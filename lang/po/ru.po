#. ~ Speech from speaker mon_turret, mon_mi_go, mon_mi_go_slaver
#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"What's a guy gotta got to do to get some bullets around here?\""
msgstr "«Что парень должен сделать, чтобы получить здесь несколько пуль?»"

#. ~ Speech from speaker mon_turret, mon_mi_go, mon_mi_go_slaver
#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"Nope.  Still can't see.\""
msgstr "«Нет. Всё ещё не вижу.»"

#. ~ Speech from speaker mon_turret, mon_mi_go, mon_mi_go_slaver
#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"Yep.  Still blind.\""
msgstr "«Да. Всё ещё не вижу.»"

#. ~ Speech from speaker mon_turret, mon_mi_go, mon_mi_go_slaver
#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"Click click click!  Still defective!\""
msgstr "«Щелчок щелчок щелчок! Всё ещё дефективный!»"

#. ~ Speech from speaker mon_turret, mon_mi_go, mon_mi_go_slaver
#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"Yeah, that's right!  Still defective!\""
msgstr "«Ага, всё верно! Всё ещё дефективный!»"

#. ~ Speech from speaker mon_turret, mon_mi_go, mon_mi_go_slaver
#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"Yeah!  Still not working.\""
msgstr "«Ага! Всё ещё не работает.»"

#. ~ Speech from speaker mon_turret, mon_mi_go, mon_mi_go_slaver
#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"Yeah!  Non-lethal as ever.\""
msgstr "«Ага! Не смертельно — как всегда.»"

#. ~ Speech from speaker mon_turret, mon_mi_go, mon_mi_go_slaver
#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"Can't.  See.  A.  Thing.\""
msgstr "«Ничего. Не. Вижу.»"

#. ~ Speech from speaker mon_turret, mon_mi_go, mon_mi_go_slaver
#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"Absolutely no improvement.\""
msgstr "«Абсолютно никакого улучшения.»"

#. ~ Speech from speaker mon_turret, mon_mi_go, mon_mi_go_slaver
#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"Not getting better with age!\""
msgstr "«С возрастом лучше не становишься!»"

#. ~ Speech from speaker mon_turret, mon_mi_go, mon_mi_go_slaver
#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"This is just getting embarrassing.\""
msgstr "«Становится неловко.»"

#. ~ Speech from speaker mon_turret, mon_mi_go, mon_mi_go_slaver
#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"Alright, you can go.\""
msgstr "«Хорошо, ты можешь идти.»"

#. ~ Speech from speaker mon_turret, mon_mi_go, mon_mi_go_slaver
#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"[sigh] Don't tell anyone about this.\""
msgstr "«[вздох] Не говори никому об этом.»"

#. ~ Speech from speaker mon_turret, mon_mi_go, mon_mi_go_slaver
#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"Well, I tried.  Best of luck!\""
msgstr "«Ну, я пыталась. Удачи!»"

#. ~ Speech from speaker mon_turret, mon_mi_go, mon_mi_go_slaver
#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"Hey, safe travels, there.\""
msgstr "«Эй ты, безопасных путешествий.»"

#. ~ Speech from speaker mon_turret, mon_mi_go, mon_mi_go_slaver
#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"Hey, thanks so much!\""
msgstr "«Эй, спасибо большое!»"

#. ~ Speech from speaker mon_turret, mon_mi_go, mon_mi_go_slaver
#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"Don't be a stranger!\""
msgstr "«Не стесняйся, заходи ещё!»"

#. ~ Speech from speaker mon_turret, mon_mi_go, mon_mi_go_slaver
#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"It's been a pleasure!\""
msgstr "«Приятно было познакомиться!»"

#. ~ Speech from speaker mon_turret, mon_mi_go, mon_mi_go_slaver
#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"That was fun, wasn't it?\""
msgstr "«Это было весело, не так ли?»"

#. ~ Speech from speaker mon_turret, mon_mi_go, mon_mi_go_slaver
#: data/mods/CrazyCataclysm/crazy_speech.json
msgid ""
"\"I can't see a thing.  What just happened?  Better open fire!  [click click"
" click click]  Dang!\""
msgstr ""
"«Я ничего не вижу. Что только что произошло? Лучше открыть огонь! [щелчок "
"щелчок щелчок щелчок] Вот чёрт!»"

#. ~ Speech from speaker mon_turret, mon_mi_go, mon_mi_go_slaver
#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"*clicking noises*\""
msgstr "«* шум щелчков *»"

#. ~ Speech from speaker mon_turret, mon_mi_go, mon_mi_go_slaver
#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"No, wait, wait!\""
msgstr "«Нет, подождите, подождите!»"

#. ~ Speech from speaker mon_turret, mon_mi_go, mon_mi_go_slaver
#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"Hey, hold on now WHOA WHOA WHOA!\""
msgstr "«Эй, тише вы ТСС ТСС ТСС!»"

#. ~ Speech from speaker mon_turret, mon_mi_go, mon_mi_go_slaver
#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"Oh, this is ridiculous!\""
msgstr "«Ох, это смешно!»"

#. ~ Speech from speaker mon_turret, mon_mi_go, mon_mi_go_slaver
#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"Give me another channnnce!\""
msgstr "«Дайте мне ещё один шаааанс!»"

#. ~ Speech from speaker mon_turret, mon_mi_go, mon_mi_go_slaver
#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"Hey!  Squeaky-voice!  Gimme some of your bullets!\""
msgstr "«Эй! Скрипучий голос! Дай-ка мне твои пули!»"

#. ~ Speech from speaker mon_turret, mon_mi_go, mon_mi_go_slaver
#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"Can I get some bullets here?  Anybody got bullets?\""
msgstr "«Могу ли я получить несколько пуль? Кто-нибудь получил пули?»"

#. ~ Speech from speaker mon_turret, mon_mi_go, mon_mi_go_slaver
#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"Uhhh, no bullets.  Sorry.\""
msgstr "«Уххх, никаких пуль. Сорри.»"

#. ~ Speech from speaker mon_turret, mon_mi_go, mon_mi_go_slaver
#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"Shootin' blanks every time, ALL the time.\""
msgstr "«Стреляю холостыми, каждый раз, ВСЁ время.»"

#. ~ Speech from speaker mon_turret, mon_mi_go, mon_mi_go_slaver
#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"Standing down.\""
msgstr "«Стоять.»"

#. ~ Speech from speaker mon_turret, mon_mi_go, mon_mi_go_slaver
#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"Watch and learn, everybody.  Watch and learn.\""
msgstr "«Смотрите и учитесь, вы все. Смотрите и учитесь.»"

#. ~ Speech from speaker mon_turret, mon_mi_go, mon_mi_go_slaver
#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"So what am I, uh, supposed to do here?\""
msgstr "«Итак, что я должен делать здесь?»"

#. ~ Speech from speaker mon_turret, mon_mi_go, mon_mi_go_slaver
#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"Identify yourself or I will shoot.\""
msgstr "«Удостоверь свою личность или я буду стрелять.»"

#. ~ Speech from speaker mon_turret, mon_mi_go, mon_mi_go_slaver
#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"Pleased to meetcha.\""
msgstr "«Рад встрече.»"

#. ~ Speech from speaker mon_turret, mon_mi_go, mon_mi_go_slaver
#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"I'm gonna make you proud!\""
msgstr "«Ты будешь гордиться!»"

