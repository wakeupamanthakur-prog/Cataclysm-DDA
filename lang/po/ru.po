msgstr "полицейская сирена, вуп-вуп-ВУП"

#: src/monattack.cpp:3945
msgid "\"YOU… ARE FILTH…\""
msgstr "«ТЫ… МЕРЗКИЙ…»"

#: src/monattack.cpp:3948
msgid "\"VERMIN… YOU ARE VERMIN…\""
msgstr "«ЧЕРВЯК… ТЫ ЧЕРВЯК…»"

#: src/monattack.cpp:3951
msgid "\"LEAVE NOW…\""
msgstr "«ПРОВАЛИВАЙ…»"

#: src/monattack.cpp:3954
msgid "\"WE… WILL FEAST… UPON YOU…\""
msgstr "«МЫ… ПОЛАКОМИМСЯ… ТОБОЙ…»"

#: src/monattack.cpp:3957
msgid "\"FOUL INTERLOPER…\""
msgstr "«ГЛУПЫЙ ЧЕЛОВЕЧИШКА…»"

#. ~ %1$s is the name of the zombie upgrading the other, %2$s is the zombie
#. being upgraded.
#: src/monattack.cpp:4014
#, c-format
msgid ""
"You feel a sudden, intense burst of energy in the air between the %1$s and "
"the %2$s."
msgstr ""
"Вы чувствуете внезапный сильный прилив энергии в воздухе между одним "
"противником (%1$s) и другим (%2$s)."

#: src/monattack.cpp:4017
#, c-format
msgid "You feel a sudden, intense burst of energy from the %s."
msgstr "Вы чувствуете внезапный, мощный выброс энергии, и источник - %s."

#. ~ %1$s is the pre-upgrade monster, %2$s is the post-upgrade monster.
#: src/monattack.cpp:4023
#, c-format
msgid "The %1$s becomes a %2$s!"
msgstr "%1$s превращается! Теперь здесь %2$s!"

#: src/monattack.cpp:4026
#, c-format
