#: src/ranged.cpp:724
#, c-format
msgid "<npcname>'s attached %s is destroyed by their shot!"
msgstr "Прикреплённая модификация (%s - <npcname>) уничтожена выстрелом!"

#: src/ranged.cpp:728
#, c-format
msgid "Your attached %s is damaged by your shot!"
msgstr "Прикреплённая модификация (%s) повреждается из-за выстрела!"

#: src/ranged.cpp:729
#, c-format
msgid "<npcname>'s %s is damaged by their shot!"
msgstr ""
"Прикреплённая модификация (%s - <npcname>) повреждается из-за выстрела!"

#: src/ranged.cpp:738
#, c-format
msgid "Your %s emits a grimace-inducing screech!"
msgstr "%s издаёт невыносимый пилящий звук!"

#: src/ranged.cpp:739
#, c-format
msgid "<npcname>'s %s emits a grimace-inducing screech!"
msgstr "%s <npcname> издаёт невыносимый пилящий звук!"

#: src/ranged.cpp:747
#, c-format
msgid "Your %s fails to cycle!"
msgstr "Ваше %s заклинило!"

#: src/ranged.cpp:748
#, c-format
msgid "<npcname>'s %s fails to cycle!"
msgstr "У <npcname> заклинило %s!"

#: src/ranged.cpp:785
#, c-format
msgid "Your %s is damaged by the high pressure!"
msgstr "Высокое давление повреждает ваше %s!"

#: src/ranged.cpp:786
#, c-format
msgid "<npcname>'s %s is damaged by the high pressure!"
msgstr "Высокое давление повреждает %s <npcname>!"

#: src/ranged.cpp:818
#, c-format
msgid ""
"Your %s displays a warning sequence as its active cooling cycle engages."
msgstr ""
"%s отображает последовательность предупреждений при включении активного "
"цикла охлаждения."

#: src/ranged.cpp:829
#, c-format
msgid ""
"Your %s revs and chokes violently as its internal containment fields detune!"
msgstr ""
"%s сильно набирает обороты и задыхается, поскольку его внутренние "
"сдерживающие поля расстраиваются!"

#: src/ranged.cpp:831
#, c-format
msgid "Your %s detonates!"
msgstr "%s детонирует!"

#: src/ranged.cpp:837
#, c-format
msgid "Acrid smoke pours from your %s as its internals fuse together."
msgstr ""
"Едкий дым валит из вашего %s, когда его внутренности сплавляются воедино."

#: src/ranged.cpp:844
#, c-format
msgid ""
"The cooling system of your %s chokes and vents a dense cloud of superheated "
"coolant."
msgstr ""
"Система охлаждения %s задыхается и выпускает плотное облако перегретой "
"охлаждающей жидкости."

#: src/ranged.cpp:862
#, c-format
msgid "%s shoots something."
msgstr "%s стреляет в кого-то."

#: src/ranged.cpp:874
#, c-format
msgid "You hear %s."
msgstr "Вы слышите %s."

#: src/ranged.cpp:897
msgid "A shotgun equipped with choke cannot fire slugs."
msgstr "Дробовик с чоком не может использовать пулевые заряды."

#: src/ranged.cpp:962
#, c-format
msgid "You cycle your %s manually."
msgstr "Вы вручную освобождаете камору %s."

