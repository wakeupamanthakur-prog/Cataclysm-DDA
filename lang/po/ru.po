msgstr[2] "атлантических лососей"
msgstr[3] "атлантические лососи"

#. ~ Description of monster "Atlantic salmon"
#: data/json/monsters/fish.json
msgid ""
"An Atlantic salmon.  A very fatty, nutritious fish.  Tastes great smoked."
msgstr ""
"Атлантический лосось.  Очень жирная питательная рыба.  Вкуснее всего в "
"копчёном виде."

#. ~ Monster name
#: data/json/monsters/fish.json
