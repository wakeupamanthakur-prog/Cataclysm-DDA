msgstr ""
"Ваше аморфное тело могло бы проскользнуть через препятствие (%s), но ваше "
"громоздкое снаряжение не сможет."

#: src/iexamine.cpp:1566
#, c-format
msgid "Slip through the %s?"
msgstr "Проскользнуть сквозь препятствие (%s)?"

#: src/iexamine.cpp:1571
msgid "You slide right between the bars."
msgstr "Вы проскальзываете между прутьями."

#: src/iexamine.cpp:1583
#, c-format
msgid "Pull up the %s?"
msgstr ""

#: src/iexamine.cpp:1586
#, c-format
msgid "You pull up the %s."
msgstr ""

