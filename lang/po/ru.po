msgstr[1] "водолазные маски выживальщика"
msgstr[2] "водолазных масок выживальщика"
msgstr[3] "водолазные маски выживальщика"

#. ~ Description of "survivor divemask"
#. ~ Description of "survivor divemask (on)"
#: data/json/items/tool_armor.json
msgid ""
"A custom-built, armored rebreather mask that covers the face and eyes.  "
"Provides excellent protection from harm as well providing breathing gas "
"while underwater.  Use it to turn it on."
msgstr ""
"Кастомная бронированная ребризерная маска, закрывающая лицо и глаза.  "
"Обеспечивает отличную защиту от повреждений, а также подает дыхательный газ "
"под водой.  Используйте её, чтобы включить."

#. ~ Item name
#: data/json/items/tool_armor.json
msgid "survivor divemask (on)"
msgid_plural "survivor divemasks (on)"
msgstr[0] "водолазная маска выживальщика (вкл)"
msgstr[1] "водолазные маски выживальщика (вкл)"
