msgstr ""
"Растительный шнур длиной примерно 15 см. Полезен для некоторых целей, но не "
"так крепок и гибок, как как настоящий шнур."

#. ~ Item name
#: data/json/items/generic/string.json
msgid "long cordage piece"
msgid_plural "long cordage pieces"
msgstr[0] "длинный растительный шнур"
msgstr[1] "длинных растительных шнура"
msgstr[2] "длинных растительных шнуров"
msgstr[3] "длинные растительные шнуры"

#. ~ Description of "long cordage piece"
#: data/json/items/generic/string.json
