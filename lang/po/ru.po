msgstr[1] "На сколько пополнить? Максимум: %d цента. (0 для отмены)"
msgstr[2] "На сколько пополнить? Максимум: %d цент. (0 для отмены)"
msgstr[3] "На сколько пополнить? Максимум: %d цент. (0 для отмены)"

