msgstr[0] "плащ джедая"
msgstr[1] "плаща джедая"
msgstr[2] "плащей джедая"
msgstr[3] "плащи джедая"

#. ~ Description of "Jedi cloak"
#: data/json/items/armor/cloaks.json
msgid ""
"A long, flowing robe.  Be sure to tear it off dramatically before fighting "
"any foes!"
msgstr ""
"Длинное струящееся платье. Не забудьте резко оторвать его, прежде чем "
"сражаться с любыми врагами!"

#. ~ Item name
#: data/json/items/armor/cloaks.json
msgid "FB51 optical cloak"
msgid_plural "FB51 optical cloaks"
msgstr[0] "плащ-невидимка FB51"
msgstr[1] "плаща-невидимки FB51"
msgstr[2] "плащей-невидимок FB51"
msgstr[3] "плащи-невидимки FB51"

#. ~ Description of "FB51 optical cloak"
#: data/json/items/armor/cloaks.json
msgid ""
"A plastic cloak embedded with cameras and LEDs that will render you fully "
"invisible to normal vision when powered and worn.  You must be carrying a "
"unified power supply, or UPS, to use it.  Activate to toggle visibility."
msgstr ""
"Пластиковый плащ, оснащённый камерами и светодиодами, который, будучи надет "
"и включён, сделает вас полностью невидимым для обычного зрения. Вам нужно "
"иметь УБП для использования плаща. Активируйте для переключения видимости."

#. ~ "msg" action message of item "FB51 optical cloak"
#: data/json/items/armor/cloaks.json
msgid "Your optical cloak flickers as it becomes transparent."
msgstr "Ваша оптическая накидка мерцает, становясь прозрачной"

#. ~ "need_charges_msg" action message of item "FB51 optical cloak"
#: data/json/items/armor/cloaks.json
#, c-format
msgid "You don't have enough UPS charges to turn on the %s"
msgstr "У вас недостаточно зарядов УБП для включения этого (%s)."

#. ~ Item name
#: data/json/items/armor/cloaks.json
msgid "FB51 optical cloak (on)"
msgid_plural "FB51 optical cloaks (on)"
msgstr[0] "плащ-невидимка FB51 (вкл)"
msgstr[1] "плаща-невидимки FB51 (вкл)"
msgstr[2] "плащей-невидимок FB51 (вкл)"
msgstr[3] "плащи-невидимки FB51 (вкл)"

#. ~ Description of "FB51 optical cloak (on)"
#: data/json/items/armor/cloaks.json
msgid ""
"A plastic cloak embedded with cameras and LEDs that will render you fully "
"invisible to normal vision when powered and worn.  It is turned on, and "
"continually draining power from a UPS.  Use it to turn it off."
msgstr ""
"Пластиковый плащ, напичканный камерами и светодиодами, который во включённом"
" состоянии делает вас полностью невидимым для обычного глаза. Он включен и "
"потребляет энергию УБП. Активируйте, чтобы отключить."

#. ~ "msg" action message of item "FB51 optical cloak (on)"
#: data/json/items/armor/cloaks.json
#, c-format
msgid "The %s flickers for a moment as it becomes opaque."
msgstr "Ваша %s мерцает на мгновение, становясь видимой."

