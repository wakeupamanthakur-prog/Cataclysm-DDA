msgstr[0] "отключенный напольный прожектор"
msgstr[1] "отключенных напольных прожектора"
msgstr[2] "отключенных напольных прожекторов"
msgstr[3] "отключенные напольные прожекторы"

#. ~ Description of "disconnected standing floodlight"
#: data/json/items/appliances.json
msgid ""
"A large, heavy light designed to illuminate wide areas when plugged into a "
