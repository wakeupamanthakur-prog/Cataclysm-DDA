#. ~ Item name
#: data/json/items/vehicle/tables.json
msgid "wooden table"
msgid_plural "wooden tables"
msgstr[0] "деревянный стол"
msgstr[1] "деревянных стола"
msgstr[2] "деревянных столов"
msgstr[3] "деревянные столы"

#. ~ Description of "wooden table"
#: data/json/items/vehicle/tables.json
msgid "A crude wooden table."
msgstr "Грубый деревянный стол."

#. ~ Item name
#: data/json/items/vehicle/tables.json
msgid "workbench (folded)"
msgid_plural "workbenches (folded)"
msgstr[0] "верстак (сложен)"
msgstr[1] "верстака (сложен)"
msgstr[2] "верстаков (сложен)"
msgstr[3] "верстаки (сложен)"

#. ~ Description of "workbench (folded)"
#: data/json/items/vehicle/tables.json
