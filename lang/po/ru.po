#. ~ NPC dialogue line
#: data/json/npcs/refugee_center/surface_refugees/NPC_Alonso_Lautrec.json
msgid "My jewel of the New England, I give to you my biggest prize."
msgstr "Моя жемчужина Новой Англии, я отдаю тебе мою самую главную награду."

#. ~ NPC dialogue line
#: data/json/npcs/refugee_center/surface_refugees/NPC_Alonso_Lautrec.json
