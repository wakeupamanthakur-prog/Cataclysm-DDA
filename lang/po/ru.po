#. ~ Snippet in category "non_kitten_items"
#. ~ Additional items from current official robotfindskitten game, GPL
#. licensed
#: data/json/snippets/robot_finds_kitten.json
msgid ""
"\"The Theory and Practice of Oligarchical Collectivism\" by Emmanuel "
"Goldstein."
msgstr ""

#. ~ Snippet in category "non_kitten_items"
#. ~ Additional items from current official robotfindskitten game, GPL
#. licensed
#: data/json/snippets/robot_finds_kitten.json
msgid "\"Yes!\" says the bit."
msgstr "На клочке бумажки написано «Да!»."

#. ~ Snippet in category "non_kitten_items"
#. ~ Additional items from current official robotfindskitten game, GPL
#. licensed
#: data/json/snippets/robot_finds_kitten.json
msgid "A bag of groceries taken off the shelf before the expiration date."
msgstr "Пакет с продуктами, снятыми с полки до истечения срока годности."

#. ~ Snippet in category "non_kitten_items"
#. ~ Additional items from current official robotfindskitten game, GPL
#. licensed
#: data/json/snippets/robot_finds_kitten.json
