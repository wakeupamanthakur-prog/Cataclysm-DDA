#. ~ Item name
#: data/json/items/generic/string.json
msgid "long leather lace"
msgid_plural "long leather laces"
msgstr[0] "длинный кожаный шнур"
msgstr[1] "длинных кожаных шнура"
msgstr[2] "длинных кожаных шнуров"
msgstr[3] "длинные кожаные шнуры"

#. ~ Description of "long leather lace"
