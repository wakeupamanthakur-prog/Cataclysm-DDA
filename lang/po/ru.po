#. ~ Response to NPC dialogue
#: data/mods/Defense_Mode/dialogue/menu_screen.json
msgid ""
"<color_yellow>Easy</color>: No additional enemies spawn per wave, and you "
"get a second chance when you die the first time.  Good for newcomers or "
"those not familiar with isometric horde fighters."
msgstr ""

#. ~ Response to NPC dialogue
#: data/mods/Defense_Mode/dialogue/menu_screen.json
msgid ""
"<color_yellow>Normal</color>: The basic way to play, no additional enemies, "
"with no safety nets.  This is considered the default."
msgstr ""

#. ~ Response to NPC dialogue
#: data/mods/Defense_Mode/dialogue/menu_screen.json
