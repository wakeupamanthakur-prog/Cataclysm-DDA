msgstr "Бронированный Робот-Перевозчик"

#. ~ Vehicle name
#: data/mods/Aftershock/vehicles/vehicles.json
msgid "Atomic Sports Car"
msgstr "атомный спортивный автомобиль"

#. ~ Vehicle name
#: data/mods/Aftershock/vehicles/vehicles.json
