msgstr[0] "модульный защитный якорь Центра 01 (вкл)"
msgstr[1] "модульных защитных якоря Центра 01 (вкл)"
msgstr[2] "модульных защитных якорей Центра 01 (вкл)"
msgstr[3] "модульные защитные якори Центра 01 (вкл)"

#. ~ Description of "Hub 01 modular defense anchor (on)"
#: data/json/items/armor/robofac_armor.json
msgid ""
"A custom-designed poncho for the true frontier explorer, made with aramid "
"fibers and robust ripstop nylon.  The logo of Hub 01 emblazoned on the chest"
" is glowing white."
msgstr ""
"Специально разработанное пончо для настоящего первооткрывателя, "
"изготовленное из арамидных волокон и прочного нейлона рипстоп. Логотип "
"Центра 01 на груди светится белым светом."

#. ~ "menu_text" action message of item "Hub 01 modular defense anchor (on)"
#: data/json/items/armor/robofac_armor.json
msgid "Turn off anchor"
msgstr "Выключить якорь"

