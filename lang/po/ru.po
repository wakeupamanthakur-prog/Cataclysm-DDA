#: src/activity_handlers.cpp:1573 src/activity_handlers.cpp:2103
#, c-format
msgid "The %s runs out of batteries."
msgstr "%s больше не работает - батарейки разряжены."

#: src/activity_handlers.cpp:1605
msgid "You won!"
msgstr "Вы победили!"

#: src/activity_handlers.cpp:1606
