msgid "Assassin"
msgstr "Ассасин"

#. ~ Profession name for female
#: data/json/professions.json
msgctxt "profession_female"
msgid "Assassin"
msgstr "Ассасин"

#. ~ Profession name for male
#: data/json/professions.json
msgctxt "profession_male"
msgid "Old Veteran"
msgstr "Старый ветеран"

#. ~ Description of profession "Old Veteran" for male
#: data/json/professions.json
msgctxt "prof_desc_male"
msgid ""
"You've been through hell once before.  Hopefully those weekend range trips "
"have kept your skills sharp."
msgstr ""
"Однажды вы уже прошли через ад.  Быть может, поездки на стрельбище по "
"выходным сохранили ваши навыки."

#. ~ Profession name for female
#: data/json/professions.json
msgctxt "profession_female"
msgid "Old Veteran"
msgstr "Старый ветеран"

