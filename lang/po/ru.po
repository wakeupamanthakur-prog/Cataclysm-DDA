msgid_plural "oven control panels"
msgstr[0] "панель управления духовкой"
msgstr[1] "панели управления духовкой"
msgstr[2] "панелей управления духовкой"
msgstr[3] "панели управления духовкой"

#. ~ Description of "oven control panel"
#: data/json/items/resources/appliance_parts.json
msgid "The control panel and LCD from a dismantled electric oven."
msgstr "Панель управления и ЖК-дисплей от разобранной электрической духовки."

#. ~ Item name
#: data/json/items/resources/appliance_parts.json
msgid "oven door"
msgid_plural "oven doors"
msgstr[0] "дверца духовки"
msgstr[1] "дверцы духовки"
msgstr[2] "дверец духовки"
msgstr[3] "дверцы духовки"

#. ~ Description of "oven door"
#: data/json/items/resources/appliance_parts.json
msgid "The removed glass and steel door of an electric oven."
msgstr "Снятая дверца электрической духовки, сделанная из стали и стекла."

#. ~ Item name
#: data/json/items/resources/appliance_parts.json
msgid "broiler pan"
msgid_plural "broiler pans"
msgstr[0] "сковорода для бройлинга"
msgstr[1] "сковороды для бройлинга"
msgstr[2] "сковород для бройлинга"
msgstr[3] "сковороды для бройлинга"

#. ~ Description of "broiler pan"
#: data/json/items/resources/appliance_parts.json
msgid ""
"A simple sheet metal drawer that goes in the bottom of an electric oven."
msgstr ""
"Простой ящик из листового металла, который вставляется в дно электрической "
"духовки."

#. ~ Item name
#: data/json/items/resources/chemicals.json
msgid "potassium alum"
msgid_plural "potassium alums"
msgstr[0] "алунит"
msgstr[1] "алунит"
msgstr[2] "алунит"
msgstr[3] "алунит"

#. ~ Description of "potassium alum"
#: data/json/items/resources/chemicals.json
msgid ""
"A handful of small, water-soluble white crystals with a watery metallic "
"odor, historically used for many different purposes.  Also known as potash "
"alum and potassium aluminum sulfate; often called simply alum, as it's the "
"most important member of the generic class of compounds called alums."
msgstr ""
"Горсть мелких, растворимых в воде белых кристаллов с водянистым "
"металлическим запахом, исторически использовавшихся для самых разных целей. "
"Также известен как калийные квасцы и сульфат алюминия-калия; часто его "
"называют просто квасцами, поскольку это наиболее важный представитель общего"
" класса соединений."

#. ~ Item name
#: data/json/items/resources/chemicals.json
msgid "cloth dye powder"
msgid_plural "cloth dye powders"
msgstr[0] "порошковый краситель для ткани"
msgstr[1] "порошковый краситель для ткани"
msgstr[2] "порошковый краситель для ткани"
msgstr[3] "порошковый краситель для ткани"

#. ~ Description of "cloth dye powder"
#: data/json/items/resources/chemicals.json
msgid ""
"A handful of powdered colorful cloth dye, which can be used to dye many "
"fabrics if combined with water and some mordant."
msgstr ""
"Горсть порошкообразного красителя для цветных тканей, который можно "
"использовать для окрашивания многих тканей, если смешать с водой и небольшим"
" количеством растворителя."

#. ~ Item name
#: data/json/items/resources/chemicals.json
msgid "calcium chloride"
msgid_plural "calcium chloride"
msgstr[0] "хлорид кальция"
msgstr[1] "хлорид кальция"
