msgstr[3] "встроенный мультиметр"

#. ~ Description of "integrated multimeter"
#: data/json/items/tool/integrated.json
msgid "Integrated bionic multimeter implanted in your fingers."
msgstr "Встроенный бионический мультиметр, имплантированный в пальцы."

#. ~ Item name
#: data/json/items/tool/integrated.json
