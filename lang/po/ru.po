msgstr "%s <npcname> даёт осечку, издав лишь тихий щелчок!"

#: src/ranged.cpp:671
#, c-format
msgid "Perhaps taking the ammo out of your %s and reloading will help."
msgstr "Возможно извлечение патрона из %s и перезарядка решат проблему."

#: src/ranged.cpp:672
#, c-format
msgid "Perhaps taking the ammo out of <npcname>'s %s and reloading will help."
msgstr ""
"Возможно извлечение патрона из оружия %s <npcname> и перезарядка решат "
"проблему."

#: src/ranged.cpp:684
#, c-format
msgid "Your %s misfires with a wet click!"
msgstr "%s влажно щёлкает и даёт осечку!"

#: src/ranged.cpp:685
#, c-format
msgid "<npcname>'s %s misfires with a wet click!"
msgstr "%s <npcname> влажно щёлкает и даёт осечку!"

#: src/ranged.cpp:694
#, c-format
msgid "Your %s malfunctions!"
msgstr "%s работает неисправно!"

#: src/ranged.cpp:695
#, c-format
msgid "<npcname>'s %s malfunctions!"
msgstr "%s <npcname> работает неисправно!"

#: src/ranged.cpp:723
#, c-format
msgid "Your attached %s is destroyed by your shot!"
