msgstr[0] "имитация говядины"
msgstr[1] "имитация говядины"
msgstr[2] "имитация говядины"
msgstr[3] "имитация говядины"

#. ~ Description of "beefsim"
#: data/mods/Aftershock/items/comestibles/cheap_food.json
msgid ""
"Soy or pureed rat?  Better not to know.\n"
"(But its probably both.)"
msgstr ""
"Соя или молотые крысы?  Лучше и не знать.\n"
"(Но скорее всего и то, и другое.)"

#. ~ Item name
#: data/mods/Aftershock/items/comestibles/cheap_food.json
msgid "soup, flavor 27"
