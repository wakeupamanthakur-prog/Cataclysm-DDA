msgid "A Clinical Guide to Video Gamers"
msgid_plural "copies of A Clinical Guide to Video Gamers"
msgstr[0] "«Клиническое руководство по игрокам в видеоигры»"
msgstr[1] "копии «Клиническое руководство по игрокам в видеоигры»"
msgstr[2] "копий «Клиническое руководство по игрокам в видеоигры»"
