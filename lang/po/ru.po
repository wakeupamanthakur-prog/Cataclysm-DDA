msgstr "Киборг"

#. ~ Job description of "Cyborg" NPC class
#: data/json/npcs/classes.json
msgid "Zzzzzt… I… I'm a Cy… BEEEEEP… borg."
msgstr "Зззззт… Я… я… Ки…БИИИИИП… борг."

#. ~ Name of an NPC class
#: data/json/npcs/classes.json
msgid "Former Cop"
msgstr "Бывший полицейский"

#. ~ Job description of "Former Cop" NPC class
#: data/json/npcs/classes.json
msgid "I used to be a police officer, but I'm just a survivor now."
msgstr "До этого я был офицером полиции, но сейчас я просто пытаюсь выжить."

