#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "green wood wall"
msgstr "зелёная деревянная стена"

#. ~ Description of terrain "green wood wall"
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "A wooden wall, painted green."
msgstr "Деревянная стена, окрашенная в зелёный."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "red wood wall"
