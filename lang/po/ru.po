#. ~ Profession name for male
#: data/json/hobbies.json
msgctxt "profession_male"
msgid "DIY Crafting (Intermediate)"
msgstr "создание DIY(средний уровень)"

#. ~ Description of profession "DIY Crafting (Intermediate)" for male
#: data/json/hobbies.json
msgctxt "prof_desc_male"
msgid ""
"You spent much of your time making useful things out of bits and bobbles."
msgstr ""
"Вы потратили много времени на изготовление полезных вещей из подручных "
"материалов."

#. ~ Profession name for female
#: data/json/hobbies.json
msgctxt "profession_female"
msgid "DIY Crafting (Intermediate)"
msgstr "создание DIY(средний уровень)"

#. ~ Description of profession "DIY Crafting (Intermediate)" for female
#: data/json/hobbies.json
msgctxt "prof_desc_female"
msgid ""
