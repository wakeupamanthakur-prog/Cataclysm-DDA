msgid_plural "fibercloth sheets"
msgstr[0] "лист волокнистой ткани"
msgstr[1] "листа волокнистой ткани"
msgstr[2] "листов волокнистой ткани"
msgstr[3] "листы волокнистой ткани"

#. ~ Description of "fibercloth sheet"
#: data/mods/innawood/items/tool_tailoring.json
msgid ""
"A 12 inch by 24 inch sheet of fabric woven from plant fiber, suitable for "
"making clothing."
msgstr ""
"Кусок ткани из растительных волокон размером 60 на 30 сантиметров, подходит "
"для изготовления одежды."

#. ~ Item name
#: data/mods/innawood/items/tool_tailoring.json
