"\n"
"Риск: нет\n"
"Интенсивность: умеренная\n"
"Время: 5 минут / грядку\n"
"Позиции: 0/1\n"

#: src/faction_camp.cpp:1330
msgid " (Finish) Plow fields"
msgstr " (Закончить) Вспахивание полей"

#: src/faction_camp.cpp:1338
msgid ""
