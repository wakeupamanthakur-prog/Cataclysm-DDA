#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
#: data/json/speech.json
msgid "\"See you tonight.\""
msgstr "«Увидимся вечером.»"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
#: data/json/speech.json
msgid "\"I got this weird rash a few days ago.\""
msgstr "«Эта странная сыпь появилась у меня пару дней назад.»"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
#: data/json/speech.json
msgid "\"Let me have a look at it.\""
msgstr "«Дай-ка взгляну.»"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
#: data/json/speech.json
msgid "\"When did you find out?\""
msgstr "«Когда вы узнали?»"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
#: data/json/speech.json
msgid "\"Seven o'clock.\""
msgstr "«Семь часов.»"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
#: data/json/speech.json
msgid "\"Nobody is helping us.\""
msgstr "«Никто нам не поможет.»"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
#: data/json/speech.json
msgid "\"We're on our own.\""
msgstr "«Мы все сами по себе.»"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
#: data/json/speech.json
msgid "\"We're all alone.\""
msgstr "«Мы все одиноки.»"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
#: data/json/speech.json
msgid "\"We should split into groups of two each.\""
msgstr "«Мы должны разделиться на группы по два человека.»"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
#: data/json/speech.json
msgid "\"It can't follow all of us.\""
msgstr "«Он не может следить за каждым из нас.»"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
#: data/json/speech.json
msgid "\"Be careful out there.\""
msgstr "«Будь осторожнее.»"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
#. ~ Speech from speaker mon_turret, mon_mi_go, mon_mi_go_slaver
#: data/json/speech.json data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"There you are.\""
msgstr "«Вот и всё.»"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"I've been looking all over for you.\""
msgstr "«Я вижу, для вас всё кончено.»"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"It's looking for us.\""
msgstr "«Он смотрит на нас.»"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"It's faster than us.\""
msgstr "«Он быстрее нас.»"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"It's looking right at us.\""
msgstr "«Он смотрит прямо на нас.»"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"It's heading right for us!\""
msgstr "«Он направляется прямо к нам!»"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Can you swim?\""
msgstr "«Ты можешь плыть?»"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Don't do that.\""
msgstr "«Не делай так.»"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_surgeon
#: data/json/speech.json
msgid "\"You hear that?\""
msgstr "«Ты это слышал?»"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
#: data/json/speech.json
msgid "\"Be quiet.\""
msgstr "«Тихо.»"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
#: data/json/speech.json
msgid "\"Look out!\""
msgstr "«Берегись!»"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Run!\""
msgstr "«Беги!»"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Hurry!\""
msgstr "«Быстрей!»"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"No!\""
msgstr "«Нет!»"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"I'll never forget you.\""
msgstr "«Я никогда не забуду тебя»."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
#: data/json/speech.json
msgid "\"Take his gun, we're going to need it.\""
msgstr "«Заберите его оружие, оно нам пригодится.»"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
#: data/json/speech.json
msgid "\"How do we get out of here?\""
msgstr "«Как же нам выбраться отсюда?»"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
#: data/json/speech.json
msgid "\"This place is like a maze.\""
msgstr "«Это место похоже на лабиринт.»"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Oh God, I'm the only one left.\""
msgstr "«О Боже, я остался один.»"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Please, I don't want to die.\""
msgstr "«Пожалуйста, я не хочу умирать.»"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
#: data/json/speech.json
msgid "\"Mom.\""
msgstr "«Мама.»"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Mom, I miss you.\""
msgstr "«Мама, я скучаю по тебе.»"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Me go, you stay.\""
msgstr "«Я уходить, ты оставаться.»"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Please, God.\""
msgstr "«Прошу, Господи!»"

