msgstr[2] "кусков резины"
msgstr[3] "куски резины"

#. ~ Description of "chunk of rubber"
#: data/json/items/ammo.json
msgid "A chunk of useful rubber that can be molded easily."
msgstr "Кусок полезной резины, который легко поддается формованию."

#. ~ Item name
