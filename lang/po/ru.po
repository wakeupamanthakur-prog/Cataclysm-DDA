#. ~ Snippet in category "observed_effect_hearing_sounds"
#: data/mods/MindOverMatter/snippets/snippets_observed.json
msgid "You hear a very faint, \"Tekeli-li!  Tekeli-li!\""
msgstr ""

#. ~ Speech from speaker mon_feral_human_pyrokin3, mon_feral_human_pyrokin2,
#. mon_civilian_pyrokinetic
#: data/mods/MindOverMatter/snippets/speech.json
msgid "the crackle of flames."
msgstr "потрескивание пламени."

#. ~ Speech from speaker mon_feral_human_pyrokin3, mon_feral_human_pyrokin2
#: data/mods/MindOverMatter/snippets/speech.json
msgid "\"Must… burn…\""
msgstr "«Должно… сгореть…\""

#. ~ Speech from speaker mon_feral_human_teep2
#: data/mods/MindOverMatter/snippets/speech.json
msgid "a low droning hum inside your head."
msgstr "низкий монотонный гул в твоей голове."

#. ~ Speech from speaker mon_feral_human_teep2
#: data/mods/MindOverMatter/snippets/speech.json
msgid "a tuneless whistling inside your head."
msgstr "немелодичный свист в твоей голове."

#. ~ Speech from speaker mon_feral_human_teep2, mon_civilian_telepath
#: data/mods/MindOverMatter/snippets/speech.json
msgid "an inarticulate cry inside your head."
msgstr "нечленораздельный крик в твоей голове."

#. ~ Speech from speaker mon_feral_human_teep2
#: data/mods/MindOverMatter/snippets/speech.json
msgid "quiet laughter inside your head."
msgstr "тихий смех в твоей голове."

#. ~ Speech from speaker mon_feral_human_bio3,
#. mon_feral_security_captain_psychic
#: data/mods/MindOverMatter/snippets/speech.json
msgid "\"Kill…\""
msgstr "«Убить…\""

#. ~ Speech from speaker mon_feral_human_clair2, mon_feral_human_clair3
#: data/mods/MindOverMatter/snippets/speech.json
msgid "\"I… see…\""
msgstr "«Я… видел…\""

#. ~ Speech from speaker mon_feral_human_clair3
#: data/mods/MindOverMatter/snippets/speech.json
msgid "\"You… see…\""
msgstr "«Ты… видел…\""

#. ~ Speech from speaker mon_feral_human_clair3
#: data/mods/MindOverMatter/snippets/speech.json
msgid "\"Can you see?\""
msgstr "«Ты можешь видеть?\""

#. ~ Speech from speaker mon_civilian_clairsentient
#: data/mods/MindOverMatter/snippets/speech.json
msgid "\"I told you they were coming.\""
msgstr "«Я же говорил, что они придут.\""

#. ~ Speech from speaker mon_civilian_clairsentient
#: data/mods/MindOverMatter/snippets/speech.json
msgid "\"You didn't listen!\""
msgstr "«Ты не слушал!\""

#. ~ Speech from speaker mon_civilian_clairsentient
#: data/mods/MindOverMatter/snippets/speech.json
msgid "\"Just like the dreams.\""
msgstr "«Это просто сон.\""

#. ~ Speech from speaker mon_civilian_clairsentient
#: data/mods/MindOverMatter/snippets/speech.json
msgid "\"This is the end.\""
msgstr "«Это конец.\""

#. ~ Speech from speaker mon_civilian_clairsentient
#: data/mods/MindOverMatter/snippets/speech.json
msgid "\"I knew it.  I knew it.  I knew it.\""
msgstr "«Я так и знал.  Я так и знал.  Я так и знал»"

#. ~ Speech from speaker mon_civilian_clairsentient
#: data/mods/MindOverMatter/snippets/speech.json
msgid "\"Doom.  DOOM!\""
msgstr "«Погибель.  ПОГИБЕЛЬ!\""

#. ~ Speech from speaker mon_civilian_pyrokinetic
#: data/mods/MindOverMatter/snippets/speech.json
msgid "\"Burn them all!  Burn them to ash!\""
msgstr "«Сожги их всех!  Сожги их дотла!\""

#. ~ Speech from speaker mon_civilian_telepath
#: data/mods/MindOverMatter/snippets/speech.json
msgid "a voice inside your head mutter, \"No no no no.\"."
msgstr "голоса в вашей голове бормочут, «Нет нет нет нет.\"."

#. ~ Speech from speaker mon_civilian_telepath
#: data/mods/MindOverMatter/snippets/speech.json
msgid "a voice inside your head whisper, \"No escape…\"."
msgstr "голоса в вашей голове шепчут, «Спасенья нет…\"."

#. ~ Speech from speaker mon_civilian_telepath
#: data/mods/MindOverMatter/snippets/speech.json
msgid "a voice inside your head say, \"Why?  Why?  Why?\"."
msgstr "голоса в вашей голове говорят, «Почему?  Зачем?  Для чего?\"."

#. ~ Speech from speaker mon_feral_human_porter3
#: data/mods/MindOverMatter/snippets/speech.json
msgid "\"Lost between…\""
msgstr "«Потерявшийся…\""

#. ~ Speech from speaker mon_feral_human_porter3, mon_civilian_teleporter
#: data/mods/MindOverMatter/snippets/speech.json
msgid "\"So… cold…\""
msgstr "«Так… холодно…\""

#. ~ Speech from speaker mon_feral_human_porter3, mon_civilian_teleporter
#: data/mods/MindOverMatter/snippets/speech.json
msgid "\"So… dark…\""
msgstr "«Так… темно…\""

#. ~ Speech from speaker mon_civilian_vitakinetic
#: data/mods/MindOverMatter/snippets/speech.json
msgid "\"I have to live!\""
msgstr "«Я буду жить!\""

#. ~ Speech from speaker mon_civilian_vitakinetic
#: data/mods/MindOverMatter/snippets/speech.json
msgid "\"Have to escape.\""
msgstr "«Нужно бежать.\""

#. ~ Speech from speaker mon_civilian_vitakinetic
#: data/mods/MindOverMatter/snippets/speech.json
msgid "\"Must survive.\""
msgstr "«Должен выжить.\""

#. ~ Speech from speaker mon_civilian_vitakinetic
#: data/mods/MindOverMatter/snippets/speech.json
msgid "\"I need a way out!\""
msgstr "«Я должен уйти!\""

#. ~ Speech from speaker mon_feral_scientist_psychic
#: data/mods/MindOverMatter/snippets/speech.json
msgid "quiet laughter."
msgstr "тихий смешок."

#. ~ Speech from speaker mon_feral_scientist_psychic
#: data/mods/MindOverMatter/snippets/speech.json
msgid "\"Yes…\""
msgstr "«Да…\""

#. ~ Speech from speaker mon_feral_scientist_psychic
#: data/mods/MindOverMatter/snippets/speech.json
msgid "\"A test subject…\""
msgstr "«Испытуемый…\""

#. ~ Speech from speaker mon_feral_scientist_psychic
#: data/mods/MindOverMatter/snippets/speech.json
msgid "\"Ah, yes…\""
msgstr "«Ах, да…\""

#. ~ Speech from speaker mon_feral_security_captain_psychic,
#. mon_feral_security_psychic
#: data/mods/MindOverMatter/snippets/speech.json
msgid "\"Stop!\""
msgstr "«Ни с места!\""

#. ~ Speech from speaker mon_feral_security_captain_psychic,
#. mon_feral_security_psychic
#: data/mods/MindOverMatter/snippets/speech.json
msgid "\"This is a restricted area!\""
msgstr "«Это запретная зона!\""

#. ~ Speech from speaker mon_feral_security_captain_psychic,
#. mon_feral_security_psychic
#: data/mods/MindOverMatter/snippets/speech.json
msgid "\"Authorized personnel only!\""
msgstr "«Только уполномоченный персонал!\""

#. ~ Speech from speaker mon_feral_security_captain_psychic,
#. mon_feral_security_psychic
#: data/mods/MindOverMatter/snippets/speech.json
msgid "\"Leave!\""
msgstr "«Уйди!\""

#. ~ Snippet in category "<telepathy_generic>"
#. ~ Used for reading anyone's minds
#: data/mods/MindOverMatter/snippets/telepathy_snippets.json
msgid "«Poor <given_name>…no one deserves to go out like that.»"
msgstr ""

#. ~ Snippet in category "<telepathy_generic>"
#. ~ Used for reading anyone's minds
#: data/mods/MindOverMatter/snippets/telepathy_snippets.json
msgid ""
"«Just one more death, one more kill and then I'll be right.  What?  No, why "
"would I think that!»"
msgstr ""

#. ~ Snippet in category "<telepathy_generic>"
#. ~ Used for reading anyone's minds
#: data/mods/MindOverMatter/snippets/telepathy_snippets.json
msgid ""
"«I need to go to bed early.  Just please, God, no more nightmares tonight.»"
msgstr ""

#. ~ Snippet in category "<telepathy_generic>"
#. ~ Used for reading anyone's minds
#: data/mods/MindOverMatter/snippets/telepathy_snippets.json
msgid ""
"«It's me, hi, I'm the problem, it's me\n"
"At tea time, everybody agrees\n"
"I'll stare directly at the dammit why can't I get it out of my head!»"
msgstr ""

#. ~ Snippet in category "<telepathy_generic>"
#. ~ Used for reading anyone's minds
#: data/mods/MindOverMatter/snippets/telepathy_snippets.json
msgid "«<given_name>…I'm sorry…forgive me…»"
msgstr ""

#. ~ Snippet in category "<telepathy_generic>"
#. ~ Used for reading anyone's minds
#: data/mods/MindOverMatter/snippets/telepathy_snippets.json
msgid ""
"«…»\n"
"\n"
"No thoughts at all.  Maybe they're aphantasic?"
msgstr ""

#. ~ Snippet in category "<telepathy_generic>"
#. ~ Used for reading anyone's minds
#: data/mods/MindOverMatter/snippets/telepathy_snippets.json
msgid ""
"«Just let one of those <zombies> get close and it'll get some 5.56 right "
"between the eyes.  Not too close, though.  God damn it, <family_name>, I "
"told you to watch out.»"
msgstr ""

#. ~ Snippet in category "<telepathy_generic>"
#. ~ Used for reading anyone's minds
#: data/mods/MindOverMatter/snippets/telepathy_snippets.json
msgid ""
"«Wasn't that long ago we were all eating sushi at the new place in the city."
"  And now this.  At least I still have food.»"
msgstr ""

#. ~ Snippet in category "<telepathy_generic>"
#. ~ Used for reading anyone's minds
#: data/mods/MindOverMatter/snippets/telepathy_snippets.json
msgid "«I would kill for some Foodplace right now.»"
msgstr "«Я бы сейчас убил за какое-нибудь местечко, где можно поесть.»"

#. ~ Snippet in category "<telepathy_generic>"
#. ~ Used for reading anyone's minds
#: data/mods/MindOverMatter/snippets/telepathy_snippets.json
msgid ""
"«This was the year the Patriots were going to bring it home!  I wonder if "
"any of those guys made it out?  At least the riots didn't start until after "
"the season…»"
msgstr ""
"«Это был год, когда патриоты собирались вернуть его домой!  Интересно, выжил"
" ли кто-нибудь из этих парней?  По крайней мере, беспорядки начались только "
"после окончания сезона…»"

#. ~ Snippet in category "<telepathy_generic>"
#. ~ Used for reading anyone's minds
#: data/mods/MindOverMatter/snippets/telepathy_snippets.json
#, no-c-format
msgid ""
"«So did everyone in the past spend 95% of the time bored as shit?  I hate "
"this.»"
msgstr ""
"«Итак, все ли в прошлом проводили 95% времени в жуткой скуке?  Я ненавижу "
"это.»"

#. ~ Snippet in category "<telepathy_generic>"
#. ~ Used for reading anyone's minds
#: data/mods/MindOverMatter/snippets/telepathy_snippets.json
msgid ""
"«Who would have thought that guy screaming on the street corner was right?  "
"Hell, maybe the FBI really did steal ten billion from him.»"
msgstr ""
"«Кто бы мог подумать, что тот парень, кричавший на углу улицы, был прав?  "
"Черт возьми, может быть, ФБР действительно украло у него десять миллиардов.»"

#. ~ Snippet in category "<telepathy_generic>"
#. ~ Used for reading anyone's minds
#: data/mods/MindOverMatter/snippets/telepathy_snippets.json
msgid "«*tuneless humming*»"
msgstr "«*немелодичное жужжание*»"

#. ~ Snippet in category "<telepathy_generic>"
#. ~ Used for reading anyone's minds
#: data/mods/MindOverMatter/snippets/telepathy_snippets.json
msgid "«This is like the worst isekai ever.»"
msgstr "«Это похоже на худший исекай в истории.»"

#. ~ Snippet in category "<telepathy_generic>"
#. ~ Used for reading anyone's minds
#: data/mods/MindOverMatter/snippets/telepathy_snippets.json
msgid "«Have to live.  Have to live.  For you, <given_name>.»"
msgstr ""

#. ~ Snippet in category "<telepathy_generic>"
#. ~ Used for reading anyone's minds
#: data/mods/MindOverMatter/snippets/telepathy_snippets.json
msgid ""
"«The bees and ants are already the size of dogs.  Are they just going to "
"keep getting bigger?»"
msgstr ""
"«Пчелы и муравьи уже размером с собак.  Они что, и дальше будут становиться "
"больше?»"

#. ~ Snippet in category "<telepathy_generic>"
#. ~ Used for reading anyone's minds
#: data/mods/MindOverMatter/snippets/telepathy_snippets.json
msgid ""
"«<given_name>, did you make it out?  I should have gone back for you but "
"there were just too many of them.»"
msgstr ""

#. ~ Snippet in category "<telepathy_generic>"
#. ~ Used for reading anyone's minds
#: data/mods/MindOverMatter/snippets/telepathy_snippets.json
msgid ""
"«You looked so happy in that mushroom field.  Maybe I should have listened "
"to you.»"
msgstr ""
"«Ты выглядела такой счастливой на том грибном поле.  Возможно, мне следовало"
" прислушаться к тебе.»"

#. ~ Snippet in category "<telepathy_generic>"
#. ~ Used for reading anyone's minds
#: data/mods/MindOverMatter/snippets/telepathy_snippets.json
msgid ""
"«I should have gone camping more.  But maybe I can use that pottery class I "
"took…»"
msgstr ""
"«Мне следовало чаще ходить в походы.  Но, может быть, мне пригодятся уроки "
"гончарного дела, которые я посещал…»"

#. ~ Snippet in category "<telepathy_generic>"
#. ~ Used for reading anyone's minds
#: data/mods/MindOverMatter/snippets/telepathy_snippets.json
msgid "«I should have listened to <given_name>'s stories about the dreams.»"
msgstr ""

#. ~ Snippet in category "<telepathy_generic>"
#. ~ Used for reading anyone's minds
#: data/mods/MindOverMatter/snippets/telepathy_snippets.json
msgid ""
"«It's all a dream.  All this is a dream.  I'll wake up soon and it'll be "
"Saturday morning.»"
msgstr ""
"«Это все сон.  Все это сон.  Я скоро проснусь, и будет субботнее утро.»"

#. ~ Snippet in category "<telepathy_generic>"
#. ~ Used for reading anyone's minds
#: data/mods/MindOverMatter/snippets/telepathy_snippets.json
msgid "«At least I'll never have to hear any damn <musicgenre> again.»"
msgstr ""
"«По крайней мере, мне больше никогда не придется слышать идиота "
"<musicgenre>»"

#. ~ Snippet in category "<telepathy_generic>"
#. ~ Used for reading anyone's minds
#: data/mods/MindOverMatter/snippets/telepathy_snippets.json
msgid "«I never did make it to Machu Picchu.»"
msgstr "«Я так и не добрался до Мачу-Пикчу»."

#. ~ Snippet in category "<telepathy_refugee_guard>"
#. ~ Used for reading refugee center guards' minds
#: data/mods/MindOverMatter/snippets/telepathy_snippets.json
msgid ""
"«Ugh, why won't this asshole leave me alone?  I just want to finish my shift"
" and get something to eat.»"
msgstr ""
"«Фу, почему этот мудак не оставит меня в покое?  Я просто хочу закончить "
"свою смену и чего-нибудь поесть.»"

#. ~ Snippet in category "<telepathy_refugee_guard>"
#. ~ Used for reading refugee center guards' minds
#: data/mods/MindOverMatter/snippets/telepathy_snippets.json
msgid ""
"«They were just sitting there in the loading dock this whole time.  Right "
"near us.  Could have been any of us trapped in there with them.»"
msgstr ""
"«Все это время они просто сидели там, на погрузочной платформе.  Прямо рядом"
" с нами.  Любой из нас мог оказаться запертым там вместе с ними.»"

#. ~ Snippet in category "<telepathy_refugee_guard>"
#. ~ Used for reading refugee center guards' minds
#: data/mods/MindOverMatter/snippets/telepathy_snippets.json
msgid ""
"«When I told them I knew how to fight I didn't expect this.  This is nothing"
" like the dojo.»"
msgstr ""
"«Когда я сказал им, что знаю, как драться, я такого не ожидал.  Это совсем "
"не похоже на додзе.»"

#. ~ Snippet in category "<telepathy_refugee_guard>"
#. ~ Used for reading refugee center guards' minds
#: data/mods/MindOverMatter/snippets/telepathy_snippets.json
msgid ""
"«Tonight's the night I win it all back.  Don't know how <family_name> pulled"
" off that straight but she can't do it twice in a row.»"
msgstr ""

#. ~ Snippet in category "<telepathy_refugee_guard>"
#. ~ Used for reading refugee center guards' minds
#: data/mods/MindOverMatter/snippets/telepathy_snippets.json
msgid "«Four hours down, six to go.  But better bored than exciting.»"
msgstr ""
"«Четыре часа прошло, осталось шесть.  Но лучше чтоб было скучно, а не "
"захватывающим »."

#. ~ Snippet in category "<telepathy_refugee_guard>"
#. ~ Used for reading refugee center guards' minds
#: data/mods/MindOverMatter/snippets/telepathy_snippets.json
msgid ""
"«At least I'm on guard duty in here and not with one of the caravans.  Those"
" poor bastards.  After what <family_name> looked like when they hauled him "
"back you couldn't pay me enough to go out there.»"
msgstr ""

#. ~ Snippet in category "<telepathy_refugee_guard>"
#. ~ Used for reading refugee center guards' minds
#: data/mods/MindOverMatter/snippets/telepathy_snippets.json
msgid "«Why me?  Why couldn't this weirdo have talked to <given_name>.»"
msgstr ""

#. ~ Snippet in category "<telepathy_refugee_guard>"
#. ~ Used for reading refugee center guards' minds
#: data/mods/MindOverMatter/snippets/telepathy_snippets.json
msgid ""
"«Dammit, I know I saw <weird_sky_thing> on shift last night.  Trust "
"<given_name> to give me shit about it.»"
msgstr ""

#. ~ Snippet in category "<telepathy_refugee_guard>"
#. ~ Used for reading refugee center guards' minds
#: data/mods/MindOverMatter/snippets/telepathy_snippets.json
msgid ""
"«Well, he's definitely never going to write that last book now.  At least "
"people keep bringing Smokes new books.  Don't know what I would do if I "
"couldn't wind down with a good book.  Ha, \"time enough at last\".»"
msgstr ""
"«Ну, теперь он точно никогда не напишет последнюю книгу.  По крайней мере, "
"люди продолжают приносить дымку новые книги.  Не знаю, что бы я делал, если "
"бы не смог закончить хорошую книгу.  Ха, «наконец-то достаточно времени».»"

#. ~ Snippet in category "<telepathy_refugee_guard>"
#. ~ Used for reading refugee center guards' minds
#: data/mods/MindOverMatter/snippets/telepathy_snippets.json
msgid ""
"«That fence is not going to stop some of the things we saw on the way here…»"
msgstr "«Этот забор не спасет нас от того, что мы видели по дороге сюда…»"

#. ~ Snippet in category "<telepathy_refugee_guard>"
#. ~ Used for reading refugee center guards' minds
#: data/mods/MindOverMatter/snippets/telepathy_snippets.json
msgid ""
"«Endless black glass…sky filled with colors…the screams…thank God it was "
"just a nightmare.»"
msgstr ""
"«Бесконечное черное стекло… небо, наполненное красками… крики…  Слава богу, "
"это был всего лишь ночной кошмар»."

#. ~ Snippet in category "<telepathy_refugee_guard>"
#. ~ Used for reading refugee center guards' minds
#: data/mods/MindOverMatter/snippets/telepathy_snippets.json
msgid "«To think I used to be a pacifist.»"
msgstr "«Подумать только, раньше я был пацифистом»."

#. ~ Snippet in category "<telepathy_follower>"
#. ~ Used for reading your followers' minds
#: data/mods/MindOverMatter/snippets/telepathy_snippets.json
msgid "«Every time they leave…is this the time they won't come back?»"
msgstr "«Каждый раз, когда они уходили…  Неужели в этот раз они не вернутся?»"

#. ~ Snippet in category "<telepathy_follower>"
#. ~ Used for reading your followers' minds
#: data/mods/MindOverMatter/snippets/telepathy_snippets.json
msgid "«Ugh!  Were they literally bathing in sewage?  What is that smell!»"
msgstr ""
"«Фу!  Неужели они буквально купаются в нечистотах?  Что это за запах!»"

#. ~ Snippet in category "<telepathy_follower>"
#. ~ Used for reading your followers' minds
#: data/mods/MindOverMatter/snippets/telepathy_snippets.json
msgid ""
"«Please, just tell me to take a car apart.  I'd rather do that than go back "
"out there.»"
msgstr ""
"«Пожалуйста, просто скажи мне разобрать машину.  Я лучше сделаю это, чем "
"вернусь туда»."

#. ~ Snippet in category "<telepathy_follower>"
#. ~ Used for reading your followers' minds
#: data/mods/MindOverMatter/snippets/telepathy_snippets.json
msgid "«Punching out a jabberwock?  Please.  How stupid do they think I am?»"
msgstr ""
"«Избить бармаглота?  Да пожалуйста.  Насколько же глупым они меня считают?»"

#. ~ Snippet in category "<telepathy_follower>"
#. ~ Used for reading your followers' minds
#: data/mods/MindOverMatter/snippets/telepathy_snippets.json
msgid "«Can we really make this place a new home?»"
msgstr "«Мы действительно можем сделать это место новым домом?»"

#. ~ Snippet in category "<telepathy_follower>"
#. ~ Used for reading your followers' minds
#: data/mods/MindOverMatter/snippets/telepathy_snippets.json
msgid "«Well.  At least it beats being dead.»"
msgstr "«хорошо.  По крайней мере, это лучше, чем быть мертвым.»"

#. ~ Snippet in category "<telepathy_follower>"
#. ~ Used for reading your followers' minds
#: data/mods/MindOverMatter/snippets/telepathy_snippets.json
msgid "«They're like a machine.  How do they do it?»"
msgstr "«Они как машина.  Как они это делают?»"

#. ~ Snippet in category "<telepathy_follower>"
#. ~ Used for reading your followers' minds
#: data/mods/MindOverMatter/snippets/telepathy_snippets.json
msgid "«Oh God, not another fucking training session.»"
msgstr "«О Боже, только не ещё одна гребаная тренировка»."

#. ~ Snippet in category "<telepathy_follower>"
#. ~ Used for reading your followers' minds
#: data/mods/MindOverMatter/snippets/telepathy_snippets.json
msgid "«If I were injured on a run, would they come back for me?»"
msgstr "«Если бы я был ранен на пробежке, они вернулись бы за мной?»"

#. ~ Message after transforming to "f_teleporter_attuned_ground"
#: data/mods/MindOverMatter/ter_transform/ter_transform.json
msgid "You spend some time memorizing your location."
msgstr "Вы тратите некоторое время на запоминание своего местоположения."

#. ~ MOD name
#: data/mods/My_Sweet_Cataclysm/modinfo.json
msgid "My Sweet Cataclysm"
msgstr "Мой Сладкий Катаклизм"

#. ~ Description of MOD "My Sweet Cataclysm"
#: data/mods/My_Sweet_Cataclysm/modinfo.json
msgid ""
"In the wake of the Cataclysm, sweets and snacks are coming to life.  You "
"could be one of them and walk through the Cataclysm as a human shaped piece "
"of sugar with your pet necco wafer, or you could just hunt them for some "
"sweet treats."
msgstr ""
"После наступления Катаклизма сладости и закуски оживают.  Вы можете стать "
"одним из них и выжить в Катаклизме в виде человекоподобного куска сахара, "
"сопровождаемого верной ручной вафлей, или можете на них охотиться ради "
"сладкой добычи."

#. ~ Item name
#: data/mods/My_Sweet_Cataclysm/sweet_comestibles.json
msgid "necco corpse"
msgid_plural "necco corpses"
msgstr[0] "труп некко"
msgstr[1] "трупа некко"
msgstr[2] "трупов некко"
msgstr[3] "трупы некко"

#. ~ Description of "necco corpse"
#: data/mods/My_Sweet_Cataclysm/sweet_comestibles.json
msgid ""
"The corpse of a necco.  Now it really looks like a giant necco wafer.  "
"Surely a bite wouldn't hurt, right?"
msgstr ""
"Труп некко, сейчас очень напоминает огромную вафельку Некко.  Не помешает "
"откусить кусочек, верно?"

#. ~ Description of "marshmallows"
#: data/mods/My_Sweet_Cataclysm/sweet_comestibles.json
msgid ""
"A handful of squishy, fluffy, puffy, delicious marshmallows.  They feel "
"oddly warm…"
msgstr ""
"Горстка нежного, воздушного, пышного и вкусного зефира.  Кажется странно "
"теплой…"

#. ~ Description of "s'mores"
#: data/mods/My_Sweet_Cataclysm/sweet_comestibles.json
msgid ""
"A pair of graham crackers with some chocolate and a marshmallow between "
"them.  Warmth radiates from it as if it is… alive?"
msgstr ""
"Пара крекеров в шоколаде, разделённые слоем зефира.  От них ощущается тепло,"
" словно… от живых?"

#. ~ Description of "chewy candy"
#: data/mods/My_Sweet_Cataclysm/sweet_comestibles.json
msgid ""
"A handful of colorful fruit-flavored chewy candy.  They feel warm to the "
"touch and you can almost feel a slow beat coming from them.  How odd…"
msgstr ""
"Горсть разноцветных жевательных конфет со фруктовыми вкусами.  Они теплые на"
" ощупь, и вы почти испытываете медленное пульсирование, исходящее от них.  "
"Как странно…"

#. ~ Description of "chewy reptilian candy"
#: data/mods/My_Sweet_Cataclysm/sweet_comestibles.json
msgid ""
"A handful of colorful fruit-flavored chewy candy shaped in a reptilian "
"fashion.  They're warm to the touch and you can feel a slow beat coming from"
" them.  How odd…"
msgstr ""
"Горсть разноцветных жевательных конфет со фруктовыми вкусами в форме "
"рептилий.  Они теплые на ощупь, и вы испытываете медленное пульсирование, "
"исходящее от них.  Как странно…"

#. ~ Description of "graham cracker"
#: data/mods/My_Sweet_Cataclysm/sweet_comestibles.json
msgid ""
"Dry and sugary, these crackers will leave you thirsty, but go good with some"
" chocolate and marshmallows.  They shiver under your touch.  Weird!"
msgstr ""
"Эти сухие и сладкие крекеры вызывают жажду, но хорошо сочетаются с шоколадом"
" и зефиром.  Они вздрагивают при касании.  Как необычно!"

#. ~ Item name
#: data/mods/My_Sweet_Cataclysm/sweet_comestibles.json
msgid "graham cracker roe"
msgid_plural "graham cracker roe"
msgstr[0] "икра из крекеров Грэма"
msgstr[1] "икра из крекеров Грэма"
msgstr[2] "икра из крекеров Грэма"
msgstr[3] "икра из крекеров Грэма"

#. ~ Description of "graham cracker roe"
#: data/mods/My_Sweet_Cataclysm/sweet_comestibles.json
msgid ""
"Dry and sugary, these cracker pellets will leave you thirsty, but go good "
"with some chocolate and marshmallows.  They shiver under your touch.  Weird!"
msgstr ""
"Сухие и сладкие катышки крекеров, вызывающие жажду, но хорошо сочетающиеся с"
" шоколадом и зефиром.  Они вздрагивают при касании.  Как необычно!"

#. ~ Description of "cookie"
#: data/mods/My_Sweet_Cataclysm/sweet_comestibles.json
msgid ""
"Sweet and delicious cookies, just like grandma used to bake.  They shiver "
"under your touch.  Weird!"
msgstr ""
"Любимое сладенькое печенье, прям как бабуля делала.  Оно вздрагивает при "
"касании.  Как странно!"

#. ~ Description of "cookie egg"
#: data/mods/My_Sweet_Cataclysm/sweet_comestibles.json
msgid ""
"Sweet and delicious cookies, shaped like eggs.  They shiver under your touch"
" as if something is inside.  Weird!"
msgstr ""
"Сладкие и вкусные печенья в форме яиц.  Они дрожат от вашего прикосновения, "
"как будто что-то есть внутри.  Странно!"

#. ~ Description of "chewing gum"
#: data/mods/My_Sweet_Cataclysm/sweet_comestibles.json
msgid ""
"Bright pink chewing gum.  Sugary, sweet, and bad for your teeth.  It's oddly"
" warm to the touch…"
msgstr ""
"Ярко-розовая жевательная резинка.  Сладкая и вредная для зубов.  Странно "
"теплая на ощупь…"

#. ~ Description of "caffeinated chewing gum"
#: data/mods/My_Sweet_Cataclysm/sweet_comestibles.json
msgid ""
"Chewing gum with added caffeine.  Sugary and bad for your teeth, but it's a "
"nice pick-me-up.  It's oddly warm to the touch…"
msgstr ""
"Жевательная резинка с добавлением кофеина.  Сладкая и вредная для зубов.  "
"Обладает бодрящим эффектом.  Удивительно теплая на ощупь…"

#. ~ Description of "candy cattle"
#: data/mods/My_Sweet_Cataclysm/sweet_comestibles.json
msgid ""
"A handful of chocolate candies shaped like cows.  They're really warm, "
"enough to make you wonder how they haven't melted."
msgstr ""
"Горсть шоколадных конфет в форме коров.  Они довольно тёплые, достаточно, "
"чтобы заставить задуматься, как они не растаяли."

#. ~ Item name
#: data/mods/My_Sweet_Cataclysm/sweet_comestibles.json
msgid "raw chocolate milk"
msgid_plural "raw chocolate milk"
msgstr[0] "сырое шоколадное молоко"
msgstr[1] "сырое шоколадное молоко"
msgstr[2] "сырое шоколадное молоко"
msgstr[3] "сырое шоколадное молоко"

#. ~ Description of "raw chocolate milk"
#: data/mods/My_Sweet_Cataclysm/sweet_comestibles.json
msgid ""
"This is raw, unhomogenized and unpasteurized chocolate milk from a chocolate"
" cow.  It couldn't be any fresher unless you drank it straight from the cow,"
" which might upset it.  Depending on your dietary sensibilities, you might "
"want to pasteurize or even boil this before drinking."
msgstr ""
"Сырое негомогенизированное и непастеризованное шоколадное молоко шоколадной "
"коровы.  Свежее не бывает, разве что пить сразу из коровы, но это её "
"расстроит.  В зависимости от ваших предпочтений его хорошо бы "
"пропастеризовать или даже прокипятить перед тем, как пить."

#. ~ Description of "chocolate milk"
#: data/mods/My_Sweet_Cataclysm/sweet_comestibles.json
msgid ""
"Baby chocolate cow food, appropriated for adult humans.  Spoils rapidly."
msgstr "Пища телят, приготовленная для взрослых людей.  Быстро портится."

#. ~ Item name
#: data/mods/My_Sweet_Cataclysm/sweet_comestibles.json
msgid "liquid cacao"
msgid_plural "liquid cacao"
msgstr[0] "жидкое какао"
msgstr[1] "жидкое какао"
msgstr[2] "жидкое какао"
msgstr[3] "жидкое какао"

#. ~ Description of "liquid cacao"
#: data/mods/My_Sweet_Cataclysm/sweet_comestibles.json
msgid "Liquid unsweetened cacao.  Quite bitter to taste."
msgstr "Жидкое несладкое какао.  Довольно горькое на вкус."

#. ~ Item name
#: data/mods/My_Sweet_Cataclysm/sweet_comestibles.json
msgid "reconstituted chocolate milk"
msgid_plural "reconstituted chocolate milk"
msgstr[0] "восстановленное шоколадное молоко"
msgstr[1] "восстановленное шоколадное молоко"
msgstr[2] "восстановленное шоколадное молоко"
msgstr[3] "восстановленное шоколадное молоко"

#. ~ Description of "reconstituted chocolate milk"
#: data/mods/My_Sweet_Cataclysm/sweet_comestibles.json
msgid ""
"Baby chocolate cow food, appropriated for adult humans.  This milk has been "
"reconstituted from a processed milk.  Spoils rapidly."
msgstr ""
"Пища телят, приготовленная для взрослых людей.  Было восстановлено из "
"переработанного шоколадного молока.  Быстро портится."

#. ~ Item name
#: data/mods/My_Sweet_Cataclysm/sweet_comestibles.json
msgid "powdered chocolate milk"
msgid_plural "powdered chocolate milk"
msgstr[0] "сухое шоколадное молоко"
msgstr[1] "сухое шоколадное молоко"
msgstr[2] "сухое шоколадное молоко"
msgstr[3] "сухое шоколадное молоко"

#. ~ Description of "powdered chocolate milk"
#: data/mods/My_Sweet_Cataclysm/sweet_comestibles.json
msgid ""
"Dehydrated chocolate milk powder.  Mix with water to make drinkable milk."
msgstr ""
"Сухой шоколадный молочный порошок.  Смешайте с водой, чтобы получить молоко,"
" которое можно пить."

#. ~ Description of "licorice"
#: data/mods/My_Sweet_Cataclysm/sweet_comestibles.json
msgid ""
"A swirly confectionary treat in strings of sweet tasting candy.  You think "
"you've seen them wriggle a bit.  How strange…"
msgstr ""
"Закрученное десертное лакомство в виде ниток сладкости.  Вы думаете, что "
"видели, как они немного пошевелились.  Как странно…"

