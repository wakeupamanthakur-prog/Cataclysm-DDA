msgstr "Вы убрали доску."

#: src/iexamine.cpp:1728
#, c-format
msgid "You need $%d to play."
msgstr "Для игры надо опустить $%d."

#: src/iexamine.cpp:1731
#, c-format
msgid "Insert $%d?"
msgstr "Опустить $%d?"

#: src/iexamine.cpp:1731
#, c-format
