msgstr[1] "железные руды"
msgstr[2] "железных руд"
msgstr[3] "железные руды"

#. ~ Description of "iron ore"
#: data/mods/innawood/mining/items/ore.json
msgid "A chunk of iron-rich earth.  Could be refined with a bloomery."
msgstr ""
"Кусок богатой железом земли.  Может быть обработана в сыродутной печи."

#. ~ Item name
#: data/mods/innawood/mining/items/ore.json
