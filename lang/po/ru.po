#: src/monattack.cpp:4736
#, c-format
msgid "The %s dissipates and reforms itself from the angles in the corner."
msgstr "%s рассеивается и меняет себя."

#: src/monattack.cpp:4755
msgid "The floor trembles underneath your feet."
msgstr "Пол колышется под вашими ногами."

#: src/monattack.cpp:4757 src/monattack.cpp:4785
msgid "a deafening roar!"
msgstr "оглушительный рёв!"

#: src/monattack.cpp:4775
#, c-format
msgid "A %s struggles to pull itself free from the %s!"
msgstr "%s пытается вырваться от %s!"

#: src/monattack.cpp:4864
