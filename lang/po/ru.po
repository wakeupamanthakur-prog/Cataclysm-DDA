msgstr "как роботизированный голос гремит «Гражданин <male_full_name>!»"

#: src/monattack.cpp:3115
msgid "a robotic voice boom, \"Citizen <female_full_name>!\""
msgstr "как роботизированный голос гремит «Гражданин <female_full_name>!»"

#: src/monattack.cpp:3118
#, c-format
