msgstr "Метаморфоза раптора"

#. ~ Name of effect type id "mutagen_raptor"
#: data/json/effects.json
msgid "Raptor Mutation"
msgstr "Мутация раптора"

#. ~ Name of effect type id "mutagen_raptor"
#: data/json/effects.json
msgid "Raptor Transformation"
msgstr "Трансформация раптора"

#. ~ Description of effect type "Raptor Metamorphosis, Raptor Mutation, Raptor
#. Transformation"
#: data/json/effects.json
msgid "Delusions fill your head… is it true?  Did you die long ago?"
msgstr ""
"Сомнения наполняют вашу голову… правда ли это? Вы умерли давным давно?"

#. ~ Description of effect type "Raptor Metamorphosis, Raptor Mutation, Raptor
#. Transformation"
#: data/json/effects.json
msgid ""
"Sharpen your talons and clean your feathers.  Your prey won't give itself "
"easily."
msgstr "Точите когти и чистите перья. Ваша добыча не сдастся без боя."

#. ~ Description of effect type "Raptor Metamorphosis, Raptor Mutation, Raptor
#. Transformation"
#: data/json/effects.json
msgid "You consumed raptor primer."
msgstr "Вы употребили праймер раптора."

#. ~ Name of effect type id "mutagen_rabbit"
#: data/json/effects.json
msgid "Rabbit Metamorphosis"
msgstr "Метаморфоза кролика"

#. ~ Name of effect type id "mutagen_rabbit"
#: data/json/effects.json
msgid "Rabbit Mutation"
msgstr "Мутация кролика"

#. ~ Name of effect type id "mutagen_rabbit"
#: data/json/effects.json
