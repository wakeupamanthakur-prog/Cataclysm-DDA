msgstr[2] "канальных сомиков"
msgstr[3] "канальные сомики"

#. ~ Description of monster "channel catfish"
#: data/json/monsters/fish.json
msgid "A channel catfish.  It has a forked tail and long whiskers."
msgstr "Канальный сомик, у этой рыбы раздвоенный хвост и длинные усы."

#. ~ Monster name
