#: data/json/items/generic/string.json
msgid "A 6-inch (or about 15 cm) long piece of cotton string."
msgstr "Кусок хлопкового шнура длиной примерно 15 см."

#. ~ Item name
#: data/json/items/generic/string.json
msgid "long string"
msgid_plural "long strings"
msgstr[0] "длинный шнур"
msgstr[1] "длинных шнура"
msgstr[2] "длинных шнуров"
msgstr[3] "длинные шнуры"

#. ~ Description of "long string"
#: data/json/items/generic/string.json
