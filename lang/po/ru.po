msgstr[3] "Штурмовые колючки"

#. ~ Name of a gun
#: data/json/items/gun/bio.json
msgid "Ranged pulling implement"
msgid_plural "Ranged pulling implements"
msgstr[0] "устройство удалённого приитягивания"
msgstr[1] "устройство удалённого приитягивания"
