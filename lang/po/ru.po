msgstr[0] "мотоциклетные ботинки"
msgstr[1] "пары мотоциклетных ботинок"
msgstr[2] "пар мотоциклетных ботинок"
msgstr[3] "пары мотоциклетных ботинок"

#. ~ Description of "pair of motorcycle boots"
#: data/json/items/armor/boots.json
msgid "A pair of durable boots used by dirt bikers and motorcyclists."
msgstr ""
"Пара прочных ботинок, предназначенная для мотокроссменов и мотоциклистов."

#. ~ Item name
#: data/json/items/armor/boots.json
msgid "pair of rollerblades"
