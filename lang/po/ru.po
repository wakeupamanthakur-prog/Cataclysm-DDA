#, c-format
msgid "You doubt someone would want to eat %1$s."
msgstr "Вы сомневаетесь, что кто-то стал бы есть это (%1$s)."

#: src/iuse.cpp:1542
#, c-format
msgid "Tame which animal with %s?"
msgstr "Приручить какое животное с помощью %s?"

