msgstr[1] "средних рюкзака MOLLE"
msgstr[2] "средних рюкзаков MOLLE"
msgstr[3] "средние рюкзаки MOLLE"

#. ~ Based upon own service and wikipedia: https://en.wikipedia.org/wiki/MOLLE
