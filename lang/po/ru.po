msgid_plural "lake whitefish"
msgstr[0] "сиг озерный"
msgstr[1] "сига озерных"
msgstr[2] "сигов озерных"
msgstr[3] "сиги озерные"

#. ~ Description of monster "lake whitefish"
#: data/json/monsters/fish.json
msgid ""
"A lake whitefish, closely related to salmon.  One can assume they taste just"
" as nice when smoked."
msgstr ""
"Озёрный сиг, близкий родственник лосося.  Некоторые считают, что копчёные "
"они одинаково вкусны."

#. ~ Monster name
#: data/json/monsters/fish.json
