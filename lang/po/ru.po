#: src/options.cpp:3384
#, c-format
msgid "The window will be %d pixel tall with the selected value."
msgid_plural "The window will be %d pixels tall with the selected value."
msgstr[0] "Высота окна будет %d пиксель с заданным значением."
msgstr[1] "Высота окна будет %d пикселя с заданным значением."
msgstr[2] "Высота окна будет %d пикселей с заданным значением."
msgstr[3] "Высота окна будет %d пикселей с заданным значением."

