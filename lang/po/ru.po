msgstr[1] "неактивных экстерминатрона"
msgstr[2] "неактивных экстерминатронов"
msgstr[3] "неактивные экстерминатроны"

#. ~ Description of "inactive exterminatron"
#: data/json/items/corpses/inactive_bots.json
