msgstr[1] "углевыжигательные печи (полные)"
msgstr[2] "углевыжигательных печей (полные)"
msgstr[3] "углевыжигательных печей (полные)"

#. ~ Furniture name
#: data/json/furniture_and_terrain/furniture-tools.json
