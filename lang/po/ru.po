msgstr[3] "нарезанные тыквы"

#. ~ Description of "cut pumpkin"
#: data/json/items/comestibles/raw_veggy.json
msgid ""
"A quarter section of a pumpkin.  The seeds and stringy inner pulp have been "
"removed."
msgstr "Четвертинка тыквы.  Семена и тягучую мякоть внутри удаляем."

#. ~ Item name
#: data/json/items/comestibles/raw_veggy.json
msgid "horseradish greens"
msgid_plural "horseradish greens"
