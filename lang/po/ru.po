#. ~ Item name
#: data/json/items/tool_armor.json
msgid "pair of binoculars"
msgid_plural "pairs of binoculars"
msgstr[0] "бинокль"
msgstr[1] "бинокля"
msgstr[2] "биноклей"
msgstr[3] "бинокли"

#. ~ Description of "pair of binoculars"
#: data/json/items/tool_armor.json
msgid ""
"A pair of optics with a neck strap attached.  Useful for seeing long "
"distances.  Wearing this item or carrying it in your inventory will double "
"the distance around you that is mapped during your travels.  You could also "
"use them to focus the sunlight."
msgstr ""
"Оптический инструмент с ремнём для ношения на шее.  Используется, чтобы "
"смотреть на дальние расстояния.  Просто носите его в инвентаре или же "
"наденьте на шею, и во время вашего путешествия вокруг вас будет отображаться"
" территория на вдвое большем расстоянии.  Можно использовать для фокусировки"
" солнечных лучей."

#. ~ Item name
#: data/json/items/tool_armor.json
#: data/mods/Aftershock/items/electrokinetic_charging_overrides.json
#: data/mods/MindOverMatter/items/electrokinetic_charging_overrrides.json
msgid "headlamp"
msgid_plural "headlamps"
msgstr[0] "налобный фонарь"
msgstr[1] "налобных фонаря"
msgstr[2] "налобных фонарей"
msgstr[3] "налобные фонари"

#. ~ Description of "headlamp"
#: data/json/items/tool_armor.json
msgid ""
"An LED headlamp with an adjustable strap so as to be comfortably worn on "
"your head or attached to your helmet.  Use it to turn it on."
msgstr ""
"Светодиодный налобный фонарь с регулируемым ремешком, который можно удобно "
"носить на голове или прикрепить к шлему.  Используйте его, чтобы включить "
"его."

#. ~ "msg" action message of item "headlamp"
#. ~ "msg" action message of item "heavy-duty headlamp"
#: data/json/items/tool_armor.json
msgid "You turn the headlamp on."
msgstr "Вы включили налобный фонарь."

#. ~ "need_charges_msg" action message of item "headlamp"
#. ~ "need_charges_msg" action message of item "heavy-duty headlamp"
