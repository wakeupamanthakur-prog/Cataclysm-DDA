msgid_plural "flintlock rifles"
msgstr[0] "кремнёвая винтовка"
msgstr[1] "кремнёвые винтовки"
msgstr[2] "кремнёвых винтовок"
msgstr[3] "кремнёвые винтовки"

#. ~ Description of gun "flintlock rifle"
#: data/json/items/gun/flintlock.json
msgid ""
"Also called a Pennsylvania rifle, this long-barreled rifled flintlock gun "
"has significantly increased accuracy at the cost of taking even longer to "
"reload."
msgstr ""
"Длинное нарезное ружье с кремневым механизмом, также называемое "
"«Пенсильванская винтовка», имеет значительно более высокую точность за счет "
"более длительного времени перезарядки."

#. ~ Variant name of gun "flintlock rifle"
