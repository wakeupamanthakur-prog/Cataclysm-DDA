#, c-format
msgid "Place the %s where?"
msgstr "Где разместить %s?"

#: src/iuse.cpp:8028
#, c-format
msgid "You can't place the %s there!"
msgstr "Вы не можете разместить %s здесь!"

#: src/iuse.cpp:8046
#, c-format
msgid "Grab which creature to place in the %s?"
msgstr "Какое существо поместить в %s?"

#: src/iuse.cpp:8049
msgid "There is no creature nearby you can capture."
msgstr "Поблизости нет существа, которое можно было бы захватить. "

#: src/iuse.cpp:8061
#, c-format
msgid "The %1$s is too big to put in your %2$s."
msgstr "%1$s слишком велико, чтобы поместиться в %2$s!"

