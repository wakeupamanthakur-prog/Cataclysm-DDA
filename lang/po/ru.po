#. ~ Item name
#: data/json/items/melee/spears_and_polearms.json
msgid "makeshift tepoztopili"
msgid_plural "makeshift tepoztopilis"
msgstr[0] "самодельный тепозтопили"
msgstr[1] "самодельных тепозтопили"
msgstr[2] "самодельных тепозтопили"
msgstr[3] "самодельные тепозтопили"

#. ~ Description of "makeshift tepoztopili"
#: data/json/items/melee/spears_and_polearms.json
msgid ""
"This is a long polearm with an oar-like oval head covered with razors.  Its "
"shape make it suitable for both thrusting and slashing.  It resembles the "
"Mesoamerican Tepoztopili, though the shaft is not very sturdy."
msgstr ""
"Это длинное копье с овальной головкой, похожей на весло, покрытой лезвиями."
"  Его форма делает его подходящим как для выпадов, так и для рубящих ударов."
"  Оно напоминает мезоамериканское оружие тепоцтопили, хотя стержень не очень"
" прочный."

#. ~ Item name
#: data/json/items/melee/spears_and_polearms.json
msgid "glass bladed tepoztopili"
msgid_plural "glass bladed tepoztopilis"
msgstr[0] "тепозтопили со стеклянными лезвиями"
msgstr[1] "тепозтопили со стеклянными лезвиями"
msgstr[2] "тепозтопили со стеклянными лезвиями"
msgstr[3] "тепозтопили со стеклянными лезвиями"

#. ~ Description of "glass bladed tepoztopili"
#: data/json/items/melee/spears_and_polearms.json
