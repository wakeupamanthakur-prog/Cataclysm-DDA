msgstr "%1$s делает механический выпад в сторону %2$s!"

#: src/monattack.cpp:5003
#, c-format
msgid "The %1$s impales %2$s!"
msgstr "%1$s пронзает %2$s!"

#: src/monattack.cpp:5013
#, c-format
