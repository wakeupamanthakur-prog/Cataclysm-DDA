msgstr "Вы надеваете сумку на спину."

#. ~ Item name
#: data/json/items/armor/storage.json
msgid "MOLLE assault pack"
msgid_plural "MOLLE assault packs"
msgstr[0] "штурмовой рюкзак MOLLE"
msgstr[1] "штурмовых рюкзака MOLLE"
msgstr[2] "штурмовых рюкзаков MOLLE"
msgstr[3] "штурмовые рюкзаки MOLLE"

#. ~ Description of "MOLLE assault pack"
#: data/json/items/armor/storage.json
msgid ""
"The Modular Lightweight Load-carrying Equipment is an advanced military "
"backpack.  Covered with pockets and straps, it strikes a fine balance "
"between storage space and encumbrance.  Can attach accessory pockets to the "
"outside rigging."
msgstr ""
"«Модульное легковесное разгрузочное снаряжение» (MOLLE) — это современный "
"военный рюкзак.  Покрытый карманами и ремнями, он обеспечивает прекрасный "
"баланс между пространством для хранения и скованностью.  Можно прикрепить "
"карманы для аксессуаров к внешней оснастке."

#. ~ Item name
#: data/json/items/armor/storage.json
msgid "MOLLE medium rucksack"
msgid_plural "MOLLE medium rucksacks"
msgstr[0] "средний рюкзак MOLLE"
