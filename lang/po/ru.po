#. ~ Description of "hardtack"
#: data/json/items/comestibles/bread.json
msgid ""
"A dry, virtually tasteless bread product capable of remaining edible without"
" spoilage for vast lengths of time.  So hard it is inedible by itself."
msgstr ""
"Сухой, практически безвкусный хлебный продукт, способный оставаться "
"съедобным в течение длительного времени.  Настолько твёрдый, что сам по себе"
" несъедобен."

#. ~ Item name
#: data/json/items/comestibles/bread.json
msgid "soggy hardtack"
msgid_plural "soggy hardtack"
msgstr[0] "смоченная галета"
msgstr[1] "смоченные галеты"
msgstr[2] "смоченных галет"
msgstr[3] "смоченные галеты"

#. ~ Description of "soggy hardtack"
#: data/json/items/comestibles/bread.json
