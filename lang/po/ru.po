msgid_plural "striped bass"
msgstr[0] "полосатый окунь"
msgstr[1] "полосатых окуня"
msgstr[2] "полосатых окуней"
msgstr[3] "полосатые окуни"

#. ~ Description of monster "striped bass"
#: data/json/monsters/fish.json
msgid ""
"A striped bass.  Mostly a saltwater fish, they migrate to fresher water to "
"spawn."
msgstr ""
"Полосатый окунь.  Большую часть времени живёт в солёной воде, мигрирует в "
"пресную воду для размножения."

#. ~ Monster name
#: data/json/monsters/fish.json
