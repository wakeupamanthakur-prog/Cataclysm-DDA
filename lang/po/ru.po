#. ~ Item name
#: data/json/items/chemicals_and_resources.json
msgid "almonds"
msgid_plural "almonds"
msgstr[0] "миндаль"
msgstr[1] "миндаль"
msgstr[2] "миндаль"
msgstr[3] "миндаль"

#. ~ Description of "almonds"
#: data/json/items/chemicals_and_resources.json
msgid "A handful of hard nuts from an almond tree, still in their shells."
msgstr "Горсть твердых орехов миндального дерева, всё ещё в скорлупе."

#. ~ Item name
#: data/json/items/chemicals_and_resources.json
msgid "peanuts"
msgid_plural "peanuts"
msgstr[0] "арахис"
msgstr[1] "арахис"
msgstr[2] "арахис"
msgstr[3] "арахис"

#. ~ Description of "peanuts"
#: data/json/items/chemicals_and_resources.json
msgid "A handful of hard nuts from a peanut bush, still in their shells."
msgstr "Горсть твердых орехов с арахисового куста, всё ещё в скорлупе."

#. ~ Item name
#: data/json/items/chemicals_and_resources.json
msgid "hazelnuts"
msgid_plural "hazelnuts"
msgstr[0] "фундук"
msgstr[1] "фундук"
msgstr[2] "фундук"
msgstr[3] "фундук"

#. ~ Description of "hazelnuts"
#: data/json/items/chemicals_and_resources.json
msgid "A handful of hard nuts from a hazelnut tree, still in their shells."
msgstr "Горсть твердых орехов фундука, всё ещё в скорлупе."

#. ~ Item name
#: data/json/items/chemicals_and_resources.json
msgid "chestnuts"
msgid_plural "chestnuts"
msgstr[0] "каштан"
msgstr[1] "каштана"
msgstr[2] "каштанов"
msgstr[3] "каштаны"

#. ~ Description of "chestnuts"
