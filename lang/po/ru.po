msgstr "%s исчезает!"

#: src/monattack.cpp:4028
#, c-format
msgid "A %s appears!"
msgstr "Появляется %s!"

#: src/monattack.cpp:4090
#, c-format
msgid "The %1$s stretches its head at you, but bounces off the %2$s"
msgstr ""
"%1$s вытягивает голову в вашем направлении, но отскакивает от препятствия "
"(%2$s)"

#: src/monattack.cpp:4091
#, c-format
