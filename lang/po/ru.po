#: src/handle_action.cpp:600 src/handle_action.cpp:613
#, c-format
msgid "You open the %1$s's %2$s."
msgstr "Вы открываете %2$s (%1$s)."

#: src/avatar_action.cpp:531
#, c-format
msgid "You bump into the %s!"
msgstr "Вы врезаетесь в препятствие (%s)!"

#: src/avatar_action.cpp:539
msgid "That door is locked!"
msgstr "Эта дверь закрыта!"

#: src/avatar_action.cpp:541
msgid "You rattle the bars but the door is locked!"
msgstr "Вы гремите решёткой, но дверь закрыта!"

#: src/avatar_action.cpp:585
msgid "You can't climb here - there's a ceiling above."
msgstr "Вы не можете забраться выше здесь — сверху потолок."

#: src/avatar_action.cpp:609 src/game.cpp:10718
msgid "The water puts out the flames!"
msgstr "Вода тушит огонь!"

#: src/avatar_action.cpp:619
msgid "The water washes off the glowing goo!"
msgstr "Вода смывает светящуюся слизь!"

#: src/avatar_action.cpp:631
msgid "You sink like a rock!"
msgstr "Вы тонете как камень!"

#: src/avatar_action.cpp:637
#, c-format
msgid "You need to breathe!  (%s to surface.)"
msgstr "Вам необходимо вдохнуть! (%s, чтобы всплыть.)"

#: src/avatar_action.cpp:639
msgid "You need to breathe but you can't swim!  Get to dry land, quick!"
msgstr ""
"Вам нужно вдохнуть, но вы не умеете плавать! Быстрее выбирайтесь на землю!"

#: src/avatar_action.cpp:647
msgid "You cannot board a vehicle while mounted."
msgstr "Вы не можете зайти в транспорт верхом."

#: src/avatar_action.cpp:713
msgid "No hostile creature in reach.  Waiting a turn."
msgstr ""
"В пределах досягаемости враждебных существ не наблюдается. Ожидаем один ход."

#: src/avatar_action.cpp:742
msgid "Your eyes steel, and you raise your weapon!"
msgstr "Ваши глаза полны решимости, и вы вскидываете своё оружие!"

#: src/avatar_action.cpp:743
msgid "You can't fire your weapon, it's too heavy…"
msgstr "Вы не можете стрелять из вашего оружия, оно слишком тяжёлое…"

#: src/avatar_action.cpp:774
#, c-format
msgid "The %s must be attached to a gun, it can not be fired separately."
msgstr ""
"Это (%s) нужно присоединить к оружию, из него нельзя стрелять отдельно от "
"оружия."

#: src/avatar_action.cpp:781
#, c-format
msgid "The %s can't be fired while loaded with incompatible ammunition %s"
msgstr "Невозможно стрелять из оружия (%s) несовместимыми патронами (%s)"

#: src/avatar_action.cpp:808
#, c-format
msgid "The %s is out of ammo."
msgstr "%s - закончились боеприпасы."

#: src/avatar_action.cpp:811
#, c-format
msgid "The %s is not powered."
msgstr "%s — отсутствует питание."

#: src/avatar_action.cpp:849
msgid "It's too dark to work on mending this."
msgstr "Слишком темно для починки этого предмета."

#: src/avatar_action.cpp:857
msgid "You're not wielding anything."
msgstr "Вы ничего не держите в руках."

#: src/avatar_action.cpp:873
#, c-format
msgid "You're too full to eat the leaves from the %s."
msgstr "Вы слишком сыты, чтобы есть листья с растения (%s)."

#: src/avatar_action.cpp:885
msgid "You're too full to graze."
msgstr "Вы слишком сыты, чтобы пастись."

#: src/avatar_action.cpp:902
msgid "This grass is too short to graze."
msgstr "Эта трава слишком низкая, чтобы пастись на ней."

#: src/avatar_action.cpp:905
msgid "This grass is dead and too mangled for you to graze."
msgstr "Эта трава мертва и слишком изодрана, чтобы пастись на ней."

#: src/avatar_action.cpp:908
msgid "This grass is tainted with paint and thus inedible."
msgstr "Эта трава испачкана краской и несъедобна."

#: src/avatar_action.cpp:957
msgid "You can't effectively throw while you're in your shell."
msgstr "Вы не можете совершать полноценные броски, находясь в своей раковине."

#: src/avatar_action.cpp:960 src/handle_action.cpp:2020 src/iexamine.cpp:6683
#: src/iexamine.cpp:6693 src/iexamine.cpp:6703 src/melee.cpp:558
msgid "You lack the substance to affect anything."
msgstr "Вам не хватает материальности, чтобы повлиять на что-нибудь."

#: src/avatar_action.cpp:967 src/game.cpp:10336 src/game.cpp:11750
#: src/handle_action.cpp:758
#, c-format
msgid "Your %s refuses to move as its batteries have been drained."
msgstr "Ваш мех (%s) не двигается, так как у него сели батареи."

#: src/avatar_action.cpp:976
msgid "You don't have any items to throw."
msgstr "У вас нет предметов для бросания."

#: src/avatar_action.cpp:997 src/character_attire.cpp:240
msgid "You don't have that item."
msgstr "У вас нет этого предмета."

#: src/avatar_action.cpp:1000
msgid "That is too heavy to throw."
msgstr "Вы не можете метнуть такой тяжёлый предмет."

#: src/avatar_action.cpp:1006
msgid "That's part of your body, you can't throw that!"
msgstr "Это часть вашего тела, её нельзя метнуть!"

#: src/avatar_action.cpp:1010
msgid "You concentrate mightily, and your body obeys!"
msgstr "Вы сильно сконцентрировались, и ваше тело подчиняется!"

#: src/avatar_action.cpp:1011
msgid "You can't muster up the effort to throw anything…"
msgstr "У вас не хватает сил бросить что-либо…"

#: src/avatar_action.cpp:1082 src/character.cpp:3219 src/character.cpp:12413
msgid "You can't use anything while incorporeal."
msgstr "Вы не можете ничего использовать, пока вы бестелесны."

#: src/avatar_action.cpp:1101
msgid "Try as you might, you can't consume frozen liquids."
msgstr "Как ни старайтесь, вы не можете потреблять замёрзшие жидкости."

#: src/avatar_action.cpp:1106
msgid "This item is still wet and it will break if you turn it on. Proceed?"
msgstr "Этот предмет всё ещё мокрый и сломается при включении. Продолжить?"

#: src/avatar_action.cpp:1146
#, c-format
msgid "Couldn't pick up the %s."
msgstr "Не могу поднять %s."

#: src/avatar_action.cpp:1150
#, c-format
