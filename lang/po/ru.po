#. with 10 strength
#. ~ Item name
#: data/json/items/ammo/sling-ready_grenade.json
msgid "sling-ready grenade"
msgid_plural "sling-ready grenades"
msgstr[0] "граната (для пращи)"
msgstr[1] "гранаты (для пращи)"
msgstr[2] "гранат (для пращи)"
msgstr[3] "гранаты (для пращи)"

