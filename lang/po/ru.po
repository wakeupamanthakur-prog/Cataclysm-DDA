msgid_plural "LIXA research archive backup"
msgstr[0] "резервная копия исследовательского архива LIXA"
msgstr[1] "резервные копии исследовательского архива LIXA"
msgstr[2] "резервных копий исследовательского архива LIXA"
msgstr[3] "резервные копии исследовательского архива LIXA"

#. ~ Description of "LIXA research archive backup"
#: data/json/items/generic.json
msgid ""
"A secured USB thumb drive, containing a copy of the LIXA facility's research"
