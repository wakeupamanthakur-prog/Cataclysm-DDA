#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
#: data/json/npcs/your_followers/luo_follower.json
msgid "Can you host a training seminar?"
msgstr "Ты можешь провести тренировочное занятие?"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
#: data/json/npcs/your_followers/luo_follower.json
msgid "I have something to teach you."
msgstr "У меня есть чему тебя научить."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
#: data/json/npcs/your_followers/luo_follower.json
msgid "Let's trade items"
msgstr "Давай обменяемся предметами."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
#: data/json/npcs/your_followers/luo_follower.json
msgid "Hold on to this item."
msgstr "Держи этот предмет."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
#: data/json/npcs/your_followers/luo_follower.json
msgid "Guard this position."
msgstr "Охраняй эту позицию."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
#: data/json/npcs/your_followers/luo_follower.json
msgid "Find a horse and mount up!"
msgstr "Найди лошадь и садись верхом!"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
#: data/json/npcs/your_followers/luo_follower.json
msgid "Drop off any items you're not using."
msgstr "Брось все предметы, которые не используешь."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
#: data/json/npcs/your_followers/luo_follower.json
msgid "Get off your mount, please."
msgstr "Спешься, пожалуйста."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Let's talk about your current activity."
msgstr "Давай поговорим о твоём текущем занятии."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Let's talk about the camp."
msgstr "Давай поговорим о лагерях."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
#: data/json/npcs/your_followers/luo_follower.json
msgid "Change your martial arts style."
msgstr ""

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "*will engage all enemies."
msgstr "*будет атаковать всех врагов."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
#: data/mods/Aftershock/npcs/Backgrounds/BGBR_Sadie.json
msgid "  "
msgstr "  "

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "  What should <mypronoun> do?"
msgstr "Что <mypronoun> нужно делать?"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Change your engagement rules…"
msgstr "Изменить порядок боевых действий…"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Change your aiming rules…"
msgstr "Изменить правила прицеливания…"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Change your bionic power reserve rules…"
msgstr "Изменить твои правила распоряжения бионической энергией…"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Change your bionic power recharge rules…"
msgstr "Изменить твои правила зарядки бионической энергии…"

#. ~ Affirmative response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Move freely as you need to."
msgstr "Ходи свободно, если нужно."

#. ~ Negative response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Stick close to me, no matter what."
msgstr "Держись ближе ко мне, несмотря ни на что."

#. ~ Affirmative response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "<ally_rule_follow_distance_request_4_text>"
msgstr "<ally_rule_follow_distance_request_4_text>"

#. ~ Negative response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "<ally_rule_follow_distance_request_2_text>"
msgstr "<ally_rule_follow_distance_request_2_text>"

#. ~ Affirmative response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Don't use ranged weapons anymore."
msgstr "Больше не используй стрелковое оружие."

#. ~ Negative response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "You can use ranged weapons."
msgstr "Можешь пользоваться стрелковым оружием."

#. ~ Affirmative response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Don't worry about noise."
msgstr "Не парься по поводу шума."

#. ~ Negative response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Use only silent weapons."
msgstr "Используй только тихое оружие."

#. ~ Affirmative response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Don't use grenades anymore."
msgstr "Больше не используй гранаты."

#. ~ Negative response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "You can use grenades."
msgstr "Можешь использовать гранаты."

#. ~ Affirmative response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Don't worry about shooting an ally."
msgstr "Не беспокойся о возможности подстрелить товарища."

#. ~ Negative response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Don't shoot unless you're sure you won't hit an ally."
msgstr "Не стреляй, пока не убедишься, что не попадёшь в товарища."

#. ~ Affirmative response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Move wherever you need to go to fight an enemy."
msgstr "Двигайся как угодно, чтобы добраться до противника."

#. ~ Negative response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Hold the line: don't move onto obstacles adjacent to me."
msgstr "Держать строй: не иди в препятствия рядом со мной."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
#: data/json/npcs/robofac/NPC_Cranberry_Foster.json
#: data/json/npcs/robofac/robofac_ancilla_npcs/NPC_ANCILLA_DOCTOR.json
#: data/json/npcs/tacoma_ranch/NPC_ranch_crop_overseer.json
#: data/json/npcs/tacoma_ranch/NPC_ranch_doctor.json
#: data/json/npcs/tacoma_ranch/NPC_ranch_scrapper.json
#: data/json/npcs/tacoma_ranch/NPC_ranch_sickly_laborer.json
msgid "Never mind."
msgstr "Неважно."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Don't fight unless your life depends on it."
msgstr "Не вступай в бой, если твоей жизни не угрожает опасность."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Attack enemies that get too close."
msgstr "Нападай на врагов, которые подобрались слишком близко."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Attack enemies that you can kill easily."
msgstr "Нападай на тех, кого можешь легко завалить."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Attack only enemies that I attack first."
msgstr "Нападай только на тех, кого атакую я."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Attack only enemies you can reach without moving."
msgstr "Атакуй только тех врагов, до которых можно достать без передвижения."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Attack any enemy within range of your ranged weapon, but don't move."
msgstr ""
"Атакуй любого противника в области твоего стрелкового оружия, но стой на "
"месте."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Attack anything you want."
msgstr "Нападай на кого хочешь."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "*will not reserve any power for defense or utility CBMs."
msgstr "*не будет беречь энергию для защитной или вспомогательной бионики."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid ""
"  How should much power should <mypronoun> reserve for defense or utility "
"CBMs?"
msgstr ""
"Сколько энергии должен <mypronoun> беречь для защитной или вспомогательной "
"бионики?"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid ""
"Don't use any CBM weapons.  Save all power for defense or utility CBMs."
msgstr ""
"Не используй никакое бионическое оружие. Прибереги всю энергию для защитной "
"или вспомогательной бионики."

