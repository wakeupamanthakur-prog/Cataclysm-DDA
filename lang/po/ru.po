msgstr[2] "отключенных воздушных компрессоров"
msgstr[3] "отключенные воздушные компрессоры"

#. ~ Description of "disconnected air compressor"
#: data/json/items/appliances.json
msgid ""
"This durable tank is topped with a motor that will cram as much air into the"
" tank as possible.  Needs to be placed and plugged into a power source."
msgstr ""
"Этот прочный резервуар оснащен двигателем, который позволяет нагнетать в "
"резервуар как можно больше воздуха.  Необходимо разместить и подключить к "
"источнику питания."

#. ~ Item name
#: data/json/items/appliances.json
msgid "disconnected autoclave"
