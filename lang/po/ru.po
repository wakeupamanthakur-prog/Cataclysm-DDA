msgstr "Баскетбол (средний уровень)"

#. ~ Description of profession "Basketball (Intermediate)" for male
#: data/json/hobbies.json
msgctxt "prof_desc_male"
msgid "Your ability to play point or post will beat the undead in overtime."
msgstr ""
"Вы хороши в защите и нападении с баскетбольным мечом, и нежити вас не "
"обыграть в овертайме."

#. ~ Profession name for female
#: data/json/hobbies.json
msgctxt "profession_female"
msgid "Basketball (Intermediate)"
msgstr "Баскетбол (средний уровень)"

#. ~ Description of profession "Basketball (Intermediate)" for female
#: data/json/hobbies.json
