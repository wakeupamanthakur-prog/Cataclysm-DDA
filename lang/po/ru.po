msgstr[3] "овощной сок «V8»"

#. ~ Description of "V8"
#: data/json/items/comestibles/drink.json
msgid "Contains up to eight vegetables!  Nutritious and tasty."
msgstr "Содержит до восьми видов овощей!  Питательно и вкусно."

#. ~ Description of "water"
#: data/json/items/comestibles/drink.json
msgid ""
"Water, the stuff of life, necessary for all kinds of crafting, cleaning, and"
" avoiding an agonizing death by dehydration.  You should boil or purify it "
"before using it as drinking water."
msgstr ""
"Вода — основа жизни, необходимая для всех видов деятельности, мытья и питья."
"  Вы должны прокипятить или очистить её перед использованием в качестве "
"питьевой воды."

#. ~ Item name
#: data/json/items/comestibles/drink.json
msgid "murky water"
msgid_plural "murky water"
msgstr[0] "мутная вода"
msgstr[1] "мутная вода"
msgstr[2] "мутная вода"
msgstr[3] "мутная вода"

#. ~ Description of "murky water"
#: data/json/items/comestibles/drink.json
