msgstr "Вы не можете нырять, пока на вас надет плавучий предмет."

#: src/game.cpp:11911
msgid "You dive underwater!"
msgstr "Вы нырнули под воду!"

#: src/game.cpp:11921
msgid "You surface."
msgstr "Вы всплыли."

#: src/game.cpp:11924
msgid "You try to surface but can't!"
msgstr "Вы пытаетесь всплыть, но не можете!"

#: src/game.cpp:11955
msgid "You swim up."
msgstr ""

#: src/game.cpp:11957
msgid "You are already underwater and there is no water above you to swim up!"
msgstr ""

