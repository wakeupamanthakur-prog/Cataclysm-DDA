msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of monster "triffid podling"
#: data/mods/TropiCataclysm/monsters/tropical_triffid.json
msgid ""
"A very small triffid born out of a triffid pod.  Like all triffids its a "
"very dangerous plant but for now its just a harmless colorful flower."
msgstr ""

#. ~ Monster name
#: data/mods/TropiCataclysm/monsters/tropical_triffid.json
