msgid_plural "yellow perches"
msgstr[0] "желтый окунь"
msgstr[1] "желтых окуня"
msgstr[2] "желтых окуней"
msgstr[3] "желтые окуни"

#. ~ Description of monster "yellow perch"
#: data/json/monsters/fish.json
msgid ""
"A small, sprightly perch.  It is a very bony fish, still has some tasty meat"
" on it though."
msgstr ""
"Мелкий юркий пресноводный окунь.  Очень костлявая рыба, но на ней есть и "
"вкусное мясо."

#. ~ Monster name
#: data/json/monsters/fish.json
