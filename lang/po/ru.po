msgstr[3] "нефритовые броши"

#. ~ Description of "jade brooch"
#: data/json/items/armor/jewelry.json
msgid "A hand-crafted jade brooch of Oriental origin."
msgstr "Азиатская нефритовая брошь ручной работы."

#. ~ Item name
#: data/json/items/armor/jewelry.json
msgid "pearl collar"
msgid_plural "pearl collars"
msgstr[0] "жемчужное ожерелье"
msgstr[1] "жемчужных ожерелья"
msgstr[2] "жемчужных ожерелий"
msgstr[3] "жемчужные ожерелья"

#. ~ Description of "pearl collar"
#: data/json/items/armor/jewelry.json
msgid ""
"A collar made from round and lustrous pearls, its former owner must have "
"been a wealthy individual."
msgstr ""
"Ожерелье, сделанное из блестящего, круглого жемчуга. Должно быть, прежний "
"хозяин был богат."

