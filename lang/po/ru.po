msgid "Laborer"
msgstr "Разнорабочий"

#. ~ NPC dialogue line
#: data/json/npcs/tacoma_ranch/NPC_ranch_sickly_laborer.json
msgid "Please leave me alone…"
msgstr "Пожалуйста, оставь меня в покое…"

