msgid "The %s's 120mm cannon fires!"
msgstr "%s стреляет из 120-мм пушки!"

#: src/monattack.cpp:3628 src/monattack.cpp:3650
#, c-format
msgid "The tongue of flame hits the %s!"
msgstr "Язык пламени попадает по окружению %s!"

#: src/monattack.cpp:3684
msgid "a robotic voice boom, \"Citizen, Halt!\""
msgstr "гремит механический голос, «Гражданин, стоять на месте!»"

#: src/monattack.cpp:3687
msgid "a robotic voice boom, \"Please put down your weapon.\""
msgstr "гремит механический голос, «Опустите своё оружие.»"

#: src/monattack.cpp:3691
msgid "a robotic voice boom, \"Come out with your hands up!\""
msgstr "гремит механический голос, «Выходите с поднятыми руками!»"

#: src/monattack.cpp:3695
msgid "a police siren, whoop WHOOP"
msgstr "полицейская сирена, вуп-вуп-ВУП"

#: src/monattack.cpp:3888
msgid "\"YOU… ARE FILTH…\""
msgstr "«ТЫ…  МЕРЗКИЙ…»"

#: src/monattack.cpp:3891
msgid "\"VERMIN… YOU ARE VERMIN…\""
msgstr "«ЧЕРВЯК…  ТЫ ЧЕРВЯК…»"

#: src/monattack.cpp:3894
msgid "\"LEAVE NOW…\""
msgstr "«ПРОВАЛИВАЙ…»"

#: src/monattack.cpp:3897
msgid "\"WE… WILL FEAST… UPON YOU…\""
msgstr "«МЫ…  ПОЛАКОМИМСЯ…  ТОБОЙ…»"

#: src/monattack.cpp:3900
msgid "\"FOUL INTERLOPER…\""
msgstr "«ГЛУПЫЙ ЧЕЛОВЕЧИШКА…»"

#. ~ %1$s is the name of the zombie upgrading the other, %2$s is the zombie
#. being upgraded.
#: src/monattack.cpp:3957
#, c-format
msgid ""
"You feel a sudden, intense burst of energy in the air between the %1$s and "
"the %2$s."
msgstr ""
"Вы чувствуете внезапный сильный прилив энергии в воздухе между %1$s и %2$s."

#: src/monattack.cpp:3960
#, c-format
msgid "You feel a sudden, intense burst of energy from the %s."
msgstr "Вы чувствуете внезапный мощный выброс энергии от %s."

#. ~ %1$s is the pre-upgrade monster, %2$s is the post-upgrade monster.
#: src/monattack.cpp:3966
#, c-format
