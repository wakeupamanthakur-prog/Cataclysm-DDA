#. ~ Item name
#: data/mods/Sky_Island/secure_container.json
msgid "Alpha Secure Container"
msgid_plural "Alpha Secure Containers"
msgstr[0] "защищённый контейнер Альфа"
msgstr[1] "защищённых контейнера Альфа"
msgstr[2] "защищённых контейнеров Альфа"
msgstr[3] "защищённые контейнеры Альфа"

#. ~ Description of "Alpha Secure Container"
#: data/mods/Sky_Island/secure_container.json
msgid ""
"The most secure storage possible, even if it is tiny.  This metaphysical "
"container is unique in that it is the only storage that will keep its "
"contents on death.  Everything else will still be lost."
msgstr ""
"Очень безопасное хранилище, не смотря на то, что оно крошечное.  Этот "
"метафизический контейнер уникален тем, что это единственное хранилище, "
"которое сохранит своё содержимое после смерти.  Всё остальное снаряжение "
"будет потеряно."

#. ~ Description of mutation "Security Alpha"
#: data/mods/Sky_Island/secure_container.json
msgid ""
"You have come into possession of a tiny, ethereal storage container that "
"cannot be removed or destroyed.  It can hold 500 mL and will bring items "
"back to the island with you, even when you die."
msgstr ""
"Вы стали обладателем крошечного неземного контейнера для хранения, который "
"невозможно удалить или уничтожить.  Он вмещает 500 мл и сохранит предметы, "
"даже если вы умрёте."

