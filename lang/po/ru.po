#. ~ Gun mod name
#: data/json/items/gunmod/rail.json
msgid "rail laser sight"
msgid_plural "rail laser sights"
msgstr[0] "лазерный целеуказатель на планку"
msgstr[1] "лазерных целеуказателя на планку"
