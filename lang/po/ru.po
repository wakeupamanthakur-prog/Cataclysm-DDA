msgstr[1] "вторых магазина KSG-25"
msgstr[2] "вторых магазинов KSG-25"
msgstr[3] "вторые магазины KSG-25"

#. ~ Description of gun mod "KSG-25 second magazine"
#: data/json/obsoletion_and_migration_0.I/gun.json
msgid ""
"The integrated second tube magazine of the Kel-Tec KSG-25, which holds 12 "
"shots.  It's irremovable."
msgstr ""
"Интегрированный второй магазин для дробовика Kel-Tec KSG-25 на 12 патронов."
"  Эта модификация не съёмная."

#. ~ Name of a gun
