#. switch statement in nested effect in switch statement in effect in EoC
#. "EOC_mon_reflection_attack"
#: data/json/monster_special_attacks/spells.json
msgid "Something deep inside you is manifested physically."
msgstr "Что-то глубоко внутри вас принимает физическую форму."

#. ~ Spell name
#: data/json/monster_special_attacks/spells.json
msgid "Reflection Revive"
msgstr "Возродить отражение"

#. ~ Description of spell "Reflection Revive"
#: data/json/monster_special_attacks/spells.json
msgid "Revives the reflection."
msgstr "Возраждает отражение."

#. ~ Spell name
#: data/json/monster_special_attacks/spells.json
msgid "Officer banish"
msgstr "Изгнание офицера"

#. ~ Description of spell "Officer banish"
#: data/json/monster_special_attacks/spells.json
msgid "Stops the haunting."
msgstr "Остановит призраков."

#. ~ Spell name
#: data/json/monster_special_attacks/spells.json
msgid "Tainted Shadow Revive"
msgstr "Оживление испорченной тени"

#. ~ Description of spell "Tainted Shadow Revive"
#: data/json/monster_special_attacks/spells.json
msgid "Revives the tainted shadow."
msgstr "Оживляет испорченную тень."

#. ~ Spell name
#: data/json/monster_special_attacks/spells.json
msgid "Hallucination Touch Dissipation"
msgstr "Галлюцинация рассеянного прикосновения"

#. ~ Spell name
#: data/json/monster_special_attacks/spells.json
msgid "Give The Hallucination Effect"
msgstr "Создание эффекта галлюцинации"

#. ~ Description of spell "Give The Hallucination Effect"
#: data/json/monster_special_attacks/spells.json
msgid ""
"Spell that gives the player the effect, that will cause short term "
"hallucination attacks.  You can see it only in debug menu."
msgstr ""
"Заклинание, дающее игроку эффект, вызывающий кратковременные приступы "
"галлюцинаций.  Вы можете увидеть это только в меню отладки."

#. ~ Spell name
#: data/json/monster_special_attacks/spells.json
msgid "flatlander attack"
msgstr "атака флатлендера"

#. ~ Description of spell "flatlander attack"
#: data/json/monster_special_attacks/spells.json
msgid "Dazes the player"
msgstr "Ошеломляет игрока"

#. ~ Spell name
#: data/json/monster_special_attacks/spells.json
msgid "flatlander attack nausea"
msgstr "тошнотворная атака флатлендера"

#. ~ Description of spell "flatlander attack nausea"
#: data/json/monster_special_attacks/spells.json
msgid "Makes enemy nauseous"
msgstr "Вызывает тошноту у врага"

#. ~ Spell name
#: data/json/monster_special_attacks/spells.json
msgid "star vampire invisibility"
msgstr "невидимость звёздного вампира"

#. ~ Description of spell "star vampire invisibility"
#: data/json/monster_special_attacks/spells.json
msgid "Makes the star vampire invisible"
msgstr "Делает звёздного вампира невидимым."

#. ~ Spell name
#: data/json/monster_special_attacks/spells.json
msgid "Sloth Attack"
msgstr "Напасть лени"

#. ~ Description of spell "Sloth Attack"
#: data/json/monster_special_attacks/spells.json
msgid "Slows you."
msgstr "Замедляет вас."

#. ~ Spell name
#: data/json/monster_special_attacks/spells.json
msgid "Life Flashing"
msgstr "Вспышка жизни"

#. ~ Description of spell "Life Flashing"
#: data/json/monster_special_attacks/spells.json
msgid "Brings back memories."
msgstr "Возвращает воспоминания."

#. ~ Spell name
#: data/json/monster_special_attacks/spells.json
msgid "Guilt Attack"
msgstr "Напасть вины"

#. ~ Description of spell "Guilt Attack"
#: data/json/monster_special_attacks/spells.json
msgid "Makes things heavier."
msgstr "Утяжеляет вещи."

#. ~ Spell name
#: data/json/monster_special_attacks/spells.json
msgid "Fear Paralyze"
msgstr "Паралич от страха"

#. ~ Description of spell "Fear Paralyze"
#: data/json/monster_special_attacks/spells.json
msgid "Paralyzes you when you see the creature."
msgstr "Парализует вас, когда вы видите существо."

#. ~ Player message in effect in EoC "EOC_FEAR_PARALYZE2"
#: data/json/monster_special_attacks/spells.json
msgid "The <npc_name> probes your mind, but is rebuffed!"
msgstr "<npc_name> пытается проникнуть в ваш разум, но его отражает!"

#. ~ Player message in effect in EoC "EOC_FEAR_PARALYZE3"
#: data/json/monster_special_attacks/spells.json
msgid "The terrifying visage of the <npc_name> paralyzes you."
msgstr "<npc_name> парализует вас ужасающим видением."

#. ~ Player message in false effect in EoC "EOC_FEAR_PARALYZE3"
#: data/json/monster_special_attacks/spells.json
msgid "You manage to avoid staring at the horrendous <npc_name>."
msgstr "Вы смогли отвести взгляд от ужасающего (<npc_name>)."

#. ~ Spell name
#: data/json/monster_special_attacks/spells.json
msgid "Stare"
msgstr "Взгляд"

#. ~ Description of spell "Stare"
#: data/json/monster_special_attacks/spells.json
msgid "Applies various effects when you see the creature."
msgstr "Накладывает различные эффекты, когда вы видите существо."

#. ~ Player message in effect in EoC "EOC_STARE"
#: data/json/monster_special_attacks/spells.json
#: data/mods/MindOverMatter/effectoncondition/eoc_misc.json
msgid "You feel a strange reverberation across your body."
msgstr "Вы чувствуете странную дрожь по всему телу."

#. ~ Player message in effect in EoC "EOC_STARE2"
#: data/json/monster_special_attacks/spells.json
msgid "The <npc_name> stares at you, and you shudder."
msgstr "<npc_name> пристально смотрит на вас, и вас бросает в дрожь."

#. ~ Player message in false effect in EoC "EOC_STARE2"
#: data/json/monster_special_attacks/spells.json
msgid "You feel like you're being watched, it makes you sick."
msgstr "У вас такое чувство, будто за вами следят, и вам нехорошо от этого."

#. ~ Player message in effect in EoC "EOC_STARE_EFF3"
#. ~ Player message in effect in EoC "EOC_STARE_EFF4"
#: data/json/monster_special_attacks/spells.json
msgid "Your sight darkens as the visions overtake you!"
msgstr "Ваше зрение затемняется, когда вас наполняют образы!"

#. ~ Spell name
#: data/json/monster_special_attacks/spells.json
msgid "Irradiate Player"
msgstr "Радиация игрока"

#. ~ Description of spell "Irradiate Player"
#: data/json/monster_special_attacks/spells.json
msgid "Adds minor radiation to player."
msgstr "Добавляет незначительное облучение игроку."

#. ~ Player message in effect in EoC "EOC_veiled_butterfly_irradiate"
#: data/json/monster_special_attacks/spells.json
msgid ""
"The veiled butterfly's wings move in odd ways and a strange glow envelops "
"you!"
msgstr ""
"Крылья вуальной бабочки причудливо движутся, и вас окутывает странное "
"сияние!"

#. ~ Item name
#: data/json/monster_special_attacks/void_spider_mechanics.json
msgid "void weaver effigy"
msgid_plural "void weaver effigy"
msgstr[0] "чучело ткача пустоты"
msgstr[1] "чучела ткача пустоты"
msgstr[2] "чучел ткача пустоты"
msgstr[3] "чучела ткача пустоты"

#. ~ Description of "void weaver effigy"
#: data/json/monster_special_attacks/void_spider_mechanics.json
msgid "The severed leg of a void weaver, turned into some macabre ornament."
msgstr "Отрубленная нога ткача пустоты, превращённая в жуткое украшение."

#. ~ "description" action message of item "void weaver effigy"
#: data/json/monster_special_attacks/void_spider_mechanics.json
msgid "Touch the effigy."
msgstr "Коснуться чучела."

#. ~ Player message in effect in EoC "VOID_SPIDER_TEST_MAP" in use action of
#. item "void weaver effigy"
#: data/json/monster_special_attacks/void_spider_mechanics.json
msgid "The world warps."
msgstr "Мир искривляется."

#. ~ Monster attack "void_spider_bite" message
#: data/json/monster_special_attacks/void_spider_mechanics.json
#, c-format
msgid ""
"%1$s's immaterial limbs crawl over you and sink their fangs in your %2$s!"
msgstr "Нематериальные конечности %1$s ползают по вам и вонзают клыки в %2$s!"

#. ~ Monster attack "void_spider_bite" message
#: data/json/monster_special_attacks/void_spider_mechanics.json
#, c-format
msgid "%1$s's hanging limbs try to bite you, but you dodge!"
msgstr ""
"%1$s пытается укусить свисающими конечностями вас, но вы уворачиваетесь!"

#. ~ Monster attack "void_spider_bite" message
#: data/json/monster_special_attacks/void_spider_mechanics.json
#, c-format
msgid "%1$s's hanging limbs try to bite <npcname>, but they dodge!"
msgstr "<npcname> уклоняется от свисающих конечностей %1$s!"

#. ~ Monster attack "void_spider_bite" message
#: data/json/monster_special_attacks/void_spider_mechanics.json
#, c-format
msgid ""
"%1$s's hanging limbs try to bite your %2$s, but fails to penetrate your "
"armor!"
msgstr ""
"%1$s пытается укусить свисающими конечностями вас в %2$s, но не может "
"прокусить вашу броню!"

#. ~ Monster attack "void_spider_bite" message
#: data/json/monster_special_attacks/void_spider_mechanics.json
#, c-format
msgid ""
"%1$s's hanging limbs try to bite <npcname>, but fails to penetrate their "
"armor!"
msgstr ""
"%1$s пытается укусить свисающими конечностями <npcname>, но не может "
"прокусить броню!"

#. ~ Spell name
#: data/json/monster_special_attacks/void_spider_mechanics.json
msgid "Void spider emptiness"
msgstr "Пустота пустотного паука"

#. ~ Description of spell "Void spider emptiness"
#. ~ Description of spell "Void spider revert emptiness"
#: data/json/monster_special_attacks/void_spider_mechanics.json
