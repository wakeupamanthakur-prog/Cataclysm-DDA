msgid_plural "kokanee salmon"
msgstr[0] "нерка"
msgstr[1] "нерки"
msgstr[2] "нерок"
msgstr[3] "нерки"

#. ~ Description of monster "kokanee salmon"
#: data/json/monsters/fish.json
msgid ""
"A Kokanee salmon.  A very fatty, nutritious fish.  Tastes great smoked."
msgstr ""
"Один из видов лосося.  Очень жирная и питательная рыба.  Вкуснее всего в "
"копчёном виде."

#. ~ Monster name
#: data/json/monsters/fish.json
