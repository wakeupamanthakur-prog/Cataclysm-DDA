msgid_plural "copies of FM 23-11: 90mm Recoilless Rifle, M67"
msgstr[0] "«FM 23-11: 90mm винтовка без отдачи, M67»"
msgstr[1] "книги «FM 23-11: 90mm винтовка без отдачи, M67»"
msgstr[2] "книг «FM 23-11: 90mm винтовка без отдачи, M67»"
msgstr[3] "книги «FM 23-11: 90mm винтовка без отдачи, M67»"

#. ~ Description of variant "FM 23-11: 90mm Recoilless Rifle, M67" of item
