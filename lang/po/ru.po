msgstr[2] "улиток-переростков"
msgstr[3] "улитки-переростки"

#. ~ Description of monster "oversized snail"
#: data/json/monsters/mollusk.json
msgid ""
"A shelled gastropod either of native or introduced stock.  This one looks "
"larger than usual."
msgstr ""
"Брюхоногий моллюск в панцире.  Этот экземпляр выглядит крупнее обычного."

#. ~ Monster name
#: data/json/monsters/mollusk.json data/mods/Tamable_Wildlife/mollusk.json
