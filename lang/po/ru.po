msgid_plural "grenade hacks"
msgstr[0] "дрон-граната"
msgstr[1] "дрона-гранаты"
msgstr[2] "дронов-гранат"
msgstr[3] "дроны-гранаты"

#. ~ Description of monster "grenade hack"
