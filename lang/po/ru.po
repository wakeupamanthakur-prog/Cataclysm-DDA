#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgctxt "u:m"
msgid "Are you sure?"
msgstr "Ты уверен?"

#. ~ NPC dialogue line
#. ~ You don't need to translate genders that aren't in your language
#. ~ Check: https://github.com/CleverRaven/Cataclysm-
#. DDA/blob/master/doc/TRANSLATING.md#grammatical-gender
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgctxt "u:n"
msgid "Are you sure?"
msgstr "Уверены?"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Yes, I'm sure."
msgstr "Да, мы бросаем лагерь."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
#: data/json/npcs/common_chat/TALK_FRIEND_CONVERSATION.json
msgid "Actually, never mind."
msgstr "Вообще-то забудь."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid " *tshk* Not sure it works when I am that far."
msgstr " *тц* Не думаю, что это получится, когда я так далеко."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Trust me (+10 trust)."
msgstr "Доверяй мне (+10 доверия)."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Do not trust me (-10 trust)."
msgstr "Не доверяй мне (-10 доверия)."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Fear me (+10 fear)."
msgstr "Бойся меня (+10 страха)."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Do not fear me (-10 fear)."
msgstr "Не бойся меня (-10 страха)."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Value me (+10 value)."
msgstr "Цени меня (+10 значимость)."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Do not value me (-10 value)."
msgstr "Не цени меня (-10 значимость)."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Be angry (+10 anger)."
msgstr "Разозлись (+10 гнев)."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Do not be angry (-10 anger)."
msgstr "Не злись (-10 гнев)."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Owe me (+10 owed)."
msgstr "У тебя есть долг передо мной (+10 чувство долга)."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Do not owe me (-10 owed)."
msgstr "У тебя нет долга передо мной (-10 чувство долга)."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Favor me (+10 favors)."
msgstr "Симпатизируй мне (+10 симпатии)."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Do not favor me (-10 favors)."
msgstr "Не симпатизируй мне (-10 симпатии)."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Train me."
msgstr "Обучи меня."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Do a seminar."
msgstr "Проведи тренировочное занятие."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_GREET.json
msgid "Another survivor!  We should travel together."
msgstr "Ещё один выживший!  Нам нужно двигаться вместе."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_GREET.json
#: data/json/npcs/militia/GM_Militia_Guard.json
msgid "What are you doing?"
msgstr "Чем занимаешься?"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_GREET.json
msgid "Put away weapon."
msgstr "Убрать оружие."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_GREET.json
msgid "Drop weapon."
msgstr "Бросить оружие."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_GREET.json
msgid "Don't worry, I'm not going to hurt you"
msgstr "Не волнуйся, я не причиню тебе вреда!"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_GREET.json
msgid "Drop your weapon!"
msgstr "Бросай оружие!"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_GREET.json
msgid "Get out of here or I'll kill you."
msgstr "Проваливай отсюда, или я убью тебя."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_GREET.json
msgid "Hey there, <name_g>."
msgstr "Привет, <name_g>."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_GREET.json
#: data/json/npcs/refugee_center/surface_staff/NPC_free_merchant_guard1.json
msgid "Hello there."
msgstr "Привет."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_GREET.json
msgid "Okay, no sudden movements…"
msgstr "Ладно, не делай резких движений…"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_GREET.json
msgid "Keep your distance!"
msgstr "Не подходи ближе!"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_GREET.json
msgid "This is my territory, <name_b>."
msgstr "Это моя территория, <name_b>."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_GREET.json
msgid "Calm down.  I'm not going to hurt you."
msgstr "Успокойся.  Я не причиню тебе зла."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_GREET.json
msgid "Screw you, no."
msgstr "Иди на хрен, нет."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_GREET.json
msgid "Put hands up."
msgstr "Поднять руки."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_GREET.json
msgid "*drops his weapon."
msgstr "*бросает своё оружие."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_GREET.json
msgid "*drops her weapon."
msgstr "*бросает своё оружие."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_GREET.json
msgid "Now get out of here"
msgstr "А теперь убирайся."

#. ~ NPC dialogue line
#. ~ You don't need to translate genders that aren't in your language
#. ~ Check: https://github.com/CleverRaven/Cataclysm-
#. DDA/blob/master/doc/TRANSLATING.md#grammatical-gender
#: data/json/npcs/common_chat/TALK_COMMON_GREET.json
