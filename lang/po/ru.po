msgstr[0] "огромный пластиковый блок"
msgstr[1] "огромных пластиковых блока"
msgstr[2] "огромных пластиковых блоков"
msgstr[3] "огромные пластиковые блоки"

#. ~ Description of "enormous plastic block"
#: data/json/items/resources/alien.json
msgid ""
