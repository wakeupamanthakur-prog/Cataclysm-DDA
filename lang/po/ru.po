"%1$s вытягивает голову в направлении противника (<npcname>), но отскакивает "
"от препятствия (%2$s)"

#: src/monattack.cpp:4106
#, c-format
msgid ""
"The %s's head extends to bite you, but you dodge and the head sails past!"
msgstr ""
"Голова существа (%s) вытягивается в попытке укусить вас, но не попадает и "
"пролетает мимо!"

#: src/monattack.cpp:4107
#, c-format
msgid ""
"The %s's head extends to bite <npcname>, but they dodge and the head sails "
"past!"
msgstr ""
"Голова существа (%s) вытягивается в попытке укусить противника (<npcname>), "
"но не попадает и пролетает мимо!"

#. ~ 1$s is monster name, 2$s bodypart in accusative
#: src/monattack.cpp:4121
#, c-format
msgid "The %1$s's teeth sink into your %2$s!"
msgstr "Зубы (%1$s) впиваются в вашу часть тела (%2$s)!"

#. ~ 1$s is monster name, 2$s bodypart in accusative
#: src/monattack.cpp:4123
#, c-format
