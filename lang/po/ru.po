msgstr "У вас нет кредитки, чтобы снять денег!"

#: src/iexamine.cpp:818
#, c-format
msgid "Withdraw how much?  Max: %d cent.  (0 to cancel) "
msgid_plural "Withdraw how much?  Max: %d cents.  (0 to cancel) "
msgstr[0] "Сколько снять? Максимум: %d цент. (0 для отмены)"
