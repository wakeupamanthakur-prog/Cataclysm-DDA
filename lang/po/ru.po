msgstr "%s не может стрелять."

#: src/ranged.cpp:653
#, c-format
msgid "Your %s is little more than an awkward club now."
msgstr "%s теперь не более чем неуклюжая дубина."

#: src/ranged.cpp:664
#, c-format
