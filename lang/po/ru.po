#. ~ Item name
#: data/json/items/tool/shelters.json
msgid "tent"
msgid_plural "tents"
msgstr[0] "палатка"
msgstr[1] "палатки"
msgstr[2] "палаток"
msgstr[3] "палатки"

#. ~ Description of "tent"
#: data/json/items/tool/shelters.json
msgid ""
"A small personal tent in a storage bag.  It's just big enough to fit one "
"person comfortably."
msgstr ""
"Небольшая личная палатка в сумке для хранения.  Она достаточно велика, чтобы"
" с комфортом вместить одного человека."

#. ~ Item name
#: data/json/items/tool/shelters.json
msgid "aluminum tent pole"
msgid_plural "aluminum tent poles"
msgstr[0] "алюминиевый столб для палатки"
msgstr[1] "алюминиевых столба для палатки"
msgstr[2] "алюминиевых столбов для палатки"
msgstr[3] "алюминиевые столбы для палатки"

