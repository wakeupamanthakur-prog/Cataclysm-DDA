msgstr "Лёгкая тошнота"

#. ~ Name of effect type id "nausea"
#: data/json/effects.json
msgid "Mildly Nauseous"
msgstr "Слабая тошнота"

#. ~ Name of effect type id "nausea"
#: data/json/effects.json
msgid "Nauseous"
msgstr "Тошнота"

#. ~ Name of effect type id "nausea"
#: data/json/effects.json
msgid "Very Nauseous"
msgstr "Сильная тошнота"

#. ~ Name of effect type id "nausea"
#: data/json/effects.json
msgid "Extremely Nauseous"
msgstr "Очень сильная тошнота"

#. ~ Description of effect type "Slightly Nauseous, Mildly Nauseous, Nauseous,
#. Very Nauseous, Extremely Nauseous"
#: data/json/effects.json
