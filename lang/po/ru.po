msgstr "Вы чувствуете ностальгию, глядя на это фото."

#. ~ Snippet in category "magic_8ball_good"
#: data/json/snippets/snippets.json
msgid "It is certain."
msgstr "Это точно."

#. ~ Snippet in category "magic_8ball_good"
#: data/json/snippets/snippets.json
msgid "It is decidedly so."
msgstr "Это решительно так."

#. ~ Snippet in category "magic_8ball_good"
#: data/json/snippets/snippets.json
msgid "Without a doubt."
msgstr "Без сомнений."

#. ~ Snippet in category "magic_8ball_good"
#: data/json/snippets/snippets.json
msgid "Yes - definitely."
msgstr "Да — однозначно."

#. ~ Snippet in category "magic_8ball_good"
#: data/json/snippets/snippets.json
msgid "You may rely on it."
msgstr "Можете рассчитывать на это."

#. ~ Snippet in category "magic_8ball_good"
#: data/json/snippets/snippets.json
msgid "As I see it, yes."
msgstr "Насколько я вижу, да."

#. ~ Snippet in category "magic_8ball_good"
#: data/json/snippets/snippets.json
msgid "Most likely."
msgstr "Скорее всего."

#. ~ Snippet in category "magic_8ball_good"
#: data/json/snippets/snippets.json
msgid "Outlook good."
msgstr "Перспективы хорошие."

#. ~ Snippet in category "magic_8ball_good"
#: data/json/snippets/snippets.json
msgid "Signs point to yes."
msgstr "Знаки говорят что да."

#. ~ Snippet in category "magic_8ball_unknown"
#: data/json/snippets/snippets.json
msgid "Reply hazy, try again."
msgstr "Ответ туманный, попробуйте ещё раз."

#. ~ Snippet in category "magic_8ball_unknown"
#: data/json/snippets/snippets.json
msgid "Ask again later."
msgstr "Спроси снова чуть позже."

#. ~ Snippet in category "magic_8ball_unknown"
#: data/json/snippets/snippets.json
msgid "Better not tell you now."
msgstr "Лучше не говорить тебе сейчас."

#. ~ Snippet in category "magic_8ball_unknown"
#: data/json/snippets/snippets.json
msgid "Can't predict now."
msgstr "Не могу предугадать сейчас."

#. ~ Snippet in category "magic_8ball_unknown"
#: data/json/snippets/snippets.json
msgid "Concentrate and ask again."
msgstr "Сконцентрируйся и спроси снова."

#. ~ Snippet in category "magic_8ball_bad"
#: data/json/snippets/snippets.json
msgid "Don't count on it."
msgstr "Не рассчитывай на это."

#. ~ Snippet in category "magic_8ball_bad"
#: data/json/snippets/snippets.json
msgid "My reply is no."
msgstr "Мой ответ — нет."

#. ~ Snippet in category "magic_8ball_bad"
#: data/json/snippets/snippets.json
msgid "My sources say no."
msgstr "Мои источники утверждают, что нет."

#. ~ Snippet in category "magic_8ball_bad"
#: data/json/snippets/snippets.json
msgid "Outlook not so good."
msgstr "Перспективы не очень хорошие."

#. ~ Snippet in category "magic_8ball_bad"
#: data/json/snippets/snippets.json
msgid "Very doubtful."
msgstr "Очень сомнительно."

