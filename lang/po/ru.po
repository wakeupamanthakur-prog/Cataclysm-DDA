"************************************************\n"
"*  Copyright (c) Cyma Enterprise Systems 3013  *\n"
"************************************************\n"
"\n"
"Escape Pod Control:"
msgstr ""

#. ~ Response to NPC dialogue
#: data/mods/Aftershock/npcs/computers/escape_pod_control.json
msgid "Ready escape pod."
msgstr ""

#. ~ NPC dialogue line
#: data/mods/Aftershock/npcs/computers/escape_pod_control.json
#, no-c-format
msgid ""
"&************************************************\n"
"\n"
"INTEGRITY CHK : ███████████████ 100% (COMPLETE)\n"
