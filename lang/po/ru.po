msgstr "Вы получаете %2$d урона в %1$s!"

#: src/monattack.cpp:4111
#, c-format
msgid "The %1$s quivers hungrily in the direction of the %2$s."
msgstr "%1$s голодно дёргается в направлении %2$s."

#: src/monattack.cpp:4129
#, c-format
