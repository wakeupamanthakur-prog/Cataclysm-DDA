msgid "back seat"
msgstr "заднее сиденье"

#. ~ Description of vehicle part "back seat"
#: data/json/vehicleparts/seats.json
msgid ""
"A benchlike seat.  Mostly found in the second row, also known as the back or"
" rear seat."
msgstr ""
"Широкое сиденье. Обычно стоит во втором ряду, так же известно как заднее."

#. ~ Vehicle part name
#: data/json/vehicleparts/seats.json
msgid "leather back seat"
msgstr "кожаное заднее сиденье"

#. ~ Description of vehicle part "saddle"
#: data/json/vehicleparts/seats.json
msgid "A padded wedge that you straddle, like a bicycle or motorcycle."
msgstr "Мягкий клин, используемый как сиденье на велосипеде или мотоцикле."

#. ~ Label of vehicle part variant "pedal"
