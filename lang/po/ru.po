msgid "Select an appliance."
msgstr "Выберите технику."

#: src/iuse.cpp:8107
msgid "There is no appliance nearby."
msgstr "Поблизости нет никакой техники."

#: src/iuse.cpp:8109
msgid "You haven't selected any appliance."
msgstr "Вы не выбрали никакую технику."

#: src/iuse.cpp:8114
msgid "This isn't an appliance."
msgstr "Это не техника."

#: src/iuse.cpp:8126
msgid "The appliance doesn't have a proper heater."
msgstr "Техника не имеет должного нагревателя."

#: src/iuse.cpp:8130
msgid "Select a built-in heater."
msgstr "Выберите встроенный нагреватель."

#: src/iuse.cpp:8136
msgid "You haven't selected any heater."
msgstr "Вы не выбрали никакой нагреватель."

#: src/iuse.cpp:8162
#, c-format
msgid "You put %1$s on fire to start heating."
msgstr "Вы кладёте %1$s на огонь и начинаете разогревать."

#: src/iuse.cpp:8166 src/iuse.cpp:8168 src/iuse.cpp:8171
#, c-format
msgid "You use %1$s to start heating."
msgstr "Вы начинаете разогревать с помощью %1$s."

#: src/iuse.cpp:8173
#, c-format
msgid "The %s has been used up."
msgstr "%s использовано до конца."

#: src/iuse.cpp:8193
msgid "Select a tool to heat (or cancel to select an appliance):"
msgstr ""
"Выберите инструмент для нагрева (или отмените, чтобы выбрать технику):"

#: src/iuse.cpp:8195
msgid ""
"You don't have a proper heating tool.  Try selecting an appliance with a "
"heater."
msgstr ""
"У вас нет должного нагревательного прибора.  Попробуйте выбрать технику с "
"нагревателем."

#: src/iuse.cpp:8209
msgid "The appliance doesn't have enough power."
msgstr "В технике недостаточно энергии."

#: src/iuse.cpp:8214
#, c-format
msgid "You put %1$s on %2$s to start heating."
msgstr "Вы кладёте %1$s на %2$s и начинаете разогревать."

