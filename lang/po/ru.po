#. ~ Monster name
#: data/json/monsters/misc.json
msgid "weak debug grabber"
msgid_plural "weak debug grabbers"
msgstr[0] "отладочный хвататель (слабый)"
msgstr[1] "отладочных хватателя (слабый)"
msgstr[2] "отладочных хватателей (слабый)"
msgstr[3] "отладочные хвататели (слабый)"

#. ~ Description of monster "weak debug grabber"
#: data/json/monsters/misc.json
msgid ""
"This monster exists only for grab testing purposes.  Same grab strength as a"
" basic zombie."
msgstr ""
"Этот монстр существует только для целей тестирования захвата.  Сила захвата "
"такая же, как у обычного зомби."

#. ~ Monster name
#: data/json/monsters/misc.json
msgid "middle-strength debug grabber"
msgid_plural "middle-strength debug grabbers"
msgstr[0] "отладочный хвататель (средний)"
msgstr[1] "отладочных хватателя (средний)"
msgstr[2] "отладочных хватателей (средний)"
msgstr[3] "отладочные хвататели (средний)"

