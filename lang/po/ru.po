msgid_plural "inactive autonomous M240 CROWS II turrets"
msgstr[0] "неактивная автономная M240 CROWS II"
msgstr[1] "неактивные автономные M240 CROWS II"
msgstr[2] "неактивных автономных M240 CROWS II"
msgstr[3] "неактивные автономные M240 CROWS II"

