msgstr "Мутация лягушки"

#. ~ Name of effect type id "mutagen_batrachian"
#: data/json/effects.json
msgid "Frog Transformation"
msgstr "Трансформация лягушки"

#. ~ Name of effect type id "mutagen_batrachian"
#: data/json/effects.json
msgid "Frog Metamorphosis"
msgstr "Метаморфоза лягушки"

#. ~ Description of effect type "Frog Mutation"
#: data/json/effects.json
