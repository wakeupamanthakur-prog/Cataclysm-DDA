#. nested EOCs in effect in EoC "afs_motion_sensor_eoc"
#: data/mods/Aftershock/effects_on_condition.json
msgid "The motion detector whines distressingly!"
msgstr "Датчик движения издает пронзительный звук!"

#. ~ Player message in effect in EoC "afs_motion_sensor_audio_warning_medium"
