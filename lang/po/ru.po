msgid "As you unleash your powers, you feel enervated."
msgstr ""

#. ~ Player message in effect in EoC "EOC_AFS_ESPER_STUNNED_ENDS_POWERS"
#. ~ Player message in effect in EoC "EOC_PSIONICS_STUNNED_ENDS_POWERS"
