msgstr[2] "машинок на РУ (вкл)"
msgstr[3] "машинки на РУ (вкл)"

#. ~ Description of "RC car (on)"
#: data/json/items/tool/radio_tools.json
msgid ""
"A remote-controlled toy car.  It is turned on and draining its batteries "
"just like a real electric car!  Use a remote control to drive it around."
msgstr ""
"Игрушечная машинка с дистанционным управлением.  Она включается и разряжает "
"аккумуляторы, как настоящий электромобиль!  Управляйте ею с помощью пульта "
"дистанционного управления."

#. ~ "sound_message" action message of item "RC car (on)"
#: data/json/items/tool/radio_tools.json
msgid "buzzz…"
msgstr "бжжжж…"

#. ~ Item name
#: data/json/items/tool/radio_tools.json
msgid "radio activation mod"
