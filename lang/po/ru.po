#: data/json/effects.json
#: data/mods/MindOverMatter/effects/effects_penalty.json
msgid "You feel awful!"
msgstr "Вы чувствуете себя ужасно!"

#. ~ Remove message of effect type "Mutagenic Slurry"
#: data/json/effects.json
msgid "You're feeling a little better now."
msgstr "Вы чувствуете себя немного лучше."

