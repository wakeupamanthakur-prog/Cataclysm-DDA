#. ~ default value for place name in effect in EoC "EOC_IN_VOID_SPIDER_LAIR"
#: data/json/monster_special_attacks/void_spider_mechanics.json
msgid "strange cavern"
msgstr "странная пещера"

#. ~ Player message in effect in EoC "webbed_place_void_spider" in nested EOCs
#. in effect in EoC "EOC_IN_VOID_SPIDER_LAIR"
#. ~ Player message in effect in EoC "time_place_void_spider" in nested EOCs
#. in effect in EoC "EOC_IN_VOID_SPIDER_LAIR"
#: data/json/monster_special_attacks/void_spider_mechanics.json
