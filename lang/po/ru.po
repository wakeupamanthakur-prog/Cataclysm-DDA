msgstr ""
"%1$s бросается на противника (<npcname> - %2$s), нанеся урон в %3$d единиц!"

#: src/monattack.cpp:4342
#, c-format
msgid "The %1$s lunges at your %2$s, but your armor prevents injury!"
msgstr ""
"%1$s бросается на вас (%2$s), но ваша броня предотвратила нанесение урона!"

#: src/monattack.cpp:4343
#, c-format
