msgid_plural ".45 Luty submachine guns"
msgstr[0] "пистолет-пулемёт .45 Luty"
msgstr[1] "пистолет-пулемёта .45 Luty"
msgstr[2] "пистолет-пулемётов .45 Luty"
msgstr[3] "пистолет-пулемёты .45 Luty"

