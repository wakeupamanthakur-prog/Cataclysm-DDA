#. ~ Spell name
#: data/json/monster_special_attacks/spells.json
msgid "Boomer Suicide Spell"
msgstr "Суицидное заклинание Бумера"

#. ~ Spell name
#: data/json/monster_special_attacks/spells.json
msgid "Twisting Blade Attack"
msgstr "Атака вращающимся лезвием"

#. ~ Spell name
#: data/json/monster_special_attacks/spells.json
msgid "Swarm Structure Action"
msgstr "Действие структуры роя"

#. ~ Description of spell "Swarm Structure Action"
#: data/json/monster_special_attacks/spells.json
msgid "Teleports and summons monsters."
msgstr "Телепортирует и призывает монстров."

#. ~ Spell name
#: data/json/monster_special_attacks/spells.json
msgid "Reflection Action"
msgstr "Действие отражения"

#. ~ Description of spell "Reflection Action"
#: data/json/monster_special_attacks/spells.json
msgid "Teleports and harms monsters."
msgstr "Телепортирует и наносит урон монстрам."

#. ~ Player message in nested effect in switch statement in effect in EoC
#. "EOC_mon_reflection_attack"
#: data/json/monster_special_attacks/spells.json
msgid "Your reflection feasts directly on your essence."
msgstr "Ваше отражение питается самой вашей сущностью."

#. ~ Player message in nested effect in switch statement in effect in EoC
#. "EOC_mon_reflection_attack"
#: data/json/monster_special_attacks/spells.json
msgid "Your reflection uses your bond to feast on your essence."
msgstr ""
"Ваше отражение использует вашу связь, чтобы напитаться вашей сущностью."

#. ~ Player message in nested effect in switch statement in nested effect in
#. switch statement in effect in EoC "EOC_mon_reflection_attack"
#: data/json/monster_special_attacks/spells.json
msgid "Your reflection clears the way between you two."
msgstr "Ваше отражение расчищает путь между вами двумя."

#. ~ Player sees monster spawns in effect in EoC
#. "portal_storm_reflection_summon_guilt" in nested EOCs in nested effect in
#. switch statement in nested effect in switch statement in effect in EoC
#. "EOC_mon_reflection_attack"
#. ~ Player sees monster spawns in effect in EoC
