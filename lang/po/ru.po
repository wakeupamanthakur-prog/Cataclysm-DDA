#. ~ Item name
#: data/mods/Aftershock/items/casing.json
msgid "5x50mm hull"
msgid_plural "5x50mm hulls"
msgstr[0] "гильза 5x50 мм"
msgstr[1] "гильзы 5x50 мм"
