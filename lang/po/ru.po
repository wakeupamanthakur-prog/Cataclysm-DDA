#. ~ Description of "straw hat"
#: data/json/items/armor/hats.json
msgid ""
"A hat woven out of straw.  Its brim helps keep the sun out of your eyes."
msgstr "Сплетённая из соломы шляпа.  Её поля защищают глаза от солнца."

#. ~ Item name
#: data/json/items/armor/hats.json
msgid "tinfoil hat"
msgid_plural "tinfoil hats"
msgstr[0] "шапочка из фольги"
msgstr[1] "шапочки из фольги"
msgstr[2] "шапочек из фольги"
msgstr[3] "шапочки из фольги"

#. ~ Description of "tinfoil hat"
#: data/json/items/armor/hats.json
msgid ""
"A sheet of aluminum foil that has been molded into a form-fitting hat.  "
"Perfect for protecting yourself from the government, Illuminati, aliens, and"
" THEM."
msgstr ""
"Лист алюминиевой фольги, сложенный в виде шапочки.  Идеально подходит для "
"защиты от правительства, иллюминатов, инопланетян и от НИХ."

#. ~ Item name
#: data/json/items/armor/hats.json
msgid "top hat"
msgid_plural "top hats"
