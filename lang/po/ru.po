msgstr "Деревянная стена, окрашенная в красный."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "white wood wall"
msgstr "белая деревянная стена"

#. ~ Description of terrain "white wood wall"
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "A wooden wall, painted white."
msgstr "Деревянная стена, окрашенная в белый."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "purple wood wall"
msgstr "фиолетовая деревянная стена"

#. ~ Description of terrain "purple wood wall"
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "A wooden wall, painted purple."
msgstr "Деревянная стена, окрашенная в фиолетовый."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "pink wood wall"
msgstr "розовая деревянная стена"

#. ~ Description of terrain "pink wood wall"
