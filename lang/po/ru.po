#: data/json/effects.json
msgid "Plant Mutation"
msgstr "Мутация растения"

#. ~ Name of effect type id "mutagen_plant"
#: data/json/effects.json
msgid "Plant Transformation"
msgstr "Трансформация растения"

#. ~ Description of effect type "Plant Metamorphosis, Plant Mutation, Plant
#. Transformation"
#: data/json/effects.json
msgid ""
"All this running… why don't you just find a nice, fertile spot and bask in "
"the sun?"
msgstr ""
"Вся эта суета... почему бы тебе просто не найти хорошее, плодородное место и"
" не погреться на солнышке?"

#. ~ Description of effect type "Plant Metamorphosis, Plant Mutation, Plant
#. Transformation"
#: data/json/effects.json
msgid "You consumed plant primer."
msgstr "Вы употребили праймер растения."

#. ~ Description of effect type "Plant Metamorphosis, Plant Mutation, Plant
#. Transformation"
#: data/json/effects.json
