#: data/json/effects.json
msgid "Mouse Mutation"
msgstr "Мутация мыши"

#. ~ Name of effect type id "mutagen_mouse"
#: data/json/effects.json
msgid "Mouse Transformation"
msgstr "Трансформация мыши"

#. ~ Description of effect type "Mouse Metamorphosis, Mouse Mutation, Mouse
#. Transformation"
#: data/json/effects.json
msgid "You consumed mouse primer."
msgstr "Вы употребили праймер мыши."

#. ~ Description of effect type "Mouse Metamorphosis, Mouse Mutation, Mouse
#. Transformation"
#: data/json/effects.json
msgid "Your heart hammers away with a rapid, irregular beat."
msgstr "Ваше сердце бьется неравномерно и очень быстро."

