msgid "Barry!  You're okay!"
msgstr "Барри!  Ты в порядке!"

#. ~ NPC dialogue line
#: data/json/npcs/isherwood_farm/Isherwood_Rescue_NPC_Duplicates.json
msgid "Oh god, oh thank god.  Let's get Barry out of here."
msgstr "О боже, слава богу.  Давай вытащим Барри оттуда."

#. ~ NPC dialogue line
#: data/json/npcs/isherwood_farm/Isherwood_Rescue_NPC_Duplicates.json
msgid "What's up?  Change of plans?"
msgstr "В чём дело?  Смена планов?"

#. ~ NPC dialogue line
#: data/json/npcs/isherwood_farm/Isherwood_Rescue_NPC_Duplicates.json
msgid "Everything OK?"
msgstr "Всё в порядке?"

#. ~ NPC dialogue line
#: data/json/npcs/isherwood_farm/Isherwood_Rescue_NPC_Duplicates.json
msgid "Not really a good time for a chat."
msgstr "Не самое подходящее время для разговоров."

#. ~ NPC dialogue line
#: data/json/npcs/isherwood_farm/Isherwood_Rescue_NPC_Duplicates.json
msgid "I can't believe this is happening."
msgstr "Поверить не могу, что это всё происходит."

#. ~ Response to NPC dialogue
#: data/json/npcs/isherwood_farm/Isherwood_Rescue_NPC_Duplicates.json
msgid "We've got him, let's get out of here."
msgstr "Он с нами, теперь валим отсюда."

#. ~ Response to NPC dialogue
#: data/json/npcs/isherwood_farm/Isherwood_Rescue_NPC_Duplicates.json
msgid "Right.  Let's do this."
msgstr "Верно.  Вперёд."

