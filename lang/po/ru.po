#. ~ Speech from speaker foodperson_mask, mon_mi_go, mon_mi_go_slaver
#: data/json/speech.json
msgid "\"♪Eat at Foodplace.  ♫It is a place with food.♪\""
msgstr "«♪Зайди в Сядь-и-поешь. ♫Здесь полно еды.♪»"

#. ~ Speech from speaker foodperson_mask, mon_mi_go, mon_mi_go_slaver
#: data/json/speech.json
