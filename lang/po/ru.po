msgstr ""

#. ~ Terrain name
#: data/mods/Xedra_Evolved/furniture_and_terrain/terrain-stairs.json
msgid "earthen stairs"
msgstr "земляная лестница"

#. ~ Description of terrain "earthen stairs"
#: data/mods/Xedra_Evolved/furniture_and_terrain/terrain-stairs.json
msgid "A set of stone and dirt steps leading up."
msgstr "Ступеньки из камня и земли ведут вверх."

#. ~ Description of terrain "earthen stairs"
#: data/mods/Xedra_Evolved/furniture_and_terrain/terrain-stairs.json
