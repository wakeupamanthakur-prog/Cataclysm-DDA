msgid "A trap that summons forge hounds!  Not what you were expecting, is it?"
msgstr "Капкан, призывающий гончих кузни!  Этого вы не ожидали, правда?"

#. ~ Spell name
#: data/mods/Magiclysm/Spells/monsterspells.json
msgid "Rocket Punch"
msgstr "Ракетный удар"

#. ~ Description of spell "Rocket Punch"
#: data/mods/Magiclysm/Spells/monsterspells.json
msgid "Ejects giant fist from arm."
msgstr "Стреляет огромным кулаком из кисти."

#. ~ Spell name
