msgid "Pick the lock"
msgstr "Взломать замок"

#: src/iexamine.cpp:1858
msgid "Pry open"
msgstr "Взломать"

#: src/iexamine.cpp:1870
#, c-format
msgid "The %s is locked.  You could pry it open with the right tool…"
msgstr "Это (%s) закрыто. Можно было бы взломать подходящим инструментом."

