msgstr "%s появляется!"

#: src/monattack.cpp:4020
msgid "He's brandishing a knife!"
msgstr "Он размахивает ножом!"

#: src/monattack.cpp:4021
msgid "Quiet, quiet"
msgstr "Тихо, тихо"

#: src/monattack.cpp:4047
msgid "a terrifying roar!"
msgstr "ужасающий рёв!"

#: src/monattack.cpp:4057
#, c-format
msgid "The %1$s swings a massive claw at %2$s!"
msgstr "%1$s замахивается на %2$s массивной клешнёй!"

#. ~ 1$s is bodypart name, 2$d is damage value.
#: src/monattack.cpp:4080
#, c-format
