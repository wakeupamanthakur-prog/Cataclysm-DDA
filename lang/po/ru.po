msgstr ""
"%s заперт. Если бы только у вас был подходящий для вскрытия инструмент…"

#: src/iexamine.cpp:1942
#, c-format
msgid "Pick the lock of %1$s using your %2$s?"
msgstr "Взломать замок (%1$s), используя инструмент (%2$s)?"

#: src/iexamine.cpp:1947
#, c-format
msgid "You attempt to pick the lock of %1$s using your %2$s…"
msgstr "Вы пытаетесь взломать замок (%1$s) при помощи инструмента (%2$s)…"

