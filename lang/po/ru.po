msgstr[2] "защитных забрал"
msgstr[3] "защитные забрала"

#. ~ Description of "shield visor"
#: data/json/items/armor/head_attachments.json
msgid "A common shield visor intended to be attached on a hard hat or helmet."
msgstr "Обычное забрало, предназначенное для прикрепления к каске или шлему."

#. ~ Item name
#: data/json/items/armor/head_attachments.json
msgid "face shield"
