#: data/mods/Magiclysm/Spells/earthshaper.json
msgid "Reactive Armour"
msgstr ""

#. ~ Description of spell "Reactive Armour"
#. ~ Earthshaper spell
#. ~ Description of "Scroll of Reactive Armour"
#: data/mods/Magiclysm/Spells/earthshaper.json
#: data/mods/Magiclysm/items/spell_scrolls.json
