msgstr[2] "магазинов крупнокалиберной винтовки"
msgstr[3] "магазины крупнокалиберной винтовки"

#. ~ Description of magazine "anti-materiel rifle magazine"
#: data/mods/Generic_Guns/magazines/rifle_huge.json
