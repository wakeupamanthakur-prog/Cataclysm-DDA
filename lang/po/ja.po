msgstr "頼みを聞いてあげたんだけど..."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "I'll give it back!"
msgstr "後で絶対返すから！"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Give it to me, or else!"
msgstr "いいから早く渡せよ。"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Eh, never mind."
msgstr "ええと、何でもない。"

#. ~ Response to NPC dialogue
