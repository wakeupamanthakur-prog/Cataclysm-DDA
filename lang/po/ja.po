#. ~ Spell name
#: data/mods/MindOverMatter/monsters/monsters_spells.json
msgid "[Ψ]Fountain of Flames Monster"
msgstr "[Ψ]ﾌｧｳﾝﾃﾝ･ｵﾌﾞ･ﾌﾚｲﾑｽﾞ(モンスター専用)"

