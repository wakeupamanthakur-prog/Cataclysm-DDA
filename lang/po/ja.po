msgstr "地球外の植物が生い茂っています。"

#. ~ Name of map extra
#: data/mods/MindOverMatter/overmap/map_extras.json
msgid "pool of dark water"
msgstr "黒い水溜り"

#. ~ Description of map extra "pool of dark water"
#: data/mods/MindOverMatter/overmap/map_extras.json
msgid "A pool of some unearthly liquid."
msgstr "正体不明の不気味な液体が溜まっています。"

#. ~ Name of map extra
#: data/mods/MindOverMatter/overmap/map_extras.json
msgid "Suspicious stand of trees"
msgstr "奇妙な並木"

#. ~ Description of map extra "Suspicious stand of trees"
#: data/mods/MindOverMatter/overmap/map_extras.json
