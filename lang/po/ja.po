#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Why should I travel with you?"
msgstr "何故、一緒に旅をする必要があるんだ？"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Understood.  I'll get those antibiotics."
msgstr "分かった。抗生物質を手に入れる。"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Right, right, I'll ask later."
msgstr "ああ、そうだった。また今度にするよ。"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "I can keep you safe."
msgstr "あなたを護衛しよう。"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "You can keep me safe."
msgstr "私を護衛してほしいんだ。"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "I'll kill you if you don't."
msgstr "言う通りにしなければ殺す。"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "You got it, I'm with you!"
msgstr "分かった、一緒に行こう！"

#. ~ Response to NPC dialogue
#. ~ Snippet in category "<good_job>"
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#: data/mods/BombasticPerks/perkdata/praise.json
