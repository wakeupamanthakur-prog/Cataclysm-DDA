#. ~ Name of effect type id "mutagen_chiropteran"
#: data/json/effects.json
msgid "Chiropteran Transformation"
msgstr "変異(コウモリ)"

#. ~ Name of effect type id "mutagen_chiropteran"
#: data/json/effects.json
msgid "Chiropteran Metamorphosis"
msgstr "急変(コウモリ)"

#. ~ Description of effect type "Chiropteran Mutation"
#: data/json/effects.json
msgid "You consumed chiropteran primer."
msgstr "コウモリの変異源プライマーを摂取しました。"

#. ~ Description of effect type "Chiropteran Transformation"
