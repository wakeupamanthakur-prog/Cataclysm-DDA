#, c-format
msgid "The %s shocks you!"
msgstr "%sの電流攻撃を受けました！"

#: src/monattack.cpp:2924
#, c-format
msgid "The %s shocks <npcname>!"
msgstr "<npcname>が%sの電流攻撃を受けました！"

#: src/monattack.cpp:3152
msgid "a robotic voice boom, \"Citizen, Halt!\""
msgstr "[響き渡る機械音声]「市民、止まりなさい！」"

#: src/monattack.cpp:3155
msgid "a robotic voice boom, \"Please put down your weapon.\""
msgstr "[響き渡る機械音声]「持っている武器をその場に置いて下さい。」"

#: src/monattack.cpp:3159
msgid "a robotic voice boom, \"Come out with your hands up!\""
msgstr "[響き渡る機械音声]「手を挙げろ！」"

#: src/monattack.cpp:3163
msgid "a police siren, whoop WHOOP"
msgstr "[警察のサイレン]ウー！ウー！"

#: src/monattack.cpp:3194
msgid "\"YOU… ARE FILTH…\""
msgstr "「...汚らわしき者よ...」"

#: src/monattack.cpp:3197
msgid "\"VERMIN… YOU ARE VERMIN…\""
msgstr "「虫けら...貴様は虫けらだ...」"

#: src/monattack.cpp:3200
msgid "\"LEAVE NOW…\""
msgstr "「立ち去れ...」"

#: src/monattack.cpp:3203
msgid "\"WE… WILL FEAST… UPON YOU…\""
msgstr "「貴様を...我らの...晩餐としてやろう...」"

#: src/monattack.cpp:3206
