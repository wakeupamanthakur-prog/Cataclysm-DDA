msgid "5.45x39mm, black powder"
msgid_plural "5.45x39mm, black powder"
msgstr[0] "弾薬(5.45mm/黒色火薬)"

#. ~ Description of "5.45x39mm, black powder"
#: data/json/items/ammo/545x39.json
msgid ""
