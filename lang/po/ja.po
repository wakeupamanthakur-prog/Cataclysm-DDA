"&Cyma Interface [version 2.85.1004]\n"
"************************************************\n"
"*  Copyright (c) Cyma Enterprise Systems 3013  *\n"
"************************************************\n"
"\n"
"Escape Pod Control:"
msgstr ""
"&Cyma インターフェース [バージョン 2.85.1004]\n"
"************************************************\n"
"*  Copyright (c) Cyma Enterprise Systems 3013  *\n"
"************************************************</color>\n"
"\n"
"脱出ポッド制御:"

#. ~ Response to NPC dialogue
#: data/mods/Aftershock/npcs/computers/escape_pod_control.json
msgid "Ready escape pod."
msgstr "脱出ポッド射出準備開始。"

#. ~ NPC dialogue line
#: data/mods/Aftershock/npcs/computers/escape_pod_control.json
#, no-c-format
msgid ""
"&************************************************\n"
"\n"
"INTEGRITY CHK : ███████████████ 100% (COMPLETE)\n"
