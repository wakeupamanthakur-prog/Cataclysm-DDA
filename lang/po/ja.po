#. ~ NPC dialogue line
#: data/mods/Defense_Mode/dialogue/menu_screen.json
msgid ""
"We have a grand variety of preselected game modes for you to choose from!  "
"Pick one and play now!"
msgstr "あらかじめ設定された様々なゲームモードの中から選ぶことができます！気になったものを選んでプレイしましょう！"

#. ~ Response to NPC dialogue
#: data/mods/Defense_Mode/dialogue/menu_screen.json
msgid ""
"<color_yellow>Shaun of The Dead</color>: (Defend a bar against classic "
"zombies with your five friends.  Easy and fun.)"
msgstr ""
"<color_yellow>ショーン・オブ・ザ・デッド</color>: "
"(5人の仲間と共に、古典的なゾンビから酒場を守り抜きましょう。簡単で楽しいモードです。)"

#. ~ Response to NPC dialogue
#: data/mods/Defense_Mode/dialogue/menu_screen.json
msgid ""
"<color_yellow>Dawn of The Dead</color>: (Classic zombies only, slower and "
"more realistic.)"
msgstr "<color_yellow>ドーン・オブ・ザ・デッド</color>: (速度が遅く本物らしい、古典的なゾンビのみ出現します。)"

#. ~ Response to NPC dialogue
#: data/mods/Defense_Mode/dialogue/menu_screen.json
msgid ""
"<color_yellow>Eight-Legged Freaks</color>: (Hordes of spiders!  Not "
"arachnophobia friendly!)"
msgstr "<color_yellow>スパイダーパニック！</color>: (クモの大群が出現します！クモ恐怖症の人には辛い！)"

#. ~ Response to NPC dialogue
#: data/mods/Defense_Mode/dialogue/menu_screen.json
msgid ""
"<color_yellow>Day of The Triffids</color>: (Protect your mansion against the"
" triffids.)"
msgstr "<color_yellow>トリフィドの日</color>: (大邸宅をトリフィドから守り抜きましょう。)"

#. ~ Response to NPC dialogue
#: data/mods/Defense_Mode/dialogue/menu_screen.json
msgid ""
"<color_yellow>Skynet</color>: (Robots have decided that humans are the "
"enemy!)"
msgstr "<color_yellow>スカイネット</color>: (ロボットたちが人類を敵とみなしました！)"

#. ~ Response to NPC dialogue
#: data/mods/Defense_Mode/dialogue/menu_screen.json
msgid ""
"<color_yellow>The Call of Cthulhu</color>: (Fend off hordes of eldritch "
"horrors.)"
msgstr "<color_yellow>クトゥルフの呼び声</color>: (名状しがたい怪物の群れを撃退しましょう。)"

#. ~ NPC dialogue line
#: data/mods/Defense_Mode/dialogue/menu_screen.json
msgid ""
"Please alter these game options as you wish, make the experience just like "
"you want it."
msgstr "ゲーム設定を必要に応じ。変更し、希望に沿ったゲームを体験してください。"

#. ~ Response to NPC dialogue
#: data/mods/Defense_Mode/dialogue/menu_screen.json
