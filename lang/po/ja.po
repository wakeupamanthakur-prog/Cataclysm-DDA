#: src/projectile.cpp:250
#, c-format
msgid "<npcname> is hit by %s %s, %s."
msgstr "<npcname>に%s%sが命中し、%s。"

#. ~ Phrase describing getting hit by multiple projectiles, i.e. "The zombie
#. is hit by many bomb fragments, dealing 50 damage."
#: src/projectile.cpp:254
#, c-format
msgid "%s is hit by %s %s, %s."
