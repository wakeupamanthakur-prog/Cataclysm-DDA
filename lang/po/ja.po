msgstr "25mm弾"

#. ~ Name of an ammunition type
#: data/mods/Aftershock/items/ammo_type.json
msgid "25mm microjet"
msgstr "25mm誘導弾"

#. ~ Name of an ammunition type
#: data/mods/Aftershock/items/ammo_type.json
msgid "10mm"
msgstr "10mm弾"

#. ~ Name of an ammunition type
#: data/mods/Aftershock/items/ammo_type.json
msgid "10mm microjet"
msgstr "10mm誘導弾"

#. ~ Name of an ammunition type
