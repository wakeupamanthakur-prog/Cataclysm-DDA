msgstr "オフィスの回転イスなどに付いている、旋回可能な小型ホイール一式です。"

#. ~ Vehicle part name
#: data/json/vehicleparts/wheel.json
msgid "large casters"
msgstr "キャスターL"

#. ~ Description of vehicle part "large casters"
#: data/json/vehicleparts/wheel.json
msgid "A set of wheels, mounted on pivots, like the ones on a grocery cart."
msgstr "食料品店のカートなどに付いている、旋回可能なホイール一式です。"

#. ~ Vehicle part name
#: data/json/vehicleparts/wheel.json
msgid "skateboard wheels"
msgstr "スケートボードホイール"

#. ~ Vehicle part name
#: data/json/vehicleparts/wheel.json
msgid "skateboard trucks"
msgstr "スケートボードトラック"

#. ~ Description of vehicle part "skateboard trucks"
#: data/json/vehicleparts/wheel.json
msgid "A pair of skateboard trucks, for attaching wheels to."
msgstr "ホイールを取り付けるための、一組のスケートボードトラックです。"

#. ~ Vehicle part name
#: data/json/vehicleparts/wheel.json
msgid "wheels"
msgstr "ホイール"

#. ~ Description of vehicle part "wheels"
#: data/json/vehicleparts/wheel.json
msgid "A set of 10\" wheels with tough rubber tires."
msgstr "頑丈なゴム製タイヤを備えた一組の10インチホイールです。"

#. ~ Description of vehicle part "motorbike wheel"
#: data/json/vehicleparts/wheel.json
msgid "A small wheel from a motorcycle."
msgstr "バイク用の小型ホイールです。"

