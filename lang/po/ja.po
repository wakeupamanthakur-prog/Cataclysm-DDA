msgid_plural "Nicaraguan flags"
msgstr[0] "国旗(ﾆｶﾗｸﾞｱ)"

#. ~ Description of variant "Nicaraguan flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid ""
"A flag that features a horizontal triband of azure and white with the coat "
"of arms centered on the white band."
msgstr "空色と白色で横に三分された旗の中央に国の紋章が描かれています。"

#. ~ Variant name of item "national flag"
#: data/json/items/armor/cloaks.json
