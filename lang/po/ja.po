msgstr "変化(マウス)"

#. ~ Name of effect type id "mutagen_mouse"
#: data/json/effects.json
msgid "Mouse Transformation"
msgstr "変異(マウス)"

#. ~ Name of effect type id "mutagen_mouse"
#: data/json/effects.json
msgid "Mouse Metamorphosis"
msgstr "急変(マウス)"

#. ~ Description of effect type "Mouse Mutation"
#: data/json/effects.json
msgid "You consumed mouse primer."
msgstr "マウスの変異原プライマーを摂取しました。"

#. ~ Description of effect type "Mouse Transformation"
#: data/json/effects.json
msgid ""
"Your heart pounds, knowing that predators could approach at any second!"
msgstr "今にも肉食獣に襲われるような気がして、動悸が治まりません！"

#. ~ Description of effect type "Mouse Metamorphosis"
#: data/json/effects.json
msgid "Your heart hammers away with a rapid, irregular beat."
msgstr "心臓が忙しなく不規則に拍動しています。"

#. ~ Name of effect type id "mutagen_plant"
#: data/json/effects.json
msgid "Plant Mutation"
msgstr "変化(植物)"

#. ~ Name of effect type id "mutagen_plant"
#: data/json/effects.json
msgid "Plant Transformation"
msgstr "変異(植物)"

#. ~ Name of effect type id "mutagen_plant"
#: data/json/effects.json
msgid "Plant Metamorphosis"
msgstr "急変(植物)"

#. ~ Description of effect type "Plant Mutation"
#: data/json/effects.json
msgid "You consumed plant primer."
msgstr "植物の変異源プライマーを摂取しました。"

#. ~ Description of effect type "Plant Transformation"
#: data/json/effects.json
msgid ""
"All this running… why don't you just find a nice, fertile spot and bask in "
"the sun?"
msgstr "誰も彼も忙しなく動いてばかり...肥沃な大地で日向ぼっこなんて、いい考えだと思いませんか？"

#. ~ Description of effect type "Plant Metamorphosis"
#: data/json/effects.json
msgid "Your processes are slowing.  You would make great fertilizer."
msgstr "動作が鈍くなっているように感じます。効き目の強い肥料ですね。"

#. ~ Name of effect type id "mutagen_raptor"
#: data/json/effects.json
msgid "Raptor Mutation"
msgstr "変化(ラプトル)"

#. ~ Name of effect type id "mutagen_raptor"
#: data/json/effects.json
msgid "Raptor Transformation"
msgstr "変異(ラプトル)"

#. ~ Name of effect type id "mutagen_raptor"
#: data/json/effects.json
msgid "Raptor Metamorphosis"
msgstr "急変(ラプトル)"

#. ~ Description of effect type "Raptor Mutation"
#: data/json/effects.json
msgid "You consumed raptor primer."
msgstr "ラプトルの変異源プライマーを摂取しました。"

#. ~ Description of effect type "Raptor Transformation"
#: data/json/effects.json
msgid ""
"Sharpen your talons and clean your feathers.  Your prey won't give itself "
"easily."
msgstr "爪を研ぎ、羽を繕いましょう。獲物は決して逃がしません。"

#. ~ Description of effect type "Raptor Metamorphosis"
#: data/json/effects.json
msgid "Delusions fill your head… is it true?  Did you die long ago?"
msgstr "頭の中が妄想で埋め尽くされています...これは？太古の絶滅の記憶？"

#. ~ Name of effect type id "mutagen_rabbit"
#: data/json/effects.json
msgid "Rabbit Mutation"
msgstr "変化(ウサギ)"

#. ~ Name of effect type id "mutagen_rabbit"
#: data/json/effects.json
msgid "Rabbit Transformation"
msgstr "変異(ウサギ)"

#. ~ Name of effect type id "mutagen_rabbit"
#: data/json/effects.json
msgid "Rabbit Metamorphosis"
msgstr "急変(ウサギ)"

#. ~ Description of effect type "Rabbit Mutation"
#: data/json/effects.json
msgid "You consumed rabbit primer."
msgstr "ウサギの変異源プライマーを摂取しました。"

#. ~ Description of effect type "Rabbit Transformation"
#: data/json/effects.json
msgid "So much to do!  Better hop to it!"
msgstr "やるべきことは山積みです！飛び越えていきましょう！"

#. ~ Description of effect type "Rabbit Metamorphosis"
#: data/json/effects.json
