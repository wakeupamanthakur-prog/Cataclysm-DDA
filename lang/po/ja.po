msgstr "変異(エルファ)"

#. ~ Name of effect type id "mutagen_elfa"
#: data/json/effects.json
msgid "Elf-A Metamorphosis"
msgstr "急変(エルファ)"

#. ~ Description of effect type "Elf-A Mutation"
#: data/json/effects.json
msgid "You consumed Elf-A primer."
msgstr "エルファの変異原プライマーを摂取しました。"

#. ~ Description of effect type "Elf-A Transformation"
#: data/json/effects.json
msgid "You must look after this world, if no one else will."
msgstr "ここが見捨てられた世界だと言うのなら、自ら面倒を見るしかありません。"

#. ~ Description of effect type "Elf-A Metamorphosis"
#: data/json/effects.json
msgid "You see stars.  You see so many stars."
msgstr "星が見えます。満天の星空です。"

#. ~ Name of effect type id "mutagen_feline"
#: data/json/effects.json
msgid "Feline Mutation"
msgstr "変化(ネコ)"

#. ~ Name of effect type id "mutagen_feline"
#: data/json/effects.json
msgid "Feline Transformation"
msgstr "変異(ネコ)"

#. ~ Name of effect type id "mutagen_feline"
#: data/json/effects.json
msgid "Feline Metamorphosis"
msgstr "急変(ネコ)"

#. ~ Description of effect type "Feline Mutation"
#: data/json/effects.json
msgid "You consumed feline primer."
msgstr "ネコの変異原プライマーを摂取しました。"

#. ~ Description of effect type "Feline Transformation"
#: data/json/effects.json
msgid "Quiet steps and sharp claws.  They'll never see it coming."
msgstr "静かな足取りと鋭い爪。決して気付かれることはありません。"

#. ~ Description of effect type "Feline Metamorphosis"
#: data/json/effects.json
msgid "If this overdose kills you, you've got a few more lives… right?"
msgstr "たとえ過剰摂取で死んだとしても、まだ命がいくつか残っているから大丈夫...なのでしょうか？"

#. ~ Name of effect type id "mutagen_fish"
