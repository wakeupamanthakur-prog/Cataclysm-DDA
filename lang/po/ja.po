msgstr "指定した位置に騒音を発生させます。"

#. ~ Sound description of spell "[Ψ]Telepathic Shrieking Monster"
#: data/mods/MindOverMatter/monsters/monsters_spells.json
msgid "static"
msgstr "[雑音]"

#. ~ Spell name
#: data/mods/MindOverMatter/monsters/monsters_spells.json
msgid "[Ψ]Network Effect Monster"
msgstr "[Ψ]ﾈｯﾄﾜｰｸ･ｴﾌｪｸﾄ(モンスター専用)"

#. ~ Description of spell "[Ψ]Network Effect Monster"
#: data/mods/MindOverMatter/monsters/monsters_spells.json
