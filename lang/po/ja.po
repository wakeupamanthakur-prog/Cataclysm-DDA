#: src/monattack.cpp:3612
msgid "\"Stop it please.\""
msgstr "「止めて下さい。」"

#: src/monattack.cpp:3615
msgid "\"Let us help you.\""
msgstr "「あなたを助けてあげたい。」"

#: src/monattack.cpp:3618
msgid "\"We wish you no harm.\""
msgstr "「あなたを傷つけたくない。」"

#: src/monattack.cpp:3621
msgid "\"Do not fear.\""
msgstr "「怖がらないで。」"

#: src/monattack.cpp:3624
msgid "\"We can help you.\""
msgstr "「あなたを助けたい。」"

#: src/monattack.cpp:3627
msgid "\"We are friendly.\""
msgstr "「私たちは友達。」"

#: src/monattack.cpp:3630
msgid "\"Please don't.\""
msgstr "「お願い、やめて。」"

