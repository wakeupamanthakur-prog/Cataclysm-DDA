msgstr "クマに変身する術を習得しました。"

#. ~ EOC option description in effect in EoC "EOC_DRUID_SHIFTER_GIVE_FORM_2"
#: data/mods/Magiclysm/effects/eoc_game_start.json
msgid "You learned how to transform into a deer"
msgstr "シカに変身する術を習得しました。"

#. ~ EOC option description in effect in EoC "EOC_DRUID_SHIFTER_GIVE_FORM_2"
#: data/mods/Magiclysm/effects/eoc_game_start.json
msgid "You learned how to transform into a raven"
msgstr "ワタリガラスに変身する術を習得しました。"

#. ~ EOC selection title in effect in EoC "EOC_DRUID_SHIFTER_GIVE_FORM_2"
#: data/mods/Magiclysm/effects/eoc_game_start.json
msgid "Which form did you learn how to shift into?"
msgstr "習得している変化形態を選択"

#. ~ Player message in effect in EoC "EOC_DRUID_SHIFTER_BEAR_FORM_activated_3"
#. in nested EOCs in effect in EoC "EOC_DRUID_SHIFTER_BEAR_FORM_activated_2"
