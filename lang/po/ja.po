msgstr "敵の設定"

#. ~ Response to NPC dialogue
#: data/mods/Defense_Mode/dialogue/menu_screen.json
msgid "Preset Game Options"
msgstr "プリセットモード"

#. ~ Response to NPC dialogue
#: data/mods/Defense_Mode/dialogue/menu_screen.json
msgid "Advanced Game Options"
msgstr "詳細設定"

#. ~ Response to NPC dialogue
#: data/mods/Defense_Mode/dialogue/menu_screen.json
msgid "Difficulty Options"
msgstr "難易度設定"

#. ~ NPC dialogue line
#: data/mods/Defense_Mode/dialogue/menu_screen.json
msgid "What kinds of enemies do you want to see?"
msgstr "どのような敵を出現させますか？"

#. ~ Response to NPC dialogue
#: data/mods/Defense_Mode/dialogue/menu_screen.json
msgid "Allow regular zombies."
