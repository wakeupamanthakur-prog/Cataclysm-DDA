msgstr "サーモジェネシス中"

#. ~ EOC option name in effect in EoC
#. "EOC_SPELL_PYROKIN_THERMOGENESIS_SELECTOR"
#: data/mods/MindOverMatter/powers/pyrokinesis_eoc.json
msgid "Major thermogenesis"
msgstr "サーモジェネシス強"

#. ~ EOC option name in effect in EoC
#. "EOC_SPELL_PYROKIN_THERMOGENESIS_SELECTOR"
#: data/mods/MindOverMatter/powers/pyrokinesis_eoc.json
msgid "Banish all thermogenesis nodes"
msgstr "全てのサーモジェネシスを止める"

#. ~ EOC option description in effect in EoC
#. "EOC_SPELL_PYROKIN_THERMOGENESIS_SELECTOR"
#: data/mods/MindOverMatter/powers/pyrokinesis_eoc.json
msgid "Raise the temperature a few degrees."
msgstr "気温を数度だけ高めます。"

#. ~ EOC option description in effect in EoC
#. "EOC_SPELL_PYROKIN_THERMOGENESIS_SELECTOR"
#: data/mods/MindOverMatter/powers/pyrokinesis_eoc.json
msgid "Raise the temperature from a summer night to a summer day."
msgstr "夏の夜の気温を夏の昼程度まで高めます。"

#. ~ EOC option description in effect in EoC
#. "EOC_SPELL_PYROKIN_THERMOGENESIS_SELECTOR"
#: data/mods/MindOverMatter/powers/pyrokinesis_eoc.json
msgid "Raise the temperature from winter to early fall."
msgstr "冬の気温を初秋程度まで高めます。"

#. ~ EOC option description in effect in EoC
#. "EOC_SPELL_PYROKIN_THERMOGENESIS_SELECTOR"
#: data/mods/MindOverMatter/powers/pyrokinesis_eoc.json
msgid "Raise the temperature from winter to summer."
msgstr "冬の気温を夏程度まで高めます。"

#. ~ EOC option description in effect in EoC
#. "EOC_SPELL_PYROKIN_THERMOGENESIS_SELECTOR"
#: data/mods/MindOverMatter/powers/pyrokinesis_eoc.json
msgid "Stop all current thermogenesis."
msgstr "現在のサーモジェネシス効果を全て停止します。"

#. ~ Player spell casting message in effect in EoC
#. "EOC_SPELL_PYROKIN_SUMMON_HEAT_1"
#: data/mods/MindOverMatter/powers/pyrokinesis_eoc.json
msgid "The air nearby grows slightly warmer."
msgstr "周囲の空気が少し暖かくなりました。"

#. ~ Player spell casting message in effect in EoC
#. "EOC_SPELL_PYROKIN_SUMMON_HEAT_2"
#: data/mods/MindOverMatter/powers/pyrokinesis_eoc.json
msgid "Warm air swirls from the spot."
msgstr "周囲の空気が渦を巻き、暖まりました。"

#. ~ Player spell casting message in effect in EoC
#. "EOC_SPELL_PYROKIN_SUMMON_HEAT_3"
#: data/mods/MindOverMatter/powers/pyrokinesis_eoc.json
msgid "Hot air swirls from the spot."
msgstr "周囲の空気が渦を巻き、熱を発しました。"

#. ~ Player spell casting message in effect in EoC
#. "EOC_SPELL_PYROKIN_SUMMON_HEAT_4"
#: data/mods/MindOverMatter/powers/pyrokinesis_eoc.json
msgid "The air grows as hot as a summer day."
msgstr "周囲の空気が夏の日中のように熱くなりました。"

#. ~ Player message in effect in EoC "EOC_SPELL_PYROKIN_BANISH_HEAT"
#: data/mods/MindOverMatter/powers/pyrokinesis_eoc.json
msgid "The heated air you have been maintaining returns to normal."
msgstr "温められていた空気の塊が正常な温度に戻りました。"

#. ~ Spell name
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid "[Ψ]Far Hand"
msgstr "[Ψ]ﾌｧｰ･ﾊﾝﾄﾞ"

#. ~ Description of spell "[Ψ]Far Hand"
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid "Move a set of items towards or away from you."
msgstr "複数のアイテムを引き寄せたり、押し退けたりします。"

#. ~ Spell name
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid "[Ψ]Far Hand Pull Items Real"
msgstr "[Ψ]ﾌｧｰ･ﾊﾝﾄﾞアイテム引寄"

#. ~ Description of spell "[Ψ]Far Hand Pull Items Real"
#. ~ Description of spell "[Ψ]Far Hand Push Items Real"
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid ""
"The actual effect that causes the far hand.  It's a bug if you have it."
msgstr "ファー・ハンドの効果を実行する呪文です。通常は表示されません。"

#. ~ Spell name
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid "[Ψ]Far Hand Push Items Real"
msgstr "[Ψ]ﾌｧｰ･ﾊﾝﾄﾞアイテム押退"

#. ~ Spell name
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid "[Ψ]Force Shove"
msgstr "[Ψ]ﾌｫｰｽ･ｼｮｰｳﾞ"

#. ~ Description of spell "[Ψ]Force Shove"
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid ""
"Shove a target away or pull it towards you with a burst of psionic force.  "
"The distance the target can be moved depends on its weight versus your power"
" level; heavier things will not go as far, and if your target is too heavy, "
"you may not be able to move it at all."
msgstr ""
"超能力を爆発させて標的を押し退けるか、または引き寄せます。標的を移動させる距離は、超能力の強さと標的の重量によって変化します。標的が重ければそれほど長い距離を動かせず、あまりに重すぎるとまったく動かせない場合もあります。"

#. ~ Spell name
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid "[Ψ]Force Shove Away"
msgstr "[Ψ]ﾌｫｰｽ･ｼｮｰｳﾞ押退"

#. ~ Description of spell "[Ψ]Force Shove Away"
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid "The power that shoves a target away.  It's a bug if you have it."
msgstr "対象を遠くへ押し退ける力です。通常は表示されません。"

#. ~ Spell name
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid "[Ψ]Force Shove Toward"
msgstr "[Ψ]ﾌｫｰｽ･ｼｮｰｳﾞ引寄"

#. ~ Description of spell "[Ψ]Force Shove Toward"
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid "The power that shoves a target toward.  It's a bug if you have it."
msgstr "対象を近くへ引き寄せる力です。通常は表示されません。"

#. ~ Spell name
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid "[Ψ]Force Shove Push Real"
msgstr "[Ψ]ﾌｫｰｽ･ｼｮｰｳﾞ押退効果"

#. ~ Description of spell "[Ψ]Force Shove Push Real"
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid ""
"The actual effect that causes the force shove away.  It's a bug if you have "
"it."
msgstr "フォース・ショーヴの押し退ける効果を実行する呪文です。通常は表示されません。"

#. ~ Spell name
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid "[Ψ]Force Shove Pull Real"
msgstr "[Ψ]ﾌｫｰｽ･ｼｮｰｳﾞ引寄効果"

#. ~ Description of spell "[Ψ]Force Shove Pull Real"
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid ""
"The actual effect that causes the force shove toward.  It's a bug if you "
"have it."
msgstr "フォース・ショーヴの引き寄せる効果を実行する呪文です。通常は表示されません。"

#. ~ Spell name
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid "[Ψ]Noisemaker"
msgstr "[Ψ]ﾉｲｽﾞﾒｰｶｰ"

#. ~ Description of spell "[Ψ]Noisemaker"
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid ""
"Using a focused burst of telekinesis, slam two objects together, or an "
"object into the ground, or simply hit the ground with your powers, causing a"
" loud noise."
msgstr "超能力を一点に集中させ、二つの物体同士を叩きつける、物体を地面に叩きつける、地面を叩くなどの動作によって大きな音を立てます。"

#. ~ Sound description of spell "[Ψ]Noisemaker"
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid "a loud thump"
msgstr "[大きな衝撃音]"

#. ~ Message of spell "[Ψ]Noisemaker"
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid "You lash out at the ground with your powers."
msgstr "力を一点に集中させて地面に叩きつけました。"

#. ~ Spell name
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid "[Ψ]Knockdown"
msgstr "[Ψ]ﾉｯｸﾀﾞｳﾝ"

#. ~ Description of spell "[Ψ]Knockdown"
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid ""
"Slam something to the ground with a burst of telekinetic force, doing a "
"small amount of damage and downing them."
msgstr "念動力の爆発によって標的を地面に叩きつけ、多少のダメージを与えて転倒させます。"

#. ~ Message of spell "[Ψ]Knockdown"
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid "Your target is knocked to the ground."
msgstr "標的が地面に叩きつけられました。"

#. ~ Spell name
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid "[Ψ]Momentum Alteration (C)"
msgstr "[Ψ]ﾓﾒﾝﾀﾑ･ｵﾙﾀﾚｰｼｮﾝ(C)"

#. ~ Description of spell "[Ψ]Momentum Alteration (C)"
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid ""
"Edit the momentum of yourself and nearby objects to your benefit, slowing damaging force and slightly increasing your speed.\n"
"\n"
"This power <color_yellow>is maintained by concentration</color> and <color_red>may fail</color> if <color_yellow>concentration is interrupted</color>."
msgstr ""
"自分自身の運動量を増加させて速度をわずかに上昇させ、周囲の物体の運動量を減少させて被ダメージをわずかに軽減します。\n"
"\n"
"この超能力は<color_yellow>精神統一によって維持</color>されており、<color_yellow>精神統一を中断</color>すると<color_red>効果が停止</color>します。"

#. ~ Spell name
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid "[Ψ]Slowfall"
msgstr "[Ψ]ｽﾛｰﾌｫｰﾙ"

#. ~ Description of spell "[Ψ]Slowfall"
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid ""
"Counteract the pull of gravity with telekinetic force, greatly reducing or "
"even eliminating damage from falling and becoming much more buoyant."
msgstr "念動力で重力に対抗し、落下によるダメージを大幅に軽減もしくは無効化し、浮力を大幅に高めます。"

#. ~ Message of spell "[Ψ]Slowfall"
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid "You feel lighter."
msgstr "身体が軽くなりました。"

#. ~ Spell name
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid "[Ψ]Wave of Force"
msgstr "[Ψ]ｳｪｰﾌﾞ･ｵﾌﾞ･ﾌｫｰｽ"

#. ~ Description of spell "[Ψ]Wave of Force"
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid ""
"Unleash a telekinetic wave around you that indiscriminately knocks "
"everything back."
msgstr "周囲に念力を放ち、範囲内の者を無差別に打ち倒します。"

#. ~ Message of spell "[Ψ]Wave of Force"
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid "You knock everything nearby backwards!"
msgstr "周囲の者を全て打ち倒しました！"

#. ~ Spell name
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid "[Ψ]Wave of Force WONDER"
msgstr "[Ψ]ｳｪｰﾌﾞ･ｵﾌﾞ･ﾌｫｰｽWONDER"

#. ~ Description of spell "[Ψ]Wave of Force WONDER"
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid "The WONDER spell that casts multiple waves of force ."
msgstr "ウェーブ・オブ・フォースのWONDERフラグをもつ呪文です。"

#. ~ Spell name
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid "[Ψ]Telekinetic Wave Push"
msgstr "[Ψ]ｳｪｰﾌﾞ･ｵﾌﾞ･ﾌｫｰｽ押出"

#. ~ Description of spell "[Ψ]Telekinetic Wave Push"
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid "Part of Wave of Force.  If you see this it's a bug."
msgstr "ウェーブ・オブ・フォースの効果の一部です。通常は表示されません。"

#. ~ Spell name
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid "[Ψ]Lifting Field (C)"
msgstr "[Ψ]ﾘﾌﾃｨﾝｸﾞ･ﾌｨｰﾙﾄﾞ(C)"

#. ~ Description of spell "[Ψ]Lifting Field (C)"
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid ""
"Hover a single object next to you, freeing your hands for other tasks and making it easy to access.\n"
"\n"
"This power <color_yellow>is maintained by concentration</color> and <color_red>may fail</color> if <color_yellow>concentration is interrupted</color>."
msgstr ""
"1個のアイテムを傍に浮遊させることで、手を他の作業に使うことができ、アイテムが必要になったときは簡単に手元に戻せます。\n"
"\n"
"この超能力は<color_yellow>精神統一によって維持</color>されており、<color_yellow>精神統一を中断</color>すると<color_red>効果が停止</color>します。"

#. ~ Spell name
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid "[Ψ]Enhance Strength (C)"
msgstr "[Ψ]ｴﾝﾊﾝｽ･ｽﾄﾚﾝｸﾞｽ(C)"

#. ~ Description of spell "[Ψ]Enhance Strength (C)"
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid ""
"Focus your powers to allow you to move much heavier objects and smash through walls.\n"
"\n"
"This power <color_yellow>is maintained by concentration</color> and <color_red>may fail</color> if <color_yellow>concentration is interrupted</color>.  It is <color_red>canceled by engaging in combat</color>."
msgstr ""
"精神を集中させ、より重い物体を動かしたり、壁を打ち破ったりできる力を得ます。\n"
"\n"
"この超能力は<color_yellow>精神統一によって維持</color>されており、<color_yellow>精神統一を中断</color>すると<color_red>効果が停止</color>します。<color_red>戦闘を行うと無効化されます</color>。"

#. ~ Spell name
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid "[Ψ]Mindhammer"
msgstr "[Ψ]ﾏｲﾝﾄﾞﾊﾝﾏｰ"

#. ~ Description of spell "[Ψ]Mindhammer"
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid "Smash a single target or small area with a fist of telekinetic force."
msgstr "念動力の拳で単一の標的または狭い範囲を粉砕します。"

#. ~ Sound description of spell "[Ψ]Mindhammer"
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid "a heavy thud!"
msgstr "[重々しい衝撃音！]"

#. ~ Message of spell "[Ψ]Mindhammer"
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid "You smash your target with a fist of force."
msgstr "力強い拳が標的を打ち砕きました。"

#. ~ Spell name
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid "Mindhammer Ground damage"
msgstr "マインドハンマー地形ダメージ"

#. ~ Description of spell "Mindhammer Ground damage"
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid ""
"Damages ground when you use Mindhammer.  If you have this you debugged it "
"in."
msgstr "マインドハンマーを詠唱した際に地形にダメージを与えます。デバッグ中しか表示されません。"

#. ~ Spell name
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid "[Ψ]Lift Vehicle (C)"
msgstr "[Ψ]ﾘﾌﾄ･ﾋﾞｰｸﾙ(C)"

#. ~ Description of spell "[Ψ]Lift Vehicle (C)"
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid ""
"Focus your powers to raise a vehicle just enough to change a tire or perform repairs.  As your powers increase, you will be able to lift heavier vehicles.\n"
"\n"
"This power <color_yellow>is maintained by concentration</color> and <color_red>may fail</color> if <color_yellow>concentration is interrupted</color>.  It is <color_red>canceled by engaging in combat</color>."
msgstr ""
"精神を集中させて車両を持ち上げ、タイヤ交換や修理ができる状態にします。成長すると、より重い車両を持ち上げられるようになります。\n"
"\n"
"この超能力は<color_yellow>精神統一によって維持</color>されており、<color_yellow>精神統一を中断</color>すると<color_red>効果が停止</color>します。<color_red>戦闘を行うと無効化されます</color>。"

#. ~ Spell name
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid "[Ψ]Inertial Barrier (C)"
msgstr "[Ψ]ｲﾅｰｼｬﾙ･ﾊﾞﾘｱ(C)"

#. ~ Description of spell "[Ψ]Inertial Barrier (C)"
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid ""
"Create a telekinetic barrier around yourself to protect you from damage.\n"
"\n"
"This power <color_yellow>is maintained by concentration</color> and <color_red>may fail</color> if <color_yellow>concentration is interrupted</color>."
msgstr ""
"念動力のバリアをまとい、ダメージから肉体を保護します。\n"
"\n"
"この超能力は<color_yellow>精神統一によって維持</color>されており、<color_yellow>精神統一を中断</color>すると<color_red>効果が停止</color>します。"

#. ~ Spell name
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid "[Ψ]Wrecking Ball"
msgstr "[Ψ]ﾚｯｷﾝｸﾞ･ﾎﾞｰﾙ"

#. ~ Description of spell "[Ψ]Wrecking Ball"
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid ""
"A burst of telekinetic force shatters the terrain at the target location, as"
" well as anything caught inside."
msgstr "念力の爆発によって、指定した位置の地形とその周囲の範囲内のあらゆるものを粉砕します。"

#. ~ Sound description of spell "[Ψ]Wrecking Ball"
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid "a loud crash!"
msgstr "[大きな衝撃音！]"

#. ~ Message of spell "[Ψ]Wrecking Ball"
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid "You indiscriminately blast your targets!"
msgstr "指定した位置とその周囲に無差別の爆発を引き起こしました！"

#. ~ Spell name
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid "Wrecking Ball Enemy damage"
msgstr "ﾚｯｷﾝｸﾞ･ﾎﾞｰﾙ攻撃"

#. ~ Description of spell "Wrecking Ball Enemy damage"
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid ""
"Damages enemies when you use Wrecking Ball on the ground.  If you have this "
"you debugged it in."
msgstr "レッキング・ボールを詠唱した際に敵にダメージを与えます。デバッグ中しか表示されません。"

#. ~ Spell name
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid "[Ψ]Levitation (C)"
msgstr "[Ψ]ﾚﾋﾞﾃｰｼｮﾝ(C)"

#. ~ Description of spell "[Ψ]Levitation (C)"
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid ""
"Use your telekinesis and lift yourself up, defying gravity.  While not true flight, you can cross open air and descend safely.\n"
"\n"
"This power <color_yellow>is maintained by concentration</color> and <color_red>may fail</color> if <color_yellow>concentration is interrupted</color>.  It is <color_red>canceled by engaging in combat</color>."
msgstr ""
"念力によって、重力に逆らうように自分の肉体を浮遊させます。飛行はできませんが、空中を安全に降下できます。\n"
"\n"
"この超能力は<color_yellow>精神統一によって維持</color>されており、<color_yellow>精神統一を中断</color>すると<color_red>効果が停止</color>します。<color_red>戦闘を行うと無効化されます</color>。"

#. ~ Spell name
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid "[Ψ]Megakinesis"
msgstr "[Ψ]ﾒｶﾞｷﾈｼｽ"

#. ~ Description of spell "[Ψ]Megakinesis"
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid ""
"Telekinesis on a grand scale, this power allows you to move truly enormous "
"amounts of weight, hurling a human-sized target at lethal speeds or picking "
"up and throwing something monstrously large.  The amount of weight you can "
"move is dependent on the power level."
msgstr ""
"規模の大きなテレキネシスです。非常に重い物体を移動させる力であり、人間サイズの標的を投げ飛ばして致命傷を与えたり、巨大な物体を投げつけたりできます。移動できる重量は超能力のレベルによって異なります。"

#. ~ Spell name
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid "[Ψ]Megakinesis Pushing Power"
msgstr "[Ψ]ﾒｶﾞｷﾈｼｽ押出"

#. ~ Description of spell "[Ψ]Megakinesis Pushing Power"
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid ""
"Starts the push effect EoC for Megakinesis.  It's a bug if you have it."
msgstr "メガキネシスの押し出し範囲効果を開始します。通常は表示されません。"

#. ~ Spell name
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid "[Ψ]Megakinesis Pulling Power"
msgstr "[Ψ]ﾒｶﾞｷﾈｼｽ引寄"

#. ~ Description of spell "[Ψ]Megakinesis Pulling Power"
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid ""
"Starts the pull effect EoC for Megakinesis.  It's a bug if you have it."
msgstr "メガキネシスの引き寄せ範囲効果を開始します。通常は表示されません。"

#. ~ Spell name
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid "[Ψ]Aegis"
msgstr "[Ψ]ｲｰｼﾞｽ"

#. ~ Description of spell "[Ψ]Aegis"
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid ""
"Create a shield impenetrable to physical damage around yourself.  It will "
"<color_yellow>only last a few moments</color>.  You will be "
"<color_red>unable to move</color> while the power is in effect."
msgstr ""
"物理的なダメージを通さないシールドを周囲に作り出します。効果は<color_yellow>数分のみ持続</color>し、発動中は<color_red>移動不可能</color>です。"

#. ~ Message of spell "[Ψ]Aegis"
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid "The air around you becomes as hard as adamant."
msgstr "周囲の空気が硬く凝固しました。"

#. ~ Spell name
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid "[Ψ]Earthshaker"
msgstr "[Ψ]ｱｰｽｼｪｲｶｰ"

#. ~ Description of spell "[Ψ]Earthshaker"
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid ""
"Seize the nearby earth with your powers and *wrench* it, toppling buildings "
"and knocking everyone nearby off their feet."
msgstr "念力で大地を掴んで*捩じる*ことで、建物を崩壊させ、周囲にいる者を無差別に転倒させます。"

#. ~ Sound description of spell "[Ψ]Earthshaker"
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid "the ground shaking!"
msgstr "[大地が揺れ動く轟音！]"

#. ~ Message of spell "[Ψ]Earthshaker"
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid "The earth shakes!"
msgstr "地面が揺れています！"

#. ~ Spell name
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid "[Ψ]Earthshaker Bash Terrain"
msgstr "[Ψ]ｱｰｽｼｪｲｶｰ地形破壊"

#. ~ Spell name
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid "[Ψ]Earthshaker Rubble"
msgstr "[Ψ]ｱｰｽｼｪｲｶｰ瓦礫生成"

#. ~ Player message in effect in EoC "EOC_TELEKIN_MOMENTUM_INITIATE"
#: data/mods/MindOverMatter/powers/telekinesis_concentration_eoc.json
msgid "The air around you feels more yielding."
msgstr "周囲の空気がしなやかになったようです。"

#. ~ Player message in effect in EoC "EOC_TELEKIN_LIFTING_FIELD_INITIATE"
#: data/mods/MindOverMatter/powers/telekinesis_concentration_eoc.json
msgid "You prepare to hover an item close to hand."
msgstr "アイテムを浮遊させる準備を整えました。"

#. ~ Player message in effect in EoC "EOC_TELEKIN_STRENGTH_INITIATE"
#: data/mods/MindOverMatter/powers/telekinesis_concentration_eoc.json
msgid "You concentrate and prepare to lift something heavy."
msgstr "精神を集中させ、重いものを持ち上げられるように肉体を強化します。"

#. ~ Player message in effect in EoC "EOC_TELEKIN_SHIELD_INITIATE"
#: data/mods/MindOverMatter/powers/telekinesis_concentration_eoc.json
msgid "The air around you shimmers slightly."
msgstr "周囲の空気がほのかにきらめきました。"

#. ~ Player message in effect in EoC
#. "EOC_TELEKIN_SUMMON_JACKING_TOOL_INITIATE"
#: data/mods/MindOverMatter/powers/telekinesis_concentration_eoc.json
msgid "You ready yourself to lift a car just enough to work on it."
msgstr "車両を持ち上げて作業する準備ができました。"

#. ~ Player message in effect in EoC "EOC_TELEKIN_REMOVE_JACKING_TOOL"
#: data/mods/MindOverMatter/powers/telekinesis_concentration_eoc.json
msgid "You let the vehicle settle gently to the ground."
msgstr "持ち上げていた車両を静かに降ろしました。"

#. ~ Player message in effect in EoC "EOC_TELEKIN_LEVITATION_INITIATE"
#: data/mods/MindOverMatter/powers/telekinesis_concentration_eoc.json
msgid "You begin floating a hand's breadth above the ground."
msgstr "地面から手のひらの幅程度の高さまで浮き上がりました。"

#. ~ EOC option name in effect in EoC "EOC_TELEKINETIC_FAR_HAND_SELECTOR"
#. ~ EOC option name in effect in EoC "EOC_TELEKINETIC_FORCE_SHOVE_SELECTOR"
#. ~ EOC option name in effect in EoC
#. "EOC_TELEKINETIC_MOVE_LARGE_WEIGHT_SELECTOR"
#: data/mods/MindOverMatter/powers/telekinesis_eoc.json
msgid "Pull"
msgstr "引き寄せ"

#. ~ EOC option name in effect in EoC "EOC_TELEKINETIC_FAR_HAND_SELECTOR"
#. ~ EOC option name in effect in EoC "EOC_TELEKINETIC_FORCE_SHOVE_SELECTOR"
#. ~ EOC option name in effect in EoC
#. "EOC_TELEKINETIC_MOVE_LARGE_WEIGHT_SELECTOR"
#: data/mods/MindOverMatter/powers/telekinesis_eoc.json
msgid "Push"
msgstr "押し退け"

#. ~ EOC option description in effect in EoC
#. "EOC_TELEKINETIC_FAR_HAND_SELECTOR"
#: data/mods/MindOverMatter/powers/telekinesis_eoc.json
msgid "Pull a set of items to you."
msgstr "複数のアイテムを引き寄せます。"

#. ~ EOC option description in effect in EoC
#. "EOC_TELEKINETIC_FAR_HAND_SELECTOR"
#: data/mods/MindOverMatter/powers/telekinesis_eoc.json
msgid "Push a set of items away from you."
msgstr "複数のアイテムを押し退けます。"

#. ~ EOC option description in effect in EoC
#. "EOC_TELEKINETIC_FORCE_SHOVE_SELECTOR"
#: data/mods/MindOverMatter/powers/telekinesis_eoc.json
msgid "Shove a target away from you."
msgstr "標的を遠ざけます。"

#. ~ EOC option description in effect in EoC
#. "EOC_TELEKINETIC_FORCE_SHOVE_SELECTOR"
#: data/mods/MindOverMatter/powers/telekinesis_eoc.json
msgid "Grab a target and pull them towards you."
msgstr "標的を掴んで引き寄せます。"

#. ~ NPC message in nested effect in else statement in effect in EoC
#. "EOC_TELEKINETIC_FORCE_SHOVE_PUSH_CHECKER"
#. ~ NPC message in nested effect in else statement in effect in EoC
#. "EOC_TELEKINETIC_MOVE_LARGE_WEIGHT_PUSH_CHECKER"
#. ~ Message of spell "Pushing Wind"
#: data/mods/MindOverMatter/powers/telekinesis_eoc.json
#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutation_spells.json
msgid "You hurl your target away."
msgstr "標的を吹き飛ばしました。"

#. ~ NPC message in effect in EoC "EOC_TELEKINETIC_PUSH_DOWN_CHECKER"
#: data/mods/MindOverMatter/powers/telekinesis_eoc.json
msgid "You shove your target off their feet."
msgstr "標的が立っていられないほど強い力で吹き飛ばしました。"

#. ~ NPC message in false effect in EoC "EOC_TELEKINETIC_PUSH_DOWN_CHECKER"
#: data/mods/MindOverMatter/powers/telekinesis_eoc.json
msgid "You attempt to shove your target but they are too heavy!"
msgstr "押し退けようとしましたが、標的が重すぎます！"

#. ~ NPC message in nested effect in else statement in effect in EoC
#. "EOC_TELEKINETIC_FORCE_SHOVE_PULL_CHECKER"
#. ~ NPC message in nested effect in else statement in effect in EoC
#. "EOC_TELEKINETIC_MOVE_LARGE_WEIGHT_PULL_CHECKER"
#: data/mods/MindOverMatter/powers/telekinesis_eoc.json
msgid "You pull your target towards you."
msgstr "標的を引き寄せました。"

#. ~ EOC option description in effect in EoC
#. "EOC_TELEKINETIC_MOVE_LARGE_WEIGHT_SELECTOR"
#: data/mods/MindOverMatter/powers/telekinesis_eoc.json
msgid "Push something away from you."
msgstr "物体を押し退けます。"

#. ~ EOC option description in effect in EoC
#. "EOC_TELEKINETIC_MOVE_LARGE_WEIGHT_SELECTOR"
#: data/mods/MindOverMatter/powers/telekinesis_eoc.json
msgid "Pull something toward you."
msgstr "物体を引き寄せます。"

#. ~ Spell name
#: data/mods/MindOverMatter/powers/telepathy.json
msgid "[Ψ]Concentration Trance (C)"
msgstr "[Ψ]ｺﾝｾﾝﾄﾚｰｼｮﾝ･ﾄﾗﾝｽ(C)"

#. ~ Description of spell "[Ψ]Concentration Trance (C)"
#: data/mods/MindOverMatter/powers/telepathy.json
msgid ""
"Focus your own mind into a trance state, increasing learning speed.\n"
"\n"
"This power <color_yellow>is maintained by concentration</color> and <color_red>may fail</color> if <color_yellow>concentration is interrupted</color>.  It is <color_red>canceled by engaging in combat</color>."
msgstr ""
"精神を統一してトランス状態に入り、学習速度を高めます。\n"
"\n"
"この超能力は<color_yellow>精神統一によって維持</color>されており、<color_yellow>精神統一を中断</color>すると<color_red>効果が停止</color>します。<color_red>戦闘を行うと無効化されます</color>。"

#. ~ Description of spell "[Ψ]Telepathic Shield (C)"
#: data/mods/MindOverMatter/powers/telepathy.json
msgid ""
"You can protect your mind from the dangers of the post-Cataclysmic world.\n"
"\n"
"This power <color_yellow>is maintained by concentration</color> and <color_red>may fail</color> if <color_yellow>concentration is interrupted</color>."
msgstr ""
"大変動後の世界の危険な存在から精神を守ります。\n"
"\n"
"この超能力は<color_yellow>精神統一によって維持</color>されており、<color_yellow>精神統一を中断</color>すると<color_red>効果が停止</color>します。"

#. ~ Spell name
#: data/mods/MindOverMatter/powers/telepathy.json
msgid "[Ψ]Mood Stabilization (C)"
msgstr "[Ψ]ﾑｰﾄﾞ･ｽﾀﾋﾞﾗｲｾﾞｰｼｮﾝ(C)"

#. ~ Description of spell "[Ψ]Mood Stabilization (C)"
#: data/mods/MindOverMatter/powers/telepathy.json
msgid ""
"With the ability to edit others' thoughts comes the ability to edit your own, removing negative moods to a degree.  You have also learned to do this more subtly on others, calming their anger or assuaging their fears.\n"
"\n"
"When used on yourself, this power <color_yellow>is maintained by concentration</color> and <color_red>may fail</color> if <color_yellow>concentration is interrupted</color>."
msgstr ""
"他人や自分自身の思考を操作する力が備わっており、多少のネガティブな気分であれば取り除くことができます。他者の思考をより巧妙に操作し、怒りを鎮めたり、恐怖をやわらげたりすることも可能です。\n"
"\n"
"この超能力は<color_yellow>精神統一によって維持</color>されており、<color_yellow>精神統一を中断</color>すると<color_red>効果が停止</color>します。"

#. ~ Description of spell "[Ψ]Synaptic Overload"
#: data/mods/MindOverMatter/powers/telepathy.json
msgid ""
"Short-circuit and overwhelm a target's brain, causing extreme damage or "
"death."
msgstr "標的の脳をショートさせて打ちのめし、大ダメージを与えるか死亡させます。"

#. ~ Spell name
#: data/mods/MindOverMatter/powers/telepathy.json
msgid "[Ψ]Beastmaster"
msgstr "[Ψ]ﾋﾞｰｽﾄﾏｽﾀｰ"

#. ~ Description of spell "[Ψ]Beastmaster"
#: data/mods/MindOverMatter/powers/telepathy.json
msgid ""
"Take control of an animal's mind, forcing it to obey you.  This power will "
"not work on insects, spiders, or similar beings."
msgstr "動物の心を制御して、強制的に服従させます。この超能力は昆虫やクモなどには効果がありません。"

#. ~ Message of spell "[Ψ]Beastmaster"
#: data/mods/MindOverMatter/powers/telepathy.json
msgid "You take control of the animal's mind!"
msgstr "動物の精神を操作しました！"

#. ~ Spell name
#: data/mods/MindOverMatter/powers/telepathy.json
msgid "[Ψ]Primal Terror"
msgstr "[Ψ]ﾌﾟﾗｲﾏﾙ･ﾃﾗｰ"

#. ~ Message of spell "[Ψ]Primal Terror"
#: data/mods/MindOverMatter/powers/telepathy.json
msgid "You unleash your target's fears."
msgstr "標的の恐怖心をかき立てました。"

#. ~ Spell name
#: data/mods/MindOverMatter/powers/telepathy.json
msgid "[Ψ]Obscurity"
msgstr "[Ψ]ｵﾌﾞｽｷｭﾘﾃｨ"

#. ~ Description of spell "[Ψ]Obscurity"
#: data/mods/MindOverMatter/powers/telepathy.json
msgid ""
"Use a light touch on others' minds to hide your presence.  You will be invisible to the target(s) while the power is in effect.\n"
"\n"
"This power is <color_red>canceled by engaging in combat</color> with your target."
msgstr ""
"標的の精神を多少操作して、自分自身を視認させない状態にします。効果中は標的に視認されなくなります。\n"
"\n"
"標的と<color_red>戦闘を行うと無効化</color>されます。"

#. ~ Message of spell "[Ψ]Obscurity"
#: data/mods/MindOverMatter/powers/telepathy.json
msgid "You hide your presence from your enemies."
msgstr "敵から自らの存在を隠しました。"

#. ~ Spell name
#: data/mods/MindOverMatter/powers/telepathy.json
msgid "[Ψ]Obscurity Self"
msgstr "[Ψ]ｵﾌﾞｽｷｭﾘﾃｨ自己効果"

#. ~ Description of spell "[Ψ]Obscurity Self"
#: data/mods/MindOverMatter/powers/telepathy.json
msgid ""
"Puts an effect on you so anyone affected by Obscurity knows to ignore you.  "
"It's a bug if you have this directly."
msgstr "オブスキュリティの標的になった相手に視認されなくなる効果です。通常は表示されません。"

#. ~ Spell name
#: data/mods/MindOverMatter/powers/telepathy.json
msgid "[Ψ]Psychic Scream"
msgstr "[Ψ]ｻｲｷｯｸ･ｽｸﾘｰﾑ"

#. ~ Description of spell "[Ψ]Psychic Scream"
#: data/mods/MindOverMatter/powers/telepathy.json
msgid ""
"Emit an uncontrolled psychic scream, attacking the mind of anyone nearby.  "
"This power does not distinguish between friend and foe."
msgstr "制御不能な精神攻撃を発し、周囲に無差別に精神的ダメージを与えます。"

#. ~ Message of spell "[Ψ]Psychic Scream"
#: data/mods/MindOverMatter/powers/telepathy.json
msgid "You unleash a mind-piercing psionic shriek!"
msgstr "精神を不安定にする超常的な叫び声を上げました！"

#. ~ Spell name
#: data/mods/MindOverMatter/powers/telepathy.json
msgid "[Ψ]Psychic Scream Additional Damage"
msgstr "[Ψ]ｻｲｷｯｸ･ｽｸﾘｰﾑ追加ダメージ"

#. ~ Description of spell "[Ψ]Psychic Scream Additional Damage"
#: data/mods/MindOverMatter/powers/telepathy.json
msgid ""
"This exists to allow Psychic Scream to do minimal damage and kill small "
"animals whose extremely low HP would otherwise be below the percentage "
"threshold, as well as making it more likely to stun or daze.  It's a bug if "
"you have it directly."
msgstr ""
"サイキック・スクリームの与ダメージを最小限に抑え、HPが非常に低い小動物などのモンスターを殺害するだけでなく気絶、放心などの状態にするための効果です。通常は表示されません。"

#. ~ Spell name
#: data/mods/MindOverMatter/powers/telepathy.json
msgid "[Ψ]Beast Tamer"
msgstr "[Ψ]ﾋﾞｰｽﾄ･ﾃｲﾏｰ"

#. ~ Description of spell "[Ψ]Beast Tamer"
#: data/mods/MindOverMatter/powers/telepathy.json
msgid ""
"Perform mental surgery on an animal, making it friendly to you for a much "
"longer duration.  The animal must already be friendly, either naturally or "
"through powers such as Beastmastery, in order to be tamed."
msgstr ""
"より長期間にわたって友好的に振る舞うように、動物の心を操作します。標的となる動物は元から友好的であるか、ビーストマスターなどの能力や餌やりなどで友好的な状態にしておく必要があります。"

#. ~ Message of spell "[Ψ]Beast Tamer"
#: data/mods/MindOverMatter/powers/telepathy.json
msgid "The animal sniffs at your palm."
msgstr "動物がこちらの手のひらの匂いを嗅ぎました。"

#. ~ Spell name
#: data/mods/MindOverMatter/powers/telepathy.json
msgid "[Ψ]Beast Tamer Pet Effect"
msgstr "[Ψ]ﾋﾞｰｽﾄ･ﾃｲﾏｰペット化"

#. ~ Description of spell "[Ψ]Beast Tamer Pet Effect"
#: data/mods/MindOverMatter/powers/telepathy.json
msgid ""
"This applies the pet effect to a tamed animal.  It's a bug if you have it "
"directly."
msgstr "飼い慣らした動物をペット化します。通常は表示されません。"

#. ~ Spell name
#: data/mods/MindOverMatter/powers/telepathy.json
msgid "[Ψ]Mind Control"
msgstr "[Ψ]ﾏｲﾝﾄﾞ･ｺﾝﾄﾛｰﾙ"

#. ~ Description of spell "[Ψ]Mind Control"
#: data/mods/MindOverMatter/powers/telepathy.json
msgid "Seize control of the target's mind, forcing them to do your bidding."
msgstr "標的の精神を掌握し、命令に従うよう強制します。"

#. ~ Message of spell "[Ψ]Mind Control"
#: data/mods/MindOverMatter/powers/telepathy.json
msgid "You take control of your target's mind!"
msgstr "標的の精神を操作しました！"

#. ~ Spell name
#: data/mods/MindOverMatter/powers/telepathy.json
msgid "[Ψ]Network Effect"
msgstr "[Ψ]ﾈｯﾄﾜｰｸ･ｴﾌｪｸﾄ"

#. ~ Description of spell "[Ψ]Network Effect"
#: data/mods/MindOverMatter/powers/telepathy.json
msgid ""
"Forge an unconscious telepathic network between you and nearby allies, "
"allowing you all to send and receive information about nearby dangers and "
"react more quickly in combat.  The network requires at least one ally nearby"
" to be effective."
msgstr ""
"周囲の仲間と無意識のテレパシーネットワークを構築し、付近の危険に関する情報を共有し、戦闘中により迅速に反応できるようにします。有効なネットワークを構築するには、周囲に最低でも1人の仲間がいる必要があります。"

#. ~ Spell name
#: data/mods/MindOverMatter/powers/telepathy.json
msgid "[Ψ]Network Effect Real"
msgstr "[Ψ]ﾈｯﾄﾜｰｸ･ｴﾌｪｸﾄ効果"

#. ~ Description of spell "[Ψ]Network Effect Real"
#: data/mods/MindOverMatter/powers/telepathy.json
msgid ""
"The actual power that implements the Network Effect.  It's a bug if you have"
" it."
msgstr "テレパシーネットワークの効果を実行する呪文です。通常は表示されません。"

#. ~ Player message in effect in EoC "EOC_TELEPATH_CONCENTRATION_INITIATE"
#: data/mods/MindOverMatter/powers/telepathy_concentration_eoc.json
msgid ""
"Your vision narrows to what is directly in front of you as you concentrate."
msgstr "視界を狭い範囲に集中させ、目の前にあるものを見据えました。"

#. ~ Player message in effect in EoC "EOC_TELEPATH_MORALE_INITIATE_SELF"
#: data/mods/MindOverMatter/powers/telepathy_concentration_eoc.json
msgid "You begin to edit out your discouraging thoughts."
msgstr "落ち込んだ気分を修正しました。"

#. ~ NPC message in effect in EoC "EOC_TELEPATH_MORALE_MODIFY_NPC_VALUES_2" in
#. nested EOCs in effect in EoC "EOC_TELEPATH_MORALE_MODIFY_NPC_VALUES"
#. ~ NPC message in effect in EoC
#. "EOC_TELEPATH_MORALE_MODIFY_MONSTER_VALUES_2" in nested EOCs in effect in
#. EoC "EOC_TELEPATH_MORALE_MODIFY_MONSTER_VALUES"
#: data/mods/MindOverMatter/powers/telepathy_eoc.json
msgid ""
"You reach in and, with a deft touch, sooth your target's negative emotions."
msgstr "対象の感情に寄り添い、巧みに操作し、ネガティブな思考を和らげました。"

#. ~ NPC message in false effect in EoC
#. "EOC_TELEPATH_MORALE_MODIFY_NPC_VALUES_2" in nested EOCs in effect in EoC
#. "EOC_TELEPATH_MORALE_MODIFY_NPC_VALUES"
#. ~ NPC message in false effect in EoC
#. "EOC_TELEPATH_MORALE_MODIFY_MONSTER_VALUES_2" in nested EOCs in effect in
#. EoC "EOC_TELEPATH_MORALE_MODIFY_MONSTER_VALUES"
#: data/mods/MindOverMatter/powers/telepathy_eoc.json
msgid ""
"You attempt to edit the target's mood, but your powers slam into a smooth, "
"unyielding barrier and slide off."
msgstr "対象の感情を操作しようとしましたが、滑らかで頑強な障壁に阻まれました。"

#. ~ NPC message in false effect in EoC
#. "EOC_TELEPATH_MORALE_MODIFY_NPC_VALUES"
#: data/mods/MindOverMatter/powers/telepathy_eoc.json
msgid ""
"You don't want to risk affecting the target's mind too quickly, and "
"withdraw."
msgstr "あまりにも安易に精神を操作するリスクを考え、止めておきました。"

#. ~ Player spell casting message in effect in EoC
#. "EOC_TELEPATH_NETWORK_ALLY_CHECK"
#: data/mods/MindOverMatter/powers/telepathy_eoc.json
msgid "You now have an instinctive awareness of your allies, and they of you."
msgstr "本能的に仲間と認識を相互共有しています。"

#. ~ Player message in false effect in EoC "EOC_TELEPATH_NETWORK_ALLY_CHECK"
#: data/mods/MindOverMatter/powers/telepathy_eoc.json
msgid "With no nearby allies, there is no one to network with."
msgstr "周囲に仲間がいないため、テレパシーの繋がりを構築できません。"

#. ~ Spell name
#: data/mods/MindOverMatter/powers/teleportation.json
msgid "[Ψ]Blink"
msgstr "[Ψ]ﾌﾞﾘﾝｸ"

#. ~ Description of spell "[Ψ]Blink"
#: data/mods/MindOverMatter/powers/teleportation.json
msgid ""
"Step briefly into the void between dimensions and emerge at a random nearby "
"location."
msgstr "次元の隙間に少しだけ足を踏み入れ、周囲のランダムな位置に転移します。"

#. ~ Message of spell "[Ψ]Blink"
#: data/mods/MindOverMatter/powers/teleportation.json
msgid "You vanish and reappear nearby."
msgstr "突然消え、すぐ近くの別の場所に現れました。"

#. ~ Spell name
#: data/mods/MindOverMatter/powers/teleportation.json
msgid "[Ψ]Stutterstep"
msgstr "[Ψ]ｽﾀｯﾀｰｽﾃｯﾌﾟ"

#. ~ Message of spell "[Ψ]Stutterstep"
#: data/mods/MindOverMatter/powers/teleportation.json
msgid "You warp the space around your enemies!"
msgstr "敵の周囲の空間を歪めます！"

#. ~ Spell name
#: data/mods/MindOverMatter/powers/teleportation.json
msgid "[Ψ]Phase"
msgstr "[Ψ]ﾌｪｲｽﾞ"

#. ~ Description of spell "[Ψ]Phase"
#: data/mods/MindOverMatter/powers/teleportation.json
msgid ""
"By stepping for a moment into the void between dimensions, you can bypass a "
"wall or walk from the ground to the roof of a house."
msgstr "次元の狭間に一瞬だけ足を踏み入れることで、壁を通り抜けたり、地面から屋根まで飛び移ったりすることができます。"

#. ~ Message of spell "[Ψ]Phase"
#: data/mods/MindOverMatter/powers/teleportation.json
msgid ""
"There is a brief moment of darkness and terrible cold, and you are somewhere"
" else."
msgstr "ほんの一瞬だけ暗闇とひどい寒さに襲われ、次の瞬間には別の場所に現れました。"

#. ~ Spell name
#: data/mods/MindOverMatter/powers/teleportation.json
msgid "[Ψ]Ephemeral Walk (C)"
msgstr "[Ψ]ｴﾌｪﾒﾗﾙ･ｳｫｰｸ(C)"

#. ~ Description of spell "[Ψ]Ephemeral Walk (C)"
#: data/mods/MindOverMatter/powers/teleportation.json
msgid ""
"By moving slightly into the void between dimensions, you can exist in a "
"state that allows effortless travel through obstacles."
msgstr "肉体を通常の次元からわずかにずらすことで、障害物を苦も無く通り抜けられる状態になります。"

#. ~ Spell name
#: data/mods/MindOverMatter/powers/teleportation.json
msgid "[Ψ]Extended Stride (C)"
msgstr "[Ψ]ｴｸｽﾃﾝﾃﾞｯﾄﾞ･ｽﾄﾗｲﾄﾞ(C)"

#. ~ Description of spell "[Ψ]Extended Stride (C)"
#: data/mods/MindOverMatter/powers/teleportation.json
msgid ""
"By warping space to shorten distances, you can make each of your movements carry you much further.\n"
"\n"
"This power <color_yellow>is maintained by concentration</color> and <color_red>may fail</color> if <color_yellow>concentration is interrupted</color>."
msgstr ""
"距離を無視して空間を転移することで、より遠くまで移動できるようになります。\n"
"\n"
"この超能力は<color_yellow>精神統一によって維持</color>されており、<color_yellow>精神統一を中断</color>すると<color_red>効果が停止</color>します。"

#. ~ Message of spell "[Ψ]Extended Stride (C)"
#: data/mods/MindOverMatter/powers/teleportation.json
msgid "Your steps devour the distance."
msgstr "距離を無視した一歩を踏み出すことができます。"

#. ~ Spell name
#: data/mods/MindOverMatter/powers/teleportation.json
msgid "[Ψ]Transposition"
msgstr "[Ψ]ﾄﾗﾝｽﾎﾟｼﾞｼｮﾝ"

#. ~ Description of spell "[Ψ]Transposition"
#: data/mods/MindOverMatter/powers/teleportation.json
msgid ""
"Entangle yourself with your target's position and, with a twist, swap places"
" with them."
msgstr "自分自身と標的の位置を交換します。"

#. ~ Message of spell "[Ψ]Transposition"
#: data/mods/MindOverMatter/powers/teleportation.json
msgid ""
"There is a moment of darkness and terrible cold, and you are somewhere else,"
" and so is your target."
msgstr "一瞬だけ暗闇とひどい寒さに襲われ、次の瞬間、標的と入れ替わる形で別の場所に現れました。"

#. ~ Spell name
#: data/mods/MindOverMatter/powers/teleportation.json
msgid "[Ψ]Displacement"
msgstr "[Ψ]ﾃﾞｨｽﾌﾟﾚｲｽﾒﾝﾄ"

#. ~ Description of spell "[Ψ]Displacement"
#: data/mods/MindOverMatter/powers/teleportation.json
msgid ""
"With a touch, you can send your target through the void to re-emerge "
"somewhere nearby, further away from you."
msgstr "標的に触れて虚空に転移させ、周囲のどこかに再出現させます。"

#. ~ Message of spell "[Ψ]Displacement"
#: data/mods/MindOverMatter/powers/teleportation.json
msgid "You touch your target and they are suddenly somewhere else."
msgstr "触れた相手が消え、突然別の場所に現れました。"

#. ~ Spell name
#: data/mods/MindOverMatter/powers/teleportation.json
msgid "[Ψ]Spacial Vortex"
msgstr "[Ψ]ｽﾍﾟｰｼｬﾙ･ﾎﾞﾙﾃｯｸｽ"

#. ~ Description of spell "[Ψ]Spacial Vortex"
#: data/mods/MindOverMatter/powers/teleportation.json
msgid ""
"Affect the fabric of space, changing relative distance around a point so "
"that everything moving within finds themselves moving towards it."
msgstr "空間の構造を操作してある一点の周囲との相対距離を変更し、範囲内で移動できるもの全てをその一点へ引き寄せます。"

#. ~ Message of spell "[Ψ]Spacial Vortex"
#: data/mods/MindOverMatter/powers/teleportation.json
msgid ""
"The air around your enemies shimmers as their forward motion carries them "
"rapidly towards each other."
msgstr "周囲の空気がきらめき、敵がある一点へ急速に引き寄せられ始めました。"

#. ~ Spell name
#: data/mods/MindOverMatter/powers/teleportation.json
msgid "[Ψ]Spacial Vortex 01"
msgstr "[Ψ]ｽﾍﾟｰｼｬﾙ･ﾎﾞﾙﾃｯｸｽ01"

#. ~ Description of spell "[Ψ]Spacial Vortex 01"
#: data/mods/MindOverMatter/powers/teleportation.json
msgid "Version 1 of the spacial vortex, with 2 pulls in."
msgstr "2の引寄効果をもつスペーシャル・ボルテックスの効果1です。"

#. ~ Spell name
#: data/mods/MindOverMatter/powers/teleportation.json
msgid "[Ψ]Spacial Vortex 02"
msgstr "[Ψ]ｽﾍﾟｰｼｬﾙ･ﾎﾞﾙﾃｯｸｽ02"

#. ~ Description of spell "[Ψ]Spacial Vortex 02"
#: data/mods/MindOverMatter/powers/teleportation.json
msgid "Version 2 of the spacial vortex, with 3 pulls in."
msgstr "3の引寄効果をもつスペーシャル・ボルテックスの効果2です。"

#. ~ Spell name
#: data/mods/MindOverMatter/powers/teleportation.json
msgid "[Ψ]Spacial Vortex 03"
msgstr "[Ψ]ｽﾍﾟｰｼｬﾙ･ﾎﾞﾙﾃｯｸｽ03"

#. ~ Description of spell "[Ψ]Spacial Vortex 03"
#: data/mods/MindOverMatter/powers/teleportation.json
msgid "Version 3 of the spacial vortex, with 4 pulls in."
msgstr "4の引寄効果をもつスペーシャル・ボルテックスの効果3です。"

#. ~ Spell name
#: data/mods/MindOverMatter/powers/teleportation.json
msgid "[Ψ]Spacial Vortex 04"
msgstr "[Ψ]ｽﾍﾟｰｼｬﾙ･ﾎﾞﾙﾃｯｸｽ04"

#. ~ Description of spell "[Ψ]Spacial Vortex 04"
#: data/mods/MindOverMatter/powers/teleportation.json
msgid "Version 4 of the spacial vortex, with 5 pulls in."
msgstr "5の引寄効果をもつスペーシャル・ボルテックスの効果4です。"

#. ~ Spell name
#: data/mods/MindOverMatter/powers/teleportation.json
msgid "[Ψ]Spacial Vortex 05"
msgstr "[Ψ]ｽﾍﾟｰｼｬﾙ･ﾎﾞﾙﾃｯｸｽ05"

#. ~ Description of spell "[Ψ]Spacial Vortex 05"
#: data/mods/MindOverMatter/powers/teleportation.json
msgid "Version 5 of the spacial vortex, with 6 pulls in."
msgstr "6の引寄効果をもつスペーシャル・ボルテックスの効果5です。"

#. ~ Spell name
#: data/mods/MindOverMatter/powers/teleportation.json
msgid "[Ψ]Spacial Vortex 06"
msgstr "[Ψ]ｽﾍﾟｰｼｬﾙ･ﾎﾞﾙﾃｯｸｽ06"

#. ~ Description of spell "[Ψ]Spacial Vortex 06"
#: data/mods/MindOverMatter/powers/teleportation.json
msgid "Version 6 of the spacial vortex, with 7 pulls in."
msgstr "7の引寄効果をもつスペーシャル・ボルテックスの効果6です。"

#. ~ Spell name
#: data/mods/MindOverMatter/powers/teleportation.json
msgid "[Ψ]Spacial Vortex 07"
msgstr "[Ψ]ｽﾍﾟｰｼｬﾙ･ﾎﾞﾙﾃｯｸｽ07"

#. ~ Description of spell "[Ψ]Spacial Vortex 07"
#: data/mods/MindOverMatter/powers/teleportation.json
msgid "Version 7 of the spacial vortex, with 8 pulls in."
msgstr "8の引寄効果をもつスペーシャル・ボルテックスの効果7です。"

#. ~ Spell name
#: data/mods/MindOverMatter/powers/teleportation.json
msgid "[Ψ]Spacial Vortex Real"
msgstr "[Ψ]ｽﾍﾟｰｼｬﾙ･ﾎﾞﾙﾃｯｸｽ効果"

#. ~ Description of spell "[Ψ]Spacial Vortex Real"
#: data/mods/MindOverMatter/powers/teleportation.json
msgid ""
"The actual spacial vortex that pulls in monsters.  It's a bug if you have "
"it."
msgstr "スペーシャル・ボルテックスのモンスター引寄効果を実行する呪文です。通常は表示されません。"

#. ~ Spell name
#: data/mods/MindOverMatter/powers/teleportation.json
msgid "[Ψ]Farstep"
msgstr "[Ψ]ﾌｧｰｽﾃｯﾌﾟ"

#. ~ Description of spell "[Ψ]Farstep"
#: data/mods/MindOverMatter/powers/teleportation.json
msgid ""
"Skating along the void between dimensions, move to a specific place nearby."
msgstr "次元の隙間に沿って滑るように進み、周囲の特定の位置に移動します。"

#. ~ Message of spell "[Ψ]Farstep"
#: data/mods/MindOverMatter/powers/teleportation.json
msgid ""
"There is a moment of darkness and terrible cold, and you are somewhere else."
msgstr "一瞬だけ暗闇とひどい寒さに襲われ、次の瞬間には別の場所に現れました。"

#. ~ Spell name
#: data/mods/MindOverMatter/powers/teleportation.json
msgid "[Ψ]Oubliette"
msgstr "[Ψ]ｳｰﾌﾞﾘｴｯﾄ"

#. ~ Description of spell "[Ψ]Oubliette"
#: data/mods/MindOverMatter/powers/teleportation.json
msgid ""
"Teleport the target through the nether to some other dimension.  They are "
"technically not dead, but they are no longer your concern.  Oubliette will "
"occasionally fail when used against very powerful enemies, or succeed but "
"cause damage to the teleporter."
msgstr ""
"次元を超えたどこかの異界に標的を転移させます。厳密に言えば死ぬわけではありませんが、もう誰にも迷惑を掛けることはありません。非常に強力な敵に対して使用すると、失敗したり、成功しても詠唱者が反動ダメージを受けたりする場合があります。"

#. ~ Spell name
#: data/mods/MindOverMatter/powers/teleportation.json
msgid "Oubliette Self"
msgstr "ｳｰﾌﾞﾘｴｯﾄ効果"

#. ~ Description of spell "Oubliette Self"
#. ~ Description of spell "Verdant Imprisonment Self"
#: data/mods/MindOverMatter/powers/teleportation.json
#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutation_spells.json
msgid "This is the banishment that the target casts on themselves."
msgstr "標的が自分自身に対して付与する消失効果です。"

#. ~ Spell name
#: data/mods/MindOverMatter/powers/teleportation.json
msgid "[Ψ]Gateway"
msgstr "[Ψ]ｹﾞｰﾄｳｪｲ"

#. ~ Description of spell "[Ψ]Gateway"
#: data/mods/MindOverMatter/powers/teleportation.json
msgid ""
"Transport yourself through the Nether to an attuned location.  You must "
"attune yourself to the place you wish to travel to."
msgstr "異界を通って設定した地点に転移します。転移する地点は、事前に訪れて転移ゲートを生成しておく必要があります。"

#. ~ Spell name
#: data/mods/MindOverMatter/powers/teleportation.json
msgid "[Ψ]Attune to Area"
msgstr "[Ψ]ｹﾞｰﾄｳｪｲ(位置登録)"

#. ~ Description of spell "[Ψ]Attune to Area"
#: data/mods/MindOverMatter/powers/teleportation.json
msgid "Attune to a location for later teleporting."
msgstr "転移する地点をあらかじめ設定しておきます。"

#. ~ Spell name
#: data/mods/MindOverMatter/powers/teleportation.json
msgid "[Ψ]Breach"
msgstr "[Ψ]ﾌﾞﾘｰﾁ"

#. ~ Description of spell "[Ψ]Breach"
#: data/mods/MindOverMatter/powers/teleportation.json
msgid ""
"Open a brief passage to the Nether using yourself or an enemy as an anchor and allow one (or more) of its inhabitants to come through.  You have no control over what finds the doorway and no ability to command it when it arrives.\n"
"\n"
"Remember that some denizens of the Nether die instantly in sunlight."
msgstr ""
"自分自身や敵を次元アンカーとして異界への短い通路を作り出し、異界のモンスターを一体(または複数体)呼び寄せます。何がこちら側へやってくるかを制御することはできず、やってきたモンスターに命令することもできません。\n"
"\n"
"異界のモンスターの中には日光を浴びると死んでしまうものもいるため、注意が必要です。"

#. ~ Spell name
#: data/mods/MindOverMatter/powers/teleportation.json
msgid "[Ψ]Reality Tear"
msgstr "[Ψ]ﾘｱﾘﾃｨ･ﾃｨｱｰ"

#. ~ Description of spell "[Ψ]Reality Tear"
#: data/mods/MindOverMatter/powers/teleportation.json
msgid ""
"Make your own contribution to the Cataclysm by opening a permanent tear in "
"reality, allowing all manners of netherium creatures access to Earth.  This "
"might not be a good idea."
msgstr ""
"現実世界に恒久的に残る裂け目を生じさせ、あらゆる種類の異界生物が地球上に侵入できる状態にします。これは大変動に積極的に貢献する行為であり、名案とは思えません。"

#. ~ Message of spell "[Ψ]Reality Tear"
#: data/mods/MindOverMatter/powers/teleportation.json
msgid "The air fractures and the space nearby breaks!"
msgstr "周囲の空間が裂け、破壊されました！"

#. ~ Spell name
#: data/mods/MindOverMatter/powers/teleportation.json
msgid "[Ψ]Reality Tear - Side Effects"
msgstr "[Ψ]ﾘｱﾘﾃｨ･ﾃｨｱｰ副次効果"

#. ~ Description of spell "[Ψ]Reality Tear - Side Effects"
#: data/mods/MindOverMatter/powers/teleportation.json
msgid "Side effects of Reality Tear.  Seeing this spell is a bug."
msgstr "リアリティ・ティアーの副次効果です。通常は表示されません。"

#. ~ Player message in effect in EoC "EOC_TELEPORT_STRIDE_INITIATE"
#: data/mods/MindOverMatter/powers/teleportation_concentration_eoc.json
msgid "Your steps are taking you further than your eyes tell you they should."
msgstr "それほど動かずとも、かなりの距離を移動できるようになります。"

#. ~ Player message in effect in EoC "EOC_TELEPORT_EPHEMERAL_WALK_INITIATE"
#: data/mods/MindOverMatter/powers/teleportation_concentration_eoc.json
msgid ""
"You feel a strange coolness as matter around you feels somehow less solid."
msgstr "空気が妙に涼しく、周囲の物質が柔らかくなったような気がします。"

#. ~ NPC message in false effect in EoC "EOC_TELEPORTER_OUBLIETTE_HANDLING"
#: data/mods/MindOverMatter/powers/teleportation_eoc.json
msgid "Your target wavers for a moment, but nothing happens."
msgstr "標的の姿が一瞬揺らめきましたが、他には何も起きません。"

#. ~ NPC message in nested effect in then statement in effect in EoC
#. "EOC_TELEPORTER_OUBLIETTE_HANDLING_2"
#. ~ NPC message in nested effect in then statement in false effect in EoC
#. "EOC_TELEPORTER_OUBLIETTE_HANDLING_2"
#: data/mods/MindOverMatter/powers/teleportation_eoc.json
msgid ""
"With a tremendous mental exertion, you hurl your target to another "
"dimension!"
msgstr "精神を極限まで集中させ、相手を別次元に放逐しました！"

#. ~ Spell name
#: data/mods/MindOverMatter/powers/vitakinesis.json
msgid "[Ψ]Healthy Glow (C)"
msgstr "[Ψ]ﾍﾙｼｰ･ｸﾞﾛｳ(C)"

#. ~ Description of spell "[Ψ]Healthy Glow (C)"
#: data/mods/MindOverMatter/powers/vitakinesis.json
msgid ""
"Your powers can keep you in the bloom of health.  This can also stop or prevent an asthma attack.\n"
"\n"
"This power <color_yellow>is maintained by concentration</color> and <color_red>may fail</color> if <color_yellow>concentration is interrupted</color>."
msgstr ""
"自らの肉体をより健康な状態にします。喘息発作の緩和や予防効果もあります。\n"
"\n"
"この超能力は<color_yellow>精神統一によって維持</color>されており、<color_yellow>精神統一を中断</color>すると<color_red>効果が停止</color>します。"

#. ~ Spell name
#: data/mods/MindOverMatter/powers/vitakinesis.json
msgid "[Ψ]Coagulation (C)"
msgstr "[Ψ]ｺｱｸﾞﾚｰｼｮﾝ(C)"

#. ~ Description of spell "[Ψ]Coagulation (C)"
#: data/mods/MindOverMatter/powers/vitakinesis.json
msgid ""
"By increasing the efficiency of your platelets and speeding their movement, you can slow your rate of bleeding and even prevent it before it starts.\n"
"\n"
"This power <color_yellow>is maintained by concentration</color> and <color_red>may fail</color> if <color_yellow>concentration is interrupted</color>."
msgstr ""
"血小板の働きと運動力を高めることで、出血速度を遅くし、ダメージを負っても出血しにくくなります。\n"
"\n"
"この超能力は<color_yellow>精神統一によって維持</color>されており、<color_yellow>精神統一を中断</color>すると<color_red>効果が停止</color>します。"

#. ~ Spell name
#: data/mods/MindOverMatter/powers/vitakinesis.json
msgid "[Ψ]Staunch Wound"
msgstr "[Ψ]ｽﾀﾝﾁ･ｳｰﾝﾄﾞ"

#. ~ Description of spell "[Ψ]Staunch Wound"
#: data/mods/MindOverMatter/powers/vitakinesis.json
msgid ""
"You concentrate on your injuries, and they close and the blood flow stops."
msgstr "傷に精神を集中させ、出血を止めて傷口を塞ぎます。"

#. ~ Message of spell "[Ψ]Staunch Wound"
#: data/mods/MindOverMatter/powers/vitakinesis.json
msgid "You summon up the energy to close your wounds!"
msgstr "力を集中させて傷を塞ぎました！"

#. ~ Spell name
#: data/mods/MindOverMatter/powers/vitakinesis.json
msgid "[Ψ]Staunch Wound #1"
msgstr "[Ψ]ｽﾀﾝﾁ･ｳｰﾝﾄﾞ#1"

#. ~ Description of spell "[Ψ]Staunch Wound #1"
#: data/mods/MindOverMatter/powers/vitakinesis.json
msgid ""
"The first of the Staunch Wound spells.  This summons a low-power bandage--"
"it's a bug if you have it."
msgstr "スタンチ・ウーンドの最初に発動する呪文効果です。低い効果をもつ包帯を作り出します。通常は操作キャラクターには表示されません。"

#. ~ Spell name
#: data/mods/MindOverMatter/powers/vitakinesis.json
msgid "[Ψ]Staunch Wound #2"
msgstr "[Ψ]ｽﾀﾝﾁ･ｳｰﾝﾄﾞ#2"

#. ~ Description of spell "[Ψ]Staunch Wound #2"
#: data/mods/MindOverMatter/powers/vitakinesis.json
msgid ""
"The first of the Staunch Wound spells.  This summons a medium-power bandage"
"--it's a bug if you have it."
msgstr "スタンチ・ウーンドの最初に発動する呪文効果です。中程度の効果をもつ包帯を作り出します。通常は操作キャラクターには表示されません。"

#. ~ Spell name
#: data/mods/MindOverMatter/powers/vitakinesis.json
msgid "[Ψ]Staunch Wound #3"
msgstr "[Ψ]ｽﾀﾝﾁ･ｳｰﾝﾄﾞ#3"

#. ~ Description of spell "[Ψ]Staunch Wound #3"
#: data/mods/MindOverMatter/powers/vitakinesis.json
msgid ""
"The first of the Staunch Wound spells.  This summons a high-power bandage--"
"it's a bug if you have it."
msgstr "スタンチ・ウーンドの最初に発動する呪文効果です。高い効果をもつ包帯を作り出します。通常は操作キャラクターには表示されません。"

#. ~ Spell name
#: data/mods/MindOverMatter/powers/vitakinesis.json
msgid "[Ψ]Enervating Touch"
msgstr "[Ψ]ｴﾈﾙﾍﾞｰﾄ･ﾀｯﾁ"

#. ~ Description of spell "[Ψ]Enervating Touch"
#: data/mods/MindOverMatter/powers/vitakinesis.json
msgid ""
"With but a touch you can cause your target to begin deteriorating slowly.  "
"This is most effective on targets with preternatural means of healing but "
"has some effect on anyone."
msgstr ""
"ほんの少し触れるだけで、標的をゆっくりと衰弱させていきます。超自然的な治癒手段をもつ標的に対して最も有効ですが、その他の標的にもある程度の効果があります。"

#. ~ Message of spell "[Ψ]Enervating Touch"
#: data/mods/MindOverMatter/powers/vitakinesis.json
msgid "You touch your target and leave an angry red weal behind."
msgstr "標的に触れ、怒りの籠った赤い毒素を植え付けました。"

#. ~ Spell name
#: data/mods/MindOverMatter/powers/vitakinesis.json
msgid "[Ψ]Medicinal Touch"
msgstr "[Ψ]ﾒﾃﾞｨｼﾅﾙ･ﾀｯﾁ"

#. ~ Description of spell "[Ψ]Medicinal Touch"
#: data/mods/MindOverMatter/powers/vitakinesis.json
msgid ""
"You can apply your Healthy Glow power to a follower or ally.  This can stop "
"an asthma attack."
msgstr "ヘルシー・グロウの効果を仲間などに適用できます。喘息の発作を止めることも可能です。"

#. ~ Message of spell "[Ψ]Medicinal Touch"
#: data/mods/MindOverMatter/powers/vitakinesis.json
msgid "Your touch your target and they seem to perk up."
msgstr "触れた相手が元気を取り戻したようです。"

#. ~ Spell name
#: data/mods/MindOverMatter/powers/vitakinesis.json
msgid "[Ψ]Detoxification"
msgstr "[Ψ]ﾃﾞﾄｷｼﾌｨｹｰｼｮﾝ"

#. ~ Description of spell "[Ψ]Detoxification"
#: data/mods/MindOverMatter/powers/vitakinesis.json
msgid ""
"When poisoned, you can isolate the poison and move it to your sweat glands "
"where you will harmlessly sweat it out.  While doing so, your flesh will be "
"toxic to any creatures that take a bite."
msgstr "体内の毒を選り分けて汗腺に集め、汗として排出し悪影響を取り除きます。毒の排出中は、噛み付き攻撃を命中させた敵に毒で反撃します。"

#. ~ Spell name
#: data/mods/MindOverMatter/powers/vitakinesis.json
msgid "[Ψ]Wakeful Rest"
msgstr "[Ψ]ｳｪｲｸﾌﾙ･ﾚｽﾄ"

#. ~ Description of spell "[Ψ]Wakeful Rest"
#: data/mods/MindOverMatter/powers/vitakinesis.json
msgid ""
"In lieu of sleep, you can meditate.  As long as you maintain your "
"meditations, you will rarely need to spend a night sleeping."
msgstr "眠ることなく肉体を休めます。この状態を維持している限り、一晩眠って疲れをとる必要はほとんどありません。"

#. ~ Message of spell "[Ψ]Wakeful Rest"
#: data/mods/MindOverMatter/powers/vitakinesis.json
msgid "You begin meditating."
msgstr "静養を開始しました。"

#. ~ Spell name
#: data/mods/MindOverMatter/powers/vitakinesis.json
msgid "[Ψ]Immunostimulus (C)"
msgstr "[Ψ]ｲﾐｭﾉｽﾃｨﾐｭﾗｽ(C)"

#. ~ Description of spell "[Ψ]Immunostimulus (C)"
#: data/mods/MindOverMatter/powers/vitakinesis.json
msgid ""
"Kick your immune system into overdrive in order to overcome any illnesses you may be suffering from.\n"
"\n"
"This power <color_yellow>is maintained by concentration</color> and <color_red>may fail</color> if <color_yellow>concentration is interrupted</color>."
msgstr ""
"体内の免疫の活動を活発化させ、患っている病気を克服します。\n"
"\n"
"この超能力は<color_yellow>精神統一によって維持</color>されており、<color_yellow>精神統一を中断</color>すると<color_red>効果が停止</color>します。"

#. ~ Spell name
#: data/mods/MindOverMatter/powers/vitakinesis.json
msgid "[Ψ]Damage Balancing"
msgstr "[Ψ]ﾀﾞﾒｰｼﾞ･ﾊﾞﾗﾝｼﾝｸﾞ"

#. ~ Description of spell "[Ψ]Damage Balancing"
#: data/mods/MindOverMatter/powers/vitakinesis.json
msgid ""
"By rerouting blood and stem cells from undamaged areas, you can lessen your "
"most grievous wounds at the cost of weakness elsewhere.  You may also use "
"this to control an asthma attack."
msgstr ""
"健康な部位の血液と幹細胞を融通することでダメージを肩代わりし、重篤なダメージを受けている部位をある程度治療します。喘息の発作を抑えることも可能です。"

#. ~ Message of spell "[Ψ]Damage Balancing"
#: data/mods/MindOverMatter/powers/vitakinesis.json
msgid ""
"With a moment's concentration, your worst injuries heal, but you still don't"
" feel well."
msgstr "一瞬集中するだけで酷いケガも治りますが、体調不良は回復しません。"

#. ~ Spell name
#: data/mods/MindOverMatter/powers/vitakinesis.json
msgid "[Ψ]Allay Infection"
msgstr "[Ψ]ｱﾚｲ･ｲﾝﾌｪｸｼｮﾝ"

#. ~ Description of spell "[Ψ]Allay Infection"
#: data/mods/MindOverMatter/powers/vitakinesis.json
msgid ""
"Before you could stop your bleeding with but a thought.  Now, you can treat "
"infected wounds with your powers as well."
msgstr "少し精神統一するだけで出血が治まります。これで感染症も自力で治療できるようになります。"

#. ~ Message of spell "[Ψ]Allay Infection"
#: data/mods/MindOverMatter/powers/vitakinesis.json
msgid "You concentrate on the injuries, and the itching eases."
msgstr "傷口に力を集中させると、痒みが和らぎました。"

#. ~ Spell name
#: data/mods/MindOverMatter/powers/vitakinesis.json
msgid "[Ψ]SAllay Infection #1"
msgstr "[Ψ]ｱﾚｲ･ｲﾝﾌｪｸｼｮﾝ#1"

#. ~ Description of spell "[Ψ]SAllay Infection #1"
#: data/mods/MindOverMatter/powers/vitakinesis.json
msgid ""
"The first of the Allay Infection spells.  This summons a low-power "
"disinfectant/antibiotic--it's a bug if you have it."
msgstr ""
"アレイ・インフェクションの最初に発動する呪文効果です。低い効果をもつ消毒薬・抗生物質を作り出します。通常は操作キャラクターには表示されません。"

#. ~ Spell name
#: data/mods/MindOverMatter/powers/vitakinesis.json
msgid "[Ψ]SAllay Infection #2"
msgstr "[Ψ]ｱﾚｲ･ｲﾝﾌｪｸｼｮﾝ#2"

#. ~ Description of spell "[Ψ]SAllay Infection #2"
#: data/mods/MindOverMatter/powers/vitakinesis.json
msgid ""
"The second of the Allay Infection spells.  This summons a medium-power "
"disinfectant/antibiotic--it's a bug if you have it."
msgstr ""
"アレイ・インフェクションの最初に発動する呪文効果です。中程度の効果をもつ消毒薬・抗生物質を作り出します。通常は操作キャラクターには表示されません。"

#. ~ Spell name
#: data/mods/MindOverMatter/powers/vitakinesis.json
msgid "[Ψ]SAllay Infection #3"
msgstr "[Ψ]ｱﾚｲ･ｲﾝﾌｪｸｼｮﾝ#3"

#. ~ Description of spell "[Ψ]SAllay Infection #3"
#: data/mods/MindOverMatter/powers/vitakinesis.json
msgid ""
"The third of the Allay Infection spells.  This summons a high-power "
"disinfectant/antibiotic--it's a bug if you have it."
msgstr ""
"アレイ・インフェクションの最初に発動する呪文効果です。高い効果をもつ消毒薬・抗生物質を作り出します。通常は操作キャラクターには表示されません。"

#. ~ Spell name
#: data/mods/MindOverMatter/powers/vitakinesis.json
msgid "[Ψ]Revitalizing Meditation"
msgstr "[Ψ]ﾘｳﾞｧｲﾀﾗｲｼﾞﾝｸﾞ･ﾒﾃﾞｨﾃｰｼｮﾝ"

#. ~ Description of spell "[Ψ]Revitalizing Meditation"
#: data/mods/MindOverMatter/powers/vitakinesis.json
msgid ""
"Enter a trance state and heal your injuries many times faster than they "
"would heal naturally."
msgstr "トランス状態に入ることで、自然治癒よりも何倍も速く傷を治します。"

#. ~ Message of spell "[Ψ]Revitalizing Meditation"
#: data/mods/MindOverMatter/powers/vitakinesis.json
msgid "You enter a trance and submerge your awareness into your body."
msgstr "トランス状態に入り、意識を身体の中に沈めました。"

#. ~ Spell name
#: data/mods/MindOverMatter/powers/vitakinesis.json
msgid "[Ψ]Lacerating Touch"
msgstr "[Ψ]ﾗｾﾚｲﾃｨﾝｸﾞ･ﾀｯﾁ"

#. ~ Description of spell "[Ψ]Lacerating Touch"
#: data/mods/MindOverMatter/powers/vitakinesis.json
msgid ""
"With an inverse of vitakinesis's healing powers, you randomly tear flesh and"
" cut blood vessels, causing significant damage in your target."
msgstr "ヴァイタキネシスの治癒力を逆転させ、標的の肉をズタズタに引き裂き、血管を引きちぎり、重篤なダメージを与えます。"

#. ~ Message of spell "[Ψ]Lacerating Touch"
#: data/mods/MindOverMatter/powers/vitakinesis.json
msgid "You touch your target and wounds open on their flesh."
msgstr "標的に触れると、その肉体に傷が表れました。"

#. ~ Spell name
#: data/mods/MindOverMatter/powers/vitakinesis.json
msgid "[Ψ]Radiation Decontamination"
msgstr "[Ψ]ﾗｼﾞｴｰｼｮﾝ･ﾃﾞｺﾝﾀﾐﾈｰｼｮﾝ"

#. ~ Description of spell "[Ψ]Radiation Decontamination"
#: data/mods/MindOverMatter/powers/vitakinesis.json
msgid ""
"Use your powers to isolate and flush radiation from your body.  Depending on"
" your level of contamination, this power may have serious side effects."
msgstr "内なる力によって、体内の放射性物質を除去します。重度の放射線障害を負っている場合、浄化によって重大な副作用が発生する可能性もあります。"

#. ~ Message of spell "[Ψ]Radiation Decontamination"
#: data/mods/MindOverMatter/powers/vitakinesis.json
msgid "You focus your powers on the corruption infusing your flesh."
msgstr "自身の肉体に染み込んだ汚染に精神を集中させました。"

#. ~ Spell name
#: data/mods/MindOverMatter/powers/vitakinesis.json
msgid "[Ψ]Blood Purge"
msgstr "[Ψ]ﾌﾞﾗｯﾄﾞ･ﾊﾟｰｼﾞ"

#. ~ Description of spell "[Ψ]Blood Purge"
#: data/mods/MindOverMatter/powers/vitakinesis.json
msgid ""
"You submerge your mind into your bloodstream and remove the impurities you "
"find there."
msgstr "精神を自らの血流に集中させ、血液から不純物を取り除きます。"

#. ~ Message of spell "[Ψ]Blood Purge"
#: data/mods/MindOverMatter/powers/vitakinesis.json
msgid "Your power flows through your veins, cleansing your blood."
msgstr "力が血管を通って行き渡り、血液を浄化しました。"

#. ~ Spell name
#: data/mods/MindOverMatter/powers/vitakinesis.json
msgid "[Ψ]Blood Purge Remove Mutagens"
msgstr "[Ψ]ﾌﾞﾗｯﾄﾞ･ﾊﾟｰｼﾞ変異治療"

#. ~ Description of spell "[Ψ]Blood Purge Remove Mutagens"
#: data/mods/MindOverMatter/powers/vitakinesis.json
msgid ""
"Blood purge's additional ability to remove other substances contaminating "
"your bloodstream.  It's a bug if you have it."
msgstr "有害物質を血流から除去するブラッド・パージの副次効果です。通常は表示されません。"

#. ~ Spell name
#: data/mods/MindOverMatter/powers/vitakinesis.json
msgid "[Ψ]Banish Illness"
msgstr "[Ψ]ﾊﾞﾆｯｼｭ･ｲﾙﾈｽ"

#. ~ Description of spell "[Ψ]Banish Illness"
#: data/mods/MindOverMatter/powers/vitakinesis.json
msgid ""
"Enter a deep meditative trance and purge your body of illness, even serious "
"ones like cancer or multiple sclerosis.  It will not cure mutation.  Some "
"illnesses are more difficult to successfully eradicate than others."
msgstr ""
"深く瞑想的なトランス状態に入り、ガンや多発性硬化症などの重篤なものも含め、あらゆる病気を治癒します。ただし、変異を治療することはできません。病気の種類によっては、根治が非常に困難な場合もあります。"

#. ~ Message of spell "[Ψ]Banish Illness"
#: data/mods/MindOverMatter/powers/vitakinesis.json
msgid "You attempt to cure your afflictions."
msgstr "自分が罹っている病気の治療を試みます。"

#. ~ Spell name
#: data/mods/MindOverMatter/powers/vitakinesis.json
msgid "[Ψ]Anabolic Rejuvenation (C)"
msgstr "[Ψ]ｱﾅﾎﾞﾘｯｸ･ﾘｼﾞｭﾍﾞﾈｰｼｮﾝ(C)"

#. ~ Description of spell "[Ψ]Anabolic Rejuvenation (C)"
#: data/mods/MindOverMatter/powers/vitakinesis.json
msgid ""
"You draw on your body's reserves to speed your healing a hundredfold.\n"
"\n"
"This power <color_yellow>is maintained by concentration</color> and <color_red>may fail</color> if <color_yellow>concentration is interrupted</color>.  It requires <color_yellow>even more concentration</color> than usual."
msgstr ""
"体内に蓄えたエネルギーを使って治癒力を100倍高めます。\n"
"\n"
"この超能力は<color_yellow>精神統一によって維持</color>されており、<color_yellow>精神統一を中断</color>すると<color_red>効果が停止</color>します。通常より<color_yellow>強い精神統一</color>が必要です。"

#. ~ Spell name
#: data/mods/MindOverMatter/powers/vitakinesis.json
msgid "Anabolic Rejuvenation Heal"
msgstr "[Ψ]ｱﾅﾎﾞﾘｯｸ･ﾘｼﾞｭﾍﾞﾈｰｼｮﾝ治癒"

#. ~ Description of spell "Anabolic Rejuvenation Heal"
#: data/mods/MindOverMatter/powers/vitakinesis.json
msgid "The healing part of Anabolic Rejuvenation."
msgstr "アナボリック・リジュベネーションの治癒効果です。"

#. ~ Spell name
#: data/mods/MindOverMatter/powers/vitakinesis.json
msgid "Anabolic Rejuvenation draining"
msgstr "[Ψ]ｱﾅﾎﾞﾘｯｸ･ﾘｼﾞｭﾍﾞﾈｰｼｮﾝ消耗"

#. ~ Description of spell "Anabolic Rejuvenation draining"
#: data/mods/MindOverMatter/powers/vitakinesis.json
msgid "The draining part of Anabolic Rejuvenation."
msgstr "アナボリック・リジュベネーションの消耗効果です。"

#. ~ Spell name
#: data/mods/MindOverMatter/powers/vitakinesis.json
msgid "[Ψ]Ameliorate Extremity"
msgstr "[Ψ]ｱﾒﾘｵﾚｲﾄ･ｴｸｽﾄﾘﾐﾃｨ"

#. ~ Description of spell "[Ψ]Ameliorate Extremity"
#: data/mods/MindOverMatter/powers/vitakinesis.json
msgid ""
"You sink your mind the deepest within yourself you can possibly get and "
"enter a meditative trance to rejuvenate lost limbs, one at a time.  Be sure "
"to remove any prosthetics before doing this, it's hard to work around them."
msgstr ""
"精神を自らの深層意識の奥底まで深く沈めてトランス状態に入り、失われた四肢を一度に一本ずつ再生します。着用したままの義足が機能しなくなるため、必ず義足を外してから使用してください。"

#. ~ Message of spell "[Ψ]Ameliorate Extremity"
#: data/mods/MindOverMatter/powers/vitakinesis.json
msgid "You sink your mind deep within your body and enter a trance."
msgstr "心を深層意識の奥底に沈め、トランス状態に入りました。"

#. ~ Spell name
#: data/mods/MindOverMatter/powers/vitakinesis.json
msgid "[Ψ]Accelerated Resuscitation (C)"
msgstr "[Ψ]ｱｸｾﾗﾚｰﾃｯﾄﾞ･ﾚｻｼﾃｰｼｮﾝ(C)"

#. ~ Description of spell "[Ψ]Accelerated Resuscitation (C)"
#: data/mods/MindOverMatter/powers/vitakinesis.json
msgid ""
"While this power is active, if you suffer potentially fatal damage, your vitakinesis will go into overdrive to keep you alive.\n"
"\n"
"This power <color_yellow>is maintained by concentration</color> and <color_red>may fail</color> if <color_yellow>concentration is interrupted</color>."
msgstr ""
"効果中は、致命的なダメージを受けた際にヴァイタキネシスの力を最大限活用して生命を維持します。\n"
"\n"
"この超能力は<color_yellow>精神統一によって維持</color>されており、<color_yellow>精神統一を中断</color>すると<color_red>効果が停止</color>します。"

#. ~ Player message in effect in EoC "EOC_VITAKIN_SLOW_BLEEDING_INITIATE"
#: data/mods/MindOverMatter/powers/vitakinesis_concentration_eoc.json
msgid "You feel a warmth throughout your entire body."
msgstr "体全体が温かく感じます。"

#. ~ Player message in effect in EoC "EOC_VITAKIN_HEALTH_POWER_INITIATE"
#: data/mods/MindOverMatter/powers/vitakinesis_concentration_eoc.json
msgid "Your skin prickles and you feel like you're bursting with energy."
msgstr "肌がヒリヒリして、エネルギーが湧き出てくるのを感じます。"

#. ~ Player message in effect in EoC "EOC_VITAKIN_CURE_DISEASE_INITIATE"
#: data/mods/MindOverMatter/powers/vitakinesis_concentration_eoc.json
msgid "No disease is going to keep you down."
msgstr "煩わしい病は消え失せました。"

#. ~ Player message in effect in EoC "EOC_VITAKIN_SUPER_HEAL_INITIATE"
#: data/mods/MindOverMatter/powers/vitakinesis_concentration_eoc.json
msgid "You feel a sudden sensation of fatigue and your wounds itch."
msgstr "突然疲労感を感じ、傷口がヒリヒリしました。"

#. ~ Player message in effect in EoC "EOC_VITAKIN_RETURN_FROM_DEATH_INITIATE"
#: data/mods/MindOverMatter/powers/vitakinesis_concentration_eoc.json
msgid "You prepare yourself to return from near-death."
msgstr "臨死状態から復活する準備を整えました。"

#. ~ Player message in effect in EoC "EOC_VITAKIN_DEXTOXIFICATION_CHECK_1"
#: data/mods/MindOverMatter/powers/vitakinesis_eoc.json
msgid ""
"Your skin tingles as the poison begins to work its way out of your body."
msgstr "体内の毒が排出され始め、皮膚がひりつきました。"

#. ~ Player message in false effect in EoC
#. "EOC_VITAKIN_DEXTOXIFICATION_CHECK_1"
#: data/mods/MindOverMatter/powers/vitakinesis_eoc.json
msgid "You're not suffering from poisoning and have nothing to detoxify."
msgstr "毒を受けていないため、解毒の必要もありません。"

#. ~ Player message in effect in EoC "EOC_VITAKIN_DEXTOXIFICATION_CHECK_2"
#: data/mods/MindOverMatter/powers/vitakinesis_eoc.json
msgid "You begin to sweat."
msgstr "汗をかき始めました。"

#. ~ Player message in false effect in EoC "EOC_VITAKIN_SLEEP"
#: data/mods/MindOverMatter/powers/vitakinesis_eoc.json
msgid "You're feeling refreshed and have no need to meditate."
msgstr "気分が既にすっきりしているため、静養する必要はありません。"

#. ~ Player message in false effect in EoC "EOC_VITAKIN_WAKEFUL_REST_MEDITATE"
#: data/mods/MindOverMatter/powers/vitakinesis_eoc.json
msgid "You are fully refreshed, and can end your meditations now."
msgstr "気分が完全にすっきりしたため、今すぐ静養を終了できます。"

#. ~ Player message in effect in EoC "EOC_VITAKIN_HEALING_TRANCE_REMOVE"
#: data/mods/MindOverMatter/powers/vitakinesis_eoc.json
msgid "You exit your trance and your wounds feel less painful"
msgstr "トランス状態を脱すると、傷の痛みが和らぎました。"

#. ~ Player message in effect in EoC "EOC_VITAKIN_CURE_DISEASE_VS_HAY_FEVER"
#: data/mods/MindOverMatter/powers/vitakinesis_eoc.json
msgid "Your eyes burn and your nose is clogged with mucus."
msgstr "両目が焼けるように熱く、鼻は詰まっています。"

#. ~ Player message in false effect in EoC "EOC_VITAKIN_RAD_PURGE_6" in nested
#. EOCs in false effect in EoC "EOC_VITAKIN_RAD_PURGE_5" in nested EOCs in
#. false effect in EoC "EOC_VITAKIN_RAD_PURGE_4" in nested EOCs in false
#. effect in EoC "EOC_VITAKIN_RAD_PURGE_3" in nested EOCs in false effect in
#. EoC "EOC_VITAKIN_RAD_PURGE_2" in nested EOCs in false effect in EoC
#. "EOC_VITAKIN_RAD_PURGE"
#: data/mods/MindOverMatter/powers/vitakinesis_eoc.json
msgid "You have no radiation in your body, and so no need to do anything."
msgstr "被曝していないため、浄化する必要はありません。"

#. ~ EOC option name in effect in EoC "EOC_VITAKIN_BANISH_ILLNESS_SELECTOR"
#: data/mods/MindOverMatter/powers/vitakinesis_eoc.json
msgid "Purge Minor Ailments"
msgstr "軽度の病を治す"

#. ~ EOC option name in effect in EoC "EOC_VITAKIN_BANISH_ILLNESS_SELECTOR"
#: data/mods/MindOverMatter/powers/vitakinesis_eoc.json
msgid "Purge Asthma"
msgstr "喘息を治す"

#. ~ EOC option name in effect in EoC "EOC_VITAKIN_BANISH_ILLNESS_SELECTOR"
#: data/mods/MindOverMatter/powers/vitakinesis_eoc.json
msgid "Purge Chemical Imbalance"
msgstr "化学的不均衡を治す"

#. ~ EOC option name in effect in EoC "EOC_VITAKIN_BANISH_ILLNESS_SELECTOR"
#: data/mods/MindOverMatter/powers/vitakinesis_eoc.json
msgid "Purge Kaluptic Psychosis"
msgstr "精神病を治す"

#. ~ EOC option name in effect in EoC "EOC_VITAKIN_BANISH_ILLNESS_SELECTOR"
#: data/mods/MindOverMatter/powers/vitakinesis_eoc.json
msgid "Purge Jitters"
msgstr "筋けいれんを治す"

#. ~ EOC option name in effect in EoC "EOC_VITAKIN_BANISH_ILLNESS_SELECTOR"
#: data/mods/MindOverMatter/powers/vitakinesis_eoc.json
msgid "Purge Mood Swings"
msgstr "気分変動を治す"

#. ~ EOC option name in effect in EoC "EOC_VITAKIN_BANISH_ILLNESS_SELECTOR"
#: data/mods/MindOverMatter/powers/vitakinesis_eoc.json
msgid "Purge Wasting Sickness"
msgstr "弱体化を治す"

#. ~ EOC option name in effect in EoC "EOC_VITAKIN_BANISH_ILLNESS_SELECTOR"
#: data/mods/MindOverMatter/powers/vitakinesis_eoc.json
msgid "Purge Narcolepsy"
msgstr "睡眠発作を治す"

#. ~ EOC option name in effect in EoC "EOC_VITAKIN_BANISH_ILLNESS_SELECTOR"
#: data/mods/MindOverMatter/powers/vitakinesis_eoc.json
msgid "Purge Seasonal Allergies"
msgstr "花粉症を治す"

#. ~ EOC option name in effect in EoC "EOC_VITAKIN_BANISH_ILLNESS_SELECTOR"
#: data/mods/MindOverMatter/powers/vitakinesis_eoc.json
msgid "Purge Seasonal Affective Disorder"
msgstr "季節性感情障害を治す"

#. ~ EOC option description in effect in EoC
#. "EOC_VITAKIN_BANISH_ILLNESS_SELECTOR"
#: data/mods/MindOverMatter/powers/vitakinesis_eoc.json
msgid "Attempt to cure your minor illnesses."
msgstr "軽度の病の治療を試みます。"

#. ~ EOC option description in effect in EoC
#. "EOC_VITAKIN_BANISH_ILLNESS_SELECTOR"
#: data/mods/MindOverMatter/powers/vitakinesis_eoc.json
msgid "Attempt to cure your asthma."
msgstr "喘息の治療を試みます。"

#. ~ EOC option description in effect in EoC
#. "EOC_VITAKIN_BANISH_ILLNESS_SELECTOR"
#: data/mods/MindOverMatter/powers/vitakinesis_eoc.json
msgid "Attempt to cure your chemical imbalance."
msgstr "化学的不均衡の治療を試みます。"

#. ~ EOC option description in effect in EoC
#. "EOC_VITAKIN_BANISH_ILLNESS_SELECTOR"
#: data/mods/MindOverMatter/powers/vitakinesis_eoc.json
msgid "Attempt to cure your kaluptic psychosis."
msgstr "精神病の治療を試みます。"

#. ~ EOC option description in effect in EoC
#. "EOC_VITAKIN_BANISH_ILLNESS_SELECTOR"
#: data/mods/MindOverMatter/powers/vitakinesis_eoc.json
msgid "Attempt to cure your jitters."
msgstr "筋けいれんの治療を試みます。"

#. ~ EOC option description in effect in EoC
#. "EOC_VITAKIN_BANISH_ILLNESS_SELECTOR"
#: data/mods/MindOverMatter/powers/vitakinesis_eoc.json
msgid "Attempt to cure your mood swings."
msgstr "気分変動の治療を試みます。"

#. ~ EOC option description in effect in EoC
#. "EOC_VITAKIN_BANISH_ILLNESS_SELECTOR"
#: data/mods/MindOverMatter/powers/vitakinesis_eoc.json
msgid "Attempt to cure your weakening sickness."
msgstr "弱体化の治療を試みます。"

#. ~ EOC option description in effect in EoC
#. "EOC_VITAKIN_BANISH_ILLNESS_SELECTOR"
#: data/mods/MindOverMatter/powers/vitakinesis_eoc.json
msgid ""
"Attempt to cure your narcolepsy.  This meditation is extremely intensive, "
"and is correspondingly more draining."
msgstr "睡眠発作の治療を試みます。高い精神集中が必要になるため、体力を消耗します。"

#. ~ EOC option description in effect in EoC
#. "EOC_VITAKIN_BANISH_ILLNESS_SELECTOR"
#: data/mods/MindOverMatter/powers/vitakinesis_eoc.json
msgid "Attempt to cure your seasonal allergies."
msgstr "花粉症の治療を試みます。"

#. ~ EOC option description in effect in EoC
#. "EOC_VITAKIN_BANISH_ILLNESS_SELECTOR"
#: data/mods/MindOverMatter/powers/vitakinesis_eoc.json
msgid "Attempt to cure your seasonal affective disorder."
msgstr "季節性感情障害の治療を試みます。"

