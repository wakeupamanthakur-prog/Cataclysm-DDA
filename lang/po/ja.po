msgid "Disassemble the smoking rack"
msgstr "折り畳む"

#: src/iexamine.cpp:7072
msgid "Remove food from smoking rack"
msgstr "ラックから食品を取り出す"

#: src/iexamine.cpp:7076
msgid "Reload with charcoal… you don't have any"
msgstr "炭を装填する...持っていない"

#: src/iexamine.cpp:7077
msgid "Reload with charcoal… at maximum capacity"
msgstr "炭を装填する...最大容量"

#: src/iexamine.cpp:7078
