msgid "Can't learn"
msgstr "習得不可"

#: src/proficiency_ui.cpp:171
msgid "Time to learn"
msgstr "習得時間"

#: src/proficiency_ui.cpp:174
msgid "Progress"
msgstr "進行度"

#: src/proficiency_ui.cpp:177 src/proficiency_ui.cpp:230
#: src/safemode_ui.cpp:196
msgid "Category"
msgstr "カテゴリー"

#: src/proficiency_ui.cpp:181
msgid "Pre-requisites"
msgstr "習得条件"

#: src/proficiency_ui.cpp:192
msgid "Leads to"
msgstr "発展"

#: src/proficiency_ui.cpp:227
msgid "FILTERED"
msgstr "フィルタ"

#: src/proficiency_ui.cpp:238
msgid "filter"
msgstr "フィルタ"

#: src/proficiency_ui.cpp:239
msgid "help"
msgstr "ヘルプ"

