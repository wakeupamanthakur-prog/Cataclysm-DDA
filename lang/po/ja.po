msgid "teargas grenade cartridge"
msgid_plural "teargas grenade cartridges"
msgstr[0] "弾薬(擲弾/催涙)"

#. ~ Description of "teargas grenade cartridge"
#: data/mods/Generic_Guns/ammo/grenade.json
