msgstr "何か用か？"

#. ~ Response to NPC dialogue
#: data/json/npcs/lumbermill_employees/TALK_lumbermill_logger.json
#: data/json/npcs/random_encounters/camper_van_traveler.json
#: data/json/npcs/refugee_center/surface_staff/NPC_free_merchant_teamster.json
msgid ""
"I'm looking for a specific, strange building.  I wonder if you've heard "
"anything about it?"
msgstr "ある奇妙な建物を探している。何か知っていることはないか？"

#. ~ Response to NPC dialogue
#: data/json/npcs/lumbermill_employees/TALK_lumbermill_logger.json
msgid "How do things work around here now?"
msgstr "この辺りはどんな状況だ？"

#. ~ Response to NPC dialogue
#: data/json/npcs/lumbermill_employees/TALK_lumbermill_logger.json
#: data/json/npcs/scrap_trader/scrap_trader.json
msgid "Nah, see ya."
