msgstr "茶髪を短く刈り揃えています。"

#. ~ Variant name of mutation "Hair: buzz cut"
#: data/json/mutations/appearance_hair_styles.json
msgid "Hair: gray, buzz cut"
msgstr "髪型: 銀/丸刈り"

#. ~ Description of variant "Hair: gray, buzz cut" of mutation"Hair: buzz cut"
#: data/json/mutations/appearance_hair_styles.json
msgid "Your gray hair has been shaved close to the head."
msgstr "銀髪を短く刈り揃えています。"

#. ~ Variant name of mutation "Hair: buzz cut"
#: data/json/mutations/appearance_hair_styles.json
msgid "Hair: green, buzz cut"
msgstr "髪型: 緑/丸刈り"

#. ~ Description of variant "Hair: green, buzz cut" of mutation"Hair: buzz
#. cut"
#: data/json/mutations/appearance_hair_styles.json
msgid "Your green hair has been shaved close to the head."
msgstr "緑色の髪を短く刈り揃えています。"

#. ~ Variant name of mutation "Hair: buzz cut"
#: data/json/mutations/appearance_hair_styles.json
msgid "Hair: pink, buzz cut"
msgstr "髪型: 桃/丸刈り"

#. ~ Description of variant "Hair: pink, buzz cut" of mutation"Hair: buzz cut"
