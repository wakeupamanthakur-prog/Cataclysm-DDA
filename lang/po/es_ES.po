msgid ""
"If true, preserves the square shape of tiles shown on the pixel minimap."
msgstr ""
"Si está activado, preserva la forma cuadrada de los mosaicos mostrados en el"
" minimapa de píxeles."

#: src/options.cpp:2514
msgid "Creature beacon size"
msgstr "Tamaño ocupación de criatura"

#: src/options.cpp:2515
msgid "Controls how big the creature beacons are.  Value is in minimap tiles."
msgstr ""
"Controla el tamaño de las criaturas. El valor está en espacios del minimapa."

#: src/options.cpp:2521
msgid "Hostile creature beacon blink speed"
msgstr "Velocidad de parpadeo de baliza de criatura hostil"

#: src/options.cpp:2522
msgid ""
"Controls how fast the hostile creature beacons blink on the pixel minimap.  "
"Value is multiplied by 200ms.  0 = disabled."
msgstr ""
"Controla la rapidez con que las balizas de criaturas hostiles parpadean en "
"el minimapa de píxeles. El valor se multiplica por 200ms. Establecer en 0 = "
"deshabilitado."

#: src/options.cpp:2528
msgid "Background color"
msgstr "Color de fondo"

#: src/options.cpp:2529
msgid ""
"What color the minimap background should be.  Either based on color theme or"
" (0,0,0) black."
msgstr ""
"Que color debería tener el fondo del minimapa. Basado en el color del tema o"
" (0,0,0) negro."

#: src/options.cpp:2531
msgid "Theme"
msgstr "Tema"

#: src/options.cpp:2532
msgid "Black"
msgstr "Negro"

#: src/options.cpp:2542
msgid "Graphical Display Options"
msgstr "Opciones de Aspecto Gráfico"

#: src/options.cpp:2543
msgid "Options regarding graphical display."
msgstr "Opciones relacionadas con el aspecto gráfico."

#: src/options.cpp:2547
msgid "Display"
msgstr "Pantalla"

#: src/options.cpp:2548
msgid ""
"Sets which video display will be used to show the game.  Requires restart."
msgstr ""
"Establece la salida de vídeo que se usará para mostrar el juego. Requiere "
"reiniciar el juego."

#: src/options.cpp:2554 src/options.cpp:2556
msgid "Fullscreen"
msgstr "Pantalla completa"

#: src/options.cpp:2555
msgid "Starts Cataclysm in one of the fullscreen modes.  Requires restart."
msgstr ""
"Inicia Cataclysm en uno de los modos de pantalla completa. Requiere "
"reiniciar el juego."

#: src/options.cpp:2556
msgid "Maximized"
msgstr "Maximizado"

#: src/options.cpp:2556
msgid "Windowed borderless"
msgstr "En ventana sin bordes"

#: src/options.cpp:2569 src/options.cpp:2583
msgid "Renderer"
msgstr "Renderizador"

#: src/options.cpp:2570 src/options.cpp:2584
msgid "Set which renderer to use.  Requires restart."
msgstr "Establezca qué renderizador usar. Requiere reiniciar el juego."

#: src/options.cpp:2589
msgid "Software rendering"
msgstr "Render por software"

#: src/options.cpp:2590
msgid ""
"Use software renderer instead of graphics card acceleration.  Requires "
"restart."
msgstr ""
"Utiliza el procesador de software en lugar de la aceleración de la tarjeta "
"gráfica. Requiere reiniciar el juego."

#: src/options.cpp:2598
msgid "Allow render batching"
msgstr "Permitir cocinado de render"

#: src/options.cpp:2599
msgid ""
"If true, use render batching for 2D render API to make it more efficient.  "
"Requires restart."
msgstr ""
"Si está activado, utiliza el renderizado API por lotes 2D para hacerlo más "
"eficiente. Requiere reinicio."

#: src/options.cpp:2603
msgid "Software framebuffer acceleration"
msgstr "Software de aceleración de framebuffer"

#: src/options.cpp:2604
msgid ""
"If true, use hardware acceleration for the framebuffer when using software "
"rendering.  Requires restart."
msgstr ""
"Si esta activado, usa la aceleración de hardware para la cache de fotogramas"
" cuando se use el renderizado por software. Necesita un reinicio."

#: src/options.cpp:2614
msgid "Use color modulated textures"
msgstr "Usa texturas de color modulado"

#: src/options.cpp:2615
msgid ""
"If true, tries to use color modulated textures to speed-up ASCII drawing.  "
"Requires restart."
msgstr ""
"Si está activado, intenta usar texturas de color modulado para acelerar el "
"dibujo ASCII. Requiere reiniciar el juego."

#: src/options.cpp:2619
msgid "Scaling mode"
msgstr "Modo de escalado"

#: src/options.cpp:2620
msgid ""
"Sets the scaling mode, 'none' (default) displays at the game's native "
"resolution, 'nearest' uses low-quality but fast scaling, and 'linear' "
"provides high-quality scaling."
msgstr ""
"Establece el modo de escalamiento, 'nada' (predeterminado) se muestra en la "
"resolución del juego, 'cercano' usa baja calidad pero escalamiento rápido, y"
" 'lineal' brinda escalamiento de alta calidad."

#. ~ Do not scale the game image to the window size.
#: src/options.cpp:2622
msgid "No scaling"
msgstr "Sin escalado"

#. ~ An algorithm for image scaling.
#: src/options.cpp:2624
msgid "Nearest neighbor"
msgstr "Más cercano"

#. ~ An algorithm for image scaling.
#: src/options.cpp:2626
msgid "Linear filtering"
msgstr "Filtrado lineal"

#: src/options.cpp:2631
msgid "Scaling factor"
msgstr "Factor de escala"

#: src/options.cpp:2632
msgid "Factor by which to scale the display.  Requires restart."
msgstr "Factor por el cual escalar la pantalla. Requiere reiniciar el juego."

#: src/options.cpp:2633
msgid "1x"
msgstr "1x"

#: src/options.cpp:2634
msgid "2x"
msgstr "2x"

#: src/options.cpp:2635
msgid "4x"
msgstr "4x"

#: src/options.cpp:2649
msgid "World end handling"
msgstr "Gestión del mundo al morir"

#: src/options.cpp:2650
msgid "Handling of game world when last character dies."
msgstr "Como tratar el mundo después de que el último personaje muera."

#: src/options.cpp:2652
msgid "Keep"
msgstr "Mantener"

#: src/options.cpp:2652
msgid "Query"
msgstr "Preguntar"

#: src/options.cpp:2658
msgid "Game World Options"
msgstr "Opciones del Mundo del Juego"

#: src/options.cpp:2659
msgid "Options regarding game world."
msgstr "Opciones relacionadas con el mundo del juego."

#: src/options.cpp:2661
msgid "Size of cities"
msgstr "Tamaño de las ciudades"

#: src/options.cpp:2662
msgid ""
"A number determining how large cities are.  A higher number means larger "
"cities.  0 disables cities, roads and any scenario requiring a city start."
msgstr ""
"Un número que determina el tamaño de las ciudades. Un número mayor significa"
" ciudades más grandes. El 0 desactiva las ciudades, las carreteras y "
"cualquier escenario que requiera el inicio de una ciudad."

#: src/options.cpp:2666
msgid "City spacing"
msgstr "Separación de ciudades"

#: src/options.cpp:2667
msgid ""
"A number determining how far apart cities are.  A higher number means cities"
" are further apart.  Warning, small numbers lead to very slow mapgen."
msgstr ""
"Un número que determina la distancia entre las ciudades. Un número mayor "
"significa que las ciudades están más separadas. Atención, los números "
"pequeños hacen que la generación de mapas sea muy lenta."

#: src/options.cpp:2671
msgid "Spawn rate scaling factor"
msgstr "Factor variable de generación de monstruos"

#: src/options.cpp:2672
msgid ""
"A scaling factor that determines density of monster spawns.  A higher number"
" means more monsters."
msgstr ""
"Un factor de escala que determina la densidad de aparición de monstruos. Un "
"número más alto significa más monstruos."

#: src/options.cpp:2676
msgid "Item spawn scaling factor"
msgstr "Factor variable de generación de objetos"

#: src/options.cpp:2677
msgid ""
"A scaling factor that determines density of item spawns.  A higher number "
"means more items."
msgstr ""
"Un factor de escala que determina la densidad de aparición de objetos. Un "
"número mayor significa más objetos."

#: src/options.cpp:2681
msgid "Random NPC spawn time"
msgstr "Tiempo de aparición aleatoria de PNJ"

#: src/options.cpp:2682
msgid ""
"Baseline average number of days between random NPC spawns.  Average duration"
" goes up with the number of NPCs already spawned.  A higher number means "
"fewer NPCs.  Set to 0 days to disable random NPCs."
msgstr ""
"Número medio de días entre la aparición de un PNJ aleatorio. La duración "
"media aumenta con el número de PNJs que ya han aparecido. Un número mayor "
"significa menos PNJs. Poner a 0 días para desactivar los PNJs aleatorios."

#: src/options.cpp:2687
msgid "Monster evolution scaling factor"
msgstr "Factor variable de evolución de monstruos"

#: src/options.cpp:2688
msgid ""
"A scaling factor that determines the time between monster upgrades.  A "
"higher number means slower evolution.  Set to 0.00 to turn off monster "
"upgrades."
msgstr ""
"Factor de escala que determina el tiempo que pasa entre las mejoras de los "
"monstruos. Un número alto significa una evolución más lenta. Cámbialo a 0,00"
" para desactivar la mejora de monstruos."

#: src/options.cpp:2695
msgid "Monster Properties Options"
msgstr "Opciones de Propiedades de Monstruos"

#: src/options.cpp:2696
msgid "Options regarding monster properties."
msgstr "Opciones relacionadas con las propiedades de monstruos."

#: src/options.cpp:2698
msgid "Monster speed"
msgstr "Velocidad de los monstruos"

#: src/options.cpp:2699
msgid ""
"Determines the movement rate of monsters.  A higher value increases monster "
"speed and a lower reduces it.  Requires world reset."
msgstr ""
"Determina la velocidad de movimiento de los monstruos. Un valor más alto "
"aumenta la velocidad del monstruo y un valor más bajo la reduce. Requiere "
"reinicio del mundo."

#: src/options.cpp:2703
msgid "Monster resilience"
msgstr "Resistencia de los monstruos"

#: src/options.cpp:2704
msgid ""
"Determines how much damage monsters can take.  A higher value makes monsters"
" more resilient and a lower makes them more flimsy.  Requires world reset."
msgstr ""
"Determina cuánto daño pueden recibir los monstruos. Un valor más alto hace "
"que los monstruos sean más resistentes y un valor más bajo los hace más "
"débiles. Requiere reinicio del mundo."

#: src/options.cpp:2711
msgid "Default region type"
msgstr "Tipo predeterminado de región"

#: src/options.cpp:2712
msgid "(WIP feature) Determines terrain, shops, plants, and more."
msgstr ""
"(en elaboración) Determina el terreno, los comercios, las plantas y otras "
"cosas."

#: src/options.cpp:2718
msgid "Spawn Time Options"
msgstr "Opciones de Tiempo de Aparición"

#: src/options.cpp:2719
msgid "Options regarding spawn time."
msgstr "Opciones relacionadas con el tiempo de aparición."

#: src/options.cpp:2721
msgid "Season length"
msgstr "Duración de las estaciones"

#: src/options.cpp:2722
msgid ""
"Season length, in days.  Warning: Very little other than the duration of "
"seasons scales with this value, so adjusting it may cause nonsensical "
"results."
msgstr ""
"Duración de las estaciones, en días. Advertencia: Muy pocas cosas además de "
"la duración de las estaciones cambia con este valor, así que cambiarlo puede"
" llevar a resultados sin sentido."

#: src/options.cpp:2726
msgid "Construction scaling"
msgstr "Escala de construcción"

#: src/options.cpp:2727
msgid ""
"Sets the time of construction in percents.  '50' is two times faster than "
"default, '200' is two times longer.  '0' automatically scales construction "
"time to match the world's season length."
msgstr ""
"Establece el tiempo de construcción en porcentajes. '50' es el doble de "
"rápido que el predeterminado, '200' hará que tarde el doble, '0' escala "
"automáticamente los tiempos de construcción para igualarlos a la duración de"
" las estaciones del año del mundo."

#: src/options.cpp:2731
msgid "Eternal season"
msgstr "Estación eterna"

#: src/options.cpp:2732
msgid "If true, keep the initial season for ever."
msgstr "Si está activado, mantiene la estación de inicio para siempre."

#: src/options.cpp:2736
msgid "Day/night cycle"
msgstr "Ciclo día/noche"

#: src/options.cpp:2737
msgid ""
"Day/night cycle settings.  'Normal' sets a normal cycle.  'Eternal Day' sets"
" eternal day.  'Eternal Night' sets eternal night."
msgstr ""
"Ajustes del ciclo día/noche. Normal\" establece un ciclo normal. Día "
"Eterno\" establece el día eterno. Noche Eterna\" establece la noche eterna."

#: src/options.cpp:2739
msgid "Eternal Day"
msgstr "Día Eterno"

#: src/options.cpp:2740
msgid "Eternal Night"
msgstr "Noche Eterna"

#: src/options.cpp:2748
msgid "Miscellaneous options."
msgstr "Opciones Misceláneas."

#: src/options.cpp:2750
msgid "Wandering hordes"
msgstr "Hordas errantes"

#: src/options.cpp:2751
msgid ""
"If true, emulates zombie hordes.  Zombies can group together into hordes, "
"which can wander around cities and will sometimes move towards noise.  Note:"
" the current implementation does not properly respect obstacles, so hordes "
"can appear to walk through walls under some circumstances.  Must reset world"
" directory after changing for it to take effect."
msgstr ""
"Si esta activado, emula hordas de zombies.  Los zombies pueden agruparse en "
"hordas, las cuales pueden pulular alrededor de las ciudades y a veces se "
"moverán hacia el ruido.  Nota: la implementación actual no respeta los "
"obstáculos adecuadamente, por lo que puede parecer que las hordas caminan "
"sobre muros en algunas circunstancias.  El directorio del mundo debe ser "
"reiniciado para que surta efecto."

#: src/options.cpp:2755
msgid "Surrounded start"
msgstr "Comenzar rodeado"

#: src/options.cpp:2756
msgid ""
"If true, spawn zombies at shelters.  Makes the starting game a lot harder."
msgstr ""
"Si activado, genera zombis en los centros de evacuación. Hace que el inicio "
"del juego sea mucho más difícil."

#: src/options.cpp:2763
msgid "Mutations by radiation"
msgstr "Mutaciones por radiación"

#: src/options.cpp:2764
msgid "If true, radiation causes the player to mutate."
msgstr "Si está activado, la radiación causará mutaciones en el personaje."

#: src/options.cpp:2770
msgid "Character point pools"
msgstr "Grupos de puntos de personaje"

#: src/options.cpp:2771
msgid "Allowed point pools for character generation."
msgstr "Grupos de puntos permitidos para la generación de personajes."

#: src/options.cpp:2772
msgid "Legacy Multipool"
msgstr "Antiguo Múltireserva"

#: src/options.cpp:2778
msgid "Meta Progression"
msgstr "Meta Progreso"

#: src/options.cpp:2779
msgid ""
"Will you need to complete certain achievements to enable certain scenarios "
"and professions?  Achievements are tracked from your memorial file so "
"characters from any world will be checked.  Disabling this will spoil "
"factions and situations you may otherwise stumble upon naturally.  Some "
"scenarios are frustrating for the uninitiated and some professions skip "
"portions of the games content.  If new to the game meta progression will "
"help you be introduced to mechanics at a reasonable pace."
msgstr ""
"¿Necesitarás completar ciertos logros para habilitar determinados escenarios"
" y profesiones? Los logros se rastrean desde tu expediente histórico, por lo"
" que se comprobarán los personajes de cualquier mundo. Si se desactiva esto,"
" se estropearán facciones y situaciones con las que se puede tropezar de "
"forma natural. Algunos escenarios son frustrantes para los novatos y algunas"
" profesiones omiten partes del contenido del juego. Si eres nuevo en el "
"juego, el meta progreso te ayudará a introducirte en las mecánicas a un "
"ritmo razonable."

#: src/options.cpp:2790
msgid "Distance initial visibility"
msgstr "Distancia visible inicial"

#: src/options.cpp:2791
msgid "Determines the scope, which is known in the beginning of the game."
msgstr "Determina el alcance visible, lo que es visto al inicio del juego."

#: src/options.cpp:2798
msgid "Character Generation Points Options"
msgstr "Opciones de Puntos de Generación de Personaje"

#: src/options.cpp:2799
msgid "Options regarding character generation points."
msgstr "Opciones relacionadas con los puntos de generación de personaje."

#: src/options.cpp:2801
msgid "Initial stat points"
msgstr "Puntos iniciales de características"

#: src/options.cpp:2802
msgid "Initial points available to spend on stats on character generation."
msgstr ""
"Son los puntos iniciales disponibles para gastar en atributos al crear el "
"personaje."

#: src/options.cpp:2806
msgid "Initial trait points"
msgstr "Puntos iniciales de rasgos"

#: src/options.cpp:2807
msgid "Initial points available to spend on traits on character generation."
msgstr ""
"Son los puntos iniciales disponibles para gastar en rasgos al crear el "
"personaje."

#: src/options.cpp:2811
msgid "Initial skill points"
msgstr "Puntos iniciales de habilidades"

#: src/options.cpp:2812
msgid "Initial points available to spend on skills on character generation."
msgstr ""
"Son los puntos iniciales disponibles para gastar en habilidades al crear el "
"personaje."

#: src/options.cpp:2816
msgid "Maximum trait points"
msgstr "Puntos máximos de rasgos"

#: src/options.cpp:2817
msgid "Maximum trait points available for character generation."
msgstr ""
"Los puntos máximos de rasgos que tendrás disponibles cuando crees tu "
"personaje."

#: src/options.cpp:2824
msgid "Show values for character creation"
msgstr "Mostrar valores para la generación de personaje"

#: src/options.cpp:2825
msgid ""
"In character creation will show the underlying value that is used to "
"determine difficulty."
msgstr ""
"En la generación de personaje se mostraran los valores por debajo de lo que "
"se usa para determinar la dificultad."

#: src/options.cpp:2831
msgid "Skill training speed"
msgstr "Velocidad de entrenamiento de habilidad"

#: src/options.cpp:2832
msgid ""
"Scales experience gained from practicing skills and reading books.  0.5 is "
"half as fast as default, 2.0 is twice as fast, 0.0 disables skill training "
"except for NPC training."
msgstr ""
"Escala la experiencia ganada al practicar habilidades y leer libros. 0,5 es "
"la mitad de lo predeterminado, 2,0 es el doble de rápido, 0,0 desactiva el "
"entrenamiento de habilidades excepto para el entrenamiento mediante PNJs."

#: src/options.cpp:2838
msgid "Proficiency training speed"
msgstr "Velocidad de entrenamiento de competencias"

#: src/options.cpp:2839
msgid ""
"Scales experience gained from practicing proficiencies.  0.5 is half as fast"
" as default, 2.0 is twice as fast, 0.0 disables proficiency training except "
"for NPC training."
msgstr ""
"Escala la experiencia ganada al practicar competencias. 0.5 es la mitad de "
"rápido que por defecto, 2.0 es el doble de rápido, 0.0 deshabilita el "
"entrenamiento de habilidades excepto para los PNJ."

#: src/options.cpp:2844
msgid "3D Field Of Vision Options"
msgstr "Opciones de Campo de Visión 3D"

#: src/options.cpp:2845
msgid "Options regarding 3D field of vision."
msgstr "Opciones relacionadas con el campo de visión 3D."

#: src/options.cpp:2847
msgid "Experimental 3D field of vision"
msgstr "Campo visual 3D experimental"

#: src/options.cpp:2848
msgid ""
"If true and the world is in Z-level mode, the vision will extend beyond "
"current Z-level.  If false, vision is limited to current Z-level."
msgstr ""

#: src/options.cpp:2852
msgid "Vertical range of 3D field of vision"
msgstr "Alcance vertical del campo de visión 3D"

#: src/options.cpp:2853
msgid ""
"How many levels up and down the experimental 3D field of vision reaches and "
"is drawn on screen.  (This many levels up, this many levels down.)  3D "
"vision of the full height of the world can slow the game down a lot.  Seeing"
" fewer Z-levels is faster."
msgstr ""

#: src/options.cpp:2860
msgid "Occlusion Options"
msgstr "Opciones de Oclusión"

#: src/options.cpp:2861
msgid "Options regarding occlusion."
msgstr "Opciones relacionadas con la oclusión."

#: src/options.cpp:2863
msgid "Handle occlusion by high sprites"
msgstr "Manejar oclusión de gráficos altos"

#: src/options.cpp:2864
msgid ""
"Draw walls normal (Off), retracted/transparent (On), or automatically "
"retracting/transparent near player (Auto)."
msgstr ""
"Dibuja muros normalmente (Desactivado), retractado/transparente (Activado) o"
" automáticamente retractándose/transparentándose cerca del jugador "
"(Automático)."

#: src/options.cpp:2870
msgid "Prevent occlusion via transparency"
msgstr "Prevenir oclusión usando transparencia"

#: src/options.cpp:2871
msgid "Prevent occlusion by using semi-transparent sprites."
msgstr "Prevenir oclusión usando gráficos semitransparentes."

#: src/options.cpp:2875
msgid "Prevent occlusion via retraction"
msgstr "Prevenir oclusión usando retracción"

#: src/options.cpp:2876
msgid "Prevent occlusion by retracting high sprites."
msgstr "Prevenir oclusión usando retracción de gráficos altos."

#: src/options.cpp:2881
msgid "Minimum distance for auto occlusion handling"
msgstr "Distancia mínima para el manejo de oclusión"

#: src/options.cpp:2882
msgid ""
"Minimum distance for auto occlusion handling.  Values above zero overwrite "
"tileset settings."
msgstr ""
"Distancia mínima para el manejo de oclusión. Valores por encima de cero "
"sobreescriben las preferencias del teselado."

#: src/options.cpp:2887
msgid "Maximum distance for auto occlusion handling"
msgstr "Distancia máxima para el manejo de oclusión automático"

#: src/options.cpp:2888
msgid ""
"Maximum distance for auto occlusion handling.  Values above zero overwrite "
"tileset settings."
msgstr ""
"Distancia máxima para el manejo de auto oclusión. Valores por encima de cero"
" sobreescriben las preferencias del teselado."

#: src/options.cpp:2903
msgid "Quicksave on app lose focus"
msgstr "Guardado rápido al pasar a segundo plano"

#: src/options.cpp:2904
msgid ""
"If true, quicksave whenever the app loses focus (screen locked, app moved "
"into background etc.)  WARNING: Experimental.  This may result in corrupt "
"save games."
msgstr ""
"Si esta activado, guarda rápido cada vez que la ventana pierda el foco "
"(bloque de pantalla, el programa pasa al fondo, etc.)  AVISO: Experimental."
"  Esto puede acabar corrompiendo las partidas guardadas."

#: src/options.cpp:2911
msgid "Android Keyboard Options"
msgstr ""

#: src/options.cpp:2912
msgid "Options regarding Android keyboard."
msgstr ""

#: src/options.cpp:2914
msgid "Trap Back button"
msgstr "Trampa Back button"

#: src/options.cpp:2915
msgid ""
"If true, the back button will NOT back out of the app and will be passed to "
"the application as SDL_SCANCODE_AC_BACK.  Requires restart."
msgstr ""
"Si esta a verdadero, el botón \"retroceso\" NO se retirará de la aplicación "
"y se pasará a la aplicación como SDL_SCANCODE_AC_BACK. Requiere reiniciar."

#: src/options.cpp:2920
msgid "Use native Android UI menus"
msgstr "Usar menus nativos de Interfaz de Usuario de Android"

#: src/options.cpp:2921
msgid ""
"If true, native Android dialogs are used for some in-game menus, such as "
"popup messages and yes/no dialogs."
msgstr ""
"Si activo, menus nativos de Android serán usados en algunos menus del juego,"
" tales como ventanas emergente y dialogos si/no"

#: src/options.cpp:2926
msgid "Auto-manage virtual keyboard"
msgstr "Gestionar automáticamente el teclado virtual"

#: src/options.cpp:2927
msgid ""
"If true, automatically show/hide the virtual keyboard when necessary based "
"on context.  If false, virtual keyboard must be toggled manually."
msgstr ""
"Si está activado, muestra y oculta automáticamente el teclado virtual cuando"
" sea necesario, basado en el contexto. Si está desactivado, el teclado "
"virtual se debe activar manualmente."

#: src/options.cpp:2932
msgid "Virtual keyboard screen scale"
msgstr "Escala de la pantalla del teclado virtual"

#: src/options.cpp:2933
msgid ""
"If true, when the virtual keyboard is visible, scale the screen to prevent "
"overlapping.  Useful for text entry so you can see what you're typing."
msgstr ""
"Si esta activado, cuando el teclado virtual este visible, escala la pantalla"
" para prevenir solapamiento.  Útil para entradas de texto y que puedas ver "
"lo que estas escribiendo."

#: src/options.cpp:2940
msgid "Vibration duration"
msgstr "Duración de la vibración"

#: src/options.cpp:2941
msgid ""
"If non-zero, vibrate the device for this long on input, in milliseconds.  "
"Ignored if hardware keyboard connected."
msgstr ""
"Si no es cero, hace vibrar el dispositivo durante este tiempo al introducir "
"datos, en milisegundos. Se ignora si el teclado de hardware está conectado."

#: src/options.cpp:2948
msgid "Android Joystick Options"
msgstr ""

#: src/options.cpp:2949
msgid "Options regarding Android Joystick."
msgstr ""

#: src/options.cpp:2951
msgid "Show virtual joystick"
msgstr "Mostrar joystick virtual"

#: src/options.cpp:2952
msgid ""
"If true, show the virtual joystick when touching and holding the screen.  "
"Gives a visual indicator of deadzone and stick deflection."
msgstr ""
"Si esta activado, muestra la palanca de mando virtual cuando se toque o "
"mantenga apretada la pantalla.  Da un indicador visual de la zona muerta y "
"el desvío de la palanca."

#: src/options.cpp:2956
msgid "Virtual joystick opacity"
msgstr "Opacidad del joystick virtual"

#: src/options.cpp:2957
msgid "The opacity of the on-screen virtual joystick, as a percentage."
msgstr "Opacidad del joystick virtual, como porcentaje."

#: src/options.cpp:2961
msgid "Virtual joystick deadzone size"
msgstr "Tamaño de la zona muerta del joystick virtual"

#: src/options.cpp:2962
msgid ""
"While using the virtual joystick, deflecting the stick beyond this distance "
"will trigger directional input.  Specified as a percentage of longest screen"
" edge."
msgstr ""
"Cuando se usa el joystick virtual la desviación de la palanca más allá de "
"esta distancia activará la entrada de datos direccionales. Se especifica "
"como porcentaje del borde de pantalla máximo."

#: src/options.cpp:2966
msgid "Virtual joystick size"
msgstr "Tamaño del joystick virtual"

#: src/options.cpp:2967
msgid ""
"While using the virtual joystick, deflecting the stick by this much will "
"repeat input at the deflected rate (see below).  Specified as a percentage "
"of longest screen edge."
msgstr ""
"Cuando se usa el joystick virtual, desviar la palanca esta cantidad hará que"
" se repita la entrada de datos a la velocidad de desvío (ver abajo). Se "
"especifica como porcentaje del borde de pantalla más largo."

#: src/options.cpp:2972
msgid "Virtual joystick follows finger"
msgstr "Joystick virtual sigue a los dedos"

#: src/options.cpp:2973
msgid ""
"If true, the virtual joystick will follow when sliding beyond its range."
msgstr ""
"Si está activado, el joystick virtual continuará cuando se haga un "
"deslizamiento más allá de su alcance."

#: src/options.cpp:2978
msgid "Virtual joystick repeat rate (centered)"
msgstr "Velocidad de repetición del joystick virtual (centrado)"

#: src/options.cpp:2979
msgid ""
"When the virtual joystick is centered, how fast should input events repeat, "
"in milliseconds."
msgstr ""
"Cuando el joystick virtual está centrado, cómo de rápido deberían repetirse "
"los eventos de entrada de datos, en milisegundos."

#: src/options.cpp:2984
msgid "Virtual joystick repeat rate (deflected)"
msgstr "Velocidad de repetición del joystick virtual (desviado)"

#: src/options.cpp:2985
msgid ""
"When the virtual joystick is fully deflected, how fast should input events "
"repeat, in milliseconds."
msgstr ""
"Cuando el joystick virtual esté totalmente desviado, cómo de rápido se "
"repetirán los eventos de entrada de datos, en milisegundos."

#: src/options.cpp:2990
msgid "Virtual joystick repeat rate sensitivity"
msgstr "Sensibilidad de la velocidad de repetición del joystick virtual"

#: src/options.cpp:2991
msgid ""
"As the virtual joystick moves from centered to fully deflected, this value "
"is an exponent that controls the blend between the two repeat rates defined "
"above.  1.0 = linear."
msgstr ""
"Al mover el joystick virtual de centrado a totalmente desviado, este valor "
"es un exponente que controla la mezcla entre las dos velocidades de "
"repetición definidas arriba. 1,0 = lineal."

#: src/options.cpp:2995
msgid "Input repeat delay"
msgstr "Retraso de la repetición de entrada de datos"

#: src/options.cpp:2996
msgid ""
"While touching the screen, wait this long before showing the virtual "
"joystick and repeating input, in milliseconds.  Also used to determine "
"tap/double-tap detection, flick detection and toggling quick shortcuts."
msgstr ""
"Al tocar la pantalla esperar este tiempo antes de mostrar el joystick "
"virtual y repetir la entrada de datos, en milisegundos. También se usa para "
"determinar la detección de toque/doble toque, detección de giro y activación"
" de los atajos de teclado rápidos."

#: src/options.cpp:3000
msgid "Virtual joystick hides shortcuts"
msgstr "Joystick virtual oculta atajos de teclado"

#: src/options.cpp:3001
msgid ""
"If true, hides on-screen keyboard shortcuts while using the virtual "
"joystick.  Helps keep the view uncluttered while traveling long distances "
"and navigating menus."
msgstr ""
"Si está activado, oculta los atajos de teclado en pantalla mientras se "
"utiliza el joystick virtual. Ayuda a mantener despejada la pantalla mientras"
" se recorren largas distancias y se navega por los menús."

#: src/options.cpp:3009 src/options.cpp:3083
msgid "Android Shortcut Options"
msgstr ""

#: src/options.cpp:3010
msgid "Options regarding Android shortcut."
msgstr ""

#: src/options.cpp:3012
msgid "Default gameplay shortcuts"
msgstr "Atajos del juego predeterminados"

#: src/options.cpp:3013
msgid ""
"The default set of gameplay shortcuts to show.  Used on starting a new game "
"and whenever all gameplay shortcuts are removed."
msgstr ""
"El conjunto de atajos del juego a mostrar. Se usa al empezar una nueva "
"partida y cuando se eliminan todos los atajos del juego."

#: src/options.cpp:3018
msgid "Add shortcuts for action menu selections"
msgstr "Añadir atajos para elecciones del menú de acciones"

#: src/options.cpp:3019
msgid ""
"If true, automatically add a shortcut for actions selected via the in-game "
"action menu."
msgstr ""
"Si activado, añade automáticamente un atajo para las acciones elegidas a "
"través del menú de acciones del juego."

#: src/options.cpp:3024
msgid "Add shortcuts for inventory selections"
msgstr "Añadir atajos para elecciones del inventario"

#: src/options.cpp:3025
msgid ""
"If true, automatically add a shortcut for items selected via the inventory."
msgstr ""
"Si activado, añade automáticamente atajos para objetos seleccionados a "
"través del inventario."

#: src/options.cpp:3033
msgid "Android Gestures Options"
msgstr ""

#: src/options.cpp:3034
msgid "Options regarding Android gestures."
msgstr ""

#: src/options.cpp:3036
msgid "Tap key (in-game)"
msgstr "Tecla de toque (mientras se juega)"

#: src/options.cpp:3037
msgid "The key to press when tapping during gameplay."
msgstr "La tecla a apretar cuando se da un toque mientras se juega."

#: src/options.cpp:3041
msgid "Two-finger tap key (in-game)"
msgstr "Tecla de toque con dos dedos (mientras se juega)"

#: src/options.cpp:3042
msgid "The key to press when tapping with two fingers during gameplay."
msgstr ""
"La tecla a apretar cuando se da un toque con dos juegos mientras se juega."

#: src/options.cpp:3046
msgid "Two-finger swipe up key (in-game)"
msgstr ""
"Tecla para deslizamiento hacia arriba con dos dedos (mientras se juega)"

#: src/options.cpp:3047
msgid "The key to press when swiping up with two fingers during gameplay."
msgstr ""
"La tecla a apretar cuando se desplaza hacia arriba con dos dedos mientras se"
" juega."

#: src/options.cpp:3052
msgid "Two-finger swipe down key (in-game)"
msgstr "Tecla de desplazar hacia abajo con dos dedos (dentro del juego)"

#: src/options.cpp:3053
msgid "The key to press when swiping down with two fingers during gameplay."
msgstr ""
"La tecla a apretar cuando se desplaza hacia abajo con dos dedos mientras se "
"juega."

#: src/options.cpp:3058
msgid "Two-finger swipe left key (in-game)"
msgstr ""
"Tecla de desplazar hacia la izquierda con dos dedos (dentro del juego)"

#: src/options.cpp:3059
msgid "The key to press when swiping left with two fingers during gameplay."
msgstr ""
"La tecla a apretar cuando se desplaza hacia la izquierda con dos dedos "
"mientras se juega."

#: src/options.cpp:3064
msgid "Two-finger swipe right key (in-game)"
msgstr "Tecla de desplazar hacia la derecha con dos dedos (dentro del juego)"

#: src/options.cpp:3065
msgid "The key to press when swiping right with two fingers during gameplay."
msgstr ""
"La tecla a apretar cuando se desplaza hacia la derecha con dos dedos "
"mientras se juega."

#: src/options.cpp:3069
msgid "Pinch in key (in-game)"
msgstr "Tecla de agrandar con dos dedos (dentro del juego)"

#: src/options.cpp:3070
msgid "The key to press when pinching in during gameplay."
msgstr "La tecla a apretar cuando se agranda con dos dedos mientras se juega."

#: src/options.cpp:3074
msgid "Pinch out key (in-game)"
msgstr "Tecla de reducir con dos dedos (dentro del juego)"

#: src/options.cpp:3075
msgid "The key to press when pinching out during gameplay."
msgstr "La tecla a apretar cuando se reduce con dos dedos mientras se juega."

#: src/options.cpp:3084
msgid "Options regarding In-game shortcut."
msgstr "Opciones relacionadas con los atajos dentro del juego."

#: src/options.cpp:3087
msgid "Auto-manage contextual gameplay shortcuts"
msgstr "Gestionar automáticamente atajos contextuales del juego"

#: src/options.cpp:3088
msgid ""
"If true, contextual in-game shortcuts are added and removed automatically as"
" needed: examine, close, butcher, move up/down, control vehicle, pickup, "
"toggle enemy + safe mode, sleep."
msgstr ""
"Si está activado, los atajos contextuales del juego son añadidos y quitados "
"automáticamente conforme se vayan necesitando: examinar, cerrar, "
"descuartizar, mover arriba/abajo, conducir vehículo, recoger, activar modo "
"seguro, dormir."

#: src/options.cpp:3093
msgid "Move contextual gameplay shortcuts to front"
msgstr "Mover los atajos contextuales del juego al principio"

#: src/options.cpp:3094
msgid ""
"If the option above is enabled, specifies whether contextual in-game "
"shortcuts will be added to the front or back of the shortcuts list.  If "
"true, makes them easier to reach.  If false, reduces shuffling of shortcut "
"positions."
msgstr ""
"Si la opción de arriba está activada, especifica si los atajos contextuales "
"dentro del juego se añadirán al principio o al final de la lista de atajos. "
"Si está activado hace que sean más fáciles de alcanzar, si es falso reduce "
"los cambios de las posiciones de los atajos."

#: src/options.cpp:3098
msgid "Move used shortcuts to front"
msgstr "Mueve los atajos usados al principio"

#: src/options.cpp:3099
msgid ""
"If true, using an existing shortcut will always move it to the front of the "
"shortcuts list.  If false, only shortcuts typed via keyboard will move to "
"the front."
msgstr ""
"Si está activado, utilizar un atajo existente siempre lo moverá al principio"
" de la lista de atajos. Si está desactivado, solo los atajos introducidos "
"mediante el teclado se moverán al principio."

#: src/options.cpp:3104
msgid "Separate shortcuts for No Auto Pickup zones"
msgstr "Separar los atajos para las zonas Sin Autorecogida"

#: src/options.cpp:3105
msgid ""
"If true, separate gameplay shortcuts will be used within No Auto Pickup "
"zones.  Useful for keeping home base actions separate from exploring "
"actions."
msgstr ""
"Si está activado, un conjunto separado de los atajos del juego será usado "
"dentro de las zonas Sin Autorecogida. Útil para tener separadas las acciones"
" dentro de la base de las acciones de exploración."

#: src/options.cpp:3110
msgid "Turns to remove unused gameplay shortcuts"
msgstr "Turnos para eliminar atajos de juego no utilizados"

#: src/options.cpp:3111
msgid ""
"If non-zero, unused gameplay shortcuts will be removed after this many turns"
" (as in discrete player actions, not world calendar turns)."
msgstr ""
"Si no es cero, los atajos del juego no utilizados serán eliminados tras ese "
"número de turnos (contando las acciones del juegador, no los turnos del "
"calendario del mundo)."

#: src/options.cpp:3115
msgid "Shortcuts persistence"
msgstr "Persistencia de los atajos"

#: src/options.cpp:3116
msgid ""
"If true, shortcuts are saved/restored with each save game.  If false, "
"shortcuts reset between sessions."
msgstr ""
"Si está activado, los atajos son guardados/restaurados en cada partida "
"guardada. Si está desactivado, los atajos se reinician entre las sesiones."

#: src/options.cpp:3124
msgid "Shortcut Screen Options"
msgstr ""

#: src/options.cpp:3125
msgid "Options regarding shortcut screen."
msgstr ""

#: src/options.cpp:3127
msgid "Shortcuts position"
msgstr "Posición de los atajos"

#: src/options.cpp:3128
msgid ""
"Switch between shortcuts on the left or on the right side of the screen."
msgstr ""
"Intercambia la posición de los atajos en la zona izquierda o derecha de la "
"pantalla."

#: src/options.cpp:3133
msgid "Shortcuts screen percentage"
msgstr "Porcentaje de la pantalla de atajos"

#: src/options.cpp:3134
msgid ""
"How much of the screen can shortcuts occupy, as a percentage of total screen"
" width."
msgstr ""
"Cuánto de la pantalla pueden ocupar los atajos, como un porcentaje total del"
" ancho de la pantalla."

#: src/options.cpp:3138
msgid "Shortcuts overlap screen"
msgstr "Pantalla de superposición de los atajos"

#: src/options.cpp:3139
msgid ""
"If true, shortcuts will be drawn transparently overlapping the game screen."
"  If false, the game screen size will be reduced to fit the shortcuts below."
msgstr ""
"Si está activado, los atajos de teclado aparecerán de forma traslúcida sobre"
" la pantalla del juego. Si lo desactivas el tamaño de la ventana se reducirá"
" para que quepan en la parte de abajo los atajos."

#: src/options.cpp:3143
msgid "Shortcut opacity (background)"
msgstr "Opacidad de los atajos (fondo)"

#: src/options.cpp:3144
msgid ""
"The background opacity of on-screen keyboard shortcuts, as a percentage."
msgstr ""
"La opacidad del fondo de los atajos de teclado en pantalla, como un "
"porcentaje."

#: src/options.cpp:3148
msgid "Shortcut opacity (shadow)"
msgstr "Opacidad de los atajos (sombra)"

#: src/options.cpp:3149
msgid "The shadow opacity of on-screen keyboard shortcuts, as a percentage."
msgstr ""
"La opacidad de la sombra de los atajos de teclado en pantalla, en "
"porcentaje."

#: src/options.cpp:3153
msgid "Shortcut opacity (text)"
msgstr "Opacidad de los atajos (texto)"

#: src/options.cpp:3154
msgid ""
"The foreground opacity of on-screen keyboard shortcuts, as a percentage."
msgstr ""
"La opacidad del primer plano de los atajos de teclado en pantalla, como un "
"porcentaje."

#: src/options.cpp:3158
msgid "Shortcut color"
msgstr "Color de los atajos"

#: src/options.cpp:3159
msgid "The color of on-screen keyboard shortcuts."
msgstr "El color de los atajos de teclado en pantalla."

#: src/options.cpp:3163
msgid "Shortcut border"
msgstr "Borde de los atajos"

#: src/options.cpp:3164
msgid "The border of each on-screen keyboard shortcut in pixels."
msgstr "El borde de cada atajo de teclado en pantalla en píxeles."

#: src/options.cpp:3168
msgid "Shortcut width (min)"
msgstr "Ancho de los atajos (mín)"

#: src/options.cpp:3169
msgid ""
"The minimum width of each on-screen keyboard shortcut in pixels.  Only "
"relevant when lots of shortcuts are visible at once."
msgstr ""
"La anchura mínima de los atajos de teclado en pantalla en píxeles. Solo es "
"relevante cuando hay muchos atajos visibles a la vez."

#: src/options.cpp:3173
msgid "Shortcut width (max)"
msgstr "Ancho de los atajos (máx)"

#: src/options.cpp:3174
msgid "The maximum width of each on-screen keyboard shortcut in pixels."
msgstr "La anchura máxima de los atajos de teclado en pantalla en píxeles."

#: src/options.cpp:3178
msgid "Shortcut height"
msgstr "Altura de los atajos"

#: src/options.cpp:3179
msgid "The height of each on-screen keyboard shortcut in pixels."
msgstr "La altura de cada atajo de teclado en pantalla en píxeles."

