msgid_plural "dionaeas"
msgstr[0] "dionaea"
msgstr[1] "dionaeas"
msgstr[2] "dionaeas"

#. ~ Description of monster "dionaea"
#: data/mods/TropiCataclysm/monsters/tropical_triffid.json
msgid ""
"A strange triffid bearing something similar to a head.  Its false mouth is "
"covered in razorsharp needles."
msgstr ""
"Un extraño trífido con algo parecido a una cabeza. Su falsa boca está "
"cubierta de agujas afiladas."

#. ~ Monster name
#: data/mods/TropiCataclysm/monsters/tropical_triffid.json
msgid "sarracenia"
msgid_plural "sarracenias"
msgstr[0] "sarracenia"
msgstr[1] "sarracenias"
msgstr[2] "sarracenias"

#. ~ Description of monster "sarracenia"
#: data/mods/TropiCataclysm/monsters/tropical_triffid.json
msgid ""
"A strange triffid with a wide vase-like body.  It moves carefully while "
"carrying what appears to be a half-digested prey."
msgstr ""
"Un extraño trífido con un cuerpo ancho en forma de jarrón. Se mueve con "
"cuidado mientras lleva lo que parece ser una presa a medio digerir."

#. ~ Monster name
#: data/mods/TropiCataclysm/monsters/tropical_triffid.json
msgid "rafflesia"
msgid_plural "rafflesias"
msgstr[0] "rafflesia"
msgstr[1] "rafflesias"
msgstr[2] "rafflesias"

#. ~ Description of monster "rafflesia"
#: data/mods/TropiCataclysm/monsters/tropical_triffid.json
msgid ""
"A large walking plant with an enormous flower-like upper body.  Its center "
"has what appears to be a mouth and seems to emit a really bad aroma."
msgstr ""
"Una gran planta andante con un enorme cuerpo superior en forma de flor. Su "
"centro tiene lo que parece ser una boca y parece emitir un aroma realmente "
"malo."

#. ~ Monster message of special attack of monster "rafflesia"
#: data/mods/TropiCataclysm/monsters/tropical_triffid.json
msgid "The rafflesia spews toxic gas!"
msgstr "¡La raflesia expulsa gas tóxico!"

#. ~ Monster name
#: data/mods/TropiCataclysm/monsters/tropical_triffid.json
msgid "yateveo"
msgid_plural "yateveos"
msgstr[0] "yateveo"
msgstr[1] "yateveos"
msgstr[2] "yateveos"

#. ~ Description of monster "yateveo"
#: data/mods/TropiCataclysm/monsters/tropical_triffid.json
msgid ""
"A large walking plant shaped in the likes of a tree.  It has several long "
"vines ending in sharp wooden spikes."
msgstr ""
"Una gran planta andante con forma de árbol. Tiene varias lianas largas que "
"terminan en puntas de madera afiladas."

#. ~ Monster name
#: data/mods/TropiCataclysm/monsters/tropical_zombies.json
