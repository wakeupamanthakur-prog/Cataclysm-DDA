#. ~ Item name
#: data/json/items/tool/explosives.json
msgid "homemade bomb"
msgid_plural "homemade bombs"
msgstr[0] "bombs casera"
msgstr[1] "bombas caseras"
msgstr[2] "bombas caseras"

#. ~ Description of "homemade bomb"
#: data/json/items/tool/explosives.json
msgid ""
"A homemade explosive device, consisting of a large plastic jug filled with "
"stable explosives and scrap metal, equipped with a long fuse.  Use this item"
" to light the fuse.  Once you do, it should explode after about 20 seconds."
msgstr ""
"Un artefacto explosivo de fabricación casera, que consiste en una gran jarra"
" de plástico llena de explosivos estables y chatarra, equipada con una mecha"
" larga. Utiliza este objeto para encender la mecha. Una vez que lo hagas "
"debería explotar en unos 20 segundos."

#. ~ "msg" action message of item "homemade bomb"
#: data/json/items/tool/explosives.json
msgid ""
"You light the fuse on the small improvised fragmentation device.  Get rid of"
" it quickly!"
msgstr ""
"Enciende la mecha del pequeño dispositivo de fragmentación improvisado. "
"¡Deshazte de él rápidamente!"

#. ~ Description of "homemade bomb"
#: data/json/items/tool/explosives.json
msgid ""
"A homemade explosive device, consisting of a large plastic jug filled with "
"stable explosives and scrap metal.  Its fuse has been lit, its final "
"countdown starting."
msgstr ""
"Un artefacto explosivo de fabricación casera, consistente en una gran jarra "
"de plástico llena de explosivos militares y chatarra. Su mecha se ha "
"encendido, comenzando su cuenta atrás."

#. ~ "message" action message of item "homemade bomb"
#: data/json/items/tool/explosives.json
msgid "You've already lit the fuse - run!"
msgstr "Ya has encendido la mecha - ¡CORRE!"

#. ~ Item name
#: data/json/items/tool/explosives.json
msgid "homemade demolition charge"
msgid_plural "homemade demolition charges"
msgstr[0] "carga de demolición casera"
msgstr[1] "cargas de demolición caseras"
msgstr[2] "cargas de demolición caseras"

#. ~ Description of "homemade demolition charge"
#: data/json/items/tool/explosives.json
msgid ""
"An improvised demolition charge.  Use this item to light the fuse.  You "
"will, of course, need a lighter or matches in your inventory to do this.  20"
" seconds after lighting the fuse, it will explode, so get away!"
msgstr ""
"Una carga de demolición improvisada. Usar este objeto para encender la "
"mecha. Por supuesto, necesitarás un mechero o cerillas en tu inventario para"
" hacerlo. 20 segundos después de encender la mecha, este objeto explotará, "
"¡así que aléjate!"

#. ~ "msg" action message of item "homemade demolition charge"
#. ~ "msg" action message of item "acetylene lamp (off)"
#: data/json/items/tool/explosives.json data/json/items/tool/lighting.json
#, c-format
msgid "You light the %s."
msgstr "Enciendes la %s."

#. ~ Item name
#: data/json/items/tool/explosives.json
msgid "homemade demolition charge (lit)"
msgid_plural "homemade demolition charges (lit)"
msgstr[0] "carga de demolición casera (encendida)"
msgstr[1] "cargas de demolición caseras (encendidas)"
msgstr[2] "cargas de demolición caseras (encendidas)"

#. ~ Description of "homemade demolition charge (lit)"
#: data/json/items/tool/explosives.json
msgid ""
"The fuse on this primitive demolition charge is lit and hissing.  It'll "
"explode any moment now."
msgstr ""
"La mecha de esta primitiva carga de demolición está encendida y silbando. "
"Explotará en cualquier momento."

#. ~ Item name
#: data/json/items/tool/explosives.json
msgid "50L barrel bomb"
msgid_plural "50L barrel bombs"
msgstr[0] "barril bomba de 50L"
msgstr[1] "barriles bomba de 50L"
msgstr[2] "barriles bomba de 50L"

#. ~ Description of "50L barrel bomb"
#: data/json/items/tool/explosives.json
msgid ""
"A metal keg filled with stable explosives.  Contains a volatile explosive "
"core, so 100 seconds after the fuse has been lit the charge will detonate "
"completely, delivering its entire destructive power to everything in sight."
msgstr ""
"Un barril de metal lleno con mucho material explosivo estable. Contiene un "
"núcleo de explosivo volátil, así que después de encender la mecha tardará "
"100 segundos en detonar la carga y brindar su completo poder destructor a "
"todo lo que esté a su alcance."

#. ~ Item name
#: data/json/items/tool/explosives.json
msgid "active 50L barrel bomb"
msgid_plural "active 50L barrel bombs"
msgstr[0] "barril bomba de 50L activado"
msgstr[1] "barriles bomba de 50L activados"
msgstr[2] "barriles bomba de 50L activados"

#. ~ Description of "active 50L barrel bomb"
#: data/json/items/tool/explosives.json
msgid ""
"A metal keg filled with stable explosives.  The fuse has been lit and once "
"it ignites the primary explosive, the bomb will detonate and rain fire and "
"steel on everything in sight."
msgstr ""
"Un barril de metal lleno con un montón de explosivos estables. La mecha ha "
"sido encendida y una vez que encienda el explosivo primario, la bomba "
"detonará y hará llover fuego y acero sobre todo lo que esté a la vista."

#. ~ Item name
#: data/json/items/tool/explosives.json
msgid "100L barrel bomb"
msgid_plural "100L barrel bombs"
msgstr[0] "barril bomba de 50L"
msgstr[1] "barriles bomba de 100L"
msgstr[2] "barriles bomba de 100L"

#. ~ Item name
#: data/json/items/tool/explosives.json
msgid "active 100L barrel bomb"
msgid_plural "active 100L barrel bombs"
msgstr[0] "barril bomba de 100L activado"
msgstr[1] "barriles bomba de 100L activados"
msgstr[2] "barriles bomba de 100L activados"

#. ~ Item name
#: data/json/items/tool/fire.json
msgid "electric firestarter"
msgid_plural "electric firestarters"
msgstr[0] "magiclick"
msgstr[1] "magiclicks"
msgstr[2] "magiclicks"

#. ~ Description of "electric firestarter"
#: data/json/items/tool/fire.json
msgid ""
"A crudely-made electric firestarter, which can function as an inefficient "
"lighter."
msgstr ""
"Un simple encendedor eléctrico, que puede funcionar ineficazmente como un "
"encendedor normal."

#. ~ Item name
#: data/json/items/tool/fire.json
msgid "bow fire drill"
msgid_plural "bow fire drills"
msgstr[0] "arco de rodamiento"
msgstr[1] "arcos de rodamiento"
msgstr[2] "arcos de rodamiento"

#. ~ Description of "bow fire drill"
#: data/json/items/tool/fire.json
msgid ""
"A simple item for starting fires with friction between a notched plank and "
"wooden shaft.  The shaft is spun rapidly with a sawing motion by a bowstring"
" wrapped around it.  Very slow to acquire a usable ember."
msgstr ""
"Un objeto rudimentario para encender fuego por la fricción entre un tablón "
"agujereado y un palo de madera. El palo se hace girar rápidamente con una "
"cuerda alrededor y un movimiento de serruchado. Se tarda mucho en conseguir "
"una brasa útil."

#. ~ Item name
#: data/json/items/tool/fire.json
msgid "pump fire drill"
msgid_plural "pump fire drills"
msgstr[0] "taladro de bombeo"
msgstr[1] "taladros de bombeo"
msgstr[2] "taladros de bombeo"

#. ~ Description of "pump fire drill"
#: data/json/items/tool/fire.json
msgid ""
"A simple item for starting fires by friction between a notched plank and "
"wooden shaft, with a flywheel attached.  The shaft is spun rapidly with a "
"pumping motion by a cord wrapped around it.  Slow to acquire a usable ember."
msgstr ""
"Un objeto rudimentario para encender fuego con la fricción entre un tablón "
"agujereado y un palo de madera con un volante de inercia. El palo se hace "
"girar rápidamente con una cuerda alrededor y un movimiento de bombeo. Se "
"tarda bastante en conseguir una brasa útil."

#. ~ Item name
#: data/json/items/tool/fire.json
msgid "flint and steel"
msgid_plural "sets of flint and steel"
msgstr[0] "yesquero"
msgstr[1] "yesqueros"
msgstr[2] "yesqueros"

#. ~ Description of "flint and steel"
#: data/json/items/tool/fire.json
msgid ""
"A piece of flint paired with a hardened high carbon steel striker.  Use it "
"to spark a flame."
msgstr ""
"Un pedernal y un golpeador duro de acero alto en carbono. Se utiliza para "
"hacer chispas e iniciar una llama."

#. ~ Item name
#: data/json/items/tool/fire.json
msgid "lighter"
msgid_plural "lighters"
msgstr[0] "encendedor"
msgstr[1] "encendedores"
msgstr[2] "encendedores"

#. ~ Description of "lighter"
#: data/json/items/tool/fire.json
msgid ""
"A disposable plastic lighter, capable of creating a small flame with the "
"flick of a finger.  Allows you to use various drugs like cigarettes, light "
"explosives like Molotov cocktails, or light nearby items on fire."
msgstr ""
"Un encendedor de plástico desechable, capaz de generar un pequeña llama con "
"un gesto de dedos. Puede usarse para consumir diversas drogas como los "
"cigarrillos, encender explosivos ligeros como los cócteles molotov, o para "
"prender fuego a otras cosas cercanas."

#. ~ Item name
#: data/json/items/tool/fire.json
msgid "magnifying glass"
msgid_plural "magnifying glasses"
msgstr[0] "lupa"
msgstr[1] "lupas"
msgstr[2] "lupas"

#. ~ Description of "magnifying glass"
#: data/json/items/tool/fire.json
msgid ""
"A magnifying glass, for closely examining fine details.  It can also be used"
" for starting fires if direct sunlight is available."
msgstr ""
"Una lente de aumentos, para examinar detalles de cerca. También se puede "
"usar para iniciar fuegos si la luz del sol esta disponible."

#. ~ Item name
#: data/json/items/tool/fire.json
msgid "crude glass lens"
msgid_plural "crude glass lenses"
msgstr[0] "lente de vidrio rústico"
msgstr[1] "lentes de vidrio rústico"
msgstr[2] "lentes de vidrio rústico"

#. ~ Description of "crude glass lens"
#: data/json/items/tool/fire.json
msgid ""
"A very low-quality focusing lens, made from non-optical-grade glass.  "
"Useless for building most optical devices, but you can start a fire with it "
"if sunlight is available."
msgstr ""
"Una lente de muy baja calidad fabricada con vidrio no óptico. No sirve para "
"construir dispositivos ópticos pero se puede usar para encender un fuego si "
"hay luz del sol disponible."

#. ~ Item name
#: data/json/items/tool/fire.json
msgid "fire piston"
msgid_plural "fire pistons"
msgstr[0] "pistón incendiario"
msgstr[1] "pistones incendiarios"
msgstr[2] "pistones incendiarios"

#. ~ Description of "fire piston"
#: data/json/items/tool/fire.json
msgid ""
"A firestarting tool of Southeast Asian origin, consisting of a thin, hollow "
"wooden cylinder sealed at one end and open at the other, and a wooden piston"
" forming an airtight circular seal with it, making use of rapid and "
"adiabatic air compression to ignite a piece of tinder.  It also comes with a"
" tinder container to keep tinder dry.  Use it to start a fire."
msgstr ""
"Una herramienta para encender fuego con origen en el sureste de Asia, que "
"consiste en un cilindro hueco de madera fina sellado en una punta, abierto "
"en la otra y un pistón de madera formando un sello circular hermético, "
"usando compresión de aire rápida y adiabática para encender un poco de "
"yesca.  También tiene un recipiente para mantener seca la yesca. Úsalo para "
"prender un fuego."

#. ~ Item name
#: data/json/items/tool/fire.json
msgid "matchbook"
msgid_plural "matchbooks"
msgstr[0] "cajita de cerillas"
msgstr[1] "cajitas de cerillas"
msgstr[2] "cajitas de cerillas"

#. ~ Description of "matchbook"
#: data/json/items/tool/fire.json
msgid ""
"A small book of matches with a coarse strike surface on the outside flap for"
" lighting them.  Allows you to use various drugs like cigarettes, light "
"explosives like Molotov cocktails, or light nearby items on fire.  Due to "
"the matches being lightly glued to the matchbook, they can be removed, but "
"not replaced on the book."
msgstr ""
"Un pequeño librito de cerillas con una zona áspera de raspado en un costado."
"  Los fósforos pueden usarse para consumir diversas drogas como los "
"cigarrillos, encender explosivos ligeros como los cócteles molotov, o "
"prender fuego a otras cosas cercanas. Debido a que las cerillas están "
"pegadas al librito, se pueden quitar pero no reemplazar."

#. ~ Item name
#: data/json/items/tool/fire.json
msgid "survival match"
msgid_plural "survival matches"
msgstr[0] "cerilla de supervivencia"
msgstr[1] "cerillas de supervivencia"
msgstr[2] "cerillas de supervivencia"

#. ~ Description of "survival match"
#: data/json/items/tool/fire.json
msgid "A solid strike anywhere match.  One and done."
msgstr ""
"Una cerilla que se enciende al rozar cualquier superficie. Una y listo."

#. ~ Item name
#: data/json/items/tool/fire.json
msgid "matchbox"
msgid_plural "matchboxes"
msgstr[0] "caja de fósforos"
msgstr[1] "cajas de fósforos"
msgstr[2] "cajas de fósforos"

#. ~ Description of "matchbox"
#: data/json/items/tool/fire.json
msgid ""
"A small box of matches with a coarse strike surface on the side for lighting"
" them.  Allows you to use various drugs like cigarettes, light explosives "
"like Molotov cocktails, or light nearby items on fire."
msgstr ""
"Una caja de fósforos con una zona áspera de raspado en un costado. Los "
"fósforos pueden usarse para consumir diversas drogas como los cigarrillos, "
"encender explosivos ligeros como los cócteles molotov, o prender fuego a "
"otras cosas cercanas."

#. ~ Item name
#: data/json/items/tool/fire.json
msgid "refillable lighter"
msgid_plural "refillable lighters"
msgstr[0] "encendedor recargable"
msgstr[1] "encendedores recargables"
msgstr[2] "encendedores recargables"

#. ~ Description of "refillable lighter"
#: data/json/items/tool/fire.json
msgid ""
"A stylish lighter featuring a flip-top cover and a refuelable tank, capable "
"of creating a small flame with the flick of a finger.  Allows you to use "
"various drugs like cigarettes, light explosives like Molotov cocktails, or "
"light nearby items on fire."
msgstr ""
"Un encendedor con la tapa abatible y el tanque recargable. Puede usarse para"
" consumir diversas drogas como los cigarrillos, encender explosivos ligeros "
"como los cócteles molotov, o para prender fuego a otras cosas cercanas."

#. ~ "msg" action message of item "refillable lighter"
#: data/json/items/tool/fire.json
msgid "You flick the lighter."
msgstr "Enciendes el encendedor de un golpe."

#. ~ "need_charges_msg" action message of item "refillable lighter"
#: data/json/items/tool/fire.json
msgid "Nothing happens."
msgstr "No pasa nada."

#. ~ Description of "refillable lighter"
#: data/json/items/tool/fire.json
msgid ""
"A stylish lighter featuring a flip-top cover and a refuelable tank.  It is "
"lit."
msgstr ""
"Un encendedor estilizado con la tapa abatible y el tanque recargable. Está "
"encendido."

#. ~ "msg" action message of item "refillable lighter"
#: data/json/items/tool/fire.json
msgid "You extinguish the lighter."
msgstr "Apagas el encendedor."

#. ~ Item name
#: data/json/items/tool/fire.json
msgid "refillable butane lighter"
msgid_plural "refillable butane lighters"
msgstr[0] "encendedor de butano recargable"
msgstr[1] "encendedores de butano recargables"
msgstr[2] "encendedores de butano recargables"

#. ~ Description of "refillable butane lighter"
#: data/json/items/tool/fire.json
msgid ""
"A large lighter with a trigger and a safety, reloaded by fitting a can of "
"butane inside the base.  Allows you to use various drugs like cigarettes, "
"light explosives like Molotov cocktails, or light nearby items on fire."
msgstr ""
"Un encendedor grande con gatillo y seguro, que se recarga insertando una "
"lata de butano dentro de la base. Puede usarse para consumir diversas drogas"
" como cigarrillos, encender explosivos como cócteles molotov, o prender "
"fuego a objetos cercanos."

#. ~ Item name
#: data/json/items/tool/fire.json
msgid "ember carrier"
msgid_plural "ember carriers"
msgstr[0] "braserito"
msgstr[1] "braseritos"
msgstr[2] "braseritos"

#. ~ Description of "ember carrier"
#: data/json/items/tool/fire.json
msgid ""
"A small container for holding tinder, with holes punched in it to provide a "
"controlled airflow.  It can nurture a smoldering ember for a long time, to "
"start fires without modern tools."
msgstr ""
"Un pequeño recipiente para poner yesca, con agujeros que permiten controlar "
"la entrada de aire. Puede alimentar brasas encendidas durante un periodo "
"largo, para encender fuegos sin herramientas más modernas."

#. ~ "msg" action message of item "ember carrier"
#: data/json/items/tool/fire.json
msgid "You light the tinder."
msgstr "Enciendes la yesca."

#. ~ "need_charges_msg" action message of item "ember carrier"
#: data/json/items/tool/fire.json
msgid "The ember carrier is out of tinder."
msgstr "El portador de la brasa se ha quedado sin yesca."

#. ~ "need_fire_msg" action message of item "ember carrier"
#: data/json/items/tool/fire.json
msgid "You need a lighter or fire to light this."
msgstr "Necesitas un encendedor o fuego para encenderla."

#. ~ Item name
#: data/json/items/tool/fire.json
msgid "ember carrier (lit)"
msgid_plural "ember carriers (lit)"
msgstr[0] "braserito (encendido)"
msgstr[1] "braseritos (encendidos)"
msgstr[2] "braseritos (encendidos)"

#. ~ Description of "ember carrier (lit)"
#: data/json/items/tool/fire.json
msgid ""
"A small container for holding tinder, with holes punched in it to provide a "
"controlled airflow.  An ember is smoldering inside it, and can be used to "
"start a campfire."
msgstr ""
"Un pequeño recipiente para poner yesca, con agujeros que permiten controlar "
"la entrada de aire. Adentro tiene una brasa encendida, y puede usarse para "
"encender una fogata."

#. ~ "msg" action message of item "ember carrier (lit)"
#: data/json/items/tool/fire.json
msgid "The ember is extinguished."
msgstr "Las brasas se extinguieron."

#. ~ Item name
#: data/json/items/tool/fire.json
msgid "mini lighter"
msgid_plural "mini lighters"
msgstr[0] "mini encendedor"
msgstr[1] "mini encendedores"
msgstr[2] "mini encendedores"

#. ~ Description of "mini lighter"
#: data/json/items/tool/fire.json
msgid ""
"A miniature disposable plastic lighter, capable of creating a small flame "
"with the flick of a finger.  Allows you to use various drugs, like "
"cigarettes, light explosives like Molotov cocktails, or light nearby items "
"on fire."
msgstr ""
"Un encendedor de plástico desechable en miniatura, capaz de generar una "
"pequeña llama con un gesto de dedos. Puede usarse para consumir diversas "
"drogas como los cigarrillos, encender explosivos ligeros como los cócteles "
"molotov, o para prender fuego a otras cosas cercanas."

#. ~ Same stats as a hatchet (as a tool and weapon), except it has prying
#. instead of hammering.
#. ~ Item name
#: data/json/items/tool/firefighting.json
msgid "crash axe"
msgid_plural "crash axes"
msgstr[0] "hacha de accidente"
msgstr[1] "hachas de accidentes"
msgstr[2] "hachas de accidentes"

#. ~ Same stats as a hatchet (as a tool and weapon), except it has prying
#. instead of hammering.
#. ~ Description of "crash axe"
#: data/json/items/tool/firefighting.json
msgid ""
"A short, lightweight emergency tool with a quarter-circular blade, a short "
"pick opposite the blade, and an insulated handle.  Used on airplanes to chop"
" down or pry walls or cabinets to gain access in case of a fire."
msgstr ""
"Una herramienta corta y liviana de emergencia, con una cuchilla circular, un"
" pequeño pico en la parte opuesta a la cuchilla y un mango aislado. Se "
"utiliza en los aviones para romper paredes o casilleros para abrirse paso en"
" caso de incendio."

#. ~ Item name
#: data/json/items/tool/firefighting.json
msgid "large fire extinguisher"
msgid_plural "large fire extinguishers"
msgstr[0] "extintor grande"
msgstr[1] "extintores grandes"
msgstr[2] "extintores grandes"

#. ~ Description of "large fire extinguisher"
#: data/json/items/tool/firefighting.json
msgid ""
"An emergency fire extinguisher containing five gallons of fire-retardant "
"foam.  Useful for putting out adjacent fires."
msgstr ""
"Un extintor de emergencia que contiene 18,9 litros de espuma retardante "
"contra el fuego. Sería útil para apagar incendios adyacentes."

#. ~ Item name
#: data/json/items/tool/firefighting.json
msgid "fire axe"
msgid_plural "fire axes"
msgstr[0] "hacha de bombero"
msgstr[1] "hachas de bombero"
msgstr[2] "hachas de bombero"

#. ~ Description of "fire axe"
#: data/json/items/tool/firefighting.json
msgid ""
"A large, two-handed pickhead axe normally used by firefighters.  It makes a "
"powerful melee weapon, but is a bit slow to recover between swings."
msgstr ""
"Una gran hacha de dos manos y con una cara de la cabeza terminada en punta, "
"normalmente utilizada por los bomberos. Es un arma poderosa para el c. a c. "
"pero es un poco lenta entre hachazo y hachazo."

#. ~ Description of a pocket in item "fire axe"
#: data/json/items/tool/firefighting.json
msgid "Marrying strap for a Halligan bar."
msgstr "Correa para una barra Halligan."

#. ~ Item name
#: data/json/items/tool/firefighting.json
msgid "Halligan bar"
msgid_plural "Halligan bars"
msgstr[0] "barra Halligan"
msgstr[1] "barras Halligan"
msgstr[2] "barras Halligan"

#. ~ Description of "Halligan bar"
#: data/json/items/tool/firefighting.json
msgid ""
"A heavy, multiple-use tool commonly carried by firefighters, law "
"enforcement, and military rescue units.  Use it to open locked doors without"
" destroying them or to lift manhole covers.  You could also wield it to bash"
" some heads in."
msgstr ""
"Una herramienta pesada multiusos, comúnmente utilizada por los bomberos, "
"fuerzas de la ley y unidades militares de rescate. Úsala para abrir puertas "
"cerradas con llave sin destruirlas o para levantar tapas de alcantarilla. "
"También la puedes empuñar para romper algunas cabezas."

#. ~ Item name
#: data/json/items/tool/firefighting.json
msgid "small fire extinguisher"
msgid_plural "small fire extinguishers"
msgstr[0] "extintor pequeño"
msgstr[1] "extintores pequeños"
msgstr[2] "extintores pequeños"

#. ~ Description of "small fire extinguisher"
#: data/json/items/tool/firefighting.json
msgid ""
"A handheld fire extinguisher containing a liter of highly compressed CO2 "
"gas.  Useful for putting out adjacent fires."
msgstr ""
"Un extintor portátil que contiene un litro de gas CO2 comprimido. Es útil "
"para apagar fuegos cercanos."

#. ~ Item name
#: data/json/items/tool/firefighting.json
msgid "throwable fire extinguisher"
msgid_plural "throwable fire extinguishers"
msgstr[0] "extintor arrojable"
msgstr[1] "extintores arrojables"
msgstr[2] "extintores arrojables"

#. ~ Description of "throwable fire extinguisher"
#: data/json/items/tool/firefighting.json
msgid ""
"A fire extinguisher in grenade form.  While not as effective as a regular "
"fire extinguisher, you can use it from a farther distance.  It has a plastic"
" plug that can be pulled, but is primarily activated by heat, so just throw "
"it into the flames."
msgstr ""
"Un extintor en forma de granada. Aunque no es tan eficaz como un extintor "
"normal, se puede utilizar a distancia. Tiene un tapón de plástico del que se"
" puede tirar, pero se activa principalmente con el calor, así que basta con "
"lanzarlo a las llamas."

#. ~ "menu_text" action message of item "throwable fire extinguisher"
#: data/json/items/tool/firefighting.json
msgid "Pull plug"
msgstr "Tirar del gancho de seguridad"

#. ~ "msg" action message of item "throwable fire extinguisher"
#: data/json/items/tool/firefighting.json
msgid "You pull the plug on the extinguisher grenade."
msgstr "Se tira del pin de la granada extintor."

#. ~ Item name
#: data/json/items/tool/firefighting.json
msgid "active throwable fire extinguisher"
msgid_plural "active throwable fire extinguishers"
msgstr[0] "extintore arrojable activo"
msgstr[1] "extintores arrojables activos"
msgstr[2] "extintores arrojables activos"

#. ~ Description of "active throwable fire extinguisher"
#: data/json/items/tool/firefighting.json
msgid ""
"An active extinguisher grenade, likely to burst any second now.  Better "
"throw it!"
msgstr ""
"Una granada de extinción activa, es probable que estalle en cualquier "
"momento. ¡Mejor lánzala!"

