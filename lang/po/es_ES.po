msgstr "Aumenta frecuencias en pasos impares - ¡discontinuidad local!"

#. ~ Snippet in category "lab_postit_portal"
#: data/json/snippets/lab.json
msgid "Limit time spent in-phase to 29.1 minutes"
msgstr "Limitar el tiempo de permanencia en fase a 29,1 minutos"

#. ~ Snippet in category "lab_postit_portal"
#: data/json/snippets/lab.json
msgid "Sub-plane 117RA likes prime-numbered calibration pings"
msgstr "Al subplano 117RA le gustan los pings de calibración con número primo"

#. ~ Snippet in category "lab_postit_portal"
#: data/json/snippets/lab.json
msgid "First the candle, then the blood, NOT THE OTHER WAY AROUND"
msgstr "Primero la vela, luego la sangre, NO AL REVÉS"

#. ~ Snippet in category "lab_postit_portal"
#: data/json/snippets/lab.json
msgid "Remember Jake?  Me neither."
msgstr "¿Te acuerdas de Jake? Yo tampoco."

#. ~ Snippet in category "lab_postit_portal"
#: data/json/snippets/lab.json
msgid "Keep line of sight minimal"
msgstr "Mantener una línea de visión mínima"

#. ~ Snippet in category "lab_postit_portal"
#: data/json/snippets/lab.json
msgid "Calibrate on 013TQ for manned transfers"
msgstr "Calibrar en 013TQ para las transferencias tripuladas"

#. ~ Snippet in category "lab_postit_portal"
#: data/json/snippets/lab.json
msgid "No touching returning probes, even if they beg you to"
msgstr "No tocar las sondas de retorno, aunque te lo rueguen"

#. ~ Snippet in category "lab_postit_portal"
#: data/json/snippets/lab.json
msgid "Remember to forget.  Forget to remember."
msgstr "Recordar para olvidar. Olvidar para recordar."

#. ~ Snippet in category "lab_postit_portal"
#: data/json/snippets/lab.json
