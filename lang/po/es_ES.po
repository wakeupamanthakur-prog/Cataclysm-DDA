msgid_plural "mosasaurus eggs"
msgstr[0] "huevo de mosasaurus"
msgstr[1] "huevos de mosasaurus"
msgstr[2] "huevos de mosasaurus"

#. ~ Overmap terrain name
#: data/mods/DinoMod/obsolete/fieldoffice.json
