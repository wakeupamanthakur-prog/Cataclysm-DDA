msgstr[1] "alambre de púas paralizante"
msgstr[2] "alambre de púas paralizante"

#. ~ Description of "paralyzing barb"
#: data/json/items/ammo/barb.json
msgid ""
"Tiny droplets of venom trickle out of the sponge-like tissue of this sharp "
"barb."
msgstr ""
"Pequeñas gotas de veneno gotean del tejido esponjoso que contiene esta "
"alambrada afilada."

#. ~ Item name
#: data/json/items/ammo/blank.json
