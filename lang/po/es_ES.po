msgstr "Tu %s está empezando a sentir el daño que causó el frío."

#. ~ Name of effect type id "blisters"
#: data/json/effects.json
msgid "Blisters"
msgstr "Llagas"

#. ~ Description of effect type "Blisters"
#: data/json/effects.json
#, c-format
msgid "Your %s is blistering from the intense heat."
msgstr "Llagas en tu %s aparecen por el intenso calor."

#. ~ Miss message of effect type "Blisters"
#: data/json/effects.json
msgid "Your blisters distract you"
msgstr "Tus llagas te distraen."

#. ~ Name of effect type id "formication"
