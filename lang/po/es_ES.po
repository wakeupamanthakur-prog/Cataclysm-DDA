msgstr "¿Seguro? ¿Borrar la nota?"

#: src/overmap_ui.cpp:416 src/overmap_ui.cpp:1905
msgid "Remove dangerous mark?"
msgstr "¿Quitar marca peligrosa?"

#: src/overmap_ui.cpp:421 src/overmap_ui.cpp:1909
msgid "Edit dangerous mark?"
msgstr "¿Editar marca peligrosa?"

#: src/overmap_ui.cpp:424 src/overmap_ui.cpp:1911
