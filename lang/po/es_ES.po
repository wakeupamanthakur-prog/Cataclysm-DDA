#. ~ Message when transforming from mutation  "Weak Photophore (on)" to
#. "BIOLUM1"
#. ~ Message when transforming from mutation  "Photophore (on)" to "BIOLUM2"
#: data/json/mutations/mutations.json
msgid "Your photophore stops glowing."
msgstr "Tu fotóforo deja de brillar."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Photophore"
msgstr "Fotóforo"

#. ~ Description of mutation "Photophore"
#: data/json/mutations/mutations.json
msgid "You can make your photophore glow brightly."
msgstr "Puedes hacer que tu fotóforo brille con fuerza."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Photophore (on)"
msgstr "Fotóforo (on)"

#. ~ Description of mutation "Photophore (on)"
#: data/json/mutations/mutations.json
msgid "You photophore is glowing brightly."
msgstr "Tu fotóforo esta brillando con fuerza."

#. ~ Description of mutation "Bioluminescent Flare"
#: data/json/mutations/mutations.json
msgid ""
"You can spit a wad of bioluminescent goo several meters away.  There it will"
" light up its surroundings until it dissipates."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Normal Human"
msgstr "Humano Normal"

#. ~ Description of mutation "Normal Human"
#: data/json/mutations/mutations.json
msgid ""
"You're a normal human; there's nothing wrong with you.  No need to worry."
msgstr "Eres un humano normal; no te pasa nada. No hay de que preocuparse."

#. ~ Trigger message of mutation "Normal Human"
#: data/json/mutations/mutations.json
msgid "Everything is terrible and this makes you so ANGRY!"
msgstr "¡Todo es terrible y esto te llena de IRA!"

#. ~ Message when transforming from mutation  "Normal Human" to "HYDE"
#: data/json/mutations/mutations.json
msgid "The anger overtakes you!"
msgstr "¡La ira te invade!"

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Violent Monster"
msgstr "Monstruo Violento"

#. ~ Description of mutation "Violent Monster"
#: data/json/mutations/mutations.json
msgid "Anger clouds your mind; you can't think straight, but you feel strong."
msgstr ""
"La ira te nubla la mente, no puedes pensar bien pero te sientes fuerte."

#. ~ Trigger message of mutation "Violent Monster"
#: data/json/mutations/mutations.json
msgid "As the morning comes, you return back to normal."
msgstr "Al llegar la mañana, vuelves a la normalidad."

#. ~ Message when transforming from mutation  "Violent Monster" to "JEKYLL"
#: data/json/mutations/mutations.json
msgid "The anger subsides."
msgstr "La ira decrece."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Seasonal Affective Disorder"
msgstr ""

#. ~ Description of mutation "Seasonal Affective Disorder"
#: data/json/mutations/mutations.json
msgid ""
"You tend to have bouts of depression during the fall and especially winter."
"  Taking antidepressants can help."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Good Hearing"
msgstr "Buen Oído"

#. ~ Description of mutation "Good Hearing"
#: data/json/mutations/mutations.json
msgid ""
"Your hearing is better than average, and you can hear distant sounds more "
"easily."
msgstr ""
"Tu audición es mejor que la media y puedes oír los sonidos lejanos con mayor"
" facilidad."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Fey Hearing"
msgstr "Oido Espiritual"

#. ~ Description of mutation "Fey Hearing"
#: data/json/mutations/mutations.json
msgid ""
"You're not sure the shape of your ears is helping you any; regardless, you "
"have become very sensitive to sounds."
msgstr ""
"No estás seguro de que la forma de tus orejas te ayude, pero a pesar de eso "
"te has vuelto muy sensible a los sonidos."

#. ~ Description of mutation "Inattentive"
#: data/json/mutations/mutations.json
msgid ""
"You never paid attention to your surroundings and specifically to people "
"around you.  You can't judge the intent of critters you see."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Outdoorsman"
msgstr "Amante de la Naturaleza"

#. ~ Description of mutation "Outdoorsman"
#: data/json/mutations/mutations.json
msgid ""
"You are accustomed to being exposed to the elements.  This decreases morale "
"penalties for being wet."
msgstr ""
"Estás acostumbrado a estar a la intemperie. Esto hace que sea menor la "
"penalización a la moral por estar mojado."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Indefatigable"
msgstr "Incansable"

#. ~ Description of mutation "Indefatigable"
#: data/json/mutations/mutations.json
msgid ""
"Whether due to exercise and good diet, or due to a natural propensity to "
"physical endurance, you tire due to physical exertion much less readily than"
" others.  Your cardio fitness and maximum stamina are higher than usual."
msgstr ""
"Ya sea debido al ejercicio y la buena dieta, o debido a ser naturalmente "
"propenso a la resistencia física, el esfuerzo físico te cansa mucho menos "
"que a los demás. Tu capacidad cardiovascular y tu vigor máximo son más altas"
" de lo habitual."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Hyperactive"
msgstr "Hiperactivo"

#. ~ Description of mutation "Hyperactive"
#: data/json/mutations/mutations.json
msgid ""
"Your body's efficiency is like that of a tiny furnace, greatly increasing "
"your cardio and stamina."
msgstr ""
"La eficacia de tu cuerpo es como la de un pequeño horno, incrementando mucho"
" tu vigor y capacidad cardiaca."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Quick"
msgstr "Veloz"

#. ~ Description of mutation "Quick"
#: data/json/mutations/mutations.json
#, no-c-format
msgid "You're just generally quick!  You get a 10% bonus to action points."
msgstr ""
"¡Eres más rápido para todo! Tienes una bonificación del 10% a tus puntos de "
"acción."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Tunnel Fighter"
msgstr "Luchador de Tunel"

#. ~ Description of mutation "Tunnel Fighter"
#: data/json/mutations/mutations.json
msgid ""
"You know how to fight in cramped tunnels at risk of collapse.  You gain "
"bonuses when fighting underground."
msgstr ""
"Sabes luchar en túneles estrechos con riesgo de derrumbe. Obtienes "
"bonificaciones cuando luchas bajo tierra."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Night Raider"
msgstr "Asaltante Nocturno"

#. ~ Description of mutation "Night Raider"
#: data/json/mutations/mutations.json
msgid ""
"Your body is one with the night.  You make less noise when the moon is up in"
" the sky, even when you cannot see it."
msgstr ""
"Tu cuerpo es uno con la noche. Haces menos ruido cuando la luna está en el "
"cielo, aunque no la veas."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Portal Dependent"
msgstr "Dependiente de Portal"

#. ~ Description of mutation "Portal Dependent"
#: data/json/mutations/mutations.json
msgid ""
"You feel alien in your own body, as if part of you remained behind with the "
"storm.  You will suffer severely when not exposed to portal storms unless "
"you find a way to anchor yourself to the world again."
msgstr ""
"Te sientes extranjero en tu propio cuerpo como si parte tuya se hubiera "
"quedado en la tormenta. Sufrirás severamente cuando no estés expuesto a "
"tormentas de portales salvo que encuentres una forma de anclarte otra vez al"
" mundo."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Stabilized in Reality"
msgstr "Estabilizado en la Realidad"

#. ~ Description of mutation "Stabilized in Reality"
#: data/json/mutations/mutations.json
msgid ""
"You have regained some substance and have stabilized somewhat, if not "
"entirely.  Portal storm withdrawal will not affect you as strongly as "
"before."
msgstr ""
"Has recobrado algo de sustancia y te estabilizaste un poco. El síndrome de "
"abstinencia de tormentas de portales ya no te afectará tanto como antes."

#. ~ Description of mutation "Optimist"
#: data/json/mutations/mutations.json
msgid ""
"Nothing gets you down!  You savor the joys of life, ignore its hardships, "
"and are generally happier than most people."
msgstr ""
"¡Nada te deprime! Saboreás los placeres de la vida, ignorás las "
"dificultades, y en general eres más feliz que la mayoría de la gente."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Fast Healer"
msgstr "Sanación Veloz"

#. ~ Description of mutation "Fast Healer"
#: data/json/mutations/mutations.json
msgid "Your wounds and broken limbs heal quicker than usual."
msgstr "Tus heridas y extremidades rotas sanan mas rápido de lo normal."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Light Eater"
msgstr "Apetito ligero"

#. ~ Description of mutation "Light Eater"
#: data/json/mutations/mutations.json
msgid ""
"Your metabolism is a little slower, and you require less food than most."
msgstr ""
"Tu metabolismo es un poco más lento, y necesitas menos comida que la mayoría"
" de la gente."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Accomplished Sleeper"
msgstr "Durmiente Experto"

#. ~ Description of mutation "Accomplished Sleeper"
#: data/json/mutations/mutations.json
msgid ""
"You have always been able to fall asleep easily, even when sleeping in less "
"than ideal circumstances."
msgstr ""
"Siempre tuviste la capacidad de dormirte fácilmente, incluso cuando tienes "
"que dormir en circunstancias poco ideales."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Practiced Sleeper"
msgstr "Durmiente Con Experiencia"

#. ~ Description of mutation "Practiced Sleeper"
#: data/json/mutations/mutations.json
msgid ""
"Your body's demanding energy needs mean you can fall asleep just about "
"anywhere."
msgstr ""
"Las exigentes necesidades de energía de tu cuerpo significan que puedes "
"conciliar el sueño en cualquier lugar."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Earth Sleeper"
msgstr "Dormilón de la Tierra"

#. ~ Description of mutation "Earth Sleeper"
#: data/json/mutations/mutations.json
msgid "You always sleep better surrounded by earth."
msgstr "Siempre se duerme mejor rodeado de tierra."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Aquatic Sleeper"
msgstr "Dormilón Acuático"

#. ~ Description of mutation "Aquatic Sleeper"
#: data/json/mutations/mutations.json
msgid "You always sleep better underwater."
msgstr "Siempre se duerme mejor bajo el agua."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Pain Resistant"
msgstr "Resistente al Dolor"

#. ~ Description of mutation "Pain Resistant"
#: data/json/mutations/mutations.json
msgid "You have a high tolerance for pain."
msgstr "Tienes una gran tolerancia al dolor."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Night Vision"
msgstr "Visión Nocturna"

#. ~ Description of mutation "Night Vision"
#: data/json/mutations/mutations.json
msgid ""
"You possess natural night vision, and can see further in the dark than most."
"  Activate to toggle NV-visible areas on or off."
msgstr ""
"Tienes visión nocturna natural y puedes ver un poco más de lo normal en la "
"oscuridad. Activalo para alternar las áreas visibles por Visión Nocturna."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Poison Resistant"
msgstr "Resistente al Veneno"

#. ~ Description of mutation "Poison Resistant"
#: data/json/mutations/mutations.json
msgid ""
"Your system is rather tolerant of poisons and toxins, and most will affect "
"you less."
msgstr ""
"Tu sistema es bastante tolerante a los venenos y toxinas, y la mayoría de "
"ellos te afectarán menos que a los demás."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Fast Reader"
msgstr "Lector Veloz"

#. ~ Description of mutation "Fast Reader"
#: data/json/mutations/mutations.json
msgid ""
"You're a quick reader, and can get through books a lot faster than most."
msgstr ""
"Eres un lector rápido, puedes leer un libro mucho más rápido que la mayoría."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Tough Feet"
msgstr "Pies Duros"

#. ~ Description of mutation "Tough Feet"
#: data/json/mutations/mutations.json
msgid ""
"The bottoms of your feet are tough, and you are accustomed to going "
"barefoot.  You receive no movement penalty for not wearing shoes."
msgstr ""
"Las plantas de tus pies son duras y estan acostumbradas a ir descalzadas. No"
" recibes ninguna penalización de movimiento por no llevar zapatos."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Bovine Bulk"
msgstr "Bulto bovino"

#. ~ Description of mutation "Bovine Bulk"
#: data/json/mutations/mutations.json
msgid ""
"Your flesh has become dense with fat and muscle.  This makes you harder to "
"take down, but also a poor swimmer."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Bull Roids"
msgstr "Drogas de Toro"

#. ~ Description of mutation "Bull Roids"
#: data/json/mutations/mutations.json
msgid ""
"Your bulk has rendered you a veritable living wall.  Be careful around water"
" though; while you're as sturdy as a rock, you'll sink like one too."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Tough"
msgstr "Resistente"

#. ~ Description of mutation "Tough"
#: data/json/mutations/mutations.json
#, no-c-format
msgid ""
"It takes a lot to bring you down!  You get a 20% bonus to all hit points."
msgstr ""
"¡Derrotarte cuesta mucho! Tienes una bonificación del 20% a los puntos de "
"golpe."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Durable"
msgstr "Duradero"

#. ~ Description of mutation "Durable"
#: data/json/mutations/mutations.json
#, no-c-format
msgid ""
"You can shrug off almost anything!  You get a 30% bonus to all hit points."
msgstr ""
"¡Los golpes no te molestan demasiado! Tienes una bonificación del 30% a los "
"puntos de golpe."

#. ~ Mutation name
#. ~ Spell name
#: data/json/mutations/mutations.json
#: data/mods/Xedra_Evolved/effects/effects.json
#: data/mods/Xedra_Evolved/spells/eater_spells.json
msgid "Unbreakable"
msgstr "Irrompible"

#. ~ Description of mutation "Unbreakable"
#: data/json/mutations/mutations.json
#, no-c-format
msgid "Nothing can break you!  You get a 40% bonus to all hit points."
msgstr "golpe"

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Thick-Skinned"
msgstr "Piel Gruesa"

#. ~ Description of mutation "Thick-Skinned"
#: data/json/mutations/mutations.json
msgid ""
"Your skin is tough.  Cutting and bashing damage is slightly reduced for you."
"  There's a small chance you don't cut yourself on sharp terrain."
msgstr ""
"Tu piel es dura. El daño cortante y contundente se reduce ligeramente. Hay "
"una pequeña posibilidad de que no te cortes en terrenos afilados."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Packmule"
msgstr "Mula de Carga"

#. ~ Description of mutation "Packmule"
#: data/json/mutations/mutations.json
#, no-c-format
msgid ""
"You pack things very efficiently!  You can retrieve things from containers "
"10% faster."
msgstr ""
"Empaquetas las cosas de forma muy eficiente. Puedes recuperar cosas de los "
"contenedores un 10% más rápido."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Strong Back"
msgstr "Espalda Fuerte"

#. ~ Description of mutation "Strong Back"
#: data/json/mutations/mutations.json
#, no-c-format
msgid ""
"You are capable of carrying far more than someone with similar strength "
"could.  Your maximum weight carried is increased by 35%."
msgstr ""
"Eres capaz de cargar mucho más que una persona con fuerza similar. Tu máxima"
" carga posible está incrementada en un 35%."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Fast Learner"
msgstr "Aprendizaje Veloz"

#. ~ Description of mutation "Fast Learner"
#: data/json/mutations/mutations.json
msgid ""
"You have a flexible mind, allowing you to learn skills much faster than "
"others.  Note that this only applies to real-world experience, not to skill "
"gain from other sources like books."
msgstr ""
"Tienes una mente flexible que te permite aprender habilidades mucho más "
"rápido que los demás. Esto solo se aplica para la experiencia práctica, no "
"para las habilidades aprendidas de libros y similares."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Rigid Table Manners"
msgstr "Modales de Mesa Rígida"

#. ~ Description of mutation "Rigid Table Manners"
#: data/json/mutations/mutations.json
msgid ""
"You've been taught proper table manners from your early childhood on; now, "
"you can't even think about eating without being seated at a table and taking"
" your time.  Eating without a table and chair frustrates you, but eating "
"like a civilized person gives you a bigger morale bonus."
msgstr ""
"Te han enseñado buenos modales en la mesa desde tu infancia; ahora, no "
"puedes ni pensar en comer sin estar sentado en una mesa y tormarte tu tiempo"
" en ello. Comer sin mesa ni silla te frustra, pero comer como una persona "
"civilizada te otorga una gran bonificación de moral."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Strong Stomach"
msgstr "Estómago Fuerte"

#. ~ Description of mutation "Strong Stomach"
#: data/json/mutations/mutations.json
msgid ""
"You are less likely to throw up from food poisoning, alcohol, etc.  If you "
"throw up despite this, you won't suffer any residual nausea."
msgstr ""
"Tienes menos probabilidad de vomitar por intoxicación alimentaria, alcohol, "
"etc. Si a pesar de ello vomitas, no sufrirás náuseas residuales."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Stomach Cleanse"
msgstr "Limpieza de Estómago"

#. ~ Description of mutation "Stomach Cleanse"
#: data/json/mutations/mutations.json
msgid ""
"You have gained the ability to invert your stomach outside your body to "
"quickly eliminate toxins, and are more likely to throw up from food "
"poisoning, alcohol, etc.  If you throw up because of this, you won't suffer "
"any residual nausea."
msgstr ""
"Has ganado la capacidad de invertir el estómago fuera de tu cuerpo para "
"eliminar rápidamente las toxinas, y es más probable que vomites por "
"intoxicación alimentaria, alcohol, etc.  Si vomitas por este motivo, no "
"sufrirás náuseas residuales."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Good Memory"
msgstr "Buena Memoria"

#. ~ Description of mutation "Good Memory"
#: data/json/mutations/mutations.json
msgid ""
"You have an exceptional memory, and find it easy to remember things.  Your "
"skills will erode slightly slower than usual."
msgstr ""
"Tienes una memoria excepcional y te resulta fácil recordar cosas. Tus "
"habilidades se atrofiarán más despacio que lo normal."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Deft"
msgstr "Hábil"

#. ~ Description of mutation "Deft"
#: data/json/mutations/mutations.json
msgid ""
"While you're not any better at melee combat, you are better at recovering "
"from a miss, and will be able to attempt another strike faster."
msgstr ""
"Aunque no eres mejor en el combate c. a c., eres mejor para recuperarte de "
"un golpe errado, y podrás intentar otro golpe más rápido."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Spiritual"
msgstr "Espiritual"

#. ~ Description of mutation "Spiritual"
#: data/json/mutations/mutations.json
msgid ""
"You've always felt that there is more to the world than we can see.  Whether"
" driven by religious beliefs or philosophical interest, you find great "
"inspiration in studying holy texts and experiencing mystical things."
msgstr ""
"Siempre sentiste que hay algo más en el mundo que lo que podemos ver. Ya sea"
" por creencias religiosas o intereses filosóficos, encuentras gran "
"inspiración en estudiar los textos sagrados y experimentar cosas místicas."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Substance Tolerance"
msgstr "Tolerante a Sustancias"

#. ~ Description of mutation "Substance Tolerance"
#: data/json/mutations/mutations.json
msgid ""
"You can handle intoxicants well.  Their effects clear up more quickly for "
"you."
msgstr ""
"Puedes manejar bien las intoxicaciones. Sus efectos se van a ir más rápido."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Gourmand"
msgstr "Glotonería"

#. ~ Description of mutation "Gourmand"
#: data/json/mutations/mutations.json
msgid ""
"You eat faster, and can eat and drink more, than anyone else!  You also "
"enjoy food more; delicious food is better for your morale, and you don't "
"mind unsavory meals as much.  Activate to skip prompt for overeating."
msgstr ""
"¡Comes más rápido, y puedes comer y beber más que nadie! También disfrutas "
"más de la comida; la comida deliciosa es mejor para tu moral, y no te "
"importa tanto la comida desagradable. Actívalo para omitir la indicación de "
"comer en exceso."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Bookworm"
msgstr "Rata de biblioteca"

#. ~ Description of mutation "Bookworm"
#: data/json/mutations/mutations.json
msgid ""
"There's nothing quite like the smell of a good book!  Books are more fun (or"
" less boring) for you!"
msgstr ""
"¡No hay nada comparable con el olor de un buen libro! ¡Los libros te "
"resultan más divertidos (o menos aburridos)!"

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Addiction Resistant"
msgstr "Resistente a las Adicciones"

#. ~ Description of mutation "Addiction Resistant"
#: data/json/mutations/mutations.json
msgid ""
"Whether due to a lifetime of exposure or through simple willpower, it's "
"harder for you to become addicted to substances, and easier to rid yourself "
"of these addictions."
msgstr ""
"Ya sea por una vida de revelación o por simple fuerza de voluntad, es más "
"difícil hacerte adicto a una sustancia, y te resulta más fácil salir de las "
"adicciones."

#. ~ Mutation name
#. ~ Name of effect type id "effect_animal"
#: data/json/mutations/mutations.json
#: data/mods/BombasticPerks/perkdata/empath.json
msgid "Animal Empathy"
msgstr "Empatía Animal"

#. ~ Description of mutation "Animal Empathy"
#: data/json/mutations/mutations.json
msgid ""
"Peaceful animals will not run away from you, and even aggressive animals are"
" less likely to attack.  This only applies to natural animals such as "
"woodland creatures."
msgstr ""
"Los animales pacíficos no se escaparán cuando te vean, e incluso los "
"animales agresivos te atacarán menos. Esto solo se aplica a los animales "
"naturales como las criaturas del bosque."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Animal Kinship"
msgstr "Parentesco animal"

#. ~ Description of mutation "Animal Kinship"
#: data/json/mutations/mutations.json
msgid ""
"Something about your presence is calming to animals, and they will treat you"
" with innate trust.  This only applies to natural animals such as woodland "
"creatures."
msgstr ""
"Algo sobre tu presencia calma a los animales, y te tratarán con una "
"confianza innata. Esto solo se aplica a animales naturales como las "
"criaturas del bosque."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Terrifying"
msgstr "Terror"

#. ~ Description of mutation "Terrifying"
#: data/json/mutations/mutations.json
msgid ""
"There's something about you that creatures find frightening, and they are "
"more likely to try to flee."
msgstr ""
"Hay algo en ti que causa terror. Las criaturas tienden a huir cuando te ven."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Disease Resistant"
msgstr "Resistente a las Enfermedades"

#. ~ Description of mutation "Disease Resistant"
#: data/json/mutations/mutations.json
msgid ""
"It's very unlikely that you will catch ambient diseases like the cold or "
"flu."
msgstr ""
"Es muy poco probable que te contagies de enfermedades ambientales como el "
"resfriado o la gripe."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "High Adrenaline"
msgstr "Alta Adrenalina"

#. ~ Description of mutation "High Adrenaline"
#: data/json/mutations/mutations.json
msgid ""
"If you are in a very dangerous situation, you may experience a temporary "
"rush which increases your speed and strength significantly."
msgstr ""
"Si te encuentras en una situación muy peligrosa, puedes experimentar un "
"empujón temporal que incrementa significativamente tu velocidad y tu fuerza."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Combat Adaptation"
msgstr "Adaptación de Combate"

#. ~ Description of mutation "Combat Adaptation"
#: data/json/mutations/mutations.json
msgid ""
"When you are in great danger you may flip a chemical switch in your brain "
"and for a cost in hunger, fatigue, and thirst your nervous system will "
"process things around you slightly faster.  Giving you better reaction times"
" that you can pay for later if you survive."
msgstr ""
"Cuando estás en gran peligro puedes activar un interruptor químico en tu "
"cerebro a cambio de un coste en hambre, fatiga y sed, esto causa que tu "
"sistema nervioso procese las cosas a tu alrededor ligeramente más rápido. Lo"
" que te da mejores tiempos de reacción que podrás pagar más tarde si "
"sobrevives."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Less Sleep"
msgstr "Sueño Menor"

#. ~ Description of mutation "Less Sleep"
#: data/json/mutations/mutations.json
msgid "You need less sleep than the average person."
msgstr "Necesitas dormir menos que una persona normal."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Masochist"
msgstr "Masoquista"

#. ~ Description of mutation "Masochist"
#: data/json/mutations/mutations.json
msgid ""
"Although you still suffer the negative effects of pain, it also brings a "
"unique pleasure to you."
msgstr ""
"Sufres los efectos negativos del dolor, pero estos te aportan un placer "
"único."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Stimulant Psychosis"
msgstr "Psicosis por estimulantes"

#. ~ Description of mutation "Stimulant Psychosis"
#: data/json/mutations/mutations.json
msgid ""
"You have a unique history with stimulants (like coffee or amphetamines).  "
"You can tolerate a lot more of them without overdosing, but if you indulge "
"too much, you start seeing things…"
msgstr ""
"Tienes una historia única con estimulantes (como café o anfetaminas). Puedes"
" tolerar muchos más sin sobredosis, pero si le das demasiado, empezarás a "
"ver cosas..."

#. ~ Description of mutation "Stylish"
#: data/json/mutations/mutations.json
msgid ""
"Practicality is far less important than style.  Your morale is improved by "
"wearing fashionable and attractive clothing."
msgstr ""
"La funcionalidad es bastante menos importante que tener estilo. Tu moral "
"mejora cuando vistes ropas atractivas y de moda."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Light Step"
msgstr "Paso Sigiloso"

#. ~ Description of mutation "Light Step"
#: data/json/mutations/mutations.json
msgid ""
"You make less noise while walking.  You're also less likely to set off "
"traps."
msgstr ""
"Haces menos ruido cuando caminas. También eres menos propenso a caer en "
"trampas."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Robust Genetics"
msgstr "Genética Robusta"

#. ~ Description of mutation "Robust Genetics"
#: data/json/mutations/mutations.json
msgid ""
"Your genetics have rapidly adapted to the chaos of the Cataclysm, and the "
"genetic damage caused by mutations will fade much quicker."
msgstr ""
"Tu genética se ha adaptado rápidamente al caos del Cataclismo y el daño "
"genético causado por las mutaciones se desvanecerá mucho más rápido."

#. ~ Mutation name
#. ~ Snippet in category "<dog_name>"
#: data/json/mutations/mutations.json data/json/snippets/snippets.json
msgid "Scout"
msgstr "Explorador"

#. ~ Description of mutation "Scout"
#: data/json/mutations/mutations.json
msgid ""
"You're an excellent navigator and your ability to recognize distant "
"landmarks is unmatched.  Your sight radius on the overmap extends beyond the"
" normal range."
msgstr ""
"Eres un excelente explorador y tu habilidad para distinguir puntos de "
"referencia distantes no tiene parangón. Tu radio de visión en el mapa "
"general se extiende más allá del rango normal."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Topographagnosia"
msgstr "Topografagnosia"

#. ~ Description of mutation "Topographagnosia"
#: data/json/mutations/mutations.json
msgid ""
"Focal brain damage has rendered you incapable of recognizing landmarks and "
"orienting yourself in your surroundings, severely crippling your sight "
"radius on the overmap."
msgstr ""
"Una lesión cerebral focal te ha dejado incapaz de reconocer puntos de "
"referencia en el terreno y de orientarte, lo que incapacita severamente tu "
"radio de visión en el mapa."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Cannibal"
msgstr "Caníbal"

#. ~ Description of mutation "Cannibal"
#: data/json/mutations/mutations.json
msgid ""
"For your whole life you've been forbidden from indulging in your peculiar "
"tastes.  Now the world's ended, and you'll be damned if anyone is going to "
"tell you that you can't eat people."
msgstr ""
"Toda tu vida te han prohibido satisfacer tus particulares gustos. Ahora que "
"el mundo se terminó, ya nadie podrá venir a decirte que no te puedes comer "
"una persona."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Strict Humanitarian"
msgstr "Humanitario Estricto"

#. ~ Description of mutation "Strict Humanitarian"
#: data/json/mutations/mutations.json
msgid ""
"You're convinced that these things that look vaguely human from elsewhere "
"are definitely not people.  Therefore it's okay to eat them, right?"
msgstr ""
"Estás convencido de que estas cosas que parecen vagamente humanas de otro "
"lugar no son definitivamente personas. Por lo tanto, está bien comerlos, "
"¿verdad?"

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Psychopath"
msgstr "Psicópata"

#. ~ Description of mutation "Psychopath"
#: data/json/mutations/mutations.json
msgid ""
"You don't experience guilt like others do.  Even when you know your actions "
"are wrong, you just don't care."
msgstr ""
"No experimentas la culpa de la misma manera que lo hacen los demás. Incluso "
"cuando sabes que tus acciones están mal, simplemente no te importa."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Killer Drive"
msgstr "Impulso Asesino"

#. ~ Description of mutation "Killer Drive"
#: data/json/mutations/mutations.json
msgid ""
"You derive enjoyment from killing things.  Putting end to life seem to spark"
" some dark satisfaction and thrill, and you crave it every moment."
msgstr ""
"Obtienes placer matando cosas. Poner fin a la vida parece provocarte una "
"oscura satisfacción y emoción, y lo anhelas a cada momento."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Martial Arts Training"
msgstr "Artes Marciales"

#. ~ Description of mutation "Martial Arts Training"
#: data/json/mutations/mutations.json
msgid ""
"You have received some martial arts training at a local dojo.  You start "
"with your choice of Karate, Judo, Aikido, Tai Chi, Taekwondo, or Pankration."
msgstr ""
"Has recibido entrenamiento en algún arte marcial en tu dojo local. Empiezas "
"con uno de estos estilos a elegir: Karate, Judo, Aikido, Tai Chi, Taekwondo "
"o Pancracio."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Self-Defense Classes"
msgstr "Defensa Personal"

#. ~ Description of mutation "Self-Defense Classes"
#: data/json/mutations/mutations.json
msgid ""
"You have taken some self-defense classes at a nearby gym.  You start with "
"your choice of Boxing, Kickboxing, Capoeira, Krav Maga, Muay Thai, Ninjutsu,"
" Wing Chun, or Zui Quan."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Shaolin Adept"
msgstr "Adepto Shaolin"

#. ~ Description of mutation "Shaolin Adept"
#: data/json/mutations/mutations.json
msgid ""
"You have studied the arts of the Shaolin monks.  You start with one of the "
"five animal fighting styles: Tiger, Crane, Leopard, Snake, or Dragon."
msgstr ""
"Has estudiado las artes de los monjes Shaolin. Empiezas con uno de estos "
"estilos de lucha a elección: Tigre, Grulla, Leopardo, Serpiente o Dragón."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Melee Weapon Training"
msgstr "Entrenamiento en C. a C."

#. ~ Description of mutation "Melee Weapon Training"
#: data/json/mutations/mutations.json
msgid ""
"You have practiced fighting with weapons.  You start with your choice of "
"Barbaran Montante, Bōjutsu, Eskrima, Fencing, Fior Di Battaglia, Medieval "
"Swordsmanship, Niten Ichi-Ryu, Pencak Silat, or Sōjutsu."
msgstr ""
"Practicaste la lucha con armas. Empiezás eligiendo una de estas técnicas: "
"Barbaran Montante, Bōjutsu, Eskrima, Esgrima, Fior Di Battaglia, Espadeo "
"Medieval, Niten Ichi-Ryu, Pencak Silat o Sōjutsu."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Competitive Fencer"
msgstr "Esgrimista Experto"

#. ~ Description of mutation "Competitive Fencer"
#: data/json/mutations/mutations.json
msgid ""
"You were an avid fencer, starting with foil and moving onto saber, then "
"épée.  You competed nationally and dabbled with some of the historical "
"fencing weapons afforded by HEMA's popularity."
msgstr ""
"Eras un ávido esgrimista, empezando con florete y pasando por sable hasta "
"llegar a la espada. Competiste a nivel nacional y probastes algunas de las "
"armas de esgrima históricas que ofrece la popular HEMA."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Weak Scent"
msgstr "Rastro Débil"

#. ~ Description of mutation "Weak Scent"
#: data/json/mutations/mutations.json
msgid ""
"Your scent is quite weak.  Animals that track your scent will do so with "
"more difficulty."
msgstr ""
"Tu olor es bastante débil. Los animales que rastreen tu olor lo harán con "
"mayor dificultad."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Skilled Liar"
msgstr "Engaño"

#. ~ Description of mutation "Skilled Liar"
#: data/json/mutations/mutations.json
msgid ""
"You have no qualms about bending the truth, and have practically no tells.  "
"Telling lies and otherwise bluffing will be much easier for you."
msgstr ""
"No tienes ningún escrúpulo acerca de tergiversar la verdad, y sin que se "
"note. Decir mentiras y otros engaños será mucho más fácil para ti."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Weight: XS"
msgstr "Esquelético"

#. ~ Description of mutation "Weight: XS"
#: data/json/mutations/mutations.json
msgid ""
"You lost an awful lot of weight before the Cataclysm.  Whatever the reason, "
"now that food is not always close at hand, your skeletal figure presents an "
"additional danger.  You need to gain weight or die trying."
msgstr ""
"Has perdido mucho peso antes del Cataclismo. Sea cual sea la razón, ahora "
"que la comida no está siempre a mano, tu esquelética figura representa un "
"peligro adicional. Necesitas ganar peso o morir en el intento."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Weight: XXXL"
msgstr "Sobrepeso"

#. ~ Description of mutation "Weight: XXXL"
#: data/json/mutations/mutations.json
msgid ""
"You gained an awful lot of weight before the Cataclysm.  Whatever the "
"reason, now that mobility is key to survival, your bloated figure presents "
"an additional danger.  You need to lose weight or die trying."
msgstr ""
"Has ganado mucho peso antes del Cataclismo. Sea cual sea la razón, ahora que"
" la movilidad es clave para la supervivencia, tu hinchada figura representa "
"un peligro adicional. Tienes que perder peso o morir en el intento."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Pretty"
msgstr "Belleza"

#. ~ Description of mutation "Pretty"
#: data/json/mutations/mutations.json
msgid ""
"You are a sight to behold.  People who care about such things will react "
"more kindly to you."
msgstr ""
"Eres un regalo para la vista. Las personas que se preocupan por tales cosas "
"reaccionarán más amablemente contigo."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Bad Knees"
msgstr "Malas Rodillas"

#. ~ Description of mutation "Bad Knees"
#: data/json/mutations/mutations.json
msgid ""
"Whether due to injury or age, your knees aren't particularly strong or "
"flexible.  Moving over rough terrain will slow you down more than normal."
msgstr ""
"Ya sea por una lesión o por la edad, tus rodillas no son particularmente "
"fuertes ni flexibles. Atravesar terreno accidentado te ralentizará, más de "
"lo normal."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Stiff Knees"
msgstr "Rodillas Rígidas"

#. ~ Description of mutation "Stiff Knees"
#: data/json/mutations/mutations.json
msgid ""
"Your knees never bend.  Period.  Stiff as a metal pole.  Pray that your "
"journey doesn't involve stairs or slightly uneven terrain."
msgstr ""
"Tus rodillas nunca se doblan y punto. Tiesas como un poste de metal. "
"Esperemos que tu viaje no involucre escaleras o el mas mínimo desnivel."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Strong Knees"
msgstr "Rodillas Fuertes"

#. ~ Description of mutation "Strong Knees"
#: data/json/mutations/mutations.json
msgid ""
"Your knees are strong and capable of angles that you couldn't imagine "
"previously.  Moving over rough terrain will slow you down less than normal."
msgstr ""
"Tus rodillas son fuertes y capaces de realizar ángulos que antes no podías "
"imaginar. Moverte por un terreno accidentado te ralentizará menos de lo "
"normal."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Languorous"
msgstr "Lánguidez"

#. ~ Description of mutation "Languorous"
#: data/json/mutations/mutations.json
msgid ""
"Whether due to lack of exercise and poor diet, or due to a natural "
"disinclination to physical endurance, you tire due to physical exertion much"
" more readily than others.  Your total cardio fitness and stamina are lower "
"than normal."
msgstr ""
"Ya sea por la falta de ejercicio y mala alimentación, o debido a tu poca "
"disposición natural a la resistencia física, el esfuerzo físico te cansa "
"mucho más que a los demás. Tu capacidad cardiovascular total y Tu vigor son "
"más bajos de lo normal."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Near-Sighted"
msgstr "Miope"

#. ~ Description of mutation "Near-Sighted"
#: data/json/mutations/mutations.json
msgid ""
"Without glasses, your seeing radius is severely reduced!  However, you are "
"guaranteed to start with a pair of glasses."
msgstr ""
"¡Sin gafas, tu radio de visión se reduce severamente! Sin embargo, tienes la"
" garantía de comenzar con un par de gafas."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Slow Healer"
msgstr "Sanación Lenta"

#. ~ Description of mutation "Slow Healer"
#: data/json/mutations/mutations.json
#, no-c-format
msgid ""
"Your wounds heal a little slower than most.  Your HP whilst asleep, as well "
"as your broken limbs, heal at 75% of the regular rate."
msgstr ""
"Tus heridas se curan un poco más lentas que la mayoría. Tus PG mientras "
"duermes, así como tus extremidades rotas, se curan al 75% de la velocidad "
"normal."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Poor Healer"
msgstr "Sanación Pobre"

#. ~ Description of mutation "Poor Healer"
#: data/json/mutations/mutations.json
#, no-c-format
msgid ""
"Your health recovery is severely impaired.  Your HP whilst asleep, as well "
"as your broken limbs, heal at 33% of the regular rate."
msgstr ""
"Tu recuperación de salud se ve gravemente afectada. Tus PG mientras duermes,"
" así como tus extremidades rotas, se curan a un 33% del ritmo normal."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Imperceptive Healer"
msgstr "Sanación Nula"

#. ~ Description of mutation "Imperceptive Healer"
#: data/json/mutations/mutations.json
#, no-c-format
msgid ""
"Wounds are incredibly dangerous to you, as they barely heal at all.  Your HP"
" whilst asleep, as well as your broken limbs, heal at 10% of the regular "
"rate."
msgstr ""
"Las heridas son increíblemente peligrosas para ti, ya que apenas se curan. "
"Tus PG mientras estás dormido, así como tus extremidades rotas, se curan a "
"un 10% de la velocidad normal."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Irreparable"
msgstr "Irreparable"

#. ~ Description of mutation "Irreparable"
#: data/json/mutations/mutations.json
msgid ""
"Whatever caused the end of the world affected you in a horrible way.  Your "
"wounds will never heal on their own and your broken limbs will never mend."
msgstr ""
"Sea lo que sea que causó el fin del mundo, también te afectó de una manera "
"horrible. Tus heridas nunca sanarán por si mismas y tus extremidades "
"fracturadas no se soldarán."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Far-Sighted"
msgstr "Hipermetropía"

#. ~ Description of mutation "Far-Sighted"
#: data/json/mutations/mutations.json
msgid ""
"Without reading glasses, you are unable to read anything, and take penalties"
" on melee accuracy and electronics/tailoring crafting.  However, you are "
"guaranteed to start with a pair of reading glasses."
msgstr ""
"Sin las gafas de lectura, no puedes leer nada y sufres penalizaciones en la "
"precisión en el combate c. a c. y en la fabricación de productos "
"electrónicos y de sastrería. Sin embargo, te garantiza que comiences con un "
"par de gafas de lectura."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Heavy Sleeper"
msgstr "Sueño pesado"

#. ~ Description of mutation "Heavy Sleeper"
#: data/json/mutations/mutations.json
msgid "You're quite the heavy sleeper.  Noises are unlikely to wake you up."
msgstr ""
"Eres uno de esos que tienen el sueño pesado. Los ruidos no te van a "
"despertar fácilmente."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Sleepy"
msgstr "Letargo"

#. ~ Description of mutation "Sleepy"
#: data/json/mutations/mutations.json
msgid "You need sleep more often, but still spend most of your time awake."
msgstr ""
"Necesitas dormir más a menudo, pero aun así pasas la mayor parte del tiempo "
"despierto."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Assassin Convict"
msgstr "Asesino Convicto"

#. ~ Description of mutation "Assassin Convict"
#: data/json/mutations/mutations.json
msgid ""
"You have a target to kill.  Search it, find it, and eliminate whatever it is"
" now."
msgstr ""
"Convicto un objetivo para matar. Búscalo, encuéntralo y elimínalo sea lo que"
" sea ahora."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Asthmatic"
msgstr "Asma"

#. ~ Description of mutation "Asthmatic"
#: data/json/mutations/mutations.json
msgid ""
"You will occasionally need to use an inhaler, or else suffer severe physical"
" limitations.  However, you are guaranteed to start with an inhaler."
msgstr ""
"Ocasionalmente, necesitarás utilizar un inhalador o sino sufrirás severas "
"limitaciones físicas. Pero empiezas con un inhalador."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Bad Back"
msgstr "Mala Espalda"

#. ~ Description of mutation "Bad Back"
#: data/json/mutations/mutations.json
#, no-c-format
msgid ""
"You simply cannot carry as much as people with a similar strength could.  "
"Your maximum weight carried is reduced by 35%."
msgstr ""
"Simplemente no puedes cargar tanto peso como las personas con una fuerza "
"similar. Tu peso máximo transportado se reduce en un 35%."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Bad Temper"
msgstr "Mal Humor"

#. ~ Description of mutation "Bad Temper"
#: data/json/mutations/mutations.json
msgid ""
"Things just keep getting you down.  You tend to be unhappy, and it takes "
"some doing to cheer you up."
msgstr ""
"Las cosas siempre te ponen mal. Tienes una tendencia a estar triste, y te "
"cuesta bastante levantar el ánimo."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Disorganized"
msgstr "Desorganizado"

#. ~ Description of mutation "Disorganized"
#: data/json/mutations/mutations.json
#, no-c-format
msgid ""
"You are terrible at organizing and storing your possessions.  You retrieve "
"things from containers 10% slower."
msgstr ""
"Eres terrible organizando y almacenando tus posesiones. Recuperas las cosas "
"de los contenedores un 10% más lento."

#. ~ Mutation name
#: data/json/mutations/mutations.json
#: data/mods/innawood/mutations/mutations.json
msgid "Illiterate"
msgstr "Analfabetismo"

#. ~ Description of mutation "Illiterate"
#: data/json/mutations/mutations.json
#: data/mods/innawood/mutations/mutations.json
msgid "You never learned to read!  Books and computers are off-limits to you."
msgstr ""
"¡Nunca aprendiste a leer! Los libros y los ordenadores están fuera de tus "
"posibilidades."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Poor Hearing"
msgstr "Sordera"

#. ~ Description of mutation "Poor Hearing"
#: data/json/mutations/mutations.json
msgid "Your hearing is poor, and you may not hear quiet or far-off noises."
msgstr "Tu oído es malo, y no vas a escuchar los ruidos leves o distantes."

#. ~ Description of mutation "Deaf"
#: data/json/mutations/mutations.json
msgid ""
"You're not able to hear anything, and as such you're not able to talk to "
"NPCs."
msgstr ""
"No eres capaz de oír nada, y por lo tanto no puedes hablar con los PNJ."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Slow Learner"
msgstr "Aprendizaje Lento"

#. ~ Description of mutation "Slow Learner"
#: data/json/mutations/mutations.json
msgid ""
"You are slow to grasp new ideas, and thus learn things more slowly than "
"others.  Note that this only applies to real-world experience, not to skill "
"gain from other sources like books."
msgstr ""
"Eres lento en comprender nuevas ideas y debido a ello aprendes las cosas más"
" lentamente que otros. Ten en cuenta que esto sólo se aplica a la "
"experiencia en el mundo real, no a las habilidades obtenidas de otras "
"fuentes como los libros."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Insomniac"
msgstr "Insomnio"

#. ~ Description of mutation "Insomniac"
#: data/json/mutations/mutations.json
msgid ""
"You have a hard time falling asleep, even under the best circumstances!"
msgstr ""
"Te cuesta mucho dormirte, ¡incluso cuando las condiciones son perfectas!"

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Meat Intolerance"
msgstr "Intolerante a la Carne"

#. ~ Description of mutation "Meat Intolerance"
#. ~ Description of mutation "Herbivorous Ancestry"
#: data/json/mutations/mutations.json
#: data/mods/Aftershock/mutations/obsolete.json
msgid ""
"You have problems with eating meat.  It's possible for you to eat it, but "
"you will suffer morale penalties and obtain less nutrition from it."
msgstr ""
"Tienes problemas para comer carne. Puedes comerla, pero sufrirás una "
"penalización a la moral y obtendrás menos nutrición de ella."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Thin-Skinned"
msgstr "Piel Fina"

#. ~ Description of mutation "Thin-Skinned"
#: data/json/mutations/mutations.json
msgid ""
"Your skin is fragile.  Cutting and bashing damage is slightly increased for "
"you."
msgstr ""
"Tu piel es frágil. El daño cortante y contundente provocado en ti se "
"incrementa ligeramente."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Hates Vegetables"
msgstr "Odio A Las Verduras"

#. ~ Description of mutation "Hates Vegetables"
#: data/json/mutations/mutations.json
msgid ""
"You have problems with eating vegetables.  It's possible for you to eat "
"them, but you will suffer morale penalties and obtain less nutrition from "
"them."
msgstr ""
"Tienes problemas para comer vegetales. Puedes comerlos pero sufrirás una "
"penalización a la moral y obtendrás menos nutrición de ellos."

#. ~ Mutation name
#: data/json/mutations/mutations.json
#: data/mods/innawood/mutations/mutations.json
msgid "Hates Books"
msgstr "Odio A Los Libros"

#. ~ Description of mutation "Hates Books"
#: data/json/mutations/mutations.json
#: data/mods/innawood/mutations/mutations.json
msgid ""
"Reading is for nerds!  Boring books are more boring, and you can't have fun "
"by reading books."
msgstr ""
"¡Leer es para nerds! Los libros aburridos son aun mas aburridos, y no puedes"
" divertirte leyendo libros."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Fructose Intolerance"
msgstr "Intolerancia a la Fructosa"

#. ~ Description of mutation "Fructose Intolerance"
#: data/json/mutations/mutations.json
msgid ""
"Eating fruits always causes your stomach to ache.  It's possible for you to "
"eat them, but you will suffer morale penalties and obtain less nutrition "
"from them."
msgstr ""
"Comer frutas siempre provoca dolor de estómago. Es posible que las comas, "
"pero sufrirás penalizaciones morales y obtendrás menos nutrientes de ellas."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Lactose Intolerance"
msgstr "Intolerante a la Lactosa"

#. ~ Description of mutation "Lactose Intolerance"
#: data/json/mutations/mutations.json
msgid ""
"You, like 75 percent of the world, cannot tolerate milk or milk based "
"products.  It's possible for you to eat them, but you will suffer morale "
"penalties and obtain less nutrition from them."
msgstr ""
"Tú, como el 75% del mundo, no puedes tolerar la leche o los productos "
"lácteos. Puedes ingerirlos pero sufrirás una penalización a la moral y "
"obtendrás menos nutrición de ellos."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Junkfood Intolerance"
msgstr "Intolerante a la Comida Basura"

#. ~ Description of mutation "Junkfood Intolerance"
#: data/json/mutations/mutations.json
msgid ""
"Something in those heavily processed foods doesn't agree with you.  It's "
"possible for you to eat them, but you will suffer morale penalties and "
"obtain less nutrition from them."
msgstr ""
"Algo en estos alimentos altamente procesados no te sienta bien. Puedes "
"comerlos pero sufrirás una penalización a la moral y obtendrás menos "
"nutrición de ellos."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Grain Intolerance"
msgstr "Intolerante al Grano"

#. ~ Description of mutation "Grain Intolerance"
#: data/json/mutations/mutations.json
msgid ""
"You have a rare allergy that prevents you from eating wheat.  It's possible "
"for you to eat wheat-based products, but you will suffer morale penalties "
"and obtain less nutrition from them."
msgstr ""
"Tienes una rara alergia que te impide comer trigo. Puedes comerlo pero "
"sufrirás una penalización a la moral y obtendrás menos nutrición de ellos."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Sweet Tooth"
msgstr "Afición al Dulce"

#. ~ Description of mutation "Sweet Tooth"
#: data/json/mutations/mutations.json
msgid ""
"You have a soft spot for processed foods, and gain a morale bonus from "
"eating them."
msgstr ""
"Tienes una debilidad por los alimentos procesados, y obtienes una "
"bonificación de moral al comerlos."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Sugar-Loving"
msgstr "Amante del Azúcar"

#. ~ Description of mutation "Sugar-Loving"
#: data/json/mutations/mutations.json
msgid ""
"You *adore* the taste of junk food, and find it preferable to everything "
"else!"
msgstr ""
"*Adorás* el sabor de la comida basura, ¡y la preferís a cualquier otra "
"comida!"

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Glass Jaw"
msgstr "Mandíbula de Cristal"

#. ~ Description of mutation "Glass Jaw"
#: data/json/mutations/mutations.json
#, no-c-format
msgid ""
"Your head can't take much abuse.  Its maximum HP is 20% lower than usual.  "
"Your apparent fragility makes you less intimidating."
msgstr ""
"Tu cabeza no puede soportar mucho abuso. Sus PG máximos son un 20% menor de "
"lo usual. Tu aparente fragilidad te hace menos intimidante."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Forgetful"
msgstr "Mala Memoria"

#. ~ Description of mutation "Forgetful"
#: data/json/mutations/mutations.json
msgid ""
"You have a hard time remembering things.  Your skills will erode slightly "
"faster than usual."
msgstr ""
"Te cuesta mucho recordar las cosas. Tus habilidades se atrofiarán más rápido"
" que lo normal."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Lightweight"
msgstr "Poco Resistente A Las Drogas"

#. ~ Description of mutation "Lightweight"
#: data/json/mutations/mutations.json
msgid ""
"Alcohol and drugs go straight to your head.  You suffer the negative effects"
" of these for longer."
msgstr ""
"Las drogas y el alcohol se te van derechito a la cabeza. Sufres los efectos "
"negativos de estas cosas por más tiempo."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Addictive Personality"
msgstr "Susceptible a la adicción"

#. ~ Description of mutation "Addictive Personality"
#: data/json/mutations/mutations.json
msgid ""
"It's easier for you to become addicted to substances, and harder to rid "
"yourself of these addictions."
msgstr ""
"Es más fácil para ti volverte adicto a las sustancias, y más difícil "
"deshacerte de esas adicciones."

#. ~ Mutation name
#: data/json/mutations/mutations.json
#: data/mods/Aftershock/mutations/obsolete.json
msgid "Strong Scent"
msgstr "Rastro Fuerte"

#. ~ Description of mutation "Strong Scent"
#: data/json/mutations/mutations.json
msgid ""
"Your scent is particularly strong.  It's not offensive to humans, but "
"animals that track your scent will do so more easily."
msgstr ""
"Tu olor es bastante fuerte. No es ofensivo para los otros humanos, pero a "
"los animales que te rastrean por tu olor se les hará más fácil."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Chemical Imbalance"
msgstr "Desequilibrio Químico"

#. ~ Description of mutation "Chemical Imbalance"
#: data/json/mutations/mutations.json
msgid ""
"You suffer from a minor chemical imbalance, whether mental or physical.  "
"Minor changes to your internal chemistry will manifest themselves on "
"occasion, such as hunger, sleepiness, narcotic effects, etc."
msgstr ""
"Sufres un pequeño desequilibrio químico, ya sea mental o físico. Los "
"pequeños cambios en tu química interior se manifestarán ocasionalmente, como"
" el hambre, el sueño, los efectos narcóticos, etc."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Animal Discord"
msgstr "Antipatía Animal"

#. ~ Description of mutation "Animal Discord"
#: data/json/mutations/mutations.json
msgid ""
"Most animals don't like you, and aggressive animals are more likely to "
"attack you.  This only applies to natural animals such as woodland "
"creatures."
msgstr ""
"Le caes mal a la mayoría de los animales, y los que son agresivos serán más "
"propensos a atacarte. Esto solo se aplica a los animales naturales como las "
"criaturas del bosque."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Prey Animal"
msgstr "Presa de Animales"

#. ~ Description of mutation "Prey Animal"
#: data/json/mutations/mutations.json
msgid ""
"Natural animals like dogs and wolves see you as prey, and are liable to "
"attack you on sight."
msgstr ""
"Los animales naturales como los perros y los lobos te ven como una presa, y "
"son más propensos a atacarte a simple vista."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Slow Reader"
msgstr "Lector Lento"

#. ~ Description of mutation "Slow Reader"
#: data/json/mutations/mutations.json
msgid ""
"You're a slow reader, and it takes you longer to get through books than "
"most."
msgstr ""
"Eres un lector lento y te lleva más tiempo que a los demás terminar un "
"libro."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Kaluptic Psychosis"
msgstr "Psicosis Kalúptica"

#. ~ Description of mutation "Kaluptic Psychosis"
#: data/json/mutations/mutations.json
msgid ""
"Ever since the sky first broke, you have felt unwell, your head split by "
"alien thoughts.  You will periodically suffer from delusions, ranging from "
"minor effects to full visual hallucinations.  Some of these effects may be "
"controlled through the use of antipsychotics."
msgstr ""
"Desde que el cielo se partió por primera vez, te has sentido mal, con la "
"cabeza dividida por pensamientos alienigenas. Periódicamente sufrirás "
"delirios, que van desde efectos menores hasta alucinaciones visuales "
"completas. Algunos de estos efectos pueden controlarse mediante el uso de "
"antipsicóticos."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Narcoleptic"
msgstr "Narcolépsia"

#. ~ Description of mutation "Narcoleptic"
#: data/json/mutations/mutations.json
msgid "You randomly fall asleep without any reason."
msgstr "Sin razón alguna, a veces te quedás dormido."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Clumsy"
msgstr "Torpe"

#. ~ Description of mutation "Clumsy"
#. ~ Description of mutation "Giant Step"
#: data/json/mutations/mutations.json
#: data/mods/Aftershock/mutations/obsolete.json
msgid ""
"You make more noise while walking.  You're also more likely to set off "
"traps."
msgstr ""
"Haces más ruido cuando caminas. También eres más propenso a caer en trampas."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Jittery"
msgstr "Tembleque"

#. ~ Description of mutation "Jittery"
#: data/json/mutations/mutations.json
msgid ""
"When very hungry or under the effects of stimulants, you may find your hands"
" shaking uncontrollably, severely reducing your Dexterity."
msgstr ""
"Cuando estás muy hambriento o bajo los efectos de estimulantes, puedes "
"encontrarte con tus manos temblando incontrolablemente, reduciendo "
"severamente tu Destreza."

#. ~ Description of mutation "Hoarder"
#: data/json/mutations/mutations.json
msgid ""
"You don't feel right unless you're carrying as much as you can.  You suffer "
"morale penalties for carrying less than maximum volume (weight is ignored)."
"  Xanax can help control this anxiety."
msgstr ""
"No te vas a sentir bien a menos que estés cargando tanto como puedas. Sufres"
" penalidades a la moral si cargas menos del máximo volumen que puedes llevar"
" (el peso no importa). El Xanax te puede ayudar a controlar esta ansiedad."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Savant"
msgstr "Sabelotodo"

#. ~ Description of mutation "Savant"
#: data/json/mutations/mutations.json
msgid ""
"You tend to specialize in one skill and be poor at all others.  You advance "
"at half speed in all skills except your best one.  Note that combining this "
"with Fast Learner will come out to a slower rate of learning for all skills."
msgstr ""
"Tiendes a especializarte en una habilidad y eres peor en el resto. Avanzas a"
" media velocidad en todas las habilidades excepto en la mejor que tengas. "
"Ten en cuenta que combinar esto con Aprendizaje Rápido resultará en un "
"aprendizaje más lento para todas las habilidades."

#. ~ Description of mutation "Pacifist"
#: data/json/mutations/mutations.json
msgid ""
"You don't like thinking about violence.  Your combat skills advance much "
"slower than usual, and you feel more guilt about killing."
msgstr ""
"No te gusta pensar en la violencia. Tus habilidades de combate avanzan mucho"
" más lento que lo normal, y te sientes más culpable cuando matas."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Mood Swings"
msgstr "Cambios de Humor"

#. ~ Description of mutation "Mood Swings"
#: data/json/mutations/mutations.json
msgid "Your morale will shift up and down at random, often dramatically."
msgstr "Tu moral sube y baja al azar, a veces dramáticamente. "

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Slow Footed"
msgstr "Pies Lentos"

#. ~ Description of mutation "Slow Footed"
#: data/json/mutations/mutations.json
#, no-c-format
msgid ""
"You can't move as fast as most, resulting in a 15% speed penalty on flat "
"ground."
msgstr ""
"No puedes moverte tan rápido como la mayoría, lo que supone una penalización"
" de velocidad del 15% en terreno llano."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Weak Stomach"
msgstr "Estómago Flojo"

#. ~ Description of mutation "Weak Stomach"
#: data/json/mutations/mutations.json
msgid "You are more likely to throw up from food poisoning, alcohol, etc."
msgstr ""
"Eres más propenso a vomitar por intoxicación con la comida, el alcohol, etc."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Wool Allergy"
msgstr "Alergia a la Lana"

#. ~ Description of mutation "Wool Allergy"
#: data/json/mutations/mutations.json
msgid ""
"You are badly allergic to wool, and cannot wear any clothing made of the "
"substance."
msgstr ""
"Eres muy alérgico a la lana, y no puedes usar ninguna ropa hecha de esa "
"sustancia."

#. ~ Description of mutation "Vegan"
#: data/json/mutations/mutations.json
msgid ""
"You're very strictly vegan, eating animal products is out of the question, "
"even if it means death.  You also can't bear to wear clothing made of animal"
" products, such as leather or fur."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Truth Teller"
msgstr "Honestidad"

#. ~ Description of mutation "Truth Teller"
#: data/json/mutations/mutations.json
msgid ""
"When you try to tell a lie, you blush, stammer, and get all shifty-eyed.  "
"Telling lies and otherwise bluffing will be much more difficult for you."
msgstr ""
"Cuando tratas de mentir, te pones colorado, tartamudeas y pareces "
"sospechoso. Mentir y farolear será mucho más difícil para ti."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Ugly"
msgstr "Fealdad"

#. ~ Description of mutation "Ugly"
#: data/json/mutations/mutations.json
msgid ""
"You're not much to look at.  People who care about such things will react "
"poorly to you."
msgstr ""
"Eres difícil de mirar. La gente que se preocupa por esas cosas reaccionará "
"mal ante ti."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Albino"
msgstr "Albinismo"

#. ~ Description of mutation "Albino"
#: data/json/mutations/mutations.json
msgid ""
"You lack skin pigmentation due to a genetic problem.  You sunburn extremely "
"easily, and typically use an umbrella and sunglasses when going out in the "
"sun."
msgstr ""
"Careces de pigmentación en la piel debido a un problema genético. Te quemas "
"con mucha facilidad, y típicamente usas un paraguas y gafas de sol cuando "
"sales al sol."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Flimsy"
msgstr "Endeble"

#. ~ Description of mutation "Flimsy"
#: data/json/mutations/mutations.json
#, no-c-format
msgid ""
"Your body can't take much abuse.  Its maximum HP is 25% lower than usual.  "
"Your weakness is apparent and makes you less intimidating.  Stacks with "
"Glass Jaw."
msgstr ""
"Tu cuerpo no puede soportar mucho abuso. Sus PG máximos son un 25% menor de "
"lo usual, y te curas un poco más lento. Se acumula con Mandíbula de Cristal."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Frail"
msgstr "Debilidad"

#. ~ Description of mutation "Frail"
#: data/json/mutations/mutations.json
#, no-c-format
msgid ""
"Your body breaks very easily.  Its maximum HP is 50% lower than usual.  Your"
" weakness is apparent and makes you less intimidating.  Stacks with Glass "
"Jaw."
msgstr ""
"Tu cuerpo se rompe muy fácilmente. Sus PG máximos son un 50% menor de lo "
"usual, y te curas más lentamente. Se acumula con Mandíbula de Cristal."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Fragile"
msgstr "Fragilidad"

#. ~ Description of mutation "Fragile"
#: data/json/mutations/mutations.json
#, no-c-format
msgid ""
"Your body is extremely fragile.  Its maximum HP is 75% lower than usual.  "
"Your weakness is apparent and makes you less intimidating.  Stacks with "
"Glass Jaw."
msgstr ""
"Tu cuerpo es extremadamente frágil. Tus PG máximos son un 75% menor de lo "
"usual, y te curas bastante más lentamente. Se acumula con Mandíbula de "
"Cristal."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Genetic Downward Spiral"
msgstr "Espiral Genética Descendente"

#. ~ Description of mutation "Genetic Downward Spiral"
#: data/json/mutations/mutations.json
msgid ""
"The events of the Cataclysm have damaged your DNA beyond repair.  You mutate"
" frequently, all mutations you receive (from any source) are negative, and "
"your instability is rapidly growing out of control."
msgstr ""
"Los eventos del Cataclismo han dañado tu ADN más allá de la reparación. "
"Mutas con frecuencia, y todas las mutaciones que recibes (de cualquier "
"fuente) son negativas."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Jaundice"
msgstr ""

#. ~ Description of mutation "Jaundice"
#: data/json/mutations/mutations.json
msgid ""
"It's subtle, but your skin has definitely taken on a sickly yellow-green "
"hue."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Goosebumps"
msgstr ""

#. ~ Description of mutation "Goosebumps"
#: data/json/mutations/mutations.json
msgid ""
"You have goosebumps that never seem to go away.  Are they getting bigger?"
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Rashy Skin"
msgstr ""

#. ~ Description of mutation "Rashy Skin"
#: data/json/mutations/mutations.json
msgid ""
"You've developed a persistent skin rash.  Sometimes it's fine, other times "
"it itches like hell."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Hirsute"
msgstr ""

#. ~ Description of mutation "Hirsute"
#: data/json/mutations/mutations.json
msgid ""
"Your body hair is growing in thicker than it used to.  It's almost like "
"you're going through a second puberty or something."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Peeling Skin"
msgstr ""

#. ~ Description of mutation "Peeling Skin"
#: data/json/mutations/mutations.json
msgid ""
"Your skin keeps peeling in big flakes, like you're recovering from a bad "
"sunburn.  Oddly, it doesn't hurt at all."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Smooth Skin"
msgstr ""

#. ~ Description of mutation "Smooth Skin"
#: data/json/mutations/mutations.json
msgid ""
"Your skin has lost some of its color and taken on a smooth, papery texture."
"  This slightly reduces wet effects, but also makes you a little more "
"vulnerable to cuts and scrapes."
msgstr ""
"Tu piel ha perdido algo de su color y ha adquirido una textura suave y de "
"papel. Esto reduce ligeramente los efectos mojados, pero también te hace un "
"poco más vulnerable a cortes y raspaduras."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "High Night Vision"
msgstr "Visión Nocturna Aguda"

#. ~ Description of mutation "High Night Vision"
#: data/json/mutations/mutations.json
msgid ""
"You can see incredibly well in the dark!  Activate to toggle NV-visible "
"areas on or off."
msgstr ""
"¡Puedes ver increíblemente bien en la oscuridad! Hay que activarlo para ver "
"las áreas visibles por Visión Nocturna."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Full Night Vision"
msgstr "Visión Nocturna Completa"

#. ~ Description of mutation "Full Night Vision"
#: data/json/mutations/mutations.json
msgid ""
"You can see in pitch blackness as if you were wearing night-vision goggles."
"  Activate to toggle NV-visible areas on or off."
msgstr ""
"En la oscuridad total puedes ver como si estuvieras usando gafas de visión "
"nocturna. Hay que activarlo para ver las áreas visibles por Visión Nocturna."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Cephalopod Eyes"
msgstr "Ojos de Cefalópodo"

#. ~ Description of mutation "Cephalopod Eyes"
#: data/json/mutations/mutations.json
msgid ""
"Your eyes still bulge, yet your pupils look different somehow.  Water "
"doesn't seem to cause any trouble at all, though."
msgstr ""
"Tus ojos siguen saltando, pero tus pupilas se ven diferentes de alguna "
"manera. El agua no parece causar ningún problema, sin embargo."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Man's Best Friend"
msgstr "Mejor Amigo del Hombre"

#. ~ Description of mutation "Man's Best Friend"
#: data/json/mutations/mutations.json
msgid ""
"Man's oldest and most well known friends are all Lupines.  Somehow you've "
"mutated something that reminds other survivors of your more domestic "
"relatives.  A softer edge around the eyes, maybe."
msgstr ""
"Los amigos más antiguos y conocidos del hombre son todos Lupinos. De alguna "
"manera has mutado algo que recuerda a otros supervivientes de tus parientes "
"más domésticos. Un borde más suave alrededor de los ojos, tal vez."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Cephalopod Vision"
msgstr "Visión de Cefalópodo"

#. ~ Description of mutation "Cephalopod Vision"
#: data/json/mutations/mutations.json
msgid ""
"Your brain has caught up with your eyes.  You can see much better in the "
"dark, but sunlight seems much brighter now.  Activate to toggle NV-visible "
"areas on or off."
msgstr ""
"Tu cerebro ahora acompaña la capacidad de tus ojos. Puedes ver mucho mejor "
"en la oscuridad, pero la luz del sol parece mucho más brillante. Hay que "
"activarlo para ver las áreas visibles por Visión Nocturna."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Fey Eyes"
msgstr "Ojos de Espiritu"

#. ~ Description of mutation "Fey Eyes"
#: data/json/mutations/mutations.json
msgid ""
"Your eyes have turned… green.  It's tough to tell the exact shade, as it "
"seems to shift.  The effect is… pleasant."
msgstr ""
"Tus ojos se han vuelto... verdes. Es difícil decir el tono exacto ya que "
"parecen cambiar. El efecto es... agradable."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Fey Vision"
msgstr "Visión de Espiritu"

#. ~ Description of mutation "Fey Vision"
#: data/json/mutations/mutations.json
msgid ""
"The shadows don't seem as dark now.  Activate to toggle NV-visible areas on "
"or off."
msgstr ""
"Las sombras ya no parecen ser tan oscuras. Hay que activarlo para ver las "
"áreas visibles por Visión Nocturna."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Fey Nightsight"
msgstr "Visión Nocturna de Espiritu"

#. ~ Description of mutation "Fey Nightsight"
#: data/json/mutations/mutations.json
msgid ""
"You have great low-light vision now, but it doesn't allow you to perform "
"fine tasks such as crafting and reading in darkness.  Activate to toggle NV-"
"visible areas on or off."
msgstr ""
"Tienes una gran visión con poca luz ahora, pero no te permite realizar "
"tareas finas como la fabricación y la lectura en la oscuridad. Actívala para"
" activar o desactivar la VN."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Feline Eyes"
msgstr "Ojos Felinos"

#. ~ Description of mutation "Feline Eyes"
#: data/json/mutations/mutations.json
msgid ""
"Your eyes have mutated; now you have slit pupils, and they glitter in the "
"light, much like a cat's.  This is visually striking, but it isn't helping "
"you see at night."
msgstr ""
"Tus ojos han mutado; ahora tienes las pupilas rasgadas y brillan a la luz, "
"como los de un gato. Esto es visualmente llamativo, pero no te ayuda a ver "
"de noche."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Feline Vision"
msgstr "Visión Felina"

#. ~ Description of mutation "Feline Vision"
#: data/json/mutations/mutations.json
msgid ""
"Your optic nerves and brain caught up with your eyes.  Now you can see "
"pretty well at night.  Activate to toggle NV-visible areas on or off."
msgstr ""
"Tus nervios ópticos ahora acompañan la capacidad de tus ojos. Puedes ver "
"bastante bien en la noche. Hay que activarlo para ver las áreas visibles por"
" Visión Nocturna."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Ursine Vision"
msgstr "Visión Ursina"

#. ~ Description of mutation "Ursine Vision"
#: data/json/mutations/mutations.json
msgid ""
"Your visual processing has shifted: though you can see better in the dark, "
"you're nearsighted in the light.  Maybe glasses would help.  Activate to "
"toggle NV-visible areas on or off."
msgstr ""
"Tu proceso visual ha cambiado: a pesar de que puedes ver mejor en la "
"oscuridad, eres miope cuando hay luz. Tal vez las gafas te puedan ayudar. "
"Hay que activarlo para ver las áreas visibles por Visión Nocturna."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Avian Eyes"
msgstr "Ojos de Ave"

#. ~ Description of mutation "Avian Eyes"
#: data/json/mutations/mutations.json
msgid ""
"Your vision has become particularly acute: you suspect you could pick out "
"zombies much farther away.  Perception +4."
msgstr ""
"Tu visión se ha vuelto particularmente aguda: sospechas que puedes divisar "
"zombis desde mucho más lejos. Percepción +4."

#. ~ Description of mutation "Infrared Vision"
#: data/json/mutations/mutations.json
msgid "Your eyes have mutated to pick up radiation in the infrared spectrum."
msgstr ""
"Tus ojos han mutado y puedes ver la radiación en el espectro infrarrojo."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Reptilian Eyes"
msgstr "Ojos Reptilianos"

#. ~ Description of mutation "Reptilian Eyes"
#: data/json/mutations/mutations.json
msgid ""
"Your eyes have mutated, with a brilliant iris and slitted pupil similar to "
"that of a lizard.  This is visually striking, but doesn't seem to affect "
"your vision."
msgstr ""
"Tus ojos han mutado, con un iris brillante y la pupila rasgada, similar a "
"los de un lagarto. Esto es llamativo, pero no parece afectar tu visión."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Reptilian IR"
msgstr "Infrarrojos Reptiliano"

#. ~ Description of mutation "Reptilian IR"
#: data/json/mutations/mutations.json
msgid ""
"Your optic nerves and brain have mutated to catch up with your eyes, "
"allowing you to see in the infrared spectrum."
msgstr ""
"Tus nervios ópticos y cerebro han mutado para acompañar la capacidad de tus "
"ojos, lo que te permite ver en el espectro infrarrojo."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Very Fast Healer"
msgstr "Sanador Muy Rápido"

#. ~ Description of mutation "Very Fast Healer"
#: data/json/mutations/mutations.json
msgid "Your wounds and broken limbs heal very quickly."
msgstr "Tus heridas y extremidades rotas sanan muy rápido."

#. ~ Mutation name
#. ~ Name of effect type id "flask_regeneration"
#: data/json/mutations/mutations.json data/mods/Magiclysm/effects/effects.json
msgid "Regeneration"
msgstr "Regeneración"

#. ~ Description of mutation "Regeneration"
#: data/json/mutations/mutations.json
msgid "Your flesh regenerates and your limbs mend incredibly quickly."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Reptilian Healing"
msgstr "Sanador Reptiliano"

#. ~ Description of mutation "Reptilian Healing"
#: data/json/mutations/mutations.json
msgid ""
"Your broken limbs mend themselves without significant difficulty in addition"
" to your already-quick healing.  You do not require splints for broken "
"limbs."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Very Little Sleep"
msgstr "Muy Poco Sueño"

#. ~ Description of mutation "Very Little Sleep"
#: data/json/mutations/mutations.json
msgid "You don't sleep often.  But when you do, you need very little of it."
msgstr ""
"No duermes muy seguido. Pero cuando duermes, con muy poco es suficiente."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Tireless"
msgstr "Incansable"

#. ~ Description of mutation "Tireless"
#: data/json/mutations/mutations.json
msgid "You defend the realm all night and all day."
msgstr "Defiendes el reino toda la noche y todo el día."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Fangs"
msgstr "Colmillos"

#. ~ Description of mutation "Fangs"
#: data/json/mutations/mutations.json
msgid ""
"Your teeth have grown into two-inch-long fangs, allowing you to make an "
"extra attack when conditions favor it."
msgstr ""
"Tus dientes se han convertido en colmillos de 5 cm, lo que te permite tener "
"un ataque extra cuando las condiciones te lo permiten."

#. ~ Message when player with mutation "Fangs" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "You sink your fangs into %s!"
msgstr "¡Hundes tus colmillos en el %s!"

#. ~ Message when NPC with mutation "Fangs" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "%1$s sinks their fangs into %2$s!"
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Incisors"
msgstr "Incisivos"

#. ~ Description of mutation "Incisors"
#: data/json/mutations/mutations.json
msgid "Your big teeth have grown in.  Folks had best show some more respect."
msgstr ""
"Tus dientes grandes han crecido. La gente te va a tener que respetar más."

#. ~ Message when player with mutation "Incisors" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "You bite into %s with your ratlike incisors!"
msgstr "¡Muerdes el %s con tus incisivos como los de una rata!"

#. ~ Message when NPC with mutation "Incisors" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "%1$s bites %2$s with their ratlike incisors!"
msgstr ""

#. ~ Description of mutation "Nictitating Membrane"
#: data/json/mutations/mutations.json
msgid ""
"You have a set of clear lenses which lower over your eyes while underwater, "
"allowing you to see as though you were wearing goggles.  Slightly decreases "
"wet penalties."
msgstr ""
"Tienes un juego de lentes transparentes que bajan sobre tus ojos mientras "
"estás bajo el agua, permitiéndote ver como si estuvieras usando gafas. "
"Disminuye ligeramente las penalizaciones por estar mojado."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Frog Eyes"
msgstr "Ojos de Rana"

#. ~ Description of mutation "Frog Eyes"
#: data/json/mutations/mutations.json
msgid ""
"Your eyes bulge noticeably out of your face, and you are able to move them "
"much more freely than before.  You can see movement and close objects "
"clearly, but you have trouble picking up distant details in the light.  "
"Instead of eyelids they are covered by a translucent, protective membrane "
"that blocks irritants and water.  It allows you to sleep with your eyes "
"open!  Activate to cause the approach of hostile creatures to wake you up."
msgstr ""
"Tus ojos sobresalen notablemente de tu cara y sos capaz de moverlos de "
"manera más libre. Puedes ver movimiento y objetos cercanos con claridad pero"
" te cuesta ver los detalles lejanos en la luz. En lugar de párpados están "
"cubiertos por una membrana protectora y translúcida que bloquea irritantes y"
" el agua. ¡Puedes dormir con los ojos abiertos! Puedes hacer que las "
"criaturas hostiles te despierten con el comando Activar."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Gills"
msgstr "Branquias"

#. ~ Description of mutation "Gills"
#: data/json/mutations/mutations.json
msgid ""
"You've grown a set of gills in your neck, allowing you to breathe "
"underwater.  Slightly increases wet benefits."
msgstr ""
"Te han crecido unas branquias en tu cuello, lo que te permite respirar bajo "
"el agua. Incrementa levemente los beneficios de estar mojado."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Cephalopod Gills"
msgstr "Branquias de Cefalópodo"

#. ~ Description of mutation "Cephalopod Gills"
#: data/json/mutations/mutations.json
msgid ""
"You've grown a set of gills, running from your neck up behind your ears.  "
"They allow you to breathe underwater and slightly increase wet benefits."
msgstr ""
"Te han crecido unas branquias a lo largo de tu cuello hasta detras de las "
"orejas. Te permiten respirar abajo del agua y incrementa levemente los "
"beneficios de estar mojado."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Mycus Flesh"
msgstr "Carne de Mycus"

#. ~ Description of mutation "Mycus Flesh"
#: data/json/mutations/mutations.json
msgid ""
"We have begun adapting local physiology to Mycus physical structure, greatly"
" reducing wet effects."
msgstr ""
"Nosotros hemos comenzado a adaptar la fisiología local hacia la estructura "
"física Mycis, reduciendo mucho los efectos de estar mojado."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Mycus Fireproofing"
msgstr "Prot. Al Fuego Mycus"

#. ~ Description of mutation "Mycus Fireproofing"
#: data/json/mutations/mutations.json
msgid ""
"We have spliced the dense, amphibole fibers from Mycus core towers with the "
"resilient, adaptive flesh of local physiology.  This reduces our speed by a "
"moderate amount, but provides powerful armor across our body, nullifies wet "
"effects, and provides complete protection from fire."
msgstr ""
"Hemos fusionado las densas fibras de anfíboles de las torres núcleo de Mycus"
" con la carne resistente y adaptable de la fisiología local. Esto reduce "
"nuestra velocidad en una cantidad moderada, pero proporciona una poderosa "
"armadura a través de nuestro cuerpo, anula los efectos de la humedad y "
"proporciona una completa protección contra el fuego."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Mycogenesis"
msgstr "Mycogenesis"

#. ~ Description of mutation "Mycogenesis"
#: data/json/mutations/mutations.json
msgid ""
"Local physiology has been fully incorporated with that of Mycus silicate "
"fibers.  In addition to benefits conferred by previous developments, we may "
"join with Mycus fibers beneath us - sleeping on top of fungal areas places "
"us into a dormant state, which spreads spores around us as we sleep and "
"revitalizes our body much more quickly than regular sleep."
msgstr ""
"La fisiología local se ha incorporado plenamente a la de las fibras de "
"silicato de Mycus. Además de los beneficios conferidos por los desarrollos "
"anteriores, podemos unirnos con las fibras de Mycus que están debajo de "
"nosotros - dormir encima de las áreas de hongos nos coloca en un estado de "
"latencia, que esparce esporas a nuestro alrededor mientras dormimos y "
"revitaliza nuestro cuerpo mucho más rápido que el sueño regular."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Sparse Scales"
msgstr "escamas escasas"

#. ~ Description of mutation "Sparse Scales"
#: data/json/mutations/mutations.json
msgid ""
"Your skin has toughened and grown thin, flexible scales in some places, "
"acting as natural armor."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Scales"
msgstr "Escamas"

#. ~ Description of mutation "Scales"
#: data/json/mutations/mutations.json
msgid ""
"Your skin has toughened further and your scales have grown to cover most of "
"your body.  Somewhat reduces wet effects."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Thick Scales"
msgstr "Escamas Gruesas"

#. ~ Description of mutation "Thick Scales"
#: data/json/mutations/mutations.json
msgid ""
"Your skin has grown thick and leathery and a set of heavy green scales has "
"grown to cover most of your body, acting as natural armor.  Further, bony "
"scutes cover your extremities, offering additional protection there.  While "
"difficult to penetrate, it also limits your flexibility.  Greatly reduces "
"wet effects."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Sleek Scales"
msgstr "Escamas Lisas"

#. ~ Description of mutation "Sleek Scales"
#: data/json/mutations/mutations.json
msgid ""
"A set of very flexible and slick scales has grown to cover your toughened "
"skin.  These act as decent natural armor, improve your ability to swim, and "
"make you difficult to grab.  Mostly reduces wet effects."
msgstr ""
"Una colección de escamas muy flexibles y lisas han crecido para cubrir tu "
"cuerpo. Estas actúan como una débil armadura natural, mejoran tu habilidad "
"para nadar, y hacen que sea más difícil agarrarte. Reduce mucho los efectos "
"húmedos."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Light Bones"
msgstr "Huesos Livianos"

#. ~ Description of mutation "Light Bones"
#: data/json/mutations/mutations.json
#, no-c-format
msgid ""
"Your bones are very light.  This enables you to move and attack 10% faster, "
"but also reduces your carrying weight by 20% and makes bashing attacks hurt "
"a little more."
msgstr ""
"Tus huesos son muy livianos. Esto te permite moverte y atacar un 10% más "
"rápido, pero también reduce tu capacidad de cargar peso en un 20%, y hace "
"que los ataques contundentes recibidos duelan un poco más."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Feathers"
msgstr "Plumas"

#. ~ Description of mutation "Feathers"
#: data/json/mutations/mutations.json
msgid ""
"Iridescent feathers have grown to cover your entire body, providing a "
"marginal protection against attacks and minor protection from cold.  They "
"also provide a natural waterproofing."
msgstr ""
"Plumas iridiscentes han crecido y cubren tu cuerpo entero, lo que te brinda "
"una protección mínima contra los ataques y un poco de protección al frío. "
"También son un impermeable natural."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Down"
msgstr "Plumones"

#. ~ Description of mutation "Down"
#: data/json/mutations/mutations.json
msgid ""
"You shan't need to migrate south with your layer of down.  It's even better "
"with no apes around to kill you for it!"
msgstr ""
"No vas a necesitar migrar al sur con tu capa de plumas. Y ¡no hay simios por"
" ahí tratando de matarte por ella!"

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Lightly Furred"
msgstr "Pelaje Ligero"

#. ~ Description of mutation "Lightly Furred"
#: data/json/mutations/mutations.json
msgid ""
"Light fur has grown to cover your entire body, providing marginal protection"
" against attacks and slight protection from cold."
msgstr ""
"Te ha crecido pelo fino que cubre todo tu cuerpo, lo que te brinda una "
"mínima protección contra los ataques y una protección leve contra el frío."

#. ~ Mutation name
#: data/json/mutations/mutations.json
#: data/mods/Aftershock/mutations/obsolete.json
msgid "Furry"
msgstr "Peluche"

#. ~ Description of mutation "Furry"
#: data/json/mutations/mutations.json
msgid ""
"Thick black fur has grown to cover your entire body, providing minor "
"protection against attacks, and considerable protection from cold."
msgstr ""
"Te ha crecido pelo negro y grueso que cubre todo tu cuerpo, lo que te brinda"
" una mínima protección contra los ataques y una protección considerable "
"contra el frío."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Shaggy Fur"
msgstr "Pelaje Largo"

#. ~ Description of mutation "Shaggy Fur"
#. ~ Description of mutation "Wooly Fur"
#: data/json/mutations/mutations.json
#: data/mods/Aftershock/mutations/mutations.json
msgid ""
"Your fur has grown out and thickened, providing great protection from "
"attacks as well as considerable insulation."
msgstr ""
"Tu pelaje ha crecido y se ha endurecido, lo que te brinda una gran "
"protección contra los ataques, así como también un aislamiento térmico "
"considerable."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Scruffy Fur"
msgstr ""

#. ~ Description of mutation "Scruffy Fur"
#: data/json/mutations/mutations.json
msgid ""
"You've lost your fluffy undercoat for the summer.  This feels a lot better "
"in the heat, but it's less protective and looks a little bedraggled."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Gray Fur"
msgstr "Pelaje Gris"

#. ~ Description of mutation "Gray Fur"
#: data/json/mutations/mutations.json
msgid ""
"Dense gray fur has grown to cover your entire body, providing noticeable "
"protection against attacks, and considerable protection from cold."
msgstr ""
"Un pelaje denso y gris te ha crecido y cubre todo tu cuerpo, lo que te "
"brinda una notable protección contra los ataques y una protección "
"considerable contra el frío."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Summer Coat"
msgstr ""

#. ~ Description of mutation "Summer Coat"
#: data/json/mutations/mutations.json
msgid ""
"Your entire body is covered in dense fur, but it's thinned out a bit for the"
" summer, which may provide some relief from the heat at the cost of physical"
" protection."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Sleek Fur"
msgstr "Pelaje Liso"

#. ~ Description of mutation "Sleek Fur"
#: data/json/mutations/mutations.json
msgid ""
"You've grown sleek fur, providing minor protection against attacks, and some"
" protection from cold."
msgstr ""
"Te creció un pelaje liso que te brinda una leve protección contra los "
"ataques y algo de protección contra el frío."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Lynx Fur"
msgstr "Pelaje de Lince"

#. ~ Description of mutation "Lynx Fur"
#: data/json/mutations/mutations.json
msgid ""
"Your fur has grown out significantly around your cheeks and neck, providing "
"excellent protection from attacks."
msgstr ""
"Tu pelaje ha crecido mucho en tus cachetes y tu cuello, lo que te brinda una"
" protección excelente contra ataques."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Jumbled Skin"
msgstr "Piel Revuelta"

#. ~ Description of mutation "Jumbled Skin"
#: data/json/mutations/mutations.json
msgid "Your skin has mutated into an amalgamation of fur and scales."
msgstr "Su piel ha mutado en una amalgama de pelaje y escamas."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Patchwork Skin"
msgstr "Piel de Parche"

#. ~ Description of mutation "Patchwork Skin"
#: data/json/mutations/mutations.json
msgid ""
"Your skin has mutated into an amalgamation of thickened fur, scales, and "
"more."
msgstr ""
"Tu piel ha mutado hasta convertirse en una amalgama de pelaje grueso, "
"escamas y otras cosas."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Patchwork Armor"
msgstr "Armadura de Retazos"

#. ~ Description of mutation "Patchwork Armor"
#: data/json/mutations/mutations.json
msgid ""
"Your skin has warped into a highly protective but inconsistent medley of "
"chitin, scales, fur, bone, and even something close to Kevlar."
msgstr ""
"Tu piel se ha convertido en una mezcla muy protectora pero inconsistente de "
"quitina, escamas, pelaje, hueso e incluso algo parecido al Kevlar."

#. ~ Description of mutation "Epicuticle"
#: data/json/mutations/mutations.json
msgid ""
"Your epidermis has turned into a thin, flexible layer of chitin.  It "
"provides decent physical protection.  Slightly reduces wet effects."
msgstr ""
"Tu epidermis se ha convertido en una capa de quitina delgada y flexible. Te "
"brinda una protección física decente. Y reduce un poco los efectos de estar "
"mojado."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Epicuticle (Molted)"
msgstr ""

#. ~ Description of mutation "Epicuticle (Molted)"
#: data/json/mutations/mutations.json
msgid ""
"Your epidermis has turned into a thin, flexible layer of chitin.  Newly "
"molted, it feels a little tender, but it's still tough and leathery."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Chitin Carapace"
msgstr "Caparazón de Quitina"

#. ~ Description of mutation "Chitin Carapace"
#: data/json/mutations/mutations.json
msgid ""
"You've grown a chitin exoskeleton, much like that of an insect.  It provides"
" considerable physical protection, and make your punches hit a little "
"harder.  Somewhat reduces wet effects."
msgstr ""
"Te ha crecido un exoesqueleto de quitina, muy parecido al de un insecto. Te "
"brinda una protección física considerable y hace que tus puños sean un poco "
"más duros. Reduce un poco los efectos de estar húmedo."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Chitin Carapace (Molted)"
msgstr ""

#. ~ Description of mutation "Chitin Carapace (Molted)"
#: data/json/mutations/mutations.json
msgid ""
"You've recently molted, and your chitin exoskeleton is still soft and "
"vulnerable."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Sclerotin Plate"
msgstr "Placa de Esclerotina"

#. ~ Description of mutation "Sclerotin Plate"
#: data/json/mutations/mutations.json
msgid ""
"You've grown a sclerotin exoskeleton, akin to an organic suit of platemail."
"  It provides excellent physical protection and makes your punches hit "
"harder, but reduces your Dexterity by 1 and encumbers all body parts but "
"your eyes and mouth.  Greatly reduces wet effects."
msgstr ""
"Te ha crecido un exoesqueleto de esclerotina que es similar a un trajo "
"orgánico de placas. Te brinda una excelente protección física y hace tus "
"golpes más fuertes pero reduce tu Destreza en 1 punto, y aumenta la "
"incomodidad en todas las partes de tu cuerpo, excepto los ojos y la boca. "
"Reduce mucho los efectos de estar húmedo."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Sclerotin Plate (Molted)"
msgstr ""

#. ~ Description of mutation "Sclerotin Plate (Molted)"
#: data/json/mutations/mutations.json
msgid ""
"Your exoskeleton bears thick plates of chitin which have not fully "
"sclerotized.  They won't provide good protection until they've had time to "
"harden."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Crustacean Carapace"
msgstr ""

#. ~ Description of mutation "Crustacean Carapace"
#: data/json/mutations/mutations.json
msgid ""
"Your body is covered with a thick, near impenetrable, vividly-colored "
"carapace.  It provides unmatched physical protection and even some "
"protection from corrosive chemicals, but reduces your dexterity by 2 and "
"encumbers all body parts except your eyes.  Greatly reduces wet effects."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Crustacean Carapace (Molted)"
msgstr ""

#. ~ Description of mutation "Crustacean Carapace (Molted)"
#: data/json/mutations/mutations.json
msgid ""
"You're covered in a great chitin carapace which reduces your Dexterity by 1,"
" however it has recently molted and will offer poor protection until it has "
"time to harden.  Greatly reduces wet effects."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Hairy Chitin"
msgstr "Quitina con Pelaje"

#. ~ Description of mutation "Hairy Chitin"
#: data/json/mutations/mutations.json
msgid ""
"You've developed some sort of hair growing out of your chitin.  It's a bit "
"warmer than not having hair."
msgstr ""
"Has desarrollado una especie de pelo que crece sobre tu quitina. Es un poco "
"más caliente que no tener pelo."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Furred Chitin"
msgstr "Quitina Peluda"

#. ~ Description of mutation "Furred Chitin"
#: data/json/mutations/mutations.json
msgid ""
"Your chitin hair has thickened and spread across your body.  It provides "
"minor warmth and helps you sense nearby vibrations."
msgstr ""
"El pelo que crece de tu capa de quitina se ha engrosado y extendido por todo"
" tu cuerpo. Te brinda un poco de abrigo y te ayuda a percibir vibraciones "
"cercanas."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Furred Plate"
msgstr "Coraza Peluda"

#. ~ Description of mutation "Furred Plate"
#: data/json/mutations/mutations.json
msgid ""
"Your thick exoskeleton boasts a fine coat of hairs that put feline whiskers "
"to shame."
msgstr ""
"Tu grueso exoesqueleto posee una fina cobertura de pelos que serían la "
"envidia de los bigotes felinos."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Urticating Hairs"
msgstr "Pelos Urticantes"

#. ~ Description of mutation "Urticating Hairs"
#: data/json/mutations/mutations.json
msgid ""
"Significant amounts of your hairs have loosened.  If some creature tries to "
"attack you, your assailant is quite likely to get fine, bristly chitin in an"
" irritating spot; it doesn't carry your venom but it will be distracting."
msgstr ""
"Cantidades significativas de pelo se te han aflojado. Si alguna criatura "
"intenta atacarte, es bastante probable que tu agresor reciba una buena "
"quitina rasposa en un lugar molesto. No tiene tu veneno pero es una buena "
"distracción."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Giant Pincer"
msgstr ""

#. ~ Description of mutation "Giant Pincer"
#: data/json/mutations/mutations.json
msgid ""
"Instead of your right hand, you now have a giant claw resembling ones found "
"on crabs.  It encumbers you greatly, but you can use it in melee combat to "
"deal massive damage."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Spines"
msgstr "Pinchos"

#. ~ Description of mutation "Spines"
#: data/json/mutations/mutations.json
msgid ""
"Your skin is covered with fine spines.  Whenever an unarmed opponent strikes"
" a part of your body that is not covered by clothing, they will receive "
"moderate damage."
msgstr ""
"Tu piel está cubierta con pinchos finos. Cada vez que un oponente desarmado "
"golpea una parte de tu cuerpo que no está cubierta, va a recibir un daño "
"moderado."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Quills"
msgstr "Púas"

#. ~ Description of mutation "Quills"
#: data/json/mutations/mutations.json
msgid ""
"Your body is covered with large quills.  Whenever an unarmed opponent "
"strikes a part of your body that is not covered by clothing, they will "
"receive significant damage."
msgstr ""
"Tu cuerpo está cubierto con grandes púas. Cada vez que un oponente desarmado"
" golpea una parte de tu cuerpo que no está cubierta, va a recibir un daño "
"significativo."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Assault Barbs"
msgstr "Púas de Asalto"

#. ~ Description of mutation "Assault Barbs"
#: data/json/mutations/mutations.json
msgid ""
"Some of the quills on your arms have become quite loose.  By flinging your "
"arms, you can fire off these quills as projectiles."
msgstr ""
"Algunas de las púas de kus brazos se han vuelto bastante sueltas. Al lanzar "
"kus brazos, puede disparar estas púas como proyectiles."

#. ~ Message when firing ranged attack with mutation "Assault Barbs"
#: data/json/mutations/mutations.json
msgid "You fire off some of your quills."
msgstr "Disparas algunas de tus puas."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Phelloderm"
msgstr "Felodermis"

#. ~ Description of mutation "Phelloderm"
#: data/json/mutations/mutations.json
msgid ""
"Your skin is light green and has a slightly woody quality to it.  This "
"provides armor and helps you retain moisture, resulting in less thirst.  "
"Greatly decreases wet penalties."
msgstr ""
"Tu piel está ligeramente verdosa y tiene una pequeña similitud con la "
"madera. Esto te brinda armadura y te ayuda a mantener la humedad, lo que "
"significa tener menos sed. Disminuye mucho los problemas por estar húmedo."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Protective Bark"
msgstr "Corteza Protectora"

#. ~ Description of mutation "Protective Bark"
#: data/json/mutations/mutations.json
msgid ""
"Your skin is coated in a light bark, like that of a tree.  This provides "
"powerful armor and makes you nearly waterproof."
msgstr ""
"Tu piel está cubierta por una fina corteza como la de un árbol. Esto te "
"brinda una poderosa armadura y te hace casi impermeable."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Shifting Bark (Distributed)"
msgstr "Corteza Cambiante (Distribuida)"

#. ~ Description of mutation "Shifting Bark (Distributed)"
#: data/json/mutations/mutations.json
msgid ""
"Your warped bark can be shifted in function, and is currently spread evenly."
"  Activate to better protect your torso, at the cost of other areas."
msgstr ""
"Tu corteza retorcida puede cambiar de función y en este momento está "
"distribuida de manera equitativa. Puedes proteger mejor el torso con el "
"comando Activar, lo que descubre otras áreas."

#. ~ Message when transforming from mutation  "Shifting Bark (Distributed)" to
#. "BARK2_b"
#. ~ Message when transforming from mutation  "Shifting Bark (Consolidated)"
#. to "BARK2_c"
#. ~ Message when transforming from mutation  "Shifting Bark (Latticed)" to
#. "BARK2_a"
#: data/json/mutations/mutations.json
msgid "Your bark ripples across your body, repositioning at a cellular level."
msgstr "Tu corteza ondea por tu cuerpo reposicionándose a nivel celular."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Shifting Bark (Consolidated)"
msgstr "Corteza Cambiante (Consolidada)"

#. ~ Description of mutation "Shifting Bark (Consolidated)"
#: data/json/mutations/mutations.json
msgid ""
"Your warped bark can be shifted in function, and is currently consolidated "
"on your torso.  Activate to shift your bark into a lattice, increasing bulk "
"but providing better protection for the entire body."
msgstr ""
"Tu corteza retorcida puede cambiar de función y en este momento está "
"consolidada en tu torso. Puedes cambiarla para formar un entramado con el "
"comando Activar, incrementando el volumen pero brindando mejor protección al"
" cuerpo entero."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Shifting Bark (Latticed)"
msgstr "Corteza Cambiante (Entramado)"

#. ~ Description of mutation "Shifting Bark (Latticed)"
#: data/json/mutations/mutations.json
msgid ""
"Your warped bark can be shifted in function, and is currently expanded into "
"a sturdy lattice.  Activate to collapse the lattice, returning to an evenly "
"distributed form."
msgstr ""
"Tu corteza retorcida puede cambiar de función y en este momento está "
"expandida en forma de entramado resistente. Puedes colapsar el entramado con"
" el comando Activar, haciendo que vuelva a una forma distribuida de manera "
"más pareja."

#. ~ Mutation name
#. ~ Name of effect type id "effect_goblin_fruit_thorns"
#: data/json/mutations/mutations.json
#: data/mods/Xedra_Evolved/effects/goblin_fruit_effects.json
msgid "Thorns"
msgstr "Espinas"

#. ~ Description of mutation "Thorns"
#: data/json/mutations/mutations.json
msgid ""
"Your skin is covered in small, woody thorns.  Whenever an unarmed opponent "
"strikes a part of your body that is not covered by clothing, they will "
"receive minor damage.  Your punches may also deal extra damage."
msgstr ""
"Tu piel está cubierta con pequeñas espinas de madera. Cada vez que un "
"oponente desarmado golpea una parte de tu cuerpo que no está cubierta, va a "
"recibir un daño menor. Tus puños también causan daño extra."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Leaves"
msgstr "Hojas"

#. ~ Description of mutation "Leaves"
#: data/json/mutations/mutations.json
msgid ""
"All the hair on your body has turned to long, grass-like leaves.  Apart from"
" being physically striking, these provide you with a minor amount of "
"nutrients while in sunlight when your head is uncovered.  Slightly reduces "
"wet effects."
msgstr ""
"Todo el pelo de tu cuerpo se ha convertido en unas hojas largas como la "
"hierba. Además de ser llamativo, te brinda una pequeña cantidad de "
"nutrientes al estar tu cabeza descubierta al sol . Reduce ligeramente los "
"efectos de estar mojado."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Dead Leaves"
msgstr ""

#. ~ Description of mutation "Dead Leaves"
#: data/json/mutations/mutations.json
msgid ""
"In place of hair, you have long, grassy leaves which have gone dormant for "
"the winter, turning dry and yellow like straw.  They help keep you warm, but"
" that's about it."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Lush Leaves"
msgstr "Hojas Exuberantes"

#. ~ Description of mutation "Lush Leaves"
#: data/json/mutations/mutations.json
msgid ""
"Your leaves have grown in size and prominence, with additional leaves "
"sprouting along your arms.  While your arms and head are uncovered, you will"
" photosynthesize nutrients while in sunlight.  Reduces wet effects."
msgstr ""
"Sus hojas han crecido en tamaño y presencia, con hojas adicionales que "
"brotan a lo largo de tus brazos. Mientras tus brazos y tu cabeza estén "
"descubiertos bajo la luz del sol, realizarás la fotosíntesisl. Reduce los "
"efectos de estar mojado."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Turning Leaves"
msgstr ""

#. ~ Description of mutation "Turning Leaves"
#: data/json/mutations/mutations.json
msgid ""
"The leaves growing from your head and arms have taken on fall colors.  While"
" pretty, they can't photosynthesize as well as the green ones.  Reduces wet "
"effects."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Dead Lush Leaves"
msgstr ""

#. ~ Description of mutation "Dead Lush Leaves"
#: data/json/mutations/mutations.json
msgid ""
"You have no leaves because it's wintertime.  This keeps you warm by reducing"
" heat loss, but you don't know that because you shouldn't be able to see "
"this."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Verdant Leaves"
msgstr "Hojas Verdosas"

#. ~ Description of mutation "Verdant Leaves"
#: data/json/mutations/mutations.json
msgid ""
"Your leaves are vibrant, large, and green, and have become a major source of"
" nutrients for your body.  Whenever your arms and head are uncovered you "
"will gain a large amount of nutrients by standing in the sunlight.  Reduces "
"wet effects."
msgstr ""
"Sus hojas son llamativas, grandes y verdes, y se han convertido en una "
"importante fuente de nutrientes para tu cuerpo. Al estar bajo la luz del sol"
" y cuando tengas los brazos y la cabeza descubiertos ganarás una gran "
"cantidad de nutrientes. Reduce los efectos de estar mojado."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Autumn Foliage"
msgstr ""

#. ~ Description of mutation "Autumn Foliage"
#: data/json/mutations/mutations.json
msgid ""
"Your head and upper limbs are covered in beautiful autumn leaves.  If "
"they're uncovered you'll still be able to photosynthesize, but not as well "
"as in the warmer months.  Reduces wet effects."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Dead Verdant Leaves"
msgstr ""

#. ~ Description of mutation "Dead Verdant Leaves"
#: data/json/mutations/mutations.json
msgid ""
"It's winter, so all your leaves are gone.  This keeps you warm by reducing "
"heat loss, but you don't know that because you shouldn't be able to see "
"this."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Transpiration"
msgstr "Transpiración"

#. ~ Description of mutation "Transpiration"
#: data/json/mutations/mutations.json
msgid ""
"You body has begun moving nutrients via the evaporation of water.  This "
"increases your thirst when it's hot, but reduces it when it's cold."
msgstr ""
"Tu cuerpo ha comenzado a mover los nutrientes a través de la evaporación del"
" agua. Esto aumenta la sed cuando hace calor, pero la reduce cuando hace "
"frío."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Flowering"
msgstr "Floreciente"

#. ~ Description of mutation "Flowering"
#: data/json/mutations/mutations.json
msgid ""
"You've started blooming where your scalp used to be.  Your blossoms have a "
"pleasant aroma, are visually striking, and are quite sensitive."
msgstr ""
"Te han empezado a crecer flores donde antes estaba tu cuero cabelludo.. Tus "
"flores tienen un aroma agradable, son llamativas y bastante sensitivas."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Dead Flowers"
msgstr ""

#. ~ Description of mutation "Dead Flowers"
#. ~ Description of mutation "Dead Roses"
#: data/json/mutations/mutations.json
msgid ""
"No flowers in wintertime.  As such this mutation is not supposed to be "
"visible to the player."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Rosebuds"
msgstr "Capullo de rosa"

#. ~ Description of mutation "Rosebuds"
#: data/json/mutations/mutations.json
msgid ""
"The top of your head is blooming with rosebuds.  They're eye catching, and "
"have a mild fragrance that makes you pleasant to be around."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Blooming Roses"
msgstr ""

#. ~ Description of mutation "Blooming Roses"
#: data/json/mutations/mutations.json
msgid ""
"Your head is crowned with radiant flowers that spread their petals wide.  "
"The dizzying fragrance attracts people and pollinators alike."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Fruiting"
msgstr ""

#. ~ Description of mutation "Fruiting"
#: data/json/mutations/mutations.json
msgid ""
"A few odd-looking fruits ripen on stems growing out of your head.  They'll "
"probably die off come winter, but you could activate this mutation to pick "
"them before then, if you wanted."
msgstr ""

#. ~ Message when transforming from mutation  "Fruiting" to
#. "ROSEBUDS_FALL_active"
#: data/json/mutations/mutations.json
msgid ""
"Most of the fruits are beyond consideration, but you pick what you can and "
"discard the rest."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Fruiting (picked)"
msgstr ""

#. ~ Description of mutation "Fruiting (picked)"
#: data/json/mutations/mutations.json
msgid "You shouldn't be able to see this, it's just used to proc the EOC."
msgstr ""

#. ~ Description of mutation "Fruiting (picked)"
#: data/json/mutations/mutations.json
msgid ""
"You've picked all your fruit and no longer have any, as such this mutation "
"is not supposed to be visible."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Dead Roses"
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Mycus Spores"
msgstr "Esporas de Mycus"

#. ~ Description of mutation "Mycus Spores"
#: data/json/mutations/mutations.json
msgid "We have developed local spore sacs.  The Mycus must grow."
msgstr ""
"Nosotros hemos desarrollado sacos locales de esporas. El Mycus debe crecer."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Mycus Sporogenesis"
msgstr "Esporogénesis de Mycus"

#. ~ Description of mutation "Mycus Sporogenesis"
#: data/json/mutations/mutations.json
msgid ""
"Local organisms seem to regard overt spore dispersal as a danger, and attack"
" the Mycus.  Accordingly, our local spore sacs remain quiescent, until local"
" guidance determines that it is safe to germinate.  Rapid development taxes "
"local nutrient reserves but ensures swift and effective growth."
msgstr ""
"Los organismos locales parecen considerar la dispersión abiertas de esporas "
"como un peligro, y atacan al Mycus. En consecuencia, nuestros sacos de "
"esporas locales permanecen quietos, hasta que la orientación local determine"
" que es seguro germinar. El rápido desarrollo exprime las reservas de "
"nutrientes locales pero asegura un crecimiento rápido y efectivo."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Mycus Blossoms"
msgstr "Capullos de Mycus"

#. ~ Description of mutation "Mycus Blossoms"
#: data/json/mutations/mutations.json
msgid "We have developed local blossoms.  The Mycus must grow."
msgstr "Nosotros hemos desarrollado capullos locales. El Mycus debe crecer."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Mycus Bloom"
msgstr "Floración de Mycus"

#. ~ Description of mutation "Mycus Bloom"
#: data/json/mutations/mutations.json
msgid ""
"Local organisms seem to regard overt spore dispersal as a danger, and attack"
" the Mycus.  Accordingly, our local blossoms remain quiescent, until local "
"guidance determines that it is safe to germinate.  Rapid development taxes "
"local nutrient reserves but ensures swift and effective growth."
msgstr ""
"Los organismos locales parecen considerar la dispersión abiertas de esporas "
"como un peligro, y atacan al Mycus. En consecuencia, nuestros capullos "
"locales permanecen quietos, hasta que la orientación local determine que es "
"seguro germinar. El rápido desarrollo exprime las reservas de nutrientes "
"locales pero asegura un crecimiento rápido y efectivo."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Mycus Provenance"
msgstr "Procedencia de Mycus"

#. ~ Description of mutation "Mycus Provenance"
#: data/json/mutations/mutations.json
msgid ""
"Local spore sacs and blossoms have merged into a single, symbiotic form.  "
"Acting as one, they germinate together to cement rapid growth across a large"
" area according to local guidance.  The Mycus must grow."
msgstr ""
"Los sacos de esporas locales y las flores se han fusionado en una única "
"forma simbiótica. Actuando como uno solo, germinan juntos para cimentar un "
"rápido crecimiento en una gran área de acuerdo con la orientación local. El "
"Mycus debe crecer."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Long Fingernails"
msgstr "Uñas Largas"

#. ~ Description of mutation "Long Fingernails"
#: data/json/mutations/mutations.json
msgid ""
"Your fingernails are long and sharp.  If you aren't wearing gloves, your "
"unarmed attacks deal a minor amount of cutting damage."
msgstr ""
"Tus uñas son largas y afiladas. Si no tienes puestos guantes, tus ataques "
"desarmados causan un daño cortante menor."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Claws"
msgstr "Garras"

#. ~ Description of mutation "Claws"
#: data/json/mutations/mutations.json
msgid ""
"You have claws on the ends of your fingers.  If you aren't wearing gloves, "
"your unarmed attacks deal a minor amount of cutting damage."
msgstr ""
"Tienes garras en la punta de tus dedos. Si no tienes puestos guantes, tus "
"ataques desarmados causan un daño cortante menor."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Gnarled Claws"
msgstr ""

#. ~ Description of mutation "Gnarled Claws"
#: data/json/mutations/mutations.json
msgid "Your claws have grown tougher and slightly gnarled."
msgstr "Tus garras han crecido y son más duras y un poco retorcidas."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Stainless Claws"
msgstr "Garras Inoxidables"

#. ~ Description of mutation "Stainless Claws"
#: data/json/mutations/mutations.json
msgid ""
"Your paws are bone, muscle, and claw with a thin layer of skin and fur.  "
"They might as well be made of stainless steel."
msgstr ""
"Tus patas están hechas de hueso, músculo y garras con una pequeña capa de "
"piel y pelo. Como si fueran de acero inoxidable."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Retractable Claws"
msgstr "Garras Retraíbles"

#. ~ Description of mutation "Retractable Claws"
#: data/json/mutations/mutations.json
msgid ""
"You have claws on the ends of your fingers, and can extend or retract them "
"as desired.  Gloves will still get in the way, though."
msgstr ""
"Tienes garras en la punta de tus dedos, y las puedes extender o retraer "
"cuando quieras. Igual, los guantes van a ser un obstáculo."

#. ~ Message when transforming from mutation  "Retractable Claws" to
#. "CLAWS_RETRACT_active"
#: data/json/mutations/mutations.json
msgid "You extend your claws."
msgstr "Extiendes tus garras."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Extended Claws"
msgstr "Garras Extendidas"

#. ~ Description of mutation "Extended Claws"
#: data/json/mutations/mutations.json
msgid "Sharp claws are extending from the end of your fingers."
msgstr "Unas afiladas garras se extienden desde el extremo de  tus dedos."

#. ~ Message when transforming from mutation  "Extended Claws" to
#. "CLAWS_RETRACT"
#: data/json/mutations/mutations.json
msgid "You retract your claws."
msgstr "Retraes tus garras."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Tentacle Rakes"
msgstr "Tentáculos Rastrillo"

#. ~ Description of mutation "Tentacle Rakes"
#: data/json/mutations/mutations.json
msgid ""
"Your upper tentacles have grown large, hook-barbed rakes on the ends.  "
"They're quite vicious, but really aren't suited for fine manipulation."
msgstr ""
"Tus tentáculos superiores han desarrollado en la punta, rastrillos con "
"ganchos al final. Parecen bastante feroces, pero no son adecuados para "
"manipular objetos delicados."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Ink Glands"
msgstr "Glándulas de tinta"

#. ~ Description of mutation "Ink Glands"
#: data/json/mutations/mutations.json
msgid ""
"Several ink glands have developed in your gill structure.  When active, they"
" will spray defensive ink and blind an attacker in an emergency."
msgstr ""

#. ~ Description of mutation "Slime Spray"
#: data/json/mutations/mutations.json
msgid ""
"You exude slime from your pores.  You can spread that slime on an opponent "
"in melee range."
msgstr ""
"Exudas baba por tus poros. Puedes esparcir esa baba sobre un oponente a "
"distancia de c. a c."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Bulging Reservoir"
msgstr "Depósito abultado"

#. ~ Description of mutation "Bulging Reservoir"
#: data/json/mutations/mutations.json
msgid ""
"You develop a reservoir of fluids that bulges out of your abdomen.  Your "
"body has adapted to containing extra liquids in event of shortfalls."
msgstr ""
"Desarrollas una reserva de fluidos que sobresale de tu abdomen. Tu cuerpo se"
" ha adaptado a contener líquidos adicionales en caso de escasez."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Bombardier Beetle Blast"
msgstr ""

#. ~ Description of mutation "Bombardier Beetle Blast"
#: data/json/mutations/mutations.json
msgid ""
"You have an ability to spray boiling water on your enemies at melee "
"distance.  This will drastically increase your thirst.  Without an extra "
"reservoir you would quickly dehydrate yourself."
msgstr ""
"Tienes una habilidad de rociar agua hirviendo a tus enemigos a c. a c. Esto "
"aumentará drásticamente tu sed. Sin un depósito adicional, te deshidratarías"
" rápidamente."

#. ~ Message when player with mutation "Bombardier Beetle Blast" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "You spray %s with a boiling chemical mixture!"
msgstr ""

#. ~ Message when NPC with mutation "Bombardier Beetle Blast" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "%1$s sprays %2$s with a boiling chemical mixture!"
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Large Talons"
msgstr "Zarpas Grandes"

#. ~ Description of mutation "Large Talons"
#. ~ Description of mutation "Demon Claws"
#: data/json/mutations/mutations.json
#: data/mods/Magiclysm/traits/temporary_demon_traits.json
msgid ""
"Your index fingers have grown into huge talons.  After a bit of practice, "
"you find that this does not affect your dexterity, but allows for a deadly "
"unarmed attack.  They also prevent wearing gloves."
msgstr ""
"Tus dedos índices se han convertido en enormes garras. Después de un poco de"
" práctica, te das cuenta de que esto no afecta tu destreza, pero permite un "
"ataque mortal sin armas. También impide el uso de guantes."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Radiogenic"
msgstr "Radiogénico"

#. ~ Description of mutation "Radiogenic"
#: data/json/mutations/mutations.json
msgid ""
"Your system has adapted to radiation.  While irradiated, you will actually "
"heal slowly, converting the radiation into hit points."
msgstr ""
"Tu sistema se ha adaptado a la radiación. Mientras estás irradiado, sanarás "
"lentamente convirtiendo la radiación en puntos de golpe."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Radiophile"
msgstr ""

#. ~ Description of mutation "Radiophile"
#: data/json/mutations/mutations.json
msgid ""
"Your flesh has developed a unique reaction to radiation that lets you sense "
"when ambient radiation is abnormally high.  Turn off to ignore messages."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Marloss Carrier"
msgstr "Portador de Marloss"

#. ~ Description of mutation "Marloss Carrier"
#: data/json/mutations/mutations.json
msgid ""
"Ever since you ate that Marloss berry, you can't get its scent out of your "
"nose, and you have a strong desire to try some seeds and… sap?"
msgstr ""
"Desde que te comiste esa baya Marloss, no puedes sacar su aroma de tu nariz,"
" y tienes un fuerte deseo de probar algunas semillas y... ¿savia?"

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Marloss Vessel"
msgstr "Receptáculo Marloss"

#. ~ Description of mutation "Marloss Vessel"
#: data/json/mutations/mutations.json
msgid ""
"Ever since you ate that Marloss seed, you can't get its taste off of your "
"tongue, and you have a strong desire to try some berries and… sap?"
msgstr ""
"Desde que te comiste esa semilla de Marloss, no puedes quitarte su sabor de "
"tu lengua, y tienes un fuerte deseo de probar algunas bayas y... savia?"

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Marloss Vector"
msgstr "Vector Marloss"

#. ~ Description of mutation "Marloss Vector"
#: data/json/mutations/mutations.json
msgid ""
"Ever since you ate that Marloss jelly, you can't stop thinking of it, and "
"you have a strong desire to eat some seeds and berries."
msgstr ""
"Desde que comiste esa gelatina  Marloss, no puedes dejar de pensar en ella, "
"y tienes un fuerte deseo de comer semillas y bayas Marloss."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Marloss Rejection"
msgstr "Rechazo de Marloss"

#. ~ Description of mutation "Marloss Rejection"
#: data/json/mutations/mutations.json
msgid ""
"Ever since you had that life-threatening reaction to that Marloss junk, you "
"can't bear the thought of ever eating it again!"
msgstr ""
"Desde que tuviste esa reacción casi mortal a esa porquería Marloss, ¡no "
"puedes soportar tan siquiera el pensamiento de intentar comerlo de nuevo!"

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Mutagenic Aversion"
msgstr "Aversión al Mutágeno"

#. ~ Description of mutation "Mutagenic Aversion"
#: data/json/mutations/mutations.json
msgid ""
"Ever since you had that life-threatening reaction to those mutagen and "
"purifier things, you can't bear the thought of ever using them again!"
msgstr ""
"Desde que tuviste la reacción casi mortal a esos mutágenos y purificadores, "
"¡no puedes siquiera soportar el pensamiento de volver a utilizarlos!"

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Insect Pheromones"
msgstr "Feromonas de Insecto"

#. ~ Description of mutation "Insect Pheromones"
#: data/json/mutations/mutations.json
msgid ""
"Your body produces low-level pheromones, identifying you as a friend to many"
" species of insects.  Insects will attack you much less."
msgstr ""
"Tu cuerpo produce feromonas de bajo nivel, lo que te identifica como amigo "
"de varias especies de insectos. Los insectos te atacarán mucho menos que "
"antes."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Amphibian Pheromones"
msgstr "Feromonas Amfibias"

#. ~ Description of mutation "Amphibian Pheromones"
#: data/json/mutations/mutations.json
msgid ""
"Your body produces low-level pheromones, identifying you as a friend to many"
" species of amphibian.  Amphibians will attack you much less."
msgstr ""
"Tu cuerpo produce feromonas de bajo nivel, que te identifican como amigo "
"para muchas especies de anfibios. Los anfibios te atacarán mucho menos."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Mammal Pheromones"
msgstr "Feromonas de Mamífero"

#. ~ Description of mutation "Mammal Pheromones"
#: data/json/mutations/mutations.json
msgid ""
"Your body produces low-level pheromones which put mammals at ease.  They "
"will be less likely to attack or flee from you."
msgstr ""
"Tu cuerpo produce feromonas de bajo nivel, lo que tranquiliza a los "
"mamíferos. Estos serán menos propensos a atacarte o a huir de ti."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Disease Immune"
msgstr "Inmune a la Enfermedad"

#. ~ Description of mutation "Disease Immune"
#: data/json/mutations/mutations.json
msgid ""
"Your body is simply immune to diseases.  You will never catch an ambient "
"disease."
msgstr ""
"Tu cuerpo es inmune a las enfermedades. Nunca tendrás una enfermedad "
"ambiental."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Infection Resistant"
msgstr "Resistente a las Infecciones"

#. ~ Description of mutation "Infection Resistant"
#: data/json/mutations/mutations.json
msgid ""
"Your immune system is particularly good at resisting infections.  You have "
"an increased chance for bad wounds and infections to heal on their own, and "
"only suffer reduced penalties from them."
msgstr ""
"Tu sistema inmunológico es particularmente bueno resistiendo infecciones. "
"Tienes mayor probabilidad de que las heridas graves y las infecciones se "
"curen solas, y solo sufres penalidades menores a causa de ellas."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Infection Immune"
msgstr "Inmune a la Infección"

#. ~ Description of mutation "Infection Immune"
#: data/json/mutations/mutations.json
msgid ""
"Your bloodstream has developed antibiotic properties.  Your wounds will "
"never become infected."
msgstr ""
"Tu torrente sanguíneo ha desarrollado propiedades antibióticas. Tus heridas "
"nunca se infectarán."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Seasonal Allergies"
msgstr ""

#. ~ Description of mutation "Seasonal Allergies"
#: data/json/mutations/mutations.json
msgid ""
"You tend to get hay fever, especially in springtime.  Antihistamines are "
"your friend."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Mycus Identity"
msgstr "Identidad Mycus"

#. ~ Description of mutation "Mycus Identity"
#: data/json/mutations/mutations.json
msgid ""
"We have synchronized our local physiology with that of the Mycus.  Any "
"spores we may encounter will not attempt to germinate inside the local "
"system, and we may traverse Mycus biospheres easily, as native bioforms "
"shift shape to accommodate us."
msgstr ""
"Hemos sincronizado nuestra fisiología local con eso de Mycus. Cualquier "
"espora que encontremos no intentará germinar dentro del sistema local, y "
"podemos atravesar las biosferas de Mycus fácilmente, ya que las bioformas "
"nativas cambian de forma para acomodarse a nosotros."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Parasite Immune"
msgstr "Inmune a los Parásitos"

#. ~ Description of mutation "Parasite Immune"
#: data/json/mutations/mutations.json
msgid ""
"Your body is unusually inhospitable to parasitic lifeforms.  You will never "
"become infested with internal parasites."
msgstr ""
"Tu cuerpo es extrañamente poco hospitalario a las formas de vida "
"parásitarias. Nunca te infectarás con parásitos internos."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Venomous"
msgstr "Veneno"

#. ~ Description of mutation "Venomous"
#: data/json/mutations/mutations.json
msgid ""
"Your body produces a potent venom.  Cutting or stabbing attacks from "
"mutations have a chance to poison your target."
msgstr ""
"Tu cuerpo produce un poderoso veneno. Los ataques cortantes o punzantes de "
"las mutaciones tienen una posibilidad de envenenar a tu oponente."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Strongly Venomous"
msgstr "Veneno Poderoso"

#. ~ Description of mutation "Strongly Venomous"
#: data/json/mutations/mutations.json
msgid ""
"Your venom has become particularly strong.  You're confident that your bites"
" or other cutting/stabbing natural attacks will take your target down "
"quickly."
msgstr ""
"Tu veneno se ha vuelto particularmente fuerte. Tienes confianza en que tus "
"mordeduras u otros ataques naturales cortantes o punzantes matarán a tu "
"oponente rápidamente."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Slime Hands"
msgstr "Manos Babosas"

#. ~ Description of mutation "Slime Hands"
#: data/json/mutations/mutations.json
msgid ""
"The skin on your hands is now a mucous membrane that produces a thick, acrid"
" slime.  Attacks using your hand will cause minor acid damage.  Slightly "
"increases wet benefits."
msgstr ""
"La piel de tus manos es ahora una membrana mucosa que produce una baba "
"espesa y acre. Los ataques usando tus manos causarán daño ácido menor. "
"Incrementa ligeramente los beneficios por estar mojado."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Stretchy Limbs"
msgstr "Miembros Elásticos"

#. ~ Description of mutation "Stretchy Limbs"
#: data/json/mutations/mutations.json
msgid "Your limbs seem to have a little more 'give' to them.  +1 Dexterity."
msgstr "Tus miembros parecen tener un poco más de elasticidad. Destreza +1."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Rubbery Limbs"
msgstr "Miembros de Goma"

#. ~ Description of mutation "Rubbery Limbs"
#: data/json/mutations/mutations.json
msgid ""
"Your limbs are significantly more flexible than any pathetic human arm or "
"leg.  +3 Dexterity, -2 Strength."
msgstr ""
"Tus miembros son significativamente más flexibles que cualquier patético "
"brazo o pierna humanos. Destreza +3 y Fuerza -2."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Pseudolimbs"
msgstr "Pseudomiembros"

#. ~ Description of mutation "Pseudolimbs"
#: data/json/mutations/mutations.json
msgid ""
"Your pseudopod-like limbs can fit into anything!  +4 Dexterity, -4 Strength."
msgstr ""
"¡Tus miembros similares a los de un pseudópodo no se adaptan a nada! "
"Destreza +4 y Fuerza -4."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Muscle Consolidation"
msgstr "Consolidación Muscular"

#. ~ Description of mutation "Muscle Consolidation"
#: data/json/mutations/mutations.json
msgid ""
"Your extremities have gained strength but lost fine motor skills.  -1 "
"Dexterity +2 Strength."
msgstr ""
"Tus extremidades han ganado fuerza pero han perdido la motricidad fina. -1 "
"Destreza +2 Fuerza."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Rasping Tongue"
msgstr "Lengua Rasposa"

#. ~ Description of mutation "Rasping Tongue"
#: data/json/mutations/mutations.json
msgid ""
"You've developed an extremely long and mobile tongue capped with teeth.  You"
" may use it to attack your enemies and pull them towards you."
msgstr ""
"Has desarrollado una lengua extremadamente larga y móvil cubierta de "
"dientes. Puedes usarla para atacar a tus enemigos y atraerlos hacia ti."

#. ~ Message when player with mutation "Rasping Tongue" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "You tear into %s with your rasping tongue!"
msgstr ""

#. ~ Message when NPC with mutation "Rasping Tongue" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "%1$s tears into %2$s with their rasping tongue!"
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Harpoon Tongue"
msgstr "Lengua de Arpón"

#. ~ Description of mutation "Harpoon Tongue"
#: data/json/mutations/mutations.json
msgid ""
"Your tongue has increased its length and mobility.  You may use it to pull "
"your enemies towards you."
msgstr ""
"Tu lengua ha aumentado su longitud y movilidad. Puedes usarla para atraer a "
"tus enemigos hacia ti."

#. ~ Message when player with mutation "Harpoon Tongue" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "You stab into %s with your harpoon tongue!"
msgstr ""

#. ~ Message when NPC with mutation "Harpoon Tongue" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "%1$s stabs into %2$s with their harpoon tongue!"
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Compound Eyes"
msgstr "Ojos Compuestos"

#. ~ Description of mutation "Compound Eyes"
#: data/json/mutations/mutations.json
msgid ""
"Your eyes are compound, like those of an insect.  This increases your "
"Perception by 2 whenever you aren't wearing eyewear."
msgstr ""
"Tus ojos son compuestos, como los de un insecto. Esto aumenta tu percepción "
"en 2 mientras no lleves equipamiento en los ojos."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Padded Feet"
msgstr "Pies Acolchados"

#. ~ Description of mutation "Padded Feet"
#: data/json/mutations/mutations.json
#, no-c-format
msgid ""
"The bottoms of your feet are strongly padded.  You receive no movement "
"penalty for not wearing shoes, and even receive a 10% bonus when moving "
"barefoot.  Also, your steps are significantly quieter, as added tissue "
"dampens the noise."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Strong Legs"
msgstr "Piernas Fuertes"

#. ~ Description of mutation "Strong Legs"
#: data/json/mutations/mutations.json
msgid "Your legs have gained muscle mass to propel you across any terrain."
msgstr ""
"Tus piernas han ganado masa muscular para impulsarte por cualquier terreno."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Digitigrade Legs"
msgstr ""

#. ~ Description of mutation "Digitigrade Legs"
#: data/json/mutations/mutations.json
msgid ""
"The heels of your feet have shifted up off the ground in a rather "
"animalistic fashion, reducing your carry weight limit and preventing you "
"from wearing shoes.  These hind feet are a bad match for human arms, but "
"could pair well with matching forepaws."
msgstr ""

#. ~ Trigger message of mutation "Digitigrade Legs"
#. ~ Trigger message of mutation "Paws"
#. ~ Trigger message of mutation "Broad Paws"
#. ~ Trigger message of mutation "Little Paws"
#: data/json/mutations/mutations.json
msgid "You drop down on all fours."
msgstr ""

#. ~ Trigger message of mutation "Digitigrade Legs"
#. ~ Trigger message of mutation "Paws"
#. ~ Trigger message of mutation "Broad Paws"
#. ~ Trigger message of mutation "Little Paws"
#: data/json/mutations/mutations.json
msgid "You rise up to walk on your hind feet."
msgstr ""

#. ~ Description of mutation "Pounce"
#: data/json/mutations/mutations.json
msgid ""
"You've gained a strong ability to leap a short distance from a standing "
"position with little preparation time."
msgstr ""
"Has adquirido una gran habilidad para saltar una distancia corta desde una "
"posición de pie con poco tiempo de preparación."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Leaping Legs"
msgstr "Piernas de Salto"

#. ~ Description of mutation "Leaping Legs"
#: data/json/mutations/mutations.json
msgid "You've gained a strong ability to leap from a standing position."
msgstr ""
"Has adquirido una gran habilidad para saltar desde una posición de pie."

#. ~ Description of mutation "Crushing Leap"
#: data/json/mutations/mutations.json
msgid ""
"You've gained a strong ability to leap a significant distance from a "
"standing position and crush whatever you land on."
msgstr ""
"Has adquirido una gran habilidad para saltar una distancia considerable "
"desde una posición de pie y aplastar cualquier cosa sobre la que caigas."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Toe Talons"
msgstr "Zarpas en Pies"

#. ~ Description of mutation "Toe Talons"
#: data/json/mutations/mutations.json
msgid ""
"You have grown large, curved, and wickedly sharp talons in place of your big"
" toes.  Fortunately, they don't get in the way of your movement.  "
"Unfortunately, they do prevent wearing footgear."
msgstr ""
"Te han crecido grandes garras curvas y malvadamente afiladas en lugar de tus"
" grandes dedos del pie. Afortunadamente, no se interponen en tu movimiento. "
"Desafortunadamente, sí impiden el uso de calzado."

#. ~ Message when player with mutation "Toe Talons" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "You slash %s with one of your talons!"
msgstr ""

#. ~ Message when NPC with mutation "Toe Talons" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "%1$s slashes %2$s with one of their talons!"
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Avian Legs"
msgstr "Piernas Aviarias"

#. ~ Description of mutation "Avian Legs"
#: data/json/mutations/mutations.json
msgid ""
"Your legs and feet have become bird-like, with long talons arranged three "
"ahead and one behind.  They probably won't fit in human shoes, but they're "
"perfect for gripping onto precarious perches."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Hooves"
msgstr "Pezuñas"

#. ~ Description of mutation "Hooves"
#: data/json/mutations/mutations.json
msgid ""
"Your feet have fused into hooves.  This allows you to perform a powerful "
"kicking attack, provides natural armor, and removes the need to wear shoes; "
"however, you cannot wear normal shoes.  Reduces wet effects."
msgstr ""
"Tus pies se han fusionado en pezuñas. Esto permite que los ataques de "
"patadas hagan mucho más daño, proporciona una armadura natural y elimina la "
"necesidad de usar zapatos; sin embargo, no puedes usar zapatos de ningún "
"tipo. Reduce los efectos de la humedad."

#. ~ Message when player with mutation "Hooves" attacks
#. ~ Message when player with mutation "Demon Hooves" attacks
#: data/json/mutations/mutations.json
#: data/mods/Magiclysm/traits/temporary_demon_traits.json
#, c-format
msgid "You kick %s with your hooves!"
msgstr "¡Pateás al %s con tus pezuñas!"

#. ~ Message when NPC with mutation "Hooves" attacks
#. ~ Message when NPC with mutation "Demon Hooves" attacks
#: data/json/mutations/mutations.json
#: data/mods/Magiclysm/traits/temporary_demon_traits.json
#, c-format
msgid "%1$s kicks %2$s with their hooves!"
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Alcohol Metabolism"
msgstr "Metabolizar Alcohol"

#. ~ Description of mutation "Alcohol Metabolism"
#: data/json/mutations/mutations.json
msgid ""
"So it's fermented?  Whatever, it's still good drinking.  You've developed "
"the ability to metabolize alcohol as a food source."
msgstr ""
"¿Así que está fermentado? No importa, igual es una buena bebida. Has "
"desarrollado la capacidad de metabolizar el alcohol como si fuera comida."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Subterranean Fortitude"
msgstr "Fortaleza Subterránea"

#. ~ Description of mutation "Subterranean Fortitude"
#: data/json/mutations/mutations.json
msgid "The aches and pains of living underground don't bother you as much."
msgstr "Los malestares y dolores de vivir bajo tierra, no te molestan tanto."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Subterranean Build"
msgstr "Constitución Subterránea"

#. ~ Description of mutation "Subterranean Build"
#: data/json/mutations/mutations.json
msgid ""
"Your frame has adapted for life in confined spaces.  You seem a little "
"shorter and bulkier, trading mobility for muscle mass.  (+2 Strength, -2 "
"Dexterity)"
msgstr ""
"Tu estructura se ha adaptado a la vida en espacios confinados. Pareces un "
"poco más pequeño y corpulento, cambiando tu movilidad por masa muscular. "
"(Fuerza +2 y Destreza -2)"

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Saprovore"
msgstr "Sapróvoro"

#. ~ Description of mutation "Saprovore"
#: data/json/mutations/mutations.json
msgid ""
"Your digestive system is specialized to allow you to consume decaying "
"material.  You can eat rotten food, albeit for less nutrition than usual."
msgstr ""
"Tu sistema digestivo se especializó en permitirte consumir materia en "
"descomposición. Puedes comer comida podrida, aunque obteniendo menos "
"nutrición de lo normal."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Saprophage"
msgstr "Saprófago"

#. ~ Description of mutation "Saprophage"
#: data/json/mutations/mutations.json
msgid ""
"You prefer to sustain your nutritional needs using your roots and direct "
"nutrient extraction/synthesis.  Your human parts still need the raw caloric "
"bulk of 'food' to keep them going, though, and you handle it a lot easier if"
" it's had time to… age a little."
msgstr ""
"Prefieres mantener tus necesidades nutricionales utilizando tus raíces y la "
"extracción/síntesis directa de nutrientes. Sin embargo, tus partes humanas "
"siguen necesitando la masa calórica bruta de la \"comida\" para mantenerse "
"en marcha, aunque la manejas mucho más fácilmente si has tenido tiempo de..."
" envejecer un poco."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Gizzard"
msgstr "Molleja"

#. ~ Description of mutation "Gizzard"
#: data/json/mutations/mutations.json
msgid ""
"You seem to get full faster now, and food goes through you more rapidly as "
"well."
msgstr ""
"La comida te llena más rapidamente y  también pasa más rápido por tu cuerpo."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Mycus Feeder"
msgstr "Alimentador/a Mycus"

#. ~ Description of mutation "Mycus Feeder"
#: data/json/mutations/mutations.json
msgid ""
"We have streamlined our nutritional requirements.  We rely on the Mycus for "
"sustenance, as it relies on us.  We may locate sources of sustenance in "
"close proximity to Mycus core towers, and in forested areas that the Mycus "
"has grown into."
msgstr ""
"Hemos simplificado nuestros requisitos nutricionales. Dependemos del Mycus "
"para el sustento, como él depende de nosotros. Podemos encontrar recursos de"
" sustento en la proximidad de las torres centrales del Mycus, y en areas "
"forestales en donde el Mycus haya crecido."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Ruminant"
msgstr "Rumiante"

#. ~ Description of mutation "Ruminant"
#: data/json/mutations/mutations.json
msgid ""
"Your digestive system is capable of digesting cellulose and other rough "
"plant material.  You can eat underbrush and shrubs by activating this, "
"standing over your target, and pressing E."
msgstr ""
"Tu sistema digestivo es capaz de digerir la celulosa y otros materiales "
"vegetales ásperos. Puedes comer maleza y arbustos activando esto, parándote "
"sobre tu objetivo y pulsando E."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Grazer"
msgstr "Pastante"

#. ~ Description of mutation "Grazer"
#: data/json/mutations/mutations.json
msgid ""
"You're accustomed to eating plants directly, and can get nutrition from "
"grass as well as underbrush and shrubs.  Eat either one by activating this, "
"standing over your target, and pressing E."
msgstr ""
"Estás acostumbrado a comer plantas de manera directa, y puedes obtener "
"nutrientes de la hierba y también de la maleza y de los arbustos. Come "
"cualquiera de los dos activando esto, situándote sobre tu objetivo y "
"pulsando E."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Intestinal Fortitude"
msgstr "Fortaleza Intestinal"

#. ~ Description of mutation "Intestinal Fortitude"
#: data/json/mutations/mutations.json
msgid ""
"Your guts have developed the ability to handle the toxic elements of mutated"
" flesh.  Mostly."
msgstr ""
"Tus entrañas han desarrollado la capacidad de manejar los elementos tóxicos "
"de la carne mutada. En su mayoría."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Eater Of The Dead"
msgstr "Devorador De Los Muertos"

#. ~ Description of mutation "Eater Of The Dead"
#: data/json/mutations/mutations.json
msgid ""
"Your digestion has evolved further.  In addition to mutated meat, you can "
"also stomach the tainted and long-dead flesh of zombies… if you can stand "
"the taste, of course."
msgstr ""
"Tu digestión ha evolucionado aún más. Además de la carne mutada, también "
"puedes digerir la carne contaminada y muerta de los zombis... si puedes "
"soportar su sabor, claro."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Burrowing"
msgstr "Cavador"

#. ~ Description of mutation "Burrowing"
#: data/json/mutations/mutations.json
msgid ""
"Your dextrous paws and long teeth allow you to dig through dirt and rubble "
"with ease."
msgstr ""
"Tus patas diestras y tus largos dientes te permiten escarbar en la tierra y "
"los escombros con facilidad."

#. ~ Description of mutation "Burrowing"
#: data/json/mutations/mutations.json
msgid "Your tough paws allow you to dig through dirt and rubble with ease."
msgstr ""
"Tus duras patas te permiten escarbar en la tierra y los escombros con "
"facilidad."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Saber Teeth"
msgstr "Dientes de Sable"

#. ~ Description of mutation "Saber Teeth"
#: data/json/mutations/mutations.json
msgid ""
"Your fangs have grown extremely large and incredibly sharp.  They make it "
"impossible to wear mouthgear and difficult to eat… but leave nasty wounds "
"when you bite."
msgstr ""
"Tus colmillos han crecido extremadamente grandes e increíblemente afilados. "
"Hace que sea imposible usar un aparato bucal y difícil de comer... pero deja"
" heridas desagradables cuando muerdes."

#. ~ Message when player with mutation "Saber Teeth" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "You tear into %s with your saber teeth!"
msgstr "¡Desgarrás %s con tus dientes de sable!"

#. ~ Message when NPC with mutation "Saber Teeth" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "%1$s tears into %2$s with their saber teeth!"
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Hyper-Metabolism"
msgstr "Hiper-Metabolismo"

#. ~ Description of mutation "Hyper-Metabolism"
#: data/json/mutations/mutations.json
msgid ""
"Your particular metabolism allows you to burn calories at a prodigious rate "
"to regenerate tissues in a matter of minutes; this is, however, a very "
"wasteful process.  Activate to start healing."
msgstr ""
"Tu particular metabolismo te permite quemar calorías a un ritmo prodigioso "
"para regenerar los tejidos en cuestión de minutos. Esto es, sin embargo, un "
"proceso de gran desperdicio. Actívalo para empezar la curación."

#. ~ Message when transforming from mutation  "Hyper-Metabolism" to
#. "EATHEALTH_active"
#: data/json/mutations/mutations.json
msgid "Your hyper-metabolism starts burning up calories."
msgstr "Tu hipermetabolismo empieza a quemar calorías."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Hyper-Metabolism: burning"
msgstr "HiperMetabolismo: quemando"

#. ~ Description of mutation "Hyper-Metabolism: burning"
#: data/json/mutations/mutations.json
msgid "You're burning calories like crazy to heal your wounds."
msgstr "Estás quemando calorías como un loco para curar tus heridas."

#. ~ Message when transforming from mutation  "Hyper-Metabolism: burning" to
#. "EATHEALTH"
#: data/json/mutations/mutations.json
msgid "Your hyper-metabolism slows down."
msgstr "Tu hipermetabolismo se ralentiza.."

#. ~ Mutation name
#. ~ Mutation class name
#: data/json/mutations/mutations.json
#: data/mods/DinoMod/mutations/mutations.json
msgid "Horns"
msgstr "Cuernos"

#. ~ Description of mutation "Horns"
#: data/json/mutations/mutations.json
msgid ""
"You have a pair of small horns on your head.  They allow you to make a weak "
"piercing headbutt attack, but prevent the use of most rigid headwear."
msgstr ""
"Tienes un par de pequeños cuernos en la cabeza. Te permiten causar un poco "
"de daño penetrante con tu cabezazo, pero previenen el uso de equipamiento "
"para cabeza rígido."

#. ~ Message when player with mutation "Horns" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "You headbutt %s with your horns!"
msgstr "¡Le das un cabezazo al %s con tus cuernos!"

#. ~ Message when NPC with mutation "Horns" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "%1$s headbutts %2$s with their horns!"
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Curled Horns"
msgstr "Cuernos Enroscados"

#. ~ Description of mutation "Curled Horns"
#: data/json/mutations/mutations.json
msgid ""
"You have a pair of large curled horns, like those of a ram.  They allow you "
"to make a strong bashing headbutt attack, but prevent wearing any headwear."
msgstr ""
"Tienes un par de cuernos grandes y rizados, como los de un carnero. Te "
"permite hacer un fuerte ataque contundente de cabezazo, pero impide el uso "
"de cualquier tipo de sombreros."

#. ~ Message when player with mutation "Curled Horns" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "You headbutt %s with your curled horns!"
msgstr "¡Le das un cabezazo al %s con tus cuernos enroscados!"

#. ~ Message when NPC with mutation "Curled Horns" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "%1$s headbutts %2$s with their curled horns!"
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Pointed Horns"
msgstr "Cuernos Puntiagudos"

#. ~ Description of mutation "Pointed Horns"
#: data/json/mutations/mutations.json
msgid ""
"You have a pair of long, pointed horns, like those of an antelope.  They "
"allow you to make a strong piercing headbutt attack, but prevent wearing "
"headwear that is not made of fabric."
msgstr ""
"Tienes un par de cuernos largos y puntiagudos, como los de un antílope. Te "
"permiten hacer un fuerte ataque de cabezazos, pero evita que uses prendas en"
" la cabeza no sea de tejido."

#. ~ Message when player with mutation "Pointed Horns" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "You stab %s with your pointed horns!"
msgstr "¡Le das un cabezazo al %s con tus cuernos puntiagudos!"

#. ~ Message when NPC with mutation "Pointed Horns" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "%1$s stabs %2$s with their pointed horns!"
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Antlers"
msgstr "Astas"

#. ~ Description of mutation "Antlers"
#: data/json/mutations/mutations.json
msgid ""
"You have a huge rack of antlers, like those of a moose.  They allow you to "
"make a weak headbutt attack, but prevent wearing headwear that is not made "
"of fabric."
msgstr ""
"Tienes unos enormes cuernos, como los de un alce. Te permiten realizar un "
"débil ataque de cabeza, pero evita que puedas usar algo en la cabeza que no "
"esté hecho de tela."

#. ~ Message when player with mutation "Antlers" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "You butt %s with your antlers!"
msgstr "¡Corneás al %s con tus astas!"

#. ~ Message when NPC with mutation "Antlers" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "%1$s butts %2$s with their antlers!"
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Antennae"
msgstr "Antenas"

#. ~ Description of mutation "Antennae"
#: data/json/mutations/mutations.json
msgid ""
"You have a pair of antennae.  They allow you to detect the presence of "
"monsters up to a few tiles away, even if you can't see or hear them, but "
"prevent wearing headwear that is not made of fabric."
msgstr ""
"Tienes un par de antenas. Te permiten detectar la presencia de monstruos "
"hasta a unos pocos tiles de distancia, incluso si no puedes verlos ni "
"oírlos, pero te impiden llevar un equipo para la cabeza que no sea de "
"tejido."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Road-Runner"
msgstr "Correcaminos"

#. ~ Description of mutation "Road-Runner"
#: data/json/mutations/mutations.json
#, no-c-format
msgid ""
"Your legs are extremely limber and fast-moving.  You move 30% faster on flat"
" surfaces."
msgstr ""
"Tus piernas son extremadamente flexibles y rápidas. Te mueves un 30% más "
"rápido en superficies planas."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Stubby Tail"
msgstr "Cola Regordeta"

#. ~ Description of mutation "Stubby Tail"
#: data/json/mutations/mutations.json
msgid "You have a short, stubby tail, like a rabbit's.  It serves no purpose."
msgstr ""
"Tienes una cola regordeta, corta, como la de un conejo. No te sirve para "
"nada."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Tail Fin"
msgstr "Aleta Caudal"

#. ~ Description of mutation "Tail Fin"
#: data/json/mutations/mutations.json
msgid ""
"You have a fin-like tail.  It allows you to swim more quickly, but prevents "
"wearing non-fabric pants.  Slightly increases wet benefits."
msgstr ""
"Tienes una cola que parece una aleta, como un pez. Te permite nadar más "
"rápido, pero no te permite utilizar pantalones que no sean de tela. "
"Incrementa levemente los beneficios de estar mojado."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Long Tail"
msgstr "Cola Larga"

#. ~ Description of mutation "Long Tail"
#: data/json/mutations/mutations.json
msgid ""
"You have a long, graceful tail, like that of a big cat.  It improves your "
"balance, making your ability to dodge higher, but prevents wearing non-"
"fabric pants."
msgstr ""
"Tienes una cola larga y elegante, como la de un felino grande. Mejora tu "
"balance, lo que incrementa tu habilidad de esquivar, pero no te permite "
"utilizar pantalones que no sean de tela."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Cattle Tail"
msgstr "Cola de Ganado"

#. ~ Description of mutation "Cattle Tail"
#: data/json/mutations/mutations.json
msgid ""
"You have a long tail with a tuft on the end.  You find yourself "
"instinctively swatting away flies with it, though it's not as effective at "
"balancing you as you'd like.  Prevents wearing non-fabric pants."
msgstr ""
"Tienes una cola larga con un penacho en la punta. Instintivamente, la usas "
"para sacarte las moscas de encima, pero no es tan buena para el balance como"
" te hubiera gustado. No te permite utilizar pantalones que no sean de tela."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Rodent Tail"
msgstr "Cola de roedor"

#. ~ Description of mutation "Rodent Tail"
#: data/json/mutations/mutations.json
msgid ""
"You have a long but hairless tail.  It's a pretty effective balancing aid, "
"but does look, uh, ratty.  Prevents wearing non-fabric pants."
msgstr ""
"Tienes una cola larga y pelada. Es una ayuda bastante efectiva para tu "
"balance, pero parece... eh... de rata. No te permite utilizar pantalones que"
" no sean de tela."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Thick Tail"
msgstr "Cola Gruesa"

#. ~ Description of mutation "Thick Tail"
#: data/json/mutations/mutations.json
msgid ""
"You have a long, thick, lizardlike tail.  It helps you balance a bit but "
"also makes a serviceable whip.  Prevents wearing non-fabric pants."
msgstr ""
"Tienes una cola larga y gruesa, como la de un lagarto. Ayuda un poco tu "
"balance pero también sirve como látigo. No te permite utilizar pantalones "
"que no sean de tela."

#. ~ Message when player with mutation "Thick Tail" attacks
#. ~ Message when player with mutation "Short Dragon Tail" attacks
#: data/json/mutations/mutations.json
#: data/mods/Magiclysm/mutations/mutations.json
#, c-format
msgid "You whap %s with your tail!"
msgstr "¡Le pegas al %s con tu cola!"

#. ~ Message when NPC with mutation "Thick Tail" attacks
#. ~ Message when NPC with mutation "Short Dragon Tail" attacks
#: data/json/mutations/mutations.json
#: data/mods/Magiclysm/mutations/mutations.json
#, c-format
msgid "%1$s whaps %2$s with their tail!"
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Dromeosaur Muzzle"
msgstr ""

#. ~ Description of mutation "Dromeosaur Muzzle"
#: data/json/mutations/mutations.json
msgid ""
"Your face has drastically mutated, with the bones of your jaws having "
"extended forth into a long, tapered snout.  The palate of your mouth is "
"considerably vaulted, with curved, serrated teeth lining your saurian maw "
"and reptilian scales covering your muzzle’s exterior.  While paleobiology "
"has evidently not evolved with mouth gear in mind (making such items "
"unwearable), the bite wounds you can now inflict promise the ferocity of "
"long-dead beasts."
msgstr ""

#. ~ Message when player with mutation "Dromeosaur Muzzle" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "You dart your head and snap at %s!"
msgstr ""

#. ~ Message when NPC with mutation "Dromeosaur Muzzle" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "%1$s darts their head and snaps at %2$s!"
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Raptor Tail"
msgstr "Cola de Rapaz"

#. ~ Description of mutation "Raptor Tail"
#: data/json/mutations/mutations.json
msgid ""
"Formed from a network of interlocking bones, a long tail has mutated from "
"the base of your spine, with ossified tendons assisting in keeping the limb "
"stiff and rigid.  A plume of lengthy feathers sprouts from the reptilian "
"flesh along your new tail, drawing the eye.  While it is useless in combat "
"and prevents you from wearing non-fabric pants, you find it’s pretty handy "
"for maintaining your balance."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Fluffy Tail"
msgstr "Cola Peludita"

#. ~ Description of mutation "Fluffy Tail"
#: data/json/mutations/mutations.json
msgid ""
"You have a long, fluffy-furred tail.  It greatly improves your balance, "
"making your ability to dodge much higher.  Prevents wearing non-fabric "
"pants."
msgstr ""
"Tienes una cola larga y peludita. Mejora mucho tu balance, lo que incrementa"
" tu capacidad para esquivar. No te permite utilizar pantalones que no sean "
"de tela."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Spiked Tail"
msgstr "Cola Aguijón"

#. ~ Description of mutation "Spiked Tail"
#: data/json/mutations/mutations.json
msgid ""
"You have a long tail that ends in a vicious stinger.  It does not improve "
"your balance at all, but allows for a powerful piercing attack.  Prevents "
"wearing non-fabric pants."
msgstr ""
"Tienes una larga cola que termina en un aguijón atroz. No mejora tu "
"equilibrio en absoluto, pero permite un poderoso ataque de perforación. "
"Evita el uso de pantalones que no sean de tela."

#. ~ Message when player with mutation "Spiked Tail" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "You sting %s with your tail!"
msgstr "¡Pichas al %s con tu cola!"

#. ~ Message when NPC with mutation "Spiked Tail" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "%1$s stings %2$s with their tail!"
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Club Tail"
msgstr "Cola Garrote"

#. ~ Description of mutation "Club Tail"
#: data/json/mutations/mutations.json
msgid ""
"You have a long tail that ends in a heavy, bony club.  It does not improve "
"your balance at all, but allows for a powerful bashing attack.  Prevents "
"wearing non-fabric pants."
msgstr ""
"Tienes una cola larga que termina en un garrote óseo pesado. No te mejora el"
" balance para nada, pero te permite tener un poderoso ataque contundente. No"
" te permite utilizar pantalones que no sean de tela."

#. ~ Message when player with mutation "Club Tail" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "You club %s with your tail!"
msgstr "¡Aporreás al %s con tu cola!"

#. ~ Message when NPC with mutation "Club Tail" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "%1$s clubs %2$s with their tail!"
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Hibernation"
msgstr "Hibernación"

#. ~ Description of mutation "Hibernation"
#: data/json/mutations/mutations.json
msgid ""
"You've developed the ability to stockpile calories and then sleep for "
"extended periods of time."
msgstr ""
"Has desarrollado la habilidad de almacenar calorías y luego dormir por "
"períodos extensos de tiempo."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Resilient"
msgstr "Resistente"

#. ~ Description of mutation "Resilient"
#. ~ Description of mutation "Immovable"
#: data/json/mutations/mutations.json
#: data/mods/Aftershock/mutations/obsolete.json
#, no-c-format
msgid ""
"You can survive injuries that would incapacitate humans: you get a 20% bonus"
" to all hit points.  Stacks with Tough, etc."
msgstr ""
"Puedes sobrevivir a heridas que incapacitarían a otros humanos: tienes una "
"bonificación del 20% a los puntos de golpe. Se acumula con Resistente, etc."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Solidly Built"
msgstr "Solidamente Construido"

#. ~ Description of mutation "Solidly Built"
#. ~ Description of mutation "Unstoppable"
#: data/json/mutations/mutations.json
#: data/mods/Aftershock/mutations/obsolete.json
#, no-c-format
msgid ""
"Not much scares you.  You get a 30% bonus to all hit points.  Stacks with "
"Tough, etc."
msgstr ""
"No hay muchas cosas que te asusten. Tienes una bonificación del 30% a los "
"puntos de golpe. Se acumula con Resistente, etc."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "TAAANK"
msgstr "TAAANQUE"

#. ~ Description of mutation "TAAANK"
#. ~ Description of mutation "Meatshield"
#: data/json/mutations/mutations.json
#: data/mods/Aftershock/mutations/obsolete.json
#, no-c-format
msgid ""
"You can simply take the punishment from lesser beings and keep going.  You "
"get a 40% bonus to all hit points.  Stacks with Tough, etc."
msgstr ""
"Simplemente, puedes recibir el castigo de seres más pequeños y seguir como "
"si nada. Tienes una bonificación del 40% a los puntos de golpe. Se acumula "
"con Resistente, etc."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Pain Recovery"
msgstr "Recuperación del Dolor"

#. ~ Description of mutation "Pain Recovery"
#: data/json/mutations/mutations.json
msgid "You recover from pain slightly faster than normal."
msgstr "Te recuperas del dolor un poco más rápido que lo normal."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Quick Pain Recovery"
msgstr "Recuperación Rápida del Dolor"

#. ~ Description of mutation "Quick Pain Recovery"
#: data/json/mutations/mutations.json
msgid "You recover from pain faster than normal."
msgstr "Te recuperas del dolor más rápido que lo normal."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Very Quick Pain Recovery"
msgstr "Recuperación Muy Rápida del Dolor"

#. ~ Description of mutation "Very Quick Pain Recovery"
#: data/json/mutations/mutations.json
msgid "You recover from pain much faster than normal."
msgstr "Te recuperas del dolor mucho más rápido que lo normal."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Pain Junkie"
msgstr "Yonki del dolor"

#. ~ Description of mutation "Pain Junkie"
#: data/json/mutations/mutations.json
msgid ""
"You've developed a serious appetite for pain, and take pride in your scars."
msgstr ""
"Desarrollaste un serio apetito por el dolor, y muestras con orgullo tus "
"cicatrices."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Cenobite"
msgstr "Cenobita"

#. ~ Description of mutation "Cenobite"
#: data/json/mutations/mutations.json
msgid "You positively adore pain, in all its varied forms."
msgstr "Ciertamente, adoras el dolor, en todas sus variedades posibles."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Deadened"
msgstr "Amortiguado"

#. ~ Description of mutation "Deadened"
#: data/json/mutations/mutations.json
msgid ""
"Nothing hurts anymore.  Those bites tickle and the wounds itch a bit, but "
"that's it."
msgstr ""
"Ya nada te duele. Esas mordidas te hacen cosquillas y las heridas te pican "
"un poco, pero nada más."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Pain Sensitive"
msgstr "Sensibilidad al Dolor"

#. ~ Description of mutation "Pain Sensitive"
#: data/json/mutations/mutations.json
#, no-c-format
msgid ""
"For some reason, things always seem to hurt you more.  Pain dealt to you is "
"increased by 25%."
msgstr ""
"Por alguna razón las cosas siempre parecen herirte más. El dolor que recibes"
" es incrementado un 25%."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Hyperalgesia"
msgstr "Hiperalgesia"

#. ~ Description of mutation "Hyperalgesia"
#: data/json/mutations/mutations.json
#, no-c-format
msgid ""
"Your body experiences pain out of proportion to the physical causes.  Pain "
"dealt to you is increased by 50%."
msgstr ""
"Tu cuerpo experimenta un dolor desproporcionado por causas físicas. El dolor"
" que recibes aumenta en un 50%."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Extreme Hyperalgesia"
msgstr "Hiperalgesia Extrema"

#. ~ Description of mutation "Extreme Hyperalgesia"
#: data/json/mutations/mutations.json
msgid ""
"Your body reacts cripplingly to any source of pain.  Pain dealt to you is "
"doubled."
msgstr ""
"Tu cuerpo reacciona de forma paralizante ante cualquier fuente de dolor. El "
"dolor que recibes se duplica."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Culler"
msgstr "Sacrificador"

#. ~ Description of mutation "Culler"
#: data/json/mutations/mutations.json
msgid ""
"You've had a revelation: by killing the weaker creatures, who would only die"
" anyway, you preserve resources for those better able to survive.  You are "
"less bothered by the deaths of others: their own weakness invited these "
"fates upon them."
msgstr ""
"Has tenido una revelación: al matar a las criaturas más débiles, que sólo "
"morirían de todos modos, preservas los recursos para aquellos que pueden "
"sobrevivir mejor. Te molestan menos las muertes de otros: su propia "
"debilidad invitó a estos destinos sobre ellos."

#. ~ Mutation name
#. ~ Name of an NPC class
#. ~ Name suffix of an NPC
#. ~ Appears in the refugee center as a trader.
#. ~ Snippet in category "<dog_name>"
#: data/json/mutations/mutations.json data/json/npcs/classes.json
#: data/json/npcs/godco/classes.json
#: data/json/npcs/refugee_center/surface_visitors/NPC_hunter.json
#: data/json/snippets/snippets.json
msgid "Hunter"
msgstr "Cazador"

#. ~ Description of mutation "Hunter"
#: data/json/mutations/mutations.json
msgid ""
"Your brain has a lot more in common with a predatory animal than a human, "
"making it easier to control misplaced reactions to the death of your prey.  "
"Additionally, combat skills, which you use to hunt, are easier to learn and "
"maintain."
msgstr ""
"Tu cerebro tiene mucho más en común con un animal depredador que con un "
"humano, lo que facilita el control de reacciones erróneas ante la muerte de "
"tu presa. Además, las habilidades de combate, que utilizas para cazar, son "
"más fáciles de aprender y mantener."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Predator"
msgstr "Depredador"

#. ~ Description of mutation "Predator"
#: data/json/mutations/mutations.json
msgid ""
"You consider yourself something other than human and no longer empathize "
"with them.  Combat skills are easy to learn and maintain, but your critical "
"thinking, so characteristic to these creatures, suffers."
msgstr ""
"Te consideras a ti mismo como algo distinto a los humanos y ya no sientes "
"empatía por ellos. Las habilidades de combate son fáciles de aprender y "
"mantener, pero tu pensamiento crítico, tan característico de estas "
"criaturas, sufre."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Apex Predator"
msgstr "SuperDepredador"

#. ~ Description of mutation "Apex Predator"
#: data/json/mutations/mutations.json
msgid ""
"Your mind and brain have adapted to your new place in the world: as one on "
"top of the food chain.  You can effortlessly master and maintain combat "
"skills, but your critical thinking has atrophied further."
msgstr ""
"Tu mente y cerebro se han adaptado a tu nuevo lugar en el mundo: el de uno "
"en la punta de la pirámide alimenticia. Sin esfuerzo, podés perfeccionar y "
"mantener tus habilidades de combate, pero tu pensamiento crítico se ha "
"atrofiado aún más."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Sapiovore"
msgstr "Sapióvoro"

#. ~ Description of mutation "Sapiovore"
#: data/json/mutations/mutations.json
msgid "The hairless apes make as good eating as any other meat."
msgstr "Los simios sin pelo son tan buena comida como cualquier otra carne."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Pack Hunter"
msgstr "Cazador de Manada"

#. ~ Description of mutation "Pack Hunter"
#: data/json/mutations/mutations.json
msgid ""
"Puny as they may seem, a hunter needs a pack, and some of those hairless "
"bipeds may yet prove some worth.  You continue to gain combat skills at an "
"elevated rate, and maintain a level of critical thinking that supports "
"cooperation."
msgstr ""
"Por muy insignificantes que parezcan, un cazador necesita una manada, y "
"algunos de esos bípedos sin pelo podrían demostrar su valía. Sigues ganando "
"habilidades de combate a un ritmo elevado, y mantienes un nivel de "
"pensamiento crítico que favorece la cooperación."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Mycus Defender"
msgstr "Defensor Mycus"

#. ~ Description of mutation "Mycus Defender"
#: data/json/mutations/mutations.json
msgid ""
"From time to time the Mycus requires protection from non-Mycus that, for "
"whatever reason, wish it ill.  We have adapted to better carry out this task"
" - our fibers will grow strong and resilient when such threats present "
"themselves to us."
msgstr ""
"De vez en cuando el Mycus requiere protección de los no-Mycus que, por "
"cualquier razón, le desean el mal. Nos hemos adaptado para llevar a cabo "
"mejor esta tarea - nuestras fibras crecerán fuertes y resistentes cuando "
"tales amenazas se nos presenten."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Bird Wings"
msgstr "Alas de pájaro"

#. ~ Description of mutation "Bird Wings"
#: data/json/mutations/mutations.json
msgid ""
"Your arms have mostly transformed into a huge pair of feathered wings.  "
"Though you retain a few fingers, your fine manipulation is greatly hampered."
"  On the other hand, you can glide from ledges and will take less damage if "
"you fall, provided you're healthy and unburdened."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Insect Wings"
msgstr "Alas de Insecto"

#. ~ Description of mutation "Insect Wings"
#: data/json/mutations/mutations.json
msgid ""
"A large pair of translucent wings grow from your back.  They are too small "
"to lift you, but if you're not weighed down, they can help a bit if you "
"fall.  You can flutter them quickly to improve your move speed, but this is "
"noisy and tires you out."
msgstr ""

#. ~ Message when transforming from mutation  "Insect Wings" to
#. "WINGS_INSECT_active"
#: data/json/mutations/mutations.json
msgid "You begin buzzing your wings."
msgstr ""

#. ~ Description of mutation "Insect Wings (Buzzing)"
#: data/json/mutations/mutations.json
msgid ""
"You're fluttering your wings as fast as you can.  This doesn't generate "
"enough lift to move you, but it does increase your movement speed.  If "
"you're not burdened, you can fall short distances without harm."
msgstr ""

#. ~ Message when transforming from mutation  "Insect Wings (Buzzing)" to
#. "WINGS_INSECT"
#: data/json/mutations/mutations.json
msgid "Your wings go still."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Mouth Tentacles"
msgstr "Tentáculos Bucales"

#. ~ Description of mutation "Mouth Tentacles"
#. ~ Description of mutation "Facial Tentacles"
#: data/json/mutations/mutations.json
#: data/mods/Aftershock/mutations/mutations.json
msgid ""
"A set of tentacles surrounds your mouth.  They allow you to eat twice as "
"fast.  Slightly decreases wet penalties."
msgstr ""
"Un grupo de tentáculos te rodea la boca. Te permiten comer el doble de "
"rápido. Disminuye levemente las penalidades por estar mojado."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Mandibles"
msgstr "Mandíbulas"

#. ~ Description of mutation "Mandibles"
#: data/json/mutations/mutations.json
msgid ""
"A set of insect-like mandibles have grown around your mouth.  They allow you"
" to eat faster and provide a slicing unarmed attack.  Slightly reduces wet "
"effects."
msgstr ""
"Te han crecido alrededor de la boca unas mandíbulas como las de los "
"insectos. Te permiten comer más rápido y te dan un ataque desarmado "
"cortante. Disminuye levemente los efectos por estar húmedo."

#. ~ Message when player with mutation "Mandibles" attacks
#. ~ Message when player with mutation "Folding Fangs" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "You bite %s with your fangs!"
msgstr "¡Muerdes con tus colmillos a %s!"

#. ~ Message when NPC with mutation "Mandibles" attacks
#. ~ Message when NPC with mutation "Folding Fangs" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "%1$s bites %2$s with their fangs!"
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Folding Fangs"
msgstr "Colmillos Plegables"

#. ~ Description of mutation "Folding Fangs"
#: data/json/mutations/mutations.json
msgid ""
"You have developed deadly extensible fangs, allowing you to bite quickly or "
"ensure your venom goes home, as desired."
msgstr ""
"Has desarrollado colmillos extensibles, lo que te permite morder rápido o "
"asegurar que tu veneno llegue a su destino, cuando así lo desees."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Crab Legs"
msgstr ""

#. ~ Description of mutation "Crab Legs"
#: data/json/mutations/mutations.json
msgid ""
"You have four prong-tipped legs, splayed out and articulated like a crab's."
"  They're a little quieter than human feet."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Gastropod Foot"
msgstr "Pie de Gasterópodo"

#. ~ Description of mutation "Gastropod Foot"
#: data/json/mutations/mutations.json
msgid ""
"Your legs have consolidated into a single muscular 'foot' that goes up into "
"your belly.  You move about a fourth of your previous speed and can no "
"longer wear pants or shoes, on the other hand you make significantly less "
"noise.  In addition to being harder to knock down, you can move through "
"sludge-covered surfaces easily."
msgstr ""
"Tus piernas se han consolidado en un único \"pie\" muscular que sube hasta "
"tu vientre. Te mueves a una cuarta parte de tu velocidad anterior y ya no "
"puedes llevar pantalones ni zapatos, por otro lado haces bastante menos "
"ruido. Además de ser más difícil de derribar, puedes moverte por superficies"
" cubiertas de lodo con facilidad."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Gastropod Balance"
msgstr "Balance Gasterópodo"

#. ~ Description of mutation "Gastropod Balance"
#: data/json/mutations/mutations.json
msgid ""
"By pushing your whole 'foot' against the ground you are able to move across "
"rough terrain without losing your 'footing'.  You're also able to cling to "
"the ground underwater, allowing you to move along the bottom more easily."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Mucus Secretion"
msgstr "Secreción Mucosa"

#. ~ Description of mutation "Mucus Secretion"
#: data/json/mutations/mutations.json
msgid ""
"You once had a significant other call you slimy, now you exemplify that.  It"
" covers everything you come into contact with but now you can move through "
"slime you didn't create with ease."
msgstr ""
"Una vez tuviste una pareja que te llamó baboso, ahora lo ejemplificas. "
"Cubres todo aquello con lo que entras en contacto, pero ahora puedes moverte"
" a través de las babas que no has creado con facilidad."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Acidic Secretion"
msgstr "Secreción Ácidica"

#. ~ Description of mutation "Acidic Secretion"
#: data/json/mutations/mutations.json
msgid ""
"Your mucus has developed an acidic component that seems to soften your prey "
"up."
msgstr ""
"Tu moco ha desarrollado un componente ácido que parece ablandar a tu presa."

#. ~ Message when player with mutation "Acidic Secretion" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "You smear slime on %s!"
msgstr ""

#. ~ Message when NPC with mutation "Acidic Secretion" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "%1$s smears slime on %2$s!"
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Snail Trail"
msgstr "Rastro de Caracol"

#. ~ Description of mutation "Snail Trail"
#: data/json/mutations/mutations.json
msgid ""
"You've developed some ability to control your slime emissions.  As a result "
"of this you can leave trails of slime anywhere you walk."
msgstr ""
"Has desarrollado cierta habilidad para controlar tus emisiones de baba. Como"
" resultado, puedes dejar rastros de baba en cualquier lugar por el que "
"camines."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Animal Ears"
msgstr ""

#. ~ Description of mutation "Animal Ears"
#: data/json/mutations/mutations.json
msgid ""
"You have large ears with broad pinnae, like a dog or a cow.  They enhance "
"your hearing, allowing you to hear at greater distances."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Lupine Ears"
msgstr "Orejas Lupinas"

#. ~ Description of mutation "Lupine Ears"
#: data/json/mutations/mutations.json
msgid ""
"Your hearing has evolved further and is now on par with that of wolves.  You"
" can hear things significantly farther away."
msgstr ""
"Tu oído ha evolucionado aún más y ahora está a la par con el de los lobos. "
"Puedes oír cosas significativamente más lejos."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Feline Ears"
msgstr "Orejas Felinas"

#. ~ Description of mutation "Feline Ears"
#: data/json/mutations/mutations.json
msgid ""
"Your ears have extended into long, pointed, velvety ones, like those of a "
"feline.  You find it easier to tune in on sounds from afar."
msgstr ""
"Tus orejas se extienden largas, puntiagudas y aterciopeladas, como las de "
"los felinos. Te resulta más fácil captar sonidos desde lejos."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Ursine Ears"
msgstr "Orejas Osunas"

#. ~ Description of mutation "Ursine Ears"
#: data/json/mutations/mutations.json
msgid ""
"Your ears have grown longer and rounder, much like those of a bear.  You can"
" hear things a little farther away."
msgstr ""
"Tus orejas han crecido largas y redondas, muy parecidas a las de los osos. "
"Ahora escuchas cosas que están un poco más lejos."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Pointed Ears"
msgstr "Orejas Puntiagudas"

#. ~ Description of mutation "Pointed Ears"
#: data/json/mutations/mutations.json
msgid ""
"Your upper earlobes have grown noticeably higher.  Fortunately, they don't "
"get in the way of your headgear, much.  Unfortunately, they also don't seem "
"to help your hearing any."
msgstr ""
"Tus lóbulos superiores han crecido notablemente altos. Por suerte, no te "
"molestan para usar cosas en la cabeza, no mucho. Pero, no te mejoran la "
"audición."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Rodent Ears"
msgstr "Orejas de Roedor"

#. ~ Description of mutation "Rodent Ears"
#: data/json/mutations/mutations.json
msgid ""
"Your ears are huge, round, and gray!  They're rather fascinating, and help "
"you hear from a much greater distance."
msgstr ""
"¡Tus orejas son enormes, redondas y grises! Son fascinantes y te ayudan a "
"escuchar a mucha mayor distancia."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Web Walker"
msgstr "Caminador de Telarañas"

#. ~ Description of mutation "Web Walker"
#: data/json/mutations/mutations.json
msgid ""
"Your body excretes very fine amounts of a chemical which prevents you from "
"sticking to webs.  Walking through webs does not affect you at all."
msgstr ""
"Tu cuerpo segrega grandes cantidades de un químico que evita que te pegues "
"en las telarañas. Caminar a través de las telarañas no te afecta para nada."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Web Spinner"
msgstr "Embioptera"

#. ~ Description of mutation "Web Spinner"
#: data/json/mutations/mutations.json
msgid ""
"Your body produces and anchors webbing.  Too bad you can't seem to control "
"the process.  There is a chance that you will leave webs in your wake."
msgstr ""
"Tu cuerpo produce y coloca telarañas. Lo malo es que parece que no controlas"
" ese proceso. Hay una posibilidad de que dejes telarañas como estela."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Web Weaver"
msgstr "Tejedor de Telarañas"

#. ~ Description of mutation "Web Weaver"
#: data/json/mutations/mutations.json
msgid ""
"You've developed the necessary anatomy and techniques to control your web-"
"generation.  Activate this to start or stop weaving webs."
msgstr ""
"Has desarrollado la anatomía necesaria y las técnicas para controlar tu "
"generación de telarañas. Hay que activar esta habilidad para empezar o dejar"
" de tejer telarañas."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Web Diver"
msgstr "Saltador de Telarañas"

#. ~ Description of mutation "Web Diver"
#: data/json/mutations/mutations.json
msgid ""
"Your webbing is strong enough to support your weight.  Activate to rappel "
"down any drop you encounter, at the cost of nutrition."
msgstr ""
"Tu red es lo suficientemente fuerte como para soportar tu peso. Actívala "
"para descender en rappel por cualquier desnivel que encuentres, a costa de "
"nutrición."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Rope Webs"
msgstr "Sogas de Telaraña"

#. ~ Description of mutation "Rope Webs"
#: data/json/mutations/mutations.json
msgid ""
"With spinnerets like THESE, who needs rope?!  Activate to produce rope."
msgstr ""
"Con un hilador de telarañas como este, ¿Quién necesita sogas? Actívalo para "
"producir tu propia soga."

#. ~ Message when spawning item "rope_30" with mutation "Rope Webs"
#: data/json/mutations/mutations.json
msgid "You spin a rope from your silk."
msgstr "Creas una soga con tu seda."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Whiskers"
msgstr "Bigotes"

#. ~ Description of mutation "Whiskers"
#: data/json/mutations/mutations.json
msgid ""
"You have a handsome set of whiskers around your mouth.  These make you more "
"aware of vibrations in the air, and improve your ability to dodge very "
"slightly."
msgstr ""
"Tienes unos bonitos bigotes alrededor de la boca. Estos te hacen más "
"consciente de las vibraciones en el aire y mejoran tu capacidad de esquivar "
"muy ligeramente."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Wiry Whiskers"
msgstr "Bigotes Tiesos"

#. ~ Description of mutation "Wiry Whiskers"
#: data/json/mutations/mutations.json
msgid ""
"You have a set of prominent rodent-like whiskers around your mouth.  These "
"make you more aware of vibrations in the air, and improve your ability to "
"dodge slightly."
msgstr ""
"Tienes unos bigotes prominentes como los de los roedores en los costados de "
"tu boca. Te hacen más consciente de las vibraciones del aire, y mejora "
"levemente tu habilidad para esquivar."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Fat Deposits"
msgstr "Depósitos de Grasa"

#. ~ Description of mutation "Fat Deposits"
#: data/json/mutations/mutations.json
msgid ""
"You've put on some additional weight around your body.  It slows you down a "
"little, but helps your swimming and warmth."
msgstr ""
"Pusiste un poco más de peso alrededor de tu cuerpo. Te hace un poco más "
"lento, pero te ayuda a nadar y te abriga."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Inconveniently Large"
msgstr "Inconvenientemente Grande"

#. ~ Description of mutation "Inconveniently Large"
#. ~ Description of mutation "Elephantine"
#: data/json/mutations/mutations.json
#: data/mods/Aftershock/mutations/obsolete.json
msgid ""
"You have grown noticeably taller and broader.  Much of it is useful muscle "
"mass (Strength +2), but you find it throws off your balance and you get in "
"your own way (+10 torso and arm encumbrance)."
msgstr ""
"Has crecido notablemente más alto y ancho. La mayoría es masa muscular útil "
"(Fuerza +2), pero notás que te quita el balance y estás más torpe (+10 de "
"incomodidad en torso y brazos)."

#. ~ Mutation name
#: data/json/mutations/mutations.json
#: data/mods/Aftershock/mutations/obsolete.json
msgid "Large"
msgstr "Grande"

#. ~ Description of mutation "Large"
#: data/json/mutations/mutations.json
#: data/mods/Aftershock/mutations/obsolete.json
msgid "You carry your rugged body with the dignity you deserve.  Strength +2."
msgstr "Cargas tu robusto cuerpo con la dignidad que se merece. Fuerza +2."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Freakishly Huge"
msgstr "Peculiarmente Enorme"

#. ~ Description of mutation "Freakishly Huge"
#. ~ Description of mutation "Freakishly Gigantic"
#. ~ Description of mutation "Freakish Draconic Maturity"
#: data/json/mutations/mutations.json
#: data/mods/Aftershock/mutations/obsolete.json
#: data/mods/Magiclysm/mutations/mutations.json
msgid ""
"You have grown even more massive, to the point where you cannot usefully fit"
" into human-sized clothing or vehicles.  Much of it is powerful muscle mass "
"(Strength +4), but it's a real pain to haul around."
msgstr ""
"Has crecido todavía más, al punto que ya no entrás en la ropa tamaño humano "
"normal ni en los vehículos. La mayor parte de lo crecido es poderosa masa "
"muscular (Fuerza +4), pero es un verdadero problema ir acarreando tu cuerpo."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Huge"
msgstr "Enorme"

#. ~ Description of mutation "Huge"
#. ~ Description of mutation "Gigantic"
#. ~ Description of mutation "Draconic Maturity"
#: data/json/mutations/mutations.json
#: data/mods/Aftershock/mutations/obsolete.json
#: data/mods/Magiclysm/mutations/mutations.json
msgid ""
"Your cardiovascular system has caught up with your muscular physique, so who"
" needs pathetic human cars?  Strength +4."
msgstr ""
"Tu sistema cardiovascular ha llegado al mismo nivel que tu físico, así que "
"¿Quién necesita esos patéticos coches de humanos? Fuerza +4."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Strong"
msgstr "Fuerte"

#. ~ Description of mutation "Strong"
#: data/json/mutations/mutations.json
msgid "Your muscles are a little stronger.  +1 Strength."
msgstr "Tus músculos son un poco más fuertes. Fuerza +1."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Very Strong"
msgstr "Muy Fuerte"

#. ~ Description of mutation "Very Strong"
#: data/json/mutations/mutations.json
msgid "Your muscles are stronger.  +2 Strength."
msgstr "Tus músculos son más fuertes. Fuerza +2."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Extremely Strong"
msgstr "Extremadamente Fuerte"

#. ~ Description of mutation "Extremely Strong"
#: data/json/mutations/mutations.json
msgid "Your muscles are much stronger.  +4 Strength."
msgstr "Tus músculos son mucho más fuertes. Fuerza +4."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Insanely Strong"
msgstr "Terriblemente Fuerte"

#. ~ Description of mutation "Insanely Strong"
#: data/json/mutations/mutations.json
msgid "Your muscles are noticeably bulging.  +7 Strength."
msgstr "Tus músculos están llamativamente abultados. +7 Fuerza."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Prime Strength"
msgstr "Fuerza Suprema"

#. ~ Description of mutation "Prime Strength"
#: data/json/mutations/mutations.json
msgid "Your muscles are perfectly developed."
msgstr "Tus músculos están perfectamente desarrollados."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Dextrous"
msgstr "Ágil"

#. ~ Description of mutation "Dextrous"
#: data/json/mutations/mutations.json
msgid "You are a little nimbler.  +1 Dexterity."
msgstr "Eres un poco más ágil. Destreza +1."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Very Dextrous"
msgstr "Muy Ágil"

#. ~ Description of mutation "Very Dextrous"
#: data/json/mutations/mutations.json
msgid "You are nimbler.  +2 Dexterity."
msgstr "Eres más ágil. Destreza +2."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Extremely Dextrous"
msgstr "Extremadamente Ágil"

#. ~ Description of mutation "Extremely Dextrous"
#: data/json/mutations/mutations.json
msgid "You are nimble and quick.  +4 Dexterity."
msgstr "Eres más ágil y rápido. Destreza +4."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Insanely Dextrous"
msgstr "Increiblemente Ágil"

#. ~ Description of mutation "Insanely Dextrous"
#: data/json/mutations/mutations.json
msgid "You are much nimbler than before.  +7 Dexterity."
msgstr "Eres muchisimo más ágil que antes. Destreza +7."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Prime Dexterity"
msgstr "Destreza Suprema"

#. ~ Description of mutation "Prime Dexterity"
#: data/json/mutations/mutations.json
msgid "You're perfectly coordinated."
msgstr "Tienes una coordinación perfecta."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Smart"
msgstr "Inteligente"

#. ~ Description of mutation "Smart"
#: data/json/mutations/mutations.json
msgid "You are a little smarter.  +1 Intelligence."
msgstr "Eres un poco más inteligente. Inteligencia +1."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Very Smart"
msgstr "Muy Inteligente"

#. ~ Description of mutation "Very Smart"
#: data/json/mutations/mutations.json
msgid "You are smarter.  +2 Intelligence."
msgstr "Eres más inteligente. Inteligencia +2."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Extremely Smart"
msgstr "Extremadamente Ingeligente"

#. ~ Description of mutation "Extremely Smart"
#: data/json/mutations/mutations.json
msgid ""
"You are much smarter, and your skull bulges slightly.  +4 Intelligence."
msgstr ""
"Eres mucho más inteligente, y tu cráneo aumentó un poco de tamaño. "
"Inteligencia +4."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Insanely Smart"
msgstr "Terriblemente Inteligente"

#. ~ Description of mutation "Insanely Smart"
#: data/json/mutations/mutations.json
msgid ""
"Your skull bulges noticeably due to your impressive brain.  +7 Intelligence."
msgstr ""
"Tu cráneo se abulta llamativamente debido a tu impresionante cerebro. "
"Inteligencia + 7"

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Prime Intelligence"
msgstr "Inteligencia Suprema"

#. ~ Description of mutation "Prime Intelligence"
#: data/json/mutations/mutations.json
msgid ""
"You understand almost everything about which you think, with minimal effort."
msgstr "Entiendes casi todo lo que puedes pensar, con un esfuerzo mínimo."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Distributed Neurology"
msgstr "Neurología Distribuida"

#. ~ Description of mutation "Distributed Neurology"
#: data/json/mutations/mutations.json
msgid ""
"Your brain has evolved beyond human imagination.  You'll show them the REAL "
"meaning of 'gray goo'!"
msgstr ""
"Tu cerebro ha evolucionado más allá de las posibilidades humanas. ¡Ahora les"
" vas a mostrar el VERDADERO sentido de 'materia gris'!"

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Perceptive"
msgstr "Observador"

#. ~ Description of mutation "Perceptive"
#: data/json/mutations/mutations.json
msgid "Your senses are a little keener.  +1 Perception."
msgstr "Tus sentidos son un poco más agudos. Percepción +1."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Very Perceptive"
msgstr "Muy Observador"

#. ~ Description of mutation "Very Perceptive"
#: data/json/mutations/mutations.json
msgid "Your senses are keener.  +2 Perception."
msgstr "Tus sentidos son más agudos. Percepción +2."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Extremely Perceptive"
msgstr "Extremadamente Observador"

#. ~ Description of mutation "Extremely Perceptive"
#: data/json/mutations/mutations.json
msgid "Your senses are much keener.  +4 Perception."
msgstr "Tus sentidos son mucho más agudos. Percepción +4."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Insanely Perceptive"
msgstr "Increiblemente Observador"

#. ~ Description of mutation "Insanely Perceptive"
#: data/json/mutations/mutations.json
msgid "You can sense things you never imagined.  +7 Perception."
msgstr "Puedes percibir cosas que nunca te imaginaste. Percepción +7."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Prime Perception"
msgstr "Percepción Suprema"

#. ~ Description of mutation "Prime Perception"
#: data/json/mutations/mutations.json
msgid "Your senses are keenly honed."
msgstr "Tus sentidos están perfectamente agudizados."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Sensory Disintegration"
msgstr "Desintegración Sensorial"

#. ~ Description of mutation "Sensory Disintegration"
#: data/json/mutations/mutations.json
msgid ""
"Your sense organs are all over the place: eyes extending and retracting, "
"'ears' of various shapes migrating about, and taste & smell are "
"uncontrollable.  The world is a horrible mixup.  Ugh!"
msgstr ""
"Tus órganos sensoriales están por todos lados: ojos que se extienden y "
"retraen, 'orejas' de diversas formas, y el gusto y el olfato son "
"incontrolables. El mundo es una terrible confusión. ¡Puf!"

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Distributed Senses"
msgstr "Sentidos Distribuidos"

#. ~ Description of mutation "Distributed Senses"
#: data/json/mutations/mutations.json
msgid ""
"You can now extend and reabsorb sensory organs at will, and can therefore "
"ignore most shocks that would overwhelm lesser beings."
msgstr ""
"Ahora puedes extender y reabsorber a voluntad tus órganos sensoriales, y por"
" lo tanto ignorás las conmociones que abrumarían a seres inferiores."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Slimewave"
msgstr "Onda légamo"

#. ~ Description of mutation "Slimewave"
#: data/json/mutations/mutations.json
msgid ""
"You can communicate with your extant mass without physical contact, "
"absorbing knowledge from nearby friendly slime."
msgstr ""
"Te puedes comunicar con la masa restante sin tener contacto físico, "
"absorbiendo el conocimiento de los légamos cercanos."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Very Short"
msgstr ""

#. ~ Description of mutation "Very Short"
#: data/json/mutations/mutations.json
msgid ""
"You are significantly shorter than the general population.  You can't carry "
"quite as much as a person of average height and you need special "
"accommodations to drive a car, but otherwise being little isn't too much of "
"a bother."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Very Tall"
msgstr ""

#. ~ Description of mutation "Very Tall"
#: data/json/mutations/mutations.json
msgid ""
"You are significantly taller than the general population.  This leaves you "
"with high blood pressure, a big appetite, and some minor health concerns, "
"but you can carry a bit more than normal."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Little"
msgstr "Pequeño"

#. ~ Description of mutation "Little"
#: data/json/mutations/mutations.json
msgid ""
"You've noticeably shrunk in size.  You're able to move with increased "
"litheness, but your smaller stature prevents you from carrying as much."
msgstr ""
"Has disminuido notablemente de tamaño. Eres capaz de moverte con mayor "
"ligereza, pero tu menor estatura te impide cargar tanto."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Tiny"
msgstr "Diminuto"

#. ~ Description of mutation "Tiny"
#: data/json/mutations/mutations.json
msgid ""
"You're only half as tall as you used to be!  The weight of things you once "
"found easy to carry is now unbearable, clothes are now twice as encumbering "
"for you unless you refit them (since you're half their size), and your hit "
"points are heavily reduced.  However, your movement is silent, and your "
"dodge skill is a little higher."
msgstr ""
"¡Sólo eres la mitad de alto de lo que solías ser! El peso de las cosas que "
"antes eran fáciles de llevar es ahora insoportable, la ropa es ahora el "
"doble de pesada para ti a menos que la vuelvas a poner (ya que eres la mitad"
" de su tamaño), y tus puntos de golpe son muy reducidos. Sin embargo, tu "
"movimiento es silencioso, y tu habilidad para esquivar es un poco más alta."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Unassuming"
msgstr "Insignificante"

#. ~ Description of mutation "Unassuming"
#: data/json/mutations/mutations.json
msgid ""
"You've mastered your tiny form!  Item encumbrance and carry weight penalties"
" are reduced, and you've learned to use your increased nimbleness to offset "
"your reduced capacity to absorb damage."
msgstr ""
"¡Has dominado tu forma diminuta! Se reducen las penalizaciones por carga y "
"peso, y has aprendido a usar tu mayor agilidad para compensar tu menor "
"capacidad de absorber el daño."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Crafty"
msgstr "Astuto"

#. ~ Description of mutation "Crafty"
#: data/json/mutations/mutations.json
msgid ""
"By making the most of your small stature, you can avoid the notice of all "
"but the most perceptive creatures, and your speed is greatly increased."
msgstr ""
"Aprovechando al máximo tu pequeña estatura, puedes evitar la atención de "
"todas las criaturas, excepto las más perceptivas, y tu velocidad aumenta "
"enormemente."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Metallassomaiphile"
msgstr "Metalasomafilia"

#. ~ Description of mutation "Metallassomaiphile"
#: data/json/mutations/mutations.json
msgid ""
"Just thinking of mutagen (such a lovely word!  'Mutagen'.  Perfect!) makes "
"you thirsty.  And you so love your new parts.  You simply must have more "
"mutagen!"
msgstr ""
"Con solo pensar en mutágeno (¡qué linda palabra! 'Mutágeno'. ¡Perfecta!) te "
"agarra sed. Y te fascinan tus partes nuevas. ¡Necesitas conseguir más "
"mutágeno!"

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Head Bumps"
msgstr "Protuberancias en la Cabeza"

#. ~ Description of mutation "Head Bumps"
#: data/json/mutations/mutations.json
msgid "You have a pair of bumps on your skull."
msgstr "Tienes un par de protuberancias en el cráneo."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Slit Nostrils"
msgstr "Tajos Nasales"

#. ~ Description of mutation "Slit Nostrils"
#: data/json/mutations/mutations.json
msgid ""
"You have a flattened nose and thin slits for nostrils, giving you a lizard-"
"like appearance.  This makes breathing slightly difficult and increases "
"mouth encumbrance by 10."
msgstr ""
"Tienes la nariz aplanada y tus fosas nasales son unos tajos delgados, lo que"
" te da una apariencia de lagarto. Esto te dificulta levemente la respiración"
" e incrementa la incomodidad en tu boca en 10 puntos."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Forked Tongue"
msgstr "Lengua Bífida"

#. ~ Description of mutation "Forked Tongue"
#: data/json/mutations/mutations.json
msgid "Your tongue is forked, like that of a reptile.  This has no effect."
msgstr ""
"Tu lengua está bifurcada, como la de un reptil. Esto no tiene ningún efecto."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Lolling Tongue"
msgstr "Lengua en Movimiento"

#. ~ Description of mutation "Lolling Tongue"
#: data/json/mutations/mutations.json
msgid ""
"Your tongue has lengthened and often extends far beyond your mouth.  This "
"has no effect."
msgstr ""
"La lengua se ha alargado y a menudo se extiende más allá de la boca. Esto no"
" tiene ningún efecto."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Whipping Tongue"
msgstr "Lengua Azotadora"

#. ~ Description of mutation "Whipping Tongue"
#: data/json/mutations/mutations.json
msgid ""
"You've developed an extremely long and mobile tongue.  You may use it to "
"attack your enemies and pull them towards you."
msgstr ""
"Has desarrollado una lengua extremadamente larga y móvil. Puedes usarla para"
" atacar a tus enemigos y atraerlos hacia ti."

#. ~ Message when player with mutation "Whipping Tongue" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "You swipe %s with your tongue!"
msgstr ""

#. ~ Message when NPC with mutation "Whipping Tongue" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "%1$s swipes %2$s with their tongue!"
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Bulging Eyes"
msgstr "Ojos Saltones"

#. ~ Description of mutation "Bulging Eyes"
#: data/json/mutations/mutations.json
msgid ""
"Your eyes bulge out several inches from your skull.  This does not affect "
"your vision in any way."
msgstr ""
"Tus ojos sobresalen mas de 10 cm fuera de tu cráneo. Esto no afecta tu "
"visión de ninguna manera."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Intermediate Eyestalks"
msgstr "Oculares Intermedios"

#. ~ Description of mutation "Intermediate Eyestalks"
#: data/json/mutations/mutations.json
msgid ""
"Your eyes barely protrude from your head on tentacles, preventing the use of"
" any rigid eyewear.  On the plus side, you can have additional awareness, "
"but sometimes your vision goes wonky as your brain tries to process the new "
"angles.  Perception +1"
msgstr ""
"Tus ojos apenas sobresalen de la cabeza gracias a tus tentáculos, lo que "
"impide el uso de gafas rígidas. El lado positivo es que puedes tener una "
"conciencia adicional, pero a veces tu visión se tambalea mientras tu cerebro"
" intenta procesar los nuevos ángulos. Percepción +1"

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Eyestalks"
msgstr "Oculares"

#. ~ Description of mutation "Eyestalks"
#: data/json/mutations/mutations.json
msgid ""
"Your eyes protrude from your head on flexible tentacles, preventing the use "
"of any eyewear.  On the plus side, you can see in two directions at once, "
"and they automatically retract to reduce damage.  Perception +2"
msgstr ""
"Los ojos sobresalen de la cabeza gracias a unos tentáculos flexibles que "
"impiden el uso de cualquier tipo de gafas. El lado positivo es que puedes "
"ver en dos direcciones a la vez y que se retraen automáticamente para "
"reducir el daño. Percepción +2"

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Rigid Eyestalks"
msgstr ""

#. ~ Description of mutation "Rigid Eyestalks"
#: data/json/mutations/mutations.json
msgid ""
"You have compound eyes on rigid stalks that can fold back against your head "
"to protect them from danger.  This gives you better all-around vision and "
"allows you to see underwater, but interferes with eyewear.  Perception +1"
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Mouth Flaps"
msgstr "Aletas Bucales"

#. ~ Description of mutation "Mouth Flaps"
#. ~ Description of mutation "Mouth Tendrils"
#: data/json/mutations/mutations.json
#: data/mods/Aftershock/mutations/mutations.json
msgid ""
"Skin tabs and odd flaps of skin surround your mouth.  They don't affect your"
" eating, but are unpleasant to look at."
msgstr ""
"Unas extrañas aletas y lengüetas de piel rodean tu boca. No te molestan para"
" comer, pero son desagradables de ver."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Wing Stubs"
msgstr "Alas Muñones"

#. ~ Description of mutation "Wing Stubs"
#: data/json/mutations/mutations.json
msgid ""
"You have a pair of stubby little wings projecting from your shoulderblades."
"  They can be wiggled at will, but are useless."
msgstr ""
"Tienes un par de pequeñas alas regordetas que salen de tus omóplatos. Las "
"puedes mover a voluntad, pero no sirven para nada."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Bat Wings"
msgstr "Alas de Murciélago"

#. ~ Description of mutation "Bat Wings"
#: data/json/mutations/mutations.json
msgid ""
"You have a pair of large, leathery wings.  You can move them a little, but "
"they are useless, and in fact put you off balance, reducing your ability to "
"dodge slightly."
msgstr ""
"Tienes un par de alas grandes de cuero. Las puedes mover un poquito, pero no"
" sirven para nada, y de hecho te sacan de balance reduciendo levemente tu "
"habilidad para esquivar."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Butterfly Wings"
msgstr "Alas de Mariposa"

#. ~ Description of mutation "Butterfly Wings"
#: data/json/mutations/mutations.json
msgid ""
"You have a very large pair of brightly-colored, very beautiful wings.  They "
"can't lift you, and they make balancing tricky, but they certainly catch air"
" and attention!"
msgstr ""
"Tienes un par de alas muy grandes, de colores brillantes y muy bonitas. ¡No "
"pueden elevarte y dificultan el equilibrio, pero sin duda atraen el aire y "
"la atención!"

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Pale Skin"
msgstr "Piel Pálida"

#. ~ Description of mutation "Pale Skin"
#: data/json/mutations/mutations.json
msgid "Your skin is rather pale."
msgstr "Tu piel es más bien pálida."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Spots"
msgstr "Manchas"

#. ~ Description of mutation "Spots"
#: data/json/mutations/mutations.json
msgid "Your skin is covered in a pattern of red spots."
msgstr "Tu piel está cubierta con un diseño de manchas rojas."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Smelly"
msgstr "Oloroso"

#. ~ Description of mutation "Smelly"
#: data/json/mutations/mutations.json
msgid ""
"You smell awful.  Monsters that track scent will find you very easily, and "
"humans will react poorly."
msgstr ""
"Tienes una baranda horrible. Los monstruos que te rastrean por tu olor te "
"van a encontrar fácilmente, y los humanos no te van a querer cerca."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Deformed"
msgstr "Deforme"

#. ~ Description of mutation "Deformed"
#: data/json/mutations/mutations.json
msgid ""
"You're slightly deformed.  Some people will react badly to your appearance."
msgstr ""
"Estás ligeramente deformado. Algunas personas reaccionarán mal a tu "
"apariencia."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Badly Deformed"
msgstr "Muy Deforme"

#. ~ Description of mutation "Badly Deformed"
#: data/json/mutations/mutations.json
msgid ""
"You're hideously deformed.  Some people will have a strong negative reaction"
" to your appearance."
msgstr ""
"Estás horriblemente deformado. Alguna gente va a reaccionar muy "
"negativamente a tu apariencia."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Grotesque"
msgstr "Monstruosidad"

#. ~ Description of mutation "Grotesque"
#: data/json/mutations/mutations.json
msgid ""
"Your visage is disgusting and liable to induce vomiting.  People will not "
"want to interact with you unless they have a very good reason to."
msgstr ""
"Tu cara es repugnante y es probable que induzca al vómito. La gente no va a "
"querer interactuar contigo salvo que tengan una muy buena razón para "
"hacerlo."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Beautiful"
msgstr "Hermoso"

#. ~ Description of mutation "Beautiful"
#: data/json/mutations/mutations.json
msgid ""
"You're a real head-turner.  Some people will react well to your appearance, "
"and most people have an easier time trusting you."
msgstr ""
"Eres de esos que hacen girar la cabeza a los demás. Algunos van a reaccionar"
" bien a tu apariencia, y a la mayoría les resultará más fácil confiar en ti."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Very Beautiful"
msgstr "Muy Hermoso"

#. ~ Description of mutation "Very Beautiful"
#: data/json/mutations/mutations.json
msgid ""
"You are a vision of beauty.  Some people will react very well to your looks,"
" and most people will trust you immediately."
msgstr ""
"Posees una vista hermosa. Algunos van a reaccionar muy bien a tu apariencia,"
" y la mayoría van a confiar en ti inmediatamente."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Glorious"
msgstr "Gloria"

#. ~ Description of mutation "Glorious"
#: data/json/mutations/mutations.json
msgid ""
"You are incredibly beautiful.  People cannot help themselves due to your "
"charms, and will do whatever they can to please you."
msgstr ""
"Tienes una belleza increible. La gente no pueden escapar a tus encantos, y "
"harán cualquier cosa para complacerte."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Snout"
msgstr "Hocico"

#. ~ Description of mutation "Snout"
#: data/json/mutations/mutations.json
msgid ""
"Your face and jaw have begun… changing.  Masks and such fit OK, but you're "
"noticeably mutated."
msgstr ""
"Tu cara y tu mandíbula han empezado... a cambiar. Las máscaras y el ajuste "
"están bien, pero estás visiblemente mutado."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Bovine Snout"
msgstr "Hocico Bovino"

#. ~ Description of mutation "Bovine Snout"
#: data/json/mutations/mutations.json
msgid ""
"Your face resembles that of a bull, with a significant snout.  It looks "
"fearsome but prevents wearing mouthgear."
msgstr ""
"Tu cara se parece a la de un toro, con un hocico significativo. Parece "
"temible pero evita el uso de aparatos bucales."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Lupine Muzzle"
msgstr "Hocico Lupino"

#. ~ Description of mutation "Lupine Muzzle"
#: data/json/mutations/mutations.json
msgid ""
"Your jaw and nose have extended into a wolfish muzzle.  It lends itself to "
"biting in combat and looks impressive, but prevents wearing mouthgear."
msgstr ""
"Tu mandíbula y nariz se extienden formando un hocico como el de un lobo. "
"Viene bien para morder en combate y se ve impresionante, pero te impide usar"
" cosas sobre la boca."

#. ~ Message when player with mutation "Lupine Muzzle" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "You nip at %s!"
msgstr "¡Le das un mordisco al %s!"

#. ~ Message when NPC with mutation "Lupine Muzzle" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "%1$s nips and harries %2$s!"
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Ursine Muzzle"
msgstr "Hocico Osuno"

#. ~ Description of mutation "Ursine Muzzle"
#: data/json/mutations/mutations.json
msgid ""
"Your jaw and nose have extended into a bearish muzzle.  You could bite with "
"it, and it looks impressive, but it prevents wearing mouthgear."
msgstr ""
"Tu mandíbula y nariz se han extendido en un hocico de oso. Podrías morder "
"con él, y se ve impresionante, pero evita el uso de aparatos bucales."

#. ~ Message when player with mutation "Ursine Muzzle" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "You bite %s!"
msgstr "¡Muerdes a %s!"

#. ~ Message when NPC with mutation "Ursine Muzzle" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "%1$s bites %2$s!"
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Rodent Muzzle"
msgstr "Hocico de roedores"

#. ~ Description of mutation "Rodent Muzzle"
#: data/json/mutations/mutations.json
msgid ""
"Your face and jaw have extended, giving you an alert and attentive "
"appearance."
msgstr ""
"Tu cara y mandíbula se han extendido, lo que te da una apariencia alerta y "
"atenta."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Reptilian Muzzle"
msgstr "Hocico Reptiliano"

#. ~ Description of mutation "Reptilian Muzzle"
#: data/json/mutations/mutations.json
msgid ""
"Your face and jaws are a shorter version of those found on alligators.  They"
" look NASTY--as do the bite wounds they can inflict--but prevent wearing "
"mouthgear."
msgstr ""
"Tu cara y tus mandíbulas son una versión más corta de las que se encuentran "
"en los caimanes. Tienen un aspecto TERRIBLE, al igual que las heridas de "
"mordedura que pueden infligir, pero impide el uso de aparatos bucales."

#. ~ Message when player with mutation "Reptilian Muzzle" attacks
#. ~ Message when player with mutation "Scaled Mouth" attacks
#. ~ Message when player with mutation "Black Dragon Maw" attacks
#: data/json/mutations/mutations.json
#: data/mods/Magiclysm/mutations/mutations.json
#, c-format
msgid "You bite a chunk out of %s!"
msgstr "¡Le arrancás un pedazo de una mordida al %s!"

#. ~ Message when NPC with mutation "Reptilian Muzzle" attacks
#. ~ Message when NPC with mutation "Scaled Mouth" attacks
#. ~ Message when NPC with mutation "Black Dragon Maw" attacks
#: data/json/mutations/mutations.json
#: data/mods/Magiclysm/mutations/mutations.json
#, c-format
msgid "%1$s bites a chunk out of %2$s!"
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Wide Mouth"
msgstr "Boca Ancha"

#. ~ Description of mutation "Wide Mouth"
#: data/json/mutations/mutations.json
msgid ""
"Your face and jaws have widened like a frogs.  It looks hideous but it "
"allows you to eat food whole."
msgstr ""
"Tu cara y tus mandíbulas se han ensanchado como las de una rana. Tiene un "
"aspecto horrible, pero te permite comer alimentos enteros."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Proboscis"
msgstr "Probóscide"

#. ~ Description of mutation "Proboscis"
#: data/json/mutations/mutations.json
msgid ""
"You've gotten rid of that terribly imprecise mouth and now imbibe your food "
"like a proper person.  Chewing was tiresome anyway."
msgstr ""
"Te liberaste de esa boca terriblemente imprecisa y ahora absorbes tu comida "
"por tu trompa como una persona correcta. De todas formas, masticar era "
"agotador."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Hollow Bones"
msgstr "Huesos Huecos"

#. ~ Description of mutation "Hollow Bones"
#: data/json/mutations/mutations.json
#, no-c-format
msgid ""
"You have Avian Bone Syndrome--your bones are nearly hollow.  Your body is "
"very light as a result, enabling you to move and attack 20% faster, but also"
" frail; you can carry 40% less, and bashing attacks injure you more."
msgstr ""
"Tienes el Síndrome de los Huesos Aviarios -tus huesos son casi huecos. Como "
"resultado tu cuerpo es muy liviano, lo que te permite moverte y atacar un "
"20% más rápido, pero también es frágil. Puedes cargar un 40% menos, y los "
"ataques contundentes te causan más daño."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Dense Bones"
msgstr ""

#. ~ Description of mutation "Dense Bones"
#: data/json/mutations/mutations.json
#, no-c-format
msgid ""
"Your bones are particularly dense and durable.  Your tougher frame grants 5%"
" more HP and 15% more carry capacity plus bashing attacks injure you less, "
"but your higher weight makes attacking and moving 5% slower.  Also, dodging "
"and swimming are harder."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Nausea"
msgstr "Náusea"

#. ~ Description of mutation "Nausea"
#: data/json/mutations/mutations.json
msgid ""
"You feel nauseated almost constantly, and are more liable to throw up from "
"food poisoning, alcohol, etc.  You can, if desired, think yourself into "
"vomiting, too."
msgstr ""
"Sientes náuseas casi constantemente, y eres más propenso a vomitar por "
"intoxicación alimentaria, alcohol, etc. Tu puedes, si lo deseas, pensar en "
"vomitar, también."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Vomitous"
msgstr "Vómitos"

#. ~ Description of mutation "Vomitous"
#: data/json/mutations/mutations.json
msgid ""
"You have a major digestive disorder.  Though it causes you to vomit "
"frequently, you have found that you can trigger your vomit reflex on demand,"
" too."
msgstr ""
"Tienes un desorden alimenticio grave. Aunque te causa vomitar con "
"frecuencia, descubriste que puedes hacerte vomitar cuando quieras."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Persistence Hunter"
msgstr "Cazador Persistente"

#. ~ Description of mutation "Persistence Hunter"
#: data/json/mutations/mutations.json
msgid ""
"You can pursue prey for miles and miles at a variety of paces until they "
"stop from exhaustion."
msgstr ""
"Puedes perseguir presas durante kilómetros y kilómetros a distintos ritmos "
"hasta que se detengan debido al agotamieto."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Extreme Persistence Hunter"
msgstr "Cazador Persistente Extremo"

#. ~ Description of mutation "Extreme Persistence Hunter"
#: data/json/mutations/mutations.json
msgid ""
"You can pursue prey for days until they literally die from exhaustion.  It's"
" too bad zombies don't fatigue either."
msgstr ""
"Puedes perseguir a las presas durante días hasta que mueran literalmente de "
"agotamiento. Es una pena que los zombis tampoco se fatiguen."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Fast Metabolism"
msgstr "Metabolismo Veloz"

#. ~ Description of mutation "Fast Metabolism"
#. ~ Description of mutation "Constant Eater"
#: data/json/mutations/mutations.json
#: data/mods/Aftershock/mutations/obsolete.json
msgid ""
"You require more food than most people, but recover stamina slightly faster."
msgstr ""
"Necesitas más comida que la mayoría de la gente, pero recuperas tu vigor "
"ligeramente más rápido."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Rapid Metabolism"
msgstr "Metabolismo Rápido"

#. ~ Description of mutation "Rapid Metabolism"
#: data/json/mutations/mutations.json
msgid ""
"You require more resources than most, but heal more rapidly as well.  "
"Provides weak regeneration even when not asleep."
msgstr ""
"Requiere más recursos que la mayoría, pero también se cura más rápidamente. "
"Proporciona una débil regeneración incluso cuando no está dormido."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Very Fast Metabolism"
msgstr "Metabolismo Muy Rápido"

#. ~ Description of mutation "Very Fast Metabolism"
#: data/json/mutations/mutations.json
msgid ""
"You need about twice as much food as the average human to maintain your "
"expanded cardiovascular and respiratory systems.  On the plus side, it "
"doesn't take you much time to recover from any strenuous activity."
msgstr ""
"Necesitas más o menos el doble de comida que un humano promedio para "
"mantener tu sistema respiratorio y cardiovascular. La ventaja es que no "
"tardas mucho tiempo en recuperarte de cualquier actividad extenuante."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Extreme Metabolism"
msgstr "Metabolismo Extremo"

#. ~ Description of mutation "Extreme Metabolism"
#: data/json/mutations/mutations.json
msgid ""
"You consume three times as much food as the average human to maintain your "
"truly superhuman endurance."
msgstr ""
"Consumes tres veces más comida que el humano medio para mantener tu "
"resistencia verdaderamente sobrehumana."

#. ~ Mutation name
#: data/json/mutations/mutations.json
#: data/mods/Aftershock/mutations/obsolete.json
msgid "High Thirst"
msgstr "Alta Sed"

#. ~ Description of mutation "High Thirst"
#: data/json/mutations/mutations.json
msgid "Your body dries out easily; you need to drink more water."
msgstr "Tu cuerpo se seca con facilidad; necesitas beber más agua."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Very Thirsty"
msgstr "Mucha Sed"

#. ~ Description of mutation "Very Thirsty"
#. ~ Description of mutation "Giant Thirst"
#: data/json/mutations/mutations.json
#: data/mods/Aftershock/mutations/obsolete.json
msgid ""
"Ugh, out of water already?  You need about twice the fluids of an average "
"human."
msgstr ""
"Puf, ¿otra vez sin agua? Necesitas más o menos el doble de fluidos que una "
"persona normal."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Extremely Thirsty"
msgstr "Sed Extrema"

#. ~ Description of mutation "Extremely Thirsty"
#: data/json/mutations/mutations.json
msgid ""
"You dry out seriously quickly, requiring three times as much liquid to stay "
"hydrated."
msgstr ""
"Te secas verdaderamente rápido, por lo que necesitas tres veces más de "
"líquido para mantenerte hidratado."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Metabolic Rehydration"
msgstr "Rehidratación Metabólica"

#. ~ Description of mutation "Metabolic Rehydration"
#: data/json/mutations/mutations.json
msgid ""
"Your body gets everything it needs from the food that you eat!  You no "
"longer need hydration from fluids."
msgstr ""
"Tu cuerpo obtiene todo lo que necesita de los alimentos que comes. Ya no "
"necesitas hidratarte con fluidos."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Very Heavy Sleeper"
msgstr "Sueño Muy Pesado"

#. ~ Description of mutation "Very Heavy Sleeper"
#: data/json/mutations/mutations.json
msgid "You could probably sleep through a firefight."
msgstr "Probablemente, podrías dormir durante un tiroteo."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Very Sleepy"
msgstr "Mucho Sueño"

#. ~ Description of mutation "Very Sleepy"
#: data/json/mutations/mutations.json
msgid ""
"You find yourself needing to sleep quite often.  You'll spend about half of "
"your time in or around a bed."
msgstr ""
"Te encuentras con la necesidad de dormir bastante a menudo. Pasarás la mitad"
" del tiempo en o alrededor de la cama."

#. ~ Mutation name
#. ~ Spell name
#: data/json/mutations/mutations.json
#: data/mods/Xedra_Evolved/spells/eater_spells.json
msgid "Weakening"
msgstr "Debilitándote"

#. ~ Description of mutation "Weakening"
#: data/json/mutations/mutations.json
msgid ""
"You feel as though you are slowly weakening and your body heals slower."
msgstr ""
"Sientes como si te debilitaras lentamente y tu cuerpo se curara más "
"lentamente."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Deterioration"
msgstr "Deterioración"

#. ~ Description of mutation "Deterioration"
#: data/json/mutations/mutations.json
msgid "Your body is very slowly wasting away."
msgstr "Muy lentamente, tu cuerpo se va quedando en piel y hueso."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Disintegration"
msgstr "Desintegración"

#. ~ Description of mutation "Disintegration"
#: data/json/mutations/mutations.json
msgid "Your body is slowly wasting away!"
msgstr "¡Lentamente, tu cuerpo se va quedando en piel y hueso!"

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Solar Sensitivity"
msgstr "Sensibilidad Solar"

#. ~ Description of mutation "Solar Sensitivity"
#: data/json/mutations/mutations.json
msgid ""
"Your skin simply cannot handle ultraviolet radiation, such as sunlight.  It "
"will seriously burn you."
msgstr ""
"Tu piel no puede soportar la radiación ultravioleta, como la luz del solar. "
"Te va a quemar seriamente."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Sores"
msgstr "Llagas"

#. ~ Description of mutation "Sores"
#: data/json/mutations/mutations.json
msgid ""
"Your extremities are covered in painful sores.  The pain is worse when they "
"are covered in clothing."
msgstr ""
"Tus extremidades están cubiertas de dolorosas llagas. El dolor es peor "
"cuando tienes puesta alguna ropa."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Light Sensitive"
msgstr "Sensible a la Luz"

#. ~ Description of mutation "Light Sensitive"
#: data/json/mutations/mutations.json
msgid ""
"Sunlight makes you uncomfortable.  If you are outdoors and the weather is "
"Sunny, you suffer -1 to all stats."
msgstr ""
"La luz del sol te molesta. Si estás afuera y el clima está soleado, sufres "
"una penalización de -1 en todos tus atributos."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Very Light Sensitive"
msgstr "Muy Sensible a la Luz"

#. ~ Description of mutation "Very Light Sensitive"
#: data/json/mutations/mutations.json
msgid ""
"Sunlight makes you very uncomfortable.  If you are outdoors during the day, "
"you suffer -1 to all stats; -2 if the weather is Sunny."
msgstr ""
"La luz del sol te molesta mucho. Si estás afuera durante el día, sufres una "
"penalización de -1 en todos tus atributos, y -2 si el clima está soleado."

#. ~ Description of mutation "Troglobite"
#: data/json/mutations/mutations.json
msgid ""
"Sunlight makes you extremely uncomfortable, resulting in large penalties to "
"all stats."
msgstr ""
"La luz del sol te molesta extremadamente, lo que resulta en penalidades "
"grandes para tus atributos."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Webbed Hands"
msgstr "Manos Palmeadas"

#. ~ Description of mutation "Webbed Hands"
#: data/json/mutations/mutations.json
msgid ""
"Your hands are heavily webbed, reducing your Dexterity by 1 and causing "
"problems with gloves.  However, you can swim much faster.  Slightly "
"decreases wet penalties."
msgstr ""
"Tus manos están palmeadas, lo que reduce tu Destreza 1 punto y te dificulta "
"usar guantes. Sin embargo, puedes nadar mucho más rápido. Disminuye "
"levemente las desventajas por estar húmedo."

#. ~ Mutation name
#: data/json/mutations/mutations.json
#: data/mods/Magiclysm/mutations/fantasy_species.json
msgid "Webbed Feet"
msgstr "Pies Palmeados"

#. ~ Description of mutation "Webbed Feet"
#: data/json/mutations/mutations.json
#: data/mods/Magiclysm/mutations/fantasy_species.json
msgid ""
"Your feet are heavily webbed, allowing you to swim faster if you aren't "
"wearing footwear."
msgstr ""
"Tus pies están palmeados, lo que te permite nadar más rápido si no tienes "
"puesto ningún calzado."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Paws"
msgstr "Patas"

#. ~ Description of mutation "Paws"
#: data/json/mutations/mutations.json
msgid ""
"Your hands have fused into quasi-paws.  Fine manipulation is a challenge: "
"permanent hand encumbrance of 10, difficulty with delicate craftwork, and "
"your gloves don't fit.  But they handle water better and bear weight well, "
"allowing you to move on all fours when crouching and unarmed."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Broad Paws"
msgstr "Patas Anchas"

#. ~ Description of mutation "Broad Paws"
#: data/json/mutations/mutations.json
msgid ""
"Your paws are much larger now.  Manual dexterity is difficult: permanent "
"hand encumbrance of 20, serious problems crafting, and no gloves.  In "
"return, though, you can swim better and move on all fours when crouching and"
" unarmed."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Beak"
msgstr "Pico"

#. ~ Description of mutation "Beak"
#: data/json/mutations/mutations.json
msgid ""
"You have a beak for a mouth.  You can occasionally use it to peck at your "
"enemies, but it is impossible for you to wear mouth gear.  Slightly reduces "
"wet effects."
msgstr ""
"Tienes un pico en lugar de la boca. Ocasionalmente, lo puedes usar para "
"picar a tus enemigos, pero es imposibles usar algo sobre tu cara. Disminuye "
"levemente los efectos de estar mojado."

#. ~ Message when player with mutation "Beak" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "You peck %s!"
msgstr "¡Picoteas %s!"

#. ~ Message when NPC with mutation "Beak" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "%1$s pecks %2$s!"
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Woodpecker Beak"
msgstr "Pico de Pájaro Carpintero"

#. ~ Description of mutation "Woodpecker Beak"
#: data/json/mutations/mutations.json
msgid ""
"Pecking at prey is part of your daily routine now.  Slightly reduces wet "
"effects."
msgstr ""
"Picar a tus presas se ha convertido en parte de tu rutina diaria. Disminuye "
"levemente los efectos de estar mojado."

#. ~ Message when player with mutation "Woodpecker Beak" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "You jackhammer into %s with your beak!"
msgstr "¡Taladrás en el %s con tu pico hidráulico!"

#. ~ Message when NPC with mutation "Woodpecker Beak" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "%1$s jackhammer into %2$s with their beak!"
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Hummingbird Beak"
msgstr "Pico de Picaflor"

#. ~ Description of mutation "Hummingbird Beak"
#: data/json/mutations/mutations.json
msgid ""
"Though your beak's not suitable for pecking, those flowers out there are a "
"good source of energy.  Examine them to feed."
msgstr ""
"Aunque tu pico no es apropiado para picar, esas flores que andan por ahí son"
" una buena fuente de energía. Examinalas para alimentarte."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Genetically Unstable"
msgstr "Genéticamente Inestable"

#. ~ Description of mutation "Genetically Unstable"
#: data/json/mutations/mutations.json
msgid ""
"Your DNA has been damaged in a way that causes you to continually develop "
"more mutations."
msgstr ""
"Tu ADN ha sido dañado de una manera que te causa desarrollar mutaciones "
"continuamente."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Catastrophic Mutation"
msgstr ""

#. ~ Description of mutation "Catastrophic Mutation"
#: data/json/mutations/mutations.json
msgid ""
"Exposure to portal storms and related phenomena causes you to mutate in a "
"mostly predictable fashion."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Genetic Chaos"
msgstr "Caos Genético"

#. ~ Description of mutation "Genetic Chaos"
#: data/json/mutations/mutations.json
msgid ""
"Your body alters itself rapidly, and without your intervention or conscious "
"control."
msgstr ""
"Tu cuerpo se altera muy rápidamente, y sin que tú tengas ningún control "
"sobre eso."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Minor Radioactivity"
msgstr "Radiactividad Menor"

#. ~ Description of mutation "Minor Radioactivity"
#: data/json/mutations/mutations.json
msgid ""
"Your body has become radioactive!  You continuously emit low levels of "
"radiation, which slowly contaminates the world around you."
msgstr ""
"¡Tu cuerpo se ha vuelto radiactivo! Estás continuamente emitiendo niveles "
"bajos de radiación, que contamina lentamente el mundo que te rodea."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Radioactivity"
msgstr "Radiactividad"

#. ~ Description of mutation "Radioactivity"
#: data/json/mutations/mutations.json
msgid ""
"Your body has become radioactive!  You continuously emit moderate levels of "
"radiation, which contaminates the world around you."
msgstr ""
"¡Tu cuerpo se ha vuelto radiactivo! Estás continuamente emitiendo niveles "
"medios de radiación, que contamina el mundo que te rodea."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Severe Radioactivity"
msgstr "Radiactividad Severa"

#. ~ Description of mutation "Severe Radioactivity"
#: data/json/mutations/mutations.json
msgid ""
"Your body has become radioactive!  You continuously emit heavy levels of "
"radiation, making your surroundings unlivable."
msgstr ""
"¡Tu cuerpo se ha vuelto radiactivo! Estás continuamente emitiendo grandes "
"niveles de radiación, lo que vuelve inhabitables tus alrededores."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Slimy"
msgstr "Babosidad"

#. ~ Description of mutation "Slimy"
#: data/json/mutations/mutations.json
msgid ""
"Your body is coated with a fine slime which makes uncovered skin harder to "
"grab and protects from long-term effects of acid, though not short-term "
"ones.  Greatly increases wet benefits."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Viscous"
msgstr "Viscosidad"

#. ~ Description of mutation "Viscous"
#: data/json/mutations/mutations.json
msgid ""
"Your body's slime output has become sticky and gel-like, making uncovered "
"skin harder to grab and offering some protection from acid.  Greatly "
"increases wet benefits."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Amorphous Body"
msgstr "Cuerpo Amorfo"

#. ~ Description of mutation "Amorphous Body"
#: data/json/mutations/mutations.json
msgid ""
"Your flesh is a pleasing gel-like consistency.  Your bodily functions seem "
"to be moving around, and your leg-equivalents flow comfortably - if a little"
" slower than your old meat-legs."
msgstr ""
"Tu carne tiene una consistencia gelatinosa agradable. Tus funciones "
"corporales parecen moverse, y sus equivalentes en las piernas fluyen "
"cómodamente, aunque un poco más despacio que tus antiguas piernas de carne."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Omnicellular"
msgstr "Omnicelular"

#. ~ Description of mutation "Omnicellular"
#: data/json/mutations/mutations.json
msgid ""
"Your body is more or less one consistent whole: a single, giant, omni-cell "
"that alters itself as needed."
msgstr ""
"Tu cuerpo es más o menos un todo consistente: una omnicélula sola, gigante, "
"que se altera a sí misma según sea necesario."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Herbivore"
msgstr "Herbívoro"

#. ~ Description of mutation "Herbivore"
#: data/json/mutations/mutations.json
msgid ""
"Your body's ability to digest meat is severely hampered.  Eating meat has a "
"good chance of making you vomit it back up; even if you manage to keep it "
"down, its nutritional value is greatly reduced."
msgstr ""
"La capacidad de tu cuerpo para digerir carne está muy limitada. Hay mucha "
"probabilidad de que comer carne te haga vomitar, e incluso cuando la puedes "
"mantener adentro, su valor nutricional se reduce mucho."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Carnivore"
msgstr "Carnívoro"

#. ~ Description of mutation "Carnivore"
#: data/json/mutations/mutations.json
msgid ""
"Your body's ability to digest fruits, vegetables, grains and nuts is "
"severely hampered.  You cannot eat anything besides meat."
msgstr ""
"La capacidad de tu cuerpo para digerir frutas, verduras, granos y nueces "
"está severamente obstaculizada. No puedes comer nada más que carne."

#. ~ Mutation name
#: data/json/mutations/mutations.json
#: data/mods/Aftershock/mutations/obsolete.json
msgid "Ponderous"
msgstr "Pesado"

#. ~ Description of mutation "Ponderous"
#: data/json/mutations/mutations.json
#, no-c-format
msgid "Your muscles are generally slow to move.  You move 10% slower."
msgstr ""
"Tus músculos son generalmente lentos en sus movimientos. Te mueves un 10% "
"más lento."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Very Ponderous"
msgstr "Muy Pesado"

#. ~ Description of mutation "Very Ponderous"
#: data/json/mutations/mutations.json
#, no-c-format
msgid "Your muscles are quite slow to move.  You move 20% slower."
msgstr ""
"Tus músculos son bastante lentos en sus movimientos. Te mueves un 20% más "
"lento."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Extremely Ponderous"
msgstr "Extremadamente Pesado"

#. ~ Description of mutation "Extremely Ponderous"
#: data/json/mutations/mutations.json
#, no-c-format
msgid "Your muscles are very slow to move.  You move 30% slower."
msgstr ""
"Tus músculos son muy lentos en sus movimientos. Te mueves un 30% más lento."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Sunlight Dependent"
msgstr "Dependiente del Sol"

#. ~ Description of mutation "Sunlight Dependent"
#: data/json/mutations/mutations.json
#, no-c-format
msgid ""
"You feel very sluggish when not in direct sunlight.  You suffer a 5% drop in"
" speed when in shade, and a 10% drop in speed when in the dark."
msgstr ""
"Te sientes con muy poco vigor cuando no estás expuesto a la luz del sol. "
"Sufres una caída del 5% en tu velocidad cuando estás en la sombra, y un 10% "
"cuando está oscuro."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Vines"
msgstr "Enredaderas"

#. ~ Description of mutation "Vines"
#: data/json/mutations/mutations.json
msgid ""
"You have developed several vines sprouting from your shoulder area.  They're"
" bulky, and get in the way."
msgstr ""
"Has desarrollado varias enredaderas que brotan de la zona de tus hombros. "
"Son voluminosas y estorban."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Vine Limbs"
msgstr "Miembros Enredaderas"

#. ~ Description of mutation "Vine Limbs"
#: data/json/mutations/mutations.json
msgid ""
"You've developed the ability to control your vines; they make good lashes.  "
"You can even rappel down sheer drops using them, but disconnecting HURTS."
msgstr ""
"Has desarrollado la capacidad de control tus enredaderas; sirven como "
"látigos. Incluso las puedes usar para descender por superficies verticales, "
"pero soltarlas DUELE."

#. ~ Message when player with mutation "Vine Limbs" attacks
#. ~ Message when player with mutation "Vine Sprouter" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "You lash %s with one of your vines!"
msgstr ""

#. ~ Message when NPC with mutation "Vine Limbs" attacks
#. ~ Message when NPC with mutation "Vine Sprouter" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "%1$s lashes %2$s with one of their vines!"
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Vine Sprouter"
msgstr "Germinador de Enredaderas"

#. ~ Description of mutation "Vine Sprouter"
#: data/json/mutations/mutations.json
msgid ""
"You have full control of your vines, and can grow new ones and detach old "
"ones more or less at will."
msgstr ""
"Tienes control total sobre tus enredaderas, y puedes hacer crecer nuevas y "
"soltar las viejas, casi a voluntad."

#. ~ Message when spawning item "vine_30" with mutation "Vine Sprouter"
#: data/json/mutations/mutations.json
msgid "You detach a vine from your body."
msgstr "Te sacás una liana de tu cuerpo."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Hair Roots"
msgstr "Pelo de raíces"

#. ~ Description of mutation "Hair Roots"
#: data/json/mutations/mutations.json
msgid ""
"Roots have started growing from your leaf-like hair.  They don't seem to do "
"much."
msgstr ""
"Las raíces han empezado a crecer de tus pelo hojas, no parecen funcionar "
"para mucho."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Toe Roots"
msgstr "Dedos Raíces"

#. ~ Description of mutation "Toe Roots"
#: data/json/mutations/mutations.json
msgid ""
"Your toes have grown wriggly, and you can't imagine why you wear that stuff "
"on your feet.  Take it off.  It's in the way."
msgstr ""
"Tus dedos de los pies han crecido retorcidos, y no te puedes ni imaginar por"
" qué tienes calzado en los pies. Saquítelo, te molesta."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Roots"
msgstr "Raíces"

#. ~ Description of mutation "Roots"
#. ~ The idea is that you, for lack of a better term, plant yourself.
#. Crafting and digging don't count because they presume a certain amount of
#. movement during the task.  The handheld game does count.
#: data/json/mutations/mutations.json
msgid ""
"It's about time you started developing a root system.  When reading, "
"fishing, waiting, or otherwise being stationary for a while on diggable "
"terrain, you'll extract nutrients and water from the soil."
msgstr ""
"Ya es hora de que empezaras a desarrollar un sistema de raíces. Cuando leas,"
" pesques, esperes o estés parado por un tiempo en un terreno excavable, "
"extraerás los nutrientes y el agua del suelo."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Rooter"
msgstr "Arraigador"

#. ~ Description of mutation "Rooter"
#: data/json/mutations/mutations.json
msgid ""
"You find it difficult not to sink roots when able.  You extract nutrients "
"and water whenever on diggable terrain, but move more slowly."
msgstr ""
"Te cuesta no clavar tu raíces cada vez que puedes. Vas a extraer los "
"nutrientes y agua cuando estés sobre terreno cavable, pero te vas a mover "
"más lento."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Chloromorphosis"
msgstr "Cloromorfosis"

#. ~ Description of mutation "Chloromorphosis"
#: data/json/mutations/mutations.json
msgid ""
"You've truly become a walking plant, though you mostly feel like sleeping in"
" the sunshine.  When you do, your roots and bark will take in more nutrients"
" than ever."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Mycorrhizal Communion"
msgstr "Comunión micorrízica"

#. ~ Description of mutation "Mycorrhizal Communion"
#: data/json/mutations/mutations.json
msgid ""
"You have gained the ability to commune with trees and comprehend their "
"ancient wisdom.  Activate next to a tree to gradually gain overmap vision "
"through connected forests."
msgstr ""
"Has ganado la habilidad de estar en comunión con los árboles y comprender su"
" antigua sabiduría. Activar junto a un árbol para obtener gradualmente una "
"visión sobre el mapa a través de los bosques conectados."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Heat Dependent"
msgstr "Dependiente del Calor"

#. ~ Description of mutation "Heat Dependent"
#: data/json/mutations/mutations.json
#, no-c-format
msgid ""
"Your muscle response is dependent on ambient temperatures.  You lose 1% of "
"your speed for every 5 (2.8) degrees below 65 F (18.3 C).  This sluggishness"
" helps you conserve energy, however."
msgstr ""
"Su respuesta muscular depende de la temperatura ambiente. Pierdes el 1% de "
"tu velocidad por cada 5 (2,8) grados por debajo de 65 F (18,3 C). Sin "
"embargo, esta lentitud te ayuda a conservar la energía."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Very Heat Dependent"
msgstr "Muy Dependiente del Calor"

#. ~ Description of mutation "Very Heat Dependent"
#: data/json/mutations/mutations.json
#, no-c-format
msgid ""
"Your muscle response is highly dependent on ambient temperatures.  You lose "
"1% of your speed for every 3 (1.7) degrees below 65 F (18.3 C), but your "
"slow metabolism requires much less energy."
msgstr ""
"Tu respuesta muscular depende mucho de la temperatura ambiental. Pierdes 1% "
"de tu velocidad por cada 1.7 ºC (3 ºF) por debajo de 18.3 ºC (65 ºF) pero tu"
" lento metabolismo necesita mucha menos energía."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Cold Blooded"
msgstr "Sangre Fría"

#. ~ Description of mutation "Cold Blooded"
#: data/json/mutations/mutations.json
#, no-c-format
msgid ""
"You are cold-blooded and rely on heat to keep moving.  Your lose 1% of your "
"speed for every 2 (1.1) degrees below 65 F (18.3 C), resulting in less "
"calorie usage."
msgstr ""
"Tienes sangre fría y dependes del calor para poder funcionar. Pierdes un  1%"
" de tu velocidad por cada 1.1 ºC (2 ºF) por debajo de 18.3 ºC (65 ºF) lo que"
" resulta en un consumo menor de calorías."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Ectothermic"
msgstr "Ectotérmicidad"

#. ~ Description of mutation "Ectothermic"
#: data/json/mutations/mutations.json
#, no-c-format
msgid ""
"Your body has become permanently cold-blooded.  Your speed lowers or raises "
"1% for every 2 (1.1) degrees below or above 65 F (18.3 C).  You eat much "
"less than you otherwise would."
msgstr ""
"Ahora tu cuerpo se ha vuelto permanentemente de sangre fría. Tu velocidad "
"disminuye o aumenta un 1% por cada 1.1 ºC (2 ºF) por debajo o por encima de "
"18.3 ºC (65 ºF). Y vas a comer mucho menos que antes."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Growling Voice"
msgstr "Gruñido"

#. ~ Description of mutation "Growling Voice"
#: data/json/mutations/mutations.json
msgid ""
"You have a growling, rough voice.  Persuading NPCs will be more difficult, "
"but threatening them will be easier."
msgstr ""
"Tienes una voz áspera, como un gruñido. Te va a resultar más difícil "
"persuadir a los PNJ, pero amenazarlos va a ser más fácil."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Croaking Voice"
msgstr "Voz de Rana"

#. ~ Description of mutation "Croaking Voice"
#: data/json/mutations/mutations.json
msgid ""
"You have a low, croaking voice, like an aged grandparent.  Persuading NPCs "
"will be easier, but threatening them will be more difficult."
msgstr ""
"Tienes una voz grave y croante, como la de un abuelo anciano. Persuadir a "
"los PNJ será más fácil, pero amenazarlos será más difícil."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Snarling Voice"
msgstr "Rugidor"

#. ~ Description of mutation "Snarling Voice"
#: data/json/mutations/mutations.json
msgid ""
"You have a threatening snarl in your voice.  Persuading NPCs will be near "
"impossible, but threatening them will be much easier."
msgstr ""
"Tienes un rugido amenazante en tu voz. Te va a resultar casi imposible "
"persuadir a los PNJ, pero amenazarlos va a ser mucho más fácil."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Hissing Voice"
msgstr "Siseador"

#. ~ Description of mutation "Hissing Voice"
#: data/json/mutations/mutations.json
msgid ""
"You hiss when speaking.  Persuading NPCs will be more difficult, but "
"threatening them will be easier."
msgstr ""
"Siseas cuando hablas. Te va a resultar más difícil persuadir a los PNJ, pero"
" amenazarlos va a ser más fácil."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Screeching Voice"
msgstr ""

#. ~ Description of mutation "Screeching Voice"
#: data/json/mutations/mutations.json
msgid ""
"Your voice sounds like a bird trying to imitate a human.  Persuading NPCs "
"will be more difficult, but threatening them will be easier."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Shouter"
msgstr "Gritador"

#. ~ Description of mutation "Shouter"
#: data/json/mutations/mutations.json
msgid "You occasionally shout uncontrollably."
msgstr "Ocasionalmente, se te escapa un grito."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Screamer"
msgstr "Gritón"

#. ~ Description of mutation "Screamer"
#: data/json/mutations/mutations.json
msgid "You sometimes scream uncontrollably."
msgstr "Ocasionalmente, se te escapa un alarido."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Howler"
msgstr "Aullador"

#. ~ Description of mutation "Howler"
#: data/json/mutations/mutations.json
msgid "You frequently let out a piercing howl."
msgstr "Frecuentemente, dejas escapar un aullido agudo."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Feathered Arms"
msgstr "Brazos con Plumas"

#. ~ Description of mutation "Feathered Arms"
#: data/json/mutations/mutations.json
msgid ""
"Your arms have sprouted feathers, and you find you can no longer fully "
"extend your elbows.  This gets in the way a bit, but the feathers offer "
"minor protection from damage and the elements."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Insect Limbs"
msgstr "Miembros de Insecto"

#. ~ Description of mutation "Insect Limbs"
#: data/json/mutations/mutations.json
msgid ""
"You've *finally* sprouted a pair of arms from your midsection.  They flail "
"more or less uncontrollably, making you feel rather larval."
msgstr ""
"Te han salido finalmente unos brazos desde tu abdomen. Se agitan más o menos"
" descontroladamente, lo que te hace sentir bastante como una larva."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Insect Arms"
msgstr "Brazos de Insecto"

#. ~ Description of mutation "Insect Arms"
#: data/json/mutations/mutations.json
msgid ""
"It's good having all your arms.  Though they're too thin to block or punch, "
"you can fold them inside human-shaped gear if need be."
msgstr ""
"Está bueno tener todos tus brazos. Aunque son muy flacos para defenderte o "
"golpear, los puedes doblar dentro de la ropa para humano, si lo necesitas."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Arachnid Limbs"
msgstr "Miembros de Arácnido"

#. ~ Description of mutation "Arachnid Limbs"
#: data/json/mutations/mutations.json
msgid ""
"There's the last two limbs you were expecting.  Unfortunately, you still "
"can't coordinate them, so you're getting in your own way.  A lot."
msgstr ""
"Aparecieron los últimos dos extremidades que estabas esperando. "
"Lamentablemente, todavía no las puedes coordinar, así que te estorban. Un "
"montón."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Arachnid Arms"
msgstr "Brazos de Arácnido"

#. ~ Description of mutation "Arachnid Arms"
#: data/json/mutations/mutations.json
msgid ""
"You have four handsome limbs, and then those mutant 'hand' and 'foot' "
"things.  They probably aren't worth concealing."
msgstr ""
"Tienes cuatro espléndidos miembros, y también esa especie de manos y pies "
"mutantes. No parece necesario tener que ocultarlos."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Tentacle Arms"
msgstr "Brazos de Tentáculos"

#. ~ Description of mutation "Tentacle Arms"
#: data/json/mutations/mutations.json
msgid ""
"Your arms have transformed into tentacles, resulting in a +1 bonus to "
"Dexterity, permanent hand encumbrance of 30, and an inability to wear "
"gloves.  Somewhat decreases wet penalties."
msgstr ""
"Tus brazos se han transformado en tentáculos, lo que te da una bonificación "
"+1 a la Destreza, una incomódidad permanente en las manos de 30, y la "
"imposibilidad de usar guantes. De alguna forma, disminuye las penalizaciones"
" por estar mojado."

#. ~ Message when player with mutation "Tentacle Arms" attacks
#. ~ Message when player with mutation "4 Tentacles" attacks
#. ~ Message when player with mutation "8 Tentacles" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "You slap %s with one of your tentacles!"
msgstr ""

#. ~ Message when NPC with mutation "Tentacle Arms" attacks
#. ~ Message when NPC with mutation "4 Tentacles" attacks
#. ~ Message when NPC with mutation "8 Tentacles" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "%1$s slaps %2$s with one of their tentacles!"
msgstr ""

#. ~ Message when player with mutation "Tentacle Arms" attacks
#. ~ Message when player with mutation "4 Tentacles" attacks
#. ~ Message when player with mutation "8 Tentacles" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "You rake %s with one of your tentacles!"
msgstr ""

#. ~ Message when NPC with mutation "Tentacle Arms" attacks
#. ~ Message when NPC with mutation "4 Tentacles" attacks
#. ~ Message when NPC with mutation "8 Tentacles" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "%1$s rakes %2$s with one of their tentacles!"
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "4 Tentacles"
msgstr "4 Tentáculos"

#. ~ Description of mutation "4 Tentacles"
#: data/json/mutations/mutations.json
msgid ""
"Your arms have transformed into four tentacles, resulting in a +1 bonus to "
"Dexterity, permanent hand encumbrance of 30, and an inability to wear "
"gloves.  You can make up to 3 extra attacks with them.  Somewhat decreases "
"wet penalties."
msgstr ""
"Tus brazos se han transformado en cuatro tentáculos, lo que resulta en una "
"bonificación de +1 a la Destreza, una incomódidad permanente en las manos de"
" 30, y la imposibilidad de usar guantes. Puedes hacer hasta 3 ataques extra "
"con ellos. De alguna forma, disminuye las penalizaciones por estar mojado."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "8 Tentacles"
msgstr "8 Tentáculos"

#. ~ Description of mutation "8 Tentacles"
#: data/json/mutations/mutations.json
msgid ""
"Your arms have transformed into eight tentacles, resulting in a +1 bonus to "
"Dexterity, permanent hand encumbrance of 30, and an inability to wear "
"gloves.  You can make up to 7 extra attacks with them.  Somewhat decreases "
"wet penalties."
msgstr ""
"Tus brazos se han transformado en ocho tentáculos, lo que resulta en una "
"bonificación de +1 a la Destreza, una incomódidad permanente de manos de 30,"
" y la incapacidad de usar guantes. Puedes hacer hasta 7 ataques extra con "
"ellos. De alguna forma, disminuye un poco las penalizaciones por estar "
"mojado."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Shell"
msgstr "Caparazón"

#. ~ Description of mutation "Shell"
#: data/json/mutations/mutations.json
msgid ""
"You have grown a thick shell over your torso, providing excellent armor, but"
" you cannot wear anything on your torso.  Somewhat reduces wet effects."
msgstr ""
"Te ha crecido un grueso caparazón sobre el torso, que te proporciona una "
"excelente armadura, pero no puedes llevar nada en tu torso. Reduce en cierta"
" medida los efectos por estar mojado."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Roomy Shell"
msgstr "Caparazón Amplio"

#. ~ Description of mutation "Roomy Shell"
#: data/json/mutations/mutations.json
msgid ""
"Your protective shell has grown large enough to accommodate--if need be--"
"your whole body.  Activate to pull your head and limbs into your shell, "
"trading mobility and vision for warmth and shelter."
msgstr ""
"Tu caparazón protector ha crecido tan grande como para meter tu cuerpo "
"entero, si lo necesitas. Hay que activarlo para meter tu cabeza y tus brazos"
" adentro, ganando abrigo y refugio, y perdiendo movilidad y visión."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Nacreous Shell"
msgstr "Concha Nacarada"

#. ~ Description of mutation "Nacreous Shell"
#: data/json/mutations/mutations.json
msgid ""
"Your protective shell has developed increased strength and hardness and a "
"mother of pearl sheen."
msgstr ""
"Tu caparazón protector ha desarrollado una mayor resistencia y dureza y un "
"brillo nacarado."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Leg Tentacles"
msgstr "Piernas de Tentáculos"

#. ~ Description of mutation "Leg Tentacles"
#: data/json/mutations/mutations.json
#, no-c-format
msgid ""
"Your legs have transformed into six tentacles.  This decreases your speed on"
" land by 20%, makes your movement silent, increases your swimming speed and "
"reduces wet penalties, but you can't use footwear any more."
msgstr ""
"Tus piernas se han transformado en seis tentáculos. Esto disminuye tu "
"velocidad en tierra en un 20%, hace que tu movimiento sea silencioso, "
"aumenta tu velocidad de nado y reduce las penalizaciones por humedad, pero "
"ya no puedes usar calzado."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Tentacle Bracing"
msgstr "Soporte Tentacular"

#. ~ Description of mutation "Tentacle Bracing"
#: data/json/mutations/mutations.json
msgid ""
"Your lower tentacles have developed suckers, perfect for walking along lake "
"beds and ocean floors.  They make land movement marginally more tiring, do a"
" good job of keeping you set in place."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Scuttle"
msgstr ""

#. ~ Description of mutation "Scuttle"
#: data/json/mutations/mutations.json
msgid ""
"Your hook-shaped feet curl inward to grip the ground, allowing you to easily"
" walk along the bottom when you're underwater.  They're also a bit quicker "
"at climbing over obstacles, even on dry land."
msgstr ""

#. ~ Description of mutation "Lizard"
#: data/json/mutations/mutations.json
msgid ""
"You sometimes look back on your days before your tail came in.  But you're "
"better now."
msgstr ""
"A veces rememorás tus días antes de que te creciera la cola. Pero ahora "
"estás mejor."

#. ~ Description of mutation "Gastropod"
#: data/json/mutations/mutations.json
msgid ""
"You feel bad for all the creatures that don't carry their home on their "
"backs."
msgstr ""
"Te sientes mal por todas las criaturas que no llevan su hogar a cuestas."

#. ~ Description of mutation "Bird"
#: data/json/mutations/mutations.json
msgid ""
"You're sure you'll fly someday.  In the meantime, there are still nests to "
"build."
msgstr ""
"Estás seguro de que algún día volarás. Mientras tanto, todavía hay nidos que"
" construir."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Aquatic"
msgstr "Bajo el Agua"

#. ~ Description of mutation "Aquatic"
#: data/json/mutations/mutations.json
msgid ""
"Ninety percent of the planet, and it's yours to explore.  And colonize.  And"
" enjoy.  What was that about a surface?"
msgstr ""
"90% del planeta, y es todo tuyo para explorarlo. Y colonizarlo. Y "
"disfrutarlo. ¿Qué era eso de una superficie?"

#. ~ Description of mutation "Beast"
#: data/json/mutations/mutations.json
msgid ""
"It's about time you grew out.  Now that you've matured, it is time to make "
"something of yourself."
msgstr ""
"Ya era hora de que crecieras. Ahora que maduraste, es momento de hacer algo "
"de ti mismo."

#. ~ Description of mutation "Feline"
#: data/json/mutations/mutations.json
msgid ""
"Stalking prey, eating well, and lying in the sun.  Mmm, all you could ever "
"desire."
msgstr ""
"Acechar a la presa, comer bien, y tirarte al sol. Mmm, todo lo que siempre "
"deseaste."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Wolf"
msgstr "Lobo"

#. ~ Description of mutation "Wolf"
#: data/json/mutations/mutations.json
msgid "You're the perfect candidate to lead a pack."
msgstr "Eres el candidato perfecto para liderar una manada."

#. ~ Mutation name
#. ~ Snippet in category "<dog_name>"
#: data/json/mutations/mutations.json data/json/snippets/snippets.json
msgid "Bear"
msgstr "Oso"

#. ~ Description of mutation "Bear"
#: data/json/mutations/mutations.json
msgid "So the humans died; what's the worry?  Now they won't ruin the woods."
msgstr ""
"Así que los humanos murieron, ¿cuál es la preocupación? Ahora ya no "
"arruinarán los bosques."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Bovine"
msgstr "Bovino"

#. ~ Description of mutation "Bovine"
#: data/json/mutations/mutations.json
msgid ""
"Civilization collapsed?  Great!  You and your kin will never have to worry "
"about a slaughterhouse again."
msgstr ""
"¿La civilización colapsó? ¡Genial! Tú y tus familiares nunca tendrán que "
"volver a preocuparse por un matadero."

#. ~ Description of mutation "Insect"
#: data/json/mutations/mutations.json
msgid ""
"It would be good to be a queen, having workers constantly servicing your "
"every need… but how would you keep them in line?"
msgstr ""
"Sería bueno ser una reina, tener trabajadores constantemente atendiendo "
"todas tus necesidades... pero ¿cómo los mantendrías a raya?"

#. ~ Description of mutation "Plant"
#: data/json/mutations/mutations.json
msgid ""
"Well, you still have those other walking flowers--and the mushrooms, too--to"
" deal with.  But you'll manage."
msgstr ""
"Bueno, todavía tienes que ocuparte de esas otras flores andantes y también "
"de los hongos.  Pero te las arreglarás."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Aqueous"
msgstr "Acuoso"

#. ~ Description of mutation "Aqueous"
#: data/json/mutations/mutations.json
msgid ""
"What was that old advertisement?  'Paint the planet'?  That might be a good "
"long-term goal, but for now…"
msgstr ""
"¿Cómo era esa publicidad vieja? ¿'pintar el planeta'? Esa podría ser una "
"buena meta a largo plazo, pero por ahora..."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Subterranean"
msgstr "Bajo la Tierra"

#. ~ Description of mutation "Subterranean"
#: data/json/mutations/mutations.json
msgid ""
"Not much point to rebuilding up in that horribly bright, roofless wasteland."
"  Now that you've become accustomed to your new digs, there's the beginning "
"of a great empire right here, underground."
msgstr ""
"No tiene mucho sentido reconstruir en ese terriblemente brillante y baldío "
"pá ramo sin techo. Ahora que te acostumbraste a tus nuevos aposentos, aquí "
"están las bases de un gran imperio, subterráneo."

#. ~ Description of mutation "Cephalopod"
#: data/json/mutations/mutations.json
msgid ""
"Strange aeons, true, but Death seems to be slacking, and you are doing just "
"fine."
msgstr ""
"Son eones extraños, es cierto, pero la Muerte parece estar ganduleando y tú "
"lo estas haciendo bien."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Arachnid"
msgstr "Arácnido"

#. ~ Description of mutation "Arachnid"
#: data/json/mutations/mutations.json
msgid "Well, maybe you'll just have to make your own worldwide web."
msgstr "Bueno, tal vez tengas que crear tu propia red mundial."

#. ~ Mutation name
#. ~ Name suffix of an NPC
#. ~ A rural holdout survivor living in a barn or a forest or something, all
#. by themselves.  At some point this NPC should get special dialogue.
#. ~ A survivor who sometimes visits the refugee center.
#. ~ Name of an NPC class
#. ~ A wandering survivor, a pretty tough and capable dude.  Represents an NPC
#. version of a person much like the player.
#. ~ A random scavenger visiting the refugee center to check it out, just like
#. you.
#: data/json/mutations/mutations.json data/json/npcs/holdouts/rural.json
#: data/json/npcs/random_encounters/john_bailey.json
#: data/json/npcs/refugee_center/surface_visitors/NPC_visiting_scavenger.json
#: data/mods/Aftershock/npcs/Backgrounds/BG_traits_afs.json
msgid "Survivor"
msgstr "Superviviente"

#. ~ Description of mutation "Survivor"
#: data/json/mutations/mutations.json
msgid ""
"Hey.  Civilization fell.  You're still around.  'Rat' just isn't respectful."
msgstr ""
"¡Eh! La civilización cayó. Todavía andas dando vueltas. 'Rata' no es "
"respetuoso."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Prototype"
msgstr "Prototipo"

#. ~ Description of mutation "Prototype"
#: data/json/mutations/mutations.json
msgid "After all those experiments, what's a few more, hmm?"
msgstr "Después de todos esos experimentos, ¿Qué te hacen un par más, eh?"

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Prime"
msgstr "Supremo"

#. ~ Description of mutation "Prime"
#: data/json/mutations/mutations.json
msgid "You're the perfect candidate to tidy this mess."
msgstr "Eres el candidato perfecto para ordenar este barullo."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Fey"
msgstr "Espiritual"

#. ~ Description of mutation "Fey"
#: data/json/mutations/mutations.json
msgid ""
"You are the tree under which humankind will shelter during these dark times."
msgstr ""
"Eres el árbol debajo del cual la humanidad se refugiará durante estos "
"tiempos oscuros."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Chaos"
msgstr "Caos"

#. ~ Description of mutation "Chaos"
#: data/json/mutations/mutations.json
msgid ""
"You can't tell what you are anymore.  Everything and yet nothing, like you "
"weren't meant to exist.  But you do, and you're a force, no matter what "
"happens."
msgstr ""
"Ya no sabes qué eres. Todo y también anda, como si no hubieras debido "
"existir. Pero existes, y eres una fuerza, no importa lo que pase."

#. ~ Description of mutation "Raptor"
#: data/json/mutations/mutations.json
#: data/mods/DinoMod/mutations/mutations.json
msgid ""
"The chance to undo not one but TWO extinction events.  You're confident "
"you'll do fine."
msgstr ""
"La posibilidad de enmendar no uno, sino DOS extinciones. Tienes confianza "
"que lo vas a hacer bien."

#. ~ Description of mutation "Batrachian"
#: data/json/mutations/mutations.json
msgid "A perfect ambush predator, if only there were less competition."
msgstr ""
"Un perfecto depredador de emboscada, si sólo hubiera menos competencia."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Diminutive"
msgstr "Diminutivo"

#. ~ Description of mutation "Diminutive"
#: data/json/mutations/mutations.json
msgid ""
"So much food, everywhere!  And nobody's even guarding it anymore!  These are"
" good times."
msgstr ""
"¡Tanta comida, en todas partes! ¡Y ya nadie la vigila! Estos son buenos "
"tiempos."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Marloss Gateway"
msgstr "Portal Marloss"

#. ~ Description of mutation "Marloss Gateway"
#: data/json/mutations/mutations.json
msgid ""
"You get the feeling that you're on the cusp of becoming something greater "
"than yourself."
msgstr ""
"Tienes la sensación de estar en la cúspide de convertirte en algo más grande"
" que ti mismo."

#. ~ Description of mutation "Mycus"
#: data/json/mutations/mutations.json
msgid "We are the Mycus."
msgstr "Nosotros somos el Mycus."

#. ~ Description of mutation "Crustacean"
#: data/json/mutations/mutations.json
msgid "Who needs skin when you can have a hard carapace?"
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Acidproof"
msgstr "Antiácido"

#. ~ Description of mutation "Acidproof"
#: data/json/mutations/mutations.json
msgid "Your mutated flesh is immune to the damaging effects of acid."
msgstr "Tu carne mutada es inmune a los daños causados por el ácido."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Acid Blood"
msgstr "Sangre Ácida"

#. ~ Description of mutation "Acid Blood"
#: data/json/mutations/mutations.json
msgid ""
"Your body has developed a wonderful defense mechanism.  Instead of normal "
"blood, you bleed a strong molecular acid which will damage any creature "
"foolish enough to harm you."
msgstr ""
"Tu cuerpo ha desarrollado un maravilloso mecanismo de defensa. En lugar de "
"tener sangre normal, te corre por las venas un ácido molecular fuerte que "
"dañará a cualquier criatura que sea lo suficientemente estúpida de "
"lastimarte."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Pyromaniac"
msgstr "Piromanía"

#. ~ Description of mutation "Pyromaniac"
#: data/json/mutations/mutations.json
msgid ""
"You have an unhealthy obsession with fire, and you get anxious if you don't "
"light them every now and then or stand near them often.  However, you gain a"
" mood bonus from doing so."
msgstr ""
"Tienes una obsesión enfermiza con el fuego, y te pones ansioso si no lo "
"enciendes de vez en cuando o te paras cerca de él a menudo. Sin embargo, "
"obtienes una bonificación de moral al hacerlo."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Amphibious"
msgstr "Anfibio"

#. ~ Description of mutation "Amphibious"
#: data/json/mutations/mutations.json
msgid ""
"You're as comfortable in water as on land, and your body has adapted around "
"that fact.  Your base swimming speed is greatly increased, and weight will "
"hinder you much less while swimming."
msgstr ""
"Estás tan cómodo en el agua como en la tierra, y tu cuerpo se ha adaptado "
"alrededor de ese hecho. La velocidad de nado de la base se ha incrementado "
"enormemente, y el peso te estorbará mucho menos mientras nadas."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Lidless Eyes"
msgstr "Sin Párpados"

#. ~ Description of mutation "Lidless Eyes"
#: data/json/mutations/mutations.json
msgid ""
"Like a true fish, your eyes lack eyelids, and are instead covered by a "
"translucent, protective membrane that blocks irritants and water, and "
"provides minor armor.  It also allows you to sleep with your eyes open!  "
"Activate to cause the approach of hostile creatures to wake you up."
msgstr ""
"Como un verdadero pez, tus ojos carecen de párpados, y en su lugar están "
"cubiertos por una membrana translúcida y protectora que bloquea los agentes "
"irritantes y el agua, y proporciona una pequeña armadura. ¡También te "
"permite dormir con los ojos abiertos!. Activarlo causa que la aproximación "
"de criaturas hostiles te despierte."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Aqueous Repose"
msgstr "Descanso Acuoso"

#. ~ Description of mutation "Aqueous Repose"
#: data/json/mutations/mutations.json
msgid ""
"Falling asleep underwater is easy for you, and you spend less time asleep "
"when you rest there.  You can also eat underwater, though you can't drink."
msgstr ""
"Dormirse bajo el agua es fácil para ti, y pasas menos tiempo dormido cuando "
"descansas allí. También puedes comer bajo el agua, aunque no puedes beber."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Toxic Flesh"
msgstr "Carne tóxica"

#. ~ Description of mutation "Toxic Flesh"
#: data/json/mutations/mutations.json
msgid ""
"Your flesh is highly poisonous, and creatures that bite you will receive a "
"nasty surprise."
msgstr ""
"Tu carne es muy venenosa, y las criaturas que te muerdan recibirán una "
"desagradable sorpresa."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Freshwater Osmosis"
msgstr "Osmosis de Agua Dulce"

#. ~ Description of mutation "Freshwater Osmosis"
#: data/json/mutations/mutations.json
msgid ""
"Your gills and skin are highly permeable to moisture, and you can hydrate "
"your body through osmosis.  While submerged in fresh water, any thirst you "
"might have will be slaked."
msgstr ""
"Tus branquias y tu piel son altamente permeables a la humedad, y puedes "
"hidratar tu cuerpo a través de la ósmosis. Mientras estés sumergido en agua "
"fresca, cualquier sed que pueda tener será saciada."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Electroreceptors"
msgstr "Electroreceptores"

#. ~ Description of mutation "Electroreceptors"
#: data/json/mutations/mutations.json
msgid ""
"A network of jelly-filled electroreceptors, like that of a shark, have grown"
" throughout your face and nose.  They are very sensitive to magnetic fields,"
" allowing you to see robots and creatures charged with electricity through "
"walls, but being shocked will seriously mess you up."
msgstr ""
"Una red de electroreceptores llenos de gelatina, como los de un tiburón, ha "
"crecido a lo largo de tu cara y nariz. Son muy sensibles a los campos "
"magnéticos, permitiéndote ver robots y criaturas cargadas de electricidad a "
"través de los muros, pero ser electrocutado te destrozará seriamente."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Shark Teeth"
msgstr "Dientes de Tiburón"

#. ~ Description of mutation "Shark Teeth"
#: data/json/mutations/mutations.json
msgid ""
"Your teeth have grown incredibly sharp, and have calcified even further.  In"
" addition to letting you eat much faster, you can use them as a lethal "
"natural weapon, as long as your anatomy favors it.  They also grow very "
"fast, and you harmlessly shed them more or less at random."
msgstr ""
"Tus dientes se han vuelto increíblemente afilados y se han calcificado aún "
"más. Además de permitirte comer mucho más rápido, puedes utilizarlos como un"
" arma natural letal, siempre que tu anatomía lo favorezca. También crecen "
"muy rápido, y te desprendes de ellos más o menos al azar."

#. ~ Message when player with mutation "Shark Teeth" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "You tear into %s with your teeth!"
msgstr ""

#. ~ Message when NPC with mutation "Shark Teeth" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "%1$s tears into %2$s with their teeth!"
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Police Officer"
msgstr "Agente de Policía"

#. ~ Description of mutation "Police Officer"
#. ~ Description of mutation "SWAT Officer"
#: data/json/mutations/mutations.json
msgid ""
"You are a duly sworn law enforcement officer, with jurisdiction throughout "
"the New England region thanks to interstate agreements.  Whether that means "
"anything now is another question."
msgstr ""
"Eres un agente de la ley bajo juramento, con jurisdicción en toda la región "
"de Nueva Inglaterra, gracias a los acuerdos interestatales. Que esto "
"signifique algo ahora, eso ya es otra cosa."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "SWAT Officer"
msgstr "Agente de SWAT"

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Churl"
msgstr "Grosero"

#. ~ Description of mutation "Churl"
#: data/json/mutations/mutations.json
msgid ""
"Thou art a lewede man, a lowly cowherd, though where thi catel been thou "
"hast not ynn certain."
msgstr ""
"Tú eres un hombre común, humilde pastor, aunque donde haya estado tu ganado,"
" no lo has de podido saber."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Police Detective"
msgstr "Detective de Policía"

#. ~ Description of mutation "Police Detective"
#: data/json/mutations/mutations.json
msgid ""
"You are a duly sworn law enforcement investigator, with jurisdiction "
"throughout the New England region thanks to interstate agreements.  Whether "
"your shield means anything now is another question."
msgstr ""
"Eres un agente de la ley bajo juramento, con jurisdicción en toda la región "
"de Nueva Inglaterra, gracias a los acuerdos interestatales. Que esto "
"signifique algo ahora, eso ya es otra cosa."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "US Marshal"
msgstr "Alguacil de EE.UU."

#. ~ Description of mutation "US Marshal"
#: data/json/mutations/mutations.json
msgid ""
"You are a duly sworn Federal marshal, with nationwide jurisdiction and the "
"authority of the United States of America."
msgstr ""
"Eres un alguacil federal bajo juramento, con jurisdicción en toda la nación "
"y la autoridad en los Estados Unidos de América."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Hub 01 Ancillary"
msgstr "Hub 01 Auxiliar"

#. ~ Description of mutation "Hub 01 Ancillary"
#: data/json/mutations/mutations.json
msgid ""
"You are known to be a capable and resourceful mercenary at the employ of Hub"
" 01."
msgstr ""
"Se te conoce como un mercenario capaz y con recursos al servicio del Hub 01."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "True Foodperson"
msgstr "Comidapersona Verdadero"

#. ~ Description of mutation "True Foodperson"
#: data/json/mutations/mutations.json
msgid ""
"You are the true Foodperson, some might think Foodperson is just a mascot, "
"but you know better.  You are Foodperson, the mask has become your face; you"
" are real, and the only thing standing between this world and oblivion is "
"you."
msgstr ""
"Eres el verdadero Personacomida, algunos podrían pensar que PersonaComida es"
" sólo una mascota, pero tú lo sabes mejor. Eres PersonaComida, la máscara se"
" ha convertido en tu cara, eres real y lo único que se interpone entre este "
"mundo y el olvido eres tú."

#. ~ Description of mutation "MD"
#: data/json/mutations/mutations.json
msgid ""
"You were just through with the administrative formalities for your residency"
" when the Cataclysm struck.  \"Your\" hospital was overrun and evacuated, "
"but there's always work for a good doctor."
msgstr ""
"Acababas de completar los trámites administrativos para tu residencia cuando"
" se produjo el Cataclismo. \"Tu\" hospital fue invadido y evacuado, pero "
"siempre hay trabajo para un buen médico."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Skater"
msgstr "Skater"

#. ~ Description of mutation "Skater"
#: data/json/mutations/mutations.json
msgid ""
"You are skilled in maneuvering on skates.  You suffer lower penalties to "
"dodging and are less likely to fall down if hit in melee combat while you're"
" wearing rollerskates or rollerblades."
msgstr ""
"Eres hábil en las maniobras sobre patines. Sufres menos penalizaciones a la "
"hora de esquivar y es menos probable que caigas si te golpean en un combate "
"c. a c. mientras llevas patines o patinetas."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Martial Artist"
msgstr "Artista Marcial"

#. ~ Description of mutation "Martial Artist"
#: data/json/mutations/mutations.json
msgid ""
"You were shaping up to be a pretty decent student of the martial arts before"
" the Cataclysm struck.  Time to see just how good you really are."
msgstr ""
"Te estabas preparando para ser un estudiante de artes marciales bastante "
"decente antes de que ocurriera el Cataclismo. Es hora de ver cuán bueno eres"
" realmente."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Black Belt"
msgstr "Cinturón Negro"

#. ~ Description of mutation "Black Belt"
#: data/json/mutations/mutations.json
msgid ""
"You were competitive at national levels, and had considered teaching your "
"art.  Defending against the entire town may still be a challenge, though."
msgstr ""
"Estabas compitiendo a niveles nacionales, y consideraste enseñar tu arte. "
"Igual, defenderte contra el pueblo entero puede ser un desafío importante."

#. ~ Description of mutation "Pugilist"
#: data/json/mutations/mutations.json
msgid ""
"You are experienced in the Sweet Science of boxing.  You could've had a shot"
" at a local boxing tournament, if the Cataclysm hadn't screwed that up."
msgstr ""
"Tienes práctica en la Dulce Ciencia del boxeo. Podrías haber tenido éxito en"
" el torneo local de boxeo, si el Cataclismo no lo hubiera jodido."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Kickboxer"
msgstr ""

#. ~ Description of mutation "Kickboxer"
#: data/json/mutations/mutations.json
msgid ""
"You have some training in the art of kickboxing.  It's just boxing with "
"kicks, right?"
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Autodoc Specialist"
msgstr "Especialista en Autodoc"

#. ~ Description of mutation "Autodoc Specialist"
#: data/json/mutations/mutations.json
msgid ""
"You're trained in proper operation of the Autodoc, an advanced machine used "
"for surgical procedures.  Operations involving it will be moderately more "
"likely to succeed."
msgstr ""
"Estás capacitado para el correcto funcionamiento del Autodoc, una máquina "
"avanzada utilizada para procedimientos quirúrgicos. Las operaciones que lo "
"involucren serán moderadamente más propensas a tener éxito."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Dungeon Master"
msgstr "Maestro de Las Mazmorra"

#. ~ Description of mutation "Dungeon Master"
#: data/json/mutations/mutations.json
msgid ""
"Weeks spent picking through manuals and researching topics you aren't versed"
" in has taught you to find what you need to know more quickly.  You read "
"slightly faster, and suffer no reading time penalty for books too complex "
"for you to easily understand."
msgstr ""
"Las semanas que pasas revisando manuales e investigando temas que no conoces"
" te han enseñado a encontrar lo que necesitas saber más rápidamente. Lees un"
" poco más rápido, y no sufres ninguna penalización en el tiempo de lectura "
"por libros demasiado complejos para que los entiendas fácilmente."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Carries Brandy"
msgstr "Lleva Brandy"

#. ~ Description of mutation "Carries Brandy"
#: data/json/mutations/mutations.json
msgid "This Bartender now carries brandy!"
msgstr "¡Este Barman ahora tiene brandy!"

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Carries Rum"
msgstr "Lleva Ron"

#. ~ Description of mutation "Carries Rum"
#: data/json/mutations/mutations.json
msgid "This Bartender now carries rum!"
msgstr "¡Este Barman ahora tiene ron!"

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Carries Whiskey"
msgstr "Lleva Whisky"

#. ~ Description of mutation "Carries Whiskey"
#: data/json/mutations/mutations.json
msgid "This Bartender now carries whiskey!"
msgstr "¡Este Barman ahora tiene whisky!"

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Has Level 1 Companion Missions"
msgstr "Tiene Misiones de Compañero Nivel 1"

#. ~ Description of mutation "Has Level 1 Companion Missions"
#: data/json/mutations/mutations.json
msgid "New mission options have become available!"
msgstr "¡Están disponibles nuevas opciones de misiones!"

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Has Level 1 Construction Built"
msgstr "Tiene Construcciones Nivel 1"

#. ~ Description of mutation "Has Level 1 Construction Built"
#. ~ Description of mutation "Has Level 2 Construction Built"
#: data/json/mutations/mutations.json
msgid "New options may have become available!"
msgstr "¡Pueden estar disponibles nuevas opciones de misiones!"

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Has Level 2 Construction Built"
msgstr "Tiene Construcciones Nivel 2"

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Starting NPC"
msgstr "PNJ de Inicio"

#. ~ Description of mutation "Starting NPC"
#: data/json/mutations/mutations.json
msgid "Marker for starting NPCs"
msgstr "Marca para PNJs al comienzo del juego"

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Static NPC"
msgstr "PNJ estático"

#. ~ Description of mutation "Static NPC"
#: data/json/mutations/mutations.json
msgid "Marker for static NPCs"
msgstr "Marca para los PNJ estáticos"

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Hallucination"
msgstr "Alucinación"

#. ~ Description of mutation "Hallucination"
#: data/json/mutations/mutations.json
msgid ""
"NPC trait that makes them be hallucination.  It is a bug if you have it."
msgstr ""
"Rasgo de PNJ que hace que sientan alucinaciones. Es un bug si lo tienes."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Ignores Sounds"
msgstr "Ignorar Sonidos"

#. ~ Description of mutation "Ignores Sounds"
#: data/json/mutations/mutations.json
msgid ""
"NPC ignores sounds and does not investigate them.  If you see this, it's is "
"a bug."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Will Not Bash"
msgstr "No Contundente"

#. ~ Description of mutation "Will Not Bash"
#: data/json/mutations/mutations.json
msgid "NPC will not bash to reach things.  If you see this, it's a bug."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Returns to Start POS"
msgstr "Volver a la POS inicial"

#. ~ Description of mutation "Returns to Start POS"
#: data/json/mutations/mutations.json
msgid "NPC will return to its spawn position on idle."
msgstr "El PNJ volverá a su posición inicial parado."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Assign Random Mission"
msgstr ""

#. ~ Description of mutation "Assign Random Mission"
#: data/json/mutations/mutations.json
msgid ""
"This is an AI tag to give a static NPC a random mission.  If you see this, "
"it's a bug."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Assign Random Nomove Mission"
msgstr ""

#. ~ Description of mutation "Assign Random Nomove Mission"
#: data/json/mutations/mutations.json
msgid ""
"This is an AI tag to give a static NPC a random mission that doesn't involve"
" them following you.  If you see this, it's a bug."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Debug Tail"
msgstr "Cola Depurado"

#. ~ Description of mutation "Debug Tail"
#: data/json/mutations/mutations.json
msgid "Gain a tail bodypart."
msgstr "Recibir cola."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Debug No Torso"
msgstr "Depurar Sin Torso"

#. ~ Description of mutation "Debug No Torso"
#: data/json/mutations/mutations.json
msgid "They said college costs an arm and a leg, they sure weren't kidding!"
msgstr ""
"Dijeron que la universidad cuesta un ojo de la cara, ¡y no estaban "
"bromeando!"

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Debug Big Head"
msgstr ""

#. ~ Description of mutation "Debug Big Head"
#: data/json/mutations/mutations.json
msgid "They said college what make me smart, this is a lot to lug around!"
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Debug Night Vision"
msgstr "Depurar Visión Nocturna"

#. ~ Description of mutation "Debug Night Vision"
#. ~ Description of mutation "Debug Clairvoyance"
#: data/json/mutations/mutations.json
msgid "You can clearly see that this is for dev purposes only."
msgstr ""
"Claramente, te das cuenta que esto es solo para propósitos de desarrollo del"
" software."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Debug Clairvoyance"
msgstr "Depurar Clarividencia"

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Debug Clairvoyance Super"
msgstr "Depurar Super Clarividencia"

#. ~ Description of mutation "Debug Clairvoyance Super"
#: data/json/mutations/mutations.json
msgid "You can see all the bugs with this one."
msgstr "Puedes ver todos los errores con este."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Debug Invisibility"
msgstr "Depurar Invisibilidad"

#. ~ Description of mutation "Debug Invisibility"
#: data/json/mutations/mutations.json
msgid "If you see this, you'd best be debugging something."
msgstr "Si ves esto, mejor que estes depurando algo."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Debug Life Support"
msgstr "Depurar Soporte Vital"

#. ~ Description of mutation "Debug Life Support"
#: data/json/mutations/mutations.json
msgid ""
"Holds hunger, thirst, and fatigue stable.  You can debug all year long with "
"this one!"
msgstr ""
"Mantiene estable el hambre, la sed y el cansacio. ¡Puedes depurar todo el "
"año con esto!"

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Debug Cardio"
msgstr "Depurar Cardio"

#. ~ Description of mutation "Debug Cardio"
#: data/json/mutations/mutations.json
msgid "You can run, but you'll never run out of breath."
msgstr "Puedes correr, pero nunca te quedarás sin aliento."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Debug 9000 HP"
msgstr ""

#. ~ Description of mutation "Debug 9000 HP"
#: data/json/mutations/mutations.json
msgid "If you need to survive the deadliest bug attacks."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Debug Regeneration"
msgstr ""

#. ~ Description of mutation "Debug Regeneration"
#: data/json/mutations/mutations.json
msgid "Heal yourself from this stupid bug attacks."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Debug Deodorizer"
msgstr "Depurar Desodorante"

#. ~ Description of mutation "Debug Deodorizer"
#: data/json/mutations/mutations.json
msgid "Smell that bug?  Smell's certainly not coming from you!"
msgstr "¿Hueles ese bug? ¡Ese olor no sale de ti!"

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Debug Silent Walk"
msgstr "Depurar Paso Silencioso"

#. ~ Description of mutation "Debug Silent Walk"
#: data/json/mutations/mutations.json
msgid "Be vewwy vewwy quiet.  We're hunting bugs."
msgstr "Shhh... no hagas ruido. Estamos cazando bugs."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Debug Mana"
msgstr "Maná Depuración"

#. ~ Description of mutation "Debug Mana"
#: data/json/mutations/mutations.json
msgid "To cast bug killing spells.  Also increase the cast speed of spells."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Debug HVAC"
msgstr "Depurar HVAC"

#. ~ Description of mutation "Debug HVAC"
#: data/json/mutations/mutations.json
msgid "Temperature and weather won't bug you."
msgstr "La temperatura y el calor no te van a molestar. Tampoco los bugs."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Debug Invincibility"
msgstr "Depurar Invencibilidad"

#. ~ Description of mutation "Debug Invincibility"
#: data/json/mutations/mutations.json
msgid "Bug-repellent forcefield."
msgstr "Campo de fuerza repelente de bichos."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Debug Light"
msgstr ""

#. ~ Description of mutation "Debug Light"
#: data/json/mutations/mutations.json
msgid "You start to emit a light, so you can debug in the darkest nights."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Debug Hammerspace"
msgstr "Depurar EspacioMartillo"

#. ~ Description of mutation "Debug Hammerspace"
#: data/json/mutations/mutations.json
msgid ""
"Crafting and construction requirements bugger off with this one.  Apply with"
" care."
msgstr ""
"Con esto, no existen los requisitos para fabricar o construir. Manejar con "
"cuidado."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Debug Crafting Virtuoso"
msgstr "Depurar Fabricación Virtuosa"

#. ~ Description of mutation "Debug Crafting Virtuoso"
#: data/json/mutations/mutations.json
msgid "Crafting failures won't bug you any more."
msgstr "Los fallos de fabricación no te molestarán más."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Debug Crafting Speed"
msgstr ""

#. ~ Description of mutation "Debug Crafting Speed"
#: data/json/mutations/mutations.json
msgid "Craft the bug out 50 times faster."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Debug Mind Control"
msgstr "Depurar Control Mental"

#. ~ Description of mutation "Debug Mind Control"
#: data/json/mutations/mutations.json
msgid "Mind the bugs, would you kindly?"
msgstr "Ocupate de los errores, ¿serías tan amable?"

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Debug Bionic Installation"
msgstr "Depurar Instalación Biónica"

#. ~ Description of mutation "Debug Bionic Installation"
#: data/json/mutations/mutations.json
msgid "Lets you instantly install torsion ratchets for your eight legs."
msgstr ""
"Te permite instalar instantáneamente engranajes de torsión en tus ocho "
"patas."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Debug Speed"
msgstr ""

#. ~ Description of mutation "Debug Speed"
#: data/json/mutations/mutations.json
msgid "With this, you'll be fixing those bugs faster than ever!"
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Debug Prevent Death"
msgstr ""

#. ~ Description of mutation "Debug Prevent Death"
#: data/json/mutations/mutations.json
msgid "You are prevented from death."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Squeamish"
msgstr "Aprensividad"

#. ~ Description of mutation "Squeamish"
#: data/json/mutations/mutations.json
msgid ""
"You can't even think about putting filthy clothes on yourself, especially "
"from zombies' corpses."
msgstr ""
"Ni siquiera soportas la idea de ponerte ropas sucias, especialmente las que "
"estuvieron en el cadáver de un zombi."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Bee"
msgstr "Abeja"

#. ~ Description of mutation "Bee"
#: data/json/mutations/mutations.json
msgid ""
"NPC trait that makes monsters see it as a bee.  It is a bug (heh) if you "
"have it."
msgstr ""
"Rasgo de PNJ que hace que los monstruos lo vean como una abeja. Es un bug "
"(je) si lo tienes."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Mycus friend"
msgstr "Amigo Mycus"

#. ~ Description of mutation "Mycus friend"
#: data/json/mutations/mutations.json
msgid "NPC trait that makes fungaloid monsters see this NPC as a friend."
msgstr ""
"Rasgo del PNJ que hace que los monstruos fungaloides vean a este PNJ como un"
" amigo."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Mute"
msgstr "Mudez"

#. ~ Description of mutation "Mute"
#: data/json/mutations/mutations.json
msgid "Trait that makes it impossible to say anything."
msgstr "Rasgo que hace imposible decir algo."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Nomad"
msgstr "Nómada"

#. ~ Description of mutation "Nomad"
#: data/json/mutations/mutations.json
msgid ""
"You're too adventurous for your own good.  The more time you spend "
"somewhere, the unhappier it makes you to be there."
msgstr ""
"Eres demasiado aventurero para tu propio bien. Cuanto más tiempo pasas en un"
" lugar, más infeliz te hace estar allí."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Antsy"
msgstr "Antsy"

#. ~ Description of mutation "Antsy"
#: data/json/mutations/mutations.json
msgid ""
"You can't bear to stay still for long.  Your morale will suffer unless you "
"constantly explore new territory."
msgstr ""
"No puedes soportar quedarte quieto por mucho tiempo. Tu moral se resentirá a"
" menos que explores constantemente nuevos territorios."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Restless"
msgstr "Inquieto"

#. ~ Description of mutation "Restless"
#: data/json/mutations/mutations.json
msgid ""
"Spending any amount of time in familiar places makes you miserable.  Must.  "
"Keep.  Moving."
msgstr ""
"Pasar cualquier cantidad de tiempo en lugares familiares te hace miserable. "
"Debes mantenerte en movimiento."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Wayfarer"
msgstr "Viandante"

#. ~ Description of mutation "Wayfarer"
#: data/json/mutations/mutations.json
msgid ""
"Whether from personal choice or childhood trauma, traveling with vehicles is"
" off-limits to you, even if your life depended on it."
msgstr ""
"Ya sea por elección personal o por un trauma de la niñez, viajar con "
"vehículos está fuera de los límites para ti, incluso si tu vida depende de "
"ello."

#. ~ Description of mutation "Brawler"
#: data/json/mutations/mutations.json
msgid ""
"Whether from personal choice or childhood trauma, using ranged weapons is "
"off-limits to you, even if your life depended on it."
msgstr ""
"Ya sea por elección personal o por un trauma de la infancia, no puedes usar "
"armas a distancia, incluso aunque tu vida dependa de ello."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Fast Reflexes"
msgstr "Reflejos Rápidos"

#. ~ Description of mutation "Fast Reflexes"
#: data/json/mutations/mutations.json
msgid "You have fast reflexes, allowing you to dodge attacks more easily."
msgstr ""
"Tienes reflejos rápidos, lo que te permite esquivar los ataques con mayor "
"facilidad."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Lagomorph"
msgstr "lagomorfo"

#. ~ Description of mutation "Lagomorph"
#: data/json/mutations/mutations.json
msgid ""
"You really want to eat some carrots.  Welcome to the Lagomorpha family."
msgstr ""
"Realmente quieres comer algunas zanahorias. Bienvenido a la familia "
"Lagomorfa."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Rabbit Ears"
msgstr "Orejas de conejo"

#. ~ Description of mutation "Rabbit Ears"
#: data/json/mutations/mutations.json
msgid ""
"Your ears have grown into tall and flexible rabbit ears.  They're are "
"slender and enhance your hearing beyond the normal range."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Rabbit Tail"
msgstr "Cola de Conejo"

#. ~ Description of mutation "Rabbit Tail"
#: data/json/mutations/mutations.json
msgid ""
"Your stubby tail has become fuzzy and more round, but doesn't seem to serve "
"any purpose."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Rabbit Fur"
msgstr "Piel de Conejo"

#. ~ Description of mutation "Rabbit Fur"
#: data/json/mutations/mutations.json
msgid ""
"Your fur keeps you covered in winter, maintaining heat and allowing you to "
"better tolerate cold temperatures."
msgstr ""
"Tu pelaje te mantiene cubierto en invierno, manteniendo el calor y "
"permitiéndote tolerar mejor las temperaturas frías."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Rabbit Feet"
msgstr "Pies de Conejo"

#. ~ Description of mutation "Rabbit Feet"
#: data/json/mutations/mutations.json
msgid ""
"Your feet have grown into strong and large rabbit feet.  This makes your "
"kicks pack a little more oomph.  Emphasis on little.  It also offers some "
"warmth, and the lucky part is but superstition.  The downside is you are "
"unable to wear shoes."
msgstr ""
"Tus pies se han convertido en fuertes y grandes patas de conejo. Esto hace "
"que tus patadas tengan un poco más de potencia. El énfasis está en lo de "
"\"poco\". También ofrece algo de calor, y lo de la suerte no es más que una "
"superstición. La desventaja es que no puedes usar zapatos."

#. ~ Message when player with mutation "Rabbit Feet" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "You kick %s with your large feet!"
msgstr ""

#. ~ Message when NPC with mutation "Rabbit Feet" attacks
#: data/json/mutations/mutations.json
#, c-format
msgid "%1$s kicks %2$s with their large feet!"
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Rabbit Nose"
msgstr "Nariz de Conejo"

#. ~ Description of mutation "Rabbit Nose"
#: data/json/mutations/mutations.json
msgid ""
"Your nose has morphed into a cute bunny nose, along with the snout.  It's "
"extremely twitchy too."
msgstr ""
"Tu nariz se ha transformado en una bonita nariz de conejo, junto con el "
"hocico. También es extremadamente nerviosa."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Little Paws"
msgstr "Pequeñas Patas"

#. ~ Description of mutation "Little Paws"
#: data/json/mutations/mutations.json
msgid ""
"Your hands have elongated and look a bit more like paws.  It makes fine "
"manipulation a little more difficult, but you can still probably manage.  "
"Plus, they allow you to move on all fours when crouching and unarmed."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Hunted"
msgstr "Cazado"

#. ~ Description of mutation "Hunted"
#: data/json/mutations/mutations.json
msgid ""
"Since the start of the Cataclysm, something has been hunting you "
"relentlessly.  You can outrun it, but it always seems to find you "
"eventually.  The only escape is for one of you to die."
msgstr ""
"Desde el comienzo del Cataclismo, algo te ha estado persiguiendo "
"implacablemente. Puedes huir de ello, pero siempre parece encontrarte. La "
"única forma de escapar es que uno de los dos muera."

#. ~ Description of mutation "Numb"
#: data/json/mutations/mutations.json
msgid "Your ability to feel or express emotion has been greatly hampered."
msgstr "Tu capacidad de sentir o expresar emociones ha sido muy mermada."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Booming Voice"
msgstr "Voz Potente"

#. ~ Description of mutation "Booming Voice"
#: data/json/mutations/mutations.json
msgid ""
"You know how to project your voice.  You are able to shout much louder than "
"the average person."
msgstr ""
"Sabes cómo proyectar tu voz. Eres capaz de gritar mucho más fuerte que una "
"persona normal."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Feline Flexibility"
msgstr "Flexibilidad Felina"

#. ~ Description of mutation "Feline Flexibility"
#: data/json/mutations/mutations.json
msgid ""
"Your muscles, joints, and the movement center of your brain have changed "
"internally somewhat, allowing you to traverse obstacles with ease."
msgstr ""
"Tus músculos, articulaciones y el centro de movimiento de tu cerebro han "
"cambiado un poco internamente, lo que te permite atravesar los obstáculos "
"con facilidad."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Hates Water"
msgstr "Odia el Agua"

#. ~ Description of mutation "Hates Water"
#: data/json/mutations/mutations.json
msgid ""
"You really hate getting your fur all wet.  This increases morale penalties "
"for being wet, and you will get them even when wearing appropriate clothing."
msgstr ""
"Odias que se te moje la piel. Esto aumenta las penalizaciones de moral por "
"estar mojado, y las recibirás incluso cuando lleves ropa adecuada."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Imitation Carnivore"
msgstr "Imitación Carnívoro"

#. ~ Description of mutation "Imitation Carnivore"
#: data/json/mutations/mutations.json
msgid ""
"Fake mutation to allow post-threshold Ursine mutants access to mutations "
"normally gated behind Carnivore.  This is not meant to be visible in-game."
msgstr ""
"Es una mutación falsa que permite a los mutantes que pasaron el umbral osuno"
" que accedan a las mutaciones que están en la categoría de carnívoros. Esto "
"no debería verse en el juego."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Resilient Physiology"
msgstr "Fisiología Resiliente"

#. ~ Description of mutation "Resilient Physiology"
#: data/json/mutations/mutations.json
#, no-c-format
msgid ""
"Your body is well-adapted to resist trauma.  20% bonus to all hit points.  "
"Stacks with Tough, etc."
msgstr ""
"Tu cuerpo está bien adaptado a los traumas físicos. Tienes un 20% de "
"bonificación a tus puntos de vida. Y es acumulativo con Duro y otros rasgos."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Solid Physiology"
msgstr "Fisiología Sólida"

#. ~ Description of mutation "Solid Physiology"
#: data/json/mutations/mutations.json
#, no-c-format
msgid ""
"Your body is extremely well-adapted to resist trauma.  30% bonus to all hit "
"points.  Stacks with Tough, etc."
msgstr ""
"Tu cuerpo está extremadamente bien adaptado a los traumas físicos. Tienes un"
" 30% de bonificación a tus puntos de vida. Y es acumulativo con Duro y otros"
" rasgos."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Tainted Shadow"
msgstr "Sombra Contaminada"

#. ~ Description of mutation "Tainted Shadow"
#: data/json/mutations/mutations.json
msgid "You shouldn't see this.  This makes you spawn tainted shadows."
msgstr "No deberías ver esto. Esto hace que generes sombras contaminadas."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Nyctophobia"
msgstr "Nictofobia"

#. ~ Description of mutation "Nyctophobia"
#: data/json/mutations/mutations.json
msgid ""
"You are terribly afraid of the dark.  You refuse to enter very dark areas.  "
"If you somehow still happen to stay in dark areas, you suffer from various "
"detrimental mental and physical effects."
msgstr ""
"Le tienes un miedo terrorífico a la oscuridad. Rehúsas entrar en zonas "
"oscuras. Si por alguna razón te quedas en alguna zona oscura, vas a sufrir "
"de varios detrimentos mentales y físicos."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Cold Tolerance"
msgstr "Tolerancia al frio"

#. ~ Description of mutation "Cold Tolerance"
#: data/json/mutations/mutations.json
msgid ""
"You fare better than most in colder climates and are less bothered by lower "
"temperatures.  Note that while you are slightly less prone to developing "
"frostbite as a result, you aren't any better at dealing with the symptoms."
msgstr ""
"Te las apañas mejor que otros en climas gélidos y te molestan menos las "
"bajas temperaturas. Aunque eres menos propenso a desarrollar congelación "
"como resultado, no eres mejor lidiando con los síntomas."

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "High Cold Tolerance"
msgstr ""

#. ~ Description of mutation "High Cold Tolerance"
#: data/json/mutations/mutations.json
msgid ""
"You are now even less bothered by the cold and it is harder for you to "
"freeze or to even get chilly.  When you do though, it'll hit just as hard as"
" it did before."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Heat Tolerance"
msgstr "Tolerancia al calor"

#. ~ Description of mutation "Heat Tolerance"
#: data/json/mutations/mutations.json
msgid ""
"You fare better than most in warmer climates and are less bothered by hotter"
" temperatures.  Note that while you it will take more heat and exposure for "
"you to suffer from sunstroke, this will not make dealing with its "
"consequences any easier."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "High Heat Tolerance"
msgstr ""

#. ~ Description of mutation "High Heat Tolerance"
#: data/json/mutations/mutations.json
msgid ""
"You are now even less bothered by the heat and it is harder for you to "
"overheat or even sweat.  When you do though, it'll hit just as hard as it "
"did before."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Colorful Skin"
msgstr ""

#. ~ Description of mutation "Colorful Skin"
#: data/json/mutations/mutations.json
msgid ""
"Your skin is covered in shifting patterns of dots, lines, and swirls.  This "
"is outside of your control and does not help your stealth.  In fact, it "
"makes you more noticeable."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Camouflage Skin"
msgstr ""

#. ~ Description of mutation "Camouflage Skin"
#: data/json/mutations/mutations.json
msgid ""
"Your can change your skin patterns to match your environment, somewhat "
"increasing your stealthiness."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Cephalopod Mind"
msgstr ""

#. ~ Description of mutation "Cephalopod Mind"
#: data/json/mutations/mutations.json
msgid ""
"Your mind has been altered in such a way that you now find it very difficult"
" to understand humans.  Your capability to persuade and lie to them suffers "
"slightly, even if it is mitigated by your intelligence.  In addition, while "
"you find it much easier to learn by doing now, the plasticity of your psyche"
" means you forget skills much faster."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Temperature Tolerance"
msgstr ""

#. ~ Description of mutation "Temperature Tolerance"
#: data/json/mutations/mutations.json
msgid ""
"You are now not at all bothered by the heat and it is harder for you to "
"overheat or freeze at all.  When you do though, it'll hit just as hard as it"
" did before."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Highly Vain"
msgstr ""

#. ~ Description of mutation "Highly Vain"
#: data/json/mutations/mutations.json
msgid ""
"You know you're beautiful, and the world deserves to know it too.  You "
"prefer to show off your stunningly good looks to the world and will be "
"unhappy if you cover up your face."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Picky Eater"
msgstr ""

#. ~ Description of mutation "Picky Eater"
#: data/json/mutations/mutations.json
msgid ""
"You're a very picky eater.  You refuse to eat any food that tastes bad "
"unless you're starving."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Superiority Complex"
msgstr ""

#. ~ Description of mutation "Superiority Complex"
#: data/json/mutations/mutations.json
msgid ""
"You can't stand to prostrate yourself before your lessers and hate it when "
"they don't immediately do what you say.  Persuasion is much more difficult, "
"but you're better at lying and intimidating."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/mutations.json
msgid "Comfortably Fluid"
msgstr ""

#. ~ Description of mutation "Comfortably Fluid"
#: data/json/mutations/mutations.json
msgid ""
"You can hear your heartbeat in your ears, feel the blood sloshing around in "
"your veins.  The uneven hitches in your breath, the aches in your joints, "
"the rumbling of your stomach.  It's nasty and messy and ugly.  And you are "
"extremely grateful for that."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/npc_personality.json
msgid "Survivor at any cost"
msgstr ""

#. ~ Description of mutation "Survivor at any cost"
#: data/json/mutations/npc_personality.json
msgid ""
"<npc_name> is certainly a survivor.  You can only wonder how many they've "
"abandoned to save themself."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/npc_personality.json
msgid "Timid"
msgstr ""

#. ~ Description of mutation "Timid"
#: data/json/mutations/npc_personality.json
msgid ""
"<npc_name> tries to avoid conflict, even when they have good reason not to."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/npc_personality.json
msgid "Hardass"
msgstr ""

#. ~ Description of mutation "Hardass"
#: data/json/mutations/npc_personality.json
msgid "<npc_name> loves to fight a good fight, but only for themself."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/npc_personality.json
msgid "Freedom fighter"
msgstr ""

#. ~ Description of mutation "Freedom fighter"
#: data/json/mutations/npc_personality.json
msgid ""
"<npc_name> believes in fighting… mostly for others, even at risk to their "
"own wellbeing."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/npc_personality.json
msgid "Volatile"
msgstr ""

#. ~ Description of mutation "Volatile"
#: data/json/mutations/npc_personality.json
msgid "<npc_name> is just looking for an excuse."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/npc_personality.json
msgid "Coward"
msgstr ""

#. ~ Description of mutation "Coward"
#: data/json/mutations/npc_personality.json
msgid ""
"<npc_name> flinches at the thought of fighting, whether it be other people "
"or the undead."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/npc_personality.json
msgid "Craven"
msgstr ""

#. ~ Description of mutation "Craven"
#: data/json/mutations/npc_personality.json
msgid ""
"<npc_name> is afraid of the dark, spiders, and unexplained sounds.  So are "
"you, but only because you've lived through the apocalypse.  <npc_name> has "
"always been like this."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/npc_personality.json
msgid "Brave"
msgstr ""

#. ~ Description of mutation "Brave"
#: data/json/mutations/npc_personality.json
msgid ""
"<npc_name> knows the name of fear, but only as a long-defeated foe.  Little "
"can shake them."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/npc_personality.json
msgid "Hero"
msgstr "Héroe"

#. ~ Description of mutation "Hero"
#: data/json/mutations/npc_personality.json
msgid ""
"<npc_name> is an ideal ally to those they call friend, always willing to "
"help others."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/npc_personality.json
msgid "Miser"
msgstr ""

#. ~ Description of mutation "Miser"
#: data/json/mutations/npc_personality.json
msgid "<npc_name> loves their trinkets, and hates giving them away."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/npc_personality.json
msgid "Scrooge"
msgstr ""

#. ~ Description of mutation "Scrooge"
#: data/json/mutations/npc_personality.json
msgid "<npc_name> collects trash like a RPG protagonist collects potions."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/npc_personality.json
msgid "Kind"
msgstr ""

#. ~ Description of mutation "Kind"
#: data/json/mutations/npc_personality.json
msgid "<npc_name> just wants to help."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/npc_personality.json
msgid "Self-centered"
msgstr ""

#. ~ Description of mutation "Self-centered"
#: data/json/mutations/npc_personality.json
msgid ""
"<npc_name> steers every interaction into discussing how it will help them."
msgstr ""

