msgstr ""
"Una batería de plomo de 12 V utilizada para alimentar los sistemas "
"eléctricos del automóvil, contenida en un carcasa de arcilla."

#. ~ Magazine name
#: data/mods/innawood/items/vehicle_battery.json
msgid "clay battery array"
msgid_plural "clay battery arrays"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. ~ Description of magazine "clay battery array"
#: data/mods/innawood/items/vehicle_battery.json
