msgid_plural "adhesive bandages"
msgstr[0] "venda adhesiva"
msgstr[1] "vendas adhesivas"
msgstr[2] "vendas adhesivas"

#. ~ Description of "adhesive bandage"
#: data/json/items/tool/med.json
msgid ""
"A small medical dressing made of a piece of sterile cloth and sticky tape, "
"used for small injuries not serious enough to require a full-size bandage."
msgstr ""
"Un vendaje médico hecho de un pedazo esterilizado de tela y cinta adhesiva."
"  Se usa para pequeñas heridas que no requieren una venda grande."

#. ~ Item name
#: data/json/items/tool/med.json
msgid "alcohol wipe"
msgid_plural "alcohol wipes"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. ~ Description of "alcohol wipe"
#: data/json/items/tool/med.json
msgid ""
"A wet wipe saturated with alcohol and stored in a sterile package.  Used for"
" personal hygiene or disinfecting small wounds."
msgstr ""
"Una toallita humedecida con alcohol almacenada en un paquete esterilizado.  "
"Se puede utilizar para higiene personal o para desinfectar pequeñas heridas."

#. ~ Item name
#: data/json/items/tool/med.json
msgid "anesthesia kit"
msgid_plural "anesthesia kits"
msgstr[0] "kit de anestesia"
msgstr[1] "kits de anestesia"
msgstr[2] "kits de anestesia"

#. ~ Description of "anesthesia kit"
#: data/json/items/tool/med.json
msgid ""
"A kit for inducing anesthesia for surgery, containing specialized canisters "
"with a variety of powerful hypnotic, analgesic, and stimulative drugs.  It's"
" intended for use in specialized medical equipment, and can't be "
"administered manually."
msgstr ""
"Un equipo para introducir anestesia para una cirugía, que contiene "
"recipientes especializados con una variedad de poderosos fármacos "
"hipnóticos, analgésicos y drogas estimulantes. Está destinado a ser "
"utilizado en un equipo médico especializado y no puede ser administrado "
"manualmente."

#. ~ Item name
#: data/json/items/tool/med.json
msgid "bandage"
msgid_plural "bandages"
msgstr[0] "vendaje"
msgstr[1] "vendajes"
msgstr[2] "vendajes"

#. ~ Description of "bandage"
#: data/json/items/tool/med.json
msgid ""
"A sterile cloth bandage.  Used for stopping blood loss and protecting wounds"
" from aggravation to help them heal faster."
msgstr ""
"Una venda común de tela esterilizada.  Se usa para detener hemorragias, "
"proteger las heridas para que no empeoren y se curen más rápidamente."

#. ~ 10 x 60 cm, three out of a sheet
#. ~ Item name
#: data/json/items/tool/med.json
msgid "makeshift bandage"
msgid_plural "makeshift bandages"
msgstr[0] "vendaje improvisado"
msgstr[1] "vendajes improvisados"
msgstr[2] "vendajes improvisados"

#. ~ 10 x 60 cm, three out of a sheet
#. ~ Description of "makeshift bandage"
#: data/json/items/tool/med.json
msgid ""
"A reasonably clean piece of cloth wrapped for use as a simple bandage.  "
"Better than nothing."
msgstr ""
"Un pedazo de tela razonablemente limpio enrollado para usar como una venda "
"común.  Mejor que nada."

#. ~ Item name
#: data/json/items/tool/med.json
msgid "bleached makeshift bandage"
msgid_plural "bleached makeshift bandages"
msgstr[0] "Vendaje improvisado blanqueado"
msgstr[1] "Vendajes improvisados blanqueados"
msgstr[2] "Vendajes improvisados blanqueados"

#. ~ Description of "bleached makeshift bandage"
#: data/json/items/tool/med.json
msgid ""
"A piece of cloth treated with a bleach solution to sterilize it for use as a"
" bandage."
msgstr ""
"Un pedazo de tela tratado con una solución de lejía para esterilizarlo y "
"poder usarlo como venda."

#. ~ Item name
#: data/json/items/tool/med.json
msgid "boiled makeshift bandage"
msgid_plural "boiled makeshift bandages"
msgstr[0] "vendaje improvisado hervido"
msgstr[1] "vendajes improvisados hervidos"
msgstr[2] "vendajes improvisados hervidos"

#. ~ Description of "boiled makeshift bandage"
#: data/json/items/tool/med.json
msgid "A piece of cloth boiled in water to sterilize it for use as a bandage."
msgstr ""
"Un pedazo de tela hervido en agua para esterilizarlo y poder usarlo como "
"venda."

#. ~ Item name
#: data/json/items/tool/med.json
