msgstr[2] "carne grasa cocinada"

#. ~ Luxury good.
#. ~ Description of "cooked fatty meat"
#: data/json/items/comestibles/carnivore.json
msgid ""
"A chunk of cooked fatty meat.  Although absent of vitamins, it is very "
"filling and delightfully greasy."
msgstr ""
"Un trozo de carne grasa cocida. Aunque carece de vitaminas, es muy saciante "
"y deliciosamente grasienta."

#. ~ Item name
#: data/json/items/comestibles/carnivore.json
msgid "cooked pepper fatty meat"
msgid_plural "cooked pepper fatty meat"
msgstr[0] "carne grasa con pimienta cocinada"
msgstr[1] "carne grasa con pimienta cocinada"
msgstr[2] "carne grasa con pimienta cocinada"

#. ~ Description of "cooked pepper fatty meat"
#: data/json/items/comestibles/carnivore.json
msgid ""
"A chunk of cooked fatty meat properly seasoned with black pepper and salt.  "
"Although absent of vitamins, it is very filling, tasty and delightfully "
"greasy."
msgstr ""
"Un trozo de carne grasa cocida sazonada con pimienta negra y sal. Aunque "
"carece de vitaminas, sacia mucho y es deliciosamente grasienta."

#. ~ Item name
