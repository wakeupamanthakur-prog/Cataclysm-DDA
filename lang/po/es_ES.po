msgid_plural "tear gas grenades"
msgstr[0] "granada lacrimógina"
msgstr[1] "granadas lacrimóginas"
msgstr[2] "granadas lacrimóginas"

#. ~ Description of "tear gas grenade"
#: data/json/items/tool/explosives.json
msgid ""
"A canister grenade filled with noxious irritant.  Use this item to pull the "
"pin and start the fuse, turning it into an active tear gas grenade.  In five"
" seconds it will begin to expel a highly toxic gas for some time.  This gas "
"damages and slows those who enter it, as well as obscuring vision and scent."
msgstr ""
"Una granada de bote llena de un irritante nocivo. Usa este artículo para "
"tirar del pasador y encender la mecha, convirtiéndola en una granada de gas "
"lacrimógeno activa. En cinco segundos comenzará a expulsar un gas altamente "
"tóxico durante algún tiempo. Este gas daña y frena a quienes entran en él, "
"además de oscurecer la visión y el olor."

#. ~ Item name
#: data/json/items/tool/explosives.json
msgid "armed tear gas grenade"
msgid_plural "armed tear gas grenades"
msgstr[0] "granada lacrimógena activada"
msgstr[1] "granadas lacrimógenas activadas"
msgstr[2] "granadas lacrimógenas activadas"

#. ~ Description of "armed tear gas grenade"
#: data/json/items/tool/explosives.json
msgid ""
"This tear gas grenade has had its pin removed and is (or will shortly be) "
"expelling highly noxious gas."
msgstr ""
"Esta granada de gas lacrimógeno no tiene el gancho de seguridad y está (o lo"
" hará pronto) soltando un gas muy tóxico."

#. ~ Item name
#: data/json/items/tool/explosives.json
