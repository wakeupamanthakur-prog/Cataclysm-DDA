msgid_plural "overgrown terrors"
msgstr[0] "terror de gran tamaño"
msgstr[1] "terrores de gran tamaño"
msgstr[2] "terrores de gran tamaño"

#. ~ Description of monster "overgrown terror"
#: data/mods/TropiCataclysm/monsters/zed_plant.json
