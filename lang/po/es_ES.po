msgstr[0] "Cañón láser CMES"
msgstr[1] "Cañones láser CMES"
msgstr[2] "Cañones láser CMES"

#. ~ Description of gun "CMES laser cannon"
#: data/json/items/gun/ups.json
msgid ""
"The integral weapon system for the CMES exoskeleton mech-suit, a rotating-"
"barrel actively-cooled rapid-fire laser system."
msgstr ""
"El sistema integrado de armas para el exoesqueleto CMES es un sistema de "
"cañón rotativo de enfriado activo con disparo rápido láser."

#. ~ Firing mode of gun "CMES laser cannon"
#. ~ Firing mode of gun "RM216 SPIW"
#: data/json/items/gun/ups.json data/json/obsoletion/obsolete_items.json
