#: data/json/items/tool/raincatchers.json
msgid "You place the leather funnel, waiting to collect rain."
msgstr "Colocas el embudo de cuero, esperando que recolecte agua de lluvia."

#. ~ Description of "makeshift funnel"
#: data/json/items/tool/raincatchers.json
msgid ""
"A small makeshift funnel used to collect rainwater.  Use it outside and "
"place a container beneath it to collect water when it rains."
msgstr ""
"Un pequeño embudo casero que se usa para recolectar agua de lluvia. Úsalo en"
" el exterior y coloca un recipiente debajo para recolectar agua cuando "
"llueva."

#. ~ "done_message" action message of item "makeshift funnel"
#: data/json/items/tool/raincatchers.json
msgid "You place the makeshift funnel, waiting to collect rain."
msgstr "Pones el embudo improvisado, esperando que recolecte agua de lluvia."

#. ~ Description of "metal funnel"
#: data/json/items/tool/raincatchers.json
msgid ""
"A large metal funnel used to collect rainwater.  Less portable than plastic "
"funnels, but collects more water.  Use it outside and place a container "
"beneath it to collect water when it rains."
msgstr ""
"Un embudo grande de metal que puedes usar para recolectar el agua de la "
"lluvia. No es tan portátil como uno de plástico pero recolecta más cantidad "
"de agua. Úsalo en el exterior y coloca un recipiente debajo para recolectar "
"agua cuando llueva."

#. ~ "done_message" action message of item "metal funnel"
#: data/json/items/tool/raincatchers.json
msgid "You place the metal funnel, waiting to collect rain."
msgstr "Colocas el embudo de metal, esperando para recoger lluvia."

#. ~ Item name
#: data/json/items/tool/raincatchers.json
msgid "tarp raincatcher"
msgid_plural "tarp raincatchers"
msgstr[0] "colector de lluvia de lona"
msgstr[1] "colectores de lluvia de lona"
msgstr[2] "colectores de lluvia de lona"

#. ~ Description of "tarp raincatcher"
#: data/json/items/tool/raincatchers.json
msgid ""
"A collection of sticks and string with a tarpaulin to set up as an "
"improvised raincatcher."
msgstr ""
"Una colección de palos y cuerdas con una lona para montar un improvisado "
"colector de lluvia."

#. ~ "done_message" action message of item "tarp raincatcher"
#: data/json/items/tool/raincatchers.json
msgid "You set up the raincatcher, waiting to collect water."
msgstr "Pusistes el colector de lluvia, esperando para recoger el agua."

#. ~ Item name
#: data/json/items/tool/science.json
msgid "barometer"
msgid_plural "barometers"
msgstr[0] "barómetro"
msgstr[1] "barómetros"
msgstr[2] "barómetros"

#. ~ Description of "barometer"
#: data/json/items/tool/science.json
msgid "A plastic barometer that can read atmospheric pressure."
msgstr "Un barómetro de plástico que puede medir la presión atmosférica."

#. ~ Item name
#: data/json/items/tool/science.json
msgid "goo canister"
msgid_plural "goo canisters"
msgstr[0] "lata de viscosidad"
msgstr[1] "latas de viscosidad"
msgstr[2] "latas de viscosidad"

#. ~ Description of "goo canister"
#: data/json/items/tool/science.json
msgid ""
"A metal canister with a label reading: \"Warning: contains highly toxic and "
"corrosive materials.  Contents may be sentient.  Open at your own risk.\" "
"You think you can feel something moving inside it."
msgstr ""
"Este bote tiene una etiqueta: \"Advertencia: contiene materiales altamente "
"tóxicos y corrosivos. El contenido puede tener consciencia. Abrir bajo su "
"propia responsabilidad.\" Te parece que sientes que algo se mueve dentro."

#. ~ To Do: Create a bunsen burner that uses a mix of electricity and LPG,
#. then convert this to use that.  Will need multimag
#. ~ Item name
#: data/json/items/tool/science.json
msgid "chemistry set"
msgid_plural "chemistry sets"
msgstr[0] "equipo de química"
msgstr[1] "equipos de química"
msgstr[2] "equipos de química"

#. ~ To Do: Create a bunsen burner that uses a mix of electricity and LPG,
#. then convert this to use that.  Will need multimag
#. ~ Description of "chemistry set"
#: data/json/items/tool/science.json
msgid ""
"A chemistry set stored in a box.  It includes glass containers, hoses, metal"
" wire, a hotplate, and a pair of safety glasses.  It might be used to craft "
"some chemistry projects if you're so inclined."
msgstr ""
"Un equipo de química guardado en una caja. El contenido incluye recipientes "
"de cristal, mangueras, cables de metal, una placa térmica eléctrica, y "
"lentes de seguridad. Puede ser usado para fabricar cosas químicas si es que "
"te interesa."

#. ~ Item name
#: data/json/items/tool/science.json
msgid "basic chemistry set"
msgid_plural "basic chemistry sets"
msgstr[0] "equipo básico de química"
msgstr[1] "equipos básicos de química"
msgstr[2] "equipos básicos de química"

#. ~ Description of "basic chemistry set"
#: data/json/items/tool/science.json
msgid ""
"A basic chemistry set including glass containers, hoses, and a pair of "
"safety glasses.  It might be used to craft some chemistry projects if you're"
" so inclined, but you'll need a source of heat."
msgstr ""
"Un equipo básico de química que contiene recipientes de cristal, mangueras y"
" lentes de seguridad. Puede ser usado para fabricar cosas químicas si es que"
" te interesa, pero vas a necesitar también una fuente de calor."

#. ~ Item name
#: data/json/items/tool/science.json data/mods/innawood/items/electronics.json
msgid "electrolysis kit"
msgid_plural "electrolysis kits"
msgstr[0] "equipo de electrólisis"
msgstr[1] "equipos de electrólisis"
msgstr[2] "equipos de electrólisis"

#. ~ Description of "electrolysis kit"
#: data/json/items/tool/science.json data/mods/innawood/items/electronics.json
msgid ""
"A set of wiring and electrodes for applying a direct current, usually to a "
"liquid.  Useful for crafting.  Load with a storage battery or 12V vehicle "
"battery to use."
msgstr ""
"Un conjunto de cables y electrodos para aplicar corriente continua "
"usualmente a un líquido. Útil para la fabricación. Hay que cargarlo con una "
"batería de almacenamiento o una batería de 12V de auto para usarlo."

#. ~ Item name
#: data/json/items/tool/science.json
msgid "ketene lamp"
msgid_plural "ketene lamps"
msgstr[0] "lámpara de cetena"
msgstr[1] "lámparas de cetena"
msgstr[2] "lámparas de cetena"

#. ~ Description of "ketene lamp"
#: data/json/items/tool/science.json
msgid ""
"A section of glass pipe with a bulb in the middle, which contains an "
"electrical heating element.  It is used for producing ketene via pyrolysis "
"of acetone or 1,3-butadiene from cyclohexane, for use in other chemical "
"reactions.  Due to the instability of ketene, it can't be stored and must be"
" used immediately."
msgstr ""
"Una sección de tubo de vidrio con una bombilla en el medio que contiene una "
"resistencia térmica eléctrica. Se usa para producir cetena usando pirólisis "
"de acetona o 1,3-butadieno de ciclohexano, para usar en otras reacciones "
"químicas. Debido a la inestabilidad de la cetena, no puede ser almacenada y "
"debe ser utilizada inmediatamente."

#. ~ Item name
#: data/json/items/tool/science.json
msgid "makerspace kit for STEM"
msgid_plural "makerspace kits for STEM"
msgstr[0] "equipo de makerspace para STEM"
msgstr[1] "equipos de makerspace para STEM"
msgstr[2] "equipos de makerspace para STEM"

#. ~ Description of "makerspace kit for STEM"
#: data/json/items/tool/science.json
msgid ""
"A kit with hundreds of pieces and dozens of blueprints for small engineering"
" projects designed for beginner learners.  Explore mechanics and hydraulics!"
msgstr ""
"Un equipo que tiene cientos de piezas y docenas de planos para pequeños "
"proyectos de ingeniería diseñados para aprendices principiantes. ¡Explora la"
" mecánica y la hidráulica!"

#. ~ Item name
#: data/json/items/tool/science.json
msgid "robotics kit for young learners"
msgid_plural "robotics kits for young learners"
msgstr[0] "kit de robótica para jóvenes estudiantes"
msgstr[1] "kits de robótica para jóvenes estudiantes"
msgstr[2] "kits de robótica para jóvenes estudiantes"

#. ~ Description of "robotics kit for young learners"
#: data/json/items/tool/science.json
msgid ""
"A complete robotics engineering system, for learning the basics of building "
"and programming robots.  Using sensors, motors, a core controller, and "
"hundreds of snap-together building pieces, you can follow the instructions "
"to assemble 12 different robots.  The versatile parts also allow you to make"
" robots according to your own designs."
msgstr ""
"Construye y programa robots con este completo sistema de ingeniería "
"robótica. Mediante el uso de sensores, motores, un controlador central y "
"cientos de piezas de construcción de bloques, puedes seguir las "
"instrucciones para montar 12 robots diferentes. Las piezas versátiles "
"también te permiten crear robots de acuerdo a tus propios diseños."

#. ~ Item name
#: data/json/items/tool/science.json
msgid "stirling engine kit"
msgid_plural "stirling engine kits"
msgstr[0] "kit de motor de Stirling"
msgstr[1] "kits de motor de Stirling"
msgstr[2] "kits de motor de Stirling"

#. ~ Description of "stirling engine kit"
#: data/json/items/tool/science.json
msgid ""
"A stirling engine kit that demonstrates the principles behind the generation"
" of electricity through the use of hot air."
msgstr ""
"El equipo de motor Stirling demuestra los principios detrás de la generación"
" de electricidad a través de la utilización de aire caliente."

#. ~ Item name
#: data/json/items/tool/science.json
msgid "small vacuum oven"
msgid_plural "small vacuum ovens"
msgstr[0] "horno de vacio pequeño"
msgstr[1] "hornos de vacio pequeños"
msgstr[2] "hornos de vacio pequeños"

#. ~ Description of "small vacuum oven"
#: data/json/items/tool/science.json
msgid ""
"A small 0.9 cubic foot vacuum oven used to purge residual solvents out of "
"liquids and solids.  Looks kind of like a microwave."
msgstr ""
"Un horno de vacío de 0.02 metros cúbicos pequeño utilizado para purgar los "
"disolventes residuales de los líquidos y sólidos. Se parece a un microondas."

#. ~ Item name
#: data/json/items/tool/science.json
msgid "small closed loop extractor"
msgid_plural "small closed loop extractors"
msgstr[0] "extractor de bucle cerrado pequeño"
msgstr[1] "extractores de bucle cerrado pequeños"
msgstr[2] "extractores de bucle cerrado pequeños"

#. ~ Description of "small closed loop extractor"
#: data/json/items/tool/science.json
msgid ""
"A small closed loop extractor used for extracting essential oils from "
"organic material, producing a high quality-extract.  It consists of a long "
"metal tube clamped onto a steel \"honey pot\".  Organic material is packed "
"in the tube, flushed with solvent, and essential oils gathered from the pot."
"  Must be powered up to operate."
msgstr ""
"Pequeño extractor de circuito cerrado que se utiliza para extraer aceites "
"esenciales de la materia orgánica produciendo un extracto de alta calidad. "
"Consiste en un tubo metálico largo sujeto a un \"tarro de miel\" de acero. "
"La materia orgánica se introduce en el tubo, se lava con disolvente y se "
"recogen los aceites esenciales del bote. Debe estar encendido para operar."

#. ~ Item name
#: data/json/items/tool/science.json
msgid "large closed loop extractor"
msgid_plural "large closed loop extractors"
msgstr[0] "extractor de bucle cerrado grande"
msgstr[1] "extractores de bucle cerrado grandes"
msgstr[2] "extractores de bucle cerrado grandes"

#. ~ Description of "large closed loop extractor"
#: data/json/items/tool/science.json
msgid ""
"A large machine used for extracting essential oils from large batches of "
"organic material, producing a low-quality crude oil.  It consists of three "
"long metal tubes funneled into a large drum that's set horizontally.  A "
"series of hoses and tubes come out of the machine going to different valves."
"  It needs to be powered up to operate."
msgstr ""
"Una gran máquina utilizada para extraer aceites esenciales de grandes lotes "
"de materia orgánica que produce un aceite crudo de baja calidad. Consta de "
"tres largos tubos metálicos que se introducen en un gran tambor colocado en "
"posición horizontal. De la máquina salen una serie de mangueras y tubos que "
"van a diferentes válvulas. Para que funcione es necesario darle energía."

#. ~ Item name
#: data/json/items/tool/science.json
msgid "makeshift essential oil extractor"
msgid_plural "makeshift essential oil extractors"
msgstr[0] "extractor de aceites esenciales improvisado"
msgstr[1] "extractores de aceites esenciales improvisados"
msgstr[2] "extractores de aceites esenciales improvisados"

#. ~ Description of "makeshift essential oil extractor"
#: data/json/items/tool/science.json
msgid ""
"A makeshift extraction system.  It's pretty much just a 55 gallon drum, a "
"pipe to stir the solution, and a faucet at the bottom to drain the "
"extractor.  Not the most ideal piece of equipment, but it will work."
msgstr ""
"Un sistema de extracción improvisado. Es más o menos un tambor de 208 "
"litros, un tubo para agitar la solución, y un grifo en la parte inferior "
"para drenar el extractor. No es el equipo más ideal, pero funcionará."

#. ~ Item name
#: data/json/items/tool/science.json
msgid "disassembled catalytic cracking reactor"
msgid_plural "disassembled catalytic cracking reactors"
msgstr[0] "reactor de craqueo catalítico desarmado"
msgstr[1] "reactores de craqueo catalítico desarmados"
msgstr[2] "reactores de craqueo catalítico desarmados"

#. ~ Description of "disassembled catalytic cracking reactor"
#: data/json/items/tool/science.json
msgid ""
"A makeshift extraction system, or as makeshift as you can consider something"
" that was purpose-built in a laboratory by a group of experts.  Meticulously"
" disassembled.  You can reassemble and plug it into your own power grid to "
"use it."
msgstr ""

#. ~ Item name
#: data/json/items/tool/science.json
msgid "qualitative filter paper"
msgid_plural "qualitative filter paper"
msgstr[0] "papel de filtro de calidad"
msgstr[1] "papel de filtro de calidad"
msgstr[2] "papel de filtro de calidad"

#. ~ Description of "qualitative filter paper"
#: data/json/items/tool/science.json
msgid ""
"A piece of filter paper for separating solids from liquids.  This filter "
"paper has a rating of 2 microns, separating more solids out than "
"quantitative filter paper, but the process takes longer.  It's intended to "
"be disposable, but you could probably use it for some time before it's "
"unusable."
msgstr ""
"Un filtro de papel que se usa para separar los sólidos de los líquidos. El "
"filtro tiene una calificación de 2 micrones que logra separar más sólidos "
"que un filtro de papel cuantitativo, pero el proceso dura más tiempo. Está "
"diseñado para ser desechable pero probablemente lo puedas usar varias veces "
"antes de que no sirva más."

#. ~ Item name
#: data/json/items/tool/science.json
msgid "quantitative filter paper"
msgid_plural "quantitative filter paper"
msgstr[0] "papel de filtro cuantitativo"
msgstr[1] "papel de filtro cuantitativo"
msgstr[2] "papel de filtro cuantitativo"

#. ~ Description of "quantitative filter paper"
#: data/json/items/tool/science.json
msgid ""
"A piece of filter paper for separating solids from liquids.  This filter "
"paper has a rating of 20 microns, separating less solids out than "
"qualitative filter paper, but the process is much faster.  It's intended to "
"be disposable, but you could probably use it for some time before it's "
"unusable."
msgstr ""
"Un filtro de papel que se usa para separar los sólidos de los líquidos. El "
"filtro tiene una calificación de 20 micrones que logra separar menos sólidos"
" que un filtro de papel cualitativo, pero el proceso es mucho más rápido. "
"Está diseñado para ser desechable pero probablemente lo puedas usar varias "
"veces antes de que no sirva más."

#. ~ Item name
#: data/json/items/tool/science.json
msgid "plastic gasket set"
msgid_plural "plastic gasket sets"
msgstr[0] "conjunto de empaquetaduras de plástico"
msgstr[1] "conjuntos de empaquetaduras de plástico"
msgstr[2] "conjuntos de empaquetaduras de plástico"

#. ~ Description of "plastic gasket set"
#: data/json/items/tool/science.json
msgid ""
"A set of three plastic gaskets.  They're intended to be single-use, but you "
"could probably use it for some time before they're too worn out to use."
msgstr ""
"Un conjunto de tres empaquetaduras plásticas.  Diseñadas para ser "
"desechables aunque probablemente puedas usarlas varias veces antes de que "
"estén muy gastadas."

#. ~ Item name
#: data/json/items/tool/science.json
msgid "vacuum pump"
msgid_plural "vacuum pumps"
msgstr[0] "bomba de vacío"
msgstr[1] "bombas de vacío"
msgstr[2] "bombas de vacío"

#. ~ Description of "vacuum pump"
#: data/json/items/tool/science.json
msgid ""
"A small belt-driven mechanical pump capable of achieving a vacuum of -29.99 "
"hg (50 microns)."
msgstr ""
"Una pequeña bomba mecánica accionada por correa capaz de alcanzar un vacío "
"de -29,99 hg (50 micras)."

#. ~ Item name
#: data/json/items/tool/science.json
msgid "recovery pump"
msgid_plural "recovery pumps"
msgstr[0] "bomba de recuperación"
msgstr[1] "bombas de recuperación"
msgstr[2] "bombas de recuperación"

#. ~ Description of "recovery pump"
#: data/json/items/tool/science.json
msgid ""
"A medium-sized vacuum pump designed to recover solvent (hydrocarbons) from "
"extracted essential oils."
msgstr ""
"Una bomba de vacío de tamaño medio diseñada para recuperar el disolvente "
"(hidrocarburos) de los aceites esenciales extraídos."

#. ~ Energy efficiency is 40%, consuming 355 MJ and 8.936 L of water for 1 kg
#. of H2 and 7.936 kg of O2.
#. ~ Description of "makeshift water electrolyzer"
#: data/json/items/tool/science.json
msgid ""
"A makeshift appliance which decomposes water into oxygen and hydrogen via "
"electrolysis of sodium hydroxide solution.  Much less energy-efficient than "
"actual industrial equipment."
msgstr ""
"Aparato improvisado que descompone el agua en oxígeno e hidrógeno mediante "
"la electrólisis de una solución de hidróxido de sodio. Mucho menos eficiente"
" energéticamente que el equipamiento industrial."

#. ~ Consumes 200 MJ for 1 kg of NH3.
#. ~ Description of "makeshift ammonia machine reactor"
#: data/json/items/tool/science.json
msgid ""
"A huge appliance built from salvaged industrial equipment, which produces "
"ammonia via the Haber-Bosch process from hydrogen and nitrogen.  As it uses "
"primitive catalysts for the reaction, energy efficiency is very low.  This "
"one is powered by electricity."
msgstr ""
"Un enorme aparato construido a partir de equipos industriales recuperados "
"que produce amoniaco mediante el proceso Haber-Bosch a partir de hidrógeno y"
" nitrógeno. La eficiencia de energía es muy baja por usar catalíticos "
"primitivos para la reacción. Este esta alimentado con electricidad."

#. ~ Consumes 20 MJ for 1 kg of NH3.
#. ~ Description of "makeshift ammonia machine pipework"
#: data/json/items/tool/science.json
msgid ""
"A rather complicated system of thick-walled pipes, powerful compressors, and"
" wiring, meant to interface with a reactor producing ammonia from nitrogen "
"and hydrogen via Haber-Bosch process.  It also acts as a power source for "
"all the low-powered electrical components of the system."
msgstr ""
"Un sistema bastante complicado de tuberías gruesas, potentes compresores y "
"cableado destinado a interactuar con un reactor que produce amoniaco a "
"partir de nitrógeno e hidrógeno mediante el proceso Haber-Bosch. También "
"funciona como una fuente de energía para todos los componentes eléctricos "
"que forman el sistema."

#. ~ Uses up 1.2 MJ for 1 m^3 of N2 (1.253 kg), assuming 99.5% purity.
#. ~ Description of "makeshift nitrogen generator"
#: data/json/items/tool/science.json
msgid ""
"A large makeshift appliance which captures nitrogen from the air for use in "
"chemistry projects.  It includes a standard air filter for filtering out "
"dust and other large particles, a deliquescent dryer to remove water vapor "
"from air, and a nitrogen membrane filter to separate nitrogen from dry air."
msgstr ""
"Un dispositivo grande improvisado que captura el nitrógeno del aire para "
"utilizarlo en proyectos de química. Incluye un filtro de aire estándar para "
"filtrar el polvo y otras partículas grandes, un secador delicuescente para "
"quitar el vapor de agua del aire, y un filtro de nitrógeno para separarlo "
"del aire seco."

#. ~ based on a 24lb N-butane tank such as https://www.usalab.com/24lb-n-
#. butane-tank/.  That much butane occupies about 19 liters.  Roughly
#. analogous to 5 gal propane tanks.
#. ~ Item name
#: data/json/items/tool/science.json
msgid "butane tank"
msgid_plural "tanks of butane"
msgstr[0] "tanque de butano"
msgstr[1] "tanques de butano"
msgstr[2] "tanques de butano"

#. ~ based on a 24lb N-butane tank such as https://www.usalab.com/24lb-n-
#. butane-tank/.  That much butane occupies about 19 liters.  Roughly
#. analogous to 5 gal propane tanks.
#. ~ Description of "butane tank"
#: data/json/items/tool/science.json
msgid ""
"A tank of compressed butane.  Aside from its practicality as fuel, it can "
"also be used to extract essential oils from organic material."
msgstr ""
"Un tanque de butano comprimido. Aparte de su uso como combustible, también "
"se puede utilizar para extraer aceites esenciales de la materia orgánica."

#. ~ Item name
#: data/json/items/tool/science.json
msgid "hydrogen tank"
msgid_plural "hydrogen tanks"
msgstr[0] "tanque de hidrógeno"
msgstr[1] "tanques de hidrógeno"
msgstr[2] "tanques de hidrógeno"

#. ~ Description of "hydrogen tank"
#: data/json/items/tool/science.json
msgid ""
"A tank of compressed hydrogen gas.  If you need to make water from scratch, "
"or lift a zeppelin, it could come in handy."
msgstr ""
"Un tanque de gas de hidrógeno comprimido. Si necesitas hacer agua desde "
"cero, o levantar un zepelín, podría ser útil."

#. ~ Item name
#: data/json/items/tool/science.json
#: data/mods/Aftershock/items/containers.json
msgid "pressurized tank"
msgid_plural "pressurized tanks"
msgstr[0] "tanque presurizado"
msgstr[1] "tanques presurizados"
msgstr[2] "tanques presurizados"

#. ~ Description of "pressurized tank"
#: data/json/items/tool/science.json
msgid "A tank designed to hold high pressure gases."
msgstr "Un tanque diseñado para contener gases a altas presiones."

#. ~ Item name
#: data/json/items/tool/science.json
msgid "hygrometer"
msgid_plural "hygrometers"
msgstr[0] "higrómetro"
msgstr[1] "higrómetros"
msgstr[2] "higrómetros"

#. ~ Description of "hygrometer"
#: data/json/items/tool/science.json
msgid "A plastic hygrometer that can read the relative humidity in the air."
msgstr ""
"Un higrómetro de plástico que puede medir la humedad relativa del aire."

#. ~ Item name
#: data/json/items/tool/science.json
msgid "nitrogen tank"
msgid_plural "nitrogen tanks"
msgstr[0] "tanque de nitrógeno"
msgstr[1] "tanques de nitrógeno"
msgstr[2] "tanques de nitrógeno"

#. ~ Description of "nitrogen tank"
#: data/json/items/tool/science.json
msgid ""
"A tank of compressed nitrogen gas.  Nitrogen is useful for its lack of "
"reactivity.  Don't try to breathe it."
msgstr ""
"Un tanque de gas nitrógeno comprimido. El nitrógeno es útil por su falta de "
"reactividad. No intentes respirarlo."

#. ~ Magazine name
#: data/json/items/tool/science.json
msgid "oxygen tank"
msgid_plural "oxygen tanks"
msgstr[0] "tanque de oxígeno"
msgstr[1] "tanques de oxígeno"
msgstr[2] "tanques de oxígeno"

#. ~ Description of magazine "oxygen tank"
#: data/json/items/tool/science.json
msgid ""
"A large steel cylinder used for storing pressurized gas.  It is marked with "
"a faded, but legible O2 symbol."
msgstr ""
"Un gran cilindro de acero utilizado para almacenar gas a presión. Está "
"marcado con un símbolo de O2 descolorido pero legible."

#. ~ Item name
#: data/json/items/tool/science.json
msgid "platinum grille"
msgid_plural "platinum grilles"
msgstr[0] "rejilla de platino"
msgstr[1] "rejillas de platino"
msgstr[2] "rejillas de platino"

#. ~ Description of "platinum grille"
#: data/json/items/tool/science.json
msgid ""
"A metal grille with a layer of platinum plating, suitable for use as a "
"catalyst for some chemical reactions."
msgstr ""
"Una rejilla de metal con una capa de platino, útil para usarse como "
"catalizador para algunas reacciones químicas."

#. ~ Item name
#: data/json/items/tool/science.json
msgid "portal generator"
msgid_plural "portal generators"
msgstr[0] "generador de portal"
msgstr[1] "generadores de portal"
msgstr[2] "generadores de portal"

#. ~ Description of "portal generator"
#: data/json/items/tool/science.json
msgid ""
"A rare, bizarre, and arcane device of an otherworldly nature.  It's giving "
"you a headache just looking at it.  It is covered in alien markings."
msgstr ""
"Este es un dispositivo extraño, bizarro y arcano, de naturaleza "
"sobrenatural. Te duele la cabeza con solo mirarlo. Está cubierto de marcas "
"alienígenas."

#. ~ Description of "teleport pad"
#: data/json/items/tool/science.json
msgid ""
"A kit for a teleporter trap, consisting of a teleporter and a solar cell "
"that is triggered when stepped upon."
msgstr ""
"Un equipo para una trampa de teletransportación que consiste en un "
"teletransportador y una celda solar que se activa cuando se pisa."

#. ~ "done_message" action message of item "teleport pad"
#: data/json/items/tool/science.json
msgid "You place the telepad."
msgstr "Colocas el telepad."

#. ~ Item name
#: data/json/items/tool/science.json
msgid "teleporter"
msgid_plural "teleporters"
msgstr[0] "teletransportador"
msgstr[1] "teletransportadores"
msgstr[2] "teletransportadores"

#. ~ Description of "teleporter"
#: data/json/items/tool/science.json
msgid ""
"An experimental device that will teleport you a short distance when "
"activated."
msgstr ""
"Un dispositivo experimental que te teletransportará a una corta distancia "
"cuando es activado."

#. ~ Item name
#: data/json/items/tool/science.json
msgid "Doppler Radar Turbo 2000"
msgid_plural "Doppler Radar Turbo 2000s"
msgstr[0] "Doppler Radar Turbo 2000"
msgstr[1] "Doppler Radar Turbo 2000"
msgstr[2] "Doppler Radar Turbo 2000"

#. ~ Description of "Doppler Radar Turbo 2000"
#: data/json/items/tool/science.json
msgid ""
"A briefcase with a built-in laptop that looks like it's from the 80s.  Its "
"vintage monochrome monitor displays a plethora of meteorological data.  No "
"sign of the FLDSMDFR, however."
msgstr ""
"Un maletín con un portátil integrado que parece que fuera de los 80. Su "
"antiguo monitor monocromático muestra una plétora de información "
"meteorológica. Sin embargo, no hay rastros del FLDSMDFR."

#. ~ Item name
#: data/json/items/tool/science.json
msgid "basic laboratory analysis kit"
msgid_plural "basic laboratory analysis kits"
msgstr[0] "kit de análisis de laboratorio básico"
msgstr[1] "kits de análisis de laboratorio básico"
msgstr[2] "kits de análisis de laboratorio básico"

#. ~ Description of "basic laboratory analysis kit"
#: data/json/items/tool/science.json
msgid ""
"A hefty kit containing some basic things you should probably not try to do "
"precise chemistry without: a small balance scale, a spectrophotometer, a "
"melting point apparatus, a pH meter, and a set of paper for thin layer "
"chromatography.  This makes it a lot easier to feel confident that the "
"chemical you've made is what you think it is."
msgstr ""
"Este robusto equipo contiene algunas cosas básicas que vas a necesitar para "
"hacer trabajos precisos de química: específicamente, una pequeña balanza, un"
" espectrofotómetro, un aparato de punto de fusión, un medidor de pH y un "
"equipo de papeles finos de cromatografía. Esto hace mucho mas fácil sentirse"
" confiado que el químico que estas haciendo es lo que es."

#. ~ Item name
#: data/json/items/tool/science.json
msgid "small weight scale"
msgid_plural "small weight scales"
msgstr[0] "pequeña balanza"
msgstr[1] "pequeñas balanzas"
msgstr[2] "pequeñas balanzas"

#. ~ Description of "small weight scale"
#: data/json/items/tool/science.json
msgid ""
"A simple scale that uses a set of steel weights on sliding bars to measure a"
" sample's mass quite accurately."
msgstr ""
"Una simple balanza que utiliza un conjunto de pesos de acero en barras "
"deslizantes para medir la masa de una muestra con bastante precisión."

#. ~ Item name
#: data/json/items/tool/science.json
msgid "spectrophotometer"
msgid_plural "spectrophotometers"
msgstr[0] "espectrofotómetro"
msgstr[1] "espectrofotómetros"
msgstr[2] "espectrofotómetros"

#. ~ Description of "spectrophotometer"
#: data/json/items/tool/science.json
msgid ""
"A ubiquitous analytical chemistry tool that measures the light absorption of"
" a liquid sample in a special tube called a cuvette."
msgstr ""
"Esta omnipresente herramienta de química analítica mide la absorción de luz "
"de una muestra líquida en un tubo especial llamado cubeta."

#. ~ Item name
#: data/json/items/tool/science.json
msgid "set of spectrometry cuvettes"
msgid_plural "sets of spectrometry cuvettes"
msgstr[0] "conjunto de cubetas de espectrometría"
msgstr[1] "conjuntos de cubetas de espectrometría"
msgstr[2] "conjuntos de cubetas de espectrometría"

#. ~ Description of "set of spectrometry cuvettes"
#: data/json/items/tool/science.json
msgid ""
"A small box filled with precisely-calibrated square plastic tubes for "
"laboratory spectrometer use."
msgstr ""
"Una pequeña caja llena de tubos plásticos cuadrados precisamente calibrados,"
" para espectrometría de laboratorio."

#. ~ Item name
#: data/json/items/tool/science.json
msgid "pH meter"
msgid_plural "pH meters"
msgstr[0] "medidor de pH"
msgstr[1] "medidores de pH"
msgstr[2] "medidores de pH"

#. ~ Description of "pH meter"
#: data/json/items/tool/science.json
msgid ""
"A pair of glass probes attached to a voltmeter.  By putting one probe into a"
" calibration solution (conveniently included) and the other in a substance, "
"you can calculate the substance's acidity."
msgstr ""
"Un par de sondas de vidrio en un voltímetro. Al poner una sonda en la "
"solución de calibración (incluída convenientemente en el equipo) y la otra "
"sonda en una sustancia, se puede calcular su acidez."

#. ~ Item name
#: data/json/items/tool/science.json
msgid "voltmeter"
msgid_plural "voltmeters"
msgstr[0] "voltímetro"
msgstr[1] "voltímetros"
msgstr[2] "voltímetros"

#. ~ Description of "voltmeter"
#: data/json/items/tool/science.json
msgid ""
"A device with two probes that let you measure the electrical potential "
"between two points."
msgstr ""
"Un dispositivo que tiene dos sondas que permiten medir el potencial "
"eléctrico entre dos puntos."

#. ~ Dimensions from a sampling of consumer digital multimeter models online.
#. ~ Item name
#: data/json/items/tool/science.json
msgid "multimeter"
msgid_plural "multimeters"
msgstr[0] "multimetro"
msgstr[1] "multimetros"
msgstr[2] "multimetros"

#. ~ Dimensions from a sampling of consumer digital multimeter models online.
#. ~ Description of "multimeter"
#: data/json/items/tool/science.json
msgid ""
"A gadget that is a little bigger than a handheld calculator, with a digital "
"display and two pointed probes connected by wires.  It can measure not just "
"voltage, but current in amps, and resistance in ohms, as well as test for "
"electrical continuity."
msgstr ""
"Un aparato un poco más grande que una calculadora de mano, con una pantalla "
"digital y dos sondas puntiagudas conectadas por cables. Puede medir no sólo "
"la tensión, sino también la corriente en amperios y la resistencia en "
"ohmios, así como comprobar la continuidad eléctrica."

#. ~ Item name
#: data/json/items/tool/science.json
msgid "melting point apparatus"
msgid_plural "units of melting point apparatus"
msgstr[0] "aparato de punto de fusión"
msgstr[1] "aparatos de punto de fusión"
msgstr[2] "aparatos de punto de fusión"

#. ~ Description of "melting point apparatus"
#: data/json/items/tool/science.json
msgid ""
"A hot plate with a metal housing attached.  The metal housing has a "
"magnification viewport and a slot into which a capillary tube containing a "
"crystallized sample is inserted.  The device lets you precisely measure the "
"melting point of a crystal, a property very useful in identifying what it is"
" and how pure it is."
msgstr ""
"Una placa caliente, con una carcasa metálica adjunta. La carcasa metálica "
"tiene una mirilla de aumento y una ranura en la que se inserta un tubo "
"capilar que contiene una muestra cristalizada. El dispositivo permite medir "
"con precisión el punto de fusión de un cristal, una propiedad muy útil para "
"identificar qué es y qué tan puro es."

#. ~ Item name
#: data/json/items/tool/science.json
msgid "vortex device"
msgid_plural "vortex devices"
msgstr[0] "dispositivo de vórtice"
msgstr[1] "dispositivos de vórtice"
msgstr[2] "dispositivos de vórtice"

#. ~ Description of "vortex device"
#: data/json/items/tool/science.json
msgid ""
"A small, hefty, boring-looking machine.  Its weighted trapezoidal frame has "
"a single on-off switch and a speed dial, and on top of it sits a rubber "
"receptacle.  Pressing a test tube into the receptacle would, with power, "
"rapidly shake and mix the contents of the test tube.  It's surprisingly fun "
"to use."
msgstr ""
"Una máquina pequeña, pesada y aburrida. Su pesado marco trapezoidal tiene un"
" solo interruptor de encendido, apagado, un dial de velocidad, y encima de "
"él se encuentra un receptáculo de goma. Al presionar un tubo de ensayo en el"
" receptáculo se agita rápidamente y se mezcla el contenido del tubo de "
"ensayo. Es sorprendentemente divertido de usar."

#. ~ Item name
#: data/json/items/tool/science.json
msgid "light detector"
msgid_plural "light detectors"
msgstr[0] "detector de luz"
msgstr[1] "detectores de luz"
msgstr[2] "detectores de luz"

#. ~ Description of "light detector"
#: data/json/items/tool/science.json
msgid ""
"A photodiode on a chip, designed to convert incoming light to electrical "
"energy for quantification."
msgstr ""
"Un fotodiodo puesto en un chip, diseñado para convertir la luz que recibe en"
" energía eléctrica para poder medirla."

#. ~ Item name
#: data/json/items/tool/science.json
msgid "glass prism"
msgid_plural "glass prisms"
msgstr[0] "prisma de vidrio"
msgstr[1] "prismas de vidrio"
msgstr[2] "prismas de vidrio"

#. ~ Description of "glass prism"
#: data/json/items/tool/science.json
msgid ""
"A high-quality crystal glass prism for separating and redirecting light."
msgstr ""
"Un prisma de cristal de alta calidad que se usa para dividir y redireccionar"
" la luz."

#. ~ Volume here is displacement volume of a corked 25mL test tube.
#. ~ Item name
#: data/json/items/tool/science.json
msgid "small glass tube"
msgid_plural "small glass tubes"
msgstr[0] "tubo pequeño de vidrio"
msgstr[1] "tubos pequeños de vidrio"
msgstr[2] "tubos pequeños de vidrio"

#. ~ Volume here is displacement volume of a corked 25mL test tube.
#. ~ Description of "small glass tube"
#: data/json/items/tool/science.json
msgid "A small glass tube.  Small, tube-shaped, and made of glass."
msgstr ""
"Un pequeño tubo de vidrio. Pequeño, con forma de tubo y hecho de vidrio."

#. ~ Item name
#: data/json/items/tool/science.json
msgid "microscope"
msgid_plural "microscopes"
msgstr[0] "microscopio"
msgstr[1] "microscopios"
msgstr[2] "microscopios"

#. ~ Description of "microscope"
#: data/json/items/tool/science.json
msgid ""
"A classic tool for the ages!  This hefty, durable piece of lab equipment "
"makes small things look bigger.  Without electricity the light doesn't work,"
" but the rest of it is surprisingly functional.  Unfortunately it's not "
"useful for very much at the moment."
msgstr ""
"¡Una herramienta clásica para las edades! Esta pesada y duradera pieza de "
"equipo de laboratorio hace que las cosas pequeñas parezcan más grandes. Sin "
"electricidad la luz no funciona, pero el resto es sorprendentemente "
"funcional. Desafortunadamente no es útil para mucho en este momento."

#. ~ Item name
#: data/json/items/tool/science.json
msgid "dissecting microscope"
msgid_plural "dissecting microscopes"
msgstr[0] "microscopio de disección"
msgstr[1] "microscopios de disección"
msgstr[2] "microscopios de disección"

#. ~ Description of "dissecting microscope"
#: data/json/items/tool/science.json
msgid ""
"This microscope has less magnification than a standard one.  It's also "
"stereoscopic and produces a neat 3-D image of the surface.  It was typically"
" used for performing dissections and other fine-detail work on small "
"creatures.  It still works pretty well with an added light source, but what "
"would you do with it?"
msgstr ""
"Este microscopio tiene menos aumentos que uno estándar. También es "
"estereoscópico y produce una imagen nítida en 3D de la superficie. "
"Típicamente se usaba para hacer disecciones y otros trabajos de detalle fino"
" en pequeñas criaturas. Todavía funciona bastante bien con una fuente de luz"
" añadida, pero ¿qué harías con él?"

#. ~ Item name
#: data/json/items/tool/science.json
msgid "separation funnel"
msgid_plural "separation funnels"
msgstr[0] "embudo de separación"
msgstr[1] "embudos de separación"
msgstr[2] "embudos de separación"

#. ~ Description of "separation funnel"
#: data/json/items/tool/science.json
msgid ""
"This thing doesn't look much like a funnel.  It's a teardrop-shaped piece of"
" glass with a stopper at the wide end and a valve at the other.  It can be "
"used to wash one liquid with another, like water and an oil, and then draw "
"off whichever of the two liquids contains a higher amount of whatever "
"compound you're trying to isolate.  With a high level of skill, it can also "
"be used to make juvenile farting noises."
msgstr ""
"Esta cosa no se parece mucho a un embudo. Es una pieza de vidrio en forma de"
" lágrima con un tapón en el extremo ancho y una válvula en el otro. Se puede"
" usar para separar un líquido de otro, como el agua y el aceite, y luego "
"extraer cualquiera de los dos líquidos que contenga una mayor cantidad de "
"cualquier compuesto que estés tratando de aislar. Con un alto nivel de "
"habilidad también puede ser usado para hacer ruidos de pedos juveniles."

#. ~ Item name
#: data/json/items/tool/science.json
msgid "burette"
msgid_plural "burettes"
msgstr[0] "bureta"
msgstr[1] "buretas"
msgstr[2] "buretas"

#. ~ Description of "burette"
#: data/json/items/tool/science.json
msgid ""
"A tall glass column with a stopcock at the end.  If you're serious about "
"chemistry, you probably have a tattoo of one of these somewhere."
msgstr ""
"Una alta columna de vidrio con una llave de paso al final. Si hablas en "
"serio sobre la química, probablemente tengas un tatuaje de uno de estos en "
"alguna parte."

#. ~ Item name
#: data/json/items/tool/science.json
msgid "rotary evaporator"
msgid_plural "rotary evaporators"
msgstr[0] "evaporador rotativo"
msgstr[1] "evaporadores rotativos"
msgstr[2] "evaporadores rotativos"

#. ~ Description of "rotary evaporator"
#: data/json/items/tool/science.json
msgid ""
"Just looking at this thing makes you feel like a proper mad scientist.  It's"
" a series of glass tubes and round flasks, connected to a central motor and "
"a heating element.  The heating element warms one flask, kept rotating by "
"the motor, evaporating the contents.  The vapor is then condensed in the "
"tubes and collected in another flask, in case you wanted to save it for "
"later."
msgstr ""
"Sólo con mirar esta cosa te sientes como un verdadero científico loco. Es "
"una serie de tubos de vidrio y frascos redondos, conectados a un motor "
"central y a un elemento calefactor. El elemento calefactor calienta un "
"frasco, mantenido girando por el motor, evaporando el contenido. El vapor se"
" condensa en los tubos y se recoge en otro frasco, en caso de que quiera "
"guardarlo para más tarde."

#. ~ Item name
#: data/json/items/tool/science.json
msgid "fractional distillation apparatus"
msgid_plural "fractional distillation apparati"
msgstr[0] "aparato de destilación fraccionaria"
msgstr[1] "aparatos de destilación fraccionaria"
msgstr[2] "aparatos de destilación fraccionaria"

#. ~ Description of "fractional distillation apparatus"
#: data/json/items/tool/science.json
msgid ""
"One of the classic pieces of mad science glassware, this is a small-volume "
"still that passes vapor through a fractional distillation column and then "
"condenses the distillate in a cooled collection column.  A grad student or a"
" robot (is there really any difference?) collects the distillate in "
"fractions so that specific contents can be analyzed.  Going a few "
"milliliters at a time, it would not be very effective to try to distill "
"whiskey in this thing."
msgstr ""
"Una de las piezas clásicas de la cristalería de la ciencia loca, se trata "
"básicamente de un alambique de pequeño volumen que pasa el vapor a través de"
" una columna de destilación fraccionada y luego condensa el destilado en una"
" columna de recogida refrigerada. Un estudiante de posgrado o un robot "
"(¿realmente hay alguna diferencia?) recoge el destilado en fracciones para "
"que se pueda analizar su contenido específico. Con unos pocos mililitros a "
"la vez, no sería muy efectivo intentar destilar whisky en esta cosa."

#. ~ Item name
#: data/json/items/tool/science.json
msgid "electrophoresis tray"
msgid_plural "electrophoresis trays"
msgstr[0] "bandeja de electroforesis"
msgstr[1] "bandejas de electroforesis"
msgstr[2] "bandejas de electroforesis"

#. ~ Description of "electrophoresis tray"
#: data/json/items/tool/science.json
msgid ""
"A set of plastic trays, electrodes, and a power supply designed to create an"
" electric voltage gradient through a liquid solution containing a solid gel."
"  Stuff like proteins and DNA would then get separated on the gel according "
"to electrical charge and size.  Pretty useless now for anything but salvage."
msgstr ""
"Un conjunto de bandejas de plástico, electrodos y una fuente de alimentación"
" diseñada para crear un gradiente de tensión eléctrica a través de una "
"solución líquida que contiene un gel sólido. Cosas como las proteínas y el "
"ADN se separaran en el gel según la carga eléctrica y el tamaño. Bastante "
"inútil ahora, para cualquier cosa menos para piezas."

#. ~ Item name
#: data/json/items/tool/science.json
msgid "microcentrifuge"
msgid_plural "microcentrifuges"
msgstr[0] "microcentrifugadora"
msgstr[1] "microcentrifugadoras"
msgstr[2] "microcentrifugadoras"

#. ~ Description of "microcentrifuge"
#: data/json/items/tool/science.json
msgid ""
"A smaller, benchtop version of the larger furniture-sized centrifuge.  Don't"
" be fooled by its portable scale; it's still a very powerful piece of "
"equipment that can spin stuff really quickly.  It's not a toy!"
msgstr ""
"Una versión más pequeña, de mesa, de la centrifugadora más grande del tamaño"
" de un mueble. No se deje engañar por su escala portátil; sigue siendo un "
"equipo muy poderoso que puede hacer girar cosas muy rápidamente. ¡No es un "
"juguete!"

#. ~ Item name
#: data/json/items/tool/science.json
msgid "plastic stopcock"
msgid_plural "plastic stopcocks"
msgstr[0] "grifo de cierre de plastico"
msgstr[1] "grifos de cierre de plastico"
msgstr[2] "grifos de cierre de plastico"

#. ~ Description of "plastic stopcock"
#: data/json/items/tool/science.json
msgid ""
"Stop giggling.  This is a tiny plastic valve, get your mind out of the "
"gutter."
msgstr ""
"Deja de reírte. Esta es una pequeña válvula de plástico, saca tu mente de la"
" cuneta."

#. ~ Item name
#: data/json/items/tool/science.json
msgid "test tube rack"
msgid_plural "test tube racks"
msgstr[0] "soporte para tubos de ensayo"
msgstr[1] "soportes para tubos de ensayo"
msgstr[2] "soportes para tubos de ensayo"

#. ~ Description of "test tube rack"
#: data/json/items/tool/science.json
msgid ""
"A plastic box with holes in it.  Not that exciting, unless you're desperate "
"for a place to store a test tube.  Then it's great."
msgstr ""
"Una caja plástica con agujeros en ella. No muy excitante, a menos que estés "
"desesperado por un lugar para guardar tubos de ensayo. En ese caso es "
"perfecta."

#. ~ Item name
#: data/json/items/tool/science.json
msgid "microcentrifuge tube tray"
msgid_plural "microcentrifuge tube trays"
msgstr[0] "bandeja de tubos de microcentrífugadora"
msgstr[1] "bandejas de tubos de microcentrífugadora"
msgstr[2] "bandejas de tubos de microcentrífugadora"

#. ~ Description of "microcentrifuge tube tray"
#: data/json/items/tool/science.json
msgid ""
"A plastic tray riddled with small holes, for storing microcentrifuge tubes."
msgstr ""
"Una bandeja de plástico llena de pequeños agujeros, para almacenar tubos de "
"microcentrifugadora."

#. ~ Item name
#: data/json/items/tool/science.json
msgid "ring stand"
msgid_plural "ring stands"
msgstr[0] "soporte de anillo"
msgstr[1] "soportes de anillo"
msgstr[2] "soportes de anillo"

#. ~ Description of "ring stand"
#: data/json/items/tool/science.json
msgid "A heavy metal plate and a sturdy rod, for clamping lab stuff to."
msgstr ""
"Una placa de metal pesado y una varilla robusta, para sujetar cosas de "
"laboratorio."

#. ~ Item name
#: data/json/items/tool/science.json
msgid "set of ring stand clamps"
msgid_plural "sets of ring stand clamps"
msgstr[0] "juego de abrazaderas de soporte de anillo"
msgstr[1] "juegos de abrazaderas de soporte de anillo"
msgstr[2] "juegos de abrazaderas de soporte de anillo"

#. ~ Description of "set of ring stand clamps"
#: data/json/items/tool/science.json
msgid ""
"A small box with a jumbled assortment of clamps for mounting on ring stands."
"  There seems to be some sort of rule that all of them are missing at least "
"one wing nut for tightening; twist ties, duct tape, and other random stuff "
"has been used to compensate."
msgstr ""
"Una pequeña caja con un surtido mezclado de abrazaderas para montar en los "
"soportes de los anillos. Parece haber algún tipo de regla que dice que a "
"todas ellas les falta al menos una tuerca de mariposa para apretarlas; "
"parece que se ha añadido ataduras giratorias, cinta americana y otras cosas "
"al azar para compensar."

#. ~ Item name
#: data/json/items/tool/science.json
msgid "sextant"
msgid_plural "sextants"
msgstr[0] "sextante"
msgstr[1] "sextantes"
msgstr[2] "sextantes"

#. ~ Description of "sextant"
#: data/json/items/tool/science.json
msgid ""
"A tool for measuring angles of distant objects.  It can be used for "
"measuring the altitude of the sun."
msgstr ""
"Una herramienta para medir ángulos de objetos lejanos. Puede utilizarse para"
" medir la altitud del sol."

#. ~ Item name
#: data/json/items/tool/science.json
msgid "lux meter"
msgid_plural "lux meters"
msgstr[0] "luxómetro"
msgstr[1] "luxómetros"
msgstr[2] "luxómetros"

#. ~ Description of "lux meter"
#: data/json/items/tool/science.json
msgid "A tool for measuring illuminance."
msgstr "Una herramienta para medir la luminancia."

#. ~ Item name
#: data/json/items/tool/science.json
msgid "Mi-go Biotech"
msgid_plural "Mi-go Biotech"
msgstr[0] "Biotecnología Mi-go"
msgstr[1] "Biotecnología Mi-go"
msgstr[2] "Biotecnología Mi-go"

#. ~ Description of "Mi-go Biotech"
#: data/json/items/tool/science.json
msgid "A piece of mi-go biotechnology."
msgstr "Una pieza de biotecnología mi-go."

#. ~ "description" action message of item "Mi-go Biotech"
#. ~ "description" action message of item "test dust storm causer"
#: data/json/items/tool/science.json
#: data/mods/desert_region/weather/weather_eoc.json
msgid "Touch the opening."
msgstr ""

#. ~ Conditional name for "Mi-go Biotech" when VAR matches
#. npctalk_var_mbt_f_function
#: data/json/items/tool/science.json
#, c-format
msgid "%s (happy)"
msgid_plural "%s (happy)"
msgstr[0] "%s (feliz)"
msgstr[1] "%s (feliz)"
msgstr[2] "%s (feliz)"

#. ~ Conditional name for "Mi-go Biotech" when VAR matches
#. npctalk_var_mbt_f_function
#: data/json/items/tool/science.json
#, c-format
msgid "%s (focus)"
