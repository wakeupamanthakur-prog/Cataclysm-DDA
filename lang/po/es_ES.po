msgid_plural ".22 blank"
msgstr[0] ".22 blank"
msgstr[1] ".22 blank"
msgstr[2] ".22 blank"

#. ~ Description of ".22 blank"
#: data/json/items/ammo/blank.json
msgid "A powder load .22 blank used for powder actuated tools."
msgstr ""
"Un cartucho de fogueo de pólvora .22 utilizado para herramientas accionadas "
"por pólvora."

