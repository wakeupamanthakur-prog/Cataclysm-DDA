msgstr[1] "latas improvisadas de gas"
msgstr[2] "latas improvisadas de gas"

#. ~ Description of "makeshift gas canister"
#: data/json/items/tool/explosives.json
msgid ""
"A crude gas bomb made using household chemicals.  Use this item to arm it.  "
"In three seconds it will begin to expel a highly toxic gas for a short time."
"  This gas poisons those exposed to it, in addition to obscuring vision and "
"scent."
msgstr ""
"Una bombona de gas rudimentaria que utiliza productos químicos domésticos. "
"Usa este objeto para montarla. En tres segundos comenzará a expulsar un gas "
"altamente tóxico durante un breve periodo de tiempo. Este gas envenena a "
"quienes se exponen a él, además de oscurecer la visión y el olor."

#. ~ "menu_text" action message of item "makeshift gas canister"
#: data/json/items/tool/explosives.json
msgid "Arm"
msgstr "Brazo"

#. ~ "msg" action message of item "makeshift gas canister"
#: data/json/items/tool/explosives.json
msgid "You arm the makeshift gas canister."
msgstr "Activas la lata improvisada de gas."

#. ~ Item name
#: data/json/items/tool/explosives.json
