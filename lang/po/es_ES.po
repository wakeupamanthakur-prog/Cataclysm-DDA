#: data/json/items/comestibles/brewing.json
msgid "Fermented, but not distilled whiskey.  No longer tastes sweet."
msgstr "Whisky fermentado, pero no destilado. Ya no tiene sabor dulce."

#. ~ Item name
#: data/json/items/comestibles/brewing.json
msgid "gin mash"
msgid_plural "gin mash"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. ~ Description of "gin mash"
#: data/json/items/comestibles/brewing.json
msgid "Unfermented gin mash.  Fermenting it will produce gin."
msgstr "Puré de ginebra sin fermentar. Al fermentarlo se obtiene la ginebra."

#. ~ Item name
#: data/json/items/comestibles/brewing.json
msgid "gin wash"
msgid_plural "gin wash"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. ~ Description of "gin wash"
#: data/json/items/comestibles/brewing.json
msgid ""
"Gin wash, after the junipers have had time to add flavor.  Ready to be "
"distilled or drunk as is."
msgstr ""
"Lavado de ginebra, después de que los enebros hayan tenido tiempo de añadir "
"sabor. Listo para ser destilado o bebido tal cual."

#. ~ Item name
#: data/json/items/comestibles/brewing.json
msgid "sake mash"
msgid_plural "sake mash"
msgstr[0] "puré de sake"
msgstr[1] "pures de sake"
msgstr[2] "pures de sake"

#. ~ Description of "sake mash"
#: data/json/items/comestibles/brewing.json
msgid ""
"A fine mix of water, koji rice and yeast, ready to be fermented into sake "
"once set in a fermenting vat."
msgstr ""
"Una fina mezcla de agua, arroz koji y levadura, lista para ser fermentada en"
" sake una vez puesta en una cuba de fermentación."

#. ~ Item name
#: data/json/items/comestibles/brewing.json
msgid "unfermented soy sauce"
msgid_plural "unfermented soy sauce"
msgstr[0] "salsa de soja sin fermentar"
msgstr[1] "salsa de soja sin fermentar"
msgstr[2] "salsa de soja sin fermentar"

#. ~ Description of "unfermented soy sauce"
#: data/json/items/comestibles/brewing.json
msgid ""
"Brine with mashed soybeans, wheat flour and koji mold added to it.  If you "
"want to make soy sauce from this, the next step would be to let it ferment."
msgstr ""
"Salmuera con puré de soja, harina de trigo y moho koji añadidos a ella. Si "
"se quiere hacer salsa de soja con esto, el siguiente paso sería dejarla "
"fermentar."

#. ~ Item name
#: data/json/items/comestibles/brewing.json
msgid "unstrained soy sauce"
msgid_plural "unstrained soy sauce"
msgstr[0] "salsa de soja sin filtrar"
msgstr[1] "salsa de soja sin filtrar"
msgstr[2] "salsa de soja sin filtrar"

#. ~ Description of "unstrained soy sauce"
#: data/json/items/comestibles/brewing.json
msgid ""
"Nearly-finished soy sauce that still has some solid particles floating in "
"it.  Still needs to be strained, and also pasteurized to get rid of harmful "
"bacteria."
msgstr ""
"Salsa de soja casi terminada que todavía tiene algunas partículas sólidas "
"flotando en ella. Todavía necesita ser colada, y también pasteurizada para "
"deshacerse de las bacterias dañinas."

