#: src/player_hardcoded_effects.cpp:379
msgid "You feel a little strange."
msgstr "Te sientes un poco extraño."

#: src/player_hardcoded_effects.cpp:383
msgid "The world takes on a dreamlike quality."
msgstr "El mundo adopta una similitud a los sueños."

#: src/player_hardcoded_effects.cpp:385
msgid "You have a sudden nostalgic feeling."
msgstr "De repente, te asalta un sentimiento de nostalgia."

#: src/player_hardcoded_effects.cpp:387
msgid "Everything around you is starting to breathe."
msgstr "Todo empieza a respirar alrededor tuyo."

#: src/player_hardcoded_effects.cpp:389
msgid "Something feels very, very wrong."
msgstr "Algo parece estar mal, muy mal."

#: src/player_hardcoded_effects.cpp:393
msgid "You feel sick to your stomach."
msgstr "Te sientes mal del estómago."

#: src/player_hardcoded_effects.cpp:401
msgid "\"I think it's starting to kick in.\""
msgstr "\"Creo que está empezando a hacer efecto.\""

#: src/player_hardcoded_effects.cpp:402
msgid "\"Oh God, what's happening?\""
msgstr "\"Oh Dios, ¿qué está pasando?\""

#: src/player_hardcoded_effects.cpp:403
msgid "\"Of course… it's all fractals!\""
msgstr "\"Por supuesto... ¡son todos fractales!\""

#: src/player_hardcoded_effects.cpp:404
msgid "\"Huh?  What was that?\""
msgstr "\"¿Eh? ¿Qué fue eso?\""

#: src/player_hardcoded_effects.cpp:420
msgid "Fractal patterns dance across your vision."
msgstr "Adelante de tus ojos, comienzan a bailar estructuras fractales."

#: src/player_hardcoded_effects.cpp:427
msgid "Dancing fractals distract you."
msgstr "Fractales danzantes te distraen."

#: src/player_hardcoded_effects.cpp:434
msgid "Everything looks SO boring now."
msgstr "Ahora todo parece MUY aburrido."

#: src/player_hardcoded_effects.cpp:436
msgid "Things are returning to normal."
msgstr "Las cosas vuelven a la normalidad."

#: src/player_hardcoded_effects.cpp:480
msgid "Your thoughts are unclear."
msgstr "Tus pensamientos están nublados."

#: src/player_hardcoded_effects.cpp:482
msgid "Your face is stiff from the cold."
msgstr "Tienes la cara dura de frío."

#: src/player_hardcoded_effects.cpp:484
msgid "You quiver from the cold."
msgstr "Estás temblando de frío."

#: src/player_hardcoded_effects.cpp:484
msgid "Your torso is freezing cold.  You should put on a few more layers."
msgstr "Tu torso está helado. Deberías ponerte unas pocas capas más."

#: src/player_hardcoded_effects.cpp:485
msgid "Your shivering makes you unsteady."
msgstr "Los escalofríos te hacen temblar."

#: src/player_hardcoded_effects.cpp:486 src/player_hardcoded_effects.cpp:487
msgid "Your left arm is shivering."
msgstr "Te tiembla el brazo izquierdo."

#: src/player_hardcoded_effects.cpp:486 src/player_hardcoded_effects.cpp:487
msgid "Your left arm trembles from the cold."
msgstr "Tu brazo izquierdo se estremece por el frío."

#: src/player_hardcoded_effects.cpp:488 src/player_hardcoded_effects.cpp:489
msgid "Your right arm is shivering."
msgstr "Te tiembla el brazo derecho."

#: src/player_hardcoded_effects.cpp:488 src/player_hardcoded_effects.cpp:489
msgid "Your right arm trembles from the cold."
msgstr "Tu brazo derecho se estremece por el frío."

#: src/player_hardcoded_effects.cpp:490 src/player_hardcoded_effects.cpp:491
msgid "Your left hand feels like ice."
msgstr "Tienes la mano izquierda helada."

#: src/player_hardcoded_effects.cpp:490 src/player_hardcoded_effects.cpp:491
msgid "Your left hand quivers in the cold."
msgstr "Tu mano izquierda tiembla por el frío."

#: src/player_hardcoded_effects.cpp:492 src/player_hardcoded_effects.cpp:493
msgid "Your right hand feels like ice."
msgstr "Tienes la mano derecha helada."

#: src/player_hardcoded_effects.cpp:492 src/player_hardcoded_effects.cpp:493
msgid "Your right hand quivers in the cold."
msgstr "Tu mano derecha se estremece por el frío."

#: src/player_hardcoded_effects.cpp:494 src/player_hardcoded_effects.cpp:495
msgid "Your left leg trembles against the relentless cold."
msgstr "Tu pierna izquierda se estremece por el frío implacable."

#: src/player_hardcoded_effects.cpp:494 src/player_hardcoded_effects.cpp:495
#: src/player_hardcoded_effects.cpp:496 src/player_hardcoded_effects.cpp:497
msgid "Your legs uncontrollably shake from the cold."
msgstr "Tus piernas tiemblan descontroladamente por el frío."

#: src/player_hardcoded_effects.cpp:496 src/player_hardcoded_effects.cpp:497
msgid "Your right leg trembles against the relentless cold."
msgstr "Tu pierna derecha se estremece por el frío implacable."

#: src/player_hardcoded_effects.cpp:498 src/player_hardcoded_effects.cpp:499
msgid "Your left foot feels frigid."
msgstr "Tu pie izquierdo está gélido."

#: src/player_hardcoded_effects.cpp:498
msgid "Your left foot is as nimble as a block of ice."
msgstr "Tu pie izquierdo está como un bloque de hielo."

#: src/player_hardcoded_effects.cpp:499
msgid "Your freezing left foot messes up your balance."
msgstr "Pierdes un poco el balance por tener el pie izquierdo helado."

#: src/player_hardcoded_effects.cpp:500 src/player_hardcoded_effects.cpp:501
msgid "Your right foot feels frigid."
msgstr "Tu pie derecho está gélido."

#: src/player_hardcoded_effects.cpp:500
msgid "Your right foot is as nimble as a block of ice."
msgstr "Tu pie derecho está como un bloque de hielo."

#: src/player_hardcoded_effects.cpp:501
msgid "Your freezing right foot messes up your balance."
msgstr "Pierdes un poco el balance por tener el pie derecho helado."

#: src/player_hardcoded_effects.cpp:514
msgid "Your head is pounding from the heat."
msgstr "Sientes un martilleo en tu cabeza debido al calor."

#: src/player_hardcoded_effects.cpp:516
msgid "You are sweating profusely."
msgstr "Estás transpirando como testigo falso."

#: src/player_hardcoded_effects.cpp:518 src/player_hardcoded_effects.cpp:519
msgid "Your left hand's too sweaty to grip well."
msgstr "Tu mano izquierda está patinosa por la transpiración."

#: src/player_hardcoded_effects.cpp:520 src/player_hardcoded_effects.cpp:521
msgid "Your right hand's too sweaty to grip well."
msgstr "Tu mano derecha está patinosa por la transpiración."

#: src/player_hardcoded_effects.cpp:522
msgid "Your left leg is cramping up."
msgstr "Sientes un calambre en la pierna izquierda."

#: src/player_hardcoded_effects.cpp:524
msgid "Your right leg is cramping up."
msgstr "Sientes un calambre en la pierna derecha."

#: src/player_hardcoded_effects.cpp:526
msgid "Your left foot is swelling in the heat."
msgstr "Sientes el pie izquierdo hinchado por el calor."

#: src/player_hardcoded_effects.cpp:528
msgid "Your right foot is swelling in the heat."
msgstr "Sientes el pie derecho hinchado por el calor."

#: src/player_hardcoded_effects.cpp:547
msgid "The heat is making you see things."
msgstr "El calor te está haciendo ver cosas."

#: src/player_hardcoded_effects.cpp:556 src/player_hardcoded_effects.cpp:557
msgid "You have trouble grasping with your numb fingers."
msgstr "Te cuesta agarrar cosas con los dedos dormidos."

#: src/player_hardcoded_effects.cpp:558 src/player_hardcoded_effects.cpp:559
#: src/player_hardcoded_effects.cpp:560 src/player_hardcoded_effects.cpp:561
msgid "Your foot has gone numb."
msgstr "Se te durmió el pie."

#: src/player_hardcoded_effects.cpp:562 src/player_hardcoded_effects.cpp:563
msgid "Your face feels numb."
msgstr "Sientes la cara adormecida."

#: src/player_hardcoded_effects.cpp:589
msgid "Glowing lights surround you, and you teleport."
msgstr "Te rodean luces brillantes, y te teletransportás."

#: src/player_hardcoded_effects.cpp:609
msgid "You pass out."
msgstr "Te desmayaste."

#: src/player_hardcoded_effects.cpp:643 src/player_hardcoded_effects.cpp:1299
msgid "A monster appears nearby!"
msgstr "¡Aparece un monstruo cerca!"

#: src/player_hardcoded_effects.cpp:644 src/player_hardcoded_effects.cpp:1300
msgid "A portal opens nearby, and a monster crawls through!"
msgstr "¡Un portal se abre cerca, y un monstruo aparece arrastrándose!"

#: src/player_hardcoded_effects.cpp:653
msgid "You shudder suddenly."
msgstr "De repente, sientes un escalofrío."

#: src/player_hardcoded_effects.cpp:667
msgid "Your vision is filled with bright lights…"
msgstr "Tu visión se llena de luces brillantes..."

#: src/player_hardcoded_effects.cpp:683
msgid "You're suddenly covered in ectoplasm."
msgstr "De repente, estás cubierto de ectoplasma."

#: src/player_hardcoded_effects.cpp:694
msgid "We have many colonists awaiting passage."
msgstr "Tenemos muchos colonos esperando un pasaje."

#: src/player_hardcoded_effects.cpp:723
msgid ""
"You're experiencing loss of basic motor skills and blurred vision.  Your "
"mind recoils in horror, unable to communicate with your spinal column."
msgstr ""
"Estás sintiendo una pérdida de tus habilidades motoras básicas, y visión "
"borrosa. Tu mente retrocede espantada, incapaz de comunicarse con tu columna"
" vertebral."

#: src/player_hardcoded_effects.cpp:724
msgid "You stagger and fall!"
msgstr "¡Te tambaleas y te caes!"

#: src/player_hardcoded_effects.cpp:739
msgid "There's some kind of big machine in the sky."
msgstr "Hay una especie de máquina grande en el cielo."

#: src/player_hardcoded_effects.cpp:742
msgid "It's some kind of electric snake, coming right at you!"
msgstr "Es como una serpiente eléctrica, ¡que viene hacia ti!"

#: src/player_hardcoded_effects.cpp:749
msgid ""
"Order us some golf shoes, otherwise we'll never get out of this place alive."
msgstr "Pídenos unos zapatos de golf, o nunca saldremos vivos de aquí."

#: src/player_hardcoded_effects.cpp:753
msgid "The possibility of physical and mental collapse is now very real."
msgstr "Ahora te parece muy real la posibilidad del colapso físico y mental."

#: src/player_hardcoded_effects.cpp:755
msgid "No one should be asked to handle this trip."
msgstr "No se le tendría que pedir a nadie que haga este viaje."

#: src/player_hardcoded_effects.cpp:765
msgid ""
"Your heart spasms painfully and stops, dragging you back to reality as you "
"die."
msgstr ""
"Sientes espasmos dolorosos en tu corazón, y se detiene, arrastrándote hacia "
"la realidad mientras te mueres."

#: src/player_hardcoded_effects.cpp:768
msgid ""
"You dissolve into beautiful paroxysms of energy.  Life fades from your "
"nebulae and you are no more."
msgstr ""
"Te disuelves en hermosos paroxismos de energía. La vida se desvanece de tu "
"nebulosa y ya no existes más."

#: src/player_hardcoded_effects.cpp:790
msgid "You bleed to death!"
msgstr "¡Te desangras hasta morir!"

#: src/player_hardcoded_effects.cpp:791
msgid "<npcname> bleeds to death!"
msgstr "¡<npcname> se desangra hasta morir!"

#: src/player_hardcoded_effects.cpp:796
msgid "Your heart can't keep up the pace and fails!"
msgstr "¡Tu corazón no puede seguir el ritmo y falla!"

#: src/player_hardcoded_effects.cpp:823
msgid "Your skin looks pale and you feel anxious and thirsty.  Blood loss?"
msgstr ""
"Tu piel está pálida y te sientes nervioso y sediento. ¿Pérdida de sangre?"

#: src/player_hardcoded_effects.cpp:825
msgid ""
"Your pale skin is sweating, your heart is beating fast, and you feel "
"restless.  Maybe you lost too much blood?"
msgstr ""
"Tu piel pálida está sudando, tu corazón late rápido y te sientes inquieto. "
"¿Tal vez has perdido mucha sangre?"

#: src/player_hardcoded_effects.cpp:827
msgid ""
"You're unsettlingly white, but your fingertips are bluish.  You are agitated"
" and your heart is racing.  Your blood loss must be serious."
msgstr ""
"Estás inquietantemente blanco, pero las puntas de tus dedos estan azuladas. "
"Estás agitado y tu corazón está acelerado. Tu pérdida de sangre debe ser "
"grave."

#: src/player_hardcoded_effects.cpp:829
msgid ""
"You are pale as a ghost, dripping wet from the sweat, and sluggish - despite"
" your heart racing like a train.  You are on the brink of collapse from the "
"effects of blood loss."
msgstr ""
"Estás pálido como un fantasma, empapado por el sudor, y aletargado, a pesar "
"de que tu corazón late como un tren. Estás al borde del colapso por los "
"efectos de la pérdida de sangre."

#: src/player_hardcoded_effects.cpp:837
msgid "You feel dizzy and lightheaded."
msgstr "Te sientes mareado y sin aire."

#: src/player_hardcoded_effects.cpp:841
msgid "You feel tired and you breathe heavily."
msgstr "Te sientes cansado y respiras con dificultad."

#: src/player_hardcoded_effects.cpp:845
msgid "You are anxious and cannot collect your thoughts."
msgstr "Está ansioso y no puedes aclarar tus pensamientos."

#: src/player_hardcoded_effects.cpp:849
msgid "You are sweating profusely, but you feel cold."
msgstr "Estás sudando profusamente, pero sientes frío."

#: src/player_hardcoded_effects.cpp:858
msgid "You huff and puff.  Your breath is rapid and shallow."
msgstr "Resoplas. Tu respiración es rápida y sin profundidad."

#: src/player_hardcoded_effects.cpp:863
msgid "You drop to the ground, fighting to keep yourself conscious."
msgstr "Te tiras al suelo, luchando por mantenerte consciente."

#: src/player_hardcoded_effects.cpp:867
msgid "Your mind slips away."
msgstr "Tu mente se escapa."

#: src/player_hardcoded_effects.cpp:898
msgid "You cannot breathe and your body gives out!"
msgstr "¡No puedes respirar y tu cuerpo se rinde!"

#: src/player_hardcoded_effects.cpp:899
msgid "<npcname> gasps for air and dies!"
msgstr " ¡<npcname> jadea en busca de aire y muere!"

#: src/player_hardcoded_effects.cpp:907
msgid "Your hands feel unusually cold."
msgstr "Tus manos se sienten inusualmente frías."

#: src/player_hardcoded_effects.cpp:912
msgid "Your feet feel unusually cold."
msgstr "Tus pies se sienten inusualmente frías."

#: src/player_hardcoded_effects.cpp:917
msgid "Your skin looks very pale."
msgstr "Tu piel esta muy pálida."

#: src/player_hardcoded_effects.cpp:920
msgid "You feel weak.  Where has your strength gone?"
msgstr "Te sientes débil. ¿Adónde han ido a parar tus fuerzas?"

#: src/player_hardcoded_effects.cpp:923
msgid "You feel feeble.  A gust of wind could make you stumble."
msgstr "Te sientes débil. Una ráfaga de viento podría hacerte tropezar."

#: src/player_hardcoded_effects.cpp:926
msgid "There is an overwhelming aura of tiredness inside of you."
msgstr "Hay un aura abrumadora de cansancio en tu interior."

#: src/player_hardcoded_effects.cpp:939
msgid "Rest is what you want.  Rest is what you need."
msgstr "El descanso es lo que quieres. Descansar es lo que necesitas."

#: src/player_hardcoded_effects.cpp:942
msgid "You feel dizzy and can't coordinate the movement of your feet."
msgstr "Te sientes mareado y no puedes coordinar el movimiento de tus pies."

#: src/player_hardcoded_effects.cpp:946
msgid "Your muscles are quivering."
msgstr "Tus músculos están temblando."

#: src/player_hardcoded_effects.cpp:950
msgid "You crave for ice.  The dirt under your feet looks tasty too."
msgstr "Anhelas el hielo. La tierra bajo tus pies también parece sabrosa."

#: src/player_hardcoded_effects.cpp:953
msgid "Your whole mouth is sore, and your tongue is swollen."
msgstr "Te duele toda la boca y tienes la lengua hinchada."

#: src/player_hardcoded_effects.cpp:956
msgid "You feel lightheaded.  A migraine follows."
msgstr "Te sientes mareado. Una migraña sigue."

#: src/player_hardcoded_effects.cpp:969
msgid "Your legs are restless.  The urge to move them is so strong."
msgstr "Tus piernas están inquietas. La necesidad de moverlas es muy fuerte."

#: src/player_hardcoded_effects.cpp:972
msgid "You feel like you could sleep on a rock."
msgstr "Te sientes como si pudieras dormir sobre una roca."

#: src/player_hardcoded_effects.cpp:976
msgid "You gasp for air!"
msgstr "¡Jadeas por aire!"

#: src/player_hardcoded_effects.cpp:981
msgid "Can't breathe.  Must rest."
msgstr "No puedo respirar. Debo descansar."

#: src/player_hardcoded_effects.cpp:986
msgid "You can't take it any more.  Rest first; everything else later."
msgstr "No puedes aguantar más. Descansa primero; todo lo demás, después."

#: src/player_hardcoded_effects.cpp:991
msgid "You must sit down for a moment.  Just a moment."
msgstr "Debes sentarte un momento. Sólo un momento."

#: src/player_hardcoded_effects.cpp:1031
msgid "You feel well rested."
msgstr "Te sientes bien descansado."

#: src/player_hardcoded_effects.cpp:1034
msgid ""
"You feel physically rested, but you haven't been able to catch up on your "
"missed sleep yet."
msgstr ""
"Te sientes físicamente descansado, pero no pudiste recuperar el tiempo de "
"sueño perdido."

#: src/player_hardcoded_effects.cpp:1092 src/player_hardcoded_effects.cpp:1101
#: src/player_hardcoded_effects.cpp:1108
msgid "It's too bright to sleep."
msgstr "Hay mucha luz para dormir."

#: src/player_hardcoded_effects.cpp:1116
#, c-format
msgid "You see %s approaching!"
msgstr "¡Ves a %s acercándose! "

#: src/player_hardcoded_effects.cpp:1134
msgid "You toss and turn trying to keep warm."
msgstr "Das vueltas tratando de mantener la temperatura."

#: src/player_hardcoded_effects.cpp:1138
msgid "It's too cold to sleep."
msgstr "Hace demasiado frío para dormir."

#: src/player_hardcoded_effects.cpp:1146
msgid "You toss and turn in the heat."
msgstr "Das vueltas del calor."

#: src/player_hardcoded_effects.cpp:1150
msgid "It's too hot to sleep."
msgstr "Hace demasiado calor para dormir."

#: src/player_hardcoded_effects.cpp:1232
msgid "Your flesh crawls; insects tear through the flesh and begin to emerge!"
msgstr ""
"Tu carne está plagada de bichos. ¡Insectos desgarran tu piel y empiezan a "
"brotar!"

#: src/player_hardcoded_effects.cpp:1233
msgid "Insects begin to emerge from <npcname>'s skin!"
msgstr "¡Insectos empiezan a brotar de la piel de <npcname>!"

#. ~ %s is bodypart in accusative.
#: src/player_hardcoded_effects.cpp:1259
#, c-format
msgid "You start scratching your %s!"
msgstr "¡Te rascas tu %s!"

#. ~ 1$s is NPC name, 2$s is bodypart in accusative.
#: src/player_hardcoded_effects.cpp:1263
#, c-format
msgid "%1$s starts scratching their %2$s!"
msgstr "¡%1$s se está rascando su %2$s!"

#: src/player_hardcoded_effects.cpp:1275
msgid "Why waste your time on that insignificant speck?"
msgstr "¿Para qué vas a gastar tiempo en esa mancha insignificante?"

#: src/player_hardcoded_effects.cpp:1307
msgid "The bees have started escaping your teeth."
msgstr "Las abejas empezaron a escaparse de tus dientes."

#: src/player_hardcoded_effects.cpp:1309
msgid "You feel paranoid.  They're watching you."
msgstr "Te sientes paranoico. Te están observando."

#: src/player_hardcoded_effects.cpp:1314
msgid ""
"You feel like you need less teeth.  You pull one out, and it is rotten to "
"the core."
msgstr ""
"Sientes como si necesitaras menos dientes. Te sacas uno, y está podrido "
"desde la raíz."

#: src/player_hardcoded_effects.cpp:1317
msgid "You notice a large abscess.  You pick at it."
