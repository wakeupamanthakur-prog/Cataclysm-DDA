msgstr ""
"Una escotilla de nave espacial blindada y hermética. Una palanca lateral "
"permite su accionamiento manual."

#. ~ Terrain name
#: data/mods/Aftershock/maps/furniture_and_terrain/terrain_spaceship.json
msgid "open spaceship hatch"
msgstr "escotilla de nave espacial abierta"

