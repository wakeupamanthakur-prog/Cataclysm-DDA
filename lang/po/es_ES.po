msgid_plural "late rent notices"
msgstr[0] "notificación de alquiler sin pagar"
msgstr[1] "notificaciones de alquiler sin pagar"
msgstr[2] "notificaciones de alquiler sin pagar"

#. ~ Description of variant "late rent notice" of item "letter"
#: data/json/items/generic/mail.json
