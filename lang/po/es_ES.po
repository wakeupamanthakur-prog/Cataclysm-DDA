msgstr[1] "restos de carne cocinada sazonada"
msgstr[2] "restos de carne cocinada sazonada"

#. ~ Description of "cooked pepper scrap of meat"
#: data/json/items/comestibles/carnivore.json
msgid ""
"A cooked scrap of meat that has been properly seasoned with pepper and salt."
"  Yet small, they have a good taste."
msgstr ""
"Un trozo de carne cocinada que ha sido apropiadamente sazonada con pimienta "
"y sal. Aunque es pequeño, tiene un buen sabor."

#. ~ Item name
#: data/json/items/comestibles/carnivore.json
msgid "cooked mutant meat"
msgid_plural "cooked mutant meat"
msgstr[0] "carne mutante cocinada"
msgstr[1] "carne mutante cocinada"
msgstr[2] "carne mutante cocinada"

#. ~ Description of "cooked mutant meat"
#: data/json/items/comestibles/carnivore.json
msgid "A cooked chunk of meat from a mutated animal."
msgstr "Un trozo de carne cocinada de un animal mutante."

#. ~ Item name
#: data/json/items/comestibles/carnivore.json
msgid "cooked pepper mutant meat"
msgid_plural "cooked pepper mutant meat"
msgstr[0] "carne mutante con pimienta cocinada"
msgstr[1] "carne mutante con pimienta cocinada"
msgstr[2] "carne mutante con pimienta cocinada"

#. ~ Description of "cooked pepper mutant meat"
#: data/json/items/comestibles/carnivore.json
msgid ""
"A cooked chunk of meat from a mutated animal which has been properly "
"seasoned with black pepper and salt, will keep your hunger away, but even "
"seasoned, it has a weird taste."
msgstr ""
"Un trozo cocinado de carne de un animal mutado que ha sido adecuadamente "
"sazonado con pimienta negra y sal, mantendrá tu hambre a raya, pero incluso "
"sazonado, tiene un sabor ¡Raro!."

#. ~ Item name
#: data/json/items/comestibles/carnivore.json
