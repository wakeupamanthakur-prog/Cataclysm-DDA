#. ~ Profession name for male
#: data/json/professions.json
msgctxt "profession_male"
msgid "Assassin"
msgstr "Asesino"

#. ~ Profession name for female
#: data/json/professions.json
msgctxt "profession_female"
msgid "Assassin"
msgstr "Asesina"

#. ~ Profession name for male
#: data/json/professions.json
msgctxt "profession_male"
msgid "Old Veteran"
msgstr "Antiguo Veterano"

#. ~ Description of profession "Old Veteran" for male
#: data/json/professions.json
msgctxt "prof_desc_male"
msgid ""
"You've been through hell once before.  Hopefully those weekend range trips "
"have kept your skills sharp."
msgstr ""
"Ya has pasado por el infierno una vez. Espero que esos viajes de fin de "
"semana al campo de tiro hayan mantenido tus habilidades afiladas."

#. ~ Profession name for female
#: data/json/professions.json
msgctxt "profession_female"
msgid "Old Veteran"
msgstr "Antigua Veterana"

#. ~ Description of profession "Old Veteran" for female
