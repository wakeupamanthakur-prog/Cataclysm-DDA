msgstr ""
"Es una copia de Weekly World News. ¡Prestale atención al Nautilus pompilius!"

#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
#: data/json/snippets/robot_finds_kitten.json
msgid "It's the proverbial wet blanket."
msgstr "Es la proverbial manta húmeda."

#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
#: data/json/snippets/robot_finds_kitten.json
msgid "A \"Get Out of Jail Free\" card."
msgstr "Es una tarjeta de \"Salir gratis de la cárcel\"."

#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
#: data/json/snippets/robot_finds_kitten.json
msgid "An incredibly expensive \"Mad About You\" collector plate."
msgstr "Es un plato de colección increíblemente caro de \"Mad about you\"."

#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
#: data/json/snippets/robot_finds_kitten.json
msgid "Paul Moyer's necktie."
msgstr "Es la corbata de Paul Moyer."

#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
#: data/json/snippets/robot_finds_kitten.json
msgid "A haircut and a real job.  Now you know where to get one!"
msgstr ""
"Un corte de pelo y un trabajo de verdad. ¡Ahora ya sabes dónde conseguir "
"uno!"

#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
#: data/json/snippets/robot_finds_kitten.json
msgid "An automated robot-hater.  It frowns disapprovingly at you."
msgstr ""
"Es un odiador de robots automatizado. Te frunce el ceño de forma "
"desaprobatoria."

#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
#: data/json/snippets/robot_finds_kitten.json
msgid "An automated robot-liker.  It smiles at you."
msgstr "Es un robot amigable automatizado. Te sonrie."

#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
#: data/json/snippets/robot_finds_kitten.json
msgid "It's a black hole.  Don't fall in!"
msgstr "Es un agujero negro. ¡No te caigas en el!"

#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
#: data/json/snippets/robot_finds_kitten.json
msgid "Just a big brick wall."
msgstr "Solo un muro grande de ladrillos."

#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
#: data/json/snippets/robot_finds_kitten.json
msgid "You found kitten!  No, just kidding."
msgstr "¡Encontraste a un gatito! No, era un chiste."

#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
#: data/json/snippets/robot_finds_kitten.json
msgid "Heart of Darkness brand pistachio nuts."
msgstr "Nueces de pistacho marca Corazón de las Tinieblas."

#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
#: data/json/snippets/robot_finds_kitten.json
msgid "A smoking branding iron shaped like a 24-pin connector."
msgstr ""
"Es una marca de hierro todavía humeante, con forma de un conector de 24 "
"pines."

#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
#: data/json/snippets/robot_finds_kitten.json
msgid "It's a Java applet."
msgstr "Es una applet de Java."

#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
#: data/json/snippets/robot_finds_kitten.json
msgid "An abandoned used-car lot."
msgstr "Es un terreno abandonado de coches usados."

#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
#: data/json/snippets/robot_finds_kitten.json
msgid "A shameless plug for Crummy: https://www.crummy.com/"
msgstr "Un sinvergüenza del Crummy: https://www.crummy.com/"

#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
#: data/json/snippets/robot_finds_kitten.json
msgid ""
"A shameless plug for the UCLA Linux Users Group: https://linux.ucla.edu/"
msgstr ""
"Un sinvergüenza del Grupo de Usuarios de Linux de UCLA: "
"https://linux.ucla.edu/"

#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
#: data/json/snippets/robot_finds_kitten.json
msgid "A can of Spam Lite."
msgstr "Es una lata de Spam Lite."

#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
#: data/json/snippets/robot_finds_kitten.json
msgid "This is another fine mess you've gotten us into, Stanley."
msgstr "Este es otro de esos bonitos líos en donde nos metes, Stanley."

#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
#: data/json/snippets/robot_finds_kitten.json
msgid "It's scenery for \"Waiting for Godot\"."
msgstr "Es escenografía de \"Esperando a Godot\"."

#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
#: data/json/snippets/robot_finds_kitten.json
msgid "This grain elevator towers high above you."
msgstr "Estas torres de elevación de granos frente a ti."

#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
#: data/json/snippets/robot_finds_kitten.json
msgid "A Mentos wrapper."
msgstr "Es un envoltorio de Mentos."

#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
#: data/json/snippets/robot_finds_kitten.json
msgid "It's the constellation Pisces."
msgstr "Es la constelación Piscis."

#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
#: data/json/snippets/robot_finds_kitten.json
msgid "It's a fly on the wall.  Hi, fly!"
msgstr "Una mosca en el muro. ¡Hola, mosca!"

#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
#: data/json/snippets/robot_finds_kitten.json
msgid "This kind of looks like kitten, but it's not."
msgstr "Esto medio como que se parece a un gatito, pero no lo es."

#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
#: data/json/snippets/robot_finds_kitten.json
msgid "It's a banana!  Oh, joy!"
msgstr "¡Es una banana! ¡Qué alegría!"

#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
#: data/json/snippets/robot_finds_kitten.json
msgid "A helicopter has crashed here."
msgstr "Un helicóptero se ha estrellado aquí."

#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
#: data/json/snippets/robot_finds_kitten.json
msgid "Carlos Tarango stands here, doing his best impression of Pat Smear."
msgstr ""
"Aquí está parado Carlos Tarango, haciendo su mejor imitación de Pat Smear."

#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
#: data/json/snippets/robot_finds_kitten.json
msgid "A patch of mushrooms grows here."
msgstr "Aquí está creciendo un grupo de hongos."

#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
#: data/json/snippets/robot_finds_kitten.json
msgid "A patch of grape jelly grows here."
msgstr "Aquí está creciendo un grupo de mermelada de uvas."

#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
#: data/json/snippets/robot_finds_kitten.json
msgid "A spindle, and a grindle, and a bucka-wacka-woom!"
msgstr "Un huso, y un molinillo, y un ¡bucka-wacka-woom!"

#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
#: data/json/snippets/robot_finds_kitten.json
msgid "A geyser sprays water high into the air."
msgstr "Un géiser tira agua muy alto para arriba."

#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
#: data/json/snippets/robot_finds_kitten.json
msgid "A toenail?  What good is a toenail?"
msgstr ""
"¿La uña de un dedo del pie? ¿Para qué sirve la uña de un dedo del pie?"

#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
#: data/json/snippets/robot_finds_kitten.json
msgid "You've found the fish!  Not that it does you much good in this game."
msgstr "¡Encontraste el pescado! Aunque no te sirve de mucho en este juego."

#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
#: data/json/snippets/robot_finds_kitten.json
msgid "A Buttertonsils bar."
msgstr "Es un bar Buttertonsils."

#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
#: data/json/snippets/robot_finds_kitten.json
msgid "One of the few remaining discoes."
msgstr "Es una de las últimas discotecas que quedan."

#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
#: data/json/snippets/robot_finds_kitten.json
msgid "Ah, the uniform of a Revolutionary-era minuteman."
msgstr ""
"Ah, el uniforme de un soldado de milicia de la época de la revolución."

#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
#: data/json/snippets/robot_finds_kitten.json
msgid "A punch bowl, filled with punch and lemon slices."
msgstr "Es una ponchera, llena de ponche y rodajas de limón."

#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
#: data/json/snippets/robot_finds_kitten.json
msgid "It's nothing but a G-thang, baby."
msgstr "No es nada más que un G-thang, nena."

#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
#: data/json/snippets/robot_finds_kitten.json
msgid "IT'S ALIVE!  AH HA HA HA HA!"
msgstr "¡ESTÁ VIVO! ¡JA JA JA JA JA!"

#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
#: data/json/snippets/robot_finds_kitten.json
msgid "This was no boating accident!"
msgstr "¡Esto no fue un accidente de barcos!"

#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
#: data/json/snippets/robot_finds_kitten.json
msgid ""
"Wait!  This isn't the poker chip!  You've been tricked!  DAMN YOU, MENDEZ!"
msgstr ""
"¡Esperá! ¡Esta no es la ficha de poker! ¡Has sido engañado! ¡MALDITO SEAS, "
"MENDEZ!"

#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
#: data/json/snippets/robot_finds_kitten.json
msgid "A livery stable!  Get your livery!"
msgstr "¡Es un establo! ¡Coge tu caballo!"

#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
#: data/json/snippets/robot_finds_kitten.json
msgid "It's a perpetual immobility machine."
msgstr "Es una máquina de perpetua inmovilidad."

#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
#: data/json/snippets/robot_finds_kitten.json
msgid "\"On this spot in 1962, Henry Winkler was sick.\""
msgstr "\"En este lugar en 1962, Henry Winkler estuvo enfermo.\""

#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
#: data/json/snippets/robot_finds_kitten.json
msgid "There's nothing here; it's just an optical illusion."
msgstr "Aquí no hay nada; es solo una ilusión óptica."

#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
#: data/json/snippets/robot_finds_kitten.json
msgid "The World's Biggest Motzah Ball!"
msgstr "¡La Bola de Matzah Más Grande del Mundo!"

#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
#: data/json/snippets/robot_finds_kitten.json
msgid ""
"A tribe of cannibals lives here.  They eat Malt-O-Meal for breakfast, you "
"know."
msgstr ""
"Una tribu de caníbales vive aquí. Comen cereales Malt-O-Meal en el desayuno,"
" ya sabes."

#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
#: data/json/snippets/robot_finds_kitten.json
msgid "This appears to be a rather large stack of trashy romance novels."
msgstr "Esto parece ser un montón grande de horribles novelas de romance."

#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
#: data/json/snippets/robot_finds_kitten.json
msgid "Look out!  Exclamation points!"
msgstr "¡Cuidado! ¡Signos de exclamación!"

#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
#: data/json/snippets/robot_finds_kitten.json
msgid "A herd of wild coffee mugs slumbers here."
msgstr "Aquí duerme un rebaño de tazas de café salvajes."

#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
#: data/json/snippets/robot_finds_kitten.json
msgid "It's a limbo bar!  How low can you go?"
msgstr "¡Es un barra de limbo! ¿Cuánto te puedes agachar?"

#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
#: data/json/snippets/robot_finds_kitten.json
msgid "It's the horizon.  Now THAT'S weird."
msgstr "Es el horizonte. ehhh ESO es raro."

#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
#: data/json/snippets/robot_finds_kitten.json
msgid "A vase full of artificial flowers is stuck to the floor here."
msgstr "Aquí trabado en el suelo hay un jarrón lleno de flores artificiales."

#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
#: data/json/snippets/robot_finds_kitten.json
msgid "A large snake bars your way."
msgstr "Una serpiente grande te prohibe el camino."

#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
#: data/json/snippets/robot_finds_kitten.json
msgid "A pair of saloon-style doors swing slowly back and forth here."
msgstr ""
"Aquí hay un par de puertas como las de taberna que se balancean lentamente "
"hacia atrás y hacia adelante."

#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
#: data/json/snippets/robot_finds_kitten.json
msgid "It's an ordinary bust of Beethoven… but why is it painted green?"
msgstr ""
"Es un busto ordinario de Beethoven... pero ¿por qué está pintado de verde?"

#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
#: data/json/snippets/robot_finds_kitten.json
msgid "It's TV's lovable wisecracking Crow!  \"Bite me!\", he says."
msgstr "¡Es el adorable cuervo bromista de la tele! \"¡Muérdeme!\", dice."

#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
#: data/json/snippets/robot_finds_kitten.json
msgid ""
"Hey, look, it's war.  What is it good for?  Absolutely nothing.  Say it "
"again."
msgstr ""
"Oye, mira, es la guerra. ¿Para qué sirve? Absolutamente para nada. Dilo de "
"nuevo."

#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
#: data/json/snippets/robot_finds_kitten.json
msgid "It's the amazing self-referential thing that's not kitten."
msgstr "Es la maravillosa cosa autoreferencial que no es un gatito."

#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
#: data/json/snippets/robot_finds_kitten.json
msgid "A flamboyant feather boa.  Now you can dress up like Carol Channing!"
msgstr ""
"Una boa de plumas extravagante. ¡Ahora puedes vestirte como Carol Channing!"

#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
#: data/json/snippets/robot_finds_kitten.json
msgid "\"Sure hope we get some rain soon,\" says Farmer Joe."
msgstr "\"Esperamos que llueva rápido,\" dice el Granjero Joe."

#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
#: data/json/snippets/robot_finds_kitten.json
msgid ""
"\"How in heck can I wash my neck if it ain't gonna rain no more?\" asks "
"Farmer Al."
msgstr ""
"\"¿Cómo diablos me voy a lavar el cogote si no va a llover nunca más?\" "
"pregunta el Granjero Al."

#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
#: data/json/snippets/robot_finds_kitten.json
msgid "\"Topsoil's all gone, ma,\" weeps Lil' Greg."
msgstr ""
"\"La parte superior del suelo desapareció, ma,\" se queja el Pequeño Greg."

#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
#: data/json/snippets/robot_finds_kitten.json
msgid ""
"This is a large brown bear.  Oddly enough, it's currently peeing in the "
"woods."
msgstr ""
"Esto es un gran oso pardo. Por raro que parezca, ahora está meando en el "
"bosque."

#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
#: data/json/snippets/robot_finds_kitten.json
msgid "A team of arctic explorers is camped here."
msgstr "Aquí hay un equipo de exploradores árticos acampando."

#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
#: data/json/snippets/robot_finds_kitten.json
msgid "This object here appears to be Louis Farrakhan's bow tie."
msgstr "Este objeto de aquí parece ser la corbata de Louis Farrakhan."

#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
#: data/json/snippets/robot_finds_kitten.json
msgid "This is the world-famous Chain of Jockstraps."
msgstr "Esta es la mundialmente famosa Cadena de Canzoncillos."

#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
#: data/json/snippets/robot_finds_kitten.json
msgid "A trash compactor, compacting away."
msgstr "Es un compactador de basura, compactando."

#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
#: data/json/snippets/robot_finds_kitten.json
msgid "This toaster strudel is riddled with bullet holes!"
msgstr "¡Ese strudel tostado está acribillado a balazos!"

#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
#: data/json/snippets/robot_finds_kitten.json
msgid "It's a hologram of a crashed helicopter."
msgstr "Es un holograma de un helicóptero estrellado."

#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
#: data/json/snippets/robot_finds_kitten.json
msgid ""
"This is a television.  On screen you see a robot strangely similar to "
"yourself."
msgstr ""
"Esto es un televisor. En la pantalla ves un robot extrañamente similar a ti "
"mismo."

#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
#: data/json/snippets/robot_finds_kitten.json
msgid "This balogna has a first name, it's R-A-N-C-I-D."
msgstr "Esta salchicha de Bolonia tiene nombre, es R-A-N-C-I-A."

#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
#: data/json/snippets/robot_finds_kitten.json
msgid "A salmon hatchery?  Look again.  It's merely a single salmon."
msgstr "¿Un criadero de salmones? Fijate mejor. Es meramente un salmón solo."

#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
#: data/json/snippets/robot_finds_kitten.json
msgid "It's a rim shot.  Ba-da-boom!"
msgstr "Es un rim shot. ¡Ba-da-boom!"

#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
#: data/json/snippets/robot_finds_kitten.json
msgid ""
"It's creepy and it's kooky, mysterious and spooky.  It's also somewhat ooky."
msgstr ""
"Es escalofriante y  chiflado, misterioso y espeluznante. También es un poco "
"espantoso."

#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
#: data/json/snippets/robot_finds_kitten.json
msgid "This is an anagram."
msgstr "Esto es un anagrama."

#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
#: data/json/snippets/robot_finds_kitten.json
msgid "This object is like an analogy."
msgstr "Este objeto es como una analogía."

#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
#: data/json/snippets/robot_finds_kitten.json
msgid "It's a symbol.  You see in it a model for all symbols everywhere."
msgstr ""
"Es un símbolo. Ves en él un modelo para todos los símbolos de todos lados."

#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
#: data/json/snippets/robot_finds_kitten.json
msgid "The object pushes back at you."
msgstr "El objeto retrocede ante ti."

#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
#: data/json/snippets/robot_finds_kitten.json
msgid "A traffic signal.  It appears to have been recently vandalized."
msgstr "Una señal de tráfico. Parece que ha sido vandalizada recientemente."

#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
#: data/json/snippets/robot_finds_kitten.json
msgid ""
"\"There is no kitten!\" cackles the old crone.  You are shocked by her "
"blasphemy."
msgstr ""
"\"¡No existe un gatito!\" ríe a carcajadas la vieja bruja. Estás en shock "
"por su blasfemia."

#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
#: data/json/snippets/robot_finds_kitten.json
msgid "This is a Lagrange point.  Don't come too close now."
msgstr "Esto es un punto de Lagrange. No te acerques mucho ahora."

#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
#: data/json/snippets/robot_finds_kitten.json
msgid "The dirty old tramp bemoans the loss of his harmonica."
msgstr "El sucio y viejo vagabundo se lamenta por la pérdida de su armónica."

#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
#: data/json/snippets/robot_finds_kitten.json
msgid "Look, it's Fanny the Irishman!"
msgstr "¡Mirá, es Fanny the Irishman!"

#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
#: data/json/snippets/robot_finds_kitten.json
msgid "What in blazes is this?"
msgstr "¿Qué diablos es eso?"

#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
#: data/json/snippets/robot_finds_kitten.json
msgid "It's the instruction manual for a previous version of this game."
msgstr ""
"Es el manual de instrucciones para una versión anterior de este juego."

#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
#: data/json/snippets/robot_finds_kitten.json
msgid "A brain cell.  Oddly enough, it seems to be functioning."
msgstr ""
"Es una célula cerebral. Lo que es raro es que parece que está funcionando."

#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
#: data/json/snippets/robot_finds_kitten.json
msgid "Tea and/or crumpets."
msgstr "Té y/o bollos."

