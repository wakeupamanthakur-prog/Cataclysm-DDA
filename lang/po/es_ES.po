#: data/mods/Magiclysm/items/alchemy_items.json
#: data/mods/MindOverMatter/items/tools/lighting.json
msgid "Close cover"
msgstr "Cerrar cubierta"

#. ~ "msg" action message of item "atomic headlamp"
#: data/json/items/tool_armor.json
msgid "You close the headlamp's cover."
msgstr "Cierra la tapa de la linterna de cabeza."

#. ~ Item name
#: data/json/items/tool_armor.json
msgid "atomic headlamp (covered)"
msgid_plural "atomic headlamps (covered)"
msgstr[0] "linterna de cabeza atómica (cubierta)"
msgstr[1] "linternas de cabeza atómica (cubiertas)"
msgstr[2] "linternas de cabeza atómica (cubiertas)"

#. ~ Description of "atomic headlamp (covered)"
#: data/json/items/tool_armor.json
msgid ""
"A custom-made, reinforced headlamp powered by the magic of nuclear decay, "
"focused for more usable brightness.  The adjustable strap allows it to be "
"comfortably worn on your head or attached to your helmet.  Use it to open "
"the cover and show the light."
msgstr ""
"Una linterna de cabeza reforzada hecha a medida, alimentada por la magia de "
"la decadencia nuclear, enfocada para un brillo más utilizable. La correa "
"ajustable permite que se lleve cómodamente en la cabeza o que se fije en el "
"casco. Usar para abrir la cubierta y mostrar la luz."

#. ~ "menu_text" action message of item "atomic headlamp (covered)"
#. ~ "menu_text" action message of item "atomic lamp (covered)"
#. ~ "menu_text" action message of item "atomic reading light (covered)"
#. ~ "menu_text" action message of item "magical reading light (covered)"
#. ~ "menu_text" action message of item "everglow matrix lamp (covered)"
