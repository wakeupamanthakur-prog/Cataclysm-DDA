msgstr[0] "par de botas de quitina de demonio XL"
msgstr[1] "pares de botas de quitina de demonio XL"
msgstr[2] "pares de botas de quitina de demonio XL"

#. ~ Item name
#: data/mods/Magiclysm/items/armor.json
msgid "demon chitin dog mesh harness"
msgid_plural "demon chitin dog mesh harnesses"
msgstr[0] "arnes de malla para perro de chitina de demonio"
msgstr[1] "arneses de malla para perro de chitina de demonio"
msgstr[2] "arneses de malla para perro de chitina de demonio"

#. ~ Description of "demon chitin dog mesh harness"
#: data/mods/Magiclysm/items/armor.json
msgid ""
"A makeshift harness of demon chitin fitted to a thin mesh protecting the "
"neck to flank of canines.  You could put this on a friendly dog."
msgstr ""
"Un arnés improvisado de quitina de demonio ajustado a una fina malla que "
"protege el cuello y el flanco de los canidos. Se puede poner esto a un perro"
" amistoso."

#. ~ Item name
#: data/mods/Magiclysm/items/armor.json
msgid "demon chitin horse armor"
msgid_plural "demon chitin horse armors"
msgstr[0] "armadura de caballo de quitina de demonio"
msgstr[1] "armaduras de caballo de quitina de demonio"
msgstr[2] "armaduras de caballo de quitina de demonio"

#. ~ Description of "demon chitin horse armor"
#: data/mods/Magiclysm/items/armor.json
msgid ""
"A makeshift assembly of criniere, peytral and croupiere made from demon "
"chitin fitted to a thin mesh.  You could put this on a friendly horse."
msgstr ""
"Un conjunto improvisado de criniere, peytral y croupiere hecho de quitina de"
" demonio ajustada a una malla fina. Se puede poner esto en un caballo "
"amistoso."

#. ~ Item name
#: data/mods/Magiclysm/items/bionics.json
msgid "Blood Power Generator CBM"
msgid_plural "Blood Power Generator CBMs"
msgstr[0] "MBC Generador de Poder Sanguíneo"
msgstr[1] "MBCs Generadores de Poder Sanguíneo"
