msgstr "Opciones de Minimapa de Pixeles"

#: src/options.cpp:2468
msgid "Options regarding pixel minimap."
msgstr "Opciones relacionadas con el minimapa de pixeles."

#: src/options.cpp:2470
msgid "Pixel minimap"
msgstr "Minimapa de píxeles"

