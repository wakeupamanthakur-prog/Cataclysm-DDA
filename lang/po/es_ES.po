msgid "hydraulic press"
msgid_plural "hydraulic presses"
msgstr[0] "prensa hidráulica"
msgstr[1] "prensas hidráulicas"
msgstr[2] "prensas hidráulicas"

#. ~ Description of vehicle part "hydraulic press"
#: data/json/furniture_and_terrain/appliances.json
msgid ""
"If you really want to squash something a lot, this is exactly the right "
"industrial tool for you.  Plugged in and ready to go."
msgstr ""
"Si realmente quieres aplastar algo mucho, esta sería exactamente la "
"herramienta industrial adecuada para ti. Enchufada y lista para ser usada."

#. ~ Vehicle part name
#. ~ Furniture name
#. ~ Item name
