#. ~ Spell name
#: data/mods/Magiclysm/Spells/earthshaper.json
msgid "Utility Molding (Hammer)"
msgstr ""

#. ~ Description of spell "Utility Molding (Hammer)"
#: data/mods/Magiclysm/Spells/earthshaper.json
