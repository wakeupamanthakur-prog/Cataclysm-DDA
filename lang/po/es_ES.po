#: data/json/items/comestibles/nuts.json
msgid "blanching acorns"
msgid_plural "blanching acorns"
msgstr[0] "bellota blanqueándose"
msgstr[1] "bellotas blanqueándose"
msgstr[2] "bellotas blanqueándose"

#. ~ Description of "blanching acorns"
#: data/json/items/comestibles/nuts.json
msgid ""
"A mix of water and hulled acorns, slowly leaching the tannins.  It'll take "
"about a week before they're palatable."
msgstr ""
"Una mezcla de agua y bellotas peladas blanqueando lentamente los taninos. "
"Puede tardar una semana antes de volverse agradable para comer."

#. ~ "msg" action message of item "blanching acorns"
#: data/json/items/comestibles/nuts.json
msgid ""
"After a week of changing water and taste-testing, the acorns are no longer "
"bitter and ready to decant."
msgstr ""
"Después de una semana cambiando el agua y probando las bellotas, ya no están"
" amargas y están listas para decantar."

#. ~ "not_ready_msg" action message of item "blanching acorns"
#: data/json/items/comestibles/nuts.json
msgid "The acorns are still bitter."
msgstr "Las bellotas todavía están amargas."

#. ~ Item name
#: data/json/items/comestibles/offal_dishes.json
msgid "faux gras"
msgid_plural "faux gras"
msgstr[0] "faux gras"
msgstr[1] "faux gras"
msgstr[2] "faux gras"

#. ~ Description of "faux gras"
#: data/json/items/comestibles/offal_dishes.json
msgid ""
"Though this meal is technically not foie gras, you have a feeling neither "
"the French nor animal rights groups are likely to criticize it now."
msgstr ""
"Aunque esta comida técnicamente no es foie gras, tienes la sensación de que "
"ni los franceses ni los grupos animalistas vayan a criticarlo en estos "
"momentos."

#. ~ Item name
#: data/json/items/comestibles/offal_dishes.json
msgid "liver & onions"
msgid_plural "liver & onions"
msgstr[0] "hígado encebollado"
msgstr[1] "hígado encebollado"
msgstr[2] "hígado encebollado"

#. ~ Description of "liver & onions"
#: data/json/items/comestibles/offal_dishes.json
msgid "A classic way to serve liver."
msgstr "Una forma clásica de servir el hígado."

#. ~ Item name
#: data/json/items/comestibles/offal_dishes.json
msgid "fried liver"
msgid_plural "fried liver"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. ~ Description of "fried liver"
#: data/json/items/comestibles/offal_dishes.json
msgid "Tasty deep-fried liver, a Southern delicacy."
msgstr "Hígado frito y sabroso, una exquisitez sureña."

#. ~ Item name
#: data/json/items/comestibles/offal_dishes.json
msgid "humble pie"
msgid_plural "humble pies"
msgstr[0] "pastel humilde"
msgstr[1] "pasteles humildes"
msgstr[2] "pasteles humildes"

#. ~ Description of "humble pie"
#: data/json/items/comestibles/offal_dishes.json
msgid ""
"Also known as 'Umble' pie, made with chopped organ meats.  Not half bad, and"
" full of vitamins!"
msgstr ""
"También conocida como tarta 'Umble', está hecha de pedazos de órganos. ¡No "
"está tan mal y está llena de vitaminas!"

#. ~ Item name
#: data/json/items/comestibles/offal_dishes.json
msgid "stewed tripe"
msgid_plural "stewed tripe"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. ~ Description of "stewed tripe"
#: data/json/items/comestibles/offal_dishes.json
msgid ""
"Stomach lining, cut up and stewed for an hour in broth.  Better than it "
"sounds."
msgstr ""
"El estómago se forra, se corta y se cocina durante una hora en caldo. Mejor "
"de lo que suena."

#. ~ Item name
#: data/json/items/comestibles/offal_dishes.json
msgid "deep-fried tripe"
msgid_plural "deep-fried tripe"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. ~ Description of "deep-fried tripe"
#: data/json/items/comestibles/offal_dishes.json
msgid ""
"Some people don't enjoy the taste or texture of organ meat, so deep-frying "
"is a great way to disguise both."
msgstr ""
"Algunos no disfrutan del sabor o la textura de la carne de los órganos, así "
"que una buena manera de disfrazarlos es mediante la fritura."

#. ~ Item name
#: data/json/items/comestibles/offal_dishes.json
msgid "leverpostej"
msgid_plural "leverpostej"
msgstr[0] "Leverpostej"
msgstr[1] "Leverpostej"
msgstr[2] "Leverpostej"

#. ~ Description of "leverpostej"
#: data/json/items/comestibles/offal_dishes.json
msgid ""
"A traditional Danish pate.  Probably better if you spread it on some bread."
msgstr ""
"Un plato tradicional danés. Probablemente sea mejor que lo extiendas en un "
"pan."

#. ~ Item name
#: data/json/items/comestibles/offal_dishes.json
msgid "fried brain"
msgid_plural "fried brain"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. ~ Description of "fried brain"
#: data/json/items/comestibles/offal_dishes.json
msgid ""
"I don't know what you were expecting.  It's brain.  It's deep-fried.  Enjoy!"
msgstr ""
"No sé qué estabas esperando. Es un cerebro. Está muy frito. ¡Disfrutalo!"

#. ~ Item name
#: data/json/items/comestibles/offal_dishes.json
msgid "deviled kidney"
msgid_plural "deviled kidney"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. ~ Description of "deviled kidney"
#: data/json/items/comestibles/offal_dishes.json
msgid ""
"A delicious way to prepare kidneys, originating from Victorian England.  You"
" had to make some substitutions in the devilling sauce, but it still came "
"out damn good."
msgstr ""
"Una manera deliciosa de preparar riñones, originaria de la Inglaterra "
"victoriana. Tienes que hacer algunas sustituciones para el preparado de la "
"salsa pero todavía salio bastante bueno."

#. ~ Item name
#: data/json/items/comestibles/offal_dishes.json
msgid "grilled sweetbread"
msgid_plural "grilled sweetbread"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. ~ Description of "grilled sweetbread"
#: data/json/items/comestibles/offal_dishes.json
msgid "Not sweet like the name would suggest, but delicious all the same!"
msgstr "El nombre no te dice mucho, pero ¡es igualmente delicioso!"

#. ~ Item name
#: data/json/items/comestibles/offal_dishes.json
msgid "canned liver"
msgid_plural "canned liver"
msgstr[0] "hígado enlatado"
msgstr[1] "hígado enlatado"
msgstr[2] "hígado enlatado"

#. ~ Description of "canned liver"
#: data/json/items/comestibles/offal_dishes.json
msgid "Livers preserved in a can.  Chock-full of B vitamins!"
msgstr "Hígados conservados en una lata. ¡Lleno de vitaminas B!"

#. ~ Item name
#: data/json/items/comestibles/offal_dishes.json
msgid "lung provence"
msgid_plural "lung provence"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. ~ Description of "lung provence"
#: data/json/items/comestibles/offal_dishes.json
msgid ""
"A French lung dish, made by poaching the lungs before pan-frying them with "
"onion, tomato, seasonings, and a generous amount of wine."
msgstr ""
"Un plato francés con pulmón, hecho hirviendo los pulmones antes de freírlos "
"con cebolla, tomate, condimentos y una generosa cantidad de vino."

#. ~ Item name
#: data/json/items/comestibles/offal_dishes.json
msgid "töttchen"
msgid_plural "töttchen"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. ~ Description of "töttchen"
#: data/json/items/comestibles/offal_dishes.json
msgid ""
"A German peasant dish that converts many less-desirable meat cuts and organs"
" into a palatable meal with the liberal application of butter, sugar, and "
"wine."
msgstr ""
"Un plato campesino alemán que convierte cualquier corte de carne u órganos "
"no tan deseables en una comida más apetitosa con la libre aplicación de "
"manteca, azúcar y vino."

#. ~ Item name
#: data/json/items/comestibles/offal_dishes.json
msgid "scrambled eggs and brain"
msgid_plural "scrambled eggs and brain"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. ~ Description of "scrambled eggs and brain"
#: data/json/items/comestibles/offal_dishes.json
msgid "Brain and eggs, why didn't you ever think to put these together?"
msgstr ""
"Cerebros y huevos ¿por qué no se te había ocurrido nunca ponerlos juntos?"

#. ~ Item name
#: data/json/items/comestibles/offal_dishes.json
msgid "sausage casing"
msgid_plural "sausage casings"
msgstr[0] "tripa para salchichas"
msgstr[1] "tripas para salchichas"
msgstr[2] "tripas para salchichas"

#. ~ Description of "sausage casing"
#: data/json/items/comestibles/offal_dishes.json
msgid ""
"Sausage casings made from animal intestines.  Ready to be used for forming "
"meat products."
msgstr ""
"Tripas de salchicha hechas de intestinos de origen animal. Listas para ser "
"usadas para formar productos cárnicos."

#. ~ Item name
#: data/json/items/comestibles/offal_dishes.json
msgid "artificial sausage casing"
msgid_plural "artificial sausage casings"
msgstr[0] "tripa artificial para salchicha"
msgstr[1] "tripas artificiales para salchichas"
msgstr[2] "tripas artificiales para salchichas"

#. ~ Description of "artificial sausage casing"
#: data/json/items/comestibles/offal_dishes.json
msgid ""
"Sausage casings made from plastic bags.  Ready to be used for forming meat "
"products."
msgstr ""
"Tripas para embutidos fabricadas con bolsas de plástico. Listas para ser "
"utilizadas para formar productos cárnicos."

#. ~ Item name
#: data/json/items/comestibles/offal_dishes.json
msgid "homemade hot dog"
msgid_plural "homemade hot dogs"
msgstr[0] "perrito caliente casero"
msgstr[1] "perritos calientes caseros"
msgstr[2] "perritos calientes caseros"

#. ~ Item name
#: data/json/items/comestibles/other.json
msgid "dried bottle gourd"
msgid_plural "dried bottle gourds"
msgstr[0] "calabaza botella secada"
msgstr[1] "calabazas botella secadas"
msgstr[2] "calabazas botella secadas"

#. ~ Description of "dried bottle gourd"
#: data/json/items/comestibles/other.json
msgid ""
"A vegetable from the gourd family, bottle gourds were brought to the "
"Americas by the first Native American settlers crossing the Bering strait.  "
"This one has been dried for processing into a watertight container."
msgstr ""
"Un vegetal de la familia de las calabazas, las calabazas botella fueron "
"exportadas a las Américas por los primeros pioneros Americanos Nativos "
"cruzando el estrecho de Bering. Este ha sido secado para procesarlo en un "
"contenedor hermético."

#. ~ Item name
#: data/json/items/comestibles/other.json
#: data/mods/My_Sweet_Cataclysm/sweet_comestibles.json
msgid "chewing gum"
msgid_plural "chewing gums"
msgstr[0] "chicle"
msgstr[1] "chicles"
msgstr[2] "chicles"

#. ~ Description of "chewing gum"
#: data/json/items/comestibles/other.json
msgid "Bright pink sugar-free chewing gum."
msgstr "Chicle sin azúcar de un rosa brillante."

#. ~ Item name
#: data/json/items/comestibles/other.json
msgid "slime glob"
msgid_plural "slime globs"
msgstr[0] "glóbulo légamo"
msgstr[1] "glóbulos légamo"
msgstr[2] "glóbulos légamo"

#. ~ Description of "slime glob"
#: data/json/items/comestibles/other.json
msgid ""
"A little hunk of glop that fell off a slime monster.  It doesn't seem "
"hostile, but it does wiggle occasionally."
msgstr ""
"Un pequeño trozo de glóbulo que cayó de un monstruo légamo. No parece "
"hostil, pero se mueve ocasionalmente."

#. ~ Item name
#: data/json/items/comestibles/other.json
msgid "honey comb"
msgid_plural "honey combs"
msgstr[0] "panal de miel"
msgstr[1] "panales de miel"
msgstr[2] "panales de miel"

#. ~ Description of "honey comb"
#: data/json/items/comestibles/other.json
msgid "A large chunk of wax filled with honey.  Very tasty."
msgstr "Un trozo grande de cera llena de miel. Muy sabroso."

#. ~ Item name
#: data/json/items/comestibles/other.json
msgid "chunk of beeswax"
msgid_plural "chunks of beeswax"
msgstr[0] "trozo de cera de abeja"
msgstr[1] "trozos de cera de abeja"
msgstr[2] "trozos de cera de abeja"

#. ~ Description of "chunk of beeswax"
#: data/json/items/comestibles/other.json
msgid ""
"A large chunk of beeswax.  Despite being used in some cooking recipes, "
"beeswax in itself is indigestible to humans."
msgstr ""
"Un trozo grande de cera de abeja. A pesar de ser usada en algunas recetas de"
" cocina, la cera de abeja por si misma no es digerible para los humanos."

#. ~ Item name
#: data/json/items/comestibles/other.json
msgid "royal jelly"
msgid_plural "royal jelly"
msgstr[0] "jalea real"
msgstr[1] "jalea real"
msgstr[2] "jalea real"

#. ~ Description of "royal jelly"
#: data/json/items/comestibles/other.json
msgid ""
"A translucent hexagonal chunk of wax, filled with dense, milky, bitter and "
"acidic-tasting jelly.  Though some hold it as a panacea, it doesn't have any"
" medical benefit.  Still it is rich with the most beneficial substances the "
"hive can produce."
msgstr ""
"Un trozo de cera hexagonal translúcido, relleno de gelatina densa, lechosa, "
"amarga y de sabor ácido. Aunque algunos la consideran una panacea, no tiene "
"ningún beneficio médico. Aún así es rica en las sustancias más beneficiosas "
"que la colmena puede producir."

#. ~ It takes about 30 portions of honeydew to feed an adult (~2000 kkal).
#. 2000 kkal is about 10 raw chunks of mutant meat, which is 250% toxins.
#. Honeydew probably isn't as toxic as meat, so 30 portions of it would give
#. you 180% of toxins.
#. ~ Item name
#: data/json/items/comestibles/other.json
msgid "honeydew"
msgid_plural "honeydew"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. ~ It takes about 30 portions of honeydew to feed an adult (~2000 kkal).
#. 2000 kkal is about 10 raw chunks of mutant meat, which is 250% toxins.
#. Honeydew probably isn't as toxic as meat, so 30 portions of it would give
#. you 180% of toxins.
#. ~ Description of "honeydew"
#: data/json/items/comestibles/other.json
msgid ""
"A sugar-rich sticky substance, produced by aphids from plant sap.  Ants and "
"bees love it."
msgstr ""
"Una sustancia pegajosa rica en azúcar, producida por los pulgones a partir "
"de la savia de las plantas. Las hormigas y las abejas la adoran."

#. ~ Item name
#. ~ Plant name of seed "Marloss seed"
#: data/json/items/comestibles/other.json
#: data/json/items/comestibles/seed.json
msgid "Marloss berry"
msgid_plural "Marloss berries"
msgstr[0] "baya Marloss"
msgstr[1] "bayas Marloss"
msgstr[2] "bayas Marloss"

#. ~ Description of "Marloss berry"
#: data/json/items/comestibles/other.json
msgid ""
"This looks like a blueberry the size of your fist, but pinkish in color.  It"
" has a strong but delicious aroma, but is clearly either mutated or of alien"
" origin."
msgstr ""
"Esto parece un arándano del tamaño de tu puño, pero con un color rosado. "
"Tiene un aroma fuerte y delicioso, pero claramente ha sufrido una mutación o"
" es de origen extraterrestre."

#. ~ Item name
#: data/json/items/comestibles/other.json
msgid "Marloss gelatin"
msgid_plural "Marloss gelatin"
msgstr[0] "gelatina de Marloss"
msgstr[1] "gelatinas de Marloss"
msgstr[2] "gelatinas de Marloss"

#. ~ Description of "Marloss gelatin"
#: data/json/items/comestibles/other.json
msgid ""
"This looks like a handful of lemon-colored liquid which has taken a set, "
"much like pre-Cataclysm Jello.  It has a strong but delicious aroma, but is "
"clearly either mutated or of alien origin."
msgstr ""
"Esto parece un puñado de líquido color limón que ha tomado un conjunto, muy "
"parecido a la gelatina de antes del Cataclismo. Tiene un fuerte pero "
"delicioso aroma, pero claramente ha sufrido una mutación o es de origen "
"alienígena."

#. ~ Item name
#: data/json/items/comestibles/other.json
msgid "Mycus fruit"
msgid_plural "Mycus fruits"
msgstr[0] "fruta Mycus"
msgstr[1] "frutas Mycus"
msgstr[2] "frutas Mycus"

#. ~ Description of "Mycus fruit"
#: data/json/items/comestibles/other.json
msgid ""
"Humans might call this a Gray Delicious apple: large, gray, and smells even "
"better than the Marloss.  If they didn't reject it for its alien origins.  "
"But we know better."
msgstr ""
"Los humanos podrían llamar a esto la Deliciosa Manzana Gris: grande, gris y "
"con mejor olor que la fruta de Marloss, si no la hubieran rechazado por su "
"origen extraterrestre. Pero nosotros sabemos que es mejor ."

#. ~ Item name
#: data/json/items/comestibles/other.json
msgid "yeast"
msgid_plural "yeast"
msgstr[0] "levadura"
msgstr[1] "levadura"
msgstr[2] "levadura"

#. ~ Description of "yeast"
#: data/json/items/comestibles/other.json
msgid ""
"A powder-like mix of cultured yeast, good for baking and brewing alike."
msgstr ""
"Una especie de polvo mezcla de levaduras refinadas, bueno para cocinar y "
"para elaborar bebidas."

#. ~ Item name
#: data/json/items/comestibles/other.json
msgid "yogurt starter culture"
msgid_plural "yogurt starter culture"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. ~ Description of "yogurt starter culture"
#: data/json/items/comestibles/other.json
msgid ""
"A powder-like mix of cultured yogurt bacteria, good for fermenting yogurt."
msgstr ""

#. ~ Item name
#: data/json/items/comestibles/other.json
msgid "koji"
msgid_plural "koji"
msgstr[0] "koji"
msgstr[1] "koji"
msgstr[2] "koji"

#. ~ Description of "koji"
#: data/json/items/comestibles/other.json
msgid ""
"Some ground rice covered with a special kind of mold used for "
"saccharification and fermentation in Japanese cuisine."
msgstr ""
"Un poco de arroz molido cubierto con un tipo especial de moho usado para la "
"sacarificación y fermentación en la cocina japonesa."

#. ~ Item name
#: data/json/items/comestibles/other.json
msgid "bone meal"
msgid_plural "bone meal"
msgstr[0] "harina de huesos"
msgstr[1] "harina de huesos"
msgstr[2] "harina de huesos"

#. ~ Description of "bone meal"
#: data/json/items/comestibles/other.json
msgid "This bone meal can be used to craft fertilizer and some other things."
msgstr ""
"Esta harina de hueso puede ser utilizada para fabricar fertilizantes y otras"
" cosas."

#. ~ Item name
#: data/json/items/comestibles/other.json
msgid "powdered gelatin"
msgid_plural "powdered gelatin"
msgstr[0] "gelatina en polvo"
msgstr[1] "gelatinas en polvo"
msgstr[2] "gelatinas en polvo"

#. ~ Description of "powdered gelatin"
#: data/json/items/comestibles/other.json
msgid ""
"Dried and powdered gelatin, used as a gelling agent when mixed with water."
msgstr ""
"Gelatina seca y en polvo, utilizada como agente gelificante cuando se mezcla"
" con agua."

#. ~ Same as the meat it's been made from.  It's additional ingredient
#. compared to smoking, jerking, and dehydrating, so there's no incentive
#. otherwise.
#. ~ Item name
#: data/json/items/comestibles/other.json
msgid "fresh gelatin"
msgid_plural "fresh gelatin"
msgstr[0] "gelatina fresca"
msgstr[1] "gelatinas frescas"
msgstr[2] "gelatinas frescas"

#. ~ Same as the meat it's been made from.  It's additional ingredient
#. compared to smoking, jerking, and dehydrating, so there's no incentive
#. otherwise.
#. ~ Description of "fresh gelatin"
#: data/json/items/comestibles/other.json
msgid "Fresh gelatin.  Not vegan-friendly!"
msgstr "Gelatina recién hecha. ¡No apta para veganos!"

#. ~ Item name
#: data/json/items/comestibles/other.json
msgid "tainted bone meal"
msgid_plural "tainted bone meal"
msgstr[0] "harina de huesos contaminados"
msgstr[1] "harina de huesos contaminados"
msgstr[2] "harina de huesos contaminados"

#. ~ Description of "tainted bone meal"
#: data/json/items/comestibles/other.json
msgid "This is a grayish bone meal made from rotten bones."
msgstr "Esto es harina de huesos grisácea hecha con huesos podridos."

#. ~ Item name
#: data/json/items/comestibles/other.json
msgid "chitin powder"
msgid_plural "chitin powder"
msgstr[0] "polvo de quitina"
msgstr[1] "polvo de quitina"
msgstr[2] "polvo de quitina"

#. ~ Description of "chitin powder"
#: data/json/items/comestibles/other.json
msgid ""
"This chitin powder can be used to craft fertilizer and some other things."
msgstr ""
"Este polvo de quitina puede ser utilizado para fabricar fertilizantes y "
"otras cosas."

#. ~ Item name
#: data/json/items/comestibles/other.json
msgid "napkin"
msgid_plural "napkins"
msgstr[0] "servilleta"
msgstr[1] "servilletas"
msgstr[2] "servilletas"

#. ~ Description of "napkin"
#: data/json/items/comestibles/other.json
msgid "A napkin.  Can be used for fires."
msgstr "Un servilleta. Se puede usar para hacer fuego."

#. ~ Item name
#: data/json/items/comestibles/other.json
msgid "cardboard"
msgid_plural "cardboards"
msgstr[0] "cartón"
msgstr[1] "cartones"
msgstr[2] "cartones"

#. ~ Description of "cardboard"
#: data/json/items/comestibles/other.json
msgid "A piece of cardboard."
msgstr "Un trozo de cartón."

#. ~ Item name
#: data/json/items/comestibles/other.json
msgid "canned beans"
msgid_plural "canned beans"
msgstr[0] "lata de alubias"
msgstr[1] "latas de alubias"
msgstr[2] "latas de alubias"

#. ~ Description of "canned beans"
#: data/json/items/comestibles/other.json
msgid ""
"Canned beans.  A staple among canned goods, these are reputedly good for "
"one's coronary health."
msgstr ""
"Lata de alubias. Un clásico de la comida enlatada, se dice que son buenas "
"para la salud coronaria."

#. ~ Item name
#: data/json/items/comestibles/other.json
msgid "dried beans"
msgid_plural "dried beans"
msgstr[0] "alubia seca"
msgstr[1] "alubias secas"
msgstr[2] "alubias secas"

#. ~ Description of "dried beans"
#: data/json/items/comestibles/other.json
msgid ""
"Dehydrated great northern beans.  Tasty and nutritious when cooked, "
"virtually inedible when dry."
msgstr ""
"Alubias deshidratadas grandes del norte. Sabrosas y nutritivas cuando se "
"cocinan, prácticamente incomibles cuando están secas."

#. ~ Plant name of seed "dried beans"
#. ~ Plant name of seed "raw beans"
#. ~ Plant name of seed "bean seeds"
#: data/json/items/comestibles/other.json
#: data/json/items/comestibles/raw_veggy.json
#: data/json/items/comestibles/seed.json
msgid "beans"
msgstr "alubias"

#. ~ Item name
#: data/json/items/comestibles/other.json
msgid "cooked beans"
msgid_plural "cooked beans"
msgstr[0] "alubias cocinadas"
msgstr[1] "alubias cocinadas"
msgstr[2] "alubias cocinadas"

#. ~ Description of "cooked beans"
#: data/json/items/comestibles/other.json
msgid "A hearty serving of cooked great northern beans."
msgstr "Una porción abundante de alubias cocinadas grandes del norte."

#. ~ Item name
#: data/json/items/comestibles/other.json
msgid "tofu"
msgid_plural "tofu"
msgstr[0] "tofu"
msgstr[1] "tofu"
msgstr[2] "tofu"

#. ~ Description of "tofu"
#. ~ Description of "fried tofu"
#: data/json/items/comestibles/other.json
msgid ""
"Tofu, a soy protein crucial to East Asian cuisine.  It absorbs flavors very "
