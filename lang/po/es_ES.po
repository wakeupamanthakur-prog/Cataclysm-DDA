msgstr[1] "pares de gafas de sol correctivas"
msgstr[2] "pares de gafas de sol correctivas"

#. ~ Description of "pair of corrective sunglasses"
#: data/json/items/armor/eyewear.json
msgid ""
"A pair of sunglasses for keeping the glare out of the eyes of those who are "
"near-sighted."
msgstr ""
"Un par de gafas de sol para mantener el brillo alejado de los ojos de los "
"miopes."

#. ~ Item name
#: data/json/items/armor/eyewear.json
msgid "pair of reading sunglasses"
