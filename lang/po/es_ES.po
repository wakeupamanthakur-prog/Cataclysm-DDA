#. ~ Profession name for male
#: data/json/professions.json
msgctxt "profession_male"
msgid "Diver"
msgstr "Buzo"

#. ~ Description of profession "Diver" for male
#: data/json/professions.json
msgctxt "prof_desc_male"
msgid ""
"You were exploring below the waves close to shore when you noticed something"
" weird on the nearby beach, you decided to swim away when you heard the "
"screams."
msgstr ""
"Estabas disfrutando de la compañía de la vida submarina cuando notaste algo "
"extraño en la playa cercana, decidiste alejarte nadando cuando escuchaste "
"los gritos."

#. ~ Profession name for female
#: data/json/professions.json
msgctxt "profession_female"
msgid "Diver"
msgstr "Buzo"

#. ~ Description of profession "Diver" for female
#: data/json/professions.json
