#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid "broken metal floor"
msgstr "suelo de metal roto"

#. ~ Description of terrain "broken metal floor"
#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid ""
"Something has cratered this metal flooring.  It will be difficult to move "
"things across."
msgstr ""
"Algo ha hecho cráteres en este suelo metálico. Será difícil mover cosas a "
"través de él."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid "floor"
msgstr "suelo"

#. ~ Description of terrain "floor"
#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid ""
"Interlocking wooden tiles that are more than likely treated against fire, "
"with wooden posts and beams supporting a roof."
msgstr ""
"Tejas de madera entrelazadas que son más que probablemente tratadas contra "
"el fuego, con postes y vigas de madera que sostienen un techo."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid "primitive floor"
msgstr "piso primitivo"

#. ~ Description of terrain "primitive floor"
#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid "A timber floor and supports, holding up a sod roof."
msgstr "Suelo de madera y soportes, sosteniendo un techo de césped."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid "simple metal floor"
msgstr "suelo simple de metal"

#. ~ Description of terrain "simple metal floor"
#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid ""
"A crudely welded-together metal floor with steel trusses and supporting "
"girders."
msgstr ""
"Un suelo de metal no muy bien soldado con una estructura de acero y vigas de"
" apoyo."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid "waxed floor"
msgstr "suelo encerado"

#. ~ Description of terrain "waxed floor"
#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid ""
"Hardwood flooring that has been treated with chemicals to improve slip "
"resistance and sliding, commonly for recreational sports."
msgstr ""
"Pisos de madera dura que han sido tratados con productos químicos para "
"mejorar la resistencia al deslizamiento y al deslizamiento, comúnmente para "
"los deportes recreativos."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-floors-indoor.json
#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
msgid "dirt floor"
msgstr "suelo de tierra"

#. ~ Description of terrain "dirt floor"
#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid ""
"A floor consisting of finely mixed earth that has been tamped down, with a "
"wooden ceiling above it."
msgstr ""
"Un suelo hecho de tierra finamente mezclada que ha sido apisonada, con un "
"techo de madera encima."

#. ~ Description of terrain "dirt floor"
#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid ""
"A floor consisting of finely mixed earth that has been tamped down, with a "
"thatched roof above it."
msgstr ""
"Un suelo que consiste en tierra finamente mezclada que ha sido apisonada, "
"con un techo de paja sobre ella."

#. ~ Description of terrain "metal grate"
#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid ""
"A walkway that can be used as a protective covering over drains, or even as "
"a filter."
msgstr ""
"Un tipo de pasarela que puede utilizarse como cubierta protectora sobre los "
"desagües o incluso como filtro."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid "utility light"
msgstr "luz de utilidad"

#. ~ Description of terrain "utility light"
#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid ""
"An industrial floodlight set up to illuminate the surroundings.  Smashing it"
" doesn't seem like it'd produce any worthwhile salvage."
msgstr ""
"Un foco industrial instalado para iluminar los alrededores. Destrozarlo no "
"parece que produzca ningún material que valga la pena."

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid "wax floor"
msgstr "piso de cera"

#. ~ Description of terrain "wax floor"
#: data/json/furniture_and_terrain/terrain-floors-indoor.json
msgid "A floor section made entirely out of wax."
msgstr ""
"Una secciónUna sección del piso hecha completamente de cera. del piso hecha "
"completamente de cera."

