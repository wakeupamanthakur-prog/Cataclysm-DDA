msgstr[1] "limonada"
msgstr[2] "limonada"

#. ~ Description of "lemonade"
#: data/json/items/comestibles/drink.json
msgid ""
"Lemon juice mixed with water and sugar to dull the sourness.  Delicious and "
"refreshing."
msgstr ""
"Zumo de limón mezclado con agua y azúcar para suavizar la acidez. Delicioso "
"y refrescante."

#. ~ Item name
#: data/json/items/comestibles/drink.json
msgid "lemon-lime soda"
msgid_plural "lemon-lime soda"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. ~ Description of "lemon-lime soda"
#: data/json/items/comestibles/drink.json
msgid ""
"Unlike cola this is caffeine free, however it is still carbonated and has "
"plenty of sugar and a lemon-lime taste."
msgstr ""
"A diferencia de los refrescos de cola, esta bebida no contiene cafeína, pero"
" sí está carbonatada y tiene mucho azúcar y sabor a lima-limón."

#. ~ Item name
#: data/json/items/comestibles/drink.json
msgid "lotus tea"
msgid_plural "lotus tea"
msgstr[0] "té de loto"
msgstr[1] "té de loto"
msgstr[2] "té de loto"

#. ~ Description of "lotus tea"
#: data/json/items/comestibles/drink.json
msgid "A healthy beverage made from lotus flowers steeped in boiling water."
msgstr ""
"Una bebida saludable hecha con flores de loto sumergidas en agua hirviendo."

#. ~ Item name
#: data/json/items/comestibles/drink.json
msgid "Mexican hot chocolate"
msgid_plural "Mexican hot chocolate"
msgstr[0] "Chocolate caliente mejicano"
msgstr[1] "Chocolate caliente mejicano"
msgstr[2] "Chocolate caliente mejicano"

#. ~ Description of "Mexican hot chocolate"
#: data/json/items/comestibles/drink.json
msgid ""
"This semi-bitter chocolate drink made from cocoa, cinnamon, and chilies "
"traces its history to the Maya and Aztecs.  Perfect for a cold winter day."
msgstr ""
"Esta bebida de chocolate semiamargo elaborada con cacao, canela y chiles se "
"remonta a los mayas y aztecas. Perfecta para un frío día de invierno."

#. ~ Item name
#: data/json/items/comestibles/drink.json
msgid "coffee milk"
msgid_plural "coffee milk"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. ~ Description of "coffee milk"
#: data/json/items/comestibles/drink.json
msgid ""
"Coffee syrup or black coffee mixed into milk.  It's been the state drink of "
"Rhode Island since 1993."
msgstr ""
"Una mezcla de sirope o café negro mezclado con leche. Ha sido la bebida "
"estatal de Rhode Island desde 1993."

#. ~ Item name
#: data/json/items/comestibles/drink.json
msgid "milk tea"
msgid_plural "milk tea"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. ~ Description of "milk tea"
#: data/json/items/comestibles/drink.json
msgid "Hot tea with cold milk."
msgstr "Té caliente con leche fría."

#. ~ most store-bought oj is fortified with calcium.
