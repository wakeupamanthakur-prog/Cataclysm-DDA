#: data/json/items/comestibles/drink.json
msgid "orange juice"
msgid_plural "orange juice"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. ~ most store-bought oj is fortified with calcium.
#. ~ Description of "orange juice"
#: data/json/items/comestibles/drink.json
msgid ""
"Store-bought orange juice.  Refreshing, tasty, and a great source of Vitamin"
" C."
msgstr ""

#. ~ Calories shouldn't matter since it won't spawn - should only be
#. craftable.
