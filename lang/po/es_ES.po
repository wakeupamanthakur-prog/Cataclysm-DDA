#: src/overmap.cpp:7141
#, c-format
msgid ""
"This is automated emergency shelter beacon %d%d.  Supplies, amenities and "
"shelter are stocked."
msgstr ""
"Esta es una radiobaliza automática del refugio de emergencia %d%d. Allí hay "
"suministros, servicios y refugio."

#: src/overmap.cpp:7145
#, c-format
msgid ""
"This is FEMA camp %d%d.  Supplies are limited, please bring supplemental "
"food, water, and bedding.  This is FEMA camp %d%d.  A designated long-term "
"emergency shelter."
msgstr ""
"Este es el campamento FEMA %d%d. Los suministros son limitados, por favor, "
"traer comida, agua y ropa de cama. Este es el campamento FEMA %d%d. Un "
"refugio designado de emergencia de largo plazo."

