#. ~ Profession name for male
#: data/json/professions.json
msgctxt "profession_male"
msgid "Groom"
msgstr "Novio"

#. ~ Description of profession "Groom" for male
#: data/json/professions.json
msgctxt "prof_desc_male"
msgid ""
"The Cataclysm struck on the big day and you escaped with nothing but your "
"wedding attire.  Cold feet?  You'd just like to keep your feet attached!"
msgstr ""
"El Cataclismo golpeó en el gran día y escapaste con nada más que tu atuendo "
"de boda. ¿Pies fríos? ¡Te preocupa más mantenerlos unidos!"

#. ~ Profession name for female
#: data/json/professions.json
msgctxt "profession_female"
msgid "Bride"
msgstr "Novia"

#. ~ Description of profession "Bride" for female
