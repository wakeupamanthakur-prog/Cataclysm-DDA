#. ~ Item name
#: data/json/items/comestibles/carnivore.json
msgid "piece of raw lung"
msgid_plural "pieces of raw lung"
msgstr[0] "trozo de pulmón crudo"
msgstr[1] "trozos de pulmón crudo"
msgstr[2] "trozos de pulmón crudo"

#. ~ Description of "piece of raw lung"
#: data/json/items/comestibles/carnivore.json
msgid ""
"A portion of lung from an animal.  It's spongy and pink, and spoils very "
"quickly.  It can be a delicacy if properly prepared - but if improperly "
"prepared, it's a chewy lump of flavorless connective tissue."
msgstr ""
"Una porción de pulmón de un animal. Es esponjosa y rosada, y se estropea muy"
" rápidamente. Puede ser un manjar si se prepara adecuadamente, pero si se "
"prepara mal, es un bulto masticable de tejido conectivo sin sabor."

#. ~ Item name
#: data/json/items/comestibles/carnivore.json
msgid "piece of raw human lung"
msgid_plural "pieces of raw human lung"
msgstr[0] "trozo de pulmón humano crudo"
msgstr[1] "trozos de pulmón humano crudo"
msgstr[2] "trozos de pulmón humano crudo"

#. ~ Description of "piece of raw human lung"
#: data/json/items/comestibles/carnivore.json
msgid ""
"A portion of lung from a human.  It's spongy and pink, and spoils very "
"quickly.  It appears to have been extracted too crudely to ever be useful as"
" a transplant."
msgstr ""
"Una porción de pulmón de un humano. Es esponjosa y rosa, y se daña muy "
"rápidamente. Parece haber sido extraída con demasiada crudeza como para ser "
"útil como trasplante."

#. ~ Item name
#: data/json/items/comestibles/carnivore.json
