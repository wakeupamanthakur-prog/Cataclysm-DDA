#. ~ Speech from speaker mon_turret, mon_mi_go, mon_mi_go_slaver
#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"Searching!\""
msgstr "\"¡Buscando!\""

#. ~ Speech from speaker mon_turret, mon_mi_go, mon_mi_go_slaver
#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"Hey!  It's me!\""
msgstr "\"¡Eh! ¡Soy yo!\""

#. ~ Speech from speaker mon_turret, mon_mi_go, mon_mi_go_slaver
#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"Ouch!\""
msgstr "\"Ouch!\""

#. ~ Speech from speaker mon_turret, mon_mi_go, mon_mi_go_slaver
#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"Sentry mode activated.\""
msgstr "\"Modo de guardia activado.\""

#. ~ Speech from speaker mon_turret, mon_mi_go, mon_mi_go_slaver
#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"Hi.\""
msgstr "\"Hola.\""

#. ~ Speech from speaker mon_turret, mon_mi_go, mon_mi_go_slaver
