msgstr "Grita a Mantenimiento para que te reemplacen de nuevo."

#. ~ Snippet in category "lab_postit_tech"
#: data/json/snippets/lab.json
msgid "Don't release switch before discharge"
msgstr "No suelte el interruptor antes de la descarga"

#. ~ Snippet in category "lab_postit_tech"
#: data/json/snippets/lab.json
msgid ""
"Shielding corrodes too fast\n"
"\n"
"Mount on drone?"
msgstr ""
"El blindaje se corroe demasiado rápido\n"
"\n"
"¿Montar en el dron?"

#. ~ Snippet in category "lab_postit_tech"
#: data/json/snippets/lab.json
