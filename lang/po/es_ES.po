msgstr[0] "unidad de compresor de alta presión"
msgstr[1] "unidades de compresor de alta presión"
msgstr[2] "unidades de compresor de alta presión"

#. ~ Description of vehicle part "high pressure compressor unit"
#: data/json/furniture_and_terrain/appliances.json
msgid ""
"A machine designed to compress an input gas to a very high pressure.  It has"
" been plugged into a power grid."
msgstr ""
"Una maquina diseñada para comprimir un gas de entrada en uno de muy alta "
"presión. Ha sido conectado a la corriente eléctrica."

#. ~ Furniture name
#: data/json/furniture_and_terrain/furniture-alien.json
msgid "glowing tendril"
msgstr "zarcillo luminoso"

#. ~ Description of furniture "glowing tendril"
#: data/json/furniture_and_terrain/furniture-alien.json
msgid ""
"A willowy tendril growing from the floor, gently waving back and forth.  A "
"faint light spills from it."
msgstr ""
"Un zarcillo de sauce que crece desde el suelo y se agita suavemente de un "
"lado a otro. Una débil luz brota de él."

