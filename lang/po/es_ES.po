msgid_plural "sap belchers"
msgstr[0] "vientre de savia"
msgstr[1] "vientres de savia"
msgstr[2] "vientres de savia"

#. ~ Description of monster "sap belcher"
#: data/mods/TropiCataclysm/monsters/zed_plant.json
msgid ""
"This big and bloated zombie seems full of sap.  Its already overgrown body "
"shows several flowering plants growing over it."
msgstr ""
"Este zombi grande e hinchado parece estar lleno de savia. Su cuerpo, ya muy "
"crecido, muestra varias plantas con flores que crecen sobre él."

#. ~ Monster name
#: data/mods/TropiCataclysm/monsters/zed_plant.json
msgid "pollinated eructor"
msgid_plural "pollinated eructors"
msgstr[0] "eructor polinizador"
msgstr[1] "eructores polinizadores"
msgstr[2] "eructores polinizadores"

#. ~ Description of monster "pollinated eructor"
#: data/mods/TropiCataclysm/monsters/zed_plant.json
msgid ""
"This engorged zombie has smears of strange pollen on its mouth and plants "
"over its body.  It shambles around eructing the stuff all over the place."
msgstr ""
"Este zombi engullido tiene manchas de extraño polen en la boca y plantas por"
" todo el cuerpo. Se pasea eructando la materia por todas partes."

#. ~ Monster name
#: data/mods/TropiCataclysm/monsters/zed_plant.json
