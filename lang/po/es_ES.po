#. ~ Based on US Army SPCS
#. ~ Description of "empty XL ballistic vest"
#: data/mods/Aftershock/items/armor.json
msgid ""
"Oversized ballistic armor without any armor inserts.  The soft armor plate "
"carrier is still protective but it won't stop high energy projectiles."
msgstr ""
"Armadura balística de gran tamaño sin ningún tipo de relleno de armadura. El"
" portador de la placa de la armadura suave sigue protegiendo pero no "
"detendrá los proyectiles de alta potencia."

#. ~ Item name
#: data/mods/Aftershock/items/armor.json
msgid "XL ESAPI ballistic vest"
msgid_plural "XL ESAPI ballistic vests"
msgstr[0] "Chaleco balístico ESAPI XL"
msgstr[1] "Chalecos balísticos ESAPI XL"
msgstr[2] "Chalecos balísticos ESAPI XL"

#. ~ Description of "XL ESAPI ballistic vest"
#: data/mods/Aftershock/items/armor.json
msgid "Oversized ballistic armor with ESAPI ceramic armor plates."
msgstr "Armadura balística de gran tamaño con placas ESAPI cerámicas."

#. ~ Item name
