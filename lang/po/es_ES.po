#. ~ Description of vehicle part "car battery"
#. ~ Description of vehicle part "large storage battery"
#: data/json/vehicleparts/battery.json
msgid ""
"A battery for storing electrical power, and discharging it to power "
"electrical devices built into the vehicle."
msgstr ""
"Una batería para almacenar energía eléctrica, y descargarla para alimentar "
"los dispositivos eléctricos incorporados en el vehículo."

#. ~ Vehicle part name
#: data/json/vehicleparts/battery.json
msgid "motorbike battery, small"
msgstr "batería de moto, pequeña"

#. ~ Vehicle part name
#: data/json/vehicleparts/battery.json
msgid "swappable very large storage battery"
msgstr "batería de almacenamiento muy grande intercambiable"

#. ~ Description of vehicle part "swappable very large storage battery"
#: data/json/vehicleparts/battery.json
msgid ""
"A battery for storing electrical power, and discharging it to power "
"electrical devices built into the vehicle.  This one is mounted on a quick "
"release framework to allow it to be easily swapped, though it still weighs "
"so much that a lifting tool of some kind is necessary for most people."
msgstr ""
"Una batería para almacenar energía eléctrica, y descargarla para alimentar "
"los dispositivos eléctricos incorporados en el vehículo. Ésta está montada "
"en un marco de liberación rápida para permitir que sea fácilmente "
"intercambiable, aunque todavía pesa tanto que una herramienta de "
"levantamiento de algún tipo es necesaria para la mayoría de las personas."

#. ~ Vehicle part name
#: data/json/vehicleparts/battery.json
msgid "swappable large storage battery"
msgstr "batería de almacenamiento grande intercambiable"

#. ~ Description of vehicle part "swappable large storage battery"
#: data/json/vehicleparts/battery.json
msgid ""
"A battery for storing electrical power, and discharging it to power "
"electrical devices built into the vehicle.  This one is mounted on a quick "
"release framework to allow it to be easily swapped, though it still weighs "
"so much that a lifting tool of some kind is necessary for some people."
msgstr ""
"Una batería para almacenar energía eléctrica, y descargarla para alimentar "
"los dispositivos eléctricos incorporados al vehículo. Está montada en un "
"amazon de liberación rápida para permitir que sea fácilmente intercambiable,"
" aunque sigue pesando tanto que para algunas personas es necesario algún "
"tipo de herramienta de elevación."

