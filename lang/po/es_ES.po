msgstr[0] "caminante de cienaga"
msgstr[1] "caminantes de cienaga"
msgstr[2] "caminantes de cienaga"

#. ~ Description of monster "mire walker"
#: data/mods/TropiCataclysm/monsters/zed_plant.json
msgid ""
"This zombie seems to have been roaming the surrounding swamps and rivers.  "
"It has several water plants clinging to its body."
msgstr ""
"Este zombi parece haber estado vagando por los pantanos y ríos de los "
"alrededores. Tiene varias plantas acuáticas adheridas a su cuerpo"

#. ~ Monster name
#: data/mods/TropiCataclysm/monsters/zed_plant.json
msgid "mangrove lurker"
msgid_plural "mangrove lurkers"
msgstr[0] "merodeador de manglar"
msgstr[1] "merodeadores de manglar"
msgstr[2] "merodeadores de manglar"

#. ~ Description of monster "mangrove lurker"
#: data/mods/TropiCataclysm/monsters/zed_plant.json
msgid ""
"This zombie seems to have adapted to hunt in the water.  It uses the aquatic"
" plants on its body to hide before hitting with its teeth."
msgstr ""
"Este zombi parece haberse adaptado a moverse en el agua. Utiliza las plantas"
" acuáticas de su cuerpo para esconderse antes de golpear con sus dientes."

