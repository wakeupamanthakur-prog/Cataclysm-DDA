#. ~ Description of "broken Exodii worker"
#: data/json/items/corpses/dead_exodii.json
msgid "A broken Exodii worker.  It's possible it could be gutted for parts."
msgstr ""
"Un trabajador Exodii roto. Es posible que se pueda desmontar para recuperar "
"sus partes."

#. ~ Item name
#: data/json/items/corpses/dead_exodii.json
#: data/mods/Xedra_Evolved/items/corpses.json
#: data/mods/Xedra_Evolved/mod_interactions/Defense_Mode/monster_corpses.json
msgid "broken Exodii quadruped"
msgid_plural "broken Exodii quadrupeds"
msgstr[0] "cuadrúpedo Exodii roto"
msgstr[1] "cuadrúpedos Exodii rotos"
msgstr[2] "cuadrúpedos Exodii rotos"

#. ~ Description of "broken Exodii quadruped"
#: data/json/items/corpses/dead_exodii.json
msgid ""
"A broken Exodii walker.  Still looks intimidating despite being permanently "
"inoperative, possibly due to the sheer size and mass.  Could be gutted for "
"parts."
msgstr ""
"Un caminante Exodii roto. Todavía se ve intimidante a pesar de estar "
"permanentemente inoperativo, posiblemente debido al tamaño y la masa. Se "
"podría desmontar para recuperar sus partes."

#. ~ Item name
#: data/json/items/corpses/dead_exodii.json
msgid "broken Exodii turret"
msgid_plural "broken Exodii turrets"
msgstr[0] "torreta Exodii rota"
msgstr[1] "torretas Exodii rotas"
msgstr[2] "torretas Exodii rotas"

#. ~ Description of "broken Exodii turret"
#: data/json/items/corpses/dead_exodii.json
msgid ""
"A broken Exodii turret.  Still looks intimidating despite being permanently "
"inoperative, possibly due to the sheer size and mass.  Could be gutted for "
"parts."
msgstr ""
"Una torreta Exodii rota. Todavía se ve intimidante a pesar de estar "
"permanentemente inoperativa, posiblemente debido al tamaño y la masa. Se "
"podría desmontar para recuperar sus partes."

#. ~ Item name
#: data/json/items/corpses/dead_exodii.json
msgid "broken Exodii balloon-drone"
msgid_plural "broken Exodii balloon-drones"
msgstr[0] "dron-globo Exodii roto"
msgstr[1] "drones-globo Exodii rotos"
msgstr[2] "drones-globo Exodii rotos"

#. ~ Description of "broken Exodii balloon-drone"
#: data/json/items/corpses/dead_exodii.json
msgid ""
"A broken balloon drone.  The balloon has been shredded, but most of the "
"chassis is still intact.  Could be gutted for parts."
msgstr ""
"Un globodrón roto. El globo ha sido destrozado, pero la mayor parte del "
"chasis sigue intacto. Se podría desmontar para recuperar sus partes."

#. ~ Item name
#: data/json/items/corpses/dead_yrax.json
msgid "trifacet remains"
msgid_plural "trifacet remains"
msgstr[0] "restos tricara"
msgstr[1] "restos tricara"
msgstr[2] "restos tricara"

#. ~ Description of "trifacet remains"
#: data/json/items/corpses/dead_yrax.json
msgid ""
"A split-open facet reveals an interior full of closely-fit geometric "
"primitives among chipped strips of milk-white quartz.  The composition of "
"parts lends you no clues as to how this machine ever functioned."
msgstr ""
"Una faz abierta completamente revela su interior lleno de primitivas figuras"
" geométricas incrustadas entre pedazos astillados de cuarzo blanco como la "
"leche. La composición de sus partes no te da ninguna pista de cómo "
"funcionaba esta máquina."

