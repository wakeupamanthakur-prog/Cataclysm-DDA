msgid_plural "bramble brutes"
msgstr[0] "bestia de la zarza"
msgstr[1] "bestias de la zarza"
msgstr[2] "bestias de la zarza"

#. ~ Description of monster "bramble brute"
#: data/mods/TropiCataclysm/monsters/zed_plant.json
