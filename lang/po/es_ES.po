#. ~ Item name
#: data/json/items/armor/eyewear.json
msgid "pair of eclipse glasses"
msgid_plural "pairs of eclipse glasses"
msgstr[0] "par de gafas para eclipses"
msgstr[1] "pares de gafas para eclipses"
msgstr[2] "pares de gafas para eclipses"

#. ~ Description of "pair of eclipse glasses"
#: data/json/items/armor/eyewear.json
msgid ""
"A pair of cardboard-framed glasses with UV and IR-filtered lenses topped "
"with a layer of aluminum coating.  They allow safe viewing of extremely "
"bright and harmful sources of light, like the sun during a solar eclipse."
msgstr ""
"Un par de gafas de cartulina con lentes con filtro UV e IR, y una capa "
"adicional de recubrimiento de aluminio. Permiten mirar a fuentes de luz "
"extremadamente brillantes y peligrosas, como el sol durante un eclipse "
"solar."

#. ~ Item name
#: data/json/items/armor/eyewear.json
msgid "leather eyepatch"
msgid_plural "leather eyepatches"
msgstr[0] "parche de ojo de cuero"
msgstr[1] "parches de ojo de cuero"
msgstr[2] "parches de ojo de cuero"

#. ~ Description of "leather eyepatch"
#: data/json/items/armor/eyewear.json
msgid ""
"A patch of black leather to cover an eye, with a string to keep it from "
"falling off.  If wearing this doesn't make you feel a pirate, nothing will."
msgstr ""
"Un parche de cuero negro para cubrir un ojo, con una cuerda para evitar que "
"se caiga. Si usar esto no te hace sentir un pirata, nada lo hará."

#. ~ Item name
#: data/json/items/armor/eyewear.json
msgid "pair of stylish sunglasses"
msgid_plural "pairs of stylish sunglasses"
msgstr[0] "par de gafas de sol elegantes"
msgstr[1] "pares de gafas de sol elegantes"
msgstr[2] "pares de gafas de sol elegantes"

#. ~ Description of "pair of stylish sunglasses"
#: data/json/items/armor/eyewear.json
msgid ""
"A pair of stylish sunglasses.  Look good while keeping the glare out of your"
" eyes."
msgstr ""
"Un par de gafas de sol elegantes. Te quedan bien y te protegen contra "
"deslumbramientos."

#. ~ Item name
#: data/json/items/armor/eyewear.json
msgid "pair of fit-over sunglasses"
msgid_plural "pairs of fit-over sunglasses"
msgstr[0] "par de gafas de sol de ajuste"
msgstr[1] "pares de gafas de sol de ajuste"
msgstr[2] "pares de gafas de sol de ajuste"

#. ~ Description of "pair of fit-over sunglasses"
#: data/json/items/armor/eyewear.json
msgid ""
"A pair of fit-over sunglasses designed to be worn over a pair of corrective "
"glasses.  Good for keeping the glare out of your eyes."
msgstr ""
"Gafas de sol de ajuste diseñadas para poder ser utilizadas cómodamente sobre"
" un par de gafas graduadas. Útiles como protección contra deslumbramientos."

#. ~ Item name
#: data/json/items/armor/eyewear.json
msgid "pair of ballistic glasses"
msgid_plural "pairs of ballistic glasses"
msgstr[0] "par de gafas de balística"
msgstr[1] "pares de gafas de balística"
msgstr[2] "pares de gafas de balística"

#. ~ Description of "pair of ballistic glasses"
#: data/json/items/armor/eyewear.json
msgid ""
"Modern tactical eyewear that protects from small projectiles and fragments."
"  Provides excellent protection from environmental dangers."
msgstr ""
"Gafas protectoras tácticas, que evitan el daño de proyectiles pequeños y de "
"fragmentos. Excelente protección contra los peligros del medio ambiente."

#. ~ Item name
#: data/json/items/armor/eyewear.json
msgid "pair of bifocal glasses"
msgid_plural "pairs of bifocal glasses"
msgstr[0] "par de gafas bifocales"
msgstr[1] "pares de gafas bifocales"
msgstr[2] "pares de gafas bifocales"

#. ~ Description of "pair of bifocal glasses"
#: data/json/items/armor/eyewear.json
msgid ""
"A pair of bifocal glasses for those who are both near-sighted and far-"
"sighted.  You can use them to focus sunlight."
msgstr ""
"Un par de gafas bifocales para los que son hipermétropes y miopes. Las "
"puedes usar para concentrar la luz del sol."

#. ~ Item name
#: data/json/items/armor/eyewear.json
msgid "pair of eyeglasses"
msgid_plural "pairs of eyeglasses"
msgstr[0] "par de gafas"
msgstr[1] "pares de gafas"
msgstr[2] "pares de gafas"

#. ~ Description of "pair of eyeglasses"
#: data/json/items/armor/eyewear.json
msgid ""
"A pair of glasses for the near-sighted.  The concave lenses diffuse the "
"sunlight, rendering them useless for starting fires."
msgstr ""
"Un par de gafas para los miopes. Las lentes cóncavas dispersan la luz, lo "
"que las hace inservibles para encender un fuego."

#. ~ DDA monocle is optical-grade.  Costume ones go for about $10.
#. ~ Item name
#: data/json/items/armor/eyewear.json
msgid "monocle"
msgid_plural "monocles"
msgstr[0] "monóculo"
msgstr[1] "monóculos"
msgstr[2] "monóculos"

#. ~ DDA monocle is optical-grade.  Costume ones go for about $10.
#. ~ Description of "monocle"
#: data/json/items/armor/eyewear.json
msgid ""
"An essential article of the gentleman's apparel.  Also corrects near-"
"sightedness.  The concave lens diffuses the sunlight, rendering it useless "
"for starting fires."
msgstr ""
"Un artículo esencial en el vestuario del caballero. También corrige la "
"miopía. La lente cóncava difumina la luz del sol, haciéndola inútil para "
"encender un fuego."

#. ~ Item name
#: data/json/items/armor/eyewear.json
msgid "pair of reading glasses"
msgid_plural "pairs of reading glasses"
msgstr[0] "par de gafas de lectura"
msgstr[1] "pares de gafas de lectura"
msgstr[2] "pares de gafas de lectura"

#. ~ Description of "pair of reading glasses"
#: data/json/items/armor/eyewear.json
msgid ""
"A pair of glasses for the far-sighted.  Useless for anyone else.  You can "
"use them to focus sunlight."
msgstr ""
"Un par de gafas para los miopes. Inútiles para cualquier otro. Puedes "
"usarlas para concentrar la luz solar."

#. ~ Item name
#: data/json/items/armor/eyewear.json
msgid "pair of safety glasses"
msgid_plural "pairs of safety glasses"
msgstr[0] "par de gafas de seguridad"
msgstr[1] "pares de gafas de seguridad"
msgstr[2] "pares de gafas de seguridad"

#. ~ Description of "pair of safety glasses"
#: data/json/items/armor/eyewear.json
msgid ""
"A pair of plastic glasses, used in workshops, sports, chemistry labs, and "
"many other places.  Provides great protection from damage."
msgstr ""
"Un par de gafas de plástico, usadas en los talleres, deportes,  laboratorios"
" de química y muchos otros sitios. Proporciona una gran protección contra "
"daños."

#. ~ Item name
#: data/json/items/armor/eyewear.json
msgid "pair of glass goggles"
msgid_plural "pairs of glass goggles"
msgstr[0] "par de gafas de cristal"
msgstr[1] "pares de gafas de cristal"
msgstr[2] "pares de gafas de cristal"

#. ~ Description of "pair of glass goggles"
#: data/json/items/armor/eyewear.json
msgid ""
"A pair of old-fashioned goggles with thick glass lenses, somewhat similar to"
" those worn by the pilots of open-cockpit aircraft, but more crude looking."
"  Won't protect your eyes from physical harm, but can keep hazardous "
"chemicals out."
msgstr ""
"Un par de gafas anticuadas con lentes de cristal grueso, algo similares a "
"las que llevan los pilotos de aviones de cabina abierta, pero de aspecto más"
" tosco. No protegen los ojos de daños físicos, pero pueden mantener alejados"
" los productos químicos peligrosos."

#. ~ Item name
#: data/json/items/armor/eyewear.json
msgid "pair of ski goggles"
msgid_plural "pairs of ski goggles"
msgstr[0] "par de gafas de esquí"
msgstr[1] "pares de gafas de esquí"
msgstr[2] "pares de gafas de esquí"

#. ~ Description of "pair of ski goggles"
#: data/json/items/armor/eyewear.json
msgid ""
"A large pair of goggles that completely seal off your eyes.  Provides "
"excellent protection from environmental dangers."
msgstr ""
"Un gran par de gafas protectoras que sellan completamente tus ojos. "
"Proporciona una excelente protección contra los peligros del medio ambiente."

#. ~ Item name
#: data/json/items/armor/eyewear.json
msgid "pair of welding goggles"
msgid_plural "pairs of welding goggles"
msgstr[0] "par de gafas de soldadura"
msgstr[1] "pares de gafas de soldadura"
msgstr[2] "pares de gafas de soldadura"

#. ~ Description of "pair of welding goggles"
#: data/json/items/armor/eyewear.json
msgid ""
"A dark pair of goggles.  They make seeing very difficult, but protect you "
"from bright flashes."
msgstr ""
"Un par de gafas oscuras. Muy difícil ver con esto puesto, pero te protege de"
" las luces brillantes."

#. ~ Item name
#: data/json/items/armor/eyewear.json
msgid "pair of snow goggles"
msgid_plural "pairs of snow goggles"
msgstr[0] "par de gafas de nieve"
msgstr[1] "pares de gafas de nieve"
msgstr[2] "pares de gafas de nieve"

#. ~ Description of "pair of snow goggles"
#: data/json/items/armor/eyewear.json
msgid ""
"Eyewear carved from wood or bone, with only a thin slit to see out of.  "
"Helps reduce glare, traditionally used by the Inuit to protect against snow "
"blindness."
msgstr ""
"Gafas talladas en madera o hueso, con sólo una fina rendija para ver. Ayudan"
" a reducir el deslumbramiento, tradicionalmente usadas por los inuit para "
"protegerse contra la ceguera de la nieve."

#. ~ Item name
#: data/json/items/armor/eyewear.json
msgid "pair of sunglasses"
msgid_plural "pairs of sunglasses"
msgstr[0] "par de gafas de sol"
msgstr[1] "pares de gafas de sol"
msgstr[2] "pares de gafas de sol"

#. ~ Description of "pair of sunglasses"
#: data/json/items/armor/eyewear.json
msgid "A pair of sunglasses, good for keeping the glare out of your eyes."
msgstr ""
"Un par de gafas de sol, que son útiles para protegernos de las luces "
