msgid_plural "spritelings"
msgstr[0] "duendeling"
msgstr[1] "duendelings"
msgstr[2] "duendelings"

#. ~ Description of monster "spriteling"
#: data/mods/TropiCataclysm/monsters/zed_plant.json
msgid ""
"An undead child mutated by alien flora.  It has several colorful flowers on "
"its scalp and an unsettling serene expression."
msgstr ""

#. ~ Monster name
