msgstr "¡La verja está cerrada!"

#. ~ Message of fail action on a gate
#: data/json/gates.json
msgid "The gate can't be closed!"
msgstr "¡No se puede cerrar la verja!"

#. ~ Message of pull action on a gate
#: data/json/gates.json
msgid "You pull the rope…"
msgstr "Tiras de la soga..."

#. ~ Message of open action on a gate
#: data/json/gates.json
msgid "The barn doors opened!"
msgstr "¡Las puertas del granero se abren!"

#. ~ Message of close action on a gate
#: data/json/gates.json
msgid "The barn doors closed!"
msgstr "¡Las puertas del granero se cierran!"

#. ~ Message of fail action on a gate
#: data/json/gates.json
msgid "The barn doors can't be closed!"
msgstr "¡No se pueden cerrar las puertas del granero!"

#. ~ Message of open action on a gate
#: data/json/gates.json
msgid "The palisade gate swings open!"
msgstr "¡La verja empalizada se abre!"

#. ~ Message of close action on a gate
#: data/json/gates.json
msgid "The palisade gate swings closed with a crash!"
msgstr "¡La verja de la empalizada se cierra de un golpe!"

#. ~ Message of fail action on a gate
#: data/json/gates.json
msgid "The palisade gate can't be closed!"
msgstr "¡No se puede cerrar la verja de la empalizada!"

#. ~ Message of pull action on a gate
#: data/json/gates.json
msgid "You throw the lever…"
msgstr "Tiras la palanca..."

#. ~ Message of open action on a gate
#: data/json/gates.json
msgid "The door rises!"
msgstr "¡La puerta se levanta!"

#. ~ Message of close action on a gate
#: data/json/gates.json
