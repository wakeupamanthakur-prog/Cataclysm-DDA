msgstr "Ya activaste la %s, ahora intenta tirarla."

#. ~ Item name
#: data/json/items/tool/explosives.json
msgid "grenade"
msgid_plural "grenades"
msgstr[0] "granada"
msgstr[1] "granadas"
msgstr[2] "granadas"

#. ~ Description of "grenade"
#: data/json/items/tool/explosives.json
msgid ""
"A military-grade fragmentation hand grenade.  Use this item to pull the pin "
"and start the fuse.  You will then have five seconds before it explodes; "
"throwing it would be a good idea."
msgstr ""
"Una granada de fragmentación de grado militar. Utiliza este objeto para "
"sacar el pasador y encender la mecha. Tendrás cinco segundos antes de que "
"explote; lanzarla sería una buena idea."

#. ~ "msg" action message of item "grenade"
#. ~ "msg" action message of item "incendiary grenade"
#. ~ "msg" action message of item "cryo grenade"
#. ~ "msg" action message of item "inferno grenade"
