msgstr[1] "cinturones de munición"
msgstr[2] "cinturones de munición"

#. ~ Description of magazine "ammo belt"
#: data/json/items/classes/magazine.json
msgid ""
"An ammo belt consisting of metal linkages which disintegrate upon firing."
msgstr ""
"Es una cinta cargadora de munición que consiste en uniones metálicas que se "
"desintegran cuando se dispara."

#. ~ Item name
#: data/json/items/comestibles/alcohol.json
msgid "Mycus wine"
msgid_plural "Mycus wine"
msgstr[0] "vino mycus"
msgstr[1] "vinos mycus"
msgstr[2] "vinos mycus"

#. ~ Description of "Mycus wine"
#: data/json/items/comestibles/alcohol.json
msgid "Goopy white wine, made of the Mycus fruit."
msgstr "Vino viscoso blanco, hecho de la fruta de mycus."

#. ~ Item name
#: data/json/items/comestibles/alcohol.json
msgid "Marloss wine"
msgid_plural "Marloss wine"
msgstr[0] "vino marloss"
msgstr[1] "vinos marloss"
msgstr[2] "vinos marloss"

#. ~ Description of "Marloss wine"
#: data/json/items/comestibles/alcohol.json
msgid "A viscous, soft pink wine, made from the fruit of the Marloss."
msgstr "Es un vino viscoso y rosa clarito hecho con la fruta del Marloss."

#. ~ Booze uses nonstandard charge counts: 15 shots of wine to the 750mL
#. bottle.  Priced at 1100 translates to $33 per, because it's still priced
#. per 250 mL charge.
#. ~ Item name
#: data/json/items/comestibles/alcohol.json
msgid "Riesling"
msgid_plural "Riesling"
msgstr[0] "Riesling"
msgstr[1] "Riesling"
msgstr[2] "Riesling"

#. ~ Booze uses nonstandard charge counts: 15 shots of wine to the 750mL
#. bottle.  Priced at 1100 translates to $33 per, because it's still priced
#. per 250 mL charge.
#. ~ Description of "Riesling"
#: data/json/items/comestibles/alcohol.json
msgid "Sparkling white wine, made from the world's noblest grape."
msgstr "Vino blanco espumante, hecho de la uva más noble del mundo."

#. ~ The PLCB can get you some for around $10 per 750mL, but I imagine you
#. want to pay for better ~fermentation~.
#. ~ Item name
#: data/json/items/comestibles/alcohol.json
msgid "Chardonnay"
msgid_plural "Chardonnay"
msgstr[0] "Chardonnay"
msgstr[1] "Chardonnay"
msgstr[2] "Chardonnay"

#. ~ The PLCB can get you some for around $10 per 750mL, but I imagine you
#. want to pay for better ~fermentation~.
#. ~ Description of "Chardonnay"
#: data/json/items/comestibles/alcohol.json
msgid "America's most popular wine, and for good reason."
msgstr "El vino más popular de Estados Unidos, y con razón."

#. ~ Item name
#: data/json/items/comestibles/alcohol.json
msgid "Cabernet Sauvignon"
msgid_plural "Cabernet Sauvignon"
msgstr[0] "Cabernet Sauvignon"
msgstr[1] "Cabernet Sauvignon"
msgstr[2] "Cabernet Sauvignon"

#. ~ Description of "Cabernet Sauvignon"
#: data/json/items/comestibles/alcohol.json
msgid ""
"The heavily disputed king of red wines.  Pairs well with red meats and "
"pasta."
msgstr ""
"El muy disputado rey de los vinos tintos. Combina bien con las carnes rojas "
"y la pasta."

#. ~ Item name
#: data/json/items/comestibles/alcohol.json
msgid "Pinot noir"
msgid_plural "Pinot noir"
msgstr[0] "Pinot noir"
msgstr[1] "Pinot noir"
msgstr[2] "Pinot noir"

#. ~ Description of "Pinot noir"
#: data/json/items/comestibles/alcohol.json
msgid ""
"Prized by collectors and adored by critics, this is one of the rarer and "
"more elegant wines."
msgstr ""
"Premiado por coleccionistas y adorado por los críticos, es uno de los vinos "
"más raros y elegantes."

#. ~ Item name
#: data/json/items/comestibles/alcohol.json
msgid "marsala"
msgid_plural "marsala"
msgstr[0] "marsala"
msgstr[1] "marsala"
msgstr[2] "marsala"

#. ~ Description of "marsala"
#: data/json/items/comestibles/alcohol.json
msgid "A wine popularly used in dishes served in Italian restaurants."
msgstr ""
"Un vino usado popularmente en los platos que se sirven en los restaurantes "
"italianos."

#. ~ Item name
#: data/json/items/comestibles/alcohol.json
msgid "vermouth"
msgid_plural "vermouth"
msgstr[0] "vermut"
msgstr[1] "vermuts"
msgstr[2] "vermuts"

#. ~ Description of "vermouth"
#: data/json/items/comestibles/alcohol.json
msgid ""
"A soft wine with a pleasant herbal flavor and aroma.  It is a common "
"cocktail ingredient, and can be used as a substitute for white wine."
msgstr ""
"Un vino suave con un agradable sabor y aroma a hierbas. Es un ingrediente "
"común en los cócteles, y puede ser usado como sustituto del vino blanco."

#. ~ Item name
#: data/json/items/comestibles/alcohol.json
msgid "barley wine"
msgid_plural "barley wine"
msgstr[0] "vino de cebada"
msgstr[1] "vino de cebada"
msgstr[2] "vino de cebada"

#. ~ Description of "barley wine"
#: data/json/items/comestibles/alcohol.json
msgid ""
"Despite the name, this is technically a strong beer and not wine, but "
"there's no need to be pedantic about it."
msgstr ""
"A pesar del nombre, se trata técnicamente de una cerveza fuerte y no de un "
"vino, pero no es necesario ser pedante al respecto."

#. ~ Given the comment, presuming we're taking bourbon here.
#. ~ Item name
#. ~ Normal whiskey has been greatly devalued in the apocalypse by the
#. disproportionate quantity of endless whiskey flasks in comparison to the
#. number of survivors.
#: data/json/items/comestibles/alcohol.json
#: data/mods/Magiclysm/items/comestibles.json
msgid "whiskey"
msgid_plural "whiskey"
msgstr[0] "whisky"
msgstr[1] "whisky"
msgstr[2] "whisky"

#. ~ Given the comment, presuming we're taking bourbon here.
#. ~ Description of "whiskey"
#: data/json/items/comestibles/alcohol.json
msgid ""
"A distilled grain alcohol, made from, by, and for real Southern colonels!"
msgstr ""
"¡Un alcohol de grano destilado, hecho desde, por y para verdaderos coroneles"
" sureños!"

#. ~ Item name
#: data/json/items/comestibles/alcohol.json
msgid "vodka"
msgid_plural "vodka"
msgstr[0] "vodka"
msgstr[1] "vodka"
msgstr[2] "vodka"

#. ~ Description of "vodka"
#: data/json/items/comestibles/alcohol.json
msgid ""
"A beverage of alcohol, water, and not much else.  In America, men make "
"vodka, but in Soviet Russia, vodka makes the man."
msgstr ""
"Una bebida de alcohol, agua, y no mucho más. En América, los hombres hacen "
"vodka, pero en la Rusia soviética, el vodka hace al hombre."

#. ~ Item name
#: data/json/items/comestibles/alcohol.json
msgid "gin"
msgid_plural "gin"
msgstr[0] "ginebra"
msgstr[1] "ginebra"
msgstr[2] "ginebra"

#. ~ Description of "gin"
#: data/json/items/comestibles/alcohol.json
msgid ""
"An alcoholic beverage flavored with juniper berries.  It smells faintly of "
"berries, but mostly booze."
msgstr ""
"Es una bebida con alcohol con gusto a bayas de enebro. Tiene un débil aroma "
"a baya, y más que nada a alcohol."

#. ~ Item name
#: data/json/items/comestibles/alcohol.json
msgid "rum"
msgid_plural "rum"
msgstr[0] "ron"
msgstr[1] "ron"
msgstr[2] "ron"

#. ~ Description of "rum"
#: data/json/items/comestibles/alcohol.json
msgid ""
"A distilled alcoholic beverage made from fermenting molasses.  Drinking it "
"might make you feel like a pirate.  Or not."
msgstr ""
"Una bebida alcohólica destilada hecha de melaza fermentada. Beberla puede "
"hacerte sentir como un pirata. O no."

#. ~ Item name
#: data/json/items/comestibles/alcohol.json
msgid "tequila"
msgid_plural "tequila"
msgstr[0] "tequila"
msgstr[1] "tequila"
msgstr[2] "tequila"

#. ~ Description of "tequila"
#: data/json/items/comestibles/alcohol.json
msgid ""
"A distilled alcoholic beverage made from a succulent plant with spiky "
"leaves.  Don't eat the worm!  Wait, there's no worm in this bottle."
msgstr ""
"Una bebida alcohólica destilada hecha de una planta suculenta con hojas "
"espinosas. ¡No te comas el gusano! Espera, no hay ningún gusano en esta "
"botella."

#. ~ Item name
#: data/json/items/comestibles/alcohol.json
msgid "triple sec"
msgid_plural "triple sec"
msgstr[0] "triple seco"
msgstr[1] "triple seco"
msgstr[2] "triple seco"

#. ~ Description of "triple sec"
#: data/json/items/comestibles/alcohol.json
msgid "An orange-flavored liquor used in many mixed drinks."
msgstr "Un licor con gusto a naranja que se usa en muchos bebidas."

#. ~ Item name
#: data/json/items/comestibles/alcohol.json
msgid "sake"
msgid_plural "sake"
msgstr[0] "sake"
msgstr[1] "sake"
msgstr[2] "sake"

#. ~ Description of "sake"
#: data/json/items/comestibles/alcohol.json
msgid ""
"A Japanese alcoholic beverage made by fermenting rice with the use of yeast "
"and koji mold.  This one is mostly clear, as it has been filtered."
msgstr ""
"Bebida alcohólica japonesa elaborada mediante la fermentación del arroz con "
"el uso de levadura y moho koji. Esta es mayormente clara, ya que ha sido "
"filtrada."

#. ~ Item name
#: data/json/items/comestibles/alcohol.json
msgid "nigori sake"
msgid_plural "nigori sake"
msgstr[0] "sake de nigori"
msgstr[1] "sake de nigori"
msgstr[2] "sake de nigori"

#. ~ Description of "nigori sake"
#: data/json/items/comestibles/alcohol.json
msgid ""
"A Japanese alcoholic beverage made by fermenting rice with the use of yeast "
"and koji mold.  This one has a cloudy white color because of fine rice "
"particles in it, as it has not been filtered."
msgstr ""
"Bebida alcohólica japonesa elaborada mediante la fermentación del arroz con "
"el uso de levadura y moho koji. Este tiene un color blanco turbio debido a "
"las finas partículas de arroz que contiene, ya que no ha sido filtrado."

#. ~ Item name
#: data/json/items/comestibles/alcohol.json
msgid "cheap wine"
msgid_plural "cheap wine"
msgstr[0] "vino barato"
msgstr[1] "vinos barato"
msgstr[2] "vinos barato"

#. ~ Description of "cheap wine"
#: data/json/items/comestibles/alcohol.json
msgid "Really cheap fortified wine."
msgstr "Vino fortalecido muy barato."

#. ~ Item name
#: data/json/items/comestibles/alcohol.json
msgid "strong mixed alcohol"
msgid_plural "strong mixed alcohol"
msgstr[0] "mezcla fuerte de alcohol"
msgstr[1] "mezcla fuerte de alcohol"
msgstr[2] "mezcla fuerte de alcohol"

#. ~ Description of "strong mixed alcohol"
#: data/json/items/comestibles/alcohol.json
msgid "Strong alcoholic drinks, mixed with no regard for taste."
msgstr "Bebidas alcohólicas fuertes, mezcladas con ningún sentido del gusto."

#. ~ Item name
#: data/json/items/comestibles/alcohol.json
msgid "weak mixed alcohol"
msgid_plural "weak mixed alcohol"
msgstr[0] "mezcla suave de alcohol"
msgstr[1] "mezcla suave de alcohol"
msgstr[2] "mezcla suave de alcohol"

#. ~ Description of "weak mixed alcohol"
#: data/json/items/comestibles/alcohol.json
msgid "Weak alcoholic drinks, mixed with no regard for taste."
msgstr "Bebidas alcohólicas suaves, mezcladas con ningún sentido del gusto."

#. ~ Item name
#: data/json/items/comestibles/alcohol.json
msgid "fruit wine"
msgid_plural "fruit wine"
msgstr[0] "vino frutal"
msgstr[1] "vino frutal"
msgstr[2] "vino frutal"

#. ~ Description of "fruit wine"
#: data/json/items/comestibles/alcohol.json
msgid ""
"Cheap booze made from fermented fruit juice.  Tastes as good as it sounds."
msgstr ""
"Bebida barata hecha con zumo de fruta fermentado. Sabe tan bien como suena."

#. ~ Item name
#: data/json/items/comestibles/alcohol.json
msgid "brandy"
msgid_plural "brandy"
msgstr[0] "brandy"
msgstr[1] "coñac"
msgstr[2] "coñac"

#. ~ Description of "brandy"
#: data/json/items/comestibles/alcohol.json
msgid ""
"Wine that has been distilled to a higher proof.  Great as an after-dinner "
"drink, but packs a punch."
msgstr ""
"Vino que ha sido destilado a mayor grado. Muy bueno como bebida para después"
" de cenar, pero pega fuerte."

#. ~ Item name
#: data/json/items/comestibles/alcohol.json
msgid "Queen Mary cocktail"
msgid_plural "Queen Mary cocktail"
msgstr[0] "Cóctel Queen Mary"
msgstr[1] "Cóctel Queen Mary"
msgstr[2] "Cóctel Queen Mary"

#. ~ Description of "Queen Mary cocktail"
#: data/json/items/comestibles/alcohol.json
msgid "A cocktail made by mixing beer and grenadine syrup.  It's quite sweet."
msgstr ""
"Un cóctel elaborado con la mezcla de cerveza y jarabe de granadina. Es "
"bastante dulce."

#. ~ Item name
#: data/json/items/comestibles/alcohol.json
msgid "Irish coffee"
msgid_plural "Irish coffee"
msgstr[0] "cafe Irlandés"
msgstr[1] "cafe Irlandés"
msgstr[2] "cafe Irlandés"

#. ~ Description of "Irish coffee"
#: data/json/items/comestibles/alcohol.json
msgid ""
"Sweetened coffee and whiskey topped with milk.  Start your day the closeted "
"alcoholic way!"
msgstr ""
"Café dulce con whisky con un poco de leche. ¡Empieza tu día como un "
"alcohólico oculto!"

#. ~ Item name
#: data/json/items/comestibles/alcohol.json
msgid "karsk"
msgid_plural "karsk"
msgstr[0] "karsk"
msgstr[1] "karsk"
msgstr[2] "karsk"

#. ~ Description of "karsk"
#: data/json/items/comestibles/alcohol.json
msgid ""
"A cocktail made by mixing coffee and pure alcohol, typically moonshine, "
"originating from Scandinavia.  Sometimes sugar is also added."
msgstr ""
"Cóctel que se elabora mezclando café y alcohol puro, normalmente moonshine, "
"originario de Escandinavia. A veces se añade también azúcar."

#. ~ Item name
#: data/json/items/comestibles/alcohol.json
msgid "gunfire cocktail"
msgid_plural "gunfire cocktail"
msgstr[0] "cóctel gunfire"
msgstr[1] "cóctel gunfire"
msgstr[2] "cóctel gunfire"

#. ~ Description of "gunfire cocktail"
#: data/json/items/comestibles/alcohol.json
msgid ""
"A cocktail made by mixing black tea and rum, which has its origins in the "
"British Army."
msgstr ""
"Un cóctel elaborado mediante la mezcla de té negro y ron, que tiene su "
"origen en el ejército británico."

#. ~ Includes cola, so presumed to be a 250mL cocktail like the others.
#. ~ Item name
#: data/json/items/comestibles/alcohol.json
msgid "Long Island iced tea"
msgid_plural "Long Island iced tea"
msgstr[0] "té helado Long Island"
msgstr[1] "té helado Long Island"
msgstr[2] "té helado Long Island"

#. ~ Includes cola, so presumed to be a 250mL cocktail like the others.
#. ~ Description of "Long Island iced tea"
#: data/json/items/comestibles/alcohol.json
msgid ""
"A blend of incredibly strong-flavored liquors that somehow tastes like none "
"of them.  It contains no tea, but the inclusion of cola gives it a tea-like "
"color."
msgstr ""
"Una mezcla de licores de sabor increíble y fuerte, que de alguna manera, "
"termina no teniendo el gusto de ninguno de ellos. No contiene te, pero la "
"inclusión de bebida de cola le da ese color parecido al té."

#. ~ Item name
#: data/json/items/comestibles/alcohol.json
msgid "screwdriver cocktail"
msgid_plural "screwdriver cocktail"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. ~ Description of "screwdriver cocktail"
#: data/json/items/comestibles/alcohol.json
msgid ""
"A mix of orange juice and vodka.  It's the surreptitious drunkard mechanic's"
" drink of choice.  A similar drink may be made by substituting cranberry "
"juice for orange juice."
msgstr ""
"Una mezcla de zumo de naranja y vodka. Es la bebida preferida de los "
"mecánicos borrachos subrepticios. Se puede hacer una bebida similar "
"sustituyendo el zumo de naranja por zumo de arándanos."

#. ~ Conditional name for "screwdriver cocktail" when COMPONENT_ID matches
#. cranberry_juice
#: data/json/items/comestibles/alcohol.json
msgid "vodka cranberry"
msgid_plural "vodka cranberry"
msgstr[0] "vodka arándano"
msgstr[1] "vodka arándano"
msgstr[2] "vodka arándano"

#. ~ Item name
#: data/json/items/comestibles/alcohol.json
msgid "wild apple"
msgid_plural "wild apple"
msgstr[0] "manzana salvaje"
msgstr[1] "manzana salvaje"
msgstr[2] "manzana salvaje"

#. ~ Description of "wild apple"
#: data/json/items/comestibles/alcohol.json
msgid "Like apple cider, only with vodka."
msgstr "Como la sidra de manzana, pero con vodka."

#. ~ Item name
#: data/json/items/comestibles/alcohol.json
msgid "rum & cola"
msgid_plural "rum & cola"
msgstr[0] "cubata"
msgstr[1] "cubata"
msgstr[2] "cubata"

#. ~ Description of "rum & cola"
#: data/json/items/comestibles/alcohol.json
msgid ""
"Suitable for tropical retreats and Canadian artists alike.  In certain "
"variants, whiskey or sake is substituted for rum."
msgstr ""
