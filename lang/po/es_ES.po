msgid ""
"Some ropes with weights, designed to tangle the legs of a target when "
"thrown, usually at an animal.  Used by the Gauchos of Argentina."
msgstr ""
"Cuerdas con pesos, diseñadas para enredarse en las patas de un objetivo "
"cuando se lanzan, generalmente un animal. Utilizadas por los Gauchos de "
"Argentina."

#. ~ Item name
#: data/json/items/ranged/throwing.json
msgid "disc"
msgid_plural "discs"
msgstr[0] "disco"
msgstr[1] "discos"
msgstr[2] "discos"

#. ~ Description of "disc"
#: data/json/items/ranged/throwing.json
msgid ""
"A plastic disc made for playing disc golf.  It is smaller and denser than a "
"normal frisbee."
msgstr ""
"Un disco de plástico para jugar al golf disco. Es más pequeño y más denso "
"que un frisbi normal."

#. ~ Item name
#: data/json/items/ranged/throwing.json
msgid "frisbee"
msgid_plural "frisbees"
msgstr[0] "frisbee"
msgstr[1] "frisbees"
msgstr[2] "frisbees"

#. ~ Description of "frisbee"
#: data/json/items/ranged/throwing.json
msgid "A plastic frisbee made for outdoor games."
msgstr "Un frisbee de plástico hecho para juegos al aire libre."

#. ~ Item name
#: data/json/items/ranged/throwing.json
msgid "net"
msgid_plural "nets"
msgstr[0] "red"
msgstr[1] "redes"
msgstr[2] "redes"

#. ~ Description of "net"
#: data/json/items/ranged/throwing.json
msgid ""
"A mesh of string and weights, traditionally used to catch fish and to "
"entangle opponents in combat."
msgstr ""
"Una malla de cuerdas y pesos, tradicionalmente utilizada para pescar y para "
"atrapar oponentes en combate."

#. ~ Item name
#: data/json/items/ranged/throwing.json
msgid "lawn dart"
msgid_plural "lawn darts"
msgstr[0] "dardo de plástico"
msgstr[1] "dardos de plástico"
msgstr[2] "dardos de plástico"

#. ~ Description of "lawn dart"
#: data/json/items/ranged/throwing.json
msgid "A large plastic dart made for outdoor games."
msgstr "Un dardo largo de plástico para deportes al aire libre."

#. ~ These are plumbatae, but that's probably not a well known word.
#. ~ Item name
#: data/json/items/ranged/throwing.json
msgid "weighted dart"
msgid_plural "weighted darts"
msgstr[0] "dardo pesado"
msgstr[1] "dardos pesados"
msgstr[2] "dardos pesados"

#. ~ These are plumbatae, but that's probably not a well known word.
#. ~ Description of "weighted dart"
#: data/json/items/ranged/throwing.json
msgid "A lead weighted dart for throwing at enemies, like the Romans used."
msgstr ""
"Un dardo pesado de plomo para tirarle a los enemigos, como los usaban los "
"romanos."

#. ~ Item name
#: data/json/items/ranged/throwing.json
msgid "throwing axe"
msgid_plural "throwing axes"
msgstr[0] "hacha arrojadiza"
msgstr[1] "hachas arrojadizas"
msgstr[2] "hachas arrojadizas"

#. ~ Description of "throwing axe"
#: data/json/items/ranged/throwing.json
msgid ""
"A lightweight hatchet made for throwing.  Its ineffective cutting edge and "
"light weight make it unsuitable for use as a tool."
msgstr ""
"Una hacha ligera hecha para ser lanzada. No tiene buen filo y su poco peso "
"la hace inservible como herramienta."

#. ~ Item name
#. ~ Make silver-steel or some kind of changeling metal.
#: data/json/items/ranged/throwing.json
#: data/mods/Xedra_Evolved/items/ammo.json
msgid "throwing knife"
msgid_plural "throwing knives"
msgstr[0] "cuchillo arrojadizo"
msgstr[1] "cuchillos arrojadizos"
msgstr[2] "cuchillos arrojadizos"

#. ~ Description of "throwing knife"
#: data/json/items/ranged/throwing.json
msgid ""
"A thin, flat knife made for throwing.  Its ineffective cutting edge and odd "
"shape make it unsuitable for use as a tool."
msgstr ""
"Un cuchillo delgado y plano hecho para ser arrojado. No tiene buen filo y su"
" extraña forma lo hace inservible como herramienta."

#. ~ Item name
#: data/json/items/ranged/throwing.json
msgid "throwing stick"
msgid_plural "throwing sticks"
msgstr[0] "palo arrojadizo"
msgstr[1] "palos arrojadizos"
msgstr[2] "palos arrojadizos"

#. ~ Description of "throwing stick"
#: data/json/items/ranged/throwing.json
msgid ""
"A stick carved into a shape suitable for throwing at a target.  It's not a "
"boomerang, so don't expect it to return to your hand."
msgstr ""
"Un palo tallado con una forma adecuada para ser lanzado. No es un bumerang, "
"así que no esperes que vuelva a tus manos."

#. ~ Had to mess with the weight and volume to get the right range, 17-18
#. tiles. They also have wide-bladed heads, instead of points, so cut damage.
#. ~ Item name
#: data/json/items/ranged/throwing.json
msgid "iron war dart"
msgid_plural "iron war darts"
msgstr[0] "dardo de hierro de guerra"
msgstr[1] "dardos de hierro de guerra"
msgstr[2] "dardos de hierro de guerra"

#. ~ Had to mess with the weight and volume to get the right range, 17-18
#. tiles. They also have wide-bladed heads, instead of points, so cut damage.
#. ~ Description of "iron war dart"
#: data/json/items/ranged/throwing.json
msgid ""
"An iron-tipped fletched throwing spear with a throwing loop for extra range."
msgstr ""
"Un dardo emplumado con la punta de hierro y un accesorio que le da mayor "
"alcance."

#. ~ Item name
#: data/json/items/ranged/throwing.json
msgid "bronze war dart"
msgid_plural "bronze war darts"
msgstr[0] "dardo de bronce de guerra"
msgstr[1] "dardos de bronce de guerra"
msgstr[2] "dardos de bronce de guerra"

#. ~ Description of "bronze war dart"
#: data/json/items/ranged/throwing.json
msgid ""
"A bronze-tipped fletched throwing spear with a throwing loop for extra "
"range."
msgstr ""
"Un dardo emplumado con la punta de hierro y un accesorio que le da mayor "
"alcance."

#. ~ Item name
#: data/json/items/relics/altered_items.json
msgid "exposed-wiring prototype"
msgid_plural "exposed-wiring prototypes"
msgstr[0] "prototipo de cableado expuesto"
msgstr[1] "prototipos de cableado expuesto"
msgstr[2] "prototipos de cableado expuesto"

#. ~ Description of "exposed-wiring prototype"
#: data/json/items/relics/altered_items.json
msgid ""
"Some kind of prototypical electronic device with exposed wiring.  Some of "
"the wires have bare ends that could be connected together."
msgstr ""
"Una especie de prototipo de dispositivo electrónico con el cableado "
"expuesto. Algunos de los cables tienen extremos desnudos que podrían "
"conectarse entre sí."

#. ~ Item name
#: data/json/items/relics/altered_items.json
msgid "Bakelite phone"
msgid_plural "Bakelite phones"
msgstr[0] "Teléfono Bakelite"
msgstr[1] "Teléfonos Bakelite"
msgstr[2] "Teléfonos Bakelite"

#. ~ Description of "Bakelite phone"
#: data/json/items/relics/altered_items.json
msgid ""
"A vintage, bright-red Bakelite phone of famous Swedish design.  It would "
"look almost normal, if not for the fact that its rotary dial has been "
"replaced with a doorknob."
msgstr ""
"Un antiguo teléfono de Bakelite de color rojo brillante de famoso diseño "
"sueco. Se vería casi normal, si no fuera por el hecho de que su dial "
"giratorio ha sido reemplazado por un pomo de puerta."

#. ~ Item name
#: data/json/items/relics/altered_items.json
msgid "golden comb"
msgid_plural "golden combs"
msgstr[0] "peine dorado"
msgstr[1] "peines dorados"
msgstr[2] "peines dorados"

#. ~ Description of "golden comb"
#: data/json/items/relics/altered_items.json
msgid ""
"A small, delicate golden comb.  It was once carefully engraved, but time has"
" smoothed its designs to illegibility."
msgstr ""
"Un pequeño y delicado peine dorado. Antes tenia un cuidadoso grabado, pero "
"el tiempo ha difuminado sus diseños hasta hacerlos ilegibles."

#. ~ Item name
#: data/json/items/relics/altered_items.json
msgid "shifting keyring"
msgid_plural "shifting keyrings"
msgstr[0] "anillo de llave"
msgstr[1] "anillos de llave"
msgstr[2] "anillos de llave"

#. ~ Description of "shifting keyring"
#: data/json/items/relics/altered_items.json
msgid ""
"A smooth ring of steel, heavy under the weight of numerous keys.  The "
"designs of the keys change over time, but none will fit any keyhole you have"
" ever found."
msgstr ""
"Un suave anillo de acero, pesado bajo el peso de numerosas llaves. Los "
"diseños de las llaves cambian con el tiempo, pero ninguna encajará en "
"ninguna cerradura que hayas encontrado."

#. ~ Item name
#: data/json/items/relics/altered_items.json
msgid "engraved cube"
msgid_plural "engraved cubes"
msgstr[0] "cubo gravado"
msgstr[1] "cubos gravados"
msgstr[2] "cubos gravados"

#. ~ Description of "engraved cube"
#: data/json/items/relics/altered_items.json
msgid ""
"A small cube of smooth rock.  A uniform grid of nine squares is engraved in "
"each of its faces."
msgstr ""
"Un pequeño cubo de roca lisa. Una cuadrícula uniforme de nueve cuadrados "
"está grabada en cada una de sus caras."

#. ~ Item name
#: data/json/items/relics/altered_items.json
msgid "Utah teapot"
msgid_plural "Utah teapots"
msgstr[0] "tetera de Utah"
msgstr[1] "teteras de Utah"
msgstr[2] "teteras de Utah"

#. ~ Description of "Utah teapot"
#: data/json/items/relics/altered_items.json
msgid ""
"A squat teapot with a minimalist design.  Its surface shines under the glow "
"of unseen light sources."
msgstr ""
"Una tetera de pie con un diseño minimalista. Su superficie brilla bajo el "
"brillo de fuentes de luz no vistas."

#. ~ Item name
#: data/json/items/relics/altered_items.json
msgid "glitching stopwatch"
msgid_plural "glitching stopwatches"
msgstr[0] "cronómetro que falla"
msgstr[1] "cronómetros que fallan"
msgstr[2] "cronómetros que fallan"

#. ~ Description of "glitching stopwatch"
#: data/json/items/relics/altered_items.json
msgid ""
"A small digital stopwatch, looking slightly old by today's standards.  Its "
"digital display prints ever-changing gibberish."
msgstr ""
"Un pequeño cronómetro digital, que parece un poco viejo para los estándares "
"de hoy en día. Su pantalla digital imprime un galimatías siempre cambiante."

#. ~ Item name
#: data/json/items/relics/altered_items.json
msgid "Hawaiian shirt"
msgid_plural "Hawaiian shirts"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. ~ Description of "Hawaiian shirt"
#: data/json/items/relics/altered_items.json
msgid ""
"A slightly worn button-down shirt with a tropical pattern, straight out of "
"the 80's.  You swear that every time you look away and look back, the "
"pattern changes subtly."
msgstr ""

#. ~ Item name
#: data/json/items/relics/altered_items.json
msgid "defaced badge"
msgid_plural "defaced badges"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. ~ Description of "defaced badge"
#: data/json/items/relics/altered_items.json
msgid ""
"A strange golden badge in the shape of a shield with scratched out "
"lettering.  The faceless figures decorating the badge seem taller and "
"thinner than ordinary humans."
msgstr ""

#. ~ Item name
#: data/json/items/relics/altered_items.json
msgid "pair of strange sunglasses"
msgid_plural "pairs of strange sunglasses"
msgstr[0] "par de gafas de sol extrañas"
msgstr[1] "pares de gafas de sol extrañas"
msgstr[2] "pares de gafas de sol extrañas"

#. ~ Description of "pair of strange sunglasses"
#: data/json/items/relics/altered_items.json
msgid ""
"A pair of thin, round sunglasses.  The tinted glass seems to reflect the "
"same shade of baleful orange light no matter what light it reflects."
msgstr ""
"Un par de gafas de sol finas circulares. El cristal tintado parece reflejar "
"el mismo sombreado naranja funesto sin importar como refleje cualquier luz."

#. ~ Item name
#: data/json/items/relics/altered_items.json
msgid "pair of antique scissors"
msgid_plural "pairs of antique scissors"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. ~ Description of "pair of antique scissors"
#: data/json/items/relics/altered_items.json
msgid ""
"A pair of ornately decorated steel scissors.  The handle is decorated with "
"vicious-looking birds."
msgstr ""

#. ~ Item name
#: data/json/items/relics/altered_items.json
msgid "antique silver locket"
msgid_plural "antique silver lockets"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. ~ Description of "antique silver locket"
#: data/json/items/relics/altered_items.json
msgid ""
"A heart-shaped silver locket with an black-and-white image of a smiling "
"woman in it.  Her eyes seem to follow you whenever you look at it."
msgstr ""

#. ~ Description of "varsity jacket"
#: data/json/items/relics/altered_items.json
msgid ""
"A jacket traditionally worn by school athletes.  The logo of the school has "
"an oddly detailed fractal pattern that draws your eye in whenever you look "
"at it."
msgstr ""

#. ~ Item name
#: data/json/items/relics/altered_items.json
msgid "ambiguous apron"
msgid_plural "ambiguous aprons"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. ~ Description of "ambiguous apron"
#: data/json/items/relics/altered_items.json
msgid ""
"A long apron with a plain pattern on it.  Your eyes can't seem to decide "
"what color it is."
msgstr ""

#. ~ Item name
#: data/json/items/relics/monolith_items.json
msgid "inscribed disc"
msgid_plural "inscribed discs"
msgstr[0] "disco inscrito"
msgstr[1] "discos inscritos"
msgstr[2] "discos inscritos"

#. ~ Description of "inscribed disc"
#: data/json/items/relics/monolith_items.json
msgid ""
"A thin, palm-sized disc of incredibly dense stone, engraved with meaningless"
" swirls.  Its surface seems to repel grime and debris, and it refuses to "
"tarnish or scratch."
msgstr ""
"Un disco fino del tamaño de una mano hecho de una piedra increíblemente "
"densa, grabada con unos garabatos sin sentido. Su superficie parece repeler "
"mugre, escombros y se niega a mancharse o rayarse."

#. ~ Item name
#: data/json/items/relics/monolith_items.json
msgid "warped brick"
msgid_plural "warped bricks"
msgstr[0] "ladrillo retorcido"
msgstr[1] "ladrillos retorcidos"
msgstr[2] "ladrillos retorcidos"

#. ~ Description of "warped brick"
#: data/json/items/relics/monolith_items.json
msgid ""
"This brick of too-dense stone is warped in a way that just barely makes it "
"worthless as a building material.  Its smooth surface is unmarred by "
"texture, dirt, or color."
msgstr ""
"Este ladrillo es de una piedra muy densa y está retorcido de una manera que "
"apenas puede ser útil como material de construcción. Su superficie suave "
"está intacta de textura, tierra o color."

#. ~ Item name
#: data/json/items/resources/alien.json
msgid "alien resin chunk"
msgid_plural "alien resin chunks"
msgstr[0] "trozo de resina alienígena"
msgstr[1] "trozos de resina alienígena"
msgstr[2] "trozos de resina alienígena"

#. ~ Description of "alien resin chunk"
#: data/json/items/resources/alien.json
msgid ""
"A shattered fragment of alien resin.  It looks a bit like a large piece of "
"sea glass, frosted and gritty with the edges rounded off.  It is somewhat "
"warm to the touch."
msgstr ""
"Un fragmento destrozado de resina alienígena. Se parece un poco a un gran "
"trozo de cristal marino, escarchado y arenoso con los bordes redondeados. Es"
" algo cálido al tacto."

#. ~ Item name
#: data/json/items/resources/alien.json
msgid "alien resin pod"
msgid_plural "alien resin pods"
msgstr[0] "vaina de resina alienígena"
msgstr[1] "vainas de resina alienígena"
msgstr[2] "vainas de resina alienígena"

#. ~ Description of "alien resin pod"
#: data/json/items/resources/alien.json
msgid ""
"A large pod the size of a beer keg, filled with gooey alien resin.  "
"Squeezing it firmly causes resin to squirt from the broken stalk at the end,"
" hardening within a few seconds of being exposed to the air."
msgstr ""
"Una gran vaina, del tamaño de un barril, llena de resina alienígena "
"pegajosa. Al apretarla firmemente, la resina sale a chorros del tallo roto "
"del extremo, endureciéndose a los pocos segundos de ser expuesta al aire."

#. ~ Item name
#: data/json/items/resources/alien.json
msgid "alien fern branch"
msgid_plural "alien fern branches"
msgstr[0] "rama de helecho extraterrestre"
msgstr[1] "ramas de helecho extraterrestre"
msgstr[2] "ramas de helecho extraterrestre"

#. ~ Description of "alien fern branch"
#: data/json/items/resources/alien.json
msgid ""
"A branching trunk of leaves from a massive fern, about two feet long and a "
"couple of feet across in diameter when including the leaves.  Maybe one day "
"you'll think of something to make with a giant fern."
msgstr ""
"Un tronco con ramas y hojas de un mega helecho, de unos sesenta centímetros "
"de largo y sesenta de diámetro incluyendo las hojas. Tal vez algún día se te"
" ocurra qué hacer con un helecho gigante."

#. ~ Item name
#: data/json/items/resources/alien.json
msgid "Exodii chassis"
msgid_plural "Exodii chassis"
msgstr[0] "chasis Exodii"
msgstr[1] "chasis Exodii"
msgstr[2] "chasis Exodii"

#. ~ Description of "Exodii chassis"
#: data/json/items/resources/alien.json
msgid ""
"This roughly hexagonal frame and associated bodywork looks like it was "
"constructed as a single piece.  The fitting holes and attachments are "
"extremely durable, despite showing signs of heavy wear and repair.  The "
"structure is versatile, and could probably be engineered to serve a number "
"of different heavy combat roles."
msgstr ""
"Este chasis aproximadamente hexagonal y la carrocería asociada parece haber "
"sido construida como una sola pieza monolítica. Los agujeros de ajuste y los"
" accesorios son extremadamente duraderos, a pesar de mostrar signos de gran "
"desgaste y reparación. La estructura es versátil, y probablemente podría ser"
" diseñada para servir a un número de diferentes roles de combate pesado."

#. ~ Item name
#: data/json/items/resources/alien.json
msgid "Exodii drone chassis"
msgid_plural "Exodii drone chassis"
msgstr[0] "chasis de dron Exodii"
msgstr[1] "chasis de dron Exodii"
msgstr[2] "chasis de dron Exodii"

#. ~ Description of "Exodii drone chassis"
#: data/json/items/resources/alien.json
msgid ""
"This small, roughly hexagonal frame and associated bodywork looks like it "
"was constructed as a single piece.  The fitting holes and attachments are "
"extremely durable, despite showing signs of heavy wear and repair.  The "
"structure is versatile, and could probably be engineered to serve a number "
"of different heavy combat roles."
msgstr ""
"Este pequeño chasis aproximadamente hexagonal y la carrocería asociada "
"parece haber sido construida como una sola pieza monolítica. Los agujeros de"
" ajuste y los accesorios son extremadamente duraderos, a pesar de mostrar "
"signos de gran desgaste y reparación. La estructura es versátil, y "
"probablemente podría ser diseñada para servir a un número de diferentes "
"roles de combate pesado."

#. ~ Item name
#: data/json/items/resources/alien.json
msgid "cybernetic neural matrix"
msgid_plural "cybernetic neural matrices"
msgstr[0] "matrix neuronal cibernética"
msgstr[1] "matrices neuronales cibernéticas"
msgstr[2] "matrices neuronales cibernéticas"

#. ~ Description of "cybernetic neural matrix"
#: data/json/items/resources/alien.json
msgid ""
"A series of tanks and tubes with ports for fluids, electricity, and input "
"and output, this complex arrangement is made to house a brain and spine, and"
" the most difficult to replace organs for keeping them alive."
msgstr ""
"Una serie de tanques y tubos con puertos para fluidos, electricidad, entrada"
" y salida, este complejo arreglo está hecho para albergar un cerebro y una "
"columna vertebral y los órganos más difíciles de reemplazar para mantenerlos"
" vivos."

#. ~ Item name
#: data/json/items/resources/alien.json
msgid "unfamiliar electronic thingy"
msgid_plural "unfamiliar electronic thingies"
msgstr[0] "cosita electrónica desconocida"
msgstr[1] "cositas electrónicas desconocidas"
msgstr[2] "cositas electrónicas desconocidas"

#. ~ Description of "unfamiliar electronic thingy"
#: data/json/items/resources/alien.json
msgid ""
"The wiring and general shape suggest to you that this is a computer, or at "
"least some sort of electronic device, but what it is and what role it serves"
" is lost on you.  It's heavy and sturdy in construction."
msgstr ""
"El cableado y la forma general sugieren que se trata de un ordenador, o al "
"menos de algún tipo de dispositivo electrónico, pero lo que es y el papel "
"que cumple no lo conoces. Es pesado y robusto en su construcción."

#. ~ Item name
#: data/json/items/resources/alien.json
msgid "inscribed metal plates"
msgid_plural "inscribed metal plates"
msgstr[0] "placas de metal inscritas"
msgstr[1] "placas de metal inscritas"
msgstr[2] "placas de metal inscritas"

#. ~ Description of "inscribed metal plates"
#: data/json/items/resources/alien.json
msgid ""
"This device looks electronic, but is unfamiliar.  It is a series of tightly "
"fitted coppery-looking rings, set concentrically.  Wires run from each ring "
"to an axis in the middle."
msgstr ""
"Este dispositivo parece electrónico, pero no es familiar. Es una serie de "
"anillos de aspecto cobrizo ajustados, colocados concéntricamente. Los cables"
" van de cada anillo a un eje en el centro."

#. ~ Item name
#: data/json/items/resources/alien.json
msgid "small unfamiliar electronic thingy"
msgid_plural "small unfamiliar electronic thingies"
msgstr[0] "pequeña cosa rara electrónica"
msgstr[1] "pequeñas cosas raras electrónicas"
msgstr[2] "pequeñas cosas raras electrónicas"

#. ~ Description of "small unfamiliar electronic thingy"
#: data/json/items/resources/alien.json
msgid ""
"The wiring and general shape suggest to you that this is a tiny computer, or"
" at least some sort of electronic device, but what it is and what role it "
"serves is lost on you.  It's small enough to fit into your palm."
msgstr ""
"Los cables y su forma general te sugieren que esto es un ordenador pequeño "
"o, por lo menos, alguna clase de dispositivo electrónico pero no tienes ni "
"idea qué es y qué función tiene. Es lo suficientemente pequeño para caber en"
" tu mano."

#. ~ Item name
#: data/json/items/resources/alien.json
msgid "inscribed metal rings"
msgid_plural "inscribed metal rings"
msgstr[0] "anillo metálico inscrito"
msgstr[1] "anillos metálicos inscritos"
msgstr[2] "anillos metálicos inscritos"

#. ~ Description of "inscribed metal rings"
#: data/json/items/resources/alien.json
msgid ""
"This device looks electronic, but is unfamiliar.  It is a series of tightly "
"fitted coppery-looking nuts, set concentrically.  Wires run from each nut to"
" an axis in the middle."
msgstr ""
"Este dispositivo parece electrónico pero no sabes qué es. Es una serie "
"apretada de tuercas que parecen de cobre, puestos de manera concéntrica. Hay"
" cables que salen de cada anillo y van hacia el eje del medio."

#. ~ Item name
#: data/json/items/resources/alien.json
msgid "cybernetic sensor"
msgid_plural "cybernetic sensors"
msgstr[0] "sensor cibernético"
msgstr[1] "sensores cibernéticos"
msgstr[2] "sensores cibernéticos"

#. ~ Description of "cybernetic sensor"
#: data/json/items/resources/alien.json
msgid ""
"From the large glassy eye - the size of a small dinner plate - in the front,"
" you deduce this is some sort of camera.  None of the inner workings make "
"any sense to you nor resemble any camera you've seen before."
msgstr ""
"Del gran ojo vidrioso, del tamaño de un pequeño plato de comida, en el "
"frente, se deduce que es una especie de cámara. Ninguno de los mecanismos "
"internos tiene sentido para ti ni se parece a ninguna cámara que hayas visto"
" antes."

#. ~ Item name
#: data/json/items/resources/alien.json
msgid "rotary device"
msgid_plural "rotary devices"
msgstr[0] "dispositivo rotatorio"
msgstr[1] "dispositivos rotatorios"
msgstr[2] "dispositivos rotatorios"

#. ~ Description of "rotary device"
#: data/json/items/resources/alien.json
msgid ""
"You assume from the coils of coppery wire and the protruding piston that "
"this is some sort of motor or generator, but the design doesn't look similar"
" to anything you've seen before, and you can't figure out how to get it to "
"work."
msgstr ""
"Supones por las bobinas de alambre de cobre y el pistón saliente que se "
"trata de algún tipo de motor o generador, pero el diseño no se parece a nada"
" que hayas visto antes, y no puedes averiguar cómo hacer que funcione."

#. ~ Item name
#: data/json/items/resources/alien.json
msgid "engraved parabolic dish"
msgid_plural "engraved parabolic dishes"
msgstr[0] "plato parabólico grabado"
msgstr[1] "platos parabólicos grabados"
msgstr[2] "platos parabólicos grabados"

#. ~ Description of "engraved parabolic dish"
#: data/json/items/resources/alien.json
msgid ""
"This hefty parabolic dish is engraved with an unrecognizable pattern of "
"symbols that might, at a guess, be some sort of circuitry pattern - or maybe"
" a religious incantation."
msgstr ""
"Esta pesada parábola está grabada con un patrón irreconocible de símbolos "
"que podría ser, en una suposición, una especie de patrón de circuitos - o "
"tal vez un encantamiento religioso."

#. ~ Item name
#: data/json/items/resources/alien.json
msgid "oblong device"
msgid_plural "oblong devices"
msgstr[0] "dispositivo oblongo"
msgstr[1] "dispositivos oblongos"
msgstr[2] "dispositivos oblongos"

#. ~ Description of "oblong device"
#: data/json/items/resources/alien.json
msgid ""
"Perfectly smooth, cool to the touch, and a dull blue-gray color, this looks "
"almost like a perfect riverstone at first glance.  Its artificial nature is "
"betrayed upon closer inspection by a network of intricate patterns visible "
"as a slight difference in the reflection of light off its surface."
msgstr ""
"Perfectamente suave, frío al tacto y de un color azul grisáceo, a primera "
"vista parece casi una piedra de río perfecta. Su naturaleza artificial es "
"traicionada al inspeccionarla por una red de patrones intrincados visibles "
"como una leve diferencia en el reflejo de la luz en su superficie."

#. ~ Item name
#: data/json/items/resources/alien.json
msgid "enormous aluminum ingot"
msgid_plural "enormous aluminum ingots"
msgstr[0] "lingote de aluminio enorme"
msgstr[1] "lingotes de aluminio enormes"
msgstr[2] "lingotes de aluminio enormes"

#. ~ Description of "enormous aluminum ingot"
#: data/json/items/resources/alien.json
msgid "A block of pure aluminum at least as big as a dishwasher."
msgstr "Un bloque de aluminio puro al menos tan grande como un lavavajillas."

#. ~ Item name
#: data/json/items/resources/alien.json
msgid "enormous plastic block"
msgid_plural "enormous plastic blocks"
msgstr[0] "bloque de plástico enorme"
msgstr[1] "bloques de plástico enormes"
msgstr[2] "bloques de plástico enormes"

#. ~ Description of "enormous plastic block"
#: data/json/items/resources/alien.json
msgid ""
"A single enormous brick of plastic, big enough for you to curl up inside if "
"it were hollow."
msgstr ""
"Un enorme bloque de plástico, lo suficientemente grande como para poder "
"acurrucarse en su interior si estuviera hueco."

#. ~ Item name
#: data/json/items/resources/alien.json
msgid "enormous steel ingot"
msgid_plural "enormous steel ingots"
msgstr[0] "lingote de acero enorme"
msgstr[1] "lingotes de acero enormes"
msgstr[2] "lingotes de acero enormes"

#. ~ Description of "enormous steel ingot"
#: data/json/items/resources/alien.json
msgid "A monolithic block of high quality steel."
msgstr "Un bloque monolítico de acero de alta calidad."

#. ~ Item name
#: data/json/items/resources/alien.json
msgid "enormous tin ingot"
msgid_plural "enormous tin ingots"
msgstr[0] "lingote de estaño enorme"
msgstr[1] "lingotes de estaño enormes"
msgstr[2] "lingotes de estaño enormes"

#. ~ Description of "enormous tin ingot"
#: data/json/items/resources/alien.json
msgid "An enormous ingot of pure tin."
msgstr "Un enorme lingote de puro estaño."

#. ~ Item name
#: data/json/items/resources/alien.json
msgid "enormous copper ingot"
msgid_plural "enormous copper ingots"
msgstr[0] "lingote de cobre enorme"
msgstr[1] "lingotes de cobre enormes"
msgstr[2] "lingotes de cobre enormes"

#. ~ Description of "enormous copper ingot"
#: data/json/items/resources/alien.json
msgid "A massive solid piece of copper, covered by a blue-green patina."
msgstr ""
"Una pieza masiva y sólida de cobre, cubierta por una pátina azul verdosa."

#. ~ Item name
#: data/json/items/resources/alien.json
msgid "enormous zinc ingot"
msgid_plural "enormous zinc ingots"
msgstr[0] "lingote de zinc enorme"
msgstr[1] "lingotes de zinc enormes"
msgstr[2] "lingotes de zinc enormes"

#. ~ Description of "enormous zinc ingot"
#: data/json/items/resources/alien.json
msgid ""
"An absolutely massive block of pure zinc.  Bet you didn't expect that - "
"nobody expects zinc."
msgstr ""
"Un bloque absolutamente gigante de zinc puro. Apuesto a que no te lo "
"esperabas, nadie espera a zinc."

#. ~ Item name
#: data/json/items/resources/alien.json
msgid "enormous lead ingot"
msgid_plural "enormous lead ingots"
msgstr[0] "lingote de plomo enorme"
msgstr[1] "lingotes de plomo enormes"
msgstr[2] "lingotes de plomo enormes"

#. ~ Description of "enormous lead ingot"
#: data/json/items/resources/alien.json
msgid ""
"A block of lead so huge you don't even want to think about how heavy it is."
msgstr ""
"Un bloque de plomo tan grande que no quieres ni pensar en lo que pesa."

#. ~ Item name
#: data/json/items/resources/alien.json
msgid "CBM interface wire kit"
msgid_plural "CBM interface wire kits"
msgstr[0] "equipo de cables de interfaz MBC"
msgstr[1] "equipos de cables de interfaz MBC"
msgstr[2] "equipos de cables de interfaz MBC"

#. ~ Description of "CBM interface wire kit"
#: data/json/items/resources/alien.json
msgid ""
"A collection of hand-soldered wires leading to plugs and what looks like an "
"exotic micro controller.  The plugs look like they could be attached to you,"
" assuming you have an SNI (Standard Neurobionic Interface)."
msgstr ""
"Una colección de cables soldados a mano que conducen a enchufes y a lo que "
"parece un exótico microcontrolador. Los enchufes parece que podrían estar "
"conectados a ti, suponiendo que tengas una SNI (Standard Neurobionic "
"Interface)."

#. ~ Item name
#: data/json/items/resources/alien.json
msgid "external climate control kit"
msgid_plural "external climate control kits"
msgstr[0] "equipo de control externo de temperatura"
msgstr[1] "equipos de control externo de temperatura"
msgstr[2] "equipos de control externo de temperatura"

#. ~ Description of "external climate control kit"
#: data/json/items/resources/alien.json
msgid ""
"A collection of mismatched pipes, wires, and a central device that looks "
"like an exotic micro controller.  Almost looks like it could be used for "
"some form of central cooling."
msgstr ""
"Una colección de tubos, cables incompatibles y un dispositivo central que "
"parece ser un microcontrolador exótico. Casi parece que podría usarse como "
"alguna clase de enfriamiento central."

#. ~ Item name
#: data/json/items/resources/alien.json
msgid "woven metallics"
msgid_plural "woven metallics"
msgstr[0] "tejido metálico"
msgstr[1] "tejidos metálicos"
msgstr[2] "tejidos metálicos"

#. ~ Description of "woven metallics"
#: data/json/items/resources/alien.json
msgid ""
"Thin metallic strips with an ochre sheen, interlaid together into a flexible"
" mesh.  You can't tell whether it's a circuit, a heat dissipation component,"
" or a mechanical actuator."
msgstr ""
"Tiras finas metálicas con un brillo ocre entretejidas con una malla "
"flexible. No te das cuenta si es un circuito, un componente de disipación de"
" calor o un accionador mecánico."

#. ~ Item name
#: data/json/items/resources/alien.json
msgid "alien metal plating"
msgid_plural "alien metal plating"
msgstr[0] "placa metálica extraterrestre"
msgstr[1] "placas metálicas extraterrestres"
msgstr[2] "placas metálicas extraterrestres"

#. ~ Description of "alien metal plating"
#: data/json/items/resources/alien.json
msgid ""
"A slightly curved plate of white metal.  It readily collects low amounts of "
"static charge."
msgstr ""
"Una placa levemente curva de metal blanco. Fácilmente acumula pocas "
"cantidades de estática."

#. ~ Item name
#: data/json/items/resources/alien.json
msgid "alien metal scrap"
msgid_plural "alien metal scrap"
msgstr[0] "chatarra alienígena"
msgstr[1] "chatarras alienígenas"
msgstr[2] "chatarras alienígenas"

#. ~ Description of "alien metal scrap"
#: data/json/items/resources/alien.json
msgid ""
"A collection of tiny metal strips, spheres, and other geometric primitives "
"taken from a disassembled alien machine."
msgstr ""
"Una colección de pequeñas tiras, esferas y otros primitivas formas "
"geométricas de metal sacadas de una máquina extraterrestre desensamblada."

#. ~ Item name
#: data/json/items/resources/alien.json
msgid "monolithic machine"
msgid_plural "monolithic machine"
msgstr[0] "máquina monolítica"
msgstr[1] "máquinas monolíticas"
msgstr[2] "máquinas monolíticas"

#. ~ Description of "monolithic machine"
#: data/json/items/resources/alien.json
msgid ""
"A very heavy sphere, presumably made almost entirely of gold.  The complex "
"pattern etched across its surface implies that it might serve some exotic "
"function."
msgstr ""
"Una esfera muy pesada, presuntamente hecha completamente de oro. Una "
"superficie grabada de forma compleja implica que puede tener alguna función "
"exótica."

#. ~ Item name
#: data/json/items/resources/alien.json
msgid "robotic innards"
msgid_plural "robotic innards"
msgstr[0] "tripa robótica"
msgstr[1] "tripas robóticas"
msgstr[2] "tripas robóticas"

#. ~ Description of "robotic innards"
#: data/json/items/resources/alien.json
msgid ""
"A robotic assembly of unknown function.  Entirely made from tight-fitting "
"metal plates, it somewhat resembles the interior of a mechanical clock."
msgstr ""
"Un ensamblaje robótico de función desconocida. Enteramente hecho de placas "
"metálicas, se parece al interior de un reloj mecánico."

#. ~ Item name
#: data/json/items/resources/alien.json
msgid "sensor assembly"
msgid_plural "sensor assembly"
msgstr[0] "ensamblaje de sensor"
msgstr[1] "ensamblaje de sensores"
msgstr[2] "ensamblaje de sensores"

#. ~ Description of "sensor assembly"
#: data/json/items/resources/alien.json
msgid ""
"A carved sphere embedded with small black glass screens.  It's probably a "
"sensor of some kind."
msgstr ""

#. ~ Item name
#: data/json/items/resources/appliance_parts.json
msgid "dismantled stovetop"
msgid_plural "dismantled stovetops"
msgstr[0] "parte superior de cocina desmantelada"
msgstr[1] "parte superior de cocinas desmanteladas"
msgstr[2] "parte superior de cocinas desmanteladas"

#. ~ Description of "dismantled stovetop"
#: data/json/items/resources/appliance_parts.json
msgid ""
"The dismantled stovetop of an electric oven.  Some electric components are "
"still attached, but the heating elements have been pulled off."
msgstr ""
"La cocina desmontada de un horno eléctrico. Algunos componentes eléctricos "
"siguen unidos, pero los elementos de calentamiento han sido arrancados."

#. ~ Item name
#: data/json/items/resources/appliance_parts.json
msgid "stripped oven cabinet"
msgid_plural "stripped oven cabinets"
msgstr[0] "carcasa de horno destripada"
msgstr[1] "carcasas de hornos destripadas"
msgstr[2] "carcasas de hornos destripadas"

#. ~ Description of "stripped oven cabinet"
#: data/json/items/resources/appliance_parts.json
msgid ""
"A large, hefty steel box that was once the main body of an electric oven.  "
"Most of the parts have been stripped.  It could be further disassembled into"
" base materials."
msgstr ""
"Una gran caja de acero que en su día fue el cuerpo principal de un horno "
"eléctrico. La mayoría de las piezas han sido desmontadas. Se podría seguir "
"desmontando en materiales básicos."

#. ~ Item name
#: data/json/items/resources/appliance_parts.json
msgid "oven control panel"
msgid_plural "oven control panels"
msgstr[0] "panel del control de horno"
msgstr[1] "paneles del control de horno"
msgstr[2] "paneles del control de horno"

#. ~ Description of "oven control panel"
#: data/json/items/resources/appliance_parts.json
msgid "The control panel and LCD from a dismantled electric oven."
msgstr ""
"El panel de control y la pantalla LCD de un horno eléctrico desmontado."

#. ~ Item name
#: data/json/items/resources/appliance_parts.json
msgid "oven door"
msgid_plural "oven doors"
msgstr[0] "puerta de horno"
msgstr[1] "puertas de horno"
msgstr[2] "puertas de horno"

#. ~ Description of "oven door"
#: data/json/items/resources/appliance_parts.json
msgid "The removed glass and steel door of an electric oven."
msgstr "La puerta de cristal y acero retirada de un horno eléctrico."

#. ~ Item name
#: data/json/items/resources/appliance_parts.json
msgid "broiler pan"
msgid_plural "broiler pans"
msgstr[0] "parrillas de asar de horno"
msgstr[1] "parrillas de asar de horno"
msgstr[2] "parrillas de asar de horno"

#. ~ Description of "broiler pan"
#: data/json/items/resources/appliance_parts.json
msgid ""
"A simple sheet metal drawer that goes in the bottom of an electric oven."
msgstr "Un simple cajón de chapa que va en el fondo de un horno eléctrico."

#. ~ Item name
#: data/json/items/resources/chemicals.json
msgid "potassium alum"
msgid_plural "potassium alum"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. ~ Description of "potassium alum"
#: data/json/items/resources/chemicals.json
msgid ""
"A handful of small, water-soluble white crystals with a watery metallic "
"odor, historically used for many different purposes.  Also known as potash "
"alum and potassium aluminum sulfate; often called simply alum, as it's the "
"most important member of the generic class of compounds called alums."
msgstr ""
"Un puñado de pequeños cristales blancos solubles en agua con olor metálico "
"acuoso, históricamente utilizados para muchos propósitos diferentes. También"
" conocido como alumbre de potasa y sulfato de aluminio y potasio; a menudo "
"llamado simplemente alumbre, ya que es el miembro más importante de la clase"
" genérica de compuestos llamados alumbre."

#. ~ Item name
#: data/json/items/resources/chemicals.json
msgid "cloth dye powder"
msgid_plural "cloth dye powder"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. ~ Description of "cloth dye powder"
#: data/json/items/resources/chemicals.json
msgid ""
"A handful of powdered colorful cloth dye, which can be used to dye many "
"fabrics if combined with water and some mordant."
msgstr ""
"Un puñado de colorante en polvo para telas, que puede utilizarse para teñir "
"muchas telas si se combina con agua y algún mordiente (sustancia para fijar "
"colores en la ropa)."

#. ~ Item name
#: data/json/items/resources/chemicals.json
msgid "calcium chloride"
msgid_plural "calcium chloride"
msgstr[0] "cloruro de calcio"
msgstr[1] "cloruros de calcio"
msgstr[2] "cloruros de calcio"

#. ~ Description of "calcium chloride"
#: data/json/items/resources/chemicals.json
msgid ""
"A handful of white, odorless, strongly hygroscopic powder with an extremely "
"salty taste.  Often used as a de-icing agent or as dessicant."
msgstr ""
"Un puñado de polvo blanco inodoro fuertemente higroscópico con un sabor "
"extremadamente salado. A menudo se utiliza como agente anticongelante o "
"desecante."

#. ~ Item name
#: data/json/items/resources/chemicals.json
msgid "washing soda"
msgid_plural "washing soda"
msgstr[0] "carbonato de sodio"
msgstr[1] "carbonatos de sodio"
msgstr[2] "carbonatos de sodio"

#. ~ Description of "washing soda"
#: data/json/items/resources/chemicals.json
msgid ""
"A handful of white, odorless, hygroscopic powder.  Often used as a cleansing"
" agent and for glass manufacturing, among other things.  Also known as "
"sodium carbonate or soda ash."
msgstr ""
"Un puñado de polvo higroscópico blanco inodoro. Se utiliza comúnmente como "
"producto de limpieza y en la fabricación de vidrio, entre otras cosas. "
"También conocido como carbonato de sodio o ceniza de soda."

#. ~ Item name
#: data/json/items/resources/chemicals.json
msgid "baking soda"
msgid_plural "baking soda"
msgstr[0] "bicarbonato de sodio"
msgstr[1] "bicarbonatos de sodio"
msgstr[2] "bicarbonatos de sodio"

#. ~ Description of "baking soda"
#: data/json/items/resources/chemicals.json
msgid ""
"A handful of white, odorless powder with a slightly salty alkaline taste.  "
"Often used in baking as a leavening agent, and has many other niche uses.  "
"Also known as sodium bicarbonate."
msgstr ""
"Un puñado de polvo inodoro blanco con un leve sabor alcalino. Se utiliza "
"comúnmente en la cocina como agente gasificante aunque tiene muchos otros "
"usos mas minoritarios. También se lo conoce como bicarbonato de soda."

#. ~ Item name
#: data/json/items/resources/chemicals.json
msgid "mercury"
msgid_plural "mercury"
msgstr[0] "mercurio"
msgstr[1] "mercurio"
msgstr[2] "mercurio"

#. ~ Description of "mercury"
#: data/json/items/resources/chemicals.json
msgid ""
"Elemental mercury, unique in that it is a liquid under normal temperatures "
"and pressures.  Known for its use in thermometers."
msgstr ""
"Mercurio líquido elemental, único en cuanto a su normalidad con temperaturas"
" y presiones normales. Conocido por ser usado en los termómetros."

#. ~ density: 4.42 g/cm3
#. ~ Item name
#: data/json/items/resources/chemicals.json
msgid "mercury fulminate"
msgid_plural "mercury fulminate"
msgstr[0] "fulminato de mercurio"
msgstr[1] "fulminatos de mercurio"
msgstr[2] "fulminatos de mercurio"

#. ~ density: 4.42 g/cm3
#. ~ Description of "mercury fulminate"
#: data/json/items/resources/chemicals.json
msgid ""
"A handful of gray powder that is highly sensitive to friction, heat, and "
"shock.  Often used as a primary explosive, and historically in percussion "
"caps and primers for self-contained firearm ammunition."
msgstr ""
"Un puñado de polvo gris muy sensible a la fricción, calor y sacudidas. Se "
"utiliza comúnmente como explosivo e históricamente, en cápsulas fulminantes "
"e iniciadores de munición."

#. ~ Item name
#: data/json/items/resources/chemicals.json
msgid "sodium"
msgid_plural "sodium"
msgstr[0] "sodio"
msgstr[1] "sodios"
msgstr[2] "sodios"

#. ~ Description of "sodium"
#: data/json/items/resources/chemicals.json
msgid ""
"A chunk of sodium, a highly reactive soft gray metal, immersed in anhydrous "
"mineral oil to prevent it from oxidizing in the air during storage."
msgstr ""
"Un trozo de sodio, un metal suave gris muy reactivo, inmerso en aceite "
"mineral anhidro para prevenir que se oxide al aire mientras se almacena."

#. ~ Item name
#: data/json/items/resources/chemicals.json
msgid "potassium"
msgid_plural "potassium"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. ~ Description of "potassium"
#: data/json/items/resources/chemicals.json
msgid ""
"A chunk of potassium, a highly reactive soft gray metal, immersed in "
"anhydrous mineral oil to prevent it from oxidizing in the air during "
"storage."
msgstr ""

#. ~ density: 4.71 g/cm3
#. ~ Item name
#: data/json/items/resources/chemicals.json
msgid "lead azide"
msgid_plural "lead azide"
msgstr[0] "azida de plomo"
msgstr[1] "azidas de plomo"
msgstr[2] "azidas de plomo"

#. ~ density: 4.71 g/cm3
#. ~ Description of "lead azide"
#: data/json/items/resources/chemicals.json
msgid ""
"A handful of white powder that is used in detonators to detonate secondary "
"explosives.  It replaced mercury fulminate in modern ammunition primers."
msgstr ""
"Un puñado de polvo blanco que se utiliza en detonadores para explosivos "
"secundarios. Reemplazó al fulminato de mercurio en los iniciadores de las "
"municiones modernas."

#. ~ Item name
#: data/json/items/resources/fasteners.json
msgid "steel buckle"
msgid_plural "steel buckles"
msgstr[0] "hebilla de acero"
msgstr[1] "hebillas de acero"
msgstr[2] "hebillas de acero"

#. ~ Description of "steel buckle"
#: data/json/items/resources/fasteners.json
msgid "A steel buckle, like the kind usually found on belts."
msgstr "Hebilla de acero, como la que se suele encontrarse en los cinturones."

#. ~ Item name
#: data/json/items/resources/fasteners.json
msgid "plastic button"
msgid_plural "plastic buttons"
msgstr[0] "botón de plástico"
msgstr[1] "botones de plástico"
msgstr[2] "botones de plástico"

#. ~ Description of "plastic button"
#: data/json/items/resources/fasteners.json
msgid "A plastic button, usually found on clothing."
msgstr "Un botón de plástico, que normalmente se encuentra en la ropa."

#. ~ Item name
#: data/json/items/resources/fasteners.json
msgid "steel button"
msgid_plural "steel buttons"
msgstr[0] "botón de acero"
msgstr[1] "botones de acero"
msgstr[2] "botones de acero"

#. ~ Description of "steel button"
#: data/json/items/resources/fasteners.json
msgid "A steel button, usually found on clothing."
msgstr "Un botón de acero, que normalmente se encuentra en la ropa."

#. ~ Item name
#: data/json/items/resources/fasteners.json
msgid "bronze button"
msgid_plural "bronze buttons"
msgstr[0] "botón de bronce"
msgstr[1] "botones de bronce"
msgstr[2] "botones de bronce"

#. ~ Description of "bronze button"
#: data/json/items/resources/fasteners.json
msgid "A bronze button, found on ancient clothing."
msgstr "Un botón de bronce, se puede encontrar en ropa antigua."

#. ~ Item name
#: data/json/items/resources/fasteners.json
msgid "wooden button"
msgid_plural "wooden buttons"
msgstr[0] "botón de madera"
msgstr[1] "botones de madera"
msgstr[2] "botones de madera"

#. ~ Description of "wooden button"
#: data/json/items/resources/fasteners.json
msgid "A crude wooden button, usually found on very old clothing."
msgstr ""
"Un botón de madera tosco, que se encuentra generalmente en la ropa muy "
"vieja."

#. ~ Item name
#: data/json/items/resources/fasteners.json
msgid "steel snap fastener"
msgid_plural "steel snap fasteners"
msgstr[0] "cierre a presión de acero"
msgstr[1] "cierres a presión de acero"
msgstr[2] "cierres a presión de acero"

#. ~ Description of "steel snap fastener"
#: data/json/items/resources/fasteners.json
msgid "A steel snap fastener, usually found on clothing."
msgstr "Un cierre de presión de cero, usualmente encontrado en la ropa."

#. ~ Item name
#: data/json/items/resources/fasteners.json
msgid "touch fastener"
msgid_plural "touch fasteners"
msgstr[0] "velcro"
msgstr[1] "velcros"
msgstr[2] "velcros"

#. ~ Description of "touch fastener"
#: data/json/items/resources/fasteners.json
msgid ""
"A pair of cloth strips, one of which has tiny hooks and another with tiny "
"loops.  Useful as a fastener for clothing and footwear."
msgstr ""
"Un par de tiras de tela, una de las cuales tiene pequeños ganchos y otra "
"tiene pequeños bucles. Útiles como abrochadores para la ropa y el calzado."

#. ~ Item name
#: data/json/items/resources/fasteners.json
msgid "long plastic zipper"
msgid_plural "long plastic zippers"
