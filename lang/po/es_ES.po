msgstr ""

#. ~ Fairly controlled substance as they go.
#. ~ Item name
#: data/json/items/comestibles/med.json
msgid "oxycodone"
msgid_plural "oxycodone"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. ~ Fairly controlled substance as they go.
#. ~ Description of "oxycodone"
#: data/json/items/comestibles/med.json
msgid ""
"A strong semi-synthetic narcotic used in the treatment of intense pain.  "
"Highly addictive."
msgstr ""
"Un narcótico fuerte, semi-sintético que se utiliza en el tratamiento para el"
" dolor intenso. Muy adictivo."

#. ~ "activation_message" action message of item "oxycodone"
#: data/json/items/comestibles/med.json
msgid "You take some oxycodone."
msgstr "Te tomas una oxicodona."

#. ~ Item name
#: data/json/items/comestibles/med.json
msgid "sleeping pill"
msgid_plural "sleeping pills"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. ~ Description of "sleeping pill"
#: data/json/items/comestibles/med.json
msgid ""
"A habit-forming tranquilizer with a variety of psychoactive side effects.  "
"Used in the treatment of insomnia."
msgstr ""
"Un tranquilizante que crea hábito con una variedad de efectos secundarios "
"psicoactivos. Utilizado en el tratamiento del insomnio."

#. ~ Item name
#: data/json/items/comestibles/med.json
msgid "poppy painkiller"
msgid_plural "poppy painkiller"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. ~ Description of "poppy painkiller"
#: data/json/items/comestibles/med.json
msgid ""
"A potent opioid palliative produced by the refining of the mutated poppy.  "
"Notably devoid of euphoric or sedative effects, but as an opiate it can "
"still be addictive."
msgstr ""
"Paliativo opiáceo potente producido mediante la refinación de la amapola "
"mutada. Aunque carece de efectos eufóricos o sedantes, como opiáceo puede "
"ser adictivo."

#. ~ "activation_message" action message of item "poppy painkiller"
#: data/json/items/comestibles/med.json
msgid "You take some poppy painkiller."
msgstr "Te tomas un analgésico de amapola."

#. ~ Item name
#: data/json/items/comestibles/med.json
msgid "poppy sleep"
msgid_plural "poppy sleep"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. ~ Description of "poppy sleep"
#: data/json/items/comestibles/med.json
msgid ""
"A potent sleep aid extracted from mutated poppy seeds.  Effective, but as an"
" opiate it can be addictive."
msgstr ""
"Un somnífero potente extraído de semillas mutadas de amapola. Efectivas, "
"pero como es un opiáceo, puede ser adictivo."

#. ~ Item name
#: data/json/items/comestibles/med.json
msgid "poppy cough syrup"
msgid_plural "poppy cough syrup"
msgstr[0] "jarabe para la tos de amapola"
msgstr[1] "jarabes para la tos de amapola"
msgstr[2] "jarabes para la tos de amapola"

#. ~ Description of "poppy cough syrup"
#: data/json/items/comestibles/med.json
msgid "Cough syrup made from mutated poppy.  Will make you sleepy."
msgstr "Jarabe para la tos hecho de amapola mutada. Te va a dar sueño."

#. ~ Item name
#: data/json/items/comestibles/med.json
msgid "injectable prophylactic antivenom"
msgid_plural "injectable prophylactic antivenom"
msgstr[0] "antiveneno profiláctico inyectable"
msgstr[1] "antivenenos profilácticos inyectables"
msgstr[2] "antivenenos profilácticos inyectables"

#. ~ Description of "injectable prophylactic antivenom"
#: data/json/items/comestibles/med.json
msgid ""
"An experimental, cutting-edge antivenom in the form of a small amber vial, "
"designed to be injected a few hours before venom exposure.  It was developed"
" in top secret by the military in response to increasing biological/chemical"
" warfare."
msgstr ""
"Un antiveneno experimental de vanguardia en forma de pequeños frascos de "
"ámbar, diseñado para ser inyectado unas horas antes de la exposición al "
"veneno. Fue desarrollado en secreto por los militares en respuesta al "
"aumento de la guerra biológica/química."

#. ~ "activation_message" action message of item "injectable prophylactic
#. antivenom"
#: data/json/items/comestibles/med.json
msgid ""
"You inject a vial of prophylactic antivenom into your arm.  You feel a bit "
"queasy."
msgstr ""
"Te inyectas un vial de antiveneno profiláctico en el brazo. Te sientes un "
"poco mareado."

#. ~ Don't have a cite for this one.
#. ~ Item name
#: data/json/items/comestibles/med.json
msgid "antidepressant"
msgid_plural "antidepressant"
msgstr[0] "antidepresivo"
msgstr[1] "antidepresivo"
msgstr[2] "antidepresivo"

#. ~ Don't have a cite for this one.
#. ~ Description of "antidepressant"
#: data/json/items/comestibles/med.json
msgid ""
"A common and popular antidepressant.  It will elevate mood, and can "
"profoundly alter the effects of other drugs.  It is only rarely habit-"
"forming, though adverse reactions are not uncommon."
msgstr ""
"Un antidepresivo común y popular. Elevará el estado de ánimo, y puede "
"afectar profundamente la acción de otras drogas. Rara vez crea hábito, "
"aunque las reacciones adversas no son raras."

#. ~ Item name
#: data/json/items/comestibles/med.json
msgid "Prussian blue tablet"
msgid_plural "Prussian blue tablets"
msgstr[0] "comprimido de azul de Prusia"
msgstr[1] "comprimidos de azul de Prusia"
msgstr[2] "comprimidos de azul de Prusia"

#. ~ Description of "Prussian blue tablet"
#: data/json/items/comestibles/med.json
msgid ""
"A tablet containing oxidized ferrous ferrocyanide salts.  Capable of purging"
" nuclear contaminants from the body if taken after radiation exposure."
msgstr ""
"Un comprimido que contiene sales ferrocianuras ferrosas oxidadas.  Es capaz "
"de purgar del cuerpo los contaminantes nucleares si se toma después de la "
"exposición a la radiación."

#. ~ "activation_message" action message of item "Prussian blue tablet"
#: data/json/items/comestibles/med.json
msgid "You take some Prussian blue."
msgstr "Te tomas un comprimido azul de Prusia."

#. ~ Item name
#: data/json/items/comestibles/med.json
msgid "hemostatic powder"
msgid_plural "hemostatic powder"
msgstr[0] "polvo hemostático"
msgstr[1] "polvo hemostático"
msgstr[2] "polvo hemostático"

#. ~ Description of "hemostatic powder"
#: data/json/items/comestibles/med.json
msgid ""
"A powdered antihemorrhagic compound that reacts with blood to immediately "
"form a gel-like substance that stops bleeding."
msgstr ""
"Un compuesto antihemorrágico en polvo que reacciona ante la sangre para "
"formar inmediatamente una sustancia con consistencia de gel que detiene el "
"sangrado."

#. ~ Item name
#: data/json/items/comestibles/med.json
msgid "saline solution"
msgid_plural "saline solution"
msgstr[0] "solución salina"
msgstr[1] "solución salina"
msgstr[2] "solución salina"

#. ~ Description of "saline solution"
#: data/json/items/comestibles/med.json
msgid ""
"A solution of sterilized water and salt for intravenous infusion or washing "
"contaminants from one's eyes."
msgstr ""
"Una solución de agua esterilizada y sal para infusión intravenosa o para "
"limpiar de contaminantes los ojos."

#. ~ Item name
#: data/json/items/comestibles/med.json
msgid "antipsychotic"
msgid_plural "antipsychotic"
msgstr[0] "antipsicotico"
msgstr[1] "antipsicotico"
msgstr[2] "antipsicotico"

#. ~ Description of "antipsychotic"
#: data/json/items/comestibles/med.json
msgid ""
"Anti-psychotic medication.  Used to stabilize brain chemistry, it can arrest"
" hallucinations and other symptoms of psychosis.  Carries a sedative effect."
msgstr ""
"Medicamentos antipsicóticos. Utilizado para estabilizar la química cerebral,"
" puede detener las alucinaciones y otros síntomas de la psicosis. Tiene un "
"efecto sedante."

#. ~ Item name
#: data/json/items/comestibles/med.json
msgid "thyme oil"
msgid_plural "thyme oil"
msgstr[0] "aceite de tomillo"
msgstr[1] "aceites de tomillo"
msgstr[2] "aceites de tomillo"

#. ~ Description of "thyme oil"
#: data/json/items/comestibles/med.json
msgid ""
"Some essential oil made from thyme, which can act as a mildly irritating "
"antiseptic."
msgstr ""
"Un aceite esencial hecho de tomillo, que puede actuar como un antiséptico "
"ligeramente irritante."

#. ~ Item name
#: data/json/items/comestibles/med.json
msgid "rolling tobacco"
msgid_plural "rolling tobacco"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. ~ Description of "rolling tobacco"
#: data/json/items/comestibles/med.json
msgid ""
"Loose, fine-cut tobacco leaves.  Popular in Europe and among hipsters.  Highly addictive and hazardous to health.\n"
"Can either be rolled into a cigarette with some rolling papers or smoked through a pipe."
msgstr ""
"Hojas sueltas de tabaco de corte fino. Popular en Europa y entre los hipsters. Muy adictivo y dañino para la salud.\n"
"Con papel de liar se puede hacer un cigarrillo, o se pueden fumar con una pipa."

#. ~ "activation_message" action message of item "rolling tobacco"
#: data/json/items/comestibles/med.json
msgid "You smoke some tobacco."
msgstr "Fumas un poco de tabaco."

#. ~ Item name
#: data/json/items/comestibles/med.json
msgid "tramadol"
msgid_plural "tramadol"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. ~ Description of "tramadol"
#: data/json/items/comestibles/med.json
msgid ""
"A painkiller used to manage moderate pain.  The effects last for several "
"hours, but are relatively subdued for an opioid."
msgstr ""
"Un analgésico que se usa para controlar el dolor de intensidad media. Sus "
"efectos duran por varias horas, pero son bastante suaves para ser un "
"opiáceo."

#. ~ "activation_message" action message of item "tramadol"
#: data/json/items/comestibles/med.json
msgid "You take some tramadol."
msgstr "Te tomas un tramadol."

#. ~ Item name
#: data/json/items/comestibles/med.json
msgid "multivitamin"
msgid_plural "multivitamin"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. ~ Description of "multivitamin"
#: data/json/items/comestibles/med.json
msgid ""
"Essential dietary nutrients conveniently packaged in pill form.  An option "
"of last resort when a balanced diet is not possible.  Excess use can cause "
"hypervitaminosis."
msgstr ""
"Nutrientes dietarios esenciales, convenientemente agrupados en forma de "
"píldora. Una opción de último recurso cuando no se puede llevar una dieta "
"balanceada. Su exceso puede ocasionar hipervitaminosis."

#. ~ "activation_message" action message of item "multivitamin"
#. ~ "activation_message" action message of item "calcium tablet"
#. ~ "activation_message" action message of item "bone meal tablet"
#. ~ "activation_message" action message of item "flavored bone meal tablet"
#. ~ "activation_message" action message of item "wyld candy"
#: data/json/items/comestibles/med.json
#: data/mods/Xedra_Evolved/items/drugs.json
#, c-format
msgid "You take the %s."
msgstr "Te tomas una %s."

#. ~ Item name
#: data/json/items/comestibles/med.json
msgid "calcium tablet"
msgid_plural "calcium tablets"
msgstr[0] "comprimido de calcio"
msgstr[1] "comprimidos de calcio"
msgstr[2] "comprimidos de calcio"

#. ~ Description of "calcium tablet"
#: data/json/items/comestibles/med.json
msgid ""
"A white calcium tablet.  Widely used by elderly people with osteoporosis as "
"a method to supplement calcium before the apocalypse."
msgstr ""
"Un comprimido blanco de calcio.  Antes del apocalipsis era comúnmente usadao"
" por gente anciana con osteoporosis como una manera de suplementar el "
"calcio."

#. ~ Item name
#: data/json/items/comestibles/med.json
msgid "bone meal tablet"
msgid_plural "bone meal tablets"
msgstr[0] "comprimido de harina de huesos"
msgstr[1] "comprimidos de harina de huesos"
msgstr[2] "comprimidos de harina de huesos"

#. ~ Description of "bone meal tablet"
#: data/json/items/comestibles/med.json
msgid ""
"A homemade calcium supplement made out of bone meal.  Tastes horrible and is"
" hard to swallow but it does its job."
msgstr ""
"Suplemento de calcio casero hecho de harina de huesos. Sabe horrible y es "
"difícil de tragar, pero cumple su función."

#. ~ Item name
#: data/json/items/comestibles/med.json
msgid "flavored bone meal tablet"
msgid_plural "flavored bone meal tablets"
msgstr[0] "comprimido de harina de huesos con sabor"
msgstr[1] "comprimidos de harina de huesos con sabor"
msgstr[2] "comprimidos de harina de huesos con sabor"

#. ~ Description of "flavored bone meal tablet"
#: data/json/items/comestibles/med.json
msgid ""
"A homemade calcium supplement made out of bone meal.  Due to some sweeteners"
" mixed in to counteract the powdery texture and the taste of ash, it's "
"almost as palatable as the pre-Cataclysm tablets."
msgstr ""
"Un suplemento de calcio casero hecho de harina de hueso.  Debido a algún "
"endulzante que ha sido mezclado para contrarrestar la textura de polvo y el "
"gusto a ceniza, es casi tan apetitoso como una píldora de antes del "
"Cataclismo."

#. ~ Item name
#: data/json/items/comestibles/med.json
msgid "gummy vitamin"
msgid_plural "gummy vitamin"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. ~ Description of "gummy vitamin"
#: data/json/items/comestibles/med.json
msgid ""
"Essential dietary nutrients conveniently packaged in a fruit-flavored chewy "
"candy form.  An option of last resort when a balanced diet is not possible."
"  Excess use can cause hypervitaminosis."
msgstr ""
"Nutrientes dietéticos esenciales convenientemente envasados en forma de "
"caramelo masticable con sabor a fruta. Una opción de último recurso cuando "
"no es posible seguir una dieta equilibrada. Su uso excesivo puede causar "
"hipervitaminosis."

#. ~ Item name
#: data/json/items/comestibles/med.json
msgid "homeopathic pill"
msgid_plural "homeopathic pills"
msgstr[0] "pildora homeopática"
msgstr[1] "pildoras homeopáticas"
msgstr[2] "pildoras homeopáticas"

#. ~ Description of "homeopathic pill"
#: data/json/items/comestibles/med.json
msgid ""
"A homeopathic pill, prepared through the repeated dilution of an active "
"ingredient with water.  The label purports that these pills are able to "
"maintain general wellness."
msgstr ""
"Una píldora homeopática, preparada mediante la disolución repetida de un "
"ingrediente activo con agua. La etiqueta afirma que estas píldoras son "
"capaces de mantener el bienestar general."

#. ~ "activation_message" action message of item "homeopathic pill"
#: data/json/items/comestibles/med.json
#, c-format
msgid "You swallow the %s.  You wait in anticipation of its effects."
msgstr "Te tragas la %s. Esperas en anticipación sus efectos."

#. ~ Snippet of item "homeopathic pill"
#: data/json/items/comestibles/med.json
msgid ""
"An Oscillococcinum homeopathic pill, prepared through the dilution of one "
"part duck offal with 10^400 parts water.  The label purports that these "
"pills are able to treat flu-like symptoms and maintain general wellness."
msgstr ""
"Una pastilla homeopática Oscillococcinum, preparada a través de la "
"disolución de una parte de achuras de pato en 10^400 partes de agua. La "
"etiqueta afirma que esta pastilla es capaz de tratar los síntomas similares "
"a la gripe y mantener el bienestar general."

#. ~ Snippet of item "homeopathic pill"
#: data/json/items/comestibles/med.json
msgid ""
"An Arsenicum album homeopathic pill, prepared through the dilution of one "
"part arsenic trioxide with 10^24 parts water.  Purported to treat anxiety, "
"various digestive disorders, and arsenic poisoning."
msgstr ""
"Una pastilla homeopática Arsenicum, preparada a través de la disolución de "
"una parte de trióxido de arsénico en 10^24 partes de agua. Pensada para "
"tratar la ansiedad, varios desórdenes digestivos y el envenenamiento por "
"arsénico."

#. ~ Snippet of item "homeopathic pill"
#: data/json/items/comestibles/med.json
msgid ""
"An Allium cepa homeopathic pill, prepared through the dilution of one part "
"onion with 10^30 parts water.  The label states that these pills can "
"ameliorate symptoms of asthma, gastrointestinal disorders, and bronchitis.  "
"You briefly wonder if it can cure fungal infections."
msgstr ""
"Una pastilla homeopática Allium cepa, preparada a través de la disolución de"
" una parte de cebolla en 10^30 partes de agua. La etiqueta establece que "
"esta pastilla puede aliviar los síntomas del asma, desórdenes "
"gastrointestinales y bronquitis. Por un momento, te preguntas si curará las "
"infecciones fúngicas."

#. ~ Snippet of item "homeopathic pill"
#: data/json/items/comestibles/med.json
msgid ""
"An Arum tryphillum homeopathic pill, prepared through the dilution of the "
"jack-in-the-pulpit plant with 10^30 parts water.  The label claims that the "
"pills are able to treat voice loss."
msgstr ""
"Una pastilla homeopática Arum tryphillum, preparada a través de la "
"disolución de la planta Arisaema triphyllum en 10^400 partes de agua. La "
"etiqueta dice que la pastilla es capaz de tratar la pérdida de la voz."

#. ~ Snippet of item "homeopathic pill"
#: data/json/items/comestibles/med.json
msgid ""
"An Aesculus hippocastanum homeopathic pill, prepared through the dilution of"
" horse chestnut with 10^30 parts water.  These pills are meant to treat "
"dysentery and hemorrhoids."
msgstr ""
"Una pastilla homeopática Aesculus hippocastanum, preparada a través de la "
"disolución de castaña de Indias con 10^30 partes de agua. Se supone que esta"
" pastilla trata la disentería y las hemorroides."

#. ~ Snippet of item "homeopathic pill"
#: data/json/items/comestibles/med.json
msgid ""
"A Lachesis mutus pill, prepared through the dilution of the venom of the "
"bushmaster snake with 10^1000 parts water.  These pills are claimed to be an"
" effective treatment for sore throat."
msgstr ""
"Una pastilla Lachesis mutus, preparada a través de la disolución de veneno "
"de una víbora cascabel en 10^1000 partes de agua. Estas pastillas dicen ser "
"efectiva en el tratamiento del dolor de garganta."

#. ~ Item name
#: data/json/items/comestibles/med.json
msgid "injectable iron"
msgid_plural "injectable iron"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. ~ Description of "injectable iron"
#: data/json/items/comestibles/med.json
msgid ""
"A small vial of dark yellow liquid containing soluble iron for injection."
msgstr ""
"Pequeño vial de líquido amarillo oscuro que contiene hierro soluble "
"inyectable."

#. ~ "activation_message" action message of item "injectable iron"
#: data/json/items/comestibles/med.json
msgid "You inject some iron."
msgstr "Te inyectas un poco de hierro."

#. ~ Item name
#: data/json/items/comestibles/med.json
msgid "marijuana"
msgid_plural "marijuana"
msgstr[0] "marihuana"
msgstr[1] "marihuana"
msgstr[2] "marihuana"

#. ~ Description of "marijuana"
#: data/json/items/comestibles/med.json
msgid ""
"The dried flower buds and leaves harvested from a psychoactive variety of "
"hemp plant.  Used to reduce nausea, stimulate appetite and elevate mood.  It"
" can be habit-forming, and adverse reactions are possible."
msgstr ""
"Hojas y capullos secos de flores, de una variedad de la planta de cáñamo. "
"Utilizado para reducir las náuseas, estimular el apetito y mejorar el ánimo."
" Puede crear hábito y causar algunas reacciones adversas."

#. ~ "activation_message" action message of item "marijuana"
#: data/json/items/comestibles/med.json
msgid "You smoke some weed.  Good stuff, man!"
msgstr "Fumas un poco de marihuana. ¡Tío, buena cosa!"

#. ~ Yeah, kinda guessing at these ones, but generic is cheaper.
#. ~ Item name
#: data/json/items/comestibles/med.json
msgid "fast-acting sedative"
msgid_plural "fast-acting sedative"
msgstr[0] "sedante de acción rápida"
msgstr[1] "sedantes de acción rápida"
msgstr[2] "sedantes de acción rápida"

#. ~ Yeah, kinda guessing at these ones, but generic is cheaper.
#. ~ Description of "fast-acting sedative"
#: data/json/items/comestibles/med.json
msgid ""
"An anti-anxiety agent with a powerful sedative effect.  May cause "
"dissociation and loss of memory.  It is dangerously addictive, and "
"withdrawal from regular use should be gradual."
msgstr ""
"Agente antiansiedad con un poderoso efecto sedante. Puede causar disociación"
" y pérdida de memoria. Es peligrosamente adictivo, y para dejarlo debe "
"hacerse de forma gradual."

#. ~ Item name
#: data/json/items/comestibles/med.json
msgid "narrow-spectrum antibiotics"
msgid_plural "narrow-spectrum antibiotics"
msgstr[0] "antibiotico de espectro reducido"
msgstr[1] "antibioticos de espectro reducido"
msgstr[2] "antibioticos de espectro reducido"

#. ~ Description of "narrow-spectrum antibiotics"
#: data/json/items/comestibles/med.json
msgid ""
"A narrow-spectrum antibiotic used to suppress infections and prevent them "
"from spreading.  It isn't broad enough to purge most infections outright, "
"but it boosts the body's resistance against them.  One dose lasts twelve "
"hours."
msgstr ""
"Un antibiótico de espectro reducido que se utiliza para suprimir las "
"infecciones y evitar que se propaguen. No es lo suficientemente amplia como "
"para purgar la mayoría de las infecciones, pero aumenta la resistencia del "
"cuerpo contra ellas. Una dosis dura doce horas."

#. ~ Item name
#: data/json/items/comestibles/med.json
msgid "heartburn medicine"
msgid_plural "heartburn medicine"
msgstr[0] "medicina para la acidez estomacal"
msgstr[1] "medicina para la acidez estomacal"
msgstr[2] "medicina para la acidez estomacal"

#. ~ Description of "heartburn medicine"
#: data/json/items/comestibles/med.json
msgid ""
"Creamy pink heartburn syrup that soothes upset stomachs and quells vomitous "
"urges."
msgstr ""
"Jarabe cremoso y rosado para la acidez estomacal que alivia el malestar "
"estomacal y sofoca las ganas de vomitar."

#. ~ "activation_message" action message of item "heartburn medicine"
#: data/json/items/comestibles/med.json
msgid "You take some heartburn medicine."
msgstr "Tomas un poco de medicina para la acidez de estómago."

#. ~ Item name
#: data/json/items/comestibles/med.json
msgid "antacid tablet"
msgid_plural "antacid tablets"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. ~ Description of "antacid tablet"
#: data/json/items/comestibles/med.json
msgid ""
"A common stomach soother in flavored tablet form.  Makes you less likely to "
"vomit."
msgstr ""

#. ~ "activation_message" action message of item "antacid tablet"
#: data/json/items/comestibles/med.json
msgid "You take an antacid tablet."
msgstr ""

#. ~ Item name
#: data/json/items/comestibles/med.json
#: data/mods/Aftershock/items/comestibles/comestibles.json
msgid "Panaceus"
msgid_plural "Panaceii"
msgstr[0] "Panacea"
msgstr[1] "Panaceii"
msgstr[2] "Panaceii"

#. ~ Description of "Panaceus"
#: data/json/items/comestibles/med.json
msgid ""
"An apple-red gel capsule the size of your thumbnail, filled with a thick, "
"oily liquid that shifts from black to purple at unpredictable intervals, "
"flecked with tiny gray dots.  Given the place you got it from, it's either "
"very potent, or highly experimental.  Holding it, all the little aches and "
"pains seem to fade, just for a moment…"
msgstr ""
