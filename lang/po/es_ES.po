msgstr[2] "pan integral sin trigo"

#. ~ Description of "wheat-free brown bread"
#: data/json/items/comestibles/bread.json
msgid ""
"Sweet, wheat-free bread made with molasses, with a consistency closer to "
"cake."
msgstr ""
"Pan dulce sin gluten hecho con melaza, con una consistencia similar a una "
"torta."

#. ~ Item name
#: data/json/items/comestibles/bread.json
msgid "hallula"
msgid_plural "hallula"
msgstr[0] "hallula"
msgstr[1] "hallula"
msgstr[2] "hallula"

#. ~ Description of "hallula"
#: data/json/items/comestibles/bread.json
msgid ""
"A type of bread popular in Chile and Bolivia.  Prepared using animal lard or"
" oil, it resembles a large, round scone.  In the pre-Cataclysm world, it "
"would usually be filled with savory ingredients."
msgstr ""
"Un tipo de pan popular en Chile y Bolivia. Preparado con manteca de cerdo o "
"aceite, se parece a un bollo grande y redondo. En el mundo anterior al "
"cataclismo, se suele rellenar con ingredientes salados."

#. ~ Item name
#: data/json/items/comestibles/brewing.json
msgid "Mycus wine must"
msgid_plural "Mycus wine must"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. ~ Description of "Mycus wine must"
#: data/json/items/comestibles/brewing.json
msgid ""
"Unfermented Mycus wine.  A goopy white mess, made from Mycus fruit.  It "
"smells sweetly of mushrooms."
msgstr ""
"Vino de Mycus sin fermentar. Una blanca y pegajosa porquería, hecha de la "
"fruta de Mycus. Huele dulcemente a hongos."

#. ~ Item name
#: data/json/items/comestibles/brewing.json
msgid "Marloss wine must"
msgid_plural "Marloss wine must"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. ~ Description of "Marloss wine must"
#: data/json/items/comestibles/brewing.json
msgid ""
"Unfermented Marloss wine.  A soft pinkish mess, made from Marloss berries.  "
"It has a strong aroma, but you're not quite sure if it's a good or bad one."
msgstr ""
"Vino Marloss sin fermentar. Un suave lío rosado, hecho con bayas de Marloss."
" Tiene un fuerte aroma, pero no se sabe muy bien si es bueno o malo."

#. ~ Item name
#: data/json/items/comestibles/brewing.json
msgid "whiskey wort"
msgid_plural "whiskey wort"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. ~ Description of "whiskey wort"
#: data/json/items/comestibles/brewing.json
msgid ""
"Unfermented whiskey.  The base of a fine drink.  Not the traditional "
"preparation, but you don't have the time."
msgstr ""
"Whisky sin fermentar. La base de una buena bebida. No es la preparación "
"tradicional, pero no te alcanza el tiempo."

