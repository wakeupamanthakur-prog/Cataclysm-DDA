#. ~ Profession name for male
#: data/json/professions.json
msgctxt "profession_male"
msgid "Undercover Operative"
msgstr "Agente Infiltrado"

#. ~ Description of profession "Undercover Operative" for male
#: data/json/professions.json
msgctxt "prof_desc_male"
msgid ""
"You've been tailing your target for months, and now he's a zombie.  So much "
"for that lead.  Command isn't responding to your calls for an evac, so "
"you'll have to make do with what you have on you."
msgstr ""
"Has estado siguiendo a tu objetivo durante meses, y ahora es un zombi. Vaya "
"faena. El comando central no responde a tus llamadas para una evacuación, "
"así que tendrás que apañarte con lo que tienes."

#. ~ Profession name for female
#: data/json/professions.json
msgctxt "profession_female"
msgid "Undercover Operative"
msgstr "Agente Infiltrada"

#. ~ Description of profession "Undercover Operative" for female
#: data/json/professions.json
msgctxt "prof_desc_female"
