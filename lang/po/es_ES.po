msgid_plural "mitre saws"
msgstr[0] "sierra de inglete"
msgstr[1] "sierras de inglete"
msgstr[2] "sierras de inglete"

#. ~ Description of vehicle part "mitre saw"
#: data/json/furniture_and_terrain/appliances.json
msgid ""
"A circular sawblade on an arm that can slide and rotate in several "
"directions, this is a staple tool for nearly any carpentry.  Plugged in and "
"ready to go."
msgstr ""
"Una hoja de sierra circular en un brazo que puede deslizarse y girar en "
"varias direcciones, esta es una herramienta básica para casi cualquier "
"trabajo de carpintería. Enchufada y lista para ser usada."

#. ~ Vehicle part name
#. ~ Furniture name
#. ~ Item name
#: data/json/furniture_and_terrain/appliances.json
#: data/json/furniture_and_terrain/furniture-tools.json
#: data/json/items/fake.json
msgid "band saw"
msgid_plural "band saws"
msgstr[0] "sierra de cinta"
msgstr[1] "sierras de cinta"
msgstr[2] "sierras de cinta"

#. ~ Description of vehicle part "band saw"
#: data/json/furniture_and_terrain/appliances.json
msgid ""
"A ribbonlike sawblade runs in a single direction in this tool, allowing "
"precise cuts at almost any angle.  Plugged in and ready to go."
msgstr ""
"Una hoja de sierra en forma de cinta que se desplaza en una sola dirección "
"en esta herramienta, lo que le permite realizar cortes precisos en casi "
"cualquier ángulo. Necesita estar enchufado para funcionar."

#. ~ Vehicle part name
#. ~ Furniture name
#: data/json/furniture_and_terrain/appliances.json
#: data/json/furniture_and_terrain/furniture-tools.json
msgid "router table"
msgstr "tabla de enrutamiento"

#. ~ Description of vehicle part "router table"
#: data/json/furniture_and_terrain/appliances.json
msgid ""
"This table has an inset router, a rotating motor with an exchangeable blade "
"head for cutting specific profiles and grooves.  Plugged in and ready to go."
msgstr ""
"Esta mesa tiene una fresadora, un motor rotativo con un cabezal de cuchilla "
"intercambiable para cortar perfiles y ranuras específicas y cosas así. "
"Enchufada y lista para ser usada."

#. ~ Vehicle part name
#. ~ Furniture name
#. ~ Item name
#: data/json/furniture_and_terrain/appliances.json
#: data/json/furniture_and_terrain/furniture-tools.json
#: data/json/items/fake.json
msgid "planer"
msgid_plural "planers"
msgstr[0] "garlopa"
msgstr[1] "garlopas"
msgstr[2] "garlopas"

#. ~ Description of vehicle part "planer"
#: data/json/furniture_and_terrain/appliances.json
msgid ""
"A hefty tool that will take in a board and cut it smooth and flat to a "
"specific width, particularly great if working with raw lumber stock, but "
"also good just for shaving wood down to size.  Plugged in and ready to go."
msgstr ""
"Una herramienta robusta que coge una tabla, la corta lisa y plana a una "
"anchura específica, particularmente grande para trabajar con madera en "
"bruto, pero también es buena para reducir el tamaño de la madera. Enchufada "
"y lista para ser usada."

#. ~ Vehicle part name
#. ~ Furniture name
#. ~ Item name
#: data/json/furniture_and_terrain/appliances.json
#: data/json/furniture_and_terrain/furniture-tools.json
#: data/json/items/fake.json
msgid "jointer"
msgid_plural "jointers"
msgstr[0] "ensambladora"
msgstr[1] "ensambladoras"
msgstr[2] "ensambladoras"

#. ~ Description of vehicle part "jointer"
#: data/json/furniture_and_terrain/appliances.json
msgid ""
"A table-shaped tool with a rotating blade that will cut down, smooth out, "
"and square off a board to make it nice and smooth.  Plugged in and ready to "
"go."
msgstr ""
"Una herramienta con forma de mesa con una hoja giratoria que cortará, "
"alisará y cuadrará una tabla para hacerla muy lisa y agradable. Enchufada y "
"lista para ser usada."

#. ~ Vehicle part name
