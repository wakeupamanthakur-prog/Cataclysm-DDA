#. ~ Description of a pocket in item "light ballistic vest (storage pouch)"
#: data/json/items/armor/ballistic_armor.json
msgid "Low-profile zipper storage pouch."
msgstr "파우치"

#. ~ Item name
#: data/json/items/armor/ballistic_armor.json
msgid "light ballistic vest (shoulder pouch)"
msgid_plural "light ballistic vests (shoulder pouch)"
msgstr[0] "경량 방탄조끼 (어깨 주머니)"

#. ~ Description of "light ballistic vest (shoulder pouch)"
#: data/json/items/armor/ballistic_armor.json
msgid ""
"A simple plate carrier covering the thorax, with front and back pockets for "
"armor plates.  Designed to keep your organs from being perforated by small-"
"arms fire.  This version has a shoulder-mounted pouch for a radio and a hook"
" on the front for a glowstick."
msgstr ""
"흉부를 덮는 간소한 플레이트 캐리어로, 앞뒤에 장갑판을 넣을 수 있는 주머니가 있습니다. 소총 사격으로 장기가 관통되는 것을 방지하도록 "
"설계되었습니다. 이 버전은 무전기를 넣을 수 있는 어깨 장착형 파우치와 야광봉을 넣을 수 있는 전면 후크가 있습니다."

#. ~ Variant name of item "light ballistic vest (shoulder pouch)"
#: data/json/items/armor/ballistic_armor.json
msgid "olive light ballistic vest (shoulder pouch)"
msgid_plural "olive light ballistic vests (shoulder pouch)"
msgstr[0] "경량 방탄조끼, 올리브색 (어깨 주머니)"

#. ~ Variant name of item "light ballistic vest (shoulder pouch)"
#: data/json/items/armor/ballistic_armor.json
msgid "tan light ballistic vest (shoulder pouch)"
msgid_plural "tan light ballistic vests (shoulder pouch)"
msgstr[0] "경량 방탄조끼, 황토색 (어깨 주머니)"

#. ~ Variant name of item "light ballistic vest (shoulder pouch)"
#: data/json/items/armor/ballistic_armor.json
msgid "black light ballistic vest (shoulder pouch)"
msgid_plural "black light ballistic vests (shoulder pouch)"
