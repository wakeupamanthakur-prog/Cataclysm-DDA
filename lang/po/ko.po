msgid ""
"NORWOOD POLICE DEPARTMENT\n"
"MISSING PERSON\n"
"\n"
"MARK WALLACE\n"
"\n"
"[Photograph: two muscular adult men posing for a selfie in a fitness gym.  The one on the right is blurred out.]\n"
"\n"
"MISSING FROM: Norwood MA\n"
"DATE MISSING: April 23\n"
"AGE: 33\n"
"HEIGHT: 6'0\"\n"
"WEIGHT: 196 Lbs\n"
"HAIR: brown ponytail with goatee\n"
"\n"
