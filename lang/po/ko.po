#. ~ Name of spell "telekinetic_pull"
#. ~ Name of spell "afs_telekinetic_move_item"
#: data/mods/MindOverMatter/powers/telekinesis.json
#: data/mods/aftershock_exoplanet/spells/psionics/telekinesis.json
msgid "[Ψ]Far Hand"
msgstr "[Ψ]파 핸드"

#. ~ Description of spell "telekinetic_pull ( [Ψ]Far Hand )"
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid "Pickup items at a distance or push them away from you."
msgstr "멀리 떨어진 곳에서 물건을 집어 올리거나 멀리 밀어내세요."

#. ~ Name of spell "telekinetic_push"
#. ~ Name of spell "afs_telekinetic_move_creature"
#: data/mods/MindOverMatter/powers/telekinesis.json
#: data/mods/aftershock_exoplanet/spells/psionics/telekinesis.json
msgid "[Ψ]Force Shove"
msgstr "[Ψ]포스 밀기"

#. ~ Description of spell "telekinetic_push ( [Ψ]Force Shove )"
#. ~ Description of spell "afs_telekinetic_move_creature ( [Ψ]Force Shove )"
#: data/mods/MindOverMatter/powers/telekinesis.json
#: data/mods/aftershock_exoplanet/spells/psionics/telekinesis.json
msgid ""
"Shove a target away or pull it towards you with a burst of psionic force.  "
"The distance the target can be moved depends on its weight versus your power"
" level; heavier things will not go as far, and if your target is too heavy, "
"you may not be able to move it at all."
msgstr ""
"사이오닉 폭발로 대상을 밀어내거나 끌어당깁니다. 대상을 움직일 수 있는 거리는 대상의 무게와 당신의 파워 레벨에 따라 달라집니다. 무거운"
" 대상은 멀리 가지 못하고, 대상이 너무 무거우면 아예 움직이지 못할 수도 있습니다."

#. ~ Name of spell "telekinetic_noise"
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid "[Ψ]Noisemaker"
msgstr "[Ψ]소음기"

#. ~ Description of spell "telekinetic_noise ( [Ψ]Noisemaker )"
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid ""
"Using a focused burst of telekinesis, slam two objects together, or an "
"object into the ground, or simply hit the ground with your powers, causing a"
" loud noise."
msgstr ""
"집중된 텔레키네시스 폭발을 이용해 두 개의 물체를 서로 부딪히거나, 물체를 땅에 내리치거나, 아니면 그냥 당신의 힘으로 땅을 때려서 큰 "
"소리를 내세요."

#. ~ Sound description of spell "telekinetic_noise ( [Ψ]Noisemaker )"
#. ~ Sound description of spell "trow_make_noise_spell ( The One Who Knocks )"
#: data/mods/MindOverMatter/powers/telekinesis.json
#: data/mods/Xedra_Evolved/spells/changeling_spells.json
msgid "a loud thump"
msgstr "큰 쿵 소리"

#. ~ Message of spell "telekinetic_noise ( [Ψ]Noisemaker )"
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid "You lash out at the ground with your powers."
msgstr "당신은 당신의 힘으로 땅을 내리칩니다."

#. ~ Name of spell "telekinetic_slam_down"
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid "[Ψ]Knockdown"
msgstr "[Ψ]녹다운"

#. ~ Description of spell "telekinetic_slam_down ( [Ψ]Knockdown )"
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid ""
"Slam something to the ground with a burst of telekinetic force, doing a "
"small amount of damage and downing them."
msgstr "순간적으로 텔레키네틱 힘을 발휘하여 무언가를 땅에 내리쳐 약간의 피해를 입히고 쓰러뜨립니다."

#. ~ Message of spell "telekinetic_slam_down ( [Ψ]Knockdown )"
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid "Your target is knocked to the ground."
msgstr "당신의 타겟은 땅에 쓰러졌습니다."

#. ~ Name of spell "telekinetic_momentum"
#. ~ Name of spell "afs_telekinetic_momentum"
#: data/mods/MindOverMatter/powers/telekinesis.json
#: data/mods/aftershock_exoplanet/spells/psionics/telekinesis.json
msgid "[Ψ]Momentum Alteration (C)"
msgstr "[Ψ]모멘텀 변화(C)"

#. ~ Description of spell "telekinetic_momentum ( [Ψ]Momentum Alteration (C)
#. )"
#. ~ Description of spell "afs_telekinetic_momentum ( [Ψ]Momentum Alteration
#. (C) )"
#: data/mods/MindOverMatter/powers/telekinesis.json
#: data/mods/aftershock_exoplanet/spells/psionics/telekinesis.json
msgid ""
"Edit the momentum of yourself and nearby objects to your benefit, slowing damaging force and slightly increasing your speed.\n"
"\n"
"This power <color_yellow>is maintained by concentration</color> and <color_red>may fail</color> if <color_yellow>concentration is interrupted</color>."
msgstr ""
"자신과 주변 물체의 추진력을 자신에게 유리하게 조정하여, 피해를 주는 힘의 속도를 늦추고 속도를 약간 증가시킵니다.\n"
"\n"
"이 능력은 <color_yellow>집중을 통해 유지되며</color>, <color_yellow>집중이 방해받으면</color> <color_red>효과가 사라질 수 있습니다</color>."

#. ~ Name of spell "telekinetic_slowfall"
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid "[Ψ]Slowfall"
msgstr "[Ψ]느림"

#. ~ Description of spell "telekinetic_slowfall ( [Ψ]Slowfall )"
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid ""
"Counteract the pull of gravity with telekinetic force, greatly reducing or "
"even eliminating damage from falling and becoming much more buoyant."
msgstr "텔레키네틱의 힘으로 중력을 상쇄하여 낙하로 인한 피해를 크게 줄이거나 아예 없애고 부력을 크게 높입니다."

#. ~ Message of spell "telekinetic_slowfall ( [Ψ]Slowfall )"
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid "You feel lighter."
msgstr "당신은 더 가벼워진 것을 느낀다."

#. ~ Name of spell "telekinetic_wave"
#. ~ Name of spell "afs_telekinetic_wave"
#: data/mods/MindOverMatter/powers/telekinesis.json
#: data/mods/aftershock_exoplanet/spells/psionics/telekinesis.json
msgid "[Ψ]Wave of Force"
msgstr "[Ψ]힘의 파동"

#. ~ Description of spell "telekinetic_wave ( [Ψ]Wave of Force )"
#. ~ Description of spell "afs_telekinetic_wave ( [Ψ]Wave of Force )"
#: data/mods/MindOverMatter/powers/telekinesis.json
#: data/mods/aftershock_exoplanet/spells/psionics/telekinesis.json
msgid ""
"Unleash a telekinetic wave around you that indiscriminately knocks "
"everything back."
msgstr "주변에 무차별적으로 모든 것을 밀어내는 염력파를 방출합니다."

#. ~ Message of spell "telekinetic_wave ( [Ψ]Wave of Force )"
#. ~ Message of spell "afs_telekinetic_wave ( [Ψ]Wave of Force )"
#: data/mods/MindOverMatter/powers/telekinesis.json
#: data/mods/aftershock_exoplanet/spells/psionics/telekinesis.json
msgid "You knock everything nearby backwards!"
msgstr "근처의 모든 것을 뒤로 밀어내요!"

#. ~ Name of spell "telekinetic_water_walk"
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid "[Ψ]Water Walking (C)"
msgstr "[Ψ]워터워킹(C)"

#. ~ Description of spell "telekinetic_water_walk ( [Ψ]Water Walking (C) )"
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid ""
"Lift yourself enough to counteract your mass, allowing the surface tension of liquids to support you, enabling you to walk on water.\n"
"\n"
"This power <color_yellow>is maintained by concentration</color> and <color_red>may fail</color> if <color_yellow>concentration is interrupted</color>.  It requires <color_yellow>even more concentration</color> than usual."
msgstr ""
"자신의 질량을 상쇄할 만큼 몸을 들어 올리면 액체의 표면 장력이 당신을 지탱하여 물 위를 걸을 수 있습니다.\n"
"\n"
"이 힘은 <color_ylow>집중력</color>을 통해 유지되며, <color_ylow>집중력이 방해받으면</color> <color_red>저하될 수 있습니다</color>. 평소보다 <color_ylow>더욱 강한 집중력</color>이 필요합니다."

#. ~ Name of spell "telekinetic_lifting_field"
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid "[Ψ]Lifting Field (C)"
msgstr "[Ψ]리프팅 필드(C)"

#. ~ Description of spell "telekinetic_lifting_field ( [Ψ]Lifting Field (C) )"
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid ""
"Hover a single object next to you, freeing your hands for other tasks and making it easy to access.\n"
"\n"
"This power <color_yellow>is maintained by concentration</color> and <color_red>may fail</color> if <color_yellow>concentration is interrupted</color>."
msgstr ""
"옆에 있는 물체 하나에 마우스를 올려놓으면 다른 작업을 위해 손을 비우고 쉽게 사용할 수 있습니다.\n"
"\n"
"이 능력은 <color_yellow>집중력</color>을 통해 유지되며, <color_yellow>집중력이 방해받으면</color> <color_red>효과가 사라질 수 있습니다</color>."

#. ~ Name of spell "telekinetic_strength"
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid "[Ψ]Enhance Strength (C)"
msgstr "[Ψ]강력 강화(C)"

#. ~ Description of spell "telekinetic_strength ( [Ψ]Enhance Strength (C) )"
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid ""
"Focus your powers to allow you to move much heavier objects and smash through walls.\n"
"\n"
"This power <color_yellow>is maintained by concentration</color> and <color_red>may fail</color> if <color_yellow>concentration is interrupted</color>.  It is <color_red>canceled by engaging in combat</color>."
msgstr ""
"힘을 집중시켜 훨씬 무거운 물체를 옮기고 벽을 부술 수 있습니다.\n"
"\n"
"이 능력은 <color_yellow>집중을 통해 유지되며</color>, <color_yellow>집중이 방해받으면</color> <color_red>실패할 수 있습니다</color>. <color_red>전투에 참여하면 취소됩니다</color>."

#. ~ Name of spell "telekinetic_hammer"
#. ~ Name of spell "afs_telekinetic_hammer"
#: data/mods/MindOverMatter/powers/telekinesis.json
#: data/mods/aftershock_exoplanet/spells/psionics/telekinesis.json
msgid "[Ψ]Mindhammer"
msgstr "[Ψ]마인드해머"

#. ~ Description of spell "telekinetic_hammer ( [Ψ]Mindhammer )"
#. ~ Description of spell "afs_telekinetic_hammer ( [Ψ]Mindhammer )"
#: data/mods/MindOverMatter/powers/telekinesis.json
#: data/mods/aftershock_exoplanet/spells/psionics/telekinesis.json
msgid "Smash a single target or small area with a fist of telekinetic force."
msgstr "염력의 주먹으로 단일 타겟이나 작은 지역을 박살냅니다."

#. ~ Sound description of spell "telekinetic_hammer ( [Ψ]Mindhammer )"
#. ~ Sound description of spell "afs_telekinetic_hammer ( [Ψ]Mindhammer )"
#: data/mods/MindOverMatter/powers/telekinesis.json
#: data/mods/aftershock_exoplanet/spells/psionics/telekinesis.json
msgid "a heavy thud!"
msgstr "쿵 하는 소리가 났다!"

#. ~ Message of spell "telekinetic_hammer ( [Ψ]Mindhammer )"
#. ~ Message of spell "afs_telekinetic_hammer ( [Ψ]Mindhammer )"
#: data/mods/MindOverMatter/powers/telekinesis.json
#: data/mods/aftershock_exoplanet/spells/psionics/telekinesis.json
msgid "You smash your target with a fist of force."
msgstr "당신은 강력한 주먹으로 목표물을 박살냅니다."

#. ~ Name of spell "telekinetic_vehicle_lift"
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid "[Ψ]Lift Vehicle (C)"
msgstr "[Ψ]리프트 차량(C)"

#. ~ Description of spell "telekinetic_vehicle_lift ( [Ψ]Lift Vehicle (C) )"
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid ""
"Focus your powers to raise a vehicle just enough to change a tire or perform repairs.  As your powers increase, you will be able to lift heavier vehicles.\n"
"\n"
"This power <color_yellow>is maintained by concentration</color> and <color_red>may fail</color> if <color_yellow>concentration is interrupted</color>.  It is <color_red>canceled by engaging in combat</color>."
msgstr ""
"타이어를 교체하거나 수리할 수 있을 만큼 차량을 들어 올리는 데 능력을 집중하세요. 능력이 향상될수록 더 무거운 차량을 들어 올릴 수 있습니다.\n"
"\n"
"이 능력은 <color_yellow>집중을 통해 유지</color>되며, <color_yellow>집중이 방해</color>받으면 <color_red>실패할 수 있습니다</color>. <color_red>전투에 참여하면</color> 해제됩니다."

#. ~ Name of spell "telekinetic_shield"
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid "[Ψ]Inertial Barrier (C)"
msgstr "[Ψ]관성 장벽(C)"

#. ~ Description of spell "telekinetic_shield ( [Ψ]Inertial Barrier (C) )"
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid ""
"Create a telekinetic barrier around yourself to protect you from damage.\n"
"\n"
"This power <color_yellow>is maintained by concentration</color> and <color_red>may fail</color> if <color_yellow>concentration is interrupted</color>."
msgstr ""
"자신을 피해로부터 보호하기 위해 주변에 염력 장벽을 생성합니다.\n"
"\n"
"이 능력은 <color_ylow>집중을 통해 유지되며</color>, <color_ylow>집중이 방해받으면</color> <color_red>효과가 사라질 수 있습니다</color>."

#. ~ Name of spell "telekinetic_explosion"
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid "[Ψ]Wrecking Ball"
msgstr "[Ψ]레킹볼"

#. ~ Description of spell "telekinetic_explosion ( [Ψ]Wrecking Ball )"
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid ""
"A burst of telekinetic force shatters the terrain at the target location, as"
" well as anything caught inside."
msgstr "염력의 폭발로 목표 지점의 지형과 그 안에 갇힌 모든 것이 파괴됩니다."

#. ~ Message of spell "telekinetic_explosion ( [Ψ]Wrecking Ball )"
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid "You indiscriminately blast your targets!"
msgstr "당신은 무차별적으로 표적을 공격합니다!"

#. ~ Name of spell "telekinetic_levitation"
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid "[Ψ]Levitation (C)"
msgstr "[Ψ]부상(C)"

#. ~ Description of spell "telekinetic_levitation ( [Ψ]Levitation (C) )"
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid ""
"Use your telekinesis and lift yourself up, defying gravity.  While not true flight, you can cross open air and descend safely.\n"
"\n"
"This power <color_yellow>is maintained by concentration</color> and <color_red>may fail</color> if <color_yellow>concentration is interrupted</color>.  It is <color_red>canceled by engaging in combat</color>.  It requires <color_yellow>even more concentration</color> than usual."
msgstr ""
"염력을 사용하여 중력을 거스르며 위로 올라가세요. 진정한 비행은 아니지만, 넓은 하늘을 가로질러 안전하게 하강할 수 있습니다.\n"
"\n"
"이 능력은 <color_yellow>집중을 통해 유지되며</color>, <color_yellow>집중이 방해받으면</color> <color_red>효과가 사라질 수 있습니다</color>. <color_red>전투에 참여하면 효과가 취소됩니다</color>. 평소보다 <color_yellow>더욱 강한 집중력</color>이 필요합니다."

#. ~ Name of spell "telekinetic_move_large_weight"
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid "[Ψ]Megakinesis"
msgstr "[Ψ]메가키네시스"

#. ~ Description of spell "telekinetic_move_large_weight ( [Ψ]Megakinesis )"
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid ""
"Telekinesis on a grand scale, this power allows you to move truly enormous "
"amounts of weight, hurling a human-sized target at lethal speeds or picking "
"up and throwing something monstrously large.  The amount of weight you can "
"move is dependent on the power level."
msgstr ""
"이 능력은 엄청난 규모의 염력을 지녔으며, 엄청난 무게를 옮길 수 있게 해 줍니다. 사람 크기의 표적을 치명적인 속도로 던지거나, "
"엄청나게 큰 물체를 집어 던질 수도 있습니다. 옮길 수 있는 무게의 양은 능력 수준에 따라 달라집니다."

#. ~ Name of spell "telekinetic_aegis"
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid "[Ψ]Aegis"
msgstr "[Ψ]이지스"

#. ~ Description of spell "telekinetic_aegis ( [Ψ]Aegis )"
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid ""
"Create a shield impenetrable to physical damage around yourself.  It will "
"<color_yellow>only last a few moments</color>.  You will be "
"<color_red>unable to move</color> while the power is in effect."
msgstr ""
"주변에 물리 피해를 받지 않는 보호막을 생성합니다. 보호막은 <color_yellow>몇 분 동안만 유지됩니다</color>. 효과가 "
"지속되는 동안 <color_red>움직일 수 없습니다</color>."

#. ~ Message of spell "telekinetic_aegis ( [Ψ]Aegis )"
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid "The air around you becomes as hard as adamant."
msgstr "당신 주변의 공기가 금처럼 딱딱해집니다."

#. ~ Name of spell "telekinetic_earthshaker"
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid "[Ψ]Earthshaker"
msgstr "[Ψ]어스셰이커"

#. ~ Description of spell "telekinetic_earthshaker ( [Ψ]Earthshaker )"
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid ""
"Seize the nearby earth with your powers and *wrench* it, toppling buildings "
"and knocking everyone nearby off their feet."
msgstr "당신의 힘으로 근처 지구를 장악하고 *파괴*하여 건물을 무너뜨리고 근처에 있는 모든 사람을 쓰러뜨립니다."

#. ~ Message of spell "telekinetic_earthshaker ( [Ψ]Earthshaker )"
#: data/mods/MindOverMatter/powers/telekinesis.json
msgid "The earth shakes!"
msgstr "땅이 흔들린다!"

#. ~ Player message in effect in EoC "EOC_TELEKIN_MOMENTUM_INITIATE"
#. ~ Player message in effect in EoC "EOC_AFS_TELEKIN_MOMENTUM_INITIATE"
#: data/mods/MindOverMatter/powers/telekinesis_concentration_eoc.json
#: data/mods/aftershock_exoplanet/spells/psionics/telekinesis_concentration_eocs.json
msgid "The air around you feels more yielding."
msgstr "주변 공기가 더 유연하게 느껴집니다."

#. ~ Player message in effect in EoC "EOC_TELEKIN_WATER_WALKING"
#: data/mods/MindOverMatter/powers/telekinesis_concentration_eoc.json
msgid "Your steps feel very light on the ground."
msgstr "당신의 발걸음은 땅을 밟는 데 매우 가볍습니다."

#. ~ Player message in effect in EoC "EOC_TELEKIN_LIFTING_FIELD_INITIATE"
#: data/mods/MindOverMatter/powers/telekinesis_concentration_eoc.json
msgid "You prepare to hover an item close to hand."
msgstr "당신은 물건을 손 가까이에 가져다 놓을 준비를 합니다."

#. ~ Player message in effect in EoC "EOC_TELEKIN_STRENGTH_INITIATE"
#: data/mods/MindOverMatter/powers/telekinesis_concentration_eoc.json
msgid "You concentrate and prepare to lift something heavy."
msgstr "당신은 집중해서 무거운 것을 들어올릴 준비를 합니다."

#. ~ Player message in effect in EoC "EOC_TELEKIN_SHIELD_INITIATE"
#: data/mods/MindOverMatter/powers/telekinesis_concentration_eoc.json
msgid "The air around you shimmers slightly."
msgstr "당신 주변의 공기가 살짝 반짝인다."

#. ~ Player message in effect in EoC
#. "EOC_TELEKIN_SUMMON_JACKING_TOOL_INITIATE"
#: data/mods/MindOverMatter/powers/telekinesis_concentration_eoc.json
msgid "You ready yourself to lift a car just enough to work on it."
msgstr "당신은 자동차를 수리하기에 딱 맞는 만큼만 들어올릴 준비를 합니다."

#. ~ Player message in effect in EoC "EOC_TELEKIN_REMOVE_JACKING_TOOL"
#: data/mods/MindOverMatter/powers/telekinesis_concentration_eoc.json
msgid "You let the vehicle settle gently to the ground."
msgstr "차량을 조심스럽게 땅에 내려놓으세요."

#. ~ Player message in effect in EoC "EOC_TELEKIN_LEVITATION_INITIATE"
#: data/mods/MindOverMatter/powers/telekinesis_concentration_eoc.json
msgid "You begin floating a hand's breadth above the ground."
msgstr "당신은 땅에서 손 너비만큼 떠 있기 시작합니다."

#. ~ Message in effect in EoC "EOC_TELEKINETIC_THROW_WEIGHT_HANDLER"
#: data/mods/MindOverMatter/powers/telekinesis_eoc.json
msgid "The weight ratio is <u_val:weight_ratio>."
msgstr "무게 비율은 <u_val:weight_ratio>입니다."

#. ~ Message in effect in EoC "EOC_TELEKINETIC_THROW_WEIGHT_HANDLER"
#: data/mods/MindOverMatter/powers/telekinesis_eoc.json
msgid "The effective spell level is <u_val:telekinesis_shove_spell_level>."
msgstr "효과적인 주문 레벨은 <u_val:telekinesis_shove_spell_level>입니다."

#. ~ Message in nested effect in then statement in nested effect in else
#. statement in effect in EoC "EOC_TELEKINETIC_THROW_WEIGHT_HANDLER"
#: data/mods/MindOverMatter/powers/telekinesis_eoc.json
msgid ""
"The effective spell level for pulling is "
"<u_val:telekinesis_shove_spell_level>."
msgstr "끌어당기기에 효과적인 주문 레벨은 <u_val:telekinesis_shove_spell_level>입니다."

#. ~ NPC message in nested effect in then statement in nested effect in else
#. statement in nested effect in else statement in effect in EoC
#. "EOC_TELEKINETIC_THROW_WEIGHT_HANDLER"
#. ~ NPC message in nested effect in then statement in nested effect in else
#. statement in effect in EoC "EOC_AFS_TELEKINETIC_FORCE_SHOVE_PUSH_CHECKER"
#: data/mods/MindOverMatter/powers/telekinesis_eoc.json
#: data/mods/aftershock_exoplanet/spells/psionics/telekinesis_eocs.json
msgid "You hurl your target."
msgstr "당신은 표적을 던집니다."

#. ~ Message in effect in EoC "EOC_TELEKINETIC_PUSH_DIRECTION_PICKER" in
#. nested EOCs in nested effect in then statement in nested effect in else
#. statement in nested effect in else statement in effect in EoC
#. "EOC_TELEKINETIC_THROW_WEIGHT_HANDLER"
#. ~ Message in effect in EoC "EOC_AFS_TELEKINETIC_PUSH_DIRECTION_PICKER" in
#. nested EOCs in nested effect in then statement in nested effect in else
#. statement in effect in EoC "EOC_AFS_TELEKINETIC_FORCE_SHOVE_PUSH_CHECKER"
#: data/mods/MindOverMatter/powers/telekinesis_eoc.json
#: data/mods/aftershock_exoplanet/spells/psionics/telekinesis_eocs.json
msgid "Select direction."
msgstr "방향을 선택하세요."

#. ~ EOC option name in effect in EoC "EOC_TELEKINETIC_FAR_HAND_SELECTOR"
#. ~ EOC option name in effect in EoC "EOC_TELEKINETIC_FORCE_SHOVE_SELECTOR"
#. ~ EOC option name in effect in EoC
#. "EOC_TELEKINETIC_MOVE_LARGE_WEIGHT_SELECTOR"
#. ~ EOC option name in effect in EoC "EOC_AFS_TELEKINETIC_FAR_HAND_SELECTOR"
#. ~ EOC option name in effect in EoC
#. "EOC_AFS_TELEKINETIC_FORCE_SHOVE_SELECTOR"
#: data/mods/MindOverMatter/powers/telekinesis_eoc.json
#: data/mods/aftershock_exoplanet/spells/psionics/telekinesis_eocs.json
msgid "Pull"
msgstr "당기다"

#. ~ EOC option name in effect in EoC "EOC_TELEKINETIC_FAR_HAND_SELECTOR"
#. ~ EOC option name in effect in EoC "EOC_AFS_TELEKINETIC_FAR_HAND_SELECTOR"
#. ~ EOC option name in effect in EoC
#. "EOC_AFS_TELEKINETIC_FORCE_SHOVE_SELECTOR"
#: data/mods/MindOverMatter/powers/telekinesis_eoc.json
#: data/mods/aftershock_exoplanet/spells/psionics/telekinesis_eocs.json
msgid "Push"
msgstr "푸시"

#. ~ EOC option description in effect in EoC
#. "EOC_TELEKINETIC_FAR_HAND_SELECTOR"
#. ~ EOC option description in effect in EoC
#. "EOC_AFS_TELEKINETIC_FAR_HAND_SELECTOR"
#: data/mods/MindOverMatter/powers/telekinesis_eoc.json
#: data/mods/aftershock_exoplanet/spells/psionics/telekinesis_eocs.json
msgid "Pull a set of items to you."
msgstr "일련의 아이템을 당신에게 가져옵니다."

#. ~ EOC option description in effect in EoC
#. "EOC_TELEKINETIC_FAR_HAND_SELECTOR"
#. ~ EOC option description in effect in EoC
#. "EOC_AFS_TELEKINETIC_FAR_HAND_SELECTOR"
#: data/mods/MindOverMatter/powers/telekinesis_eoc.json
#: data/mods/aftershock_exoplanet/spells/psionics/telekinesis_eocs.json
msgid "Push a set of items away from you."
msgstr "여러 개의 물건을 당신에게서 멀리 밀어냅니다."

#. ~ EOC option description in effect in EoC
#. "EOC_TELEKINETIC_FORCE_SHOVE_SELECTOR"
#. ~ EOC option description in effect in EoC
#. "EOC_TELEKINETIC_MOVE_LARGE_WEIGHT_SELECTOR"
#: data/mods/MindOverMatter/powers/telekinesis_eoc.json
msgid "Shove a target in a particular direction."
msgstr "특정 방향으로 표적을 밀어냅니다."

#. ~ EOC option description in effect in EoC
#. "EOC_TELEKINETIC_FORCE_SHOVE_SELECTOR"
#. ~ EOC option description in effect in EoC
#. "EOC_AFS_TELEKINETIC_FORCE_SHOVE_SELECTOR"
#: data/mods/MindOverMatter/powers/telekinesis_eoc.json
#: data/mods/aftershock_exoplanet/spells/psionics/telekinesis_eocs.json
msgid "Grab a target and pull them towards you."
msgstr "목표물을 잡아서 당신 쪽으로 끌어당기세요."

#. ~ NPC message in effect in EoC "EOC_TELEKINETIC_PUSH_DOWN_CHECKER"
#. ~ NPC message in effect in EoC "EOC_AFS_TELEKINETIC_PUSH_DOWN_CHECKER"
#: data/mods/MindOverMatter/powers/telekinesis_eoc.json
#: data/mods/aftershock_exoplanet/spells/psionics/telekinesis_eocs.json
msgid "You shove your target off their feet."
msgstr "당신은 표적을 발로 밀어냅니다."

#. ~ NPC message in false effect in EoC "EOC_TELEKINETIC_PUSH_DOWN_CHECKER"
#. ~ NPC message in false effect in EoC
#. "EOC_AFS_TELEKINETIC_PUSH_DOWN_CHECKER"
#: data/mods/MindOverMatter/powers/telekinesis_eoc.json
#: data/mods/aftershock_exoplanet/spells/psionics/telekinesis_eocs.json
msgid "You attempt to shove your target but they are too heavy!"
msgstr "당신은 목표물을 밀어내려고 시도하지만, 목표물이 너무 무겁습니다!"

#. ~ EOC option description in effect in EoC
#. "EOC_TELEKINETIC_MOVE_LARGE_WEIGHT_SELECTOR"
#: data/mods/MindOverMatter/powers/telekinesis_eoc.json
msgid "Pull something toward you."
msgstr "무언가를 당신 쪽으로 당겨보세요."

#. ~ Name of spell "telepathic_concentration"
#: data/mods/MindOverMatter/powers/telepathy.json
msgid "[Ψ]Concentration Trance (C)"
msgstr "[Ψ]집중 트랜스(C)"

#. ~ Description of spell "telepathic_concentration ( [Ψ]Concentration Trance
#. (C) )"
#: data/mods/MindOverMatter/powers/telepathy.json
msgid ""
"Focus your own mind into a trance state, increasing learning speed.\n"
"\n"
"This power <color_yellow>is maintained by concentration</color> and <color_red>may fail</color> if <color_yellow>concentration is interrupted</color>.  It is <color_red>canceled by engaging in combat</color>."
msgstr ""
"자신의 마음을 트랜스 상태로 집중시켜 학습 속도를 높입니다.\n"
"\n"
"이 능력은 <color_yellow>집중을 통해 유지되며</color>, <color_yellow>집중이 방해받으면</color> <color_red>실패할 수 있습니다</color>. <color_red>전투에 참여하면</color> 취소됩니다."

#. ~ Name of spell "telepathic_shield"
#. ~ Name of spell "afs_telepathic_shield"
#: data/mods/MindOverMatter/powers/telepathy.json
#: data/mods/aftershock_exoplanet/spells/psionics/telepathy.json
msgid "[Ψ]Telepathic Shield (C)"
msgstr "[Ψ]텔레파시 실드 (C)"

#. ~ Description of spell "telepathic_shield ( [Ψ]Telepathic Shield (C) )"
#: data/mods/MindOverMatter/powers/telepathy.json
msgid ""
"You can protect your mind from the dangers of the post-Cataclysmic world.\n"
"\n"
"This power <color_yellow>is maintained by concentration</color> and <color_red>may fail</color> if <color_yellow>concentration is interrupted</color>."
msgstr ""
"대격변 이후 세계의 위험으로부터 당신의 정신을 보호할 수 있습니다.\n"
"\n"
"이 힘은 <color_yellow>집중을 통해 유지되며</color>, <color_yellow>집중이 방해받으면</color> <color_red>실패할 수 있습니다</color>."

#. ~ Name of spell "telepathic_mind_sense"
#. ~ Name of spell "afs_telepathic_mind_sense"
#: data/mods/MindOverMatter/powers/telepathy.json
#: data/mods/aftershock_exoplanet/spells/psionics/telepathy.json
msgid "[Ψ]Sense Minds (C)"
msgstr "[Ψ]센스 마인드(C)"

#. ~ Description of spell "telepathic_mind_sense ( [Ψ]Sense Minds (C) )"
#. ~ Description of spell "afs_telepathic_mind_sense ( [Ψ]Sense Minds (C) )"
#: data/mods/MindOverMatter/powers/telepathy.json
#: data/mods/aftershock_exoplanet/spells/psionics/telepathy.json
msgid ""
"You can use your powers to detect the tell-tale hum of a living, sapient mind, no matter how strange or alien it may be.\n"
"\n"
"This power <color_yellow>is maintained by concentration</color> and <color_red>may fail</color> if <color_yellow>concentration is interrupted</color>."
msgstr ""
"당신은 당신의 능력을 사용하여 아무리 이상하고 외계적일지라도 살아 있는 지성체의 숨길 수 없는 웅웅거림을 감지할 수 있습니다.\n"
"\n"
"이 능력은 <color_yellow>집중을 통해 유지되며</color>, <color_yellow>집중이 방해받으면</color> <color_red>실패할 수 있습니다</color>."

#. ~ Name of spell "telepathic_mesmerize"
#: data/mods/MindOverMatter/powers/telepathy.json
msgid "[Ψ]Mesmerize"
msgstr "[Ψ] 최면을 걸다"

#. ~ Description of spell "telepathic_mesmerize ( [Ψ]Mesmerize )"
#: data/mods/MindOverMatter/powers/telepathy.json
msgid ""
"Hypnotize a target, causing them to stand in a trance or wander around in a "
"small area.  Any damage taken will snap the target out of their trance.  "
"Some targets are more resistant to mesmerism than others."
msgstr ""
"대상을 최면에 걸리게 하여 최면 상태에 서 있게 하거나 좁은 공간을 돌아다니게 합니다. 피해를 입으면 대상은 최면 상태에서 깨어납니다. "
"대상에 따라 최면술에 대한 저항력이 다릅니다."

#. ~ Name of spell "telepathic_morale"
#: data/mods/MindOverMatter/powers/telepathy.json
msgid "[Ψ]Mood Stabilization (C)"
msgstr "[Ψ]기분안정화(C)"

#. ~ Description of spell "telepathic_morale ( [Ψ]Mood Stabilization (C) )"
#: data/mods/MindOverMatter/powers/telepathy.json
msgid ""
"With the ability to edit others' thoughts comes the ability to edit your own, removing negative moods to a degree.  You have also learned to do this more subtly on others, calming their anger or assuaging their fears.\n"
"\n"
"When used on yourself, this power <color_yellow>is maintained by concentration</color> and <color_red>may fail</color> if <color_yellow>concentration is interrupted</color>."
msgstr ""
"다른 사람의 생각을 편집하는 능력은 자신의 생각을 편집하여 부정적인 기분을 어느 정도 해소하는 능력과 함께합니다. 또한 다른 사람에게는 더욱 미묘하게 이 능력을 사용하여 분노를 가라앉히거나 두려움을 달래는 법을 배웠습니다.\n"
"\n"
"이 능력을 자신에게 사용할 경우, <color_ylow>집중력</color>을 통해 유지되며, <color_ylow>집중력이 방해받는 경우</color> <color_red>실패할 수 있습니다</color>."

#. ~ Name of spell "telepathic_blast"
#. ~ Name of spell "afs_telepathic_blast"
#: data/mods/MindOverMatter/powers/telepathy.json
#: data/mods/aftershock_exoplanet/spells/psionics/telepathy.json
msgid "[Ψ]Synaptic Overload"
msgstr "[Ψ]시냅스 과부하"

#. ~ Description of spell "telepathic_blast ( [Ψ]Synaptic Overload )"
#: data/mods/MindOverMatter/powers/telepathy.json
msgid ""
"Short-circuit and overwhelm a target's brain, causing extreme damage or "
"death."
msgstr "표적의 뇌를 단락시키고 과부하시켜 극심한 손상이나 사망을 초래합니다."

#. ~ Message of spell "telepathic_blast ( [Ψ]Synaptic Overload )"
#. ~ Message of spell "afs_telepathic_blast ( [Ψ]Synaptic Overload )"
#: data/mods/MindOverMatter/powers/telepathy.json
#: data/mods/aftershock_exoplanet/spells/psionics/telepathy.json
msgid "You assault the mind of your target!"
msgstr "당신은 타겟의 정신을 공격합니다!"

#. ~ Name of spell "telepathic_animal_mind_control"
#: data/mods/MindOverMatter/powers/telepathy.json
msgid "[Ψ]Beastmaster"
msgstr "[Ψ]비스트마스터"

#. ~ Description of spell "telepathic_animal_mind_control ( [Ψ]Beastmaster )"
#: data/mods/MindOverMatter/powers/telepathy.json
msgid ""
"Take control of an animal's mind, forcing it to obey you.  This power will "
"not work on insects, spiders, or similar beings."
msgstr "동물의 마음을 조종하여 복종하게 만드세요. 이 능력은 곤충, 거미 또는 그와 유사한 생물에게는 통하지 않습니다."

#. ~ Message of spell "telepathic_animal_mind_control ( [Ψ]Beastmaster )"
#: data/mods/MindOverMatter/powers/telepathy.json
msgid "You take control of the animal's mind!"
msgstr "당신은 동물의 마음을 조종하세요!"

#. ~ Name of spell "telepathic_confusion"
#. ~ Name of spell "afs_telepathic_confusion"
#: data/mods/MindOverMatter/powers/telepathy.json
#: data/mods/aftershock_exoplanet/spells/psionics/telepathy.json
msgid "[Ψ]Sensory Deprivation"
msgstr "[Ψ]감각 박탈"

#. ~ Description of spell "telepathic_confusion ( [Ψ]Sensory Deprivation )"
#. ~ Description of spell "afs_telepathic_confusion ( [Ψ]Sensory Deprivation
#. )"
#: data/mods/MindOverMatter/powers/telepathy.json
#: data/mods/aftershock_exoplanet/spells/psionics/telepathy.json
msgid ""
"Disconnect a target's brain from its senses, leaving it blinded and "
"confused."
msgstr "대상의 뇌와 감각을 분리시켜 실명시키고 혼란스럽게 만듭니다."

#. ~ Message of spell "telepathic_confusion ( [Ψ]Sensory Deprivation )"
#. ~ Message of spell "afs_telepathic_confusion ( [Ψ]Sensory Deprivation )"
#: data/mods/MindOverMatter/powers/telepathy.json
#: data/mods/aftershock_exoplanet/spells/psionics/telepathy.json
msgid "You lock your target's mind away!"
msgstr "당신은 타겟의 마음을 가두어 버립니다!"

#. ~ Name of spell "telepathic_fear"
#: data/mods/MindOverMatter/powers/telepathy.json
msgid "[Ψ]Primal Terror"
msgstr "[Ψ]원시적 공포"

#. ~ Description of spell "telepathic_fear ( [Ψ]Primal Terror )"
#: data/mods/MindOverMatter/powers/telepathy.json
msgid ""
"Use a target's own inner fears against them, paralyzing them with "
"overwhelming terror.  The effect will not last long, but is completely "
"immobilizing while it does, and it leaves a lingering horror behind in the "
"target."
msgstr ""
"대상의 내면에 잠재된 공포를 이용하여 압도적인 공포로 마비시킵니다. 효과는 오래가지 않지만, 지속되는 동안 완전히 마비시키고, 대상에게 "
"잔혹한 공포를 남깁니다."

#. ~ Message of spell "telepathic_fear ( [Ψ]Primal Terror )"
#: data/mods/MindOverMatter/powers/telepathy.json
msgid "You unleash your target's fears."
msgstr "당신은 타겟의 두려움을 풀어줍니다."

#. ~ Name of spell "telepathic_invisibility"
#: data/mods/MindOverMatter/powers/telepathy.json
msgid "[Ψ]Obscurity"
msgstr "[Ψ]모호함"

#. ~ Description of spell "telepathic_invisibility ( [Ψ]Obscurity )"
#: data/mods/MindOverMatter/powers/telepathy.json
msgid ""
"Use a light touch on others' minds to hide your presence.  You will be invisible to the target(s) while the power is in effect.\n"
"\n"
"This power is <color_red>canceled by engaging in combat</color> with your target."
msgstr ""
"다른 사람의 마음에 가볍게 손을 대어 당신의 존재를 숨기세요. 이 능력이 활성화되어 있는 동안 당신은 대상에게 보이지 않습니다.\n"
"\n"
"이 능력은 대상과 <color_red>전투를 벌이면</color> 해제됩니다."

#. ~ Message of spell "telepathic_invisibility ( [Ψ]Obscurity )"
#: data/mods/MindOverMatter/powers/telepathy.json
msgid "You hide your presence from your enemies."
msgstr "당신은 적에게서 당신의 존재를 숨깁니다."

#. ~ Name of spell "telepathic_blast_radius"
#: data/mods/MindOverMatter/powers/telepathy.json
msgid "[Ψ]Psychic Scream"
msgstr "[Ψ]사이킥 스크림"

#. ~ Description of spell "telepathic_blast_radius ( [Ψ]Psychic Scream )"
#: data/mods/MindOverMatter/powers/telepathy.json
msgid ""
"Emit an uncontrolled psychic scream, attacking the mind of anyone nearby.  "
"This power does not distinguish between friend and foe."
msgstr "통제할 수 없는 사이킥 비명을 내뿜어 주변 모든 사람의 정신을 공격합니다. 이 능력은 적과 아군을 가리지 않습니다."

#. ~ Message of spell "telepathic_blast_radius ( [Ψ]Psychic Scream )"
#: data/mods/MindOverMatter/powers/telepathy.json
msgid "You unleash a mind-piercing psionic shriek!"
msgstr "당신은 정신을 꿰뚫는 듯한 정신적 비명을 질렀습니다!"

#. ~ Name of spell "telepathic_beast_taming"
#: data/mods/MindOverMatter/powers/telepathy.json
msgid "[Ψ]Beast Tamer"
msgstr "[Ψ]야수 조련사"

#. ~ Description of spell "telepathic_beast_taming ( [Ψ]Beast Tamer )"
#: data/mods/MindOverMatter/powers/telepathy.json
msgid ""
"Perform mental surgery on an animal, making it friendly to you for a much "
"longer duration.  The animal must already be friendly, either naturally or "
"through powers such as Beastmastery, in order to be tamed."
msgstr ""
"동물에게 정신 수술을 가해 훨씬 더 오랫동안 당신에게 우호적인 동물로 만듭니다. 길들이려면 동물이 본래부터 우호적이어야 하며, "
"본능적으로든 비스트마스터리와 같은 능력을 통해든 그래야 합니다."

#. ~ Message of spell "telepathic_beast_taming ( [Ψ]Beast Tamer )"
#: data/mods/MindOverMatter/powers/telepathy.json
msgid "The animal sniffs at your palm."
msgstr "동물이 당신의 손바닥을 킁킁거립니다."

#. ~ Name of spell "telepathic_mind_control"
#: data/mods/MindOverMatter/powers/telepathy.json
msgid "[Ψ]Mind Control"
msgstr "[Ψ]마인드 컨트롤"

#. ~ Description of spell "telepathic_mind_control ( [Ψ]Mind Control )"
#: data/mods/MindOverMatter/powers/telepathy.json
msgid "Seize control of the target's mind, forcing them to do your bidding."
msgstr "타겟의 마음을 장악하여 당신의 명령에 따르도록 강요하세요."

#. ~ Message of spell "telepathic_mind_control ( [Ψ]Mind Control )"
#: data/mods/MindOverMatter/powers/telepathy.json
msgid "You take control of your target's mind!"
msgstr "당신은 타겟의 마음을 조종합니다!"

#. ~ Name of spell "telepathic_network"
#: data/mods/MindOverMatter/powers/telepathy.json
msgid "[Ψ]Network Effect"
msgstr "[Ψ]네트워크 효과"

#. ~ Description of spell "telepathic_network ( [Ψ]Network Effect )"
#: data/mods/MindOverMatter/powers/telepathy.json
msgid ""
"Forge an unconscious telepathic network between you and nearby allies, "
"allowing you all to send and receive information about nearby dangers and "
"react more quickly in combat.  The network requires at least one ally nearby"
" to be effective."
msgstr ""
"자신과 근처 아군 사이에 무의식적인 텔레파시 네트워크를 구축하여, 모두가 근처 위험에 대한 정보를 주고받고 전투에서 더욱 신속하게 대응할"
" 수 있도록 합니다. 이 네트워크가 효과를 발휘하려면 근처에 최소 한 명의 아군이 있어야 합니다."

#. ~ Player message in effect in EoC "EOC_TELEPATH_CONCENTRATION_INITIATE"
#: data/mods/MindOverMatter/powers/telepathy_concentration_eoc.json
msgid ""
"Your vision narrows to what is directly in front of you as you concentrate."
msgstr "집중하면 시야가 좁아져 바로 앞에 있는 것만 보이게 됩니다."

#. ~ Player message in effect in EoC "EOC_TELEPATH_SHIELD_INITIATE"
#. ~ Player message in effect in EoC "EOC_AFS_TELEPATH_SHIELD_INITIATE"
#: data/mods/MindOverMatter/powers/telepathy_concentration_eoc.json
#: data/mods/aftershock_exoplanet/spells/psionics/telepathy_concentration_eocs.json
msgid "You begin shielding your thoughts."
msgstr "당신은 자신의 생각을 보호하기 시작합니다."

#. ~ Player message in effect in EoC "EOC_TELEPATH_SENSE_MINDS_INITIATE"
#. ~ Player message in effect in EoC "EOC_AFS_TELEPATH_SENSE_MINDS_INITIATE"
#: data/mods/MindOverMatter/powers/telepathy_concentration_eoc.json
#: data/mods/aftershock_exoplanet/spells/psionics/telepathy_concentration_eocs.json
msgid "You reach out with your powers, looking for nearby minds."
msgstr "당신은 자신의 힘을 사용하여 근처의 마음을 찾습니다."

#. ~ Player message in effect in EoC "EOC_TELEPATH_MORALE_INITIATE_SELF"
#: data/mods/MindOverMatter/powers/telepathy_concentration_eoc.json
msgid "You begin to edit out your discouraging thoughts."
msgstr "당신은 낙담스러운 생각을 삭제하기 시작합니다."

#. ~ NPC message in nested effect in then statement in effect in EoC
#. "EOC_TELEPATH_MESMERIZE_2" in nested EOCs in effect in EoC
#. "EOC_TELEPATH_MESMERIZE"
#. ~ NPC message in nested effect in then statement in false effect in EoC
#. "EOC_TELEPATH_MESMERIZE_2" in nested EOCs in effect in EoC
#. "EOC_TELEPATH_MESMERIZE"
#: data/mods/MindOverMatter/powers/telepathy_eoc.json
msgid "You mesmerize your target and they stand in a daze."
msgstr "당신은 목표물을 최면상태로 만들고, 그들은 멍하니 서 있게 만듭니다."

#. ~ NPC message in nested effect in else statement in effect in EoC
#. "EOC_TELEPATH_MESMERIZE_2" in nested EOCs in effect in EoC
#. "EOC_TELEPATH_MESMERIZE"
#. ~ NPC message in nested effect in else statement in false effect in EoC
#. "EOC_TELEPATH_MESMERIZE_2" in nested EOCs in effect in EoC
#. "EOC_TELEPATH_MESMERIZE"
#: data/mods/MindOverMatter/powers/telepathy_eoc.json
msgid "Your target resists the mesmerism!"
msgstr "당신의 타겟은 최면에 저항합니다!"

#. ~ NPC message in nested effect in then statement in false effect in EoC
#. "EOC_TELEPATH_MESMERIZE_2" in nested EOCs in effect in EoC
#. "EOC_TELEPATH_MESMERIZE"
#: data/mods/MindOverMatter/powers/telepathy_eoc.json
msgid "You mesmerize the alien creature and it stands in a daze."
msgstr "당신은 외계 생명체를 매료시켰고, 그것은 멍하니 서 있었습니다."

#. ~ NPC message in nested effect in then statement in false effect in EoC
#. "EOC_TELEPATH_MESMERIZE_2" in nested EOCs in effect in EoC
#. "EOC_TELEPATH_MESMERIZE"
#: data/mods/MindOverMatter/powers/telepathy_eoc.json
msgid "You mesmerize the feral human and they stand in a daze."
msgstr "당신은 야생 인간을 매료시키고 그들은 어리둥절한 채로 서 있게 합니다."

#. ~ NPC message in effect in EoC "EOC_TELEPATH_MORALE_MODIFY_NPC_VALUES_2" in
#. nested EOCs in effect in EoC "EOC_TELEPATH_MORALE_MODIFY_NPC_VALUES"
#. ~ NPC message in effect in EoC
#. "EOC_TELEPATH_MORALE_MODIFY_MONSTER_VALUES_2" in nested EOCs in effect in
#. EoC "EOC_TELEPATH_MORALE_MODIFY_MONSTER_VALUES"
#: data/mods/MindOverMatter/powers/telepathy_eoc.json
msgid ""
"You reach in and, with a deft touch, sooth your target's negative emotions."
msgstr "당신은 손을 뻗어 능숙한 터치로 대상의 부정적인 감정을 달래줍니다."

#. ~ NPC message in false effect in EoC
#. "EOC_TELEPATH_MORALE_MODIFY_NPC_VALUES_2" in nested EOCs in effect in EoC
#. "EOC_TELEPATH_MORALE_MODIFY_NPC_VALUES"
#. ~ NPC message in false effect in EoC
#. "EOC_TELEPATH_MORALE_MODIFY_MONSTER_VALUES_2" in nested EOCs in effect in
#. EoC "EOC_TELEPATH_MORALE_MODIFY_MONSTER_VALUES"
#: data/mods/MindOverMatter/powers/telepathy_eoc.json
msgid ""
"You attempt to edit the target's mood, but your powers slam into a smooth, "
"unyielding barrier and slide off."
msgstr "당신은 타겟의 기분을 바꾸려고 시도하지만, 당신의 힘은 매끄럽고 견고한 장벽에 부딪혀 미끄러져 나갑니다."

#. ~ NPC message in false effect in EoC
#. "EOC_TELEPATH_MORALE_MODIFY_NPC_VALUES"
#: data/mods/MindOverMatter/powers/telepathy_eoc.json
msgid ""
"You don't want to risk affecting the target's mind too quickly, and "
"withdraw."
msgstr "당신은 너무 빨리 타겟의 마음에 영향을 끼칠 위험을 감수하고 싶지 않을 것이고, 물러서야 할 것입니다."

#. ~ Player spell casting message in effect in EoC
#. "EOC_TELEPATH_NETWORK_ALLY_CHECK"
#: data/mods/MindOverMatter/powers/telepathy_eoc.json
msgid "You now have an instinctive awareness of your allies, and they of you."
msgstr "이제 당신은 동맹국을 본능적으로 인식하게 되었고, 동맹국도 당신을 인식하게 되었습니다."

#. ~ Player message in false effect in EoC "EOC_TELEPATH_NETWORK_ALLY_CHECK"
#: data/mods/MindOverMatter/powers/telepathy_eoc.json
msgid "With no nearby allies, there is no one to network with."
msgstr "근처에 동맹이 없으면 네트워크를 이룰 사람도 없습니다."

#. ~ Name of spell "teleport_blink"
#: data/mods/MindOverMatter/powers/teleportation.json
msgid "[Ψ]Blink"
msgstr "[Ψ]깜박임"

#. ~ Description of spell "teleport_blink ( [Ψ]Blink )"
#: data/mods/MindOverMatter/powers/teleportation.json
msgid ""
"Step briefly into the void between dimensions and emerge at a random nearby location.\n"
"\n"
"The power <color_red>will fail</color> if the volume of your carried gear is too great."
msgstr ""
"차원 사이의 공허 속으로 잠깐 들어가 근처 무작위 위치에서 나타나세요.\n"
"\n"
"짐을 너무 많이 싣고 다니면 <color_red>능력이 사라집니다</color>."

#. ~ Name of spell "teleport_slow"
#: data/mods/MindOverMatter/powers/teleportation.json
msgid "[Ψ]Stutterstep"
msgstr "[Ψ]스터터스텝"

#. ~ Description of spell "teleport_slow ( [Ψ]Stutterstep )"
#: data/mods/MindOverMatter/powers/teleportation.json
msgid ""
"Manipulate space to increase relative distance around the target, reducing "
"their speed."
msgstr "공간을 조작하여 대상 주변의 상대적 거리를 늘리고, 속도를 줄입니다."

#. ~ Message of spell "teleport_slow ( [Ψ]Stutterstep )"
#: data/mods/MindOverMatter/powers/teleportation.json
msgid "You warp the space around your enemies!"
msgstr "적 주변의 공간을 왜곡하세요!"

#. ~ Name of spell "teleport_phase"
#: data/mods/MindOverMatter/powers/teleportation.json
msgid "[Ψ]Phase"
msgstr "[Ψ]상"

#. ~ Description of spell "teleport_phase ( [Ψ]Phase )"
#: data/mods/MindOverMatter/powers/teleportation.json
msgid ""
"By stepping for a moment into the void between dimensions, you can bypass a "
"wall or walk from the ground to the roof of a house."
msgstr "차원 사이의 공허 속으로 잠시 발을 들여놓으면 벽을 우회하거나 땅에서 집 지붕까지 걸어갈 수 있습니다."

#. ~ Name of spell "teleport_item_apport"
#: data/mods/MindOverMatter/powers/teleportation.json
msgid "[Ψ]Apportation"
msgstr "[Ψ]기여"

#. ~ Description of spell "teleport_item_apport ( [Ψ]Apportation )"
#: data/mods/MindOverMatter/powers/teleportation.json
msgid ""
"Rather than teleporting yourself, you could teleport an item you're holding somewhere nearby without having to follow it to its destination.\n"
"\n"
"Items that are <color_yellow>too large</color> cannot be apported."
msgstr ""
"자신을 순간이동하는 대신, 목적지까지 따라갈 필요 없이 소지하고 있는 아이템을 근처 어딘가로 순간이동시킬 수 있습니다.\n"
"\n"
"<color_yellow>너무 큰</color> 아이템은 순간이동할 수 없습니다."

#. ~ Name of spell "teleport_stride"
#: data/mods/MindOverMatter/powers/teleportation.json
msgid "[Ψ]Extended Stride (C)"
msgstr "[Ψ]확장된 보폭(C)"

#. ~ Description of spell "teleport_stride ( [Ψ]Extended Stride (C) )"
#: data/mods/MindOverMatter/powers/teleportation.json
msgid ""
"By warping space to shorten distances, you can make each of your movements carry you much further.\n"
"\n"
"This power <color_yellow>is maintained by concentration</color> and <color_red>may fail</color> if <color_yellow>concentration is interrupted</color>."
msgstr ""
"공간을 왜곡하여 거리를 단축하면, 모든 움직임이 훨씬 더 멀리 나아갈 수 있습니다.\n"
"\n"
"이 힘은 <color_yellow>집중을 통해 유지되며</color>, <color_yellow>집중이 방해받으면</color> <color_red>실패할 수 있습니다</color>."

#. ~ Message of spell "teleport_stride ( [Ψ]Extended Stride (C) )"
#: data/mods/MindOverMatter/powers/teleportation.json
msgid "Your steps devour the distance."
msgstr "당신의 발걸음은 거리를 삼켜버린다."

#. ~ Name of spell "teleport_transpose"
#: data/mods/MindOverMatter/powers/teleportation.json
msgid "[Ψ]Transposition"
msgstr "[Ψ]전치"

#. ~ Description of spell "teleport_transpose ( [Ψ]Transposition )"
#: data/mods/MindOverMatter/powers/teleportation.json
msgid ""
"Entangle yourself with your target's position and, with a twist, swap places"
" with them."
msgstr "타겟의 위치에 자신을 얽어매고, 색다른 방법으로 그들과 자리를 바꿔보세요."

#. ~ Message of spell "teleport_transpose ( [Ψ]Transposition )"
#: data/mods/MindOverMatter/powers/teleportation.json
msgid ""
"There is a moment of darkness and terrible cold, and you are somewhere else,"
" and so is your target."
msgstr "어둠과 끔찍한 추위가 찾아오는 순간, 당신은 다른 곳에 있고, 당신의 목표물도 다른 곳에 있습니다."

#. ~ Name of spell "teleport_displacement"
#: data/mods/MindOverMatter/powers/teleportation.json
msgid "[Ψ]Displacement"
msgstr "[Ψ]변위"

#. ~ Description of spell "teleport_displacement ( [Ψ]Displacement )"
#: data/mods/MindOverMatter/powers/teleportation.json
msgid ""
"With a touch, you can send your target through the void to re-emerge "
"somewhere nearby, further away from you.  Targets that are <color_yellow>too"
" large</color> cannot be displaced."
msgstr ""
"터치 한 번으로 대상을 공허 속으로 보내 더 멀리 떨어진 근처 어딘가로 다시 나타나게 할 수 있습니다. <color_yellow>너무 "
"큰</color> 대상은 이동할 수 없습니다."

#. ~ Name of spell "teleport_reactive_displacement"
#: data/mods/MindOverMatter/powers/teleportation.json
msgid "[Ψ]Reactive Displacement (C)"
msgstr "[Ψ]반응성 변위(C)"

#. ~ Description of spell "teleport_reactive_displacement ( [Ψ]Reactive
#. Displacement (C) )"
#: data/mods/MindOverMatter/powers/teleportation.json
msgid ""
"Maintain a field of unstable space around you, allowing you to effortlessly teleport enemies that strike you further away.  Unfortunately, their attacks will still hurt you as normal.\n"
"\n"
"This power <color_yellow>is maintained by concentration</color> and <color_red>may fail</color> if <color_yellow>concentration is interrupted</color>."
msgstr ""
"주변에 불안정한 공간을 유지하여 적을 더 멀리 순간이동시킬 수 있습니다. 하지만 적의 공격은 여전히 평소처럼 피해를 입힙니다.\n"
"\n"
"이 능력은 <color_ylow>집중을 통해 유지되며</color>, <color_ylow>집중이 방해받으면</color> <color_red>효과가 사라질 수 있습니다</color>."

#. ~ Name of spell "teleport_collapse"
#: data/mods/MindOverMatter/powers/teleportation.json
msgid "[Ψ]Spacial Vortex"
msgstr "[Ψ]공간 소용돌이"

#. ~ Description of spell "teleport_collapse ( [Ψ]Spacial Vortex )"
#: data/mods/MindOverMatter/powers/teleportation.json
msgid ""
"Affect the fabric of space, changing relative distance around a point so "
"that everything moving within finds themselves moving towards it."
msgstr ""
"공간의 구조에 영향을 미쳐, 어떤 지점 주변의 상대적 거리를 변화시켜 그 안에서 움직이는 모든 것이 그 지점을 향해 움직이게 합니다."

#. ~ Message of spell "teleport_collapse ( [Ψ]Spacial Vortex )"
#: data/mods/MindOverMatter/powers/teleportation.json
msgid ""
"The air around your enemies shimmers as their forward motion carries them "
"rapidly towards each other."
msgstr "적들이 앞으로 움직이면서 서로를 향해 빠르게 다가가면서 주변의 공기가 반짝입니다."

#. ~ Name of spell "teleport_relocation"
#: data/mods/MindOverMatter/powers/teleportation.json
msgid "[Ψ]Relocation"
msgstr "[Ψ]이주"

#. ~ Description of spell "teleport_relocation ( [Ψ]Relocation )"
#: data/mods/MindOverMatter/powers/teleportation.json
msgid ""
"Transport items in your hands through the Nether to an attuned location."
msgstr "손에 든 아이템을 네더를 통해 조율된 장소로 운반하세요."

#. ~ Name of spell "teleport_warped_strikes"
#: data/mods/MindOverMatter/powers/teleportation.json
msgid "[Ψ]Warped Strikes (C)"
msgstr "[Ψ]뒤틀린 타격 (C)"

#. ~ Description of spell "teleport_warped_strikes ( [Ψ]Warped Strikes (C) )"
#: data/mods/MindOverMatter/powers/teleportation.json
msgid ""
"By warping space as you attack, you can allow your melee attacks to reach much further than normal.\n"
"\n"
"This power <color_yellow>is maintained by concentration</color> and <color_red>may fail</color> if <color_yellow>concentration is interrupted</color>."
msgstr ""
"공격 시 공간을 왜곡하면 근접 공격이 평소보다 훨씬 더 멀리까지 도달할 수 있습니다.\n"
"\n"
"이 능력은 <color_ylow>집중을 통해 유지되며</color>, <color_ylow>집중이 방해받으면</color> <color_red>실패할 수 있습니다</color>."

#. ~ Name of spell "teleport_ephemeral_walk"
#: data/mods/MindOverMatter/powers/teleportation.json
msgid "[Ψ]Ephemeral Walk (C)"
msgstr "[Ψ]일시적인 산책 (C)"

#. ~ Description of spell "teleport_ephemeral_walk ( [Ψ]Ephemeral Walk (C) )"
#: data/mods/MindOverMatter/powers/teleportation.json
msgid ""
"By moving slightly into the void between dimensions, you can exist in a "
"state that allows effortless travel through obstacles."
msgstr "차원 사이의 공허 속으로 살짝만 이동하면, 장애물을 쉽게 통과할 수 있는 상태로 존재할 수 있습니다."

#. ~ Name of spell "teleport_farstep"
#. ~ Name of spell "teleport_farstep_real"
#: data/mods/MindOverMatter/powers/teleportation.json
msgid "[Ψ]Farstep"
msgstr "[Ψ]파스텝"

#. ~ Description of spell "teleport_farstep ( [Ψ]Farstep )"
#. ~ Description of spell "teleport_farstep_real ( [Ψ]Farstep )"
#: data/mods/MindOverMatter/powers/teleportation.json
msgid ""
"Skating along the void between dimensions, move to a specific place nearby.\n"
"\n"
"The power <color_red>will fail</color> if the volume of your carried gear is too great."
msgstr ""
"차원 사이의 공간을 따라 스케이트를 타며 근처의 특정 장소로 이동하세요.\n"
"\n"
"짐을 싣고 다니는 장비의 양이 너무 많으면 <color_red>능력이 저하됩니다</color>."

#. ~ Name of spell "teleport_banish"
#: data/mods/MindOverMatter/powers/teleportation.json
msgid "[Ψ]Oubliette"
msgstr "[Ψ]망각의 감옥"

#. ~ Description of spell "teleport_banish ( [Ψ]Oubliette )"
#: data/mods/MindOverMatter/powers/teleportation.json
msgid ""
"Teleport the target through the nether to some other dimension.  They are "
"technically not dead, but they are no longer your concern.  Oubliette will "
"occasionally fail when used against very powerful enemies, or succeed but "
"cause damage to the teleporter."
msgstr ""
"대상을 네더를 통해 다른 차원으로 순간이동시킵니다. 엄밀히 말하면 죽은 것은 아니지만, 더 이상 당신의 걱정거리는 아닙니다. 망각의 "
"감옥은 매우 강력한 적에게 사용하면 가끔 실패하거나, 성공하더라도 사용자에게 피해를 입힙니다."

#. ~ Name of spell "teleport_loci_establishment"
#: data/mods/MindOverMatter/powers/teleportation.json
msgid "[Ψ]Loci Establishment (C)"
msgstr "[Ψ]Loci 설립 (C)"

#. ~ Description of spell "teleport_loci_establishment ( [Ψ]Loci Establishment
#. (C) )"
#: data/mods/MindOverMatter/powers/teleportation.json
msgid ""
"Start concentrating on your current location, allowing you to return here at will with the [Ψ]Loci Technique power.\n"
"\n"
"This power <color_yellow>is maintained by concentration</color> and <color_red>may fail</color> if <color_yellow>concentration is interrupted</color>."
msgstr ""
"현재 위치에 집중하면 [Ψ]로시 테크닉 능력을 통해 원하는 대로 이곳으로 돌아올 수 있습니다.\n"
"\n"
"이 능력은 <color_yellow>집중을 통해 유지되며</color>, <color_yellow>집중이 방해받으면</color> <color_red>효과가 사라질 수 있습니다</color>."

#. ~ Name of spell "teleport_loci_technique"
#: data/mods/MindOverMatter/powers/teleportation.json
msgid "[Ψ]Loci Technique"
msgstr "[Ψ]기술 위치"

#. ~ Description of spell "teleport_loci_technique ( [Ψ]Loci Technique )"
#: data/mods/MindOverMatter/powers/teleportation.json
msgid ""
"Transport yourself through the nether to your established loci location.  "
"You must currently be concentrating on your [Ψ]Loci Establishment (C) for "
"this to function."
msgstr "네더를 통해 설정된 장소로 이동합니다. 이 기능을 사용하려면 현재 [Ψ]Loci 설정(C)에 집중해야 합니다."

#. ~ Name of spell "teleport_gateway"
#: data/mods/MindOverMatter/powers/teleportation.json
msgid "[Ψ]Gateway"
msgstr "[Ψ]게이트웨이"

#. ~ Description of spell "teleport_gateway ( [Ψ]Gateway )"
#: data/mods/MindOverMatter/powers/teleportation.json
msgid ""
"Transport yourself through the Nether to an attuned location.  You must attune yourself to the place you wish to travel to.\n"
"\n"
"The power <color_red>will fail</color> if the volume of your carried gear is too great."
msgstr ""
"네더를 통해 조율된 장소로 순간이동합니다. 이동하려는 장소에 맞춰 조율해야 합니다.\n"
"\n"
"짐을 너무 많이 싣고 다니면 <color_red>능력이 사라집니다</color>."

#. ~ Name of spell "teleport_dilated_gateway"
#: data/mods/MindOverMatter/powers/teleportation.json
msgid "[Ψ]Dilated Gateway"
msgstr "[Ψ]확장된 관문"

#. ~ Description of spell "teleport_dilated_gateway ( [Ψ]Dilated Gateway )"
#: data/mods/MindOverMatter/powers/teleportation.json
msgid ""
"Transport yourself and every adjacent creature to a chosen location.  You "
"must have already attuned an area with [Ψ]Gateway."
msgstr "자신과 주변의 모든 생명체를 선택한 위치로 순간이동시킵니다. 해당 지역에는 이미 [Ψ]게이트웨이가 설정되어 있어야 합니다."

#. ~ Name of spell "teleport_summon"
#: data/mods/MindOverMatter/powers/teleportation.json
msgid "[Ψ]Breach"
msgstr "[Ψ]침해"

#. ~ Description of spell "teleport_summon ( [Ψ]Breach )"
#: data/mods/MindOverMatter/powers/teleportation.json
msgid ""
"Open a brief passage to the Nether using yourself or an enemy as an anchor and allow one (or more) of its inhabitants to come through.  You have no control over what finds the doorway and no ability to command it when it arrives.\n"
"\n"
"Remember that some denizens of the Nether die instantly in sunlight."
msgstr ""
"자신이나 적을 닻으로 삼아 네더로 통하는 짧은 통로를 열고, 네더 주민 한 명(또는 그 이상)이 통과할 수 있도록 하세요. 문으로 무엇이 들어오는지 통제할 수 없으며, 문이 도착했을 때 통제할 수 없습니다.\n"
"\n"
"네더의 일부 주민은 햇빛에 즉사한다는 점을 명심하세요."

#. ~ Name of spell "teleport_warper_combat"
#: data/mods/MindOverMatter/powers/teleportation.json
msgid "[Ψ]Flickerflash Stance"
msgstr "[Ψ]플리커플래시 스탠스"

#. ~ Description of spell "teleport_warper_combat ( [Ψ]Flickerflash Stance )"
#: data/mods/MindOverMatter/powers/teleportation.json
msgid ""
"Through constant contraction and expansion of nearby space, as well as near-constant micro-teleports less than decimeter in distance, you can increase the effective momentum behind your strikes, make your exact position nearly impossible to determine, and your blows nearly impossible to stop.\n"
"\n"
"This power <color_yellow>is maintained by concentration</color> and <color_red>may fail</color> if <color_yellow>concentration is interrupted</color>.  It requires <color_yellow>even more concentration</color> than usual."
msgstr ""
"주변 공간의 지속적인 수축과 팽창, 그리고 데시미터 미만의 거의 일정한 마이크로 순간이동을 통해, 당신은 타격의 유효 추진력을 증가시키고, 정확한 위치를 파악하는 것을 거의 불가능하게 만들며, 타격을 멈추는 것을 거의 불가능하게 만들 수 있습니다.\n"
"\n"
"이 힘은 <color_yellow>집중을 통해</color> 유지되며, <color_yellow>집중이 방해받으면</color> <color_red>실패할 수 있습니다</color>. 평소보다 <color_yellow>더욱 강한 집중</color>이 필요합니다."

#. ~ Name of spell "teleport_reality_tear"
#: data/mods/MindOverMatter/powers/teleportation.json
msgid "[Ψ]Reality Tear"
msgstr "[Ψ]현실의 균열"

#. ~ Description of spell "teleport_reality_tear ( [Ψ]Reality Tear )"
#: data/mods/MindOverMatter/powers/teleportation.json
msgid ""
"Make your own contribution to the Cataclysm by opening a rift in reality, "
"allowing all manners of netherium creatures access to Earth.  The rift is "
"temporary…hopefully."
msgstr ""
"현실에 균열을 만들어 온갖 네테리움 생명체가 지구로 들어올 수 있도록 함으로써 대격변에 당신만의 기여를 하세요. 균열은 일시적일 "
"뿐이지만… 바라건대 말입니다."

#. ~ Player message in effect in EoC "EOC_TELEPORT_STRIDE_INITIATE"
#: data/mods/MindOverMatter/powers/teleportation_concentration_eoc.json
msgid "Your steps are taking you further than your eyes tell you they should."
msgstr "당신의 발걸음은 눈이 말하는 것보다 더 멀리 가고 있습니다."

#. ~ Player message in effect in EoC "EOC_TELEPORT_WARPED_STRIKES_INITIATE"
#: data/mods/MindOverMatter/powers/teleportation_concentration_eoc.json
msgid "You are ready to momentarily warp space to coincide with your attacks."
msgstr "이제 공격에 맞춰 잠시 공간을 뒤틀 준비가 되었습니다."

#. ~ Player message in effect in EoC "EOC_TELEPORT_EPHEMERAL_WALK_INITIATE"
#: data/mods/MindOverMatter/powers/teleportation_concentration_eoc.json
msgid ""
"You feel a strange coolness as matter around you feels somehow less solid."
msgstr "당신은 주변 물질이 덜 견고하다는 느낌과 함께 이상한 차가움을 느낍니다."

#. ~ Player message in effect in EoC
#. "EOC_TELEPORT_REACTIVE_DISPLACEMENT_INITIATE"
#: data/mods/MindOverMatter/powers/teleportation_concentration_eoc.json
msgid "You are prepared to displace your attackers."
msgstr "당신은 공격자들을 물리칠 준비가 되어 있습니다."

#. ~ Player message in effect in EoC
#. "EOC_TELEPORT_LOCI_ESTABLISHMENT_INITIATE"
#: data/mods/MindOverMatter/powers/teleportation_concentration_eoc.json
msgid "You've established a locus to return to later."
msgstr "나중에 돌아갈 장소를 마련했습니다."

#. ~ Player message in effect in EoC "EOC_TELEPORT_WARPER_COMBAT_INITIATE"
#: data/mods/MindOverMatter/powers/teleportation_concentration_eoc.json
msgid "The world jerks as you start continually blinking from place to place."
msgstr "당신이 계속해서 눈을 깜빡거리며 이곳저곳을 돌아다니기 시작하면 세상이 흔들립니다."

#. ~ Player message in effect in EoC
#. "EOC_TELEPORT_SELF_CARRIED_VOLUME_CHECKER"
#: data/mods/MindOverMatter/powers/teleportation_eoc.json
msgid "Your carried volume is <u_val:teleport_total_carried_volume>."
msgstr "당신이 휴대하는 용량은 <u_val:teleport_total_carried_volume>입니다."

#. ~ Player message in effect in EoC "EOC_TELEPORT_BLINK_INITIATE"
#: data/mods/MindOverMatter/powers/teleportation_eoc.json
msgid "Your Blink volume limit is <context_val:teleport_blink_limit>."
msgstr "Blink 볼륨 제한은 <context_val:teleport_blink_limit>입니다."

#. ~ Player message in nested effect in then statement in effect in EoC
#. "EOC_TELEPORT_BLINK_INITIATE"
#: data/mods/MindOverMatter/powers/teleportation_eoc.json
msgid "You vanish and reappear nearby."
msgstr "당신은 사라졌다가 근처에 다시 나타납니다."

#. ~ Player message in nested effect in else statement in effect in EoC
#. "EOC_TELEPORT_BLINK_INITIATE"
#: data/mods/MindOverMatter/powers/teleportation_eoc.json
msgid ""
"You attempt to teleport to somewhere nearby, but your skin merely tingles "
"and nothing happens.  You're carrying too much."
msgstr "근처 어딘가로 순간이동을 시도하지만, 살갗이 따끔거릴 뿐 아무 일도 일어나지 않습니다. 짐이 너무 많네요."

#. ~ Player message in effect in EoC "EOC_TELEPORT_PHASE_INITIATE"
#: data/mods/MindOverMatter/powers/teleportation_eoc.json
msgid "Your Phase volume limit is <context_val:teleport_blink_limit>."
msgstr "귀하의 위상 볼륨 한도는 <context_val:teleport_blink_limit>입니다."

#. ~ Player message in nested effect in then statement in effect in EoC
#. "EOC_TELEPORT_PHASE_INITIATE"
#: data/mods/MindOverMatter/powers/teleportation_eoc.json
msgid ""
"There is a brief moment of darkness and terrible cold, and you are somewhere"
" else."
msgstr "잠시 어둠과 끔찍한 추위가 찾아오고, 당신은 다른 어딘가에 도착합니다."

#. ~ Player message in nested effect in else statement in effect in EoC
