msgid_plural "medium steel chainmail sleeves (pair)"
msgstr[0] "중간 강철 쇠사슬 갑옷 소매 (한 쌍)"

#. ~ Item name
#: data/json/items/armor/arms_armor.json
msgid "high steel chainmail sleeves (pair)"
msgid_plural "high steel chainmail sleeves (pair)"
msgstr[0] "고강도 강철 쇠사슬 갑옷 소매 (한 쌍)"

#. ~ Item name
#: data/json/items/armor/arms_armor.json
msgid "hardened steel chainmail sleeves (pair)"
msgid_plural "hardened steel chainmail sleeves (pair)"
msgstr[0] "경화 강철 쇠사슬 갑옷 소매 (한 쌍)"

#. ~ Item name
#: data/json/items/armor/arms_armor.json
msgid "tempered steel chainmail sleeves (pair)"
msgid_plural "tempered steel chainmail sleeves (pair)"
msgstr[0] "강화 강철 쇠사슬 갑옷 소매 (한 쌍)"

#. ~ Item name
#: data/json/items/armor/arms_armor.json
msgid "elbow pads (pair)"
msgid_plural "elbow pads (pair)"
msgstr[0] "팔꿈치 보호대 (한 쌍)"

#. ~ Description of "elbow pads (pair)"
#: data/json/items/armor/arms_armor.json
msgid "A pair of elbow pads made of stout plastic and cloth."
msgstr "천과 플라스틱으로 만들어진, 팔꿈치 보호용 패드."

#. ~ Item name
#: data/json/items/armor/arms_armor.json
msgid "bronze vambraces (pair)"
msgid_plural "bronze vambraces (pair)"
