"\n"
"탈출 포드 제어:"

#. ~ Response to NPC dialogue
#: data/mods/aftershock_exoplanet/npcs/computers/escape_pod_control.json
msgid "Ready escape pod."
msgstr "탈출 포드 준비 완료."

#. ~ NPC dialogue line
#: data/mods/aftershock_exoplanet/npcs/computers/escape_pod_control.json
msgid ""
"&************************************************\n"
"\n"
"INTEGRITY CHK : ███████████████ 100% (COMPLETE)\n"
"NAV TRANSFER :  ███████████████ 100% (COMPLETE)\n"
