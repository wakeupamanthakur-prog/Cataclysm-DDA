msgstr "RC카에 %s(을)를 장착했습니다."

#: src/iuse.cpp:7031
#, c-format
msgid "You want to arm your RC car with %s?  But how?"
msgstr "RC카에 %s을(를) 장착하고 싶으신가요? 하지만 어떻게?"

#: src/iuse.cpp:7034
#, c-format
msgid "Your %s is too heavy or bulky for this RC car."
msgstr "%s(은)는 이 RC카에는 너무 무겁거나 큽니다."

#: src/iuse.cpp:7044
msgid "You disarmed your RC car."
msgstr "RC카의 무장을 해제했다."

#: src/iuse.cpp:7059
msgid "What to do with your activated RC car?"
msgstr "활성화된 RC카로 무엇을 할까요?"

