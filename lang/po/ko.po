msgstr "보낼 항목 선택"

#: src/faction_camp.cpp:2466 src/faction_camp.cpp:2511
#: src/faction_camp.cpp:2524
msgid "These are the items you've selected so far."
msgstr "지금까지 선택한 항목들입니다."

#: src/faction_camp.cpp:2480
msgid "departs to build a hide site…"
msgstr "(이)가 은신처를 설치하러 떠납니다…"

