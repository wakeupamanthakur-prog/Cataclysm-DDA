#: src/iexamine.cpp:2262
msgid "You decided to leave the petrified eye on the pedestal…"
msgstr "돌 눈 조각을 받침대에 그대로 두기로 합니다…"

#: src/iexamine.cpp:2281
msgid "Place your petrified eye on the pedestal?"
msgstr "가지고 있는 돌 눈 조각을 받침대 위에 올려두겠습니까?"

#: src/iexamine.cpp:2287
msgid ""
"This pedestal is engraved in eye-shaped diagrams, and has a large semi-"
"spherical indentation at the top."
msgstr "이 받침대는 눈 모양의 도형이 새겨져 있고, 맨 위에는 큰 반구 형태의 흔적이 있습니다."

#: src/iexamine.cpp:2303
msgid "You cannot look through the peephole from the outside."
msgstr "바깥에서는 렌즈 구멍을 통해 안을 들여다 볼 수 없습니다."

#: src/iexamine.cpp:2310
msgid "Do what with the door?"
msgstr "문에 무엇을 합니까?"

#: src/iexamine.cpp:2311
msgid "Peek through peephole."
msgstr "렌즈 구멍으로 엿보기."

#: src/iexamine.cpp:2312
msgid "Open door."
msgstr "문 열기."

#: src/iexamine.cpp:2317
msgid "You peek through the peephole."
msgstr "렌즈 구멍으로 엿봅니다."

#: src/iexamine.cpp:2320
msgid "You open the door."
msgstr "문을 열었습니다."

#: src/iexamine.cpp:2329
#, c-format
msgid "Flip the %s?"
msgstr "%s(을)를 누릅니까?"

#: src/iexamine.cpp:2389
msgid "You hear the rumble of rock shifting."
msgstr "돌이 움직이는 소리가 들립니다."

#: src/iexamine.cpp:2400
msgid "This flower is dead.  You can't get it."
msgstr "이 꽃은 죽었습니다. 가져갈 수 없습니다."

#: src/iexamine.cpp:2402
msgid "This plant is dead.  You can't get it."
msgstr "이 식물은 죽었습니다. 가져갈 수 없습니다."

#: src/iexamine.cpp:2428
msgid "You drink some nectar."
msgstr "꽃꿀을 조금 마십니다."

#: src/iexamine.cpp:2449
#, c-format
msgid "You harvest: %s."
msgstr "수확: %s"

#: src/iexamine.cpp:2452
#, c-format
msgid "You harvest and drop: %s."
msgstr "수확한 후 땅에 버립니다: %s."

#: src/iexamine.cpp:2471
#, c-format
msgid "You feel woozy as you explore the %s. Drink?"
msgstr "%s(을)를 조사하다 보니 머리가 멍해집니다. 마십니까?"

#: src/iexamine.cpp:2475
msgid "You slowly suck up the nectar."
msgstr "천천히 꽃꿀을 빨아 먹었습니다."

#: src/iexamine.cpp:2485 src/iexamine.cpp:2528 src/iexamine.cpp:2562
#: src/iexamine.cpp:2684
#, c-format
msgid "Pick %s?"
msgstr "%s에서 채집합니까?"

#: src/iexamine.cpp:2494
msgid "This flower has a heady aroma."
msgstr "이 꽃에선 황홀한 향기가 난다."

#: src/iexamine.cpp:2504
msgid "The flower's fragrance makes you extremely drowsy…"
msgstr "꽃 향기가 당신을 극도로 졸리게 합니다…"

#: src/iexamine.cpp:2506
msgid "Your legs are covered in the poppy's roots!"
msgstr "다리가 양귀비 뿌리로 뒤덮였습니다!"

#: src/iexamine.cpp:2534
msgid "The cactus' nettles sting you!"
msgstr "선인장의 가시에 찔립니다!"

#: src/iexamine.cpp:2567
#, c-format
msgid "You don't have a digging tool to dig up roots.  Pick %s anyway?"
msgstr "뿌리를 파낼 도구가 없습니다. 그래도 %s(을)를 수확합니까?"

#: src/iexamine.cpp:2595 src/iexamine.cpp:2663
msgid "Nothing can be harvested from this plant in current season."
msgstr "이 계절에는 식물에서 수확할 수 있는 것이 없습니다."

#: src/iexamine.cpp:2602 src/iexamine.cpp:2604
#, c-format
msgid "Pick %1$s?"
msgstr "%1$s(을)를 수확합니까?"

#: src/iexamine.cpp:2670
msgid "This flower is still alive, despite the harsh conditions…"
msgstr "혹독한 환경에도 불구하고 이 꽃은 여전히 살아있습니다…"

#: src/iexamine.cpp:2674
#, c-format
msgid "You feel out of place as you explore the %s. Drink?"
msgstr "%s (을)를 조사하다 보니 얼떨떨하고 갑자기 세상이 낯설게 느껴집니다. 마십니까?"

#: src/iexamine.cpp:2680
msgid "This flower tastes very wrong…"
msgstr "이 꽃은 뭔가 잘못된 맛이 납니다…"

#: src/iexamine.cpp:2699
#, c-format
msgid "The %s crumbles into spores!"
msgstr "%s(이)가 포자로 부서집니다!"

#: src/iexamine.cpp:2738
msgid "Use which seed?"
msgstr "어떤 씨앗을 사용합니까?"

#: src/iexamine.cpp:2783 src/mission_companion.cpp:1557
msgid "You have no seeds to plant."
msgstr "심을 수 있는 씨앗이 없습니다."

#: src/iexamine.cpp:2787
msgid "Something's lying there…"
msgstr "무언가가 있다…"

#: src/iexamine.cpp:2797 src/mission_companion.cpp:1576
msgid "You saved your seeds for later."
msgstr "나중에 쓰기 위해 씨앗을 보관해두었습니다."

#: src/iexamine.cpp:2809
msgid "This type of seed can not be planted in this location."
msgstr "이런 종류의 씨앗은 이 위치에 심을 수 없습니다."

#: src/iexamine.cpp:2881
msgid "You pull up what's left of the planted crop and trample the rest."
msgstr "심어진 작물의 남은 부분을 뽑아내고 나머지는 짓밟습니다."

#: src/iexamine.cpp:2936
msgid ""
"We have altered this unit's configuration to extract and provide local "
"nutriment.  The Mycus provides."
msgstr "우리는 이 개체로 하여금 현지 영양을 추출 및 제공할 수 있도록 변화시켰습니다. 마이커스는 제공합니다."

#: src/iexamine.cpp:2941
msgid "The seed blooms forth!  We have brought true beauty to this world."
msgstr "씨앗이 피어납니다! 우리는 이 세상에 진정한 아름다움을 가져왔습니다."

#: src/iexamine.cpp:2944
msgid "The seed blossoms rather rapidly…"
msgstr "씨앗이 빠르게 피어납니다…"

#: src/iexamine.cpp:2947
msgid "The seed blossoms into a flower-looking fungus."
msgstr "씨앗이 꽃처럼 생긴 진균으로 피어납니다."

#: src/iexamine.cpp:2952
msgid "You will need a grass-cutting tool to harvest this plant."
msgstr "이 식물을 수확하려면 풀베는 도구가 필요합니다."

#: src/iexamine.cpp:2979
msgid "You harvest the plant."
msgstr "식물을 수확합니다."

#: src/iexamine.cpp:2989
msgid "Tile isn't a plant"
msgstr "이 타일은 식물이 아닙니다."

#: src/iexamine.cpp:2992
msgid "Tile is already fertilized"
msgstr "이 타일에 이미 비료를 주었습니다"

#: src/iexamine.cpp:2997
#, c-format
msgid "Tried to fertilize with %s, but player doesn't have any."
msgstr "%s(을)를 비료로 뿌리려 했지만, 플레이어가 가지고 있는 것이 ㅇ벗습니다."

#. ~ %1$s: plant name, %2$s: fertilizer name
#: src/iexamine.cpp:3049
#, c-format
msgid "You fertilize the %1$s with the %2$s."
msgstr "%1$s에 %2$s(을)를 뿌립니다."

#: src/iexamine.cpp:3058
#, c-format
msgid "You have no fertilizer for the %s."
msgstr "%s에 뿌릴 비료가 없습니다."

#: src/iexamine.cpp:3071
#, c-format
msgid "Fertilize the %s"
msgstr "%s에 비료주기"

#: src/iexamine.cpp:3078
msgid "Use which fertilizer?"
msgstr "어떤 비료를 쓸까요?"

#: src/iexamine.cpp:3106 src/iexamine.cpp:4585
#, c-format
msgid "Harvest the %s?"
msgstr "%s(을)를 수확합니까?"

#: src/iexamine.cpp:3110
#, c-format
msgid "This %s has already been fertilized."
msgstr "%s에 이미 비료를 주었습니다."

#: src/iexamine.cpp:3141
#, c-format
msgid "This %s is ready to be fired, but you have no fire source."
msgstr "이 %s은(는 발사 준비가 되었지만, 화원이 없습니다."

#: src/iexamine.cpp:3143
#, c-format
msgid "Fire the %s?"
msgstr "%s을(를) 발사하시겠습니까?"

#: src/iexamine.cpp:3165 src/iexamine.cpp:3752
msgid "Use a CBM to start a fire"
msgstr "바이오닉으로 불을 켜기"

#: src/iexamine.cpp:3176 src/iexamine.cpp:3774
#, c-format
msgid "You attempt to start a fire with your %s…"
msgstr "%s(으)로 불을 지피려고 시도합니다…"

#: src/iexamine.cpp:3220
msgid "This kiln already contains charcoal."
msgstr "이 가마에는 이미 숯이 담겨있습니다."

#: src/iexamine.cpp:3221
msgid "Remove it before firing the kiln again."
msgstr "불을 다시 붙이기 전에 가마를 비워야 합니다."

#: src/iexamine.cpp:3226
#, c-format
msgid "This kiln contains %s, which can't be made into charcoal!"
msgstr "이 가마에는 숯으로 만들 수 없는 %s(이)가 담겨있습니다!"

#: src/iexamine.cpp:3233
msgid "This kiln is empty.  Fill it with wood or bone and try again."
msgstr "이 가마는 비어있습니다. 나무나 뼈를 채운 후 다시 시도해야 합니다."

#: src/iexamine.cpp:3287
msgid "The batch in this kiln is too small to yield any charcoal."
msgstr "가마에 채운 양이 너무 적어 목탄을 만들 수 없습니다."

#: src/iexamine.cpp:3318
msgid "This kiln is empty…"
msgstr "이 가마는 비어있습니다…"

#: src/iexamine.cpp:3323
msgid "There's a charcoal kiln there."
msgstr "목탄 가마가 있습니다."

#: src/iexamine.cpp:3331 src/iexamine.cpp:3463
#, c-format
msgid "It will finish burning in about %d hour."
msgid_plural "It will finish burning in about %d hours."
msgstr[0] "약 %d 시간 후 연소가 완료될 것입니다."

#: src/iexamine.cpp:3335 src/iexamine.cpp:3467
msgid "It will finish burning in less than an hour."
msgstr "한 시간 안에 연소가 완료될 것입니다."

#: src/iexamine.cpp:3337 src/iexamine.cpp:3469
#, c-format
msgid "It should take about %d minute to finish burning."
msgid_plural "It should take about %d minutes to finish burning."
msgstr[0] "약 %d 분 뒤에 연소가 완료될 것입니다."

#: src/iexamine.cpp:3359
#, c-format
msgid "It has finished burning, yielding %d charcoal."
msgstr "연소가 완료되었으며 %d 만큼의 목탄을 생산했습니다."

#: src/iexamine.cpp:3381
msgid "This furnace already contains calcium carbide."
msgstr "이 화로에는 이미 탄화칼슘이 들어 있습니다."

#: src/iexamine.cpp:3382
msgid "Remove it before activating the arc furnace again."
msgstr "아크 용광로를 다시 작동시키기 전에 먼저 빼내세요."

#: src/iexamine.cpp:3387
#, c-format
msgid "This furnace contains %s, which can't be made into calcium carbide!"
msgstr "이 용광로에는 탄화칼슘으로 만들 수 없는 %s(이)가 들어 있습니다!"

#: src/iexamine.cpp:3394
msgid ""
"This furnace is empty.  Fill it with powdered coke and lime mix, and try "
"again."
msgstr "이 화로는 비어있습니다.  석탄과 석회석 가루 혼합물을 채워넣고 다시 시도하세요."

#: src/iexamine.cpp:3412
msgid ""
"The batch in this furnace is too small to yield usable calcium carbide."
msgstr "이 용광로의 배치는 너무 작아서 사용할 수 있는 탄화칼슘을 생산할 수 없습니다."

#: src/iexamine.cpp:3417
msgid ""
"This furnace is ready to be turned on, but you lack a UPS with sufficient "
"power."
msgstr "화로는 준비되었지만, 충분히 충전된 UPS가 없습니다."

#: src/iexamine.cpp:3420
#, c-format
msgid "This furnace contains %s %s of material, and is ready to be turned on."
msgstr "이 화로에는 %s %s(이)가 들어있고 작동할 준비가 되어있습니다."

#: src/iexamine.cpp:3422
msgid "Turn on the furnace?"
msgstr "용광로를 작동시킵니까?"

#: src/iexamine.cpp:3433
msgid "You turn on the furnace."
msgstr "용광로를 작동시킵니다."

#: src/iexamine.cpp:3451
msgid "This furnace is empty…"
msgstr "용광로가 비어있습니다…"

#: src/iexamine.cpp:3456
msgid "There's an arc furnace there."
msgstr "아크 용광로가 있습니다."

#: src/iexamine.cpp:3491
#, c-format
msgid "It has finished burning, yielding %d calcium carbide."
msgstr "연소가 완료되었으며 %d 만큼의 탄화 칼슘을 생산했습니다."

#: src/iexamine.cpp:3514
#, c-format
msgid "This pile contains %s, which can't be dried here!"
msgstr "이 더미에는 %s이(가) 포함되어 있으며, 여기서는 건조할 수 없습니다!"

#: src/iexamine.cpp:3521
msgid "Place some fresh grain here and try again."
msgstr "여기에 신선한 곡물을 놓고 다시 시도하십시오."

#: src/iexamine.cpp:3524
msgid "The stook will need to be set up outside to dry."
msgstr "곡물 더미는 건조를 위해 밖에 설치해야 합니다."

#: src/iexamine.cpp:3527
msgid "This pile contains grain that is ready to be left out for drying."
msgstr "이 더미에는 건조를 위해 밖에 놓을 준비가 된 곡물이 포함되어 있습니다."

#: src/iexamine.cpp:3528
msgid "Stand the grain up to dry?"
msgstr "곡물을 세워서 말리시겠습니까?"

#: src/iexamine.cpp:3534
msgid "You set up the stook and leave it to dry."
msgstr "곡물 더미를 설치하고 건조되도록 둡니다."

#: src/iexamine.cpp:3551
msgid "Examined furniture is stook_full but doesn't contain any grain."
msgstr "조사된 가구는 stook_full이지만 곡물을 포함하고 있지 않습니다."

#: src/iexamine.cpp:3555
msgid "There's a grain stook there."
msgstr "거기에 곡물 더미가 있습니다."

#: src/iexamine.cpp:3561
#, c-format
msgid "The stook will finish drying in %s."
msgstr "곡물 더미는 %s에 건조가 완료됩니다."

#: src/iexamine.cpp:3577
msgid "You take down the stook as the drying process is now finished."
msgstr "건조 과정이 완료되어 곡물 더미를 내립니다."

#: src/iexamine.cpp:3607 src/iexamine.cpp:3667
msgid "This autoclave is empty…"
msgstr "오토클레이브가 비어있습니다…"

#: src/iexamine.cpp:3612
msgid ""
"You need to remove all non-CBM items from the autoclave to start the "
"program."
msgstr "오토클레이브에서 바이오닉이 아닌 물건을 모두 빼내야 멸균 절차를 시작할 수 있습니다."

#: src/iexamine.cpp:3617
msgid ""
"Some of those CBMs are filthy, you should wash them first for the "
"sterilization process to work properly."
msgstr "CBM 중 몇 개는 오염되었고, 제대로 작동하려면 살균 절차를 거쳐야 합니다."

#: src/iexamine.cpp:3627
msgid "Start the autoclave?"
msgstr "오토클레이브를 작동시킵니까?"

#: src/iexamine.cpp:3640
msgid "You start the autoclave."
msgstr "오토클레이브를 작동시킵니다."

#: src/iexamine.cpp:3673
msgid "ERROR Autoclave can't process non CBM items."
msgstr "오류! 바이오닉이 아닌 물건을 멸균할 수 없음."

#: src/iexamine.cpp:3676
msgid "The autoclave is running."
msgstr "오토클레이브가 작동중입니다."

#: src/iexamine.cpp:3683
#, c-format
msgid "The cycle will be complete in %s."
msgstr "%s 뒤에 절차가 완료됩니다."

#: src/iexamine.cpp:3693
msgid "The cycle is complete, the CBMs are now sterile."
msgstr "사이클이 끝났습니다. CBM이 멸균되었습니다."

#: src/iexamine.cpp:3697
msgid ""
"CBMs in direct contact with the environment will almost immediately become "
"contaminated."
msgstr "외부 환경에 노출된 바이오닉은 거의 즉시 오염됩니다."

#: src/iexamine.cpp:3743 src/iexamine.cpp:3910 src/iexamine.cpp:4139
#: src/iexamine.cpp:4744 src/vehicle_use.cpp:2617
msgid "Select an action"
msgstr "행동 선택"

#. ~ Key binding name
#: src/iexamine.cpp:3746 src/iexamine.cpp:7545 src/vehicle_use.cpp:2367
#: data/raw/keybindings/vehicle.json
msgid "Get items"
msgstr "물건 줍기"

#: src/iexamine.cpp:3750
msgid "Start a fire"
msgstr "불 지피기"

#: src/iexamine.cpp:3750
msgid "Start a fire… you'll need a fire source."
msgstr "불을 지필 도구가 필요합니다."

#: src/iexamine.cpp:3755
msgid "Extinguish fire"
msgstr "불 끄기"

#: src/iexamine.cpp:3757
msgid "Extinguish fire (bashing item required)"
msgstr "불 끄기 (타격 유형 물품이 필요합니다)"

#: src/iexamine.cpp:3760 src/iexamine.cpp:7548
#, c-format
msgid "Take down the %s"
msgstr "%s 넘어트리기 "

#: src/iexamine.cpp:3784
msgid "You weren't able to start a fire."
msgstr "불을 피우지 못했습니다."

#: src/iexamine.cpp:3792
msgid "You can't light a fire there."
msgstr "여기에는 불을 피울 수 없습니다."

#: src/iexamine.cpp:3798
#, c-format
msgid "Really take down the %s while it's on fire?"
msgstr "정말로 불이 붙은 상태에서 %s(을)를 넘어트립니까?"

#: src/iexamine.cpp:3812
#, c-format
msgid "With a few determined moves you put out the fire in the %s."
msgstr "몇 번의 결단력 있는 움직임으로 %s 안의 불을 끕니다."

#: src/iexamine.cpp:3869
msgid "This keg is empty."
msgstr "통이 비어있습니다."

#: src/iexamine.cpp:3873
msgid "You have no brew to ferment."
msgstr "발효할 수 있는 것이 없습니다."

#: src/iexamine.cpp:3889
msgid "Use which brew?"
msgstr "어떤 것을 발효합니까?"

#: src/iexamine.cpp:3891
#, c-format
msgid "Set %s in the vat?"
msgstr "발효통 안에 %s(을)를 넣습니까?"

#: src/iexamine.cpp:3906
#, c-format
msgid "This keg contains %s (%d), %0.f%% full."
msgstr "이 발효통의 내용물은 %s (%d)이며, 현재 %0.f%%만큼 차있습니다."

#: src/iexamine.cpp:3912
#, c-format
msgid "Add more %s to the vat"
msgstr "발효통에 %s 더 붓기"

#: src/iexamine.cpp:3914
#, c-format
msgid "Remove %s from the vat"
msgstr "발효통에서 %s 빼내기"

#: src/iexamine.cpp:3915
msgid "Start fermenting cycle"
msgstr "발효 시작하기"

#: src/iexamine.cpp:3947
#, c-format
msgid "Set %s in the vat."
msgstr "발효통 안에 %s(을)를 넣었습니다."

#: src/iexamine.cpp:3948
#, c-format
msgid "The keg now contains %s (%d), %0.f%% full."
msgstr "이제 이 발효통의 내용물은 %s (%d)이며, 현재 %0.f%%만큼 차있습니다."

#: src/iexamine.cpp:3955
msgid "Start fermenting cycle?"
msgstr "발효를 시작합니까?"

#: src/iexamine.cpp:3962
