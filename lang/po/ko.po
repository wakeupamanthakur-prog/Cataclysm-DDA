msgstr "이 쌍은 얼룩말 줄무늬 패턴을 가지고 있습니다."

#. ~ Variant name of item "leggings"
#: data/json/items/armor/legs_clothes.json
msgid "leopard print leggings"
msgid_plural "leopard print leggings"
msgstr[0] "표범 무늬 레깅스"

#. ~ Description of variant "leopard print leggings" of item "leggings"
#: data/json/items/armor/legs_clothes.json
