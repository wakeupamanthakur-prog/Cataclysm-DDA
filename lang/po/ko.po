#: data/json/items/armor/suits_protection.json
msgid "You turn the climate control on."
msgstr "기후 조절 장치를 켭니다."

#. ~ "need_charges_msg" action message of item "nomad plate armor"
#. ~ "need_charges_msg" action message of item "nomad light plate armor"
#. ~ "need_charges_msg" action message of item "nomad heavy plate armor"
#. ~ "need_charges_msg" action message of item "nomad chainmail"
#. ~ "need_charges_msg" action message of item "advanced nomad jumpsuit"
