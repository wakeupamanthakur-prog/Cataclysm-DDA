msgstr "작업장"

#. ~ Graffiti placed on map crashing_ship_3, crashing_ship_2, crashing_ship_1,
#. crashing_ship_6, crashing_ship_5, crashing_ship_4, crashing_ship_9,
#. crashing_ship_8, crashing_ship_7
#: data/mods/aftershock_exoplanet/maps/mapgen/crashing_ship.json
msgid "Shuttle Bay 01"
msgstr "셔틀 베이 01"

#. ~ Graffiti placed on map crashing_ship_3, crashing_ship_2, crashing_ship_1,
#. crashing_ship_6, crashing_ship_5, crashing_ship_4, crashing_ship_9,
#. crashing_ship_8, crashing_ship_7
#: data/mods/aftershock_exoplanet/maps/mapgen/crashing_ship.json
msgid "Escape Pods & Vehicle Bay"
msgstr "탈출 포드 및 차량실"

#. ~ Computer name placed on map afs_freight_transport_a1,
#. afs_freight_transport_a2
#: data/mods/aftershock_exoplanet/maps/mapgen/freight_transport.json
msgid "MALAMUTE REACTOR CONTROL"
msgstr "말라뮤트 반응기 제어"

#. ~ Interactive menu name in computer "MALAMUTE REACTOR CONTROL" placed on
#. map afs_freight_transport_a1, afs_freight_transport_a2
