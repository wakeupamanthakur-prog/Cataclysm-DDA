msgstr "가장자리가 들쭉날쭉하고 뒤틀린 금속판 조각입니다. "

#. ~ Item name
#: data/json/items/generic.json
msgid "clay flower pot"
msgid_plural "clay flower pots"
msgstr[0] "점토 꽃 화분"

#. ~ Description of "clay flower pot"
#: data/json/items/generic.json
