msgstr "기타 금속 또는 석재 비트로 구성된 준비된 Blunderbuss 샷."

#. ~ Item name
#: data/json/items/handloaded_bullets.json
msgid "blunderbuss shot"
msgid_plural "blunderbuss shot"
msgstr[0] "나팔총 산탄"

#. ~ Description of "blunderbuss shot"
