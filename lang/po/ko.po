#. ~ Item name
#: data/json/items/armor/legs_armor.json
msgid "mild steel heavy leg guard"
msgid_plural "mild steel heavy leg guards"
msgstr[0] "연강 중량 다리 보호구"

#. ~ Description of "mild steel heavy leg guard"
#: data/json/items/armor/legs_armor.json
msgid ""
