msgid_plural "smart lamps (on)"
msgstr[0] "스마트 램프 (켜짐)"

#. ~ Description of "smart lamp (on)"
#: data/json/items/tool/lighting.json
msgid ""
"A smart lamp which can be deactivated remotely.  Currently it is turned on."
msgstr "원격으로 비활성화할 수 있는 스마트 램프입니다. 현재 켜져 있습니다."

#. ~ "msg" action message of item "smart lamp (on)"
#: data/json/items/tool/lighting.json
msgid "Your smart lamp turned off."
msgstr "스마트 램프가 꺼졌습니다."

#. ~ Item name
