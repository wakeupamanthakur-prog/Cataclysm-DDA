#: data/json/zone_field_type.json
msgid "weapons loot zone"
msgstr "무기 전리품 구역"

#. ~ Field intensity level
#: data/json/zone_field_type.json
msgid "wood loot zone"
msgstr "나무 전리품 구역"

#. ~ Name of loot zone
#: data/json/zones.json
msgid "Auto Drink"
msgstr "음료 자동 섭취"

#. ~ Description of loot zone "Auto Drink"
#: data/json/zones.json
msgid ""
"Items in this zone will be automatically consumed during a long activity if "
"you get thirsty."
msgstr "장기간 활동 중에 목이 마르면 자동적으로 이 영역 내에 있는 음료를 마실 것입니다."

#. ~ Name of loot zone
#: data/json/zones.json
msgid "Auto Eat"
msgstr "음식 자동 섭취"

#. ~ Description of loot zone "Auto Eat"
#: data/json/zones.json
msgid ""
"Items in this zone will be automatically eaten during a long activity if you"
" get hungry."
msgstr "장기간 활동 중에 배가 고파지면 자동적으로 이 영역 내에 있는 음식을 먹을 것입니다."

#. ~ Name of loot zone
#: data/json/zones.json
msgid "Basecamp: Food"
msgstr "베이스캠프: 음식"

#. ~ Description of loot zone "Basecamp: Food"
#: data/json/zones.json
msgid ""
"Items in this zone will be added to a basecamp's food supply in the "
"Distribute Food mission."
msgstr "이 영역 내에 있는 물품들은 음식 공급 임무 중의 베이스캠프의 식량 공급에 더해집니다."

#. ~ Name of loot zone
#: data/json/zones.json
msgid "Basecamp: Storage"
msgstr "베이스캠프: 보관소"

#. ~ Description of loot zone "Basecamp: Storage"
#: data/json/zones.json
msgid ""
"Items in this zone will be added to a basecamp's inventory for use by its "
"workers."
msgstr "이 영역 내에 있는 물품들은 베이스캠프의 물품 목록에 더해져, 작업원들이 사용할 수 있습니다."

#. ~ Name of loot zone
#: data/json/zones.json
msgid "Chop Trees"
msgstr "벌목 지점"

#. ~ Description of loot zone "Chop Trees"
#: data/json/zones.json
msgid "Designate an area to chop down trees."
msgstr "영역 내 나무를 자동으로 벌채하고, 인근의 물품: 미분류 영역에 옮겨놓습니다."

#. ~ Name of loot zone
#: data/json/zones.json
msgid "Construction: Blueprint"
msgstr "건축: 청사진"

#. ~ Description of loot zone "Construction: Blueprint"
#: data/json/zones.json
msgid "Designate a blueprint zone for construction."
msgstr "건축을 위한 청사진 영역을 설정합니다."

#. ~ Name of loot zone
#: data/json/zones.json
msgid "Disassembly Work"
msgstr "분해 작업"

#. ~ Description of loot zone "Disassembly Work"
#: data/json/zones.json
msgid "Items in this zone are marked for disassembly."
msgstr "이 구역의 아이템은 해체 대상으로 표시됩니다."

#. ~ Name of loot zone
#: data/json/zones.json
msgid "Farm: Plot"
msgstr "농장: 텃밭"

#. ~ Description of loot zone "Farm: Plot"
#: data/json/zones.json
msgid "Designate a farm plot for tilling and planting."
msgstr "땅을 갈고 작물을 심을 곳을 설정합니다."

#. ~ Name of loot zone
#: data/json/zones.json
msgid "Fishing Spot"
msgstr "낚시 지점"

#. ~ Description of loot zone "Fishing Spot"
#: data/json/zones.json
msgid "Designate an area to fish from."
msgstr "물고기를 낚을 곳을 설정합니다."

#. ~ Name of loot zone
#: data/json/zones.json
msgid "Mine Terrain"
msgstr "채광 지점"

#. ~ Description of loot zone "Mine Terrain"
#: data/json/zones.json
msgid "Designate an area to mine."
msgstr "자동으로 채굴할 곳을 설정합니다."

#. ~ Name of loot zone
#: data/json/zones.json
msgid "Mop Tile"
msgstr "청소 지점"

#. ~ Description of loot zone "Mop Tile"
#: data/json/zones.json
msgid "Designate an area to mop clean."
msgstr "자동으로 청소할 곳을 설정합니다."

#. ~ Name of loot zone
#: data/json/zones.json
msgid "No Auto Pickup"
msgstr "자동 줍기 금지"

#. ~ Description of loot zone "No Auto Pickup"
#: data/json/zones.json
msgid "You won't auto-pickup items inside the zone."
msgstr "이 영역 내에 있는 물건들을 자동으로 줍지 않습니다."

#. ~ Name of loot zone
#: data/json/zones.json
msgid "No NPC Pickup"
msgstr "NPC 줍기 금지"

#. ~ Description of loot zone "No NPC Pickup"
#: data/json/zones.json
msgid "Friendly NPCs don't pickup items inside the zone."
msgstr "NPC는 이 영역 내에 있는 물건들을 자동으로 줍지 않습니다."

#. ~ Name of loot zone
#: data/json/zones.json
msgid "NPC Ignore Sounds"
msgstr "NPC 소리 무시"

#. ~ Description of loot zone "NPC Ignore Sounds"
#: data/json/zones.json
msgid "Friendly NPCs won't investigate unseen sounds coming from this zone."
msgstr "우호적인 NPC는 이 영역 내에서 발생하는 알 수 없는 소음을 조사하지 않을 것입니다."

#. ~ Name of loot zone
#: data/json/zones.json
msgid "NPC Investigation Area"
msgstr "NPC 조사 지점"

#. ~ Description of loot zone "NPC Investigation Area"
#: data/json/zones.json
msgid ""
"Friendly NPCs will investigate unseen sounds only if they come from inside "
"this area."
msgstr "우호적인 NPC는 이 영역 내에서 발생하는 알 수 없는 소음을 조사할 것입니다."

#. ~ Name of loot zone
#: data/json/zones.json
msgid "NPC Retreat"
msgstr "NPC 후퇴 지점"

#. ~ Description of loot zone "NPC Retreat"
#: data/json/zones.json
msgid ""
"When fleeing, friendly NPCs will attempt to retreat toward this zone if it "
"is within 60 tiles."
msgstr "도망치는 상황에서, 60타일 이내에 이 영역이 존재한다면 우호적인 NPC가 이곳으로 도망치려 시도할 것입니다."

#. ~ Name of loot zone
#: data/json/zones.json
msgid "Start Point"
msgstr "시작 지점"

#. ~ Description of loot zone "Start Point"
#: data/json/zones.json
msgid "A prioritized spawn point."
msgstr "우선순위가 부여된 생성 지점."

#. ~ Name of loot zone
#: data/json/zones.json
msgid "Source: Firewood"
msgstr "저장소: 장작"

#. ~ Description of loot zone "Source: Firewood"
#: data/json/zones.json
msgid ""
"Source for firewood or other flammable materials in this zone may be used to"
" automatically refuel fires.  This will be done to maintain light during "
"long-running tasks such as crafting, reading or waiting."
msgstr ""
"이 영역 내에 있는 장작이나 기타 태울 수 있는 물품은 불을 피웠을 때 자동적으로 그 연료로 소비될 것입니다. 제작, 독서, 대기 등의 "
"장기간에 걸친 행동 중에 광원을 유지하기 위해 행해집니다."

#. ~ Name of loot zone
#: data/json/zones.json
msgid "Vehicle Deconstruct Zone"
msgstr "차량 해체 지점"

#. ~ Description of loot zone "Vehicle Deconstruct Zone"
#: data/json/zones.json
msgid "Any vehicles in this area are marked for deconstruction."
msgstr "이 영역 내에 있는 모든 차량은 해체 대상으로 간주됩니다."

#. ~ Name of loot zone
#: data/json/zones.json
msgid "Vehicle Patrol Zone"
msgstr "차량 순찰 지역"

#. ~ Description of loot zone "Vehicle Patrol Zone"
#: data/json/zones.json
msgid "Vehicles with an autopilot will patrol in this zone."
msgstr "오토파일럿이 장착된 차량은 이 영역을 순찰할 것입니다."

#. ~ Name of loot zone
#: data/json/zones.json
msgid "Vehicle Repair Zone"
msgstr "차량 수리 지점"

#. ~ Description of loot zone "Vehicle Repair Zone"
#: data/json/zones.json
msgid "Any vehicles in this area are marked for repair work."
msgstr "이 영역 내에 있는 모든 차량은 수리 대상으로 간주됩니다."

#. ~ Message of spell "AO_FRIENDLY_VORTEX ( Artifact Vortex )"
#: data/json/artifact/altered_object_active.json
msgid "Space twists and deforms around you."
msgstr "주변 공간이 뒤틀리고 변형됩니다."

#. ~ Message of spell "AO_CALL_OF_TINDALOS ( Artifact Call of Tindalos )"
#: data/json/artifact/altered_object_active.json
msgid ""
"The world unravels into geometric shapes, and between the chaos you spot a "
"horrid prowling beast."
msgstr "세상은 기하학적인 형태로 풀려나고, 혼돈 속에서 끔찍한 배회하는 짐승을 발견합니다."

#. ~ Message of spell "AO_FORCE_PULL ( Artifact Force Pull )"
#: data/json/artifact/altered_object_active.json
msgid "An unnatural implosion sends objects flying."
msgstr "부자연스러운 내파가 물체를 날려버립니다."

#. ~ Message of spell "AO_TELEPORTITIS ( Artifact Teleportitis )"
#: data/json/artifact/altered_object_active.json
msgid ""
"The world loses coherence, with images of nearby places forming and "
"disappearing around you."
msgstr "세상은 일관성을 잃고, 주변 장소의 이미지가 당신 주위에 형성되고 사라집니다."

#. ~ Message of spell "AO_SLOW ( Artifact Slow )"
#: data/json/artifact/altered_object_active.json
msgid "The world shifts blue, and reality accelerates around you."
msgstr "세상은 푸른색으로 변하고, 현실은 당신 주위에서 가속됩니다."

#. ~ Message of spell "AO_TIME_STOP ( Artifact Time Stop )"
#: data/json/artifact/altered_object_active.json
msgid "Stale golden light floods the world, and reality stands still."
msgstr "오래된 황금빛이 세상을 뒤덮고, 현실은 멈춰섭니다."

#. ~ Message of spell "AO_SPATIAL_ANCHOR ( Artifact anchor )"
#. ~ Message of spell "AO_SPATIAL_ANCHOR_SLOW ( Artifact anchor (SLOW) )"
#: data/json/artifact/altered_object_active.json
msgid "You feel a deep sense of connection to this place."
msgstr "이 장소에 깊은 유대감을 느낍니다."

#. ~ Message of spell "AO_RESONANCE_BARRIER ( Artifact resonance barrier )"
#: data/json/artifact/altered_object_active.json
msgid "Your surroundings start shimmering."
msgstr "주변이 반짝이기 시작합니다."

#. ~ Message of spell "AO_SURFACE ( Artifact surfacing )"
#: data/json/artifact/altered_object_active.json
msgid ""
"You reel as your sense of balance falters, but you didn't fall anywhere."
msgstr "균형 감각이 흔들리면서 비틀거리지만, 아무데도 넘어지지 않았습니다."

#. ~ Message of spell "AO_BOOK_SNAP ( Grimoire Snap )"
#: data/json/artifact/altered_object_active.json
msgid "The tome snaps shut with tremendous force."
msgstr "마법서가 엄청난 힘으로 닫힙니다."

#. ~ Message of spell "AO_READ_GOOD ( Artifact fast reader )"
#: data/json/artifact/altered_object_active.json
msgid ""
"You don't understand the book yet, but you feel like you are making "
"progress."
msgstr "아직 책을 이해하지 못했지만, 진전이 있는 것 같습니다."

#. ~ Message of spell "AO_READ_BAD ( Artifact Nearsighted )"
#: data/json/artifact/altered_object_active.json
msgid "Your eyes hurt after focusing on the strange tome."
msgstr "이상한 마법서에 집중한 후 눈이 아픕니다."

#. ~ Message of spell "AO_READ_VERY_BAD ( Artifact Illiterate )"
#: data/json/artifact/altered_object_active.json
msgid ""
"You realize that staring at the scratches within is pointless, you don't "
"know how to read."
msgstr "안에 있는 긁힌 자국을 쳐다보는 것이 무의미하다는 것을 깨닫습니다. 당신은 읽는 법을 모릅니다."

#. ~ Message of spell "AO_BOOK_FAR_TP ( Book far tp )"
#: data/json/artifact/altered_object_active.json
msgid "You find the description of a distance place."
msgstr "먼 장소에 대한 설명을 찾습니다."

#. ~ Message of spell "AO_BOOK_BLAST ( Book blast Attack )"
#. ~ Message of spell "AO_BOOK_BLAST_ATTACK ( Book blast Attack )"
#: data/json/artifact/altered_object_active.json
msgid "Razor sharp pages shoot out from the book when you open it."
msgstr "책을 펼치자 면도날처럼 날카로운 페이지들이 튀어나옵니다."

#. ~ Message of spell "AO_BOOK_COMBUSTION ( Book combustion )"
#: data/json/artifact/altered_object_active.json
msgid "The pages glint slightly as you flip through them."
msgstr "페이지를 넘길 때 약간 반짝입니다."

#. ~ Message of spell "AO_MAGIC_CASCADE_START ( Artifact magic cascade )"
#. ~ Message of spell "MAGIC_CASCADE ( Artifact magic cascade )"
#: data/json/artifact/altered_object_active.json
msgid "Burning ash whirls around you."
msgstr "불타는 재가 당신 주위를 맴돕니다."

#. ~ Message of spell "AO_TRUESIGHT_EFFECT ( Artifact Truesight )"
#: data/json/artifact/altered_object_active.json
msgid "You see movement in the corners of your vision."
msgstr "시야의 가장자리에서 움직임을 봅니다."

#. ~ Message of spell "AO_DARKNESS_EFFECT ( Artifact Darkness )"
#: data/json/artifact/altered_object_active.json
msgid "Persistent shadows invade your field of view."
msgstr "지속적인 그림자가 시야를 침범합니다."

#. ~ Message of spell "AO_LIFE_DRAIN ( Artifact Hurtall )"
#: data/json/artifact/altered_object_active.json
msgid "You feel hollow inside."
msgstr "속이 텅 빈 느낌이 듭니다."

#. ~ Item name
#: data/json/artifact/artifact_item_types.json
msgid "smooth sphere"
msgid_plural "smooth spheres"
msgstr[0] "매끄러운 구체"

#. ~ Description of "smooth sphere"
#. ~ Description of "slim rod"
#. ~ Description of "teardrop-shaped stone"
#. ~ Description of "hollow, transparent cube"
#. ~ Description of "winding, flexible rod"
#. ~ Description of "smooth disc"
#. ~ Description of "string of beads"
#. ~ Description of "very thin sheet"
#. ~ Description of "spiked sphere"
#. ~ Description of "malleable blob"
#. ~ Description of "spiraling rod"
#. ~ Description of "small pin"
#. ~ Description of "hollow tube"
#. ~ Description of "regular tetrahedron"
#. ~ Description of "translucent crystal"
#. ~ Description of "twisted, knotted cord"
#. ~ Description of "crescent-shaped stone"
#: data/json/artifact/artifact_item_types.json
msgid ""
"It is the only one of its kind.\n"
"It may have unknown powers; try activating them."
msgstr ""
"세상에 딱 하나뿐인 것입니다.\n"
"사용하여 깃들어진 힘을 드러냅니다."

#. ~ Item name
#: data/json/artifact/artifact_item_types.json
msgid "slim rod"
msgid_plural "slim rods"
msgstr[0] "얅은 막대"

#. ~ Item name
#. ~ Variant name of item "ancient codex"
#: data/json/artifact/artifact_item_types.json
msgid "ancient codex"
msgid_plural "ancient codices"
msgstr[0] "고대의 사본"

#. ~ Description of "ancient codex"
#. ~ Description of variant "ancient codex" of item "ancient codex"
#: data/json/artifact/artifact_item_types.json
msgid ""
"Vellum pages bound in bark.  The strange symbols within seems to have been "
"overwritten hundreds of times."
msgstr "나무껍질로 제본된 양피지. 안에 있는 이상한 기호들은 수백 번이나 겹쳐 쓰여진 듯하다."

#. ~ Variant name of item "ancient codex"
#: data/json/artifact/artifact_item_types.json
msgid "In Uklm-si"
msgid_plural "In Uklm-si"
msgstr[0] "In Uklm-si"

#. ~ Description of variant "In Uklm-si" of item "ancient codex"
#: data/json/artifact/artifact_item_types.json
msgid ""
"The text is written in english, but every word takes incredible effort to "
"comprehend."
msgstr "이 글은 영어로 쓰여졌지만, 모든 단어를 이해하려면 엄청난 노력이 필요합니다."

#. ~ Variant name of item "ancient codex"
#: data/json/artifact/artifact_item_types.json
msgid "Perfect Index"
msgid_plural "Perfect Indices"
msgstr[0] "완벽한 지수"

#. ~ Description of variant "Perfect Index" of item "ancient codex"
#: data/json/artifact/artifact_item_types.json
msgid ""
"The book describes a curious heximal library classification system, and "
"purports to be a perfect index for all possible written works."
msgstr "이 책은 흥미로운 육각형 도서관 분류 체계를 설명하고, 가능한 모든 서면 작품에 대한 완벽한 색인이라고 주장합니다."

#. ~ Variant name of item "ancient codex"
#: data/json/artifact/artifact_item_types.json
msgid "MCV"
msgid_plural "MCV"
msgstr[0] "MCV"

#. ~ Description of variant "MCV" of item "ancient codex"
#: data/json/artifact/artifact_item_types.json
msgid ""
"The book contains nothing but the letters MCV perversely repeated from the "
"first line to the last."
msgstr "이 책은 첫 줄부터 마지막 줄까지 MCV라는 글자만 비정상적으로 반복되어 있습니다."

#. ~ Variant name of item "ancient codex"
#: data/json/artifact/artifact_item_types.json
msgid "Kybernetika"
msgid_plural "copies of Kybernetika"
msgstr[0] "카이버네티카 복사본"

#. ~ Description of variant "Kybernetika" of item "ancient codex"
#: data/json/artifact/artifact_item_types.json
msgid ""
"A postmodern novel where the protagonist finds a copy of this very book, and"
" reads it to find a copy of this very book, and reads it to find a copy of "
"this very book, and…"
msgstr ""
"주인공이 바로 이 책의 사본을 발견하고, 그 책을 읽으면 바로 이 책의 사본을 발견하고, 또 읽으면 바로 이 책의 사본을 발견하고… "
"포스트모던 소설입니다."

#. ~ Variant name of item "ancient codex"
#: data/json/artifact/artifact_item_types.json
msgid "celestial atlas"
msgid_plural "celestial atlases"
msgstr[0] "천체 지도"

#. ~ Description of variant "celestial atlas" of item "ancient codex"
#: data/json/artifact/artifact_item_types.json
msgid ""
"Its pages are filled with star charts and diagrams of fanciful "
"constellations."
msgstr "그 페이지들은 별자리표와 환상적인 별자리의 다이어그램으로 가득 차 있습니다."

#. ~ Variant name of item "ancient codex"
#: data/json/artifact/artifact_item_types.json
msgid "book of fairytales"
msgid_plural "books of fairytales"
msgstr[0] "동화책"

#. ~ Description of variant "book of fairytales" of item "ancient codex"
#: data/json/artifact/artifact_item_types.json
msgid ""
"Any glance given to this book is survived by the drone of flapping wings."
msgstr "이 책을 힐끗 볼 때마다 날개짓 소리가 윙윙거립니다."

#. ~ Variant name of item "ancient codex"
#: data/json/artifact/artifact_item_types.json
msgid "blank book"
msgid_plural "blank books"
msgstr[0] "공허의 서"

#. ~ Description of variant "blank book" of item "ancient codex"
#: data/json/artifact/artifact_item_types.json
msgid "This book is blank and perfectly immaculate."
msgstr "이 책은 비어 있고 완벽하게 깨끗합니다."

#. ~ Item name
#: data/json/artifact/artifact_item_types.json
msgid "teardrop-shaped stone"
msgid_plural "teardrop-shaped stones"
msgstr[0] "눈물 모양 돌"

#. ~ Item name
#: data/json/artifact/artifact_item_types.json
msgid "hollow, transparent cube"
msgid_plural "hollow, transparent cubes"
msgstr[0] "빈, 투명한 큐브"

#. ~ Item name
#: data/json/artifact/artifact_item_types.json
msgid "winding, flexible rod"
msgid_plural "winding, flexible rods"
msgstr[0] "흐느적거리는, 유연한 막대"

#. ~ Item name
#: data/json/artifact/artifact_item_types.json
msgid "smooth disc"
msgid_plural "smooth discs"
msgstr[0] "매끄러운 원반"

#. ~ Item name
#: data/json/artifact/artifact_item_types.json
msgid "string of beads"
msgid_plural "strings of beads"
msgstr[0] "구슬 목걸이"

#. ~ Item name
#: data/json/artifact/artifact_item_types.json
#: data/mods/Xedra_Evolved/items/inventor/spark_artifact_items.json
msgid "very thin sheet"
msgid_plural "very thin sheets"
msgstr[0] "아주 얇은 시트"

#. ~ Item name
#: data/json/artifact/artifact_item_types.json
#: data/mods/Xedra_Evolved/items/inventor/spark_artifact_items.json
msgid "spiked sphere"
msgid_plural "spiked spheres"
msgstr[0] "가시 구체"

#. ~ Item name
#: data/json/artifact/artifact_item_types.json
#: data/mods/Xedra_Evolved/items/inventor/spark_artifact_items.json
msgid "malleable blob"
msgid_plural "malleable blobs"
msgstr[0] "말랑한 덩어리"

#. ~ Item name
#: data/json/artifact/artifact_item_types.json
#: data/mods/Xedra_Evolved/items/inventor/spark_artifact_items.json
msgid "spiraling rod"
msgid_plural "spiraling rods"
msgstr[0] "나선 막대"

#. ~ Item name
#: data/json/artifact/artifact_item_types.json
#: data/mods/Xedra_Evolved/items/inventor/spark_artifact_items.json
msgid "small pin"
msgid_plural "small pins"
msgstr[0] "작은 핀"

#. ~ Item name
#: data/json/artifact/artifact_item_types.json
#: data/mods/Xedra_Evolved/items/inventor/spark_artifact_items.json
msgid "hollow tube"
msgid_plural "hollow tubes"
msgstr[0] "빈 튜브"

#. ~ Item name
#: data/json/artifact/artifact_item_types.json
#: data/mods/Xedra_Evolved/items/inventor/spark_artifact_items.json
msgid "regular tetrahedron"
msgid_plural "regular tetrahedrons"
msgstr[0] "정사면체"

#. ~ Item name
#: data/json/artifact/artifact_item_types.json
#: data/mods/Xedra_Evolved/items/inventor/spark_artifact_items.json
msgid "translucent crystal"
msgid_plural "translucent crystals"
msgstr[0] "반투명한 크리스털"

#. ~ Item name
#: data/json/artifact/artifact_item_types.json
#: data/mods/Xedra_Evolved/items/inventor/spark_artifact_items.json
msgid "twisted, knotted cord"
msgid_plural "twisted, knotted cords"
msgstr[0] "꼬이고, 울퉁불퉁한 실"

#. ~ Item name
#: data/json/artifact/artifact_item_types.json
#: data/mods/Xedra_Evolved/items/inventor/spark_artifact_items.json
msgid "crescent-shaped stone"
msgid_plural "crescent-shaped stones"
msgstr[0] "초승달 모양 돌"

#. ~ Item name
#: data/json/artifact/artifact_item_types.json
msgid "royal robe"
msgid_plural "royal robes"
msgstr[0] "로얄 로브"

#. ~ Description of "royal robe"
#: data/json/artifact/artifact_item_types.json
msgid ""
"An ornately decorated robe with an unfamiliar royal symbol on it.  The humanoid figure on the seal has two pairs of eyes.  It is the only one of its kind.\n"
"It may have unknown powers; try activating them."
msgstr ""
"화려하게 장식된 예복에 낯선 왕실 문양이 새겨져 있습니다. 인장에 새겨진 인간형 인물은 두 쌍의 눈을 가지고 있습니다. 이런 종류의 존재는 세상에 단 하나뿐입니다.\n"
"알 수 없는 힘을 가지고 있을지도 모릅니다. 활성화해 보세요."

#. ~ Item name
#: data/json/artifact/artifact_item_types.json
msgid "ancient burial shroud"
msgid_plural "ancient burial shrouds"
msgstr[0] "고대의 매장 수의"

#. ~ Description of "ancient burial shroud"
#: data/json/artifact/artifact_item_types.json
msgid ""
"A cloak of thin, faded cloth.  The faint silhouette of a long-dead humanoid is barely visible on it.  It is the only one of its kind.\n"
"It may have unknown powers; try activating them."
msgstr ""
"얇고 빛바랜 천으로 만든 망토. 오래전에 죽은 인간형 존재의 희미한 실루엣이 거의 보이지 않는다. 이런 종류의 망토는 세상에 단 하나뿐이다.\n"
"알 수 없는 힘이 있을지도 모르니, 활성화해 보세요."

#. ~ Item name
#: data/json/artifact/artifact_item_types.json
msgid "ornate fur coat"
msgid_plural "ornate fur coats"
msgstr[0] "화려한 모피 코트"

#. ~ Description of "ornate fur coat"
#: data/json/artifact/artifact_item_types.json
msgid ""
"A heavy, finely crafted coat made of the fur of an unidentifiable creature.  It is the only one of its kind.\n"
"It may have unknown powers; try activating them."
msgstr ""
"정체를 알 수 없는 생물의 털로 만든, 무겁고 정교하게 만들어진 코트입니다. 세상에 단 하나뿐인 특별한 존재입니다.\n"
"알 수 없는 힘이 있을지도 모르니, 한번 활성화해 보세요."

#. ~ Item name
#: data/json/artifact/artifact_item_types.json
msgid "ancient stone mask"
msgid_plural "ancient stone masks"
msgstr[0] "고대의 돌가면"

#. ~ Description of "ancient stone mask"
#: data/json/artifact/artifact_item_types.json
msgid ""
"A sinister mask made of a smooth green stone.  It is the only one of its kind.\n"
"It may have unknown powers; try activating them."
msgstr ""
"매끄러운 녹색 돌로 만들어진 불길한 가면입니다. 세상에 단 하나뿐인 가면입니다.\n"
"알 수 없는 힘이 있을지도 모릅니다. 활성화해 보세요."

#. ~ Item name
#: data/json/artifact/artifact_item_types.json
msgid "ancient bronze helmet"
msgid_plural "ancient bronze helmets"
msgstr[0] "고대 청동 투구"

#. ~ Description of "ancient bronze helmet"
#: data/json/artifact/artifact_item_types.json
msgid ""
"A helmet with an imposing face plate.  Though the corrosion has completely defaced the symbols written on the sides, it seems sturdy.  It is the only one of its kind.\n"
"It may have unknown powers; try activating them."
msgstr ""
"위풍당당한 얼굴 보호판이 달린 헬멧입니다. 부식으로 인해 측면에 새겨진 기호는 완전히 손상되었지만, 튼튼해 보입니다. 이런 종류의 헬멧은 세상에 단 하나뿐입니다.\n"
"알 수 없는 힘이 있을지도 모릅니다. 활성화해 보세요."

#. ~ Item name
#: data/json/artifact/artifact_item_types.json
msgid "ornate leather gloves (pair)"
msgid_plural "ornate leather gloves (pair)"
msgstr[0] "화려한 가죽 장갑 (쌍)"

#. ~ Description of "ornate leather gloves (pair)"
#: data/json/artifact/artifact_item_types.json
msgid ""
"A set of worn leather gloves embossed with gold.  The unidentifiable leather it is made from is oddly soft.  It is the only one of its kind.\n"
"It may have unknown powers; try activating them."
msgstr ""
"금박이 새겨진 낡은 가죽 장갑입니다. 정체를 알 수 없는 가죽으로 만들어졌는데, 이상하게 부드럽습니다. 세상에 단 하나뿐인 특별한 장갑입니다.\n"
"알 수 없는 힘이 있을지도 모르니, 활성화해 보세요."

#. ~ Item name
#: data/json/artifact/artifact_item_types.json
msgid "ancient leather boots (pair)"
msgid_plural "ancient leather boots (pair)"
msgstr[0] "고대의 가죽 부츠 (쌍)"

#. ~ Description of "ancient leather boots (pair)"
#: data/json/artifact/artifact_item_types.json
msgid ""
"A pair of ancient leather boots.  Though the flaps of leather are crudely sewn together, the red hue it is dyed with is striking.  It is the only one of its kind.\n"
"It may have unknown powers; try activating them."
msgstr ""
"오래된 가죽 부츠 한 켤레. 가죽 플랩은 투박하게 꿰매져 있지만, 붉은색으로 물든 모습이 눈길을 사로잡습니다. 세상에 단 하나뿐인 특별한 부츠입니다.\n"
"알 수 없는 힘이 있을지도 모르니, 한번 사용해 보세요."

#. ~ Item name
#: data/json/artifact/artifact_item_types.json
msgid "amber ring"
msgid_plural "amber rings"
msgstr[0] "호박 반지"

#. ~ Description of "amber ring"
#: data/json/artifact/artifact_item_types.json
msgid ""
"A band of gold with a smooth piece of amber set into it.  A strange worm is encased in the amber, making a perfect spiral with its sealed body.  It is the only one of its kind.\n"
"It may have unknown powers; try activating them."
msgstr ""
"매끄러운 호박 조각이 박힌 금띠입니다. 호박 안에는 이상한 벌레가 갇혀 있으며, 봉인된 몸으로 완벽한 나선형을 이루고 있습니다. 이런 종류의 벌레는 세상에 단 하나뿐입니다.\n"
"알 수 없는 힘이 있을지도 모릅니다. 활성화해 보세요."

#. ~ Item name
#: data/json/artifact/artifact_item_types.json
#: data/mods/Xedra_Evolved/items/weapon_copy_extensions.json
msgid "ancient staff"
msgid_plural "ancient staffs"
msgstr[0] "고대의 지팡이"

#. ~ Description of "ancient staff"
#: data/json/artifact/artifact_item_types.json
msgid ""
"A well-balanced stick of treated wood with metal caps.  A red stone is embedded in the handle.  It is the only one of its kind.\n"
"It may have unknown powers; try activating them."
msgstr ""
"금속 캡이 달린, 가공된 나무로 만들어진 균형 잡힌 막대기입니다. 손잡이에는 붉은 돌이 박혀 있습니다. 세상에 단 하나뿐인 특별한 막대기입니다.\n"
"알 수 없는 힘이 있을지도 모릅니다. 한번 사용해 보세요."

#. ~ Item name
#: data/json/artifact/artifact_item_types.json
#: data/mods/Isolation-Protocol/unique_items.json
msgid "ancient sword"
msgid_plural "ancient swords"
msgstr[0] "고대의 검"

#. ~ Description of "ancient sword"
#: data/json/artifact/artifact_item_types.json
msgid ""
"A sword made out of a striking black metal.  It is the only one of its kind.\n"
"It may have unknown powers; try activating them."
msgstr ""
"눈길을 사로잡는 검은 금속으로 만들어진 검입니다. 세상에 단 하나뿐인 검입니다.\n"
"알 수 없는 힘이 있을지도 모릅니다. 한번 사용해 보세요."

#. ~ Item name
#: data/json/artifact/artifact_item_types.json
msgid "ancient harp"
msgid_plural "ancient harps"
msgstr[0] "고대의 하프"

#. ~ Description of "ancient harp"
#: data/json/artifact/artifact_item_types.json
msgid ""
"A harp made of black wood.  Faint hypnotic notes ring in the air each time you touch it.  It is the only one of its kind.\n"
"It may have unknown powers; try activating them."
msgstr ""
"검은 나무로 만든 하프입니다. 만질 때마다 희미한 최면의 음조가 공중에 울려 퍼집니다. 세상에 단 하나뿐인 특별한 하프입니다.\n"
"알 수 없는 힘이 있을지도 모르니, 한번 사용해 보세요."

#. ~ Item name
#: data/json/artifact/artifact_item_types.json
msgid "ancient athame"
msgid_plural "ancient athames"
msgstr[0] "고대의 애서메"

#. ~ Description of "ancient athame"
#: data/json/artifact/artifact_item_types.json
msgid ""
"A ritual knife used by some ancient civilization.  Unreadable runes are carved into the handle.  It is the only one of its kind.\n"
"It may have unknown powers; try activating them."
msgstr ""
"고대 문명에서 사용했던 의식용 칼입니다. 손잡이에는 읽을 수 없는 룬 문자가 새겨져 있습니다. 이런 종류의 칼은 세상에 단 하나뿐입니다.\n"
"알 수 없는 힘이 있을지도 모릅니다. 한번 사용해 보세요."

#. ~ Item name
#: data/json/artifact/artifact_item_types.json
#: data/mods/Xedra_Evolved/items/weapon_copy_extensions.json
msgid "ancient spear"
msgid_plural "ancient spears"
msgstr[0] "고대의 창"

#. ~ Description of "ancient spear"
#: data/json/artifact/artifact_item_types.json
msgid ""
"A sturdy wooden pole with a sharp metal spike on the end.  The handle has the symbol of a blue sun on it.  It is the only one of its kind.\n"
"It may have unknown powers; try activating them."
msgstr ""
"끝에 날카로운 금속 못이 박힌 튼튼한 나무 막대입니다. 손잡이에는 푸른 태양 문양이 새겨져 있습니다. 세상에 단 하나뿐인 특별한 물건입니다.\n"
"알 수 없는 힘이 있을지도 모릅니다. 한번 사용해 보세요."

#. ~ Item name
#: data/json/artifact/artifact_item_types.json
#: data/mods/Xedra_Evolved/items/weapon_copy_extensions.json
msgid "ancient club"
msgid_plural "ancient clubs"
msgstr[0] "고대의 뭉둥이"

#. ~ Description of "ancient club"
#: data/json/artifact/artifact_item_types.json
msgid ""
"A misshapen rod of gnarled, knotted wood.  The knots in the wood exhibit a strange fractal pattern.  It is the only one of its kind.\n"
"It may have unknown powers; try activating them."
msgstr ""
"옹이투성이에 옹이가 있는 기형적인 나무 막대입니다. 나무의 옹이는 기묘한 프랙탈 패턴을 보입니다. 이런 종류의 나무는 세상에 단 하나뿐입니다.\n"
"알 수 없는 힘이 있을지도 모릅니다. 한번 활성화해 보세요."

#. ~ Item name
#: data/json/artifact/artifact_item_types.json
msgid "set of oddly interlocked rings"
msgid_plural "sets of oddly interlocked rings"
msgstr[0] "기이하게 얽힌 고리 세트"

#. ~ Description of "set of oddly interlocked rings"
#: data/json/artifact/artifact_item_types.json
msgid ""
"A set of three rings linked together.  There's something about the way the rings connect to each other that gives you a headache.  It is the only one of its kind.\n"
"It may have unknown powers; try activating them."
msgstr ""
"세 개의 고리가 서로 연결되어 있습니다. 고리들이 서로 연결되는 방식이 뭔가 머리가 아플 정도입니다. 세상에 단 하나뿐인 특별한 반지입니다.\n"
"알 수 없는 힘이 있을지도 모르니, 한번 작동시켜 보세요."

#. ~ Item name
#: data/json/artifact/artifact_item_types.json
msgid "strange triangle"
msgid_plural "strange triangles"
msgstr[0] "기이한 삼각형"

#. ~ Description of "strange triangle"
#: data/json/artifact/artifact_item_types.json
msgid ""
"A large triangle made out of three thick rectangles that connect to each other in an angle.  No matter how much you turn it around, you can't seem to comprehend how it links together.  It is the only one of its kind.\n"
"It may have unknown powers; try activating them."
msgstr ""
"세 개의 두꺼운 직사각형이 비스듬히 연결되어 이루어진 커다란 삼각형입니다. 아무리 돌려봐도 어떻게 연결되어 있는지 알 수 없습니다. 세상에 단 하나뿐인 특별한 삼각형입니다.\n"
"알 수 없는 힘이 있을지도 모르니, 한번 활성화해 보세요."

#. ~ Item name
#: data/json/artifact/artifact_item_types.json
msgid "impossible trident"
msgid_plural "impossible tridents"
msgstr[0] "불가능한 삼지창"

#. ~ Description of "impossible trident"
#: data/json/artifact/artifact_item_types.json
msgid ""
"A large trident made entirely out of an indiscernible material.  The prong in the middle seems to fade away into nothingness when looked at from the top, but you can clearly see the shaft connecting the tip of the weapon from the bottom.  It's giving you a headache.  It is the only one of its kind.\n"
"It may have unknown powers; try activating them."
msgstr ""
"알 수 없는 재료로만 만들어진 커다란 삼지창. 위에서 보면 가운데 갈래가 허공으로 사라지는 듯하지만, 아래에서 보면 무기 끝을 연결하는 축이 선명하게 보인다. 머리가 아프다. 세상에 단 하나뿐인 무기다.\n"
"알 수 없는 힘이 있을지도 모르니, 한번 작동시켜 보세요."

#. ~ Item name
#: data/json/artifact/artifact_item_types.json
msgid "self-crossing flask"
msgid_plural "self-crossing flasks"
msgstr[0] "자가 교차 플라스크"

#. ~ Description of "self-crossing flask"
#: data/json/artifact/artifact_item_types.json
msgid ""
"A transparent flask with a neck that connects directly to its bottom without overlapping itself, even though it clearly does.  You can put things in it, but attempting to follow their path through the neck is impossible.  It is the only one of its kind.\n"
"It may have unknown powers; try activating them."
msgstr ""
"목이 바닥과 직접 연결되어 있지만, 서로 겹치지 않는 투명한 플라스크입니다. 물론 목이 겹치는 건 분명하지만요. 안에 물건을 넣을 수는 있지만, 목을 통해 그 경로를 추적하는 것은 불가능합니다. 이런 종류의 플라스크는 세상에 단 하나뿐입니다.\n"
"알 수 없는 힘이 있을지도 모르니, 한번 활성화해 보세요."

#. ~ Item name
#: data/json/artifact/artifact_item_types.json
msgid "four-dimensional cube"
msgid_plural "four-dimensional cubes"
msgstr[0] "4차원 큐브"

#. ~ Description of "four-dimensional cube"
#: data/json/artifact/artifact_item_types.json
msgid ""
"It's a cube that constantly shrinks and grows in size.  It's two cubes linked by the vertices, with ever-shifting sides folding onto each other, over and over.  It's four cubes in the exact same position.  It's a cube fading to ash then reverting to pristine form repeatedly.  It's all of these at once, and none of them at all.  It is the only one of its kind.\n"
"It may have unknown powers; try activating them."
msgstr ""
"끊임없이 크기가 줄어들고 커지는 정육면체입니다. 꼭짓점으로 연결된 두 개의 정육면체로, 끊임없이 변하는 면들이 계속해서 서로 겹쳐집니다. 정확히 같은 위치에 있는 네 개의 정육면체입니다. 재로 변했다가 다시 원래 모습으로 돌아오기를 반복하는 정육면체입니다. 이 모든 것이 한꺼번에 일어나는 동시에, 그 어떤 것도 아닙니다. 이 정육면체는 세상에 단 하나뿐입니다.\n"
"알려지지 않은 힘이 있을지도 모릅니다. 활성화해 보세요."

#. ~ Item name
#: data/json/artifact/artifact_item_types.json
msgid "irrational cube"
msgid_plural "irrational cubes"
msgstr[0] "무리수 큐브"

#. ~ Description of "irrational cube"
#: data/json/artifact/artifact_item_types.json
msgid ""
"A large wire-frame cube.  The interior wires somehow appear to be over the exterior wires, no matter which angle you look at the cube from.  Trying to trace the lines with your finger is probably not a good idea.  It is the only one of its kind.\n"
"It may have unknown powers; try activating them."
msgstr ""
"커다란 철사 프레임 큐브입니다. 큐브를 어느 각도에서 보든 내부 전선이 외부 전선 위에 있는 것처럼 보입니다. 손가락으로 선을 따라가려고 하는 것은 좋지 않습니다. 이런 종류의 큐브는 세상에 단 하나뿐이니까요.\n"
"알 수 없는 힘이 있을지도 모르니, 활성화해 보세요."

#. ~ Item name
#: data/json/artifact/artifact_item_types.json
msgid "wobbly ring"
msgid_plural "wobbly rings"
msgstr[0] "흔들리는 반지"

#. ~ Description of "wobbly ring"
#: data/json/artifact/artifact_item_types.json
msgid ""
"A chunky ring that folds onto itself continuously, preventing its use as an esoteric piece of jewelry.  It is the only one of its kind.\n"
"It may have unknown powers; try activating them."
msgstr ""
"끊임없이 스스로 접히는 두꺼운 반지로, 신비로운 장신구로 사용하기에 적합하지 않습니다. 세상에 단 하나뿐인 특별한 반지입니다.\n"
"알 수 없는 힘이 있을지도 모르니, 한번 활성화해 보세요."

#. ~ Message of spell "AEA_ADRENALINE ( Artifact Adrenaline )"
#. ~ Message of spell "MoM_AEA_ADRENALINE ( MoM Artifact Adrenaline )"
#: data/json/artifact/legacy_artifact_active.json
#: data/mods/MindOverMatter/powers/artifacts.json
msgid "You're filled with a roaring energy!"
msgstr "솟구치는 에너지가 느껴집니다!"

#. ~ Message of spell "AEA_BLOOD ( Artifact Blood )"
#: data/json/artifact/legacy_artifact_active.json
msgid "Blood soaks out of the ground and walls."
msgstr "벽과 땅에서 피가 새어나온다."

#. ~ Message of spell "AEA_HEAL ( Artifact Heal )"
#: data/json/artifact/legacy_artifact_active.json
msgid "You feel healed."
msgstr "회복되는 것이 느껴집니다."

#. ~ Message of spell "AEA_PAIN ( Artifact Pain )"
#: data/json/artifact/legacy_artifact_active.json
msgid "You're wracked with pain!"
msgstr "고통 때문에 괴롭다!"

#. ~ Message of spell "AEA_TELEPORT ( Artifact Teleport )"
#: data/json/artifact/legacy_artifact_active.json
msgid "You teleport!"
msgstr "몸이 저절로 사라지더니… 짠!"

#. ~ Message of spell "AEA_ATTENTION ( Artifact Attention )"
#. ~ Message of spell "MoM_AEA_ATTENTION ( MoM Artifact Attention )"
#: data/json/artifact/legacy_artifact_active.json
#: data/mods/MindOverMatter/powers/artifacts.json
msgid "You feel like your action has attracted attention."
msgstr "행동이 주의를 끈 것 같습니다."

#. ~ Message of spell "AEA_TELEGLOW ( Artifact Teleglow )"
#: data/json/artifact/legacy_artifact_active.json
msgid "You feel unhinged."
msgstr "기분이 심란하다."

#. ~ Message of spell "AEA_VOMIT ( Artifact Vomit )"
#. ~ Message of spell "MoM_AEA_VOMIT ( Artifact Vomit )"
#: data/json/artifact/legacy_artifact_active.json
#: data/mods/MindOverMatter/powers/artifacts.json
msgid "A wave of nausea passes through you!"
msgstr "어지러움이 밀려옵니다!"

#. ~ Message of spell "AEA_SHADOWS ( Artifact Shadows )"
#: data/json/artifact/legacy_artifact_active.json
msgid "Shadows form around you."
msgstr "주위에서 그림자가 생겨난다."

#. ~ Message of spell "AEA_STAMINA_EMPTY ( Artifact Stamina Empty )"
#. ~ Message of spell "MoM_AEA_STAMINA_EMPTY ( Artifact Stamina Empty )"
#: data/json/artifact/legacy_artifact_active.json
#: data/mods/MindOverMatter/powers/artifacts.json
msgid "Your body feels like jelly."
msgstr "몸에서 기운이 빠져나갑니다."

#. ~ Message of spell "AEA_RADIATION ( Artifact Radiation )"
#: data/json/artifact/legacy_artifact_active.json
msgid "Horrible gases are emitted!"
msgstr "지독한 가스가 방출되었습니다!"

#. ~ Message of spell "art_flies_buzz ( Artifact Flies Buzz )"
#: data/json/artifact/legacy_artifact_active.json
msgid "Flies buzz around you."
msgstr "파리가 주위를 날아다닌다."

#. ~ Message of spell "art_summon_flies ( Artifact Summon Flies )"
#: data/json/artifact/legacy_artifact_active.json
msgid "Giant flies appear!"
msgstr "거대 파리가 나타났습니다!"

#. ~ Message of spell "art_summon_bees ( Artifact Summon Bees )"
#: data/json/artifact/legacy_artifact_active.json
msgid "Giant bees appear!"
msgstr "거대한 꿀벌이 나타났습니다!"

#. ~ Message of spell "art_summon_wasps ( Artifact Summon Wasps )"
#: data/json/artifact/legacy_artifact_active.json
msgid "Giant wasps appear!"
msgstr "거대한 말벌들이 나타났습니다!"

#. ~ Sound description of spell "AEA_NOISE ( Artifact Noise )"
#: data/json/artifact/legacy_artifact_active.json
msgid "a deafening boom"
msgstr "귀가 먹먹해지는 굉음"

#. ~ Message of spell "AEA_NOISE ( Artifact Noise )"
#: data/json/artifact/legacy_artifact_active.json
msgid "You hear a deafening boom from your location!"
msgstr "귀가 먹먹해지는 굉음이 당신이 있는 곳에서 들려옵니다!"

#. ~ Message of spell "AEA_LIGHT ( Artifact Light )"
#: data/json/artifact/legacy_artifact_active.json
msgid "You glow brightly!"
msgstr "당신이 밝게 빛납니다!"

#. ~ Message of spell "AEA_DIM ( Artifact Dim )"
#: data/json/artifact/legacy_artifact_active.json
msgid "The sky starts to dim."
msgstr "하늘이 어두워지기 시작합니다."

#. ~ Message of spell "AEA_PARALYZE ( Artifact Paralyze )"
#: data/json/artifact/legacy_artifact_active.json
msgid "You're paralyzed!"
msgstr "마비되었습니다!"

#. ~ Message of spell "AEA_MAP ( Artifact Map )"
#. ~ Message of spell "MoM_AEA_MAP ( MoM Artifact Map )"
#: data/json/artifact/legacy_artifact_active.json
#: data/mods/MindOverMatter/powers/artifacts.json
msgid "You have a vision of the surrounding area…"
msgstr "주변 지형이 한눈에 들어옵니다…"

#. ~ Message of spell "AEA_FIRESTORM ( Artifact Firestorm )"
#: data/json/artifact/legacy_artifact_active.json
msgid "Fire rains down around you!"
msgstr "주변에 화염 비가 내린다!"

#. ~ Message of spell "AEA_FUN ( Artifact Fun )"
#: data/json/artifact/legacy_artifact_active.json
msgid "You're filled with euphoria!"
msgstr "압도적인 행복감으로 충만해집니다!"

#. ~ Sound description of spell "AEA_STORM_bolt ( Bolt )"
#: data/json/artifact/legacy_artifact_active.json
msgid "Ka-BOOM!"
msgstr "콰-앙!"

#. ~ Sound description of spell "AEA_SCREAM ( Artifact Scream )"
#: data/json/artifact/legacy_artifact_active.json
msgid "an ethereal scream"
msgstr "영계의 비명"

#. ~ Sound description of spell "AEA_PULSE ( Artifact Pulse )"
#: data/json/artifact/legacy_artifact_active.json
msgid "the earth shaking!"
msgstr "땅이 흔들린다!"

#. ~ Item name
#: data/json/artifact/premade_artifacts.json
msgid "The Architect's Cube"
msgid_plural "The Architect's Cubes"
msgstr[0] "건축가의 큐브"

#. ~ Description of "The Architect's Cube"
#: data/json/artifact/premade_artifacts.json
msgid ""
"This is a solid cube that is much heavier than its size suggests.  When you "
"look at it, it pulls your gaze inward until you fall through the sky, "
"showing you a top-down view of your position with the surroundings revealed."
msgstr ""
"겉으로 보는 것보다 훨씬 무겁고, 단단한 큐브입니다. 큐브를 들여다보면 당신의 시야가 끌려들어가, 하늘에서 내려다보는 구도로 주변을 "
"바라보게 됩니다."

#. ~ Prerequisite of terrain constrution
#: data/json/construction/doors.json
#: data/json/construction/furniture_barriers.json
#: data/json/construction/furniture_fireplaces.json
#: data/json/construction/furniture_recreation.json
#: data/json/construction/furniture_sleep.json
#: data/json/construction/furniture_surfaces.json
#: data/json/construction/furniture_tools.json
#: data/json/construction/manufactured.json
#: data/mods/innawood/mining/construction.json
msgid "Can be deconstructed without tools."
msgstr "도구 없이도 분해할 수 있습니다."

#. ~ Prerequisite of terrain constrution
#: data/json/construction/doors.json
#: data/json/construction/floors_indoors.json
#: data/json/construction/floors_outdoors.json
#: data/json/construction/furniture_tools.json
#: data/json/construction/walls.json
msgid "Must be supported on at least two sides."
msgstr "적어도 두 방향에서 지지해줘야 합니다."

#. ~ Prerequisite of terrain constrution
#: data/json/construction/doors.json
msgid ""
"Must be between ordinary, concrete, brick, or rock walls to function, and at"
" least one wall must have an adjacent mechanical winch."
msgstr ""
"정상적으로 작동하려면 일반 벽, 콘크리트 벽, 벽돌 벽, 또는 암석 벽 사이에 있어야 하며,\n"
"최소한 한 쪽 벽에는 기계식 윈치가 인접해 있어야 합니다."

#. ~ Prerequisite of terrain constrution
#: data/json/construction/fences_gates.json
msgid "Requires diggable terrain."
msgstr "파낼 수 있는 지형이 필요합니다."

#. ~ Prerequisite of terrain constrution
#: data/json/construction/fences_gates.json
msgid "Needs to be supported on both sides by fencing, walls, etc."
msgstr "울타리나 벽 따위로 양쪽에서 지지해주어야 합니다."

#. ~ Prerequisite of terrain constrution
#: data/json/construction/fences_gates.json
msgid ""
"Must be between palisade walls to function, and at least one wall must have "
"an adjacent rope & pulley system."
msgstr "말뚝 울타리벽 사이에서만 기능하며, 적어도 벽 하나는 도르래 장치와 인접해야 합니다."

#. ~ Prerequisite of terrain constrution
#: data/json/construction/floors_indoors.json
msgid ""
"Your power tool is effective at cutting through the resin cage, but it's "
"still a hard process.  Mi-go structures are dangerously hot -- you'll likely"
" need to take breaks outside."
msgstr ""
"전동 공구는 수지 우리를 절단하는 데 효과적이지만, 여전히 고된 작업입니다.\n"
"미고 구조물은 위험할 정도로 뜨거우므로, 중간에 바깥에서 휴식을 취해야 할 수 있습니다."

#. ~ Prerequisite of terrain constrution
#: data/json/construction/floors_indoors.json
msgid ""
"This is a slow, hard process that could be accelerated with power tools.  "
"Mi-go structures are dangerously hot -- you'll likely need to take breaks "
"outside."
msgstr ""
"이 작업은 느리고 고된 과정이며, 전동 공구를 사용하면 속도를 높일 수 있습니다.\n"
"미고 구조물은 위험할 정도로 뜨거우므로, 중간에 바깥으로 나와 휴식을 취해야 할 수도 있습니다."

#. ~ Prerequisite of terrain constrution
#: data/json/construction/furniture_domestic_plants.json
msgid ""
"Mark a spot to stack cut grain for drying outdoors.  Once placed, put "
"unrotten undried grain stalks on the stooking spot and examine it to get "
"started."
msgstr ""
"베어낸 곡물을 야외에서 말릴 수 있도록 지정된 장소입니다.\n"
"설치한 후, 부패하지 않은 건조 전 곡물 줄기를 이 장소에 놓고 조사하면 건조 작업이 시작됩니다."

#. ~ Prerequisite of terrain constrution
#: data/json/construction/furniture_recreation.json
msgid "Needs diggable terrain to secure it."
msgstr "고정하려면 파낼 수 있는 지형이 필요합니다."

#. ~ Prerequisite of terrain constrution
#: data/json/construction/furniture_recreation.json
#: data/json/construction/furniture_tools.json
msgid "Must be built indoors."
msgstr "실내 전용"

#. ~ Prerequisite of terrain constrution
#: data/json/construction/furniture_sleep.json
msgid ""
"Can be deconstructed without tools.  Must be supported on at least two "
"sides."
msgstr "도구 없이도 분해할 수 있습니다.  양쪽에서 지지할 곳이 있어야 합니다."

#. ~ Prerequisite of terrain constrution
#: data/json/construction/furniture_tools.json
msgid "Built in a tree."
msgstr "나무 위에만 건설할 수 있습니다."

#. ~ Prerequisite of terrain constrution
#: data/json/construction/manufactured.json
msgid "Carve a thick wooden door for the brick oven."
msgstr "벽돌 오븐에 사용할 두꺼운 나무 문을 조각합니다."

#. ~ Prerequisite of terrain constrution
#: data/json/construction/manufactured.json
msgid "Weld together a metal door for the brick oven."
msgstr "벽돌 오븐에 사용할 금속 문을 용접하여 만듭니다."

#. ~ Prerequisite of terrain constrution
#: data/json/construction/manufactured.json
msgid "You need a deep pit to construct a root cellar."
msgstr "지하 저장실을 건설하려면 깊은 구덩이가 필요합니다."

#. ~ Prerequisite of terrain constrution
#: data/json/construction/mechanisms.json
msgid ""
"Must be adjacent to ordinary, concrete, brick, or rock wall that is itself "
"adjacent to a metal gate in order to open said gate."
msgstr "금속 문을 열기 위해서는, 해당 문과 인접한 금속 문에 인접한 콘크리트 벽, 벽돌 벽 또는 암석 벽 옆에 있어야 합니다."

#. ~ Prerequisite of terrain constrution
#: data/json/construction/mechanisms.json
msgid ""
"Can be deconstructed without tools.  Must be adjacent to a palisade wall "
"that is itself adjacent to a palisade gate in order to open said gate."
msgstr "도구 없이도 분해할 수 있습니다. 말뚝 울타리문과 인접한 말뚝 울타리벽에 붙어있어야 문을 여닫을 수 있습니다."

#. ~ Prerequisite of terrain constrution
#: data/json/construction/misc.json
msgid "Certain terrain and furniture can be deconstructed without any tools."
msgstr "일부 지형과 가구는 도구 없이도 분해할 수 있습니다."

#. ~ Prerequisite of terrain constrution
#: data/json/construction/misc.json
msgid ""
"Mark a spot for crafting.  Crafting tasks next to this tile will "
"automatically use this location instead of attempting to craft in your "
"hands, with the usual crafting speed penalty for working on the ground.  "
"Does not prevent using a proper workbench, if available.  Deconstruct or "
"smash to remove."
msgstr ""
"한 장소를 제작소로 지정합니다. 해당 타일 주변에서 제작을 시도하면 손에 들고 제작하는 대신 해당 타일에 놓고 제작합니다. 제작 속도 "
"페널티는 손에 들고 제작하는 것과 같습니다. 다른 작업대를 사용할 수 있다면, 그 작업대를 사용하는 것을 막지 않습니다. 때려부수거나 "
"건축 메뉴에서 제거할 수 있습니다."

#. ~ Prerequisite of terrain constrution
#: data/json/construction/misc.json
msgid ""
"Firewood or other flammable materials on a nearby tile marked in this way "
"may be used to automatically refuel fires.  This will be done to maintain "
"light during long-running tasks that require it such as crafting or reading,"
" but not (for example) if you are simply waiting nearby."
msgstr ""
"표시된 타일 근처에 있는 장작 또는 가연성 물질을 소모하여 자동으로 땔감을 집어넣을 수 있습니다. 제작이나 책 읽기 등 오랜 시간이 "
"소요되는 작업을 할땐 자동으로 땔감을 집어넣지만, 단순히 기다리는 경우에는 그렇지 않습니다."

#. ~ Prerequisite of terrain constrution
#: data/json/construction/misc.json
msgid ""
"Mark a spot for target practice.  Firing will automatically target the first"
" practice target location found in gun range, if no enemies are around."
msgstr ""
"한 지점을 연습용 타겟으로 지정합니다. 사정거리 내에 있고 다른 적이 없다면 그 주변에서의 사격은 연습용 타겟을 우선 사격합니다."

#. ~ Prerequisite of terrain constrution
#: data/json/construction/roofs.json
msgid ""
"Must be supported directly from below or on at least two sides.  May need a "
"'room' supporting a roof directly below."
msgstr "아래에서 또는 최소한 두 측면에서 직접 지원해야합니다.  바로 아래 지붕을지지하는 '방'이 필요할 수 있습니다."

#. ~ Prerequisite of terrain constrution
#: data/json/construction/zlvels_transition.json
msgid ""
"Build a concrete ramp leading to the next z-level above, and the "
"corresponding ramp down leading from the z-level above to this level.  It "
"must be built next to a low end of a ramp to allow moving between z-levels "
"in both directions."
msgstr ""
"다음 z축 높이로 향하는 콘크리트 경사로와 해당 높이에서 이곳으로 내려오는 경사로를 만듭니다. 경사로 최저점이 반드시 인접해있어야 양쪽 "
"방향에서 z축 높이를 오갈 수 있습니다."

#. ~ Prerequisite of terrain constrution
#: data/json/construction/zlvels_transition.json
msgid ""
"Build a concrete ramp leading to the next z-level above, and the "
"corresponding ramp down leading from the z-level above to this level.  The "
"high end of a ramp must be built adjacent to allow moving between z-levels "
"in both directions."
msgstr ""
"다음 z축 높이로 향하는 콘크리트 경사로와 해당 높이에서 이곳으로 내려오는 경사로를 만듭니다. 경사로 최고점이 반드시 인접해있어야 양쪽 "
"방향에서 z축 높이를 오갈 수 있습니다."

#. ~ Prerequisite of terrain constrution
#: data/json/construction/zlvels_transition.json
msgid ""
"Build an earth ramp leading to the next z-level above, and the corresponding"
" ramp down leading from the z-level above to this level.  It must be built "
"next to a low end of a ramp to allow moving between z-levels in both "
"directions."
msgstr ""
"다음 z축 높이로 향하는 콘크리트 경사로와 해당 높이에서 이곳으로 내려오는 경사로를 만듭니다. 경사로 최저점이 반드시 인접해있어야 양쪽 "
"방향에서 z축 높이를 오갈 수 있습니다."

#. ~ Prerequisite of terrain constrution
#: data/json/construction/zlvels_transition.json
msgid ""
"Build an earth ramp leading to the next z-level above, and the corresponding"
" ramp down leading from the z-level above to this level.  The high end of a "
"ramp must be built adjacent to allow moving between z-levels in both "
"directions."
msgstr ""
"상층으로 연결되는 흙 경사로를 만들고, 해당 상층에서 이 층으로 내려오는 경사로 또한 구축해야 합니다.\n"
"경사로의 높은 쪽은 인접한 위치에 있어야 위아래 층 사이를 자유롭게 이동할 수 있습니다."

#. ~ Prerequisite of terrain constrution
#: data/json/construction/zlvels_transition.json
msgid "Builds another scaffolding level."
msgstr "다른 비계 레벨을 건설합니다."

#. ~ Prerequisite of terrain constrution
#: data/json/construction/zlvels_transition.json
msgid ""
"Constructs scaffolding on the tile and provides a platform on the Z level "
"above."
msgstr "타일에 비계를 건설하고 위쪽 Z 레벨에 플랫폼을 제공합니다."

#. ~ Prerequisite of terrain constrution
#: data/json/construction/zlvels_transition.json
msgid "Removes down scaffolding from directly above the construction tile."
msgstr "건설 타일 바로 위에서 아래 비계를 제거합니다."

#. ~ Prerequisite of terrain constrution
#: data/json/construction/zlvels_transition.json
msgid "Removes scaffolding."
msgstr "비계를 제거합니다."

