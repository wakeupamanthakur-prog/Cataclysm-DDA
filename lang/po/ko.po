#. ~ "msg" action message of item "torch"
#. ~ "msg" action message of item "everburning torch"
#: data/json/items/tool/lighting.json
#: data/mods/Magiclysm/items/enchanted_misc.json
msgid "You light the torch."
msgstr "횃불에 불을 붙입니다."

#. ~ Description of "torch"
#: data/json/items/tool/lighting.json
