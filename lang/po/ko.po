msgstr "더 많은 인원이 필요하신가요? - Mass General?"

#. ~ Snippet in category "lab_postit_blob"
#: data/json/snippets/lab.json
msgid "Reinforce doors"
msgstr "문을 강화하다"

#. ~ Snippet in category "lab_postit_blob"
#: data/json/snippets/lab.json
msgid "Where does the energy come from?"
msgstr "에너지는 어디에서 오는가?"

#. ~ Snippet in category "lab_postit_blob"
#: data/json/snippets/lab.json
