msgid "hardened steel heavy arm guard"
msgid_plural "hardened steel heavy arm guards"
msgstr[0] "표면경화강 중량 팔 보호구"

#. ~ Description of "hardened steel heavy arm guard"
#: data/json/items/armor/arms_armor.json
msgid ""
