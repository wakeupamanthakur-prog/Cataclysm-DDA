#. ~ Faction mission name
#. ~ Gather items header label of faction mission "Gathering"
#. ~ Gather items header label of faction mission "Collect Firewood"
#: data/json/faction_missions.json
msgid "Gathering"
msgstr "수집"

#. ~ Description of faction mission "Gathering"
#: data/json/faction_missions.json
msgid "Send a companion to gather materials for the next camp upgrade."
msgstr "다음 캠프 업그레이드를 위한 재료를 수집하도록 동료를 보냅니다."

#. ~ Duration of faction mission "Gathering"
#. ~ Duration of faction mission "Collect Firewood"
#: data/json/faction_missions.json
msgid "3 Hours, Repeated"
msgstr "3시간, 반복"

#. ~ Faction mission name
#: data/json/faction_missions.json
msgid "Collect Firewood"
msgstr "장작 수집"

#. ~ Description of faction mission "Collect Firewood"
#: data/json/faction_missions.json
msgid "Send a companion to gather light brush and stout branches."
msgstr "가벼운 덤불과 튼튼한 나뭇가지를 수집하도록 동료를 보냅니다."

#. ~ Possible item from faction mission "Collect Firewood"
#: data/json/faction_missions.json
msgid "stout branches"
msgstr "튼튼한 나뭇가지"

#. ~ Possible item from faction mission "Collect Firewood"
#: data/json/faction_missions.json
msgid "withered plants"
msgstr "시든 식물"

#. ~ Possible item from faction mission "Collect Firewood"
#. ~ Item name
#: data/json/faction_missions.json data/json/items/resources/wood.json
msgid "splintered wood"
msgid_plural "splintered wood"
msgstr[0] "쪼개진 나무"

#. ~ Faction mission name
#: data/json/faction_missions.json
msgid "Sorting"
msgstr "정렬"

#. ~ Description of faction mission "Sorting"
#: data/json/faction_missions.json
msgid "Send a companion to do low level chores and sort supplies."
msgstr "하급 잡일을 하고 보급품을 정렬하도록 동료를 보냅니다."

#. ~ Duration of faction mission "Sorting"
#. ~ Duration of faction mission "Survey Expansion"
#: data/json/faction_missions.json
msgid "3 Hours"
msgstr "3시간"

#. ~ Effect of faction mission "Sorting"
#: data/json/faction_missions.json
msgid ""
"Material left in the unsorted loot zone will be sorted into a defined loot "
"zone."
msgstr "정렬되지 않은 전리품 구역에 남겨진 재료는 정의된 전리품 구역으로 정렬됩니다."

#. ~ Faction mission name
#: data/json/faction_missions.json
msgid "Cut Logs"
msgstr "통나무 자르기"

#. ~ Description of faction mission "Cut Logs"
#: data/json/faction_missions.json
msgid "Send a companion to a nearby forest to cut logs."
msgstr "근처 숲으로 동료를 보내 통나무를 자르게 합니다."

#. ~ Duration of faction mission "Cut Logs"
#: data/json/faction_missions.json
msgid "6 Hours Base + Travel Time + Cutting Time"
msgstr "기본 6시간 + 이동 시간 + 벌목 시간"

#. ~ Effect of faction mission "Cut Logs"
#: data/json/faction_missions.json
msgid "50% of trees/trunks at the forest position will be cut down."
msgstr "숲 위치에 있는 나무/통나무의 50%가 벌목됩니다."

#. ~ Effect of faction mission "Cut Logs"
#: data/json/faction_missions.json
msgid "100% of total material will be brought back."
msgstr "총 재료의 100%가 회수됩니다."

#. ~ Effect of faction mission "Cut Logs"
#: data/json/faction_missions.json
msgid "Repeatable with diminishing returns."
msgstr "수확 체감으로 반복 가능합니다."

#. ~ Effect of faction mission "Cut Logs"
#: data/json/faction_missions.json
msgid "Will eventually turn forests into fields."
msgstr "결국 숲을 밭으로 바꿀 것입니다."

#. ~ Faction mission name
#: data/json/faction_missions.json
msgid "Clear Cut"
msgstr "개간"

#. ~ Description of faction mission "Clear Cut"
#: data/json/faction_missions.json
msgid "Send a companion to clear a nearby forest."
msgstr "근처 숲을 개간하도록 동료를 보냅니다."

#. ~ Duration of faction mission "Clear Cut"
#: data/json/faction_missions.json
msgid "6 Hour Base + Travel Time + Cutting Time"
msgstr "기본 6시간 + 이동 시간 + 벌목 시간"

#. ~ Footer of faction mission "Clear Cut"
#: data/json/faction_missions.json
msgid ""
"Note that it's likely both forest and field roads look exactly the same "
"after having been cleared."
msgstr "숲길과 밭길 모두 개간 후에는 정확히 똑같아 보일 가능성이 높습니다."

#. ~ Effect of faction mission "Clear Cut"
#: data/json/faction_missions.json
msgid "95% of trees/trunks at the forest position will be cut down."
msgstr "숲 위치에 있는 나무/통나무의 95%가 벌목됩니다."

#. ~ Effect of faction mission "Clear Cut"
#: data/json/faction_missions.json
msgid "0% of total material will be brought back."
msgstr "총 재료의 0%가 회수됩니다."

#. ~ Effect of faction mission "Clear Cut"
#: data/json/faction_missions.json
msgid "Forest should become a field tile."
msgstr "숲은 밭 타일이 되어야 합니다."

#. ~ Effect of faction mission "Clear Cut"
#: data/json/faction_missions.json
msgid "Useful for clearing land for another faction camp."
msgstr "다른 진영 캠프를 위한 땅을 개간하는 데 유용합니다."

#. ~ Faction mission name
#: data/json/faction_missions.json
msgid "Setup Hide Site"
msgstr "은신처 설치"

#. ~ Description of faction mission "Setup Hide Site"
#: data/json/faction_missions.json
msgid ""
"Send a companion to build an improvised shelter and stock it with equipment "
"at a distant map location."
msgstr "멀리 떨어진 지도 위치에 임시 대피소를 짓고 장비를 비축하도록 동료를 보냅니다."

#. ~ Duration of faction mission "Setup Hide Site"
#: data/json/faction_missions.json
msgid "6 Hour Construction + Travel"
msgstr "6시간 건설 + 이동"

#. ~ Effect of faction mission "Setup Hide Site"
#: data/json/faction_missions.json
msgid "Good for setting up resupply or contingency points."
msgstr "재보급 지점이나 비상 대책 지점을 설정하는 데 좋습니다."

#. ~ Effect of faction mission "Setup Hide Site"
#. ~ Effect of faction mission "Relay Hide Site"
#: data/json/faction_missions.json
msgid "Gear is left unattended and could be stolen."
msgstr "장비는 방치되어 도난당할 수 있습니다."

#. ~ Effect of faction mission "Setup Hide Site"
#: data/json/faction_missions.json
msgid "Time dependent on weight of equipment being sent forward."
msgstr "시간은 전방으로 보내지는 장비의 무게에 따라 달라집니다."

#. ~ Faction mission name
#: data/json/faction_missions.json
msgid "Relay Hide Site"
msgstr "은신처 중계"

#. ~ Description of faction mission "Relay Hide Site"
#: data/json/faction_missions.json
msgid "Push gear out to a hide site or bring gear back from one."
msgstr "장비를 은신처로 보내거나 은신처에서 장비를 가져옵니다."

#. ~ Duration of faction mission "Relay Hide Site"
#: data/json/faction_missions.json
msgid "1 Hour Base + Travel"
msgstr "기본 1시간 + 이동"

#. ~ Effect of faction mission "Relay Hide Site"
#: data/json/faction_missions.json
msgid "Good for returning equipment you left in the hide site shelter."
msgstr "은신처 대피소에 남겨둔 장비를 회수하는 데 좋습니다."

#. ~ Effect of faction mission "Relay Hide Site"
#: data/json/faction_missions.json
msgid "Time dependent on weight of equipment being sent forward or back."
msgstr "시간은 장비가 전방으로 보내지거나 회수되는 무게에 따라 달라집니다."

#. ~ Faction mission name
#. ~ Gather items header label of faction mission "Foraging"
#: data/json/faction_missions.json
msgid "Foraging"
msgstr "채집"

#. ~ Description of faction mission "Foraging"
#: data/json/faction_missions.json
msgid "Send a companion to forage for edible plants."
msgstr "식용 식물을 채집하도록 동료를 보냅니다."

