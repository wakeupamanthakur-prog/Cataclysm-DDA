#. ~ Item name
#: data/json/items/armor/arms_armor.json
msgid "tempered steel heavy arm guard"
msgid_plural "tempered steel heavy arm guards"
msgstr[0] "강화강 중량 팔 보호구"

#. ~ Description of "tempered steel heavy arm guard"
#: data/json/items/armor/arms_armor.json
msgid ""
"A heavy armguard, 2.25 mm at the thickest.  The medium steel has been "
