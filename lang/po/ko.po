msgstr "당신은 확실히 경연대회에서 이겼을 겁니다."

#. ~ Remove message of effect type "Deeds of Lughnasadh"
#: data/mods/Xedra_Evolved/effects/effects.json
msgid "Your athletic prowess fades."
msgstr "당신의 운동 실력은 사라집니다."

#. ~ Name of effect type id "effect_changeling_noble_broken_right_of_passage"
#: data/mods/Xedra_Evolved/effects/effects.json
