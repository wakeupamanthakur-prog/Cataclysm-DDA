#. ~ Snippet in category "lab_postit_blob"
#: data/json/snippets/lab.json
msgid "Removed parts fuse preferentially to original host"
msgstr "제거된 부품은 원래 호스트에 우선적으로 융합됩니다."

#. ~ Snippet in category "lab_postit_blob"
#: data/json/snippets/lab.json
msgid "Never dead"
msgstr "결코 죽지 않는다"

#. ~ Snippet in category "lab_postit_migo"
#: data/json/snippets/lab.json
