#: src/faction_camp.cpp:2224 src/faction_camp.cpp:2279
#, c-format
msgid "%s : %s"
msgstr "%s : %s"

#: src/faction_camp.cpp:2229
msgid "No current job."
msgstr "현재 배정된 작업이 없습니다."

#: src/faction_camp.cpp:2241
#, c-format
