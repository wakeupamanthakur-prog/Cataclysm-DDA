#: data/mods/aftershock_exoplanet/start_locations.json
msgid "Robot Dispatch Center"
msgstr "로봇 파견센터"

#. ~ Name of starting location "sloc_afs_augmentation_clinic_n3"
#: data/mods/aftershock_exoplanet/start_locations.json
msgid "Augclinic"
msgstr "오그클리닉"

