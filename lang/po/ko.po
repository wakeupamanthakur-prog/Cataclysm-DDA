#: src/faction_camp.cpp:2291
msgid "Priority for all jobs "
msgstr "모든 작업의 우선순위 "

#: src/faction_camp.cpp:2297
#, c-format
msgid "Priority for %s "
msgstr "%s의 우선도"

#: src/faction_camp.cpp:2323
#, c-format
