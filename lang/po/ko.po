#. ~ Description of effect type "Scarecrow's Mien"
#: data/mods/Xedra_Evolved/effects/effects_changeling_seasonal_magic.json
msgid "Now they shall know fear."
msgstr "이제 그들은 두려움을 알게 될 것이다."

#. ~ Remove message of effect type "Scarecrow's Mien"
#: data/mods/Xedra_Evolved/effects/effects_changeling_seasonal_magic.json
msgid "The terrifying illusions fade away."
msgstr "무서운 환상은 사라집니다."

#. ~ Name of effect type id "effect_changeling_autumn_protection_from_ranged"
#. ~ Name of spell "changeling_autumn_protection_from_ranged_spell"
#: data/mods/Xedra_Evolved/effects/effects_changeling_seasonal_magic.json
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_autumn.json
msgid "Swirl of Autumn Leaves"
msgstr "가을 단풍의 소용돌이"

#. ~ Description of effect type "Swirl of Autumn Leaves"
#: data/mods/Xedra_Evolved/effects/effects_changeling_seasonal_magic.json
msgid "A chill wind is whirling around you."
msgstr "차가운 바람이 당신 주위를 돌고 있습니다."

#. ~ Remove message of effect type "Swirl of Autumn Leaves"
#: data/mods/Xedra_Evolved/effects/effects_changeling_seasonal_magic.json
msgid "The autumn leaves fall to the ground."
msgstr "가을 낙엽이 땅에 떨어진다."

#. ~ Name of effect type id "effect_changeling_autumn_freeze_in_place_target"
#: data/mods/Xedra_Evolved/effects/effects_changeling_seasonal_magic.json
msgid "Baleful Gaze"
msgstr "불길한 시선"

#. ~ Name of effect type id
#. "effect_changeling_winter_freeze_target_in_place_not_winter"
#. ~ Name of effect type id
#. "effect_changeling_winter_freeze_target_in_place_during_winter"
#. ~ Name of spell "changeling_winter_freeze_target_in_place_spell"
#: data/mods/Xedra_Evolved/effects/effects_changeling_seasonal_magic.json
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_winter.json
msgid "Grip of Winter"
msgstr "겨울의 손아귀"

#. ~ Description of effect type "Grip of Winter"
#: data/mods/Xedra_Evolved/effects/effects_changeling_seasonal_magic.json
msgid "Ice coats your lower limbs, freezing you in place."
msgstr "얼음이 당신의 하체를 감싸서 당신을 그 자리에 얼려버립니다."

#. ~ Remove message of effect type "Grip of Winter"
#. ~ Remove message of effect type "Path of Rime"
#: data/mods/Xedra_Evolved/effects/effects_changeling_seasonal_magic.json
msgid "The chill around your feet fades away."
msgstr "발 주변의 추위가 사라집니다."

#. ~ Name of effect type id "effect_changeling_winter_walk_in_silence"
#. ~ Name of spell "changeling_winter_walk_in_silence"
#: data/mods/Xedra_Evolved/effects/effects_changeling_seasonal_magic.json
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_winter.json
