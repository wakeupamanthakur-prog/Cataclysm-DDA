msgstr "(이)가 당신의 주방에서 뭔가를 가지고 복귀합니다…"

#: src/faction_camp.cpp:1610
msgid "returns from your farm with something…"
msgstr "(이)가 당신의 농장에서 뭔가를 가지고 복귀합니다…"

#: src/faction_camp.cpp:1613
