#. ~ Item name
#: data/mods/desert_region/weather/weather_eoc.json
msgid "test dust storm causer"
msgid_plural "test dust storm causers"
msgstr[0] "테스트 먼지 폭풍 유발 장치"

#. ~ Description of "test dust storm causer"
#: data/mods/desert_region/weather/weather_eoc.json
msgid "Causes dust storms."
msgstr "먼지 폭풍을 일으킵니다."

#. ~ Player message in effect in EoC "EOC_DUST_STORM_POPUP_DAY_NIGHT" in
#. nested EOCs in effect in EoC "EOC_EARLY_DUST_STORM_POPUP" in nested EOCs in
#. effect in EoC "EOC_CAUSE_EARLY_DUST_STORM"
#: data/mods/desert_region/weather/weather_eoc.json
msgid ""
"You suddenly notice a wall of dust and debris coming your way.  A dust storm"
" is approaching."
msgstr "갑자기 먼지와 잔해의 벽이 다가오는 것을 느낍니다. 먼지 폭풍이 다가오고 있습니다."

#. ~ Player message in false effect in EoC "EOC_DUST_STORM_POPUP_DAY_NIGHT" in
#. nested EOCs in effect in EoC "EOC_EARLY_DUST_STORM_POPUP" in nested EOCs in
#. effect in EoC "EOC_CAUSE_EARLY_DUST_STORM"
#: data/mods/desert_region/weather/weather_eoc.json
msgid ""
"NIGHT You suddenly notice a wall of dust and debris coming your way.  A dust"
" storm is approaching."
msgstr "밤 갑자기 먼지와 잔해의 벽이 다가오는 것을 느꼈습니다. 먼지 폭풍이 다가오고 있었습니다."

#. ~ Player message in effect in EoC "EOC_DUST_STORM_MESSAGE" in nested EOCs
#. in effect in EoC "EOC_CAUSE_DUST_STORM"
#: data/mods/desert_region/weather/weather_eoc.json
msgid "The dust storm has arrived!"
msgstr "먼지 폭풍이 도착했습니다!"

#. ~ Player message in effect in EoC "EOC_END_DUST_STORM_MESSAGE" in nested
#. EOCs in effect in EoC "EOC_CANCEL_DUST_STORM"
#: data/mods/desert_region/weather/weather_eoc.json
msgid "As suddenly as it began, the dust storm fades."
msgstr "먼지 폭풍은 갑자기 시작되었지만 곧 사라집니다."

#. ~ Player message in effect in EoC "EOC_LOSE_GLAND"
#: data/mods/extra_mut_scen/EoCs.json
msgid ""
"You've somehow overcome the genetic reprogramming you were unwillingly made "
"subject to, your gland wilting and becoming benign."
msgstr "당신은 어떻게든 원치 않게 유전적 재프로그램을 극복했고, 당신의 샘은 시들어지고 양성화되었습니다."

#. ~ Player message in nested effect in then statement in effect in EoC
#. "EOC_GLAND_PASSED_THRESHOLD"
#: data/mods/extra_mut_scen/EoCs.json
msgid ""
"You feel as though your experimental gland will fight your body less from "
"now on."
msgstr "이제부터는 실험샘이 몸과 덜 싸우는 것 같은 느낌이 듭니다."

#. ~ Player message in effect in EoC "EOC_TEST_GLAND"
#: data/mods/extra_mut_scen/debug.json
msgid "Initial setup complete (1 if true): <u_val:setup_gland>"
msgstr "초기 설정 완료(true이면 1): <u_val:setup_gland>"

#. ~ Player message in effect in EoC "EOC_TEST_GLAND"
#: data/mods/extra_mut_scen/debug.json
msgid "Gland vitamin: <u_val:mutagen_gland_vitamin>"
msgstr "샘 비타민: <u_val:mutagen_gland_vitamin>"

#. ~ Player message in effect in EoC "EOC_TEST_GLAND"
#: data/mods/extra_mut_scen/debug.json
msgid "Gland threshold: <u_val:mutagen_gland_threshold>"
msgstr "샘 역치: <u_val:mutagen_gland_threshold>"

#. ~ Player message in effect in EoC "EOC_TEST_GLAND"
#: data/mods/extra_mut_scen/debug.json
msgid ""
"Gland post-mutation cooldown (-1 if off cooldown): "
"<u_val:recently_mutated_cooldown>hrs"
msgstr "선 돌연변이 후 쿨다운(쿨다운이 꺼진 경우 -1): <u_val:recently_mutated_cooldown>시간"

#. ~ Player message in effect in EoC "EOC_TEST_GLAND"
#: data/mods/extra_mut_scen/debug.json
