msgid_plural "Nedcolbertia Knuckles"
msgstr[0] "네드콜베르티아 너클즈"

#. ~ Description of monster "Nedcolbertia Knuckles"
#. ~ Description of monster "Fona Fury"
#: data/mods/DinoMod/monsters/zinosaur_upgrade.json
msgid ""
"The shuffling corpse of a bipedal dinosaur covered with tattered feathers "
