#. ~ Response to NPC dialogue
#: data/json/npcs/TALK_CITY_COP.json data/json/npcs/TALK_NC_FARMER.json
#: data/json/npcs/TALK_SURVIVOR_CHEF.json
#: data/json/npcs/refugee_center/beggars/BEGGAR_1_Reena_Sandhu.json
#: data/mods/Magiclysm/npc/TALK_HEALER_GREY.json
#: data/mods/Magiclysm/npc/TALK_OLD_MAGUS.json
#: data/mods/Magiclysm/npc/TALK_TECHNO_KID.json
msgid "Why don't you go somewhere else?"
msgstr "왜 밖으로 안 나가는거야?"

#. ~ Response to NPC dialogue
#. ~ NPC dialogue line
#: data/json/npcs/TALK_CITY_COP.json
#: data/json/npcs/militia/GM_Militia_Merchant.json
#: data/json/npcs/old_guard/NPC_Old_Guard_FOB_quartermaster.json
#: data/mods/Magiclysm/npc/TALK_HEALER_GREY.json
#: data/mods/Magiclysm/npc/TALK_OLD_MAGUS.json
#: data/mods/Magiclysm/npc/TALK_TECHNO_KID.json
msgid "Let's trade then."
msgstr "그럼 거래하자."

#. ~ NPC dialogue line
#. ~ You don't need to translate genders that aren't in your language
#. ~ Check: https://github.com/CleverRaven/Cataclysm-
#. DDA/blob/master/doc/TRANSLATING.md#grammatical-gender
