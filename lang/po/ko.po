msgstr "%s (이)가 화장실을 청소하고 다른 이들이 어질러둔걸 치우기 시작합니다."

#: src/faction_camp.cpp:2344
#, c-format
msgid "%s isn't a recognized terrain.  Please file a bug report."
msgstr "%s은(는 인식된 지형이 아닙니다. 버그 보고서를 제출해 주십시오."

#: src/faction_camp.cpp:2357
msgid ""
"The logged tile has been cleared and cannot be logged further after this "
"mission."
msgstr "기록된 타일이 지워졌으며 이 임무 이후에는 더 이상 기록할 수 없습니다."

#: src/faction_camp.cpp:2374
#, c-format
