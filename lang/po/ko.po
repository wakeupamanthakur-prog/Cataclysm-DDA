#. ~ Variant name of item "skirt"
#: data/json/items/armor/legs_clothes.json
msgid "cyan skirt"
msgid_plural "cyan skirts"
msgstr[0] "치마, 청록색"

#. ~ Description of variant "cyan skirt" of item "skirt"
#. ~ Description of variant "cyan hoodie" of item "hoodie"
#. ~ Description of variant "cyan cropped hoodie" of item "cropped hoodie"
#. ~ Description of variant "cyan t-shirt" of item "t-shirt"
#. ~ Description of variant "cyan crop top" of item "crop top"
#: data/json/items/armor/legs_clothes.json
#: data/json/items/armor/torso_clothes.json
msgid "This one is colored cyan."
