msgid "A Stop On The Road"
msgstr "길 한 가운데"

#. ~ Scenario name for male
#: data/json/scenarios.json data/mods/innawood/scenarios.json
msgctxt "scenario_male"
msgid "Last Flight"
msgstr "마지막 비행"

#. ~ Scenario name for female
