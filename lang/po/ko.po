#. ~ Location of gun mod
#: data/mods/aftershock_exoplanet/items/gun/10mm.json
#: data/mods/aftershock_exoplanet/items/gun/7.50mm.json
#: data/mods/aftershock_exoplanet/items/gunmods/ETC_firmware.json
msgid "ETCfirmware"
msgstr "ETC펌웨어"

#. ~ Item name
#. ~ Name of a gun
#: data/mods/aftershock_exoplanet/items/gun/10mm.json
msgid "MarSec. 4"
msgid_plural "MarSec. 4s"
msgstr[0] "마르섹. 4"

#. ~ Description of gun "MarSec. 4"
#. ~ Description of "MarSec. 4"
#: data/mods/aftershock_exoplanet/items/gun/10mm.json
msgid ""
"Dependable, reliable, classic.  The MarSec. 4 is the combat pistol made for "
"those who can differentiate real quality from glued-on tech."
msgstr ""
"믿음직하고, 신뢰할 수 있고, 고전적인 MarSec. 4는 진짜 품질과 엉터리 기술을 구분할 줄 아는 사람들을 위해 만들어진 전투용 "
"권총입니다."

#. ~ Firing mode of gun
#: data/mods/aftershock_exoplanet/items/gun/10mm.json
msgid "2rd burst"
msgstr "2점사"

#. ~ Item name
#. ~ Name of a gun
#. ~ Variant name of gun "W1011 Silvergram"
#. ~ Variant name of item "W1011 Silvergram"
#: data/mods/aftershock_exoplanet/items/gun/10mm.json
msgid "W1011 Silvergram"
msgid_plural "W1011 Silvergrams"
msgstr[0] "W1011 실버그램"

#. ~ Description of gun "W1011 Silvergram"
#. ~ Description of variant "W1011 Silvergram" of gun "W1011 Silvergram"
#. ~ Description of "W1011 Silvergram"
#. ~ Description of variant "W1011 Silvergram" of item "W1011 Silvergram"
#: data/mods/aftershock_exoplanet/items/gun/10mm.json
msgid ""
"A finely sculpted white and silver pistol entrusted to Wraitheon's corporate"
" elite.  It employs advanced targeting and precision guiding capabilities to"
" deliver devastating bursts of guided 10mm microjet darts.  Firing is as "
"expensive as it looks."
msgstr ""
"정교하게 조각된 흰색과 은색의 권총으로, 레이스온의 기업 엘리트들에게 맡겨졌습니다. 첨단 조준 및 정밀 유도 기능을 탑재하여 파괴적인 "
"10mm 마이크로젯 다트를 연발로 발사합니다. 보기만큼 발사 비용도 만만치 않습니다."

#. ~ Variant name of gun "W1011 Silvergram"
#. ~ Variant name of item "W1011 Silvergram"
#: data/mods/aftershock_exoplanet/items/gun/10mm.json
msgid "W1011 Silverhawk"
msgid_plural "W1011 Silverhawks"
msgstr[0] "W1011 실버호크"

#. ~ Description of variant "W1011 Silvergram" of gun "W1011 Silverhawk"
#. ~ Description of variant "W1011 Silverhawk" of item "W1011 Silvergram"
#: data/mods/aftershock_exoplanet/items/gun/10mm.json
msgid ""
"A Silvergram smart pistol given a far less conspicuous \"military carbon\" "
"black finish.  Its performance and smart targeting capacities are otherwise "
"identical."
msgstr ""
"훨씬 눈에 덜 띄는 \"군용 카본\" 블랙 마감 처리된 실버그램 스마트 권총입니다. 성능과 스마트 조준 능력은 그 외에는 동일합니다."

#. ~ Firing mode of gun
#: data/mods/aftershock_exoplanet/items/gun/10mm.json
msgid "2rd.  burst"
msgstr "2점사"

