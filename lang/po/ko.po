#: data/json/npcs/scrap_trader/scrap_trader.json
msgid "Any jobs you need done?"
msgstr "해줬으면 하는 일이 있어?"

#. ~ NPC dialogue line
#: data/json/npcs/cabin_chemist/chemist_npc.json
msgid "It's nice to see you again <u_name>.  What can I do for you?"
msgstr "<u_name> 님, 다시 뵙게 되어 반갑습니다. 무엇을 도와드릴까요?"

#. ~ NPC dialogue line
#. ~ You don't need to translate genders that aren't in your language
#. ~ Check: https://github.com/CleverRaven/Cataclysm-
#. DDA/blob/master/doc/TRANSLATING.md#grammatical-gender
