#: data/mods/Magiclysm/items/enchanted_rings.json
msgid "ring of blades"
msgid_plural "rings of blades"
msgstr[0] "칼날 반지"

#. ~ Description of "ring of blades"
#: data/mods/Magiclysm/items/enchanted_rings.json
