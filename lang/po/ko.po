#: data/mods/Magiclysm/monsters/zombified_fantasy_species.json
#, c-format
msgid "%s lunges forward to bite <npcname>, but they dodge!"
msgstr "%s가 <npcname>을 물려고 달려들지만, 그들은 피합니다!"

