#. ~ Vehicle part name
#. ~ Item name
#: data/json/furniture_and_terrain/appliances.json data/json/items/fake.json
msgid "glassblower's crucible"
msgid_plural "glassblower's crucibles"
msgstr[0] "유리 장인의 도가니"

#. ~ Description of vehicle part "glassblower's crucible"
