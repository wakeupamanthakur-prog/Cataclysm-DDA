msgstr ""
"<color_light_blue>^>v<</color>        주유소 - 가솔린을 구하기 좋은 장소입니다. 폭발할 위험이 있습니다."

#. ~ Help message in menu "Description of map symbols"
#: data/core/help.json
msgid ""
"<color_light_red>^>v<</color>        Pharmacy - The best source for vital "
"medications."
msgstr "<color_light_red>^>v<</color> 약국 - 필수 의약품을 구하기에 최적의 장소입니다."

#. ~ Help message in menu "Description of map symbols"
#: data/core/help.json
msgid ""
"<color_green>^>v<</color>        Grocery store - A good source of canned "
