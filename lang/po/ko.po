#. ~ %s is a list of body parts.  The plurality integer is the total
#. ~ number of body parts (eyes count as 2 body parts)
#. ~ This message indicates focus loss through sunshine
#: src/suffer.cpp:1020
#, c-format
msgid "The sunlight on your %s irritates you."
msgid_plural "The sunlight on your %s irritates you."
msgstr[0] "햇빛에 %s(이)가 따갑습니다."

#: src/suffer.cpp:1053
msgid "You shed a tooth!"
msgstr "이가 빠졌습니다!"

#. ~Sound of buzzing Insect Wings
#: src/suffer.cpp:1059
msgid "BZZZZZ"
msgstr "붕붕"

#: src/suffer.cpp:1090
msgid "Suddenly, you can't hear anything!"
msgstr "갑자기 아무것도 들리지 않습니다!"

#: src/suffer.cpp:1094
msgid "Suddenly, your eyes stop working!"
msgstr "갑자기 눈 앞이 보이지 않습니다!"

#: src/suffer.cpp:1100
msgid "Your visual centers must be acting up…"
msgstr "시각 중추가 이상하게 작동하는 것 같습니다…"

#: src/suffer.cpp:1187
msgid "You feel an anomalous sensation coming from your radiation sensors."
msgstr "당신의 방사능 센서로부터 오는 비정상적인 신호가 느껴집니다."

#: src/suffer.cpp:1191
msgid ""
"Your flesh tingles with an air of danger, yet it is strangely pleasurable."
msgstr "피부가 위험한 기운으로 저릿하지만, 이상하게도 즐겁습니다."

#: src/suffer.cpp:1258
msgid "Emergency!  User's lungs are not powered!"
msgstr "비상! 사용자 폐에 전원이 공급되지 않습니다!"

#: src/suffer.cpp:1265
msgid "You suffer a painful electrical discharge!"
msgstr "전력 누출로 인해 고통이 느껴집니다!"

#: src/suffer.cpp:1268
msgid "You experience an electrical discharge!"
msgstr "전기 방출!"

#: src/suffer.cpp:1280
#, c-format
msgid "The %s seems to be affected by the discharge."
msgstr "%s(이)가 전력누출에 영향을 받은 것 같습니다."

#: src/suffer.cpp:1287
msgid "You suffer a burning acidic discharge!"
msgstr "산성액 누출로 화상을 입습니다!"

#: src/suffer.cpp:1289
msgid "You experience an acidic discharge!"
msgstr "산성 방출!"

#: src/suffer.cpp:1300
msgid "You CBM leaks radiation."
msgstr "당신의 CBM에서 방사능이 누출됩니다."

#: src/suffer.cpp:1314
msgid "Your muscles spasm!"
msgstr "근육에 경련이 일어납니다!"

#: src/suffer.cpp:1316
msgid "You fall to the ground!"
msgstr "지면에 쓰러집니다!"

#: src/suffer.cpp:1323
msgid "You feel short of breath."
msgstr "호흡이 가빠집니다."

#: src/suffer.cpp:1329
msgid "You shake uncontrollably."
msgstr "떨림이 멈추지 않습니다."

#: src/suffer.cpp:1335
msgid "You feel nauseous…"
msgstr "구역질이 납니다…"

#: src/suffer.cpp:1343
msgid "You black out!"
msgstr "의식을 잃었습니다!"

#: src/suffer.cpp:1354
msgid "Your breathing slows down."
msgstr "호흡이 느려집니다."

#: src/suffer.cpp:1363
msgid "You stumble and fall over!"
msgstr "비틀거리다 쓰러집니다!"

#: src/suffer.cpp:1370
msgid "You feel tired…"
msgstr "피곤합니다…"

#: src/suffer.cpp:1382
msgid "You're beginning to feel like you've exerted yourself a bit."
msgstr "너무 활동적이었던 것 같습니다."

#: src/suffer.cpp:1385
msgid "You're tiring out mildly, and slowing down as a result."
msgstr "조금 지친 듯한 기분이 들어 느려집니다."

#: src/suffer.cpp:1388
msgid "The day's labors are taking their toll, and slowing you down."
msgstr "오늘 하루 노동에 지쳐 몸이 느려집니다."

#: src/suffer.cpp:1391
msgid "You're getting very tired from all this hard work."
msgstr "힘든 일을 하고 나니 매우 피곤합니다."

#: src/suffer.cpp:1395
msgid "You're exhausted."
msgstr "완전히 진이 빠졌습니다."

#: src/suffer.cpp:1400
msgid "You're feeling a bit better rested from your exertions."
msgstr "피로가 조금 풀린 것 같습니다."

#: src/suffer.cpp:1459
msgid "You're tiring out; continuing to work at this rate will be slower."
msgstr "지친 상태입니다.  이런 강도로 계속 일을 하면 더 느려질 것입니다."

#: src/suffer.cpp:1474
msgid "You tiredly rub your eyes."
msgstr "피곤한 듯 눈을 비빕니다."

#: src/suffer.cpp:1475
msgid "<npcname> tiredly rubs their eyes."
msgstr "<npcname>(이)가 피곤한 듯 눈을 비빕니다."

#: src/suffer.cpp:1478
msgid "You let out a small yawn."
msgstr "작게 하품합니다."

#: src/suffer.cpp:1479
msgid "<npcname> lets out a small yawn."
msgstr "<npcname>(이)가 작게 하품합니다."

#: src/suffer.cpp:1482
msgid "You stretch your back."
msgstr "등을 쭉 폅니다."

#: src/suffer.cpp:1483
msgid "<npcname> stretches their back."
msgstr "<npcname>(이)가 등을 쭉 폅니다."

#: src/suffer.cpp:1486
msgid "You feel mentally tired."
msgstr "정신적인 피로감이 느껴집니다."

#: src/suffer.cpp:1487
msgid "<npcname> lets out a huge yawn."
msgstr "<npcname>(이)가 크게 하품합니다."

#: src/suffer.cpp:1495
msgid "You feel lightheaded for a moment."
msgstr "잠깐 어지러움을 느낍니다."

#: src/suffer.cpp:1499
msgid "Your muscles spasm uncomfortably."
msgstr "불편할 정도로 근육이 경련합니다."

#: src/suffer.cpp:1503
msgid "Your vision blurs a little."
msgstr "시야가 약간 흐려집니다."

#: src/suffer.cpp:1510
msgid "Your mind lapses into unawareness briefly."
msgstr "마음이 잠시동안 무의식 속으로 빠져듭니다."

#: src/suffer.cpp:1514
msgid "Your muscles ache in stressfully unpredictable ways."
msgstr "근육이 짜증날 정도로 예측불가능하게 쑤십니다."

#: src/suffer.cpp:1518
msgid "You have a distractingly painful headache."
msgstr "정신을 쏙 빼놓을 정도로 머리가 아픕니다."

#: src/suffer.cpp:1525
msgid "You feel heartburn and an acid taste in your mouth."
msgstr "가슴이 타는 것 같고, 입에서 신 맛이 느껴집니다."

#: src/suffer.cpp:1530
msgid "Your mind is so tired that you feel you can't trust your eyes anymore."
msgstr "정신이 너무 피곤해져서 더이상 스스로의 눈을 믿을 수가 없습니다."

#: src/suffer.cpp:1535
msgid ""
"Your muscles spasm uncontrollably, and you have trouble keeping your "
"balance."
msgstr "근육이 억제할 수 없을 정도로 경련하고, 균형을 잡는데 문제가 생깁니다."

#: src/suffer.cpp:1540
msgid "Your shaking legs make you stumble."
msgstr "다리가 후들후들 떨려 넘어집니다."

#: src/suffer.cpp:1541
msgid "<npcname> stumbles."
msgstr "<npcname>(이)가 넘어집니다."

#: src/suffer.cpp:1543
msgid "<npcname> falls over!"
msgstr "<npcname>(이)가 떨어집니다!"

#: src/suffer.cpp:1543
msgid "You fall over!"
msgstr "떨어집니다!"

#: src/suffer.cpp:1560
msgid "Your tourniquet hurts you."
msgstr "지혈대가 아파옵니다."

#: src/suffer.cpp:1561
msgid "<npcname> is hurting from the tourniquet."
msgstr "<npcname>의 지혈대가 아파옵니다."

#: src/suffer.cpp:1574
msgid ""
"Your fear of the dark is so intense that your hands start shaking "
"uncontrollably."
msgstr "어둠에 대한 두려움이 너무 강해서 손이 통제할 수 없이 떨리기 시작합니다."

#: src/suffer.cpp:1582
msgid ""
"Your fear of the dark is so intense that you start breathing rapidly, and "
"you feel like your heart is ready to jump out of your chest."
msgstr "어둠에 대한 두려움이 너무 강해서 숨을 가쁘게 쉬기 시작하고, 심장이 가슴에서 튀어나올 것 같습니다."

#: src/suffer.cpp:1589
msgid "You feel a twinge of panic as darkness engulfs you."
msgstr "어둠이 당신을 감쌀 때 약간의 공포를 느낍니다."

#: src/suffer.cpp:1603
msgid "You attract the attention of something horrible."
msgstr "끔찍한 무언가의 주의를 끕니다."

#: src/suffer.cpp:1604
msgid "<npcname> attracts the attention of something horrible."
msgstr "<npcname>이(가) 끔찍한 무언가의 주의를 끕니다."

#: src/suffer.cpp:1613
msgid "Reality gives way under your feet like rotten scaffolding."
msgstr "현실이 썩은 비계처럼 발밑에서 무너집니다."

#: src/suffer.cpp:1614
msgid "Reality gives way under <npcname>'s feet like rotten scaffolding."
msgstr "현실이 <npcname>의 발밑에서 썩은 비계처럼 무너집니다."

#: src/suffer.cpp:1618
msgid "You suddenly lose all substance and corporeality."
msgstr "갑자기 모든 실체와 육체성을 잃습니다."

