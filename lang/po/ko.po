#: src/suffer.cpp:325
msgid "You're drowning!"
msgstr "물에 잠겨 죽어가고 있습니다!"

#: src/suffer.cpp:382
msgid "You're crushed against the walls!"
msgstr "벽에 부딪혀 으스러졌습니다!"

#: src/suffer.cpp:399 src/suffer.cpp:401
msgid "You're suffocating!"
msgstr "고통받고 있습니다!"

#: src/suffer.cpp:407
msgid "You can't breathe with all this weight!"
msgstr "무게에 짓눌려 숨을 쉴 수 없습니다!"

#: src/suffer.cpp:409
msgid "You're having difficulty breathing!"
msgstr "숨 쉬기가 어렵습니다!"

#: src/suffer.cpp:426
msgid "You start having withdrawals!"
msgstr "금단 증상이 나타나기 시작합니다!"

#: src/suffer.cpp:465
msgid "You're suddenly overcome with the urge to sleep and you pass out."
msgstr "당신은 갑자기 자고 싶은 충동에 사로잡혀 기절합니다."

#: src/suffer.cpp:522
msgid "You suddenly feel sharp pain for no reason."
msgstr "아무 이유 없이 갑자기 날카로운 고통이 느껴집니다."

#: src/suffer.cpp:528
msgid "You suddenly feel numb."
msgstr "갑자기 감각이 사라지는게 느껴집니다."

#: src/suffer.cpp:530
msgid "You suddenly ache."
msgstr "갑자기 아픕니다."

#: src/suffer.cpp:535 src/suffer.cpp:1360
msgid "You feel dizzy for a moment."
msgstr "잠시 어지러워집니다."

#: src/suffer.cpp:541
msgid "You suddenly feel hungry."
msgstr "갑자기 배가 고파집니다."

#: src/suffer.cpp:543
msgid "You suddenly feel a little full."
msgstr "갑자기 배가 부릅니다."

#: src/suffer.cpp:548
msgid "You suddenly feel thirsty."
msgstr "갑자기 목이 마릅니다."

#: src/suffer.cpp:552
msgid "You feel sleepy all of a sudden."
msgstr "갑자기 졸음이 쏟아집니다."

#: src/suffer.cpp:564
msgid "You suddenly feel very cold."
msgstr "갑자기 아주 추워집니다."

#: src/suffer.cpp:567
msgid "You suddenly feel cold."
msgstr "갑자기 추워집니다."

#: src/suffer.cpp:573
msgid "You suddenly feel very hot."
msgstr "갑자기 아주 더워집니다."

#: src/suffer.cpp:576
msgid "You suddenly feel hot."
msgstr "갑자기 더워집니다."

#: src/suffer.cpp:604
msgid "You have an asthma attack!"
msgstr "천식 발작이 일어납니다!"

#: src/suffer.cpp:605
msgid "<npcname> starts wheezing and coughing."
msgstr "<npcname>이(가) 쌕쌕거리고 기침하기 시작합니다."

#: src/suffer.cpp:618
msgid "You use your Oxygenator to clear it up, then go back to sleep."
msgstr "산소호흡기를 사용한 다음 다시 잠을 청합니다."

#: src/suffer.cpp:622 src/suffer.cpp:633
msgid "You use your inhaler and go back to sleep."
msgstr "흡입기를 사용하고 다시 잠을 청합니다."

#: src/suffer.cpp:626 src/suffer.cpp:637
msgid "You take a deep breath from your oxygen tank and go back to sleep."
msgstr "산소 탱크에서 숨을 깊이 들이쉰 다음 다시 잠을 청합니다."

#: src/suffer.cpp:649 src/suffer.cpp:687
msgid "You can't focus while choking!"
msgstr "목이 졸리는 동안에는 집중할 수 없습니다!"

#: src/suffer.cpp:659
msgid "You use your last inhaler charge."
msgstr "흡입기 마지막 잔량을 사용합니다."

#: src/suffer.cpp:661
#, c-format
msgid "You use your inhaler; only %d charge left."
msgid_plural "You use your inhaler; only %d charges left."
msgstr[0] "흡입기를 사용합니다. 앞으로 %d회 더 쓸 수 있습니다."

#: src/suffer.cpp:673
msgid "You breathe in the last bit of oxygen from the tank."
msgstr "탱크에서 마지막 산소를 들이킵니다."

#: src/suffer.cpp:676
#, c-format
msgid "You take a deep breath from your oxygen tank; only %d charge left."
msgid_plural ""
"You take a deep breath from your oxygen tank; only %d charges left."
msgstr[0] "산소 탱크로 숨을 깊게 들이쉬어, 충전량이 %d 만큼 남았습니다."

#: src/suffer.cpp:740 src/suffer.cpp:748
msgid "The sunlight distracts you."
msgstr "햇빛이 거슬립니다."

#: src/suffer.cpp:755
msgid "You fear the sunlight!"
msgstr "햇빛이 두렵습니다!"

#: src/suffer.cpp:762
msgid "You can't stand the sunlight!"
msgstr "햇빛을 견딜 수가 없습니다!"

