msgid "A prepared blunderbuss shot comprised of lead pellets."
msgstr "리드 펠릿으로 구성된 준비된 Blunderbuss 샷."

#. ~ Item name
#: data/json/items/handloaded_bullets.json
msgid "blunderbuss flechette"
msgid_plural "blunderbuss flechette"
