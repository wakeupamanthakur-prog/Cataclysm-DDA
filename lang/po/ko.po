#: src/activity_actor.cpp:357
#, c-format
msgid "Your %s is little more than an awkward club now."
msgstr "당신의 %s은/는 이제 이상하게 생긴 방망이에 불과합니다."

#: src/activity_actor.cpp:371
#, c-format
msgid "You manually cycle your %s, and load a new round."
msgstr "수동으로 %s을/를 회전시킨 뒤 새로운 탄약을 장전했습니다."

#: src/activity_actor.cpp:377
#, c-format
msgid ""
"Your %s has some mechanical malfunction.  You tried to quickly fix it, and "
"it works now!"
msgstr "%s에 문제가 생겼습니다. 재빨리 고치려고 노력했더니 이제 제대로 작동합니다!"

#: src/activity_actor.cpp:383
#, c-format
msgid ""
"Your %s has some mechanical malfunction.  You tried to quickly fix it, but "
"failed!"
msgstr "%s에 문제가 생겼습니다. 재빨리 고치려고 노력했지만 실패했습니다!"

#: src/activity_actor.cpp:391
#, c-format
msgid ""
"Your %s is too hot, and little screen signalizes the gun is inoperable."
msgstr "%s가 과열되었으며, 작은 화면에는 총이 작동하지 않는다는 신호가 표시됩니다."

#: src/activity_actor.cpp:680
msgid "Auto drive canceled."
msgstr "자동 운전 취소됨."

#: src/activity_actor.cpp:690 src/activity_handlers.cpp:1627
#: src/activity_handlers.cpp:1655
msgid "You have reached your destination."
msgstr "목적지에 도착했습니다."

#: src/activity_actor.cpp:718
msgid "Something got in the way of smashing."
msgstr "뭔가가 부수는 것을 방해했습니다."

#: src/activity_actor.cpp:727
msgid "You're no longer able to make progress smashing here."
msgstr "여기서는 더 이상 부술 수 없습니다."

#. ~ %1$s - gunmod, %2$s - gun.
#: src/activity_actor.cpp:808
#, c-format
msgid "You remove your %1$s from your %2$s."
msgstr "%2$s에서 %1$s(을)를 떼어냈습니다."

#: src/activity_actor.cpp:884
msgid "You cause a short circuit!"
msgstr "합선을 일으켰습니다!"

#: src/activity_actor.cpp:922
msgid "You cannot hack this."
msgstr "해킹할 수 없습니다."

#: src/activity_actor.cpp:928 src/activity_actor.cpp:2727
#: src/activity_actor.cpp:6729 src/computer_session.cpp:558
#: src/computer_session.cpp:1340 src/computer_session.cpp:1611
msgid "an alarm sound!"
msgstr "경보음!"

#: src/activity_actor.cpp:933
msgid "You fail the hack, but no alarms are triggered."
msgstr "해킹에 실패했지만, 경보음은 울리지 않았습니다."

#: src/activity_actor.cpp:949
msgid "You hack the terminal and route all available fuel to your pump!"
msgstr "단말기를 해킹하고 모든 연료를 펌프로 보냈습니다!"

#: src/activity_actor.cpp:951
msgid "Glug Glug Glug Glug Glug Glug Glug Glug Glug"
msgstr "쿨렁 쿨렁 쿨렁 쿨렁 쿨렁 쿨렁 쿨렁 쿨렁 쿨렁"

